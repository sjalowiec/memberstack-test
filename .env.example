# Copy to .env for local development. Never commit real secrets.

# Watson Postgres (legacy imports + live Shopify / license tables)
WATSON_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/watson

# Watson UI password (server-only)
WATSON_ADMIN_PASSWORD=

# Shopify Admin API (server-only) — app with read_orders only
# Store used by Knit it Now + DesignaKnit product links: vjzu11-86.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Preferred for Dev Dashboard (Spring '26+) apps: client credentials → short-lived token
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Legacy custom-app static Admin API token (used if set; skips client credentials)
# SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01

# Optional: required header X-Watson-Sync-Secret for netlify function watson-shopify-sync
# WATSON_SHOPIFY_SYNC_SECRET=

# Memberstack (existing)
# MEMBERSTACK_SECRET_KEY=
# MEMBERSTACK_SANDBOX_SECRET_KEY=

# Legacy annual expiration reconciliation (netlify function legacy-annual-expiry)
# Scheduled runs perform LIVE Memberstack changes ONLY when this is exactly
# "true". Keep it "false" until a dry run has been reviewed and approved.
LEGACY_ANNUAL_EXPIRY_LIVE_ENABLED=false
# Required to authorize a MANUAL live run (POST ?confirm=LIVE with header
# X-Legacy-Expiry-Secret). Leave blank to disable manual live runs entirely.
LEGACY_ANNUAL_EXPIRY_SECRET=

# ActiveCampaign API (server-only). Used by netlify functions memberstack-created
# (signup) and legacy-renewal-reminders (annual renewal nudges). Base URL has NO
# trailing /api/3 and NO trailing slash, e.g. https://knitbymachine.activehosted.com
ACTIVECAMPAIGN_API_KEY=
ACTIVECAMPAIGN_BASE_URL=https://knitbymachine.activehosted.com
# Existing Knit It Now list id (numeric, from ActiveCampaign > Lists). Never
# auto-created — the reminder job fails fast if this list id does not exist.
ACTIVECAMPAIGN_KIN_LIST_ID=
# Custom date field id (numeric) for "Legacy Membership Paid Through". The Watson
# subscriptionexpiring date is written here before the reminder tag is applied.
ACTIVECAMPAIGN_PAID_THROUGH_FIELD_ID=

# Legacy annual renewal reminders (netlify function legacy-renewal-reminders)
# Scheduled runs tag members LIVE in ActiveCampaign ONLY when this is exactly
# "true". Keep it "false" until a dry run has been reviewed and approved.
LEGACY_RENEWAL_REMINDER_LIVE_ENABLED=false
# Required to authorize a MANUAL live run (POST ?confirm=LIVE with header
# X-Legacy-Renewal-Secret). Leave blank to disable manual live runs entirely.
LEGACY_RENEWAL_REMINDER_SECRET=
