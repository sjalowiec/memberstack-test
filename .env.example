# Copy to .env and fill in real values. Do not commit .env.

# ---------------------------------------------------------------------------
# Memberstack: ALWAYS use the LIVE app in every environment (no test app)
# ---------------------------------------------------------------------------
# Client: the Memberstack DOM script is loaded by a single hard-coded app id in
# src/layouts/BaseLayout.astro (`data-memberstack-app="app_cmfh3d1n802wy..."`).
# There is intentionally NO separate test app id and NO localhost/dev override.
# TEST vs LIVE mode for the browser is decided by Memberstack's dashboard domain
# allowlist (Settings > Application Domains), NOT by code or env vars. To make
# localhost and the *.netlify.app dev site run the LIVE app, add those hosts to
# the LIVE domain list in the Memberstack dashboard.
#
# Server (Netlify functions / admin REST): set the LIVE secret key below in ALL
# environments (local, dev, production). LIVE keys start with `sk_`; sandbox/TEST
# keys start with `sk_sb_` and MUST NOT be used anywhere — they target test
# members and will make localhost/dev behave like the test app.
# MEMBERSTACK_SECRET_KEY=sk_live_xxx   # never sk_sb_...

# ---------------------------------------------------------------------------
# Dev-only: bypass Memberstack gating on localhost (optional)
# ---------------------------------------------------------------------------
# Set to "true" (string) to show gated/member-only content locally without
# logging in. Only has effect when running `astro dev` (import.meta.env.DEV).
# Production builds ignore this; leave false or omit before release.
#
# To test REAL Memberstack plan access locally: set this to false, restart the dev
# server, then log in. A localhost-only access debug badge (bottom-left) shows whether
# access came from a Memberstack plan, member-JSON unlock, free allowance, or logged-out.
#
# PUBLIC_DEV_BYPASS_GATING=false
