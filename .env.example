# Copy to .env and fill in real values. Do not commit .env.

# ---------------------------------------------------------------------------
# Dev-only: bypass Memberstack gating on localhost (optional)
# ---------------------------------------------------------------------------
# Set to "true" (string) to show gated/member-only content locally without
# logging in. Only has effect when running `astro dev` (import.meta.env.DEV).
# Production builds ignore this; leave false or omit before release.
#
# To test REAL Memberstack plan access locally: set this to false, restart the dev
# server, then log in. A localhost-only access debug badge (bottom-left) shows whether
# access came from a Memberstack plan, member-JSON unlock, free allowance, or logged-out.
#
# PUBLIC_DEV_BYPASS_GATING=false
