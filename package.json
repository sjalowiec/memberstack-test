{
  "name": "memberstack-test",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-public-manifests.mjs",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "prepare:transition-site": "node scripts/prepare-transition-site.mjs",
    "dev:transition-site": "npm run prepare:transition-site && astro dev --config transition-site/astro.config.mjs",
    "build:transition-site": "npm run prepare:transition-site && astro build --config transition-site/astro.config.mjs",
    "preview:transition-site": "astro preview --config transition-site/astro.config.mjs",
    "test": "vitest run",
    "postinstall": "node scripts/patch-netlify-functions-dev-multipart.mjs",
    "check:utf8": "node scripts/check-utf8.mjs",
    "generate:legacy-ebook-shopify-import": "vite-node scripts/generate-legacy-ebook-shopify-import.ts",
    "split:course-content": "vite-node scripts/split-course-content.ts",
    "watson:import": "vite-node scripts/watson-import.ts",
    "watson:import-legacy-history": "vite-node scripts/watson-import-legacy-history.ts",
    "watson:import-legacy-garments": "vite-node scripts/watson-import-legacy-garments.ts",
    "watson:validate": "vite-node scripts/watson-validate-import.ts",
    "watson:analyze-csv": "node scripts/watson-analyze-csv.mjs",
    "watson:generate-schema": "vite-node scripts/watson-generate-schema.ts"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.0",
    "@netlify/blobs": "^10.7.4",
    "astro": "^5.17.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/netlify": "^6.6.4",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.20.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
