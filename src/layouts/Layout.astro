---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ToolPrintFooter from "../components/tools/ToolPrintFooter.astro";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  skipGlobalPinterest?: boolean;
  /** Print-only tool attribution (see ToolPrintFooter). */
  toolPrintTitle?: string;
  /**
   * Onboarding flow: render a minimal header (logo → home only, no nav/search)
   * and a "Skip for now" link near the bottom. Reuse for focused onboarding
   * pages (machine-checkup, knit-your-first-rows, etc.).
   */
  onboarding?: boolean;
  /**
   * Marketing / sales pages: same minimal header as onboarding (logo only, no
   * nav or search) without onboarding-only UI such as "Skip for now".
   */
  marketing?: boolean;
  /**
   * Pattern Builder / Edit / saved-view workspaces: compact phone header
   * (hide tall search strip; keep logo + hamburger + search icon).
   * On desktop (≥1025px) the shared header stays in document flow so the full
   * chrome can scroll away; ≤1024px keeps the existing fixed header + drawer.
   */
  patternWorkspace?: boolean;
}

const {
  title,
  description,
  bodyClass = "",
  skipGlobalPinterest = false,
  toolPrintTitle,
  onboarding = false,
  marketing = false,
  patternWorkspace = false,
} = Astro.props;

// Onboarding and marketing pages get a body hook so the minimal header height is
// respected without touching the global header offset used by the rest of the site.
const resolvedBodyClass = [
  bodyClass,
  onboarding ? "page--onboarding" : "",
  marketing ? "page--marketing" : "",
  patternWorkspace ? "page--pattern-workspace page--tight-header" : "",
]
  .filter(Boolean)
  .join(" ");
---

<!-- This layout does not render a visible page heading; title is used only for <title> in BaseLayout. -->
<BaseLayout
  title={title}
  description={description}
  bodyClass={resolvedBodyClass}
  skipGlobalPinterest={skipGlobalPinterest}
>
  <slot name="head" slot="head" />
  <Header onboarding={onboarding} marketing={marketing} patternWorkspace={patternWorkspace} />

 

  <script is:inline>
    (function () {
      const openBtn = document.getElementById('open-intro-drawer');
      const drawer = document.getElementById('intro-drawer');
      const closeBtn = drawer?.querySelector('.kbm-drawer-close');

      function openDrawer() {
        if (drawer) {
          drawer.showModal();
          drawer.classList.add('kbm-drawer--open');
        }
      }

      function closeDrawer() {
        if (!drawer) return;
        drawer.classList.remove('kbm-drawer--open');
        setTimeout(function () { drawer.close(); }, 200);
      }

      if (openBtn) openBtn.addEventListener('click', openDrawer);
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);

      if (drawer) {
        drawer.addEventListener('click', function (e) {
          if (e.target === drawer) closeDrawer();
        });
        drawer.addEventListener('cancel', function (e) {
          e.preventDefault();
          closeDrawer();
        });
      }

      var whereLink = document.getElementById('drawer-where-link');
      if (whereLink) {
        whereLink.addEventListener('click', function (e) {
          e.preventDefault();
          closeDrawer();
          setTimeout(function () {
            var target = document.getElementById('where-are-you');
            var headerEl = document.querySelector('header') || document.querySelector('.kbm-header-wrap');
            var headerHeight = headerEl ? headerEl.getBoundingClientRect().height : 160;
            if (target) {
              var y = target.getBoundingClientRect().top + window.scrollY - headerHeight - 16;
              window.scrollTo({ top: y, behavior: 'smooth' });
            } else {
              window.location.href = whereLink.getAttribute('href') || '/#where-are-you';
            }
          }, 220);
        });
      }
    })();
  </script>

  <main class="site-content" data-pagefind-body style="padding-top: calc(var(--header-offset, 150px) + var(--header-buffer, 24px) + var(--kbm-env-banner-h, 0px));">
    <slot />
    {onboarding && (
      <nav class="onboarding-skip" aria-label="Skip onboarding">
        <a href="/" class="onboarding-skip__link">Skip for now → Go to Home</a>
      </nav>
    )}
    {toolPrintTitle && <ToolPrintFooter toolTitle={toolPrintTitle} />}
  </main>

  <Footer />

  <!-- Local preview: ?member=true / ?guest=true adds body classes (does not affect Memberstack) -->
  <script is:inline>
    (function () {
      try {
        var params = new URLSearchParams(window.location.search);
        if (params.get("member") === "true") {
          document.body.classList.add("preview-member");
          document.body.classList.remove("preview-guest");
        } else if (params.get("guest") === "true") {
          document.body.classList.add("preview-guest");
          document.body.classList.remove("preview-member");
        }
      } catch (e) {}
    })();
  </script>
</BaseLayout>

<style is:global>
  :root {
    --header-offset: 170px;   /* fallback if measurement fails */
    --header-buffer: 36px;   /* EXTRA breathing room */
  }

  body.page--tight-header {
    --header-buffer: 8px;
  }

  /* Onboarding and marketing: minimal header (logo only), so content can sit closer to
     the top. Set here (body scope) so it never affects the global header used
     by the rest of the site. The offset JS below refines this after measuring. */
  body.page--onboarding,
  body.page--marketing {
    --header-offset: 88px;
    --header-buffer: 8px;
  }

  @media (max-width: 600px) {
    body.page--onboarding,
    body.page--marketing {
      --header-offset: 72px;
    }
  }

  /* Pattern workspaces: provisional compact phone offset until JS measures the shorter header. */
  @media (max-width: 767.98px) {
    body.page--pattern-workspace {
      --header-offset: 64px;
      --header-buffer: 8px;
    }
  }

  /*
   * Pattern workspaces on desktop (no hamburger drawer): keep the shared header
   * markup/design, but stop fixing it so green nav + search strip scroll away.
   * Ordinary pages and ≤1024px pattern pages are untouched (fixed header remains).
   */
  @media (min-width: 1025px) {
    body.page--pattern-workspace {
      --header-offset: 0px;
      --header-buffer: 8px;
    }

    body.page--pattern-workspace .kbm-header-wrap {
      position: relative;
      /* Override EnvBanner's fixed-header `top` nudge; clear the banner with margin instead. */
      top: auto !important;
    }

    html[data-kbm-env-banner="on"] body.page--pattern-workspace .kbm-header-wrap {
      margin-top: var(--kbm-env-banner-h, 0px);
    }

    /*
     * Header is in document flow, so main must not also reserve full header height.
     * Env clearance is on the header margin above (avoid double-counting --kbm-env-banner-h).
     * !important beats the inline padding-top on main.site-content.
     */
    body.page--pattern-workspace main.site-content {
      padding-top: var(--header-buffer, 8px) !important;
    }

    body.page--pattern-workspace {
      scroll-padding-top: var(--header-buffer, 8px);
    }
  }

  /* "Skip for now" text link near the bottom of onboarding pages */
  .onboarding-skip {
    margin-top: 2.5rem;
    text-align: center;
  }

  .onboarding-skip__link {
    display: inline-block;
    padding: 0.25rem 0.25rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #6b7280;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .onboarding-skip__link:hover {
    color: var(--kbm-green, #52682d);
  }

  .onboarding-skip__link:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Mobile: more breathing room below brand bar so content doesn’t feel jammed */
  @media (max-width: 1024px) {
    :root {
      --header-buffer: 24px;
    }
  }

  html {
    scroll-padding-top: calc(var(--header-offset, 170px) + var(--header-buffer, 24px));
  }

  .site-content > :first-child {
    margin-top: 0;
  }
</style>
<script is:inline>
(function () {

  function setHeaderOffset() {
    const fallback = 170;
    const isPatternWorkspace =
      document.body.classList.contains("page--pattern-workspace");
    const isPatternWorkspacePhone =
      isPatternWorkspace && window.matchMedia("(max-width: 767.98px)").matches;
    // Desktop pattern workspaces: header is in-flow (not fixed). Do not reserve
    // a fixed-header gap. Ordinary pages and ≤1024px pattern pages keep measuring.
    const isPatternWorkspaceDesktop =
      isPatternWorkspace && window.matchMedia("(min-width: 1025px)").matches;

    if (isPatternWorkspaceDesktop) {
      document.documentElement.style.setProperty("--header-offset", "0px");
      return;
    }

    /* Use full fixed header (billboard + green bar) so content starts below both layers */
    const headerWrap = document.querySelector(".kbm-header-wrap");
    const headerEl = headerWrap || document.querySelector("header");

    if (!headerEl) {
      document.documentElement.style.setProperty(
        "--header-offset",
        (isPatternWorkspacePhone ? 64 : fallback) + "px",
      );
      return;
    }

    const headerHeight = Math.ceil(headerEl.getBoundingClientRect().height);

    // Subtract Memberstack debug pill height if present
    let debugHeight = 0;
    const debugPill = headerEl && Array.from(headerEl.querySelectorAll("*")).find((el) => {
      const txt = (el.textContent || "").trim();
      return txt.startsWith("MS:ready") || txt.includes("MS:ready loggedIn");
    });

    if (debugPill) {
      debugHeight = Math.ceil(debugPill.getBoundingClientRect().height);
    }

    // Add a small safety margin so content never kisses the header
    const safety = 12;
    const measured = headerHeight - debugHeight + safety;

    // Pattern workspace phones: trust the measured compact header (do not floor at 170px).
    const corrected = isPatternWorkspacePhone
      ? Math.max(52, measured)
      : Math.max(fallback, measured);

    document.documentElement.style.setProperty("--header-offset", corrected + "px");
  }

  window.addEventListener("load", setHeaderOffset);
  window.addEventListener("resize", setHeaderOffset);

  // Handle delayed layout shifts
  setTimeout(setHeaderOffset, 50);
  setTimeout(setHeaderOffset, 250);
  setTimeout(setHeaderOffset, 1000);

  // Recalculate after fonts load
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(setHeaderOffset).catch(function(){});
  }

  // Watch for header size changes
  window.addEventListener("load", function () {
    const wrap = document.querySelector(".kbm-header-wrap");
    if (!wrap || typeof ResizeObserver === "undefined") return;

    const observer = new ResizeObserver(setHeaderOffset);
    observer.observe(wrap);
  });

})();
</script>