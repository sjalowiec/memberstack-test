---
import "../styles/global.css";

import "../styles/print.css";
import ContactModal from "../components/ContactModal.astro";
import AccountPasswordResetModal from "../components/auth/AccountPasswordResetModal.astro";
import KinCatalogVideoModal from "../components/common/KinCatalogVideoModal.astro";
import ToolPrintFooter from "../components/tools/ToolPrintFooter.astro";
import EnvBanner from "../components/EnvBanner.astro";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  skipGlobalHyvor?: boolean;
  /** Omit Pinterest pinit.js and helpers (e.g. wizard pages debugging hidden-tab embeds). */
  skipGlobalPinterest?: boolean;
  /** When set (e.g. tool pages using BaseLayout directly), adds a print-only attribution line. */
  toolPrintTitle?: string;
}

const {
  title = "Knit it Now",
  description = "Machine knitting tools and patterns",
  bodyClass = "",
  skipGlobalHyvor = false,
  skipGlobalPinterest = false,
  toolPrintTitle
} = Astro.props;

const hostname =
  typeof Astro.url !== "undefined" && Astro.url.hostname
    ? Astro.url.hostname.toLowerCase()
    : "";

const isProduction =
  (import.meta.env.PUBLIC_SITE_ENV || "").toLowerCase() === "production";
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- CRITICAL: Inline typography to prevent Astro CSS bundler reordering issues -->
    <style data-kbm-typography>
      html {
        font-size: 112.5% !important;
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }
      @media (min-width: 1025px) {
        html {
          font-size: 112.5% !important;
        }
      }
    </style>

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  
    <!-- Google Analytics -->
{import.meta.env.PUBLIC_GA4_ID && (
  <>
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA4_ID}`}
    ></script>
    <script
      is:inline
      define:vars={{ gaId: import.meta.env.PUBLIC_GA4_ID }}
    >
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}

    <!-- Fonts & icons -->
    <link
      href="https://fonts.googleapis.com/css2?family=Handlee&family=Poppins:wght@400;500;600;700&family=Shadows+Into+Light+Two&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <script src="https://kit.fontawesome.com/2eb052bf9e.js" crossorigin="anonymous"></script>

    {!skipGlobalPinterest && (
      <>
        <!-- Pinterest Embed Script (single load site-wide; re-parse via kbmSchedulePinterestEmbedsRefresh when tabs show) -->
        <script async defer src="https://assets.pinterest.com/js/pinit.js"></script>
        <script is:inline>
          window.kbmInitPinterestEmbeds = function kbmInitPinterestEmbeds(root) {
            try {
              var PU = window.PinUtils;
              if (PU && typeof PU.build === "function") {
                PU.build(root);
              }
              if (PU && typeof PU.parse === "function" && !root) {
                PU.parse();
              }
            } catch (e) {}
          };
          window.kbmPinterestBuild = window.kbmInitPinterestEmbeds;
          /**
           * Run after layout + retry until PinUtils exists (hidden-tab embeds, slow pinit.js).
           * Optional root: document subtree only (e.g. visible tab mount) so pinit gets real widths.
           * Pattern pages: call when an Inspiration tab becomes visible and once on load if needed.
           */
          window.kbmSchedulePinterestEmbedsRefresh = function kbmSchedulePinterestEmbedsRefresh(root) {
            function tryInit() {
              try {
                window.kbmInitPinterestEmbeds(root);
              } catch (e) {}
            }
            requestAnimationFrame(function () {
              requestAnimationFrame(tryInit);
            });
            var n = 0;
            var max = 48;
            var id = window.setInterval(function () {
              n += 1;
              tryInit();
              if (window.PinUtils || n >= max) {
                window.clearInterval(id);
              }
            }, 125);
          };
        </script>
      </>
    )}
    
    <slot name="head" />

    {import.meta.env.DEV && (
      <style>
        .preview-banner {
          position: fixed;
          top: calc(var(--kbm-env-banner-h, 0px) + 2px);
          right: 0;
          z-index: 9998;

          padding: 6px 12px;
          font-size: 12px;
          font-weight: 700;

          border-bottom-left-radius: 6px;
          color: #fff;
        }

        .preview-member {
          background: #2e7d32;
        }

        .preview-nonmember {
          background: #f39c12;
        }

        .preview-default {
          background: #7f8c8d;
        }
      </style>
    )}

    <!-- MS TEST MARKER -->
<meta name="ms-test-marker" content="base-layout-is-rendering" />

<script is:inline>
  window.memberstackTranslations = {
    create_an_account: "Get the Weekly Tips"
  };
</script>
<script>
  import { hasKinVideoAccess, logKinVideoAccessDebug } from "../lib/kinVideoAccess";
  import { openMemberstackLoginModal, openMemberstackSignupModal } from "../lib/memberstackLogin";

  window.kbmHasKinVideoAccess = hasKinVideoAccess;
  window.kbmLogKinVideoAccessDebug = logKinVideoAccessDebug;
  window.kbmOpenMemberstackLoginModal = openMemberstackLoginModal;
  window.kbmOpenMemberstackSignupModal = openMemberstackSignupModal;
</script>
   
<!-- MemberStack -->
<!-- Memberstack webflow package -->
<script data-memberstack-app="app_cmfh3d1n802vb0wy706205810" src="https://static.memberstack.com/scripts/v2/memberstack.js" type="text/javascript"></script>


  

  <body class={bodyClass}>
    <EnvBanner />
    {import.meta.env.DEV && (
      <div class="preview-banner" id="preview-banner"></div>
    )}
    <div id="msTopError" class="ms-top-error" role="alert" aria-live="polite" hidden>
      <div class="ms-top-error__bar" aria-hidden="true"></div>
      <div class="ms-top-error__text"></div>
    </div>
    <a
      id="kbm-ms-login-proxy"
      href="#"
      data-ms-modal="login"
      data-ms-redirect="/"
      hidden
      aria-hidden="true"
      tabindex="-1"
    ></a>
    <a
      id="kbm-ms-signup-proxy"
      href="#"
      data-ms-modal="signup"
      data-ms-redirect="/"
      hidden
      aria-hidden="true"
      tabindex="-1"
    ></a>
    <slot /> <!-- Page content (or Layout wrapper) goes here -->

    {toolPrintTitle && <ToolPrintFooter toolTitle={toolPrintTitle} />}

    <ContactModal />
    <AccountPasswordResetModal />
    <KinCatalogVideoModal />

    <script>
      import "../scripts/accountPasswordResetModal.ts";
    </script>

    {!skipGlobalHyvor && (
      <script
        async
        src="https://talk.hyvor.com/embed/embed.js"
        type="module"
      ></script>
    )}

    <script is:inline>
(function () {
  function bannerEl() {
    return document.getElementById("msTopError");
  }

  function setBanner(message) {
    const banner = bannerEl();
    if (!banner) return;

    const textEl = banner.querySelector(".ms-top-error__text");
    if (!textEl) return;

    const msg = (message || "").trim();

    if (!msg) {
      banner.hidden = true;
      textEl.textContent = "";
      return;
    }

    textEl.textContent = msg;
    banner.hidden = false;

    // bring it into view so it's obvious
    try { banner.scrollIntoView({ behavior: "smooth", block: "start" }); } catch (e) {}
  }

  function readMemberstackError() {
    // Prefer the standard error message element if present
    const msError = document.querySelector(".ms-error-message");
    if (msError && msError.textContent.trim()) return msError.textContent.trim();

    // Fallback to data attribute containers
    const msContainers = document.querySelectorAll('[data-ms-message="error"]');
    for (const el of msContainers) {
      const txt = (el.textContent || "").trim();
      if (txt) return txt;
    }
    return "";
  }

  // clear on back/forward cache restore
  window.addEventListener("pageshow", () => setBanner(""));
})();
</script>
    <script>
      import { initMemberstackPostLoginHandlers } from "../lib/memberstackPostLogin";

      initMemberstackPostLoginHandlers();
    </script>
    <script is:inline>
  window.$memberstackDom?.onReady?.then(() => {
    window.$memberstackDom?.init?.();
  });
</script>
    <script is:inline>
  document.addEventListener("click", function (e) {
    const a = e.target?.closest?.("#kbmLoginLink");
    if (!a) return;
    e.preventDefault();
    if (window.$memberstackDom?.openModal) {
      window.$memberstackDom.openModal("LOGIN");
    }
  });
</script>
    <!--
      Inject a "Forgot Password?" link into MemberStack's prebuilt LOGIN modal.
      The prebuilt modal renders inside <memberstack-prebuilt-ui>'s shadow root and
      ships without a forgot-password link in this app's dashboard config, so we add
      one and wire it to MemberStack's own forgot-password flow. Login-only detection:
      a "current-password" field with no "new-password" field uniquely identifies the
      login modal among MemberStack's prebuilt modals (signup / reset / change-password
      all use "new-password"), so signup and other flows are left untouched.
    -->
    <script is:inline>
  (function () {
    var LINK_ID = "kbm-forgot-password-link";

    function openForgotPassword(e) {
      e.preventDefault();
      e.stopPropagation();
      if (typeof window.kbmOpenAccountPasswordResetModal === "function") {
        window.kbmOpenAccountPasswordResetModal();
      }
    }

    function findLoginPasswordInput(root) {
      // Only the login modal has a current-password field with no new-password field.
      if (root.querySelector('input[autocomplete="new-password"], input[data-ms-member="new-password"]')) {
        return null;
      }
      return root.querySelector('input[autocomplete="current-password"]');
    }

    function injectLink(shadowRoot) {
      if (!shadowRoot) return;
      var existing = shadowRoot.getElementById ? shadowRoot.getElementById(LINK_ID) : null;
      var pwInput = findLoginPasswordInput(shadowRoot);

      // Not the login modal (e.g. switched to signup) — drop any stale link.
      if (!pwInput) {
        if (existing) existing.remove();
        return;
      }
      if (existing) return;

      var field = pwInput.closest("div") || pwInput.parentElement;
      if (!field) return;

      var link = document.createElement("a");
      link.id = LINK_ID;
      link.href = "#";
      link.textContent = "Forgot Password?";

      // Match the modal's own link color (e.g. the "Create one" link) when available.
      var sampleLink = shadowRoot.querySelector('a[data-ms-modal], a, [role="link"]');
      var accent = "";
      if (sampleLink) {
        try { accent = getComputedStyle(sampleLink).color; } catch (err) {}
      }
      link.style.display = "block";
      link.style.marginTop = "8px";
      link.style.textAlign = "right";
      link.style.fontSize = "0.85rem";
      link.style.fontWeight = "600";
      link.style.textDecoration = "underline";
      link.style.cursor = "pointer";
      if (accent) link.style.color = accent;

      link.addEventListener("click", openForgotPassword);
      field.insertAdjacentElement("afterend", link);
    }

    var observedHosts = new WeakSet();
    function observeHost(host) {
      if (!host || !host.shadowRoot || observedHosts.has(host)) return;
      observedHosts.add(host);
      var mo = new MutationObserver(function () { injectLink(host.shadowRoot); });
      mo.observe(host.shadowRoot, { childList: true, subtree: true });
      injectLink(host.shadowRoot);
    }

    function scanHosts() {
      var hosts = document.querySelectorAll("memberstack-prebuilt-ui");
      for (var i = 0; i < hosts.length; i++) observeHost(hosts[i]);
    }

    function start() {
      var bodyObserver = new MutationObserver(scanHosts);
      bodyObserver.observe(document.body, { childList: true, subtree: true });
      scanHosts();
    }

    if (document.body) {
      start();
    } else {
      document.addEventListener("DOMContentLoaded", start);
    }
  })();
</script>

    {import.meta.env.DEV && (
      <script>
        const params = new URLSearchParams(window.location.search);
        const preview = params.get("previewMember");

        const banner = document.getElementById("preview-banner");

        if (banner) {
          if (preview === "member") {
            banner.textContent = "Preview: MEMBER";
            banner.classList.add("preview-member");
          } else if (preview === "nonmember") {
            banner.textContent = "Preview: NON-MEMBER";
            banner.classList.add("preview-nonmember");
          } else {
            banner.textContent = "Preview: DEFAULT";
            banner.classList.add("preview-default");
          }
        }
      </script>
    )}

    <script is:inline>
      document.addEventListener("DOMContentLoaded", async () => {
        if (!window.$memberstackDom) return;

        try {
          const res = await window.$memberstackDom.getCurrentMember();
          const data = res?.data;
          const member = (data?.member ?? data) || null;
          const rawKinAccess = member?.customFields?.["kin-access"];
          const hasVideoAccess = window.kbmHasKinVideoAccess?.(res) ?? false;

          window.kbmLogKinVideoAccessDebug?.("BaseLayout.ms-logged-in", {
            member: res,
            rawKinAccess,
            finalHasVideoAccess: hasVideoAccess,
          });

          if (hasVideoAccess) {
            document.body.classList.add("ms-logged-in");
          } else {
            document.body.classList.remove("ms-logged-in");
          }
        } catch (error) {
          console.warn("MemberStack member check failed", error);
        }
      });
    </script>

    <script is:inline>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var localMember =
          window.location.hostname === "localhost" && params.get("member") === "true";

        if (!localMember) return;

        document.body.classList.add("dev-member");
        window.__KBM_DEV_MEMBER__ = true;

        document.addEventListener(
          "click",
          function (e) {
            var t = e.target;
            if (!t || typeof t.closest !== "function") return;
            var a = t.closest("a[href]");
            if (!a) return;
            var raw = a.getAttribute("href") || "";
            var path = raw.split("#")[0].split("?")[0];
            if (path === "/membership" || /\/membership$/.test(path)) {
              e.preventDefault();
            }
          },
          true
        );
      })();
    </script>

  </body>
</html>