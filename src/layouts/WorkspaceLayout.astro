---
import WorkspaceHeader from '../components/layout/WorkspaceHeader.astro';
import WorkspaceFooter from '../components/layout/WorkspaceFooter.astro';
import RobotsMeta from '../components/seo/RobotsMeta.astro';

const { title = 'Private Project Workspace' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <RobotsMeta />
    <slot name="head" />
  </head>
  <body class="workspace-page">
    <WorkspaceHeader />
    <main class="workspace-main">
      <div class="workspace-main-inner">
        <slot />
      </div>
    </main>
    <WorkspaceFooter />
  </body>
</html>

<style>
  .workspace-page {
    margin: 0;
    min-height: 100vh;
    background: #f7f8fb;
    color: #1f2937;
    font-family: var(--font, "Poppins", Arial, sans-serif);
    font-size: 16px;
    line-height: 1.65;
  }

  .workspace-main {
    width: 100%;
    padding: 2rem 1rem 3rem;
    box-sizing: border-box;
  }

  .workspace-main-inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .workspace-main-inner :global(h1),
  .workspace-main-inner :global(h2),
  .workspace-main-inner :global(h3) {
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .workspace-main {
      padding: 2.5rem 1.5rem 3.5rem;
    }
  }
</style>
