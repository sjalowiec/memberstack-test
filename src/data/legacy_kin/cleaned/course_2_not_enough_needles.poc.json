              "order": 3
            }
          ],
          "title": "Not Enough Needles?",
          "slug": "not-enough-needles",
          "order": 2,
          "legacy": {
            "assignId": 71,
            "blockType": "Video"
          }
        },
        {
          "components": [
            {
              "type": "richText",
              "html": "Based on your gauge, \r\nhow wide can you knit with \r\nthe needles available on your machine?<br>\r\n\r\n\r\nThis is just one of the many Knit it Now charting tools available.<br>\r\n\t<img class=\"img-thumbnail\" src=\"/challenge/images/v2/2/tools.jpg\">\r\n\r\n\r\n\r\n",
              "legacyComponentId": 6152,
              "order": 1
            }
          ],
          "title": "Use the Knit it Now Tool",
          "slug": "use-the-knit-it-now-tool",
          "order": 3,
