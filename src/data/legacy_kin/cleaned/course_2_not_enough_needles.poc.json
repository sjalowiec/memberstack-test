  "lessons": [
    {
      "title": "Introduction",
      "slug": "introduction",
      "displayOrder": 1,
      "legacy": {
        "itemId": 8,
        "lessonOrder": 1
      },
      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "<p data-start=\"392\" data-end=\"563\" class=\"PDq2pG_selectionAnchorContainer\">Whether you're knitting a blanket or a plus size garment, every knitting machine has a limited number of needles. That limits the widest piece you can knit in one section.<span aria-hidden=\"true\" class=\"PDq2pG_selectionAnchor\"></span></p>\n<p data-start=\"565\" data-end=\"760\">Unlike hand knitting, we can't simply use a longer needle cable and add more stitches. When a project is too wide, we need to get creative by knitting panels or using another construction method.</p>\n<p data-start=\"762\" data-end=\"846\"><strong data-start=\"762\" data-end=\"846\">Use the calculator below to find the maximum width you can knit on your machine.</strong></p>\n<p data-start=\"848\" data-end=\"889\">Continue to the next lesson when you're finished exploring the calculator.</p>",
              "legacyComponentId": 780,
              "order": 1
            },
            {
              "type": "migrationPending",
              "legacyType": "CustomCFM",
              "notes": [
                "Legacy ColdFusion tool: Howmanyneedles.cfm",
                "Legacy ColdFusion interactive tool.",
                "Replace with equivalent KBM interactive tool."
              ],
              "legacyFields": {
                "CHALLENGE_ASSIGNID": "70",
                "CUSTOMCFM": "Howmanyneedles.cfm",
                "TYPEOF": "CustomCFM"
              },
              "legacyComponentId": 5558,
              "order": 2
            }
          ],
          "title": "Start Here",
          "slug": "start-here",
          "order": 1,
          "legacy": {
            "assignId": 70,
            "blockType": "HTML"
          }
        },
        {
          "components": [
            {
              "type": "video",
