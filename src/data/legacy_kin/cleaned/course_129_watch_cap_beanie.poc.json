        },
        {
          "components": [
            {
              "type": "richText",
              "html": "Before picking up the scrapped off stitches and shaping the wedges, choose a shaping method.<br>Following your pattern, you will work decreases every other row For a professional finish, be consistent with your shaping method.<br><img width=\"25\" src=\"/challenge/images/v2/129/icon3.gif\"> Swipe the image below to explore the options. ",
              "legacyComponentId": 9959,
              "order": 1
            },
            {
              "type": "migrationPending",
              "legacyType": "before_after",
              "notes": [
