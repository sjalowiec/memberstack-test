    {
      "title": "Sizing and Options",
      "slug": "sizing-and-options",
      "displayOrder": 10,
      "legacy": {
        "itemId": 259,
        "lessonOrder": 10
      },
      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "\r\n<br>Because of the unusual shapes, determining your size can be a bit of a challenge. <br>Here are some facts to help you make a decision.<br>The Knit it Now Dynamic pattern is based on Sally's original dimensions. Use the measurements below along with the legend images in the pattern to determine your size.<br><em>\r\nThe Knit it Now Pattern sizes are:<br>\r\nXSmall, Small, Medium, Large, XLarge</em>\r\n<center><h3>From Sally's original pattern</h3><br><img class=\"img-thumbnail\" src=\"/challenge/images/v2/36/sally_sizing.png\">\t</center><br>\r\n\r\n\r\n",
              "legacyComponentId": 4156,
              "order": 1
            },
            {
              "type": "richText",
              "html": "<!-- BUST -->\r\n\r\n\r\n    <div style=\"background-color: #9E2065;color: rgb(255,255,255);padding: 20px;\">\r\n    Body Size <button class=\"btn btn-outline-light\" onclick=\"$('#theanswer').toggle()\"> <i class=\"fa fa-arrows-v\" aria-hidden=\"true\"></i></button>\r\n    </div>\r\n\r\n\r\n<!--- hidden answer. --->\r\n\r\n    \r\n        \r\n              <img src=\"/challenge/images/v2/36/body_size.gif\">\r\n               \r\n          \r\n            <br><b>NOTE: The dimensions below are 1/2 of the total finished body circumference </b><br> Xsmall, Small, Medium, Large, XLarge <small><em>Knit it Now Pattern Sizing</em></small><br>\r\n            <img src=\"/challenge/images/v2/36/body_sizing.gif\">\r\n        \r\n    \r\n\r\n\r\n\r\n",
              "legacyComponentId": 4159,
              "order": 2
            },
            {
              "type": "richText",
              "html": "<!-- shoulder -->\r\n\r\n    <div style=\"background-color: #9E2065;color: rgb(255,255,255);padding: 20px;\">\r\n    <h2<i class=\"arrows\"></i> Shoulder Width</h2> <button class=\"btn btn-outline-light\" onclick=\"$('#shoulder').toggle()\"> <i class=\"fa fa-arrows-v\" aria-hidden=\"true\"></i></button>\r\n    </div>\r\n\r\n\r\n<!--- hidden answer. --->\r\n\r\n    \r\n\r\n <img class=\"img-thumbnail\" src=\"/challenge/images/v2/36/cross-shoulder.gif\">\r\n<br><span style=\"color:#8DC63F;\"><strong style=\"font-size: 20px;\">Cross Shoulders</strong></span><br>\r\nThe green cross shoulder measurements shown are an estimate based on the shoulder seam (solid green line). Because this is a loose-fitting poncho, the shoulders will fit a wide range of sizes.<br>\r\n\r\n\r\n\r\n   \r\n    \r\n\r\n\r\n\r\n\r\n",
              "legacyComponentId": 4157,
              "order": 3
            },
            {
              "type": "richText",
              "html": "<!--neck opening -->\r\n\r\n    <div style=\"background-color: #9E2065;color: rgb(255,255,255);padding: 20px;\">\r\n    <h2<i class=\"arrows\"></i> Neck Opening</h2> <button class=\"btn btn-outline-light\" onclick=\"$('#neck').toggle()\"> <i class=\"fa fa-arrows-v\" aria-hidden=\"true\"></i></button>\r\n    </div>\r\n\r\n\r\n<!--- hidden answer. --->\r\n\r\n    \r\n\r\n<img class=\"img-thumbnail\" src=\"/challenge/images/v2/36/neck_opening.gif\">\r\n <br><strong style=\"font-size: 20px;\">Neck Opening</strong><br>\r\nThe size of the neck opening is controlled by the bind off and cast on edge on the main piece (the \"N\" dimension).\r\n<br><b>To make a smaller neck opening, bind off fewer stitches for \"N\".</b>\r\n\r\n<ul><li> (This has to go over the head ... don't make it too small) </li>\r\n<li>Remember that this will also result in a smaller folded collar.</li></ul>\r\n\r\n<img src=\"/challenge/images/v2/36/Ndimension.gif\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n   \r\n    \r\n\r\n\r\n\r\n\r\n",
              "legacyComponentId": 4158,
              "order": 4
            }
          ],
          "title": "Sizing",
          "slug": "sizing",
          "order": 1,
          "legacy": {
            "assignId": 3156,
            "blockType": "HTML"
          }
        }
      ]
