        {
          "components": [
            {
              "type": "richText",
              "html": "To create a smooth neckline shape, you can use a plate or bowl or any circular shape.<br>Just position the round shape on your knitted piece and mark it with chalk, or a washable marker. If it's difficult to draw on your knitting, you can hand baste with a contrasting yarn or thread.<br><mark>As a subscriber bonus, download our Neckline template </mark>\r\n\t\t<center><a href=\"/store/DigitialDownload_process.cfm?itemid=474\"><img src=\"/challenge/images/v2/93/subscriber_bonus.png\"></a>\r\n\t\t\t\r\n\t\t</center>",
              "legacyComponentId": 6634,
