    {
      "title": "Swatching on the Double Bed",
      "slug": "swatching-on-the-double-bed",
      "displayOrder": 3,
      "legacy": {
        "itemId": 439,
        "lessonOrder": 3
      },
      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "Swatching for a double bed fabric is the same as swatching single bed fabrics.<br>The goal is to mark a specific number of stitches and rows in the middle of the knitted piece to accurately measure your gauge.\r\n<br>Here are some tips for perfect double bed swatches ... no matter what stitch pattern you choose.<br>",
              "legacyComponentId": 5843,
              "order": 1
            },
            {
              "type": "video",
              "vimeoId": "151859184",
              "title": "Swatching on the Double Bed",
              "legacyComponentId": 5844,
              "order": 2
            }
          ],
          "title": "Swatching is NOT optional",
          "slug": "swatching-is-not-optional",
          "order": 1,
          "legacy": {
            "assignId": 3910,
            "blockType": "HTML"
          }
        }
      ]
    },
    {
      "title": "Binding Off",
      "slug": "binding-off",
