      },
      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "This is an easy bind off, finished on the machine, that requires no hand sewing with a tapestry needle to complete.<br>This tutorial assumes that you have basic knowledge of the ribber and can cast on and knit 1 x 1 rib.",
              "legacyComponentId": 5849,
              "order": 1
            },
            {
