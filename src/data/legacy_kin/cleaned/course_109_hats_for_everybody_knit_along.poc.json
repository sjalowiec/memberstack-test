        {
          "components": [
            {
              "type": "richText",
              "html": "<style>\r\n    div.list {\r\n        font-size: 20px;\r\n    }\r\n\r\n</style>\r\n\r\n\r\n    \r\n\r\n        <div class=\"list\">\r\n            <ul>\r\n                <li><a class=\"pattermpopup\" data-garmentid=\"2251\" data-garmenttitle=\"Mile a Minute Hat\">Basic Hat</a></li>\r\n                <li><a class=\"pattermpopup\" data-garmentid=\"2236\" data-garmenttitle=\"Mile a Minute Hat\">Mile-a-Minute Basic Hat</a></li>\r\n                <li><a class=\"pattermpopup\" data-garmentid=\"2247\" data-garmenttitle=\"Inside Out Hat\">Inside Out Hat</a></li>\r\n                <li><a class=\"pattermpopup\" data-garmentid=\"2242\" data-garmenttitle=\"Earflap Hat\">Earflap Hat</a></li>\r\n                <li><a class=\"pattermpopup\" data-garmentid=\"2245\" data-garmenttitle=\"Fisherman Rib Hat\">Fisherman Rib Hat</a></li>\r\n                <li><a class=\"pattermpopup\" data-garmentid=\"2248\" data-garmenttitle=\"Rib n Roll Slouchy Hat\">Rib 'n Roll Slouchy Hat</a></li>\r\n                <li><a class=\"pattermpopup\" data-garmentid=\"2249\" data-garmenttitle=\"Machine Knit Beret\">Machine Knit Beret</a></li>\r\n                <li><a class=\"pattermpopup\" data-garmentid=\"2246\" data-garmenttitle=\"Lucky Clochet\">Lucky Cloche</a></li>\r\n                <li><a class=\"pattermpopup\" data-garmentid=\"2249\" data-garmenttitle=\"Machine Knit Berett\">Machine Knit Beret</a> with band or hem</li>\r\n                <li><a class=\"pattermpopup\" data-garmentid=\"2243\" data-garmenttitle=\"Watch Cap\">Watch Cap</a> with band or hem</li>\r\n                <li><a class=\"pattermpopup\" data-garmentid=\"2237\" data-garmenttitle=\"Shaped Crown Beanie\">Shaped Crown Beanie</a> with band or hem</li>\r\n                <li><a class=\"pattermpopup\" data-garmentid=\"2250\" data-garmenttitle=\"Santa hat\">Santa hat</a> with band or hem</li>\r\n            </ul>\r\n        </div>\r\n    \r\n        <img src=\"/challenge/images/v2/109/hat_computer.png\">\r\n    \r\n\r\n\r\n\r\n<script language=\"JavaScript\">\r\n    $(\".pattermpopup\").click(function() {\r\n        $('#Popupcontentdiv').load('/path/actions/patterninfo.cfm?garmentid=' + $(this).attr('data-garmentid'));\r\n        $('#PopupcontentTitle').html($(this).attr('data-garmenttitle'));\r\n        $('#popupContentwindow').modal('show');\r\n        //event.preventDefault();\r\n        return false;\r\n    });\r\n\r\n</script>\r\n",
