    {
      "title": "In the Round",
      "slug": "in-the-round",
      "displayOrder": 5,
      "legacy": {
        "itemId": 708,
        "lessonOrder": 5
      },
      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "\r\n\r\n\r\nIf you have a ribber, why not knit the body of your hat in the round?<br>\r\nKnit the ribbing flat (or by hand) and knit the body in a tube.<br><em>\r\nRemember, stitch patterning is only done on the main bed. So any stitch patterning (texture or color) has to be hand-manipulated when knitting in the round.</em><br>\r\n<img class=\"img-thumbnail\" src=\"/images/glossary/tubular_knitting.jpg\">\r\n\r\n\r\n",
              "legacyComponentId": 9146,
              "order": 1
            },
            {
              "type": "video",
              "vimeoId": "151858632",
              "title": "Circular / Tubular Knitting",
              "legacySlot": 1,
              "legacyComponentId": 9147,
              "order": 2
            }
          ],
          "title": "Circular (Tubular) Knitting",
          "slug": "circular-tubular-knitting",
          "order": 1,
          "legacy": {
            "assignId": 6006,
            "blockType": "HTML"
          }
        }
      ]
    }
