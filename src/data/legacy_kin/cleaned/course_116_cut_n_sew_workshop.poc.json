        {
          "components": [
            {
              "type": "richText",
              "html": "To help keep bands from \"popping out\" and laying flat against the body, it's common practice to \"grade\" the tension as you knit the band piece(s).<br><a data-GlossaryId='617' class='glossaryhelp'>Grade the Tension <i class='fa fa-question-circle' aria-hidden='true'></i></a>\r\n\r\n<img class='img-thumbnail glossaryhelp' data-GlossaryId='617' src='https://www.knititnow.com/images/glossary/grade%20tension.png'>",
              "legacyComponentId": 9585,
              "order": 1
            }
          ],
