            {
              "type": "richText",
              "html": "<style>\r\nimg.ctr{\r\ndisplay: block;\r\nmargin-left: auto;\r\nmargin-right: auto; }\r\n</style>\r\n\r\nVisit the Knit it Now <a href=\"/books/\" target=\"_blank\">Machine Knitters Bookshelf </a>for references to current and vintage books about necklines and cut 'n sew.<br>\r\n<div class=\"box\"><a href=\"/books/60/neckline-encyclopedia\"><img class=\"image-responsive ctr\" target=\"_blank\" src=\"/challenge/images/v2/116/neckline_encyclopedia2 .jpg\"></a><br><div class=\"text-center\"></div></div>\r\n<div class=\"box\"><a href=\"/books/155/passap-cut-and-sew-collars-and-bands\"><img class=\"ctr\" target=\"_blank\" src=\"/challenge/images/v2/116/PassapBandsCover.jpg\"></a>\r\n\r\n<div class=\"text-center\"></div>\r\n\r\n</div>\r\n\r\n<div class=\"box\"><a href=\"/books/129/haute-couture-of-the-cut-and-sew-technique\"><img class=\"ctr\" target=\"_blank\" width=\"325\" src=\"/images/books/couture.jpg\"><br>\r\n<div class=\"text-center\"></div>\r\n</div>\r\n\r\n",
              "legacyComponentId": 9564,
              "order": 1
            }
          ],
