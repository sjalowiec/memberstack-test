              "legacyFields": {
                "BUTTONCSS": "btn-primary",
                "BUTTONWORDS": "I've knit my swatch, help me calculate MY gauge",
                "CHALLENGE_ASSIGNID": "6398",
                "CHALLENGE_COMPONENTID": "9852",
                "MAINTITLE": "Calculate Your Gauge",
                "SAVEROWVAR": "rows",
                "SAVESTITCHVAR": "stitches"
              },
              "legacyComponentId": 9852,
              "order": 4
            },
            {
              "type": "richText",
              "html": "<style>\r\n    table td,\r\n    table th {\r\n        font-size: smaller;\r\n        border: 1px solid black;\r\n        line-height: 1.4;\r\n        padding: 10px 10px;\r\n    }\r\n\r\n    /* Highlight the middle column */\r\n    table tr th:nth-child(2),\r\n    table tr td:nth-child(2) {\r\n        background-color: #ffffcc;\r\n    }\r\n#table1 {\r\n    border: 2px solid #333;\r\n    border-radius: 10px;\r\n    margin: 20px;\r\n    padding: 15px;\r\n    text-align: center;  /* This is new */\r\n}\r\n\r\n#table1 table {\r\n    margin: 0 auto;  /* This is new */\r\n}\r\n</style>\r\n<br>\r\n\r\n<button class=\"btn btn-primary\" onclick=\"$('#helpme').toggle()\">I need help with creating my swatch</button>\r\n\r\n\r\n\r\n    \r\n\r\n        <h3>{First}</h3>\r\n        Swatching is NOT OPTIONAL<br>\r\n\r\n        Using YOUR gauge, you will create custom knitting instructions for your Triangular Cowl by knitting a <a data-GlossaryId=\"843\" class=\"glossaryhelp\"><b>Proper Swatch </b><i class=\"fa fa-question-circle-o\" aria-hidden=\"true\"></i></a><br><h3>Don't count stitches and rows,</h3> <span class=\"yellow_highlight\">mark specific stitch and row counts <b>AS YOU KNIT</b></span><br> then you can easily measure and calculate your gauge.\r\n<div id=\"table1\">\r\n        <h3>Stitches and Rows to MEASURE</h3>\r\n        Cast on and knit enough stitches and rows to MEASURE as follows:\r\n        <table>\r\n            <tbody>\r\n                <tr>\r\n                    <th>Standard Gauge</th>\r\n                    <th>Mid-Gauge</th>\r\n                    <th>Bulky Gauge</th>\r\n                </tr>\r\n                <tr>\r\n                    <td>40 stitches</td>\r\n                    <td>30 stitches</td>\r\n                    <td>20 stitches</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>60 rows</td>\r\n                    <td>40 rows</td>\r\n                    <td>30 rows</td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n\r\n    \r\n        <div class=\"videopopup\" data-videotitle=\"Knit a Gauge Swatch in Less than 10 Minutes\" data-vimeoid=\"151858429\">\r\n            <figure><img class=\"img-thumbnail\" src=\"https://i.vimeocdn.com/video/551702088-fb8f9ff692a6f99176cce61e1efe3653b41e87cb23bc93848365f06ac8e21e26-d_1280x720?r=pad\">\r\n\r\n                <figcaption align=\"center\"><br>How to knit a <a data-GlossaryId=\"843\" class=\"glossaryhelp\"><b>\"Proper\" Swatch</b> <i class=\"fa fa-question-circle-o\" aria-hidden=\"true\"></i></a></figcaption>\r\n            </figure>\r\n            <div class=\"imagecenter text-center\"><button class=\"btn btn-sm\"><i class=\"fa fa-youtube-play fa-2x learn\" aria-hidden=\"true\"></i></button></div>\r\n        </div>\r\n    \r\n    \r\n        <div class=\"videopopup\" data-videotitle=\"Accurate Gauge Measurement\" data-vimeoid=\"260683875\">\r\n            <figure><img class=\"img-thumbnail\" src=\"https://i.vimeocdn.com/video/689477228-1ce05cd1cd42a24287bb49d746fdebbe7cf7eb07a607590360047c25ee03fe21-d_1280x720?r=pad\">\r\n\r\n                <figcaption align=\"center\"><br><b>How to Accurately Measure Gauge</b> </figcaption>\r\n            </figure>\r\n\r\n            <div class=\"imagecenter text-center\"><button class=\"btn btn-sm\"><i class=\"fa fa-youtube-play fa-2x learn\" aria-hidden=\"true\"></i></button></div>\r\n        </div>\r\n    \r\n\r\n",
