    {
      "title": "Finishing",
      "slug": "finishing",
      "displayOrder": 6,
      "legacy": {
        "itemId": 855,
        "lessonOrder": 6
      },
      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "<h3>The Magic of Finishing</h3>\r\nDon't rush these last steps! Taking your time with blocking and seaming makes all the difference. These finishing touches are what turn your knitting into pieces that look polished and professional - items you'll be proud to wear, gift or sell.<br><b>Finishing Instructions:</b>\r\n<ul>\r\n<li>Block <a data-GlossaryId=\"300\" class=\"glossaryhelp\">Blocking Wires <i class=\"fa fa-question-circle\" aria-hidden=\"true\"></i></a></li>\r\n<li>Finish edges by hand, crochet, i-cord or as desired</li>\r\n<li>Neatly seam the \"B\" edges</li>\r\n<li> <a class=\"videopopup\" data-videotitle=\"Seaming - Putting It All Together\" data-vimeoid=\"151858422\"><i class=\"fa fa-youtube-play\" aria-hidden=\"true\"></i> Mattress Stitch</a></li>\r\n\r\n</ul>\r\n",
              "legacyComponentId": 9882,
              "order": 1
            }
          ],
          "title": "The Final Touch",
          "slug": "the-final-touch",
          "order": 1,
          "legacy": {
            "assignId": 6414,
            "blockType": "HTML"
