    {
      "title": "Other uses for Cut 'n Sew",
      "slug": "other-uses-for-cut-n-sew",
      "displayOrder": 4,
      "legacy": {
        "itemId": 460,
        "lessonOrder": 4
      },
      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "Fast finishing, accurate size for the opening. Use Cut 'n Sew to form the center opening for your Tree Skirt. <br>\r\n\r\n<a href=\"/challenge/14/course/christmas-tree-skirt\" target=\"_blank\"><figure><img class=\"img-thumbnail\" src=\"/challenge/images/v2/71/tree_skirt/tree_skirt.png\"><figcaption align=\"center\"><br>Complete Course for knitting your own skirt</figcaption>\r\n</figure></a>\r\n\r\n",
              "legacyComponentId": 5905,
              "order": 1
            }
          ],
          "title": "Christmas Tree Skirt",
          "slug": "christmas-tree-skirt",
          "order": 1,
          "legacy": {
            "assignId": 3944,
            "blockType": "HTML"
          }
        },
        {
          "components": [
            {
              "type": "richText",
              "html": "A pillow project that is fast, fast, fast! Use the cut 'n sew technique to create a heart shape. Put your serger or sewing machine to work and have a gift or a craft fair item in no time!<br>We knit a Valentine pillow, but consider other shapes ... how about a tooth shape for a Tooth Fairy Pillow?<br>You can knit in any stitch pattern, fairisle,stripes, tuck, slip or intarsia. Long floats aren't a problem and you don't have to worry about shaping and working a stitch pattern at the same time.<br>\r\n\r\n<figure>\r\n\r\n\r\n<a href=\"/path/176/heavenly-hearts\"><img class=\"img-thumbnail\" src=\"/path/images/101/Heart_pillow_final.jpg\">\r\n<figcaption align=\"center\"><br>Heavenly Hearts Quick Win</figcaption>\r\n</figure>\r\n</a>\r\n\r\n\r\n\r\n",
              "legacyComponentId": 5907,
              "order": 1
            }
          ],
          "title": "Pillow Shapes",
          "slug": "pillow-shapes",
          "order": 2,
          "legacy": {
            "assignId": 3945,
            "blockType": "HTML"
          }
        }
      ]
    }
