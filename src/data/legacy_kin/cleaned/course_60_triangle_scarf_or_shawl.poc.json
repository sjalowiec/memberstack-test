            "blockType": "HTML"
          }
        },
        {
          "components": [
            {
              "type": "richText",
              "html": "<span class=\"handwriting\" style=\"font-size:2em\">Simple, Quick Shaping </span><br>\r\n<span class=\"handwriting\" style=\"font-size:1.5em\">Every 2 rows, Every 3 rows, or Every 4 rows .. your choice.</span>\r\n\r\n<div class=\"no-print\"><br><i class=\"fa fa-hand-o-right no-print\" aria-hidden=\"true\"></i> Control the finished size of your scarf by adjusting the number of needles used.</div> \r\n",
