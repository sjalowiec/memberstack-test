            "blockType": "HTML"
          }
        },
        {
          "components": [
            {
              "type": "richText",
              "html": "Plain or fancy, there are many ways to work increases and decreases on the machine.  Here are some basics.",
              "legacyComponentId": 5617,
              "order": 1
            },
            {
              "type": "video",
              "vimeoId": "151858451",
              "title": "KISS Increases (automatic)",
              "legacySlot": 1,
              "legacyComponentId": 5616,
              "order": 2
            },
            {
              "type": "video",
              "vimeoId": "151858447",
              "title": "Basic Increasing and Decreasing",
              "legacySlot": 2,
              "legacyComponentId": 5616,
              "order": 2
            }
          ],
          "title": "Increases and Decreases",
          "slug": "increases-and-decreases",
          "order": 2,
          "legacy": {
            "assignId": 3761,
            "blockType": "HTML"
          }
        },
        {
          "components": [
