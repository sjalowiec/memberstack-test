        {
          "components": [
            {
              "type": "richText",
              "html": "Use a fabulous variegated yarn or mix 'n match textures and colors ... get creative and make it your own!<br>\r\n",
              "legacyComponentId": 1459,
              "order": 1
            },
            {
              "type": "migrationPending",
