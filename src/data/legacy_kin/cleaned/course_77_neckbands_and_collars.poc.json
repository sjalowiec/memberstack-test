  "lessons": [
    {
      "title": "Neckline shaping Perfection",
      "slug": "neckline-shaping-perfection",
      "displayOrder": 1,
      "legacy": {
        "itemId": 489,
        "lessonOrder": 1
      },
      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "\r\nFor this Knit-along, we are assuming that you have perfected neckline shaping (or cut 'n sew).<br>There's no point in exploring neckbands and collars before you are ready.<br>We've included some helpful tutorials with this Knit-along, but the <a href=\"/challenge/21/course/neckline-shaping-practice\" target=\"_blank\">Neckline Practice course</a> goes into depth on the subject.\r\n<a href=\"/challenge/21/course/neckline-shaping-practice  target=\"_blank\"><img src=\"/challenge/images/v2/77/neckline_course.png\"></a>\r\nIf necklines have you stumped ... please consider the complete Neckline Practice course<br>\r\n\r\n\r\n\r\n",
              "legacyComponentId": 6171,
              "order": 1
            }
          ],
          "title": "Are you confident?",
          "slug": "are-you-confident",
          "order": 1,
          "legacy": {
            "assignId": 4077,
            "blockType": "HTML"
          }
        },
        {
          "components": [
