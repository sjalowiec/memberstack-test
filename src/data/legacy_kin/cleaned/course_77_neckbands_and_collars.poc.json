    {
      "title": "Neckbands",
      "slug": "neckbands",
      "displayOrder": 2,
      "legacy": {
        "itemId": 488,
        "lessonOrder": 2
      },
      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "There are many options for adding doubled bands to the edges of our sweaters.<br><ol>\r\n<li>One-piece bands\r\n<ul>\r\n<li>Rehang the garment edge with the WRONG side facing. When the band is complete, secure it to the wrong side of the knitting by binding off or stitching it down</li>\r\n<li>Rehang the garment edge with the RIGHT side facing.  When the band is complete, secure it to the right side of the knitting by neatly stitching it in place</li>\r\n</ul>\r\n</li><br>\r\n<li>\"Sandwich\" bands<br>\r\nKnit the band in 2 pieces \"sandwiching\" the edge of the sweater between the layers.  This is often called an Industrial Band</li>\r\n</ul>\r\n</ol>",
              "legacyComponentId": 6191,
              "order": 1
            },
            {
              "type": "video",
              "vimeoId": "151860086",
              "title": "One Piece Neckband Perfection",
              "legacySlot": 1,
              "legacyComponentId": 6175,
              "order": 2
            },
            {
              "type": "video",
              "vimeoId": "223374072",
              "title": "Reversible Band",
              "legacySlot": 2,
              "legacyComponentId": 6175,
              "order": 2
            },
            {
              "type": "video",
              "vimeoId": "345492301",
              "title": "2 Piece Industrial Band",
              "legacySlot": 3,
              "legacyComponentId": 6175,
              "order": 2
            },
            {
              "type": "richText",
              "html": "<i class=\"fa fa-lightbulb-o\" aria-hidden=\"true\"></i> Jump to the 4:38 point in this video<br> for bands folded to and finished from the right (public side) ",
              "legacyComponentId": 6192,
              "order": 3
            }
          ],
