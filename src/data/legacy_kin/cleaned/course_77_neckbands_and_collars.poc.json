        {
          "components": [
            {
              "type": "richText",
              "html": "<style>\r\nhr.style13 {\r\nheight: 10px;\r\nborder: 0;\r\nbox-shadow: 0 10px 10px -10px #8c8b8b inset;\r\n}\r\n\r\n</style>\r\n\r\n\t\t<h3>Add a hood to any pattern</h3><img class=\"videopopup\" data-vimeoid=\"203390158\" src=\"/challenge/images/v2/77/hood_thumb.jpg\">\r\n\t\r\n<hr class=\"style13\">\r\n\t\t<h3>Hood Classroom</h3>\r\n\t\t<a href=\"/classrooms/133/add-a-hood-to-any-pattern\"><img class=\"responsive\" src=\"/path/images/133/hood_thumb.jpg\"></a><br>\r\n\t\r\n\t\t\t\r\n\r\n",
              "legacyComponentId": 6179,
