        },
        {
          "components": [
            {
              "type": "richText",
              "html": "Create a hood for your sweater - let Knit it Now do the math for you",
              "legacyComponentId": 6190,
              "order": 1
            },
            {
              "type": "migrationPending",
              "legacyType": "tools",
              "notes": [
                "Unmapped legacy component type: tools"
              ],
              "legacyFields": {
                "CHALLENGE_ASSIGNID": "4089",
