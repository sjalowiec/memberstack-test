      },
      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "<p class=\"lead\">Make your choices, enter your gauge and VOILA!  NO MATH!</p><br>",
              "legacyComponentId": 730,
              "order": 1
            },
            {
