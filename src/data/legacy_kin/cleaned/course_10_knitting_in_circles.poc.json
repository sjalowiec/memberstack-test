        },
        {
          "components": [
            {
              "type": "richText",
              "html": "Short Row Blanket: Knit flat<br>\r\nShort Row Pillow: Knit with shaping on both edges to make a dimensional piece to cover a pillow form</br>\r\n<br>\r\n\r\nNot enough needles for the pinwheel style?  Consider knitting wedges with the Increase/Decrease method instead.",
              "legacyComponentId": 733,
              "order": 1
            },
            {
              "type": "migrationPending",
