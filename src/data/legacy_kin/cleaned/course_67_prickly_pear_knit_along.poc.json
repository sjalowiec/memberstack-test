              "type": "richText",
              "html": "<a href=\"/LiveEvent/143/prickly-pear-qanda-live-03-11-2020\"><img src=\"/challenge/images/v2/67/prickly_live1.jpg\"></a><br><a href=\"/LiveEvent/144/prickly-pear-qanda-live-03-18-2020\"><img src=\"/challenge/images/v2/67/prickly_live2.jpg\"></a><br><a href=\"/LiveEvent/145/prickly-pear-qanda-live-03-25-2020\"><img src=\"/challenge/images/v2/67/prickly_live3.jpg\"></a>",
              "legacyComponentId": 5768,
