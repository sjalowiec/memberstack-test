    {
      "title": "Heel and Toe Techniques",
      "slug": "heel-and-toe-techniques",
      "displayOrder": 40,
      "legacy": {
        "itemId": 208,
        "lessonOrder": 40
      },
      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "Machine knitting instructors and patterns will often assume that you know what \"place needles in hold\" means.<br>For new machine knitters (especially those who hand knit) this can be a mysterious instruction.<br>Watch as we explore this basic skill on different machines. Then work the practice exercises before you start working the toes and heels of your socks.",
              "legacyComponentId": 2906,
              "order": 1
            },
            {
              "type": "video",
              "vimeoId": "287184263",
              "title": "Back to Basics: Hold Positon",
              "legacyComponentId": 2909,
              "order": 2
            }
          ],
          "title": "Place Needles in Hold",
          "slug": "place-needles-in-hold",
          "order": 1,
          "legacy": {
            "assignId": 1052,
            "blockType": "HTML"
          }
        },
        {
          "components": [
            {
              "type": "download",
