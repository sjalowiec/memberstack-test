    {
      "title": "Exercise 3 : Seam the Shoulders",
      "slug": "exercise-3-seam-the-shoulders",
      "displayOrder": 4,
      "legacy": {
        "itemId": 833,
        "lessonOrder": 4
      },
      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "Joining shoulders seams on the machine creates a tidy seam and stabilizes the garment shoulders.\r\nThis is the machine knitting version of the hand knitting 3-needle bind off.<br><ol>\r\n<li>Swatch 1: With the <b>public (right) side facing</b>, rehang the held stitches on the machine. Push the stitches behind the latches</li>\r\n<li>Swatch 2: With the <b>private (wrong) side facing</b>, rehang the held stitches IN THE LATCHES.</li>\r\n<li>Close the latches</li>\r\n<li>Carefully pull the stitches in the latches thru the other stitches</li>\r\n<li>Loosely bind off with the method of your choice</li>\r\n</ol>\r\n\r\n\r\n<figure><img src=\"/challenge/images/v2/123/seam1.jpg\">\r\n<figcaption align=\"center\">Seam with Right (public) sides together</figcaption>\r\n</figure>",
              "legacyComponentId": 9738,
