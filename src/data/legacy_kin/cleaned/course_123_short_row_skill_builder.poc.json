            {
              "type": "richText",
              "html": "\r\n\r\n    <b><i class=\"fa fa-hand-o-down\" aria-hidden=\"true\"></i> Use the tabs below to explore different methods for adding shaped shoulders. <i class=\"fa fa-hand-o-down fa-2x\" aria-hidden=\"true\"></i></b>\r\n\r\n<!--col -->\r\n\r\n<!--row -->\r\n<!-- Nav tabs -->\r\n<ul class=\"nav nav-tabs\" role=\"tablist\">\r\n    <li role=\"presentation\" class=\"active\"><a href=\"#kinSection\" aria-controls=\"kinSection\" role=\"tab\" data-toggle=\"tab\"><i class=\"fa fa-hand-o-right fa-2x\" aria-hidden=\"true\"></i> <span style=\"font-size:1.5em\">Knit it Now Patterns</span></a></li>\r\n    <li role=\"presentation\"><a href=\"#mathSection\" aria-controls=\"mathSection\" role=\"tab\" data-toggle=\"tab\"><i class=\"fa fa-hand-o-right fa-2x\" aria-hidden=\"true\"></i><span style=\"font-size:1.5em\"> Commercial Patterns + Math</span></a></li>\r\n    <li role=\"presentation\"><a href=\"#deviceSection\" aria-controls=\"deviceSection\" role=\"tab\" data-toggle=\"tab\"><i class=\"fa fa-hand-o-right fa-2x\" aria-hidden=\"true\"></i> <span style=\"font-size:1.5em\">Charting Device</span></a></li>\r\n    <li role=\"presentation\"><a href=\"#dakSection\" aria-controls=\"dakSection\" role=\"tab\" data-toggle=\"tab\"><i class=\"fa fa-hand-o-right fa-2x\" aria-hidden=\"true\"></i> <span style=\"font-size:1.5em\">DesignaKnit</span></a></li>\r\n</ul>\r\n\r\n<div class=\"tab-content\">\r\n\r\n    <!--- inital wording \r\n\t <div role=\"tabpanel\" class=\"tab-pane active\" id=\"welcome\">\r\n\t\t\r\n\t\t\t<br>\r\n\t\t\r\n\t</div>\r\n\t--->\r\n    <!--- kinSection --->\r\n    <div role=\"tabpanel\" class=\"tab-pane active\" id=\"kinSection\">\r\n        <br><blockquote class=\"smallblock\">Knit it Now Dynamic Patterns offer shaped shoulder versions.\r\n                If you need more shaping, think of the armhole as a block of instructions to be adjusted without changing the depth of the armhole or impacting the fit of the sleeves. Use the Magic Formula to calculate the shoulder shaping. </blockquote>\r\n            <div class='embed-video-container'>\n<iframe src='https://player.vimeo.com/video/268097987' frameborder='0' webkitAllowFullScreen mozallowfullscreen allowFullScreen></iframe>\n</div>\r\n        \r\n    </div>\r\n\r\n    <!--- mathSection --->\r\n    <div role=\"tabpanel\" class=\"tab-pane\" id=\"mathSection\">\r\n        <br><blockquote class=\"smallblock\">To add shoulder shaping to a commercial pattern, think of the armhole as a block of instructions to be adjusted without changing the depth of the armhole or impacting the fit of the sleeves.Use the Magic Formula to accurately calculate the shaping. </blockquote>\r\n        \r\n\r\n            <div class='embed-video-container'>\n<iframe src='https://player.vimeo.com/video/268099100' frameborder='0' webkitAllowFullScreen mozallowfullscreen allowFullScreen></iframe>\n</div>\r\n        \r\n    </div>\r\n\r\n    <!--- deviceSection --->\r\n    <div role=\"tabpanel\" class=\"tab-pane\" id=\"deviceSection\">\r\n        \r\n            <br><blockquote class=\"smallblock\">Using a Charting Device is probably the easiest way to add shaped shoulders ... just be sure that the armhole opening and sleeve cap match!</blockquote><br>\r\n        \r\n\r\n        \r\n            <img width=\"300\" src=\"/challenge/images/v2/123/nothing_fits/add_a_dart.jpg\">\r\n        \r\n    </div>\r\n\r\n    <div role=\"tabpanel\" class=\"tab-pane\" id=\"dakSection\">\r\n\r\n        <br><blockquote class=\"smallblock\">Explore a couple of methods of using DAK to adjust your sleeve length.</blockquote>\r\n            <div class='embed-video-container'>\n<iframe src='https://player.vimeo.com/video/268039723' frameborder='0' webkitAllowFullScreen mozallowfullscreen allowFullScreen></iframe>\n</div>\r\n        \r\n    </div>\r\n</div>\r\n\r\n\r\n\r\n<div class=\"clearfix\"></div>\r\n",
