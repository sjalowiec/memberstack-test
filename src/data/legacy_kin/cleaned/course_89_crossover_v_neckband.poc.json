          "slug": "the-practice-pattern",
          "order": 1,
          "legacy": {
            "assignId": 4343,
            "blockType": "HTML"
          }
        },
        {
          "components": [
            {
              "type": "richText",
              "html": "<b>You can modify any V-neck pattern for the Crossover band finish.</b><br><ol>\r\n<li>\r\nAt the point of the V remove 1\" of stitches.  This is equal to the desired width of your band.<br>Don't forget <a data-GlossaryId='605' class='glossaryhelp'>Seaming Stitches <i class='fa fa-question-circle' aria-hidden='true'></i></a> </li><br>\r\n\r\n<li>Use the <a data-GlossaryId='333' class='glossaryhelp'>Magic Formula <i class='fa fa-question-circle' aria-hidden='true'></i></a> to re-calculate the v-neck decreases.</li>\r\n</ol><br>",
              "legacyComponentId": 6560,
              "order": 1
            },
            {
              "type": "video",
              "vimeoId": "585552117",
              "title": null,
              "legacyComponentId": 6561,
              "order": 2
            }
          ],
          "title": "Use ANY Pattern",
          "slug": "use-any-pattern",
          "order": 2,
          "legacy": {
            "assignId": 4331,
            "blockType": "HTML"
          }
        }
      ]
    },
    {
