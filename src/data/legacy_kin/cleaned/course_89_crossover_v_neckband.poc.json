      "blocks": [
        {
          "components": [
            {
              "type": "richText",
              "html": "\r\n\t\r\n<a class='videopopup' data-vimeoid='587198832'><img class='img-thumbnail' src='/challenge/images/v2/89/intro (Time 0_00_00;00).png'>\r\n<div class=\"imagecenter text-center\"><button class=\"btn btn-success\"><i class=\"fa fa-youtube-play\" aria-hidden=\"true\"></i></button></div></a>\r\n<img src=\"/challenge/images/v2/89/crossover_gif2.gif\" width=\"50%\"><br>\r\n\r\n<!-- replace this video after the Knitalong is over  587199093-->\r\n",
              "legacyComponentId": 6542,
