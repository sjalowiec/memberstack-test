                "CHALLENGE_COMPONENTID": "6579",
                "GARMENTID": "679",
                "LABLE": "<i class='fa fa-cubes' aria-hidden='true'></i>",
                "TOPTEXT": "<div class=\"well\">The Practice Necklines pattern has many pieces.  For the Crossover neckline use pieces 9 and 10.<br><center> <img class=\"img-responsive\" src=\"/challenge/images/v2/89/pattern_pieces.jpg\"></center></div>"
              },
              "legacyComponentId": 6579,
