---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Member Test">
  <section class="container" style="padding: 2rem 1rem;">
    <h1>Member Test Page</h1>

    <!-- Logged OUT -->
    <div data-ms-content="!members">
      <p>You are LOGGED OUT</p>
    </div>

    <!-- Logged IN -->
    <div data-ms-content="members">
      <p>You are LOGGED IN</p>
    </div>

    <div style="margin-top: 1rem;">
      <a href="#" data-ms-modal="login" data-ms-redirect="current-url">Log in</a>
      <a href="#" data-ms-modal="signup" data-ms-redirect="current-url">Sign up</a>
      <a href="#" data-ms-action="logout">Log out</a>
    </div>
  </section>
</Layout>