---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

const pageTitle = "Access Your New Knit It Now Account";
const description =
  "Sign in or reset your password to access your Knit It Now beta account on the new platform.";
---

<Layout
  title={`${pageTitle} | Knit it Now`}
  description={description}
  bodyClass="page--tight-header"
  skipGlobalHyvor={true}
>
  <section class="container py-5 beta-signup-page">
    <h1 class="beta-signup-page__page-heading">{pageTitle}</h1>

    <div class="beta-signup-page__grid">
      <div class="beta-signup-page__col beta-signup-page__col--notepad">
        <div class="beta-signup-page__notebook-wrapper">
          <div class="beta-signup-page__notebook">
            <div class="beta-signup-page__sheet">
              <h2 class="beta-signup-page__greeting">Hi there,</h2>

              <p class="beta-signup-page__text">Welcome to the Knit It Now beta.</p>

              <p class="beta-signup-page__text">
                Your account on the new platform may already be ready. Use the sign-in option on this page,
                or reset your password if you need to.
              </p>

              <p class="beta-signup-page__text">
                <strong>Please use the same email address you currently use for your Knit It Now membership.</strong>
                This helps you reach the right account and keeps your member benefits connected.
              </p>

              <p class="beta-signup-page__text">Once you’re in, take a look around and explore when you can.</p>

              <p class="beta-signup-page__text">Thank you for helping shape what comes next.😊</p>

             
              <img
                class="beta-signup-page__signature"
                src="/images/sue-signature.svg"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="beta-signup-page__col beta-signup-page__col--form">
        <article class="kbm-card beta-signup-page__signup-card" aria-labelledby="beta-signup-access-heading">
          <h2 id="beta-signup-access-heading" class="kbm-card__title beta-signup-page__signup-card-title">
            {pageTitle}
          </h2>
          <p class="kbm-card__desc beta-signup-page__signup-card-intro">
            Your new Knit It Now account may already be set up. Use the sign-in option below, or reset
            your password if needed.
          </p>

          <p class="beta-signup-page__existing-member-note">
            If your email is already recognized, that’s good news. It means your account is already in
            the new system. Sign in or reset your password to continue.
          </p>

          <div class="beta-signup-page__signin-primary">
            <a
              href="#"
              data-ms-modal="login"
              data-ms-redirect="/beta-welcome"
              class="kbm-btn kbm-btn-primary beta-signup-page__signin-btn">Sign in instead</a
            >
          </div>

          <div class="beta-signup-page__signup-section" aria-labelledby="beta-signup-form-heading">
            <h3 id="beta-signup-form-heading" class="beta-signup-page__signup-section-title">
              New to this beta? Create an account
            </h3>

          <form data-ms-form="signup" class="beta-signup-form">
            <div
              id="beta-signup-existing-account"
              class="beta-signup-page__form-alert"
              role="alert"
              aria-live="polite"
              hidden
            >
              <p>
                It looks like this email already has an account. Please use Sign in instead above. If you
                don’t know your password, use the password reset option.
              </p>
            </div>

            <div class="form-group">
              <label for="beta-first-name">First Name</label>
              <input
                id="beta-first-name"
                type="text"
                data-ms-member="first-name"
                autocomplete="given-name"
              />
            </div>

            <div class="form-group">
              <label for="beta-email">Email Address</label>
              <input
                id="beta-email"
                type="email"
                data-ms-member="email"
                autocomplete="email"
                required
              />
            </div>

            <div class="form-group">
              <label for="beta-password">Create Password</label>
              <input
                id="beta-password"
                type="password"
                data-ms-member="password"
                autocomplete="new-password"
                required
                aria-describedby="beta-password-hint"
              />
              <p class="beta-signup-page__field-hint" id="beta-password-hint">
                Password must be at least 8 characters.
              </p>
            </div>

            <!-- TODO: Replace PLAN_OR_PRICE_ID with the actual Memberstack ID for KIN Beta Access if needed -->
            <input type="hidden" data-ms-plan:add="pln_kin-beta-access-vyek0a38" />

            <button type="submit" class="kbm-btn kbm-btn-outline beta-signup-page__submit">
              Create account
            </button>
          </form>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    const page = document.querySelector(".beta-signup-page");
    const form = page?.querySelector('form[data-ms-form="signup"]');
    const alertEl = document.getElementById("beta-signup-existing-account");
    if (!page || !form || !alertEl) return;

    const MS_ERROR_SELECTOR = '[data-ms-message="error"], .ms-error-message';
    const MS_TOAST_SELECTOR = '[data-ms-message="error"], [role="alert"]';
    const MS_TOAST_ROOT = "memberstack-prebuilt-ui";
    const EXISTING_EMAIL_RE =
      /email-already-in-use|email\s+already\s+(in\s+use|exists|taken|registered)|member\s+already\s+exists/i;
    const MS_ERROR_MAX_LEN = 160;

    function textLooksLikeExistingEmail(text) {
      const t = (text || "").trim();
      return t.length > 0 && t.length <= MS_ERROR_MAX_LEN && EXISTING_EMAIL_RE.test(t);
    }

    function payloadLooksLikeExistingEmail(payload) {
      if (!payload || typeof payload !== "object") return false;
      const rec = payload;
      const code = rec.code || rec.errorCode || rec.error?.code;
      if (code === "email-already-in-use") return true;
      const parts = [rec.message, rec.error?.message, rec.errorMessage, rec.error?.errorMessage];
      return textLooksLikeExistingEmail(parts.filter(Boolean).join(" "));
    }

    function hideMemberstackNotification(el) {
      if (!el || el === alertEl || alertEl.contains(el)) return;
      el.textContent = "";
      el.setAttribute("hidden", "");
      el.style.setProperty("display", "none", "important");
    }

    function dismissMemberstackNotifications() {
      const top = document.getElementById("msTopError");
      if (top) top.hidden = true;

      form.querySelectorAll(MS_ERROR_SELECTOR).forEach(function (el) {
        if (textLooksLikeExistingEmail(el.textContent)) hideMemberstackNotification(el);
      });

      const prebuilt = document.querySelector(MS_TOAST_ROOT);
      if (!prebuilt?.shadowRoot) return;

      prebuilt.shadowRoot.querySelectorAll(MS_TOAST_SELECTOR).forEach(function (el) {
        if (textLooksLikeExistingEmail(el.textContent)) hideMemberstackNotification(el);
      });
    }

    function showExistingAccountAlert() {
      alertEl.hidden = false;
      document.body.classList.add("beta-signup-existing-account-error");
      dismissMemberstackNotifications();
      window.setTimeout(dismissMemberstackNotifications, 50);
      window.setTimeout(dismissMemberstackNotifications, 250);
    }

    function hideExistingAccountAlert() {
      alertEl.hidden = true;
      document.body.classList.remove("beta-signup-existing-account-error");
    }

    function checkForInlineMemberstackErrors() {
      const formErrors = form.querySelectorAll(MS_ERROR_SELECTOR);
      for (let i = 0; i < formErrors.length; i++) {
        if (textLooksLikeExistingEmail(formErrors[i].textContent)) {
          showExistingAccountAlert();
          return true;
        }
      }

      const prebuilt = document.querySelector(MS_TOAST_ROOT);
      if (prebuilt?.shadowRoot) {
        const toastErrors = prebuilt.shadowRoot.querySelectorAll(MS_TOAST_SELECTOR);
        for (let j = 0; j < toastErrors.length; j++) {
          if (textLooksLikeExistingEmail(toastErrors[j].textContent)) {
            showExistingAccountAlert();
            return true;
          }
        }
      }

      return false;
    }

    form.addEventListener("submit", function () {
      hideExistingAccountAlert();
    });

    form.addEventListener(
      "input",
      function (e) {
        const target = e.target;
        if (target && target.matches && target.matches('[data-ms-member="email"]')) {
          hideExistingAccountAlert();
        }
      },
      true,
    );

    const domObserver = new MutationObserver(function () {
      checkForInlineMemberstackErrors();
    });
    domObserver.observe(form, { childList: true, subtree: true, characterData: true });

    function observePrebuiltUi() {
      const prebuilt = document.querySelector(MS_TOAST_ROOT);
      if (!prebuilt?.shadowRoot || prebuilt.dataset.betaSignupObserved) return;
      prebuilt.dataset.betaSignupObserved = "1";
      domObserver.observe(prebuilt.shadowRoot, {
        childList: true,
        subtree: true,
        characterData: true,
      });
      checkForInlineMemberstackErrors();
    }

    observePrebuiltUi();

    const bodyObserver = new MutationObserver(function (mutations) {
      for (let m = 0; m < mutations.length; m++) {
        const added = mutations[m].addedNodes;
        for (let n = 0; n < added.length; n++) {
          const node = added[n];
          if (node.nodeType !== 1) continue;
          if (
            node.matches?.(MS_TOAST_ROOT) ||
            node.querySelector?.(MS_TOAST_ROOT)
          ) {
            observePrebuiltUi();
            return;
          }
        }
      }
    });
    bodyObserver.observe(document.body, { childList: true });

    const origFetch = window.fetch;
    if (typeof origFetch === "function") {
      window.fetch = async function () {
        const res = await origFetch.apply(this, arguments);
        if (!page.isConnected) return res;

        try {
          const req = arguments[0];
          const init = arguments[1] || {};
          const url = typeof req === "string" ? req : req?.url || "";
          const method = String(init.method || (typeof req !== "string" && req?.method) || "GET").toUpperCase();

          if (/memberstack/i.test(url) && method === "POST" && !/login/i.test(url) && !res.ok) {
            const clone = res.clone();
            let body = null;
            try {
              body = await clone.json();
            } catch (e) {
              body = null;
            }
            if (payloadLooksLikeExistingEmail(body)) {
              showExistingAccountAlert();
            }
          }
        } catch (e) {}

        return res;
      };
    }
  })();
</script>

<style>
  .beta-signup-page {
    --beta-signup-paper-bg: #fff;
    --beta-signup-line-color: #cfe3ff;
    --beta-signup-margin-line: #e15252;
    --beta-signup-text: #1f2d3d;
    --beta-signup-shadow: rgba(16, 24, 40, 0.12);
    /* Ruled notebook lines (unchanged visually) */
    --beta-signup-line-spacing: 32px;
    /* Tighter vertical rhythm for body copy */
    --beta-signup-body-gap: 18px;
    --beta-signup-pad: 24px;
    --beta-signup-notepad-maxw: 720px;
    --beta-signup-radius: 10px;

    max-width: 1120px;
    margin-left: auto;
    margin-right: auto;
    padding-bottom: 2.5rem;
  }

  .beta-signup-page__page-heading {
    font-size: var(--text-xxl, 1.75rem);
    font-weight: 600;
    color: var(--kbm-green, #52682d);
    text-align: center;
    margin: 0 0 1.5rem;
    line-height: 1.2;
  }

  .beta-signup-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .beta-signup-page__grid {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
      gap: 2rem;
    }
  }

  .beta-signup-page__notebook-wrapper {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    padding: 0;
  }

  .beta-signup-page__notebook {
    position: relative;
    max-width: var(--beta-signup-notepad-maxw);
    width: 100%;
    border-radius: var(--beta-signup-radius);
    background:
      repeating-linear-gradient(
        to bottom,
        var(--beta-signup-paper-bg) 0,
        var(--beta-signup-paper-bg) calc(var(--beta-signup-line-spacing) - 1px),
        var(--beta-signup-line-color) calc(var(--beta-signup-line-spacing) - 1px),
        var(--beta-signup-line-color) var(--beta-signup-line-spacing)
      );
    box-shadow: 0 12px 30px var(--beta-signup-shadow);
    overflow: hidden;
  }

  @media (min-width: 960px) {
    .beta-signup-page__col--notepad .beta-signup-page__notebook {
      max-width: none;
    }
  }

  .beta-signup-page__notebook::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 64px;
    width: 2px;
    background: linear-gradient(var(--beta-signup-margin-line), var(--beta-signup-margin-line));
    opacity: 0.9;
    pointer-events: none;
  }

  .beta-signup-page__sheet {
    padding: var(--beta-signup-pad) calc(var(--beta-signup-pad) + 6px);
    padding-left: calc(64px + var(--beta-signup-pad));
    background: transparent;
    color: var(--beta-signup-text);
    font-family: inherit;
  }

  .beta-signup-page__greeting {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 var(--beta-signup-body-gap);
    line-height: 1.25;
    color: var(--beta-signup-text);
    font-family: inherit;
  }

  .beta-signup-page__text {
    margin: 0 0 var(--beta-signup-body-gap);
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--beta-signup-text);
    font-family: inherit;
  }

  .beta-signup-page__signoff {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
    line-height: 1.4;
    font-style: italic;
    color: var(--beta-signup-text);
    font-family: inherit;
  }

  /* +25% from min(56px, 21%); scales with sheet so it stays inside notepad */
  .beta-signup-page__signature {
    display: block;
    max-width: min(70px, 26.25%);
    width: auto;
    height: auto;
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .beta-signup-page__signup-card {
    padding: 1.5rem 1.25rem 1.75rem;
    font-family: inherit;
  }

  @media (min-width: 480px) {
    .beta-signup-page__signup-card {
      padding: 1.75rem 1.75rem 2rem;
    }
  }

  .beta-signup-page__signup-card :where(.kbm-card__title, .kbm-card__desc) {
    font-family: inherit;
  }

  .beta-signup-page__signup-card .beta-signup-form {
    font: inherit;
    font-family: inherit;
  }

  .beta-signup-page__signup-card
    .beta-signup-form
    :where(label, input, button, textarea, select, small, div, span, p, a) {
    font-family: inherit;
  }

  .beta-signup-page__signup-card .beta-signup-form :where(label, input, button, textarea, select, small) {
    font-size: inherit;
  }

  .beta-signup-page__signup-card .beta-signup-form input::placeholder {
    font: inherit;
    font-family: inherit;
  }

  .beta-signup-page__signup-card .beta-signup-form input::-webkit-input-placeholder {
    font: inherit;
    font-family: inherit;
  }

  .beta-signup-page__signup-card :where([data-ms-message], .ms-error-message) {
    font-family: inherit;
    font-size: inherit;
  }

  .beta-signup-page__signup-card-title {
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .beta-signup-page__signup-card-intro {
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .beta-signup-page__signin-primary {
    margin: 0 0 1.5rem;
  }

  .beta-signup-page__signin-btn {
    display: flex;
    width: 100%;
    justify-content: center;
    font-family: inherit;
    font-size: inherit;
    text-decoration: none;
  }

  .beta-signup-page__signup-section {
    padding-top: 1.25rem;
    border-top: 1px solid #d5dfc8;
  }

  .beta-signup-page__signup-section-title {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: #243015;
    text-align: center;
    font-family: inherit;
    line-height: 1.3;
  }

  .beta-signup-page__existing-member-note {
    margin: 0 0 1.25rem;
    padding: 0.75rem 0.85rem;
    font-size: 0.95em;
    line-height: 1.45;
    color: #3d4a30;
    background: #f4f7ef;
    border: 1px solid #d5dfc8;
    border-radius: 8px;
    text-align: center;
    font-family: inherit;
  }

  .beta-signup-page__form-alert {
    margin: 0 0 1rem;
    padding: 0.75rem 0.85rem;
    font-size: 0.95em;
    line-height: 1.5;
    color: #3d4a30;
    background: #faf8f2;
    border: 1px solid #d9c9a8;
    border-radius: 8px;
    text-align: center;
    font-family: inherit;
  }

  .beta-signup-page__form-alert p {
    margin: 0;
  }

  .beta-signup-page__form-alert[hidden] {
    display: none !important;
  }

  body.beta-signup-existing-account-error #msTopError {
    display: none !important;
  }

  .beta-signup-page .beta-signup-form .form-group {
    margin-bottom: 1rem;
  }

  .beta-signup-page .beta-signup-form label {
    display: block;
    font-weight: 600;
    font-size: inherit;
    color: #243015;
    margin-bottom: 0.35rem;
    font-family: inherit;
  }

  .beta-signup-page .beta-signup-form input[type="text"],
  .beta-signup-page .beta-signup-form input[type="email"],
  .beta-signup-page .beta-signup-form input[type="password"] {
    width: 100%;
    box-sizing: border-box;
    padding: 0.65rem 0.85rem;
    font-size: inherit;
    border: 1px solid #c5ceb8;
    border-radius: 10px;
    background: #fff;
    color: #1a1f12;
    font-family: inherit;
  }

  .beta-signup-page .beta-signup-form input:focus {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }

  .beta-signup-page__field-hint {
    margin: 0.35rem 0 0;
    font-size: 0.9em;
    line-height: 1.45;
    color: #4a5638;
    font-family: inherit;
  }

  .beta-signup-page__submit {
    width: 100%;
    margin-top: 0.5rem;
    justify-content: center;
    font-family: inherit;
    font-size: inherit;
  }

</style>
