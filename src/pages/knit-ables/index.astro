---
// Request-time schedule. A build-time date check would stay cached until the next deploy.
export const prerender = false;

import { knitAbleSlugFromPath } from "../../lib/knit-ables/schedule";
import Layout from "../../layouts/Layout.astro";
import FavoriteStar from "../../components/favorites/FavoriteStar.astro";
import FavoritesRuntime from "../../components/favorites/FavoritesRuntime.astro";
import { applyKnitAbleCacheHeaders } from "../../lib/knit-ables/pageAccess";
import { KNIT_ABLES_CANONICAL_URL } from "../../lib/knit-ables/knitAblesLanding";
import { listPublicKnitAbleCards } from "../../lib/knit-ables/scheduleStore";

applyKnitAbleCacheHeaders(Astro.response.headers);

let loadError: string | null = null;
let publicCards: Awaited<ReturnType<typeof listPublicKnitAbleCards>> = [];

try {
  publicCards = await listPublicKnitAbleCards();
} catch (error) {
  console.error(
    "[knit-ables] schedule lookup failed:",
    error instanceof Error ? error.message : "unknown error",
  );
  loadError = "These projects aren't available right now. Please try again in a few minutes.";
  Astro.response.status = 503;
}
---

<Layout
  title="Hand to Machine | Knit it Now"
  description="Hand-knitting designs provide inspiration for machine-knitting projects you can make with Knit It Now Pattern Builders and your own gauge."
  bodyClass="page--tight-header"
>
  <Fragment slot="head">
    <link rel="canonical" href={KNIT_ABLES_CANONICAL_URL} />
  </Fragment>

  <div class="page-wrap knit-ables-landing">
    <header class="knit-ables-hero" aria-labelledby="knit-ables-heading">
      <p class="knit-ables-eyebrow">Knit it Now</p>
      <h1 id="knit-ables-heading">Hand → Machine</h1>
      <p>
        Hand-knitting designs provide inspiration for machine-knitting projects. Each one
        shows how to get a similar look on your knitting machine, using a Knit It Now
        Pattern Builder and your own gauge.
      </p>
    </header>

    {
      loadError ? (
        <p role="alert">{loadError}</p>
      ) : (
        <section aria-labelledby="knit-ables-list-heading">
          <h2 id="knit-ables-list-heading">Choose a project</h2>
          {publicCards.length === 0 ? (
            <p>New projects show up here when they are published.</p>
          ) : (
            <div class="knit-ables-card-list">
              {publicCards.map((card) => {
                const slug = knitAbleSlugFromPath(card.href);
                return (
                  <div class="knit-ables-card-wrap">
                    <a class="kbm-card knit-ables-feature-card" href={card.href}>
                      <img
                        src={card.image.src}
                        alt={card.image.alt}
                        width={card.image.width}
                        height={card.image.height}
                        loading="lazy"
                        decoding="async"
                      />
                      <h3 class="kbm-card__title">{card.title}</h3>
                      <p class="kbm-card__desc">{card.description}</p>
                    </a>
                    {slug ? (
                      <FavoriteStar
                        contentType="knit-able"
                        contentId={slug}
                        title={card.title}
                        class="favorite-star--compact"
                        source="knit-able-card"
                        actionTooltip
                      />
                    ) : null}
                  </div>
                );
              })}
            </div>
            <FavoritesRuntime contentType="knit-able" />
          )}
        </section>
      )
    }
  </div>
</Layout>

<style>
  .knit-ables-landing.page-wrap {
    padding-top: 1.35rem;
    padding-bottom: 3rem;
    overflow-x: hidden;
    color: #333;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .knit-ables-hero {
    max-width: 40rem;
    margin: 0.35rem 0 2.35rem;
  }

  .knit-ables-eyebrow {
    margin: 0 0 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--kbm-green, #52682d);
  }

  .knit-ables-hero h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.85rem, 3.4vw, 2.55rem);
    line-height: 1.15;
  }

  .knit-ables-hero p:last-child {
    margin-bottom: 0;
  }

  .knit-ables-landing h2 {
    margin: 0 0 0.85rem;
  }

  .knit-ables-card-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .knit-ables-feature-card {
    display: grid;
    gap: 0.75rem;
    max-width: 22rem;
    text-decoration: none;
  }

  .knit-ables-feature-card:hover {
    transform: none;
  }

  .knit-ables-feature-card img {
    display: block;
    width: 100%;
    max-width: 10rem;
    height: auto;
    object-fit: contain;
  }

  .knit-ables-feature-card .kbm-card__title {
    margin: 0;
  }

  .knit-ables-feature-card .kbm-card__desc {
    margin: 0;
    font-weight: 400;
  }

  .knit-ables-card-wrap {
    position: relative;
    min-width: 0;
  }

  .knit-ables-card-wrap :global(.favorite-star) {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .knit-ables-landing.page-wrap {
      padding-top: 1.75rem;
    }

    .knit-ables-hero {
      margin-bottom: 2.75rem;
    }

    .knit-ables-card-list {
      grid-template-columns: repeat(2, minmax(0, 22rem));
      gap: 1.75rem;
    }
  }
</style>
