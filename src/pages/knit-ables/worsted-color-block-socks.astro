---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import KnitAbleLinkedImage from "../../components/knit-ables/KnitAbleLinkedImage.astro";
import KnitAblePageHeader from "../../components/knit-ables/KnitAblePageHeader.astro";
import KnitAbleYarnCard from "../../components/knit-ables/KnitAbleYarnCard.astro";
import { KNIT_ABLE_AFFILIATE_REL, knitAbleSockBuilderHref } from "../../lib/knit-ables/links";
import {
  WORSTED_COLOR_BLOCK_SOCKS_BUILD_STEPS,
  WORSTED_COLOR_BLOCK_SOCKS_CANONICAL_URL,
  WORSTED_COLOR_BLOCK_SOCKS_COLOR_IDEAS,
  WORSTED_COLOR_BLOCK_SOCKS_HERO_COPY,
  WORSTED_COLOR_BLOCK_SOCKS_IMAGES,
  WORSTED_COLOR_BLOCK_SOCKS_ORIGINAL_PATTERN_URL,
  WORSTED_COLOR_BLOCK_SOCKS_TITLE,
  WORSTED_COLOR_BLOCK_SOCKS_YARN,
} from "../../lib/knit-ables/worstedColorBlockSocks";

const sockBuilderHref = knitAbleSockBuilderHref();
const heroImage = WORSTED_COLOR_BLOCK_SOCKS_IMAGES.hero;
---

<Layout
  title={`${WORSTED_COLOR_BLOCK_SOCKS_TITLE} | Knit it Now`}
  description={WORSTED_COLOR_BLOCK_SOCKS_HERO_COPY}
  bodyClass="page--tight-header"
>
  <Fragment slot="head">
    <link rel="canonical" href={WORSTED_COLOR_BLOCK_SOCKS_CANONICAL_URL} />
  </Fragment>

  <div class="page-wrap knit-able-page">
    <article>
      <section class="knit-able-hero" aria-labelledby="knit-able-hero-heading">
        <figure class="knit-able-hero__figure">
          <KnitAbleLinkedImage
            href={WORSTED_COLOR_BLOCK_SOCKS_ORIGINAL_PATTERN_URL}
            src={heroImage.src}
            alt={heroImage.alt}
            width={heroImage.width}
            height={heroImage.height}
            rel={KNIT_ABLE_AFFILIATE_REL}
            loading="eager"
          />
        </figure>
        <div class="knit-able-hero__copy">
          <KnitAblePageHeader
            title={WORSTED_COLOR_BLOCK_SOCKS_TITLE}
            headingId="knit-able-hero-heading"
          />
          <p>{WORSTED_COLOR_BLOCK_SOCKS_HERO_COPY}</p>
          <p>
            These cozy socks prove that you don’t need a complicated stitch pattern to create
            something eye-catching. Start with a simple stockinette sock, then use contrasting
            colors for the cuff, heel, toe, and a narrow stripe.
          </p>
          <p>
            Use the Knit It Now Sock Builder to create the pattern for your foot size, your yarn,
            and your gauge. Choose Cuff to Toe or Toe Up.
          </p>
          <div class="knit-able-hero__actions">
            <a class="kbm-btn kbm-btn-accent" href={sockBuilderHref}>
              Build My Custom Sock Pattern
            </a>
            <a
              class="knit-able-text-link"
              href={WORSTED_COLOR_BLOCK_SOCKS_ORIGINAL_PATTERN_URL}
              target="_blank"
              rel={KNIT_ABLE_AFFILIATE_REL}
            >
              View the Original Knit Picks Pattern
            </a>
          </div>
        </div>
      </section>

      <hr class="section-divider" />

      <section aria-labelledby="knit-able-own-heading">
        <h2 id="knit-able-own-heading">Make It Your Own</h2>
        <ul class="knit-able-checklist">
          {WORSTED_COLOR_BLOCK_SOCKS_COLOR_IDEAS.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="knit-able-build-heading">
        <h2 id="knit-able-build-heading">Build Your Version</h2>
        <ul class="knit-able-checklist">
          {WORSTED_COLOR_BLOCK_SOCKS_BUILD_STEPS.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <aside class="kbm-intro-callout" aria-label="Knit Picks inspiration note">
          <p>
            The Knit Picks design is the inspiration for this Knit-able. The Knit It Now Sock
            Builder creates a separate custom machine-knitting pattern using your measurements
            and gauge. You do not need to purchase the hand-knitting pattern to use the Sock
            Builder.
          </p>
        </aside>
      </section>

      <section aria-labelledby="knit-able-yarn-heading">
        <h2 id="knit-able-yarn-heading">Featured Yarn</h2>
        <div class="knit-able-yarn-grid">
          <KnitAbleYarnCard
            heading={WORSTED_COLOR_BLOCK_SOCKS_YARN.heading}
            buttonLabel={WORSTED_COLOR_BLOCK_SOCKS_YARN.buttonLabel}
            href={WORSTED_COLOR_BLOCK_SOCKS_YARN.href}
          >
            {WORSTED_COLOR_BLOCK_SOCKS_YARN.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </KnitAbleYarnCard>
        </div>
        <p class="knit-able-affiliate" role="note">
          These are affiliate links. If you make a purchase, Knit It Now may receive a commission at
          no additional cost to you.
        </p>
      </section>

      <section aria-labelledby="knit-able-source-heading">
        <h2 id="knit-able-source-heading">Worsted Socks by Kerin Dimeler-Laurence</h2>
        <p>
          The original paid hand-knitting pattern is worked from the toe up and inspired the
          color-blocked look of this Knit-able.
        </p>
        <a
          class="kbm-btn kbm-btn-primary knit-able-source-btn"
          href={WORSTED_COLOR_BLOCK_SOCKS_ORIGINAL_PATTERN_URL}
          target="_blank"
          rel={KNIT_ABLE_AFFILIATE_REL}
        >
          View the Original Knit Picks Pattern
        </a>
      </section>

      <section class="knit-able-cta" aria-labelledby="knit-able-final-heading">
        <h2 id="knit-able-final-heading">Ready to Knit Your Own?</h2>
        <p>
          Choose your yarn, enter your gauge, and create a sock pattern sized for the wearer.
        </p>
        <a class="kbm-btn kbm-btn-accent" href={sockBuilderHref}>
          Build My Custom Sock Pattern
        </a>
        <p class="knit-able-cta__note">
          Knit It Now members can use their own measurements and gauge to generate custom
          machine-knitting instructions.
        </p>
      </section>

      <p class="knit-able-credit">
        <a
          href={WORSTED_COLOR_BLOCK_SOCKS_ORIGINAL_PATTERN_URL}
          target="_blank"
          rel={KNIT_ABLE_AFFILIATE_REL}
        >
          Worsted Socks
        </a>
         designed by Kerin Dimeler-Laurence. Images courtesy of Knit Picks.
      </p>
    </article>
  </div>
</Layout>

<style>
  .knit-able-page.page-wrap {
    padding-top: 12px;
    padding-bottom: 3rem;
    color: #333;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .knit-able-page p {
    margin: 0 0 1.05rem;
  }

  .knit-able-eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--kbm-green, #52682d);
  }

  .knit-able-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  .knit-able-hero__figure {
    margin: 0;
    max-width: 20rem;
  }

  .knit-able-hero__figure :global(img) {
    border-radius: 12px;
    background: #f7f8f5;
  }

  .knit-able-hero h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.45rem, 3vw, 2.15rem);
    line-height: 1.2;
  }

  .knit-able-hero__copy p:last-of-type {
    margin-bottom: 1.15rem;
  }

  .knit-able-hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .knit-able-text-link {
    color: var(--kbm-green, #52682d);
    font-weight: 600;
    text-underline-offset: 2px;
  }

  .knit-able-page h2 {
    margin: 0 0 0.7rem;
  }

  .knit-able-checklist {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .knit-able-checklist li {
    margin: 0 0 0.55rem;
    padding: 0.65rem 0.85rem 0.65rem 2.35rem;
    position: relative;
    color: #4d5a48;
    line-height: 1.5;
    border-radius: 0.75rem;
    background: rgba(82, 104, 45, 0.06);
    border: 1px solid rgba(82, 104, 45, 0.18);
  }

  .knit-able-checklist li:last-child {
    margin-bottom: 0;
  }

  .knit-able-checklist li::before {
    content: "";
    position: absolute;
    left: 0.85rem;
    top: 0.95rem;
    width: 0.55rem;
    height: 0.3rem;
    border-left: 2px solid var(--kbm-green, #52682d);
    border-bottom: 2px solid var(--kbm-green, #52682d);
    transform: rotate(-45deg);
  }

  .knit-able-page :global(.kbm-intro-callout) p + p {
    margin-top: 0.75rem;
  }

  .knit-able-yarn-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 1.15rem 0 0.85rem;
  }

  .knit-able-affiliate {
    margin: 0 0 0.25rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: #5a6350;
  }

  .knit-able-source-btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-bottom: 1.5rem;
  }

  .knit-able-cta {
    margin: 0.5rem 0 1.5rem;
    padding: 1.25rem 1.35rem;
    background: #f7f8f5;
    border: 1px solid #e4ebd6;
    border-radius: 10px;
  }

  .knit-able-cta h2 {
    margin-bottom: 0.85rem;
  }

  .knit-able-cta .kbm-btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
  }

  .knit-able-cta__note {
    margin: 0.85rem 0 0;
    color: #5a6350;
  }

  .knit-able-credit {
    margin: 0;
    font-size: 0.92rem;
    color: #5a6350;
  }

  .knit-able-credit a {
    color: var(--kbm-green, #52682d);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .knit-able-hero {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.15fr);
      gap: 1.75rem;
    }

    .knit-able-yarn-grid {
      grid-template-columns: minmax(0, 22rem);
      align-items: stretch;
    }
  }
</style>
