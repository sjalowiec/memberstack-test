---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import "../../styles/testimonials-public.css";
import { publicTestimonialCopy, quoteWithHighlight, testimonialDeleteConfirmation } from "../../lib/testimonials/testimonialPlainText";
import {
  getTestimonialForAdmin,
  listTestimonialsForAdmin,
} from "../../lib/testimonials/testimonialStore";
import type { TestimonialRecord } from "../../lib/testimonials/testimonialRules";

const statusParam = Astro.url.searchParams.get("status");
const status = statusParam === "active" || statusParam === "inactive" ? statusParam : "all";
const sort = Astro.url.searchParams.get("sort") === "active" ? "active" : "inactive";
const includeUnpublished = Astro.url.searchParams.get("includeUnpublished") === "1";
const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const page = Math.max(Number(Astro.url.searchParams.get("page") ?? "1") || 1, 1);
const pageSize = 40;
const selectedId = Astro.url.searchParams.get("id")?.trim() ?? "";

let rows: TestimonialRecord[] = [];
let total = 0;
let selected: TestimonialRecord | null = null;
let loadError = "";

try {
  const listed = await listTestimonialsForAdmin({
    q,
    status,
    sort,
    includeUnpublishedLegacy: includeUnpublished,
    limit: pageSize,
    offset: (page - 1) * pageSize,
  });
  rows = listed.rows;
  total = listed.total;
  if (selectedId) selected = await getTestimonialForAdmin(selectedId);
} catch (error) {
  const message = error instanceof Error ? error.message : "Could not read testimonials.";
  loadError = /relation .*testimonials.* does not exist/i.test(message)
    ? "The testimonials table is not on this database yet. Nothing has been imported here."
    : message;
}

const pageCount = Math.max(Math.ceil(total / pageSize), 1);

function listHref(next: { status?: string; page?: number; id?: string; sort?: "inactive" | "active" }) {
  const params = new URLSearchParams();
  const nextStatus = next.status ?? status;
  if (nextStatus !== "all") params.set("status", nextStatus);
  if (q) params.set("q", q);
  const nextSort = next.sort ?? sort;
  if (nextSort === "active") params.set("sort", "active");
  if (includeUnpublished) params.set("includeUnpublished", "1");
  const nextPage = next.page ?? page;
  if (nextPage > 1) params.set("page", String(nextPage));
  const nextId = "id" in next ? next.id : selectedId;
  if (nextId) params.set("id", nextId);
  const query = params.toString();
  return query ? `/admin/testimonials?${query}` : "/admin/testimonials";
}

function snippet(row: TestimonialRecord): string {
  const copy = publicTestimonialCopy(row);
  return copy.quote.length > 160 ? `${copy.quote.slice(0, 157)}…` : copy.quote;
}

function memberLabel(row: TestimonialRecord): string {
  if (row.memberstackMemberId) return `Signed-in member ${row.memberstackMemberId}`;
  if (row.legacyMemberId) return `Legacy member ${row.legacyMemberId}`;
  return "No linked member";
}

const previewParts = selected?.displayQuote
  ? quoteWithHighlight(selected.displayQuote, selected.displayHighlightStart, selected.displayHighlightEnd)
  : null;
---

<Layout title="Testimonials | Knit it Now" description="Review, correct, and activate testimonials." bodyClass="page--testimonial-admin">
  <main class="page-wrap testimonial-admin">
    <header>
      <h1>Testimonials</h1>
      <p>
        Imported and submitted testimonials stay inactive until you activate one.
        The old site’s Show flag does not publish anything. Inactivating a testimonial
        removes it from the public testimonials page.
      </p>
    </header>
    <p><a class="kbm-btn kbm-btn-outline" href="/admin">Back to Creator Control Panel</a></p>
    {loadError ? <p role="alert">{loadError}</p> : null}

    {
      !loadError ? (
        <>
          <div class="testimonial-admin__workspace">
          <div class="testimonial-admin__editor">
          <details class="testimonial-admin__add">
            <summary>Add a testimonial received by email</summary>
            <form id="testimonial-add-form" class="contact-form">
              <div class="contact-form__field">
                <label for="add-attribution">Name to display</label>
                <input id="add-attribution" name="attribution" required maxlength="80" />
              </div>
              <div class="contact-form__field">
                <label for="add-quote">Testimonial</label>
                <textarea id="add-quote" name="quote" required minlength="20" maxlength="4000" rows="6"></textarea>
              </div>
              <div class="contact-form__field">
                <label for="add-date">Date received</label>
                <input id="add-date" name="reviewDate" type="date" />
              </div>
              <button class="kbm-btn kbm-btn-primary" type="submit">Save as inactive</button>
              <p class="testimonial-admin__status" data-add-status role="status"></p>
            </form>
          </details>

          {
            selected ? (
              <article class="testimonial-admin__detail" aria-labelledby="testimonial-detail-heading">
                <h2 id="testimonial-detail-heading">{selected.originalAttribution}</h2>
                <p>
                  {selected.active ? "Active" : "Inactive"} · {selected.source.replaceAll("_", " ")} ·{" "}
                  {memberLabel(selected)}
                </p>
                <p>
                  {selected.reviewDate ?? "No review date"}
                  {selected.rating != null ? ` · rating ${selected.rating}` : ""}
                  {selected.legacyRatingId != null ? ` · legacy rating ${selected.legacyRatingId}` : ""}
                </p>
                <h3>Original text</h3>
                <pre class="testimonial-admin__original">{selected.originalQuote}</pre>
                <p class="testimonial-admin__history">
                  Legacy history, not publication:
                  Show {selected.legacyShow == null ? "unknown" : selected.legacyShow ? "1" : "0"},
                  Viewed {selected.legacyViewed == null ? "unknown" : selected.legacyViewed ? "1" : "0"},
                  UseInEmail {selected.legacyUseInEmail == null ? "unknown" : selected.legacyUseInEmail ? "1" : "0"}.
                </p>
                <form id="testimonial-display-form" class="contact-form" data-id={selected.id}>
                  <div class="contact-form__field">
                    <label for="display-attribution">Display name</label>
                    <input
                      id="display-attribution"
                      name="displayAttribution"
                      maxlength="80"
                      value={selected.displayAttribution ?? ""}
                    />
                  </div>
                  <div class="contact-form__field">
                    <label for="display-quote">Display quote</label>
                    <textarea id="display-quote" name="displayQuote" maxlength="4000" rows="6">{selected.displayQuote ?? ""}</textarea>
                  </div>
                  <p>Leave both blank to show the original wording, with legacy HTML and links removed.</p>
                  <p class="testimonial-admin__highlight-actions">
                    <button class="kbm-btn kbm-btn-outline" type="button" id="highlight-selection">Highlight</button>
                    <button class="kbm-btn kbm-btn-outline" type="button" id="highlight-remove">Remove highlight</button>
                  </p>
                  <p class="testimonial-admin__status" id="highlight-status" role="status"></p>
                  <p class="testimonial-admin__history">Preview</p>
                  <div
                    class="kbm-card testimonials-page__card testimonial-admin__preview"
                    id="highlight-preview"
                    data-highlight-start={selected.displayHighlightStart ?? ""}
                    data-highlight-end={selected.displayHighlightEnd ?? ""}
                  >
                    <p class="testimonials-page__quote" id="highlight-preview-quote">
                      {previewParts ? (
                        <>
                          {previewParts.before}
                          {previewParts.highlight ? (
                            <span class="testimonials-page__highlight">{previewParts.highlight}</span>
                          ) : null}
                          {previewParts.after}
                        </>
                      ) : (
                        "Enter a display quote to preview it."
                      )}
                    </p>
                  </div>
                  <p class="testimonial-admin__unsaved" id="unsaved-changes" hidden>Unsaved changes</p>
                  <p class="testimonial-admin__save-actions">
                    <button class="kbm-btn kbm-btn-primary" type="button" id="save-activate">Save &amp; Activate</button>
                    <button class="kbm-btn kbm-btn-outline" type="button" id="save-edits">Save</button>
                    <button class="kbm-btn kbm-btn-outline" type="button" id="save-inactivate">Save &amp; Inactivate</button>
                    <button
                      class="kbm-btn kbm-btn-outline"
                      type="button"
                      data-testimonial-delete={selected.id}
                      data-delete-confirm={testimonialDeleteConfirmation(
                        selected.originalAttribution,
                        selected.originalQuote,
                      )}
                    >
                      Delete
                    </button>
                  </p>
                  <p class="testimonial-admin__status" data-detail-status role="status"></p>
                </form>
              </article>
            ) : (
              <p class="testimonial-admin__prompt">Select a testimonial to review it.</p>
            )
          }
          </div>

          <div class="testimonial-admin__list">
          <form class="testimonial-admin__filters" method="get" action="/admin/testimonials">
            {selectedId ? <input type="hidden" name="id" value={selectedId} /> : null}
            <label>
              Search
              <input type="search" name="q" value={q} />
            </label>
            <label>
              Status
              <select name="status">
                <option value="all" selected={status === "all"}>All</option>
                <option value="active" selected={status === "active"}>Active</option>
                <option value="inactive" selected={status === "inactive"}>Inactive</option>
              </select>
            </label>
            <label>
              Sort
              <select name="sort">
                <option value="inactive" selected={sort === "inactive"}>Inactive first</option>
                <option value="active" selected={sort === "active"}>Active first</option>
              </select>
            </label>
            <label class="testimonial-admin__include">
              <input type="checkbox" name="includeUnpublished" value="1" checked={includeUnpublished} />
              Include previously unpublished legacy reviews
            </label>
            <button class="kbm-btn kbm-btn-primary" type="submit">Apply</button>
          </form>
          <p>{total} testimonial{total === 1 ? "" : "s"}</p>

          {
            rows.length === 0 ? (
              <p>No testimonials match this search.</p>
            ) : (
              <table class="testimonial-admin__table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Quote</th>
                    <th>Source</th>
                    <th>Member</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((row) => (
                    <tr class={row.id === selectedId ? "is-selected" : undefined}>
                      <td>
                        <a href={listHref({ id: row.id })} aria-current={row.id === selectedId ? "true" : undefined}>
                          {row.displayAttribution || row.originalAttribution}
                        </a>
                      </td>
                      <td>{snippet(row)}</td>
                      <td>{row.source.replaceAll("_", " ")}</td>
                      <td>{memberLabel(row)}</td>
                      <td>{row.active ? "Active" : "Inactive"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )
          }

          <p class="testimonial-admin__pager">
            {page > 1 ? <a href={listHref({ page: page - 1 })}>Previous</a> : null}
            <span>Page {page} of {pageCount}</span>
            {page < pageCount ? <a href={listHref({ page: page + 1 })}>Next</a> : null}
          </p>
          </div>
          </div>
        </>
      ) : null
    }
  </main>
</Layout>

<script>
  import { fetchAdminJson } from "../../lib/admin/adminAuthClient";

  const LIST_POSITION_KEY = "kin-testimonial-admin-scroll";
  const NOTICE_KEY = "kin-testimonial-admin-notice";
  let allowLeave = false;

  function rememberListPosition() {
    try {
      sessionStorage.setItem(LIST_POSITION_KEY, String(window.scrollY));
    } catch {
      /* Storage can be unavailable. The page still reloads with the current address. */
    }
  }

  function restoreListPosition() {
    try {
      const raw = sessionStorage.getItem(LIST_POSITION_KEY);
      if (raw == null) return;
      sessionStorage.removeItem(LIST_POSITION_KEY);
      const y = Number(raw);
      if (Number.isFinite(y)) window.scrollTo(0, y);
    } catch {
      /* The list opens at the top when storage cannot be read. */
    }
  }

  restoreListPosition();

  try {
    const savedNotice = sessionStorage.getItem(NOTICE_KEY);
    if (savedNotice) {
      sessionStorage.removeItem(NOTICE_KEY);
      const status = document.querySelector<HTMLElement>("[data-detail-status]");
      if (status) status.textContent = savedNotice;
    }
  } catch {
    /* A missing confirmation still leaves the saved record in place. */
  }

  function requestLeave(): boolean {
    const unsaved = document.getElementById("unsaved-changes");
    if (!unsaved || unsaved.hidden || allowLeave) return true;
    const ok = window.confirm("You have unsaved changes. Leave without saving?");
    if (ok) allowLeave = true;
    return ok;
  }

  window.addEventListener("beforeunload", (event) => {
    const unsaved = document.getElementById("unsaved-changes");
    if (!unsaved || unsaved.hidden || allowLeave) return;
    event.preventDefault();
    event.returnValue = "";
  });

  function editorPayload(): { displayQuote: string; displayAttribution: string; highlight: { start: number; end: number } | null } {
    const quote = document.getElementById("display-quote");
    const name = document.getElementById("display-attribution");
    const preview = document.getElementById("highlight-preview");
    const quoteText = quote instanceof HTMLTextAreaElement ? quote.value : "";
    const start = Number(preview?.getAttribute("data-highlight-start"));
    const end = Number(preview?.getAttribute("data-highlight-end"));
    const highlight = Number.isInteger(start) && Number.isInteger(end) && quoteText.slice(start, end).trim()
      ? { start, end }
      : null;
    return {
      displayQuote: quoteText,
      displayAttribution: name instanceof HTMLInputElement ? name.value : "",
      highlight,
    };
  }

  async function saveEdits(active: boolean | undefined) {
    const form = document.getElementById("testimonial-display-form");
    if (!(form instanceof HTMLFormElement)) return;
    const status = document.querySelector<HTMLElement>("[data-detail-status]");
    const body: Record<string, unknown> = editorPayload();
    if (active !== undefined) body.active = active;
    const result = await fetchAdminJson<{ ok: boolean; error?: string }>(
      `/api/admin/testimonials/${encodeURIComponent(form.dataset.id || "")}`,
      { method: "PATCH", body },
    );
    if (!result.ok || !result.data?.ok) {
      if (status) status.textContent = result.data?.error || result.error || "Could not save.";
      return;
    }
    const message = active === true ? "Saved and activated." : active === false ? "Saved and inactivated." : "Saved.";
    try {
      sessionStorage.setItem(NOTICE_KEY, message);
    } catch {
      /* The reload still keeps the address and list position. */
    }
    allowLeave = true;
    rememberListPosition();
    window.location.reload();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-testimonial-delete]").forEach((button) => {
    button.addEventListener("click", async () => {
      const id = button.dataset.testimonialDelete || "";
      const confirmation = button.dataset.deleteConfirm || "Delete this testimonial?";
      const unsaved = document.getElementById("unsaved-changes");
      const prompt = unsaved && !unsaved.hidden
        ? `${confirmation}\n\nYou also have unsaved changes.`
        : confirmation;
      if (!id || !window.confirm(prompt)) return;
      allowLeave = true;
      const status = document.querySelector<HTMLElement>("[data-detail-status]");
      const result = await fetchAdminJson<{ ok: boolean; error?: string }>(
        `/api/admin/testimonials/${encodeURIComponent(id)}`,
        { method: "DELETE" },
      );
      if (!result.ok || !result.data?.ok) {
        if (status) status.textContent = result.data?.error || result.error || "Could not delete.";
        return;
      }
      const url = new URL(window.location.href);
      url.searchParams.delete("id");
      rememberListPosition();
      window.location.href = `${url.pathname}${url.search}`;
    });
  });

  document.querySelector(".testimonial-admin__list")?.addEventListener("click", (event) => {
    const target = event.target;
    const link = target instanceof Element ? target.closest("a") : null;
    if (!link) return;
    if (!requestLeave()) {
      event.preventDefault();
      return;
    }
    rememberListPosition();
  });
  document.querySelector(".testimonial-admin__filters")?.addEventListener("submit", (event) => {
    if (!requestLeave()) {
      event.preventDefault();
      return;
    }
    rememberListPosition();
  });

  document.getElementById("testimonial-display-form")?.addEventListener("submit", (event) => {
    event.preventDefault();
    void saveEdits(undefined);
  });
  document.getElementById("save-activate")?.addEventListener("click", () => {
    void saveEdits(true);
  });
  document.getElementById("save-edits")?.addEventListener("click", () => {
    void saveEdits(undefined);
  });
  document.getElementById("save-inactivate")?.addEventListener("click", () => {
    void saveEdits(false);
  });

  const quoteField = document.getElementById("display-quote");
  const previewCard = document.getElementById("highlight-preview");
  const previewQuote = document.getElementById("highlight-preview-quote");
  const highlightStatus = document.getElementById("highlight-status");
  let highlightedPhrase = "";
  if (quoteField instanceof HTMLTextAreaElement && previewCard) {
    const start = Number(previewCard.getAttribute("data-highlight-start"));
    const end = Number(previewCard.getAttribute("data-highlight-end"));
    if (Number.isInteger(start) && Number.isInteger(end)) {
      highlightedPhrase = quoteField.value.slice(start, end);
    }
  }

  function currentHighlight(): { start: number; end: number } | null {
    if (!(previewCard instanceof HTMLElement)) return null;
    const start = Number(previewCard.getAttribute("data-highlight-start"));
    const end = Number(previewCard.getAttribute("data-highlight-end"));
    if (!Number.isInteger(start) || !Number.isInteger(end)) return null;
    return { start, end };
  }

  function renderHighlightPreview() {
    if (!(quoteField instanceof HTMLTextAreaElement) || !(previewQuote instanceof HTMLElement)) return;
    const quote = quoteField.value;
    const range = currentHighlight();
    previewQuote.replaceChildren();
    if (!quote.trim()) {
      previewQuote.textContent = "Enter a display quote to preview it.";
      return;
    }
    if (!range || quote.slice(range.start, range.end) !== highlightedPhrase || !highlightedPhrase.trim()) {
      previewQuote.textContent = quote;
      return;
    }
    previewQuote.append(quote.slice(0, range.start));
    const emphasis = document.createElement("span");
    emphasis.className = "testimonials-page__highlight";
    emphasis.textContent = quote.slice(range.start, range.end);
    previewQuote.append(emphasis, quote.slice(range.end));
  }

  const savedQuote = quoteField instanceof HTMLTextAreaElement ? quoteField.value : "";
  const savedNameField = document.getElementById("display-attribution");
  const savedName = savedNameField instanceof HTMLInputElement ? savedNameField.value : "";
  const savedHighlightStart = previewCard?.getAttribute("data-highlight-start") || "";
  const savedHighlightEnd = previewCard?.getAttribute("data-highlight-end") || "";

  function refreshUnsaved() {
    const indicator = document.getElementById("unsaved-changes");
    if (!indicator) return;
    const nameField = document.getElementById("display-attribution");
    const name = nameField instanceof HTMLInputElement ? nameField.value : "";
    const quote = quoteField instanceof HTMLTextAreaElement ? quoteField.value : "";
    const start = previewCard?.getAttribute("data-highlight-start") || "";
    const end = previewCard?.getAttribute("data-highlight-end") || "";
    const dirty = quote !== savedQuote || name !== savedName || start !== savedHighlightStart || end !== savedHighlightEnd;
    indicator.hidden = !dirty;
  }

  function clearHighlight(message: string) {
    highlightedPhrase = "";
    previewCard?.setAttribute("data-highlight-start", "");
    previewCard?.setAttribute("data-highlight-end", "");
    if (highlightStatus) highlightStatus.textContent = message;
    renderHighlightPreview();
    refreshUnsaved();
  }

  quoteField?.addEventListener("input", () => {
    const range = currentHighlight();
    const quote = quoteField instanceof HTMLTextAreaElement ? quoteField.value : "";
    if (range && quote.slice(range.start, range.end) !== highlightedPhrase) {
      clearHighlight("The quote changed. Select the highlight again.");
      return;
    }
    renderHighlightPreview();
    refreshUnsaved();
  });
  document.getElementById("display-attribution")?.addEventListener("input", () => {
    refreshUnsaved();
  });

  document.getElementById("highlight-selection")?.addEventListener("click", () => {
    if (!(quoteField instanceof HTMLTextAreaElement) || !(previewCard instanceof HTMLElement)) return;
    const start = quoteField.selectionStart ?? 0;
    const end = quoteField.selectionEnd ?? 0;
    const phrase = quoteField.value.slice(start, end);
    if (!phrase.trim()) {
      if (highlightStatus) highlightStatus.textContent = "Select the words to highlight.";
      return;
    }
    highlightedPhrase = phrase;
    previewCard.setAttribute("data-highlight-start", String(start));
    previewCard.setAttribute("data-highlight-end", String(end));
    if (highlightStatus) highlightStatus.textContent = "";
    renderHighlightPreview();
    refreshUnsaved();
  });

  document.getElementById("highlight-remove")?.addEventListener("click", () => {
    clearHighlight("Highlight removed. Save to keep this change.");
  });

  document.getElementById("testimonial-add-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const data = new FormData(form);
    const status = document.querySelector<HTMLElement>("[data-add-status]");
    const result = await fetchAdminJson<{ ok: boolean; error?: string; testimonial?: { id?: string } }>("/api/admin/testimonials", {
      method: "POST",
      body: {
        attribution: String(data.get("attribution") ?? ""),
        quote: String(data.get("quote") ?? ""),
        reviewDate: String(data.get("reviewDate") ?? ""),
      },
    });
    if (!result.ok || !result.data?.ok) {
      if (status) status.textContent = result.data?.error || result.error || "Could not save.";
      return;
    }
    const url = new URL(window.location.href);
    const createdId = result.data.testimonial?.id;
    if (createdId) url.searchParams.set("id", createdId);
    rememberListPosition();
    window.location.href = `${url.pathname}${url.search}`;
  });
</script>

<style>
  :global(body.page--testimonial-admin main.site-content) {
    max-width: none;
  }

  .testimonial-admin.page-wrap {
    max-width: none;
    width: 100%;
  }

  .testimonial-admin__workspace {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: stretch;
  }

  .testimonial-admin__editor,
  .testimonial-admin__list {
    min-width: 0;
  }

  .testimonial-admin__prompt {
    margin: 0;
    padding: 1rem;
    border: 1px solid #d6dbc9;
    border-radius: 1rem;
    background: #fff;
  }

  .testimonial-admin__filters,
  .testimonial-admin__pager {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: end;
  }

  .testimonial-admin__include {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    max-width: 16rem;
  }
  .testimonial-admin__list {
    overflow-x: auto;
  }

  .testimonial-admin__table {
    width: 100%;
    border-collapse: collapse;
  }

  .testimonial-admin__table tr.is-selected td {
    background: #f4f7ee;
  }

  .testimonial-admin__table tr.is-selected td:first-child {
    box-shadow: inset 4px 0 0 var(--kbm-green, #52682d);
  }

  .testimonial-admin__table tr.is-selected a {
    font-weight: 700;
  }
  .testimonial-admin__table th,
  .testimonial-admin__table td {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .testimonial-admin__original {
    white-space: pre-wrap;
    font: inherit;
    margin: 0;
  }
  .testimonial-admin__detail,
  .testimonial-admin__add {
    margin: 1.25rem 0;
    padding: 1rem;
    border: 1px solid #d6dbc9;
    border-radius: 1rem;
    background: #fff;
  }
  .testimonial-admin__detail p .kbm-btn + .kbm-btn,
  .testimonial-admin__highlight-actions .kbm-btn + .kbm-btn,
  .testimonial-admin__save-actions .kbm-btn + .kbm-btn {
    margin-left: 0.75rem;
  }

  .testimonial-admin__save-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .testimonial-admin__save-actions .kbm-btn + .kbm-btn {
    margin-left: 0;
  }

  .testimonial-admin__unsaved {
    margin: 0.75rem 0 0;
    color: var(--kbm-green, #52682d);
    font-weight: 700;
  }

  .testimonial-admin__status:not(:empty) {
    font-weight: 600;
  }
  .testimonial-admin__preview {
    margin-top: 0.5rem;
  }

  @media (min-width: 960px) {
