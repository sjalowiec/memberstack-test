    .legacy-ebook-lookup__purchase-panel {
      margin-bottom: 1.25rem;
    }

    .legacy-ebook-lookup__search-row {
      margin-bottom: 0.75rem;
      max-width: 36rem;
    }

    .legacy-ebook-lookup__search-label {
      display: block;
      margin-bottom: 0.35rem;
      font-size: 0.95rem;
      font-weight: 600;
      color: #374151;
    }

    .legacy-ebook-lookup__search-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
    }

    .legacy-ebook-lookup__search-input {
      flex: 1 1 14rem;
      min-width: 12rem;
      padding: 0.5rem 0.65rem;
      font-size: 1rem;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      box-sizing: border-box;
    }

    .legacy-ebook-lookup__search-input:focus {
      outline: 2px solid #526b2d;
      outline-offset: 1px;
      border-color: #526b2d;
    }

    .legacy-ebook-lookup__purchase-status {
      margin: 0 0 0.75rem 0;
      font-size: 0.92rem;
      color: #64748b;
    }

    .legacy-ebook-lookup__purchase-results-wrap.is-hidden,
    .legacy-ebook-lookup__purchase-empty.is-hidden {
      display: none;
    }

    .legacy-ebook-lookup__purchase-table .legacy-ebook-lookup__col-qty,
    .legacy-ebook-lookup__purchase-table .legacy-ebook-lookup__col-total {
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .legacy-ebook-lookup__purchase-table .legacy-ebook-lookup__col-date {
      white-space: nowrap;
      font-size: 0.88em;
      color: #475569;
    }
  </style>

  <script>
    // @ts-nocheck
    (function initLegacyEbookPurchaseSearch() {
      const dataEl = document.getElementById("legacy-ebook-purchases-data");
      const searchInput = document.getElementById("legacy-ebook-email-search");
      const searchBtn = document.getElementById("legacy-ebook-email-search-btn");
      const statusEl = document.getElementById("legacy-ebook-purchase-status");
      const resultsWrap = document.getElementById("legacy-ebook-purchase-results-wrap");
      const resultsTbody = document.getElementById("legacy-ebook-purchase-results-tbody");
      const emptyEl = document.getElementById("legacy-ebook-purchase-empty");

      if (!dataEl || !searchInput || !statusEl || !resultsWrap || !resultsTbody || !emptyEl) {
        return;
      }

      /** @type {Array<{purchaseDate:string,email:string,firstName:string,lastName:string,legacyItemId:string,title:string,quantity:number,totalPrice:string,downloadHref:string|null,downloadLabel:string|null}>} */
      let purchases = [];
      try {
        purchases = JSON.parse(dataEl.textContent || "[]");
      } catch {
        statusEl.textContent = "Could not load purchase data.";
        return;
      }

      function normalizeEmail(value) {
        return String(value ?? "").trim().toLowerCase();
      }

      function escapeHtml(text) {
        return String(text ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function formatPurchaseDate(raw) {
        const s = String(raw ?? "").trim();
        if (!s) return "—";
        const d = new Date(s.replace(" ", "T"));
        if (Number.isNaN(d.getTime())) return s;
        return d.toLocaleString(undefined, {
          year: "numeric",
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit",
        });
      }

      function renderDownloadCell(row) {
        if (row.downloadHref && row.downloadLabel) {
          return `<a href="${escapeHtml(row.downloadHref)}" class="legacy-ebook-lookup__file-link" target="_blank" rel="noopener noreferrer"><code>${escapeHtml(row.downloadLabel)}</code></a>`;
        }
        if (row.downloadLabel) {
          return `<code>${escapeHtml(row.downloadLabel)}</code>`;
        }
        return "—";
      }

      function setResultsVisible(showTable, showEmpty) {
        resultsWrap.hidden = !showTable;
        resultsWrap.classList.toggle("is-hidden", !showTable);
        emptyEl.hidden = !showEmpty;
        emptyEl.classList.toggle("is-hidden", !showEmpty);
      }

      function runSearch() {
        const query = normalizeEmail(searchInput.value);
        if (!query) {
          statusEl.textContent = "Enter an email and search to see legacy eBook purchases.";
          resultsTbody.innerHTML = "";
          setResultsVisible(false, false);
          return;
        }

        const matches = purchases.filter((row) =>
          normalizeEmail(row.email).includes(query)
        );

        matches.sort((a, b) => {
          const ta = Date.parse(String(a.purchaseDate).replace(" ", "T"));
          const tb = Date.parse(String(b.purchaseDate).replace(" ", "T"));
          const sa = Number.isFinite(ta) ? ta : 0;
          const sb = Number.isFinite(tb) ? tb : 0;
          return sb - sa;
        });

        if (matches.length === 0) {
          statusEl.textContent = "";
          resultsTbody.innerHTML = "";
          setResultsVisible(false, true);
          return;
        }

        statusEl.textContent = `${matches.length} purchase${matches.length === 1 ? "" : "s"} for “${searchInput.value.trim()}”.`;
        resultsTbody.innerHTML = matches
          .map(
            (row) => `<tr>
              <td class="legacy-ebook-lookup__col-date">${escapeHtml(formatPurchaseDate(row.purchaseDate))}</td>
              <td>${escapeHtml(row.email)}</td>
              <td>${escapeHtml(row.firstName)}</td>
              <td>${escapeHtml(row.lastName)}</td>
              <td class="legacy-ebook-lookup__col-id">${escapeHtml(row.legacyItemId)}</td>
              <td class="legacy-ebook-lookup__col-title">${escapeHtml(row.title)}</td>
              <td class="legacy-ebook-lookup__col-qty">${escapeHtml(row.quantity)}</td>
              <td class="legacy-ebook-lookup__col-total">$${escapeHtml(row.totalPrice)}</td>
              <td class="legacy-ebook-lookup__col-file">${renderDownloadCell(row)}</td>
            </tr>`
          )
          .join("");
        setResultsVisible(true, false);
      }

      searchBtn?.addEventListener("click", runSearch);
      searchInput.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          runSearch();
        }
      });
    })();
  </script>

  {books.length > 0 && (
    <script>
      // @ts-nocheck
      const tbody = document.getElementById("legacy-ebook-inventory-tbody");
      const table = document.getElementById("legacy-ebook-inventory-table");
      const showInactiveEl = document.getElementById("legacy-ebook-show-inactive");
      const showMissingOnlyEl = document.getElementById("legacy-ebook-show-missing-only");
      const visibleCountEl = document.getElementById("legacy-ebook-visible-count");
      if (!tbody || !table) {
        /* table not rendered */
      } else {
        const inactiveCount = Number(
          tbody.querySelectorAll('tr[data-inactive-title="true"]').length
        );
        const totalCount = tbody.querySelectorAll("tr").length;
        const activeCount = totalCount - inactiveCount;

        function applyRowVisibility() {
          const showInactive = showInactiveEl?.checked === true;
          const showMissingOnly = showMissingOnlyEl?.checked === true;
          let visible = 0;
          for (const row of tbody.querySelectorAll("tr")) {
            const isInactive = row.dataset.inactiveTitle === "true";
            const isMissing = row.dataset.missingFile === "true";
            const hidden =
              (isInactive && !showInactive) || (showMissingOnly && !isMissing);
            row.classList.toggle("legacy-ebook-lookup__row--hidden-inactive", hidden);
            if (!hidden) visible += 1;
          }
          if (visibleCountEl) {
            const parts = [`Showing ${visible} row${visible === 1 ? "" : "s"}`];
            if (!showInactive) {
              parts.push(`${inactiveCount} inactive hidden`);
            }
            if (showMissingOnly) {
              parts.push("missing files only");
            }
            visibleCountEl.textContent = parts.join(" · ");
          }
        }

        const headers = Array.from(
          table.querySelectorAll("th[data-sort-column]")
        );

        /** @type {"legacyId" | "title" | "filename" | "active" | "fileStatus"} */
        let sortColumn = "legacyId";
        /** @type {"asc" | "desc"} */
        let sortDirection = "asc";

        function compareStrings(a, b) {
          return a.localeCompare(b, undefined, { sensitivity: "base" });
        }

        function legacyIdSortKey(raw) {
          const n = parseInt(String(raw ?? "").trim(), 10);
          return Number.isFinite(n) ? n : Number.NaN;
        }

        function compareRows(a, b) {
          const dir = sortDirection === "asc" ? 1 : -1;

          if (sortColumn === "legacyId") {
            const na = legacyIdSortKey(a.dataset.legacyId);
            const nb = legacyIdSortKey(b.dataset.legacyId);
            const aMissing = Number.isNaN(na);
            const bMissing = Number.isNaN(nb);
            if (aMissing && bMissing) return 0;
            if (aMissing) return 1;
            if (bMissing) return -1;
            return (na - nb) * dir;
          }

          if (sortColumn === "title") {
            const ta = (a.dataset.title ?? "").trim();
            const tb = (b.dataset.title ?? "").trim();
            const aEmpty = !ta;
            const bEmpty = !tb;
            if (aEmpty && bEmpty) return 0;
            if (aEmpty) return 1;
            if (bEmpty) return -1;
            return compareStrings(ta, tb) * dir;
          }

          if (sortColumn === "filename") {
            const fa = (a.dataset.filename ?? "").trim();
            const fb = (b.dataset.filename ?? "").trim();
            const aEmpty = !fa;
            const bEmpty = !fb;
            if (aEmpty && bEmpty) return 0;
            if (aEmpty) return 1;
            if (bEmpty) return -1;
            return compareStrings(fa, fb) * dir;
          }

          if (sortColumn === "active") {
            const aa = parseInt(a.dataset.active ?? "0", 10);
            const ab = parseInt(b.dataset.active ?? "0", 10);
            const sa = Number.isFinite(aa) ? aa : 0;
            const sb = Number.isFinite(ab) ? ab : 0;
            return (sa - sb) * dir;
          }

          if (sortColumn === "fileStatus") {
            const fa = parseInt(a.dataset.fileStatus ?? "0", 10);
            const fb = parseInt(b.dataset.fileStatus ?? "0", 10);
            const sa = Number.isFinite(fa) ? fa : 0;
            const sb = Number.isFinite(fb) ? fb : 0;
            if (sa !== sb) return (sa - sb) * dir;
            return compareStrings(
              (a.dataset.filename ?? "").trim(),
              (b.dataset.filename ?? "").trim()
            ) * dir;
          }

          return 0;
        }

        function updateHeaderState() {
          for (const th of headers) {
            const col = th.dataset.sortColumn;
            const sorted = col === sortColumn;
            th.classList.toggle("is-sorted", sorted);
            th.setAttribute(
              "aria-sort",
              sorted
                ? sortDirection === "asc"
                  ? "ascending"
                  : "descending"
                : "none"
            );
            const indicator = th.querySelector(".legacy-ebook-lookup__sort-indicator");
            if (indicator) {
              indicator.textContent = sorted
                ? sortDirection === "asc"
                  ? "↑"
                  : "↓"
                : "";
            }
          }
        }

        function sortTable() {
          const rows = Array.from(tbody.querySelectorAll("tr"));
          rows.sort(compareRows);
          for (const row of rows) {
            tbody.appendChild(row);
          }
          updateHeaderState();
        }

        for (const th of headers) {
          th.addEventListener("click", () => {
            const col = th.dataset.sortColumn;
            if (!col) return;
            if (col === sortColumn) {
              sortDirection = sortDirection === "asc" ? "desc" : "asc";
            } else {
              sortColumn = col;
              sortDirection = "asc";
            }
            sortTable();
          });
          th.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              th.click();
            }
          });
          th.setAttribute("tabindex", "0");
        }

        showInactiveEl?.addEventListener("change", applyRowVisibility);
        showMissingOnlyEl?.addEventListener("change", applyRowVisibility);

        updateHeaderState();
        applyRowVisibility();
      }
    </script>
  )}
</BaseLayout>
