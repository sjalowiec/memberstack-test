---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  auditLegacyEbookCatalog,
  buildLegacyShopFileIndex,
  fileStatusSortKey,
  formatActiveLabel,
  formatFileStatusLabel,
  formatLegacyCell,
  getLegacyShopDownloadPublicUrl,
  formatShopFileSizeKb,
  listLegacyShopDownloadFiles,
  listUnmatchedLegacyShopFiles,
} from "../../lib/legacy/legacyEbookCatalog";
import {
  buildLegacyEbookCatalogById,
  loadLegacyEbookPurchases,
  enrichLegacyEbookPurchase,
  toLegacyEbookPurchaseClientRows,
} from "../../lib/legacy/legacyEbookPurchases";

const shopFiles = listLegacyShopDownloadFiles();
const shopIndex = buildLegacyShopFileIndex(shopFiles);
const books = auditLegacyEbookCatalog(undefined, shopIndex);
const catalogById = buildLegacyEbookCatalogById(books);
const purchaseClientRows = toLegacyEbookPurchaseClientRows(
  loadLegacyEbookPurchases().map((row) => enrichLegacyEbookPurchase(row, catalogById))
);
const purchaseClientJson = JSON.stringify(purchaseClientRows);
const unmatchedShopFiles = listUnmatchedLegacyShopFiles(books, shopFiles);

const missingLegacyIds = new Set(
  books.filter((b) => b.fileStatus === "missing").map((b) => b.legacyId)
);
const unmatchedWithMissingId = unmatchedShopFiles.filter(
  (f) => f.legacyIdPrefix && missingLegacyIds.has(f.legacyIdPrefix)
);

const totalBooks = books.length;
const activeBooks = books.filter((b) => b.active === true).length;
const inactiveBooks = books.filter((b) => b.active === false).length;
const booksWithFilenames = books.filter((b) => b.downloadFile).length;
const filesFound = books.filter((b) => b.fileStatus === "found").length;
const missingFiles = books.filter((b) => b.fileStatus === "missing").length;
const booksWithNoFilename = books.filter((b) => b.fileStatus === "no-filename").length;

const activeWithFilenames = books.filter((b) => b.active === true && b.downloadFile);
const activeBooksWithFilenames = activeWithFilenames.length;
const activeFilesFound = activeWithFilenames.filter((b) => b.fileStatus === "found").length;
const activeFilesMissing = activeWithFilenames.filter(
  (b) => b.fileStatus === "missing"
).length;
const activeMissingRows = activeWithFilenames.filter((b) => b.fileStatus === "missing");
---

<BaseLayout
  title="Legacy eBook Lookup | Knit it Now"
  description="Internal inventory of legacy downloadable eBooks."
  bodyClass="help-hub-admin-body"
>
  <main class="help-hub-admin">
    <header class="help-hub-admin__head">
      <h1 class="help-hub-admin__title">Legacy eBook Lookup</h1>
      <p class="help-hub-admin__sub">
        Read-only inventory from <code>src/data/legacy/legacy-ebook-catalog.csv</code>
        (legacy store export), audited against <code>public/downloads/shop/</code>.
        Customer purchases come from <code>src/data/legacy/legacy-ebook-purchases.csv</code>.
      </p>
    </header>

    <div class="help-hub-admin__toolbar">
      <a href="/admin" class="kbm-btn kbm-btn-outline">Back to Creator Control Panel</a>
    </div>

    <section
      class="admin-panel legacy-ebook-lookup__purchase-panel"
      aria-labelledby="legacy-ebook-purchase-lookup-heading"
    >
      <h2 id="legacy-ebook-purchase-lookup-heading" class="legacy-ebook-lookup__section-title">
        Customer purchase lookup
      </h2>
      <p class="legacy-ebook-lookup__section-sub">
        Search by billing email (case-insensitive). Results join to the catalog by legacy
        item ID and show a download link when the catalog audit finds a shop file.
      </p>
      <div class="legacy-ebook-lookup__search-row">
        <label class="legacy-ebook-lookup__search-label" for="legacy-ebook-email-search">
          Search customer email
        </label>
        <div class="legacy-ebook-lookup__search-controls">
          <input
            type="search"
            id="legacy-ebook-email-search"
            class="legacy-ebook-lookup__search-input"
            name="customer-email"
            autocomplete="off"
            spellcheck="false"
            placeholder="customer@example.com"
          />
          <button type="button" class="kbm-btn kbm-btn-primary" id="legacy-ebook-email-search-btn">
            Search
          </button>
        </div>
      </div>
      <p
        class="legacy-ebook-lookup__purchase-status"
        id="legacy-ebook-purchase-status"
        aria-live="polite"
      >
        Enter an email and search to see legacy eBook purchases.
      </p>
      <div
        class="help-hub-admin__table-wrap legacy-ebook-lookup__purchase-results-wrap is-hidden"
        id="legacy-ebook-purchase-results-wrap"
        hidden
      >
        <table
          class="help-hub-admin__table legacy-ebook-lookup__purchase-table"
          id="legacy-ebook-purchase-results-table"
        >
          <thead>
            <tr>
              <th scope="col">Purchase date</th>
              <th scope="col">Email</th>
              <th scope="col">First name</th>
              <th scope="col">Last name</th>
              <th scope="col">Legacy item ID</th>
              <th scope="col">eBook title</th>
              <th scope="col">Qty</th>
              <th scope="col">Total</th>
              <th scope="col">Download</th>
            </tr>
          </thead>
          <tbody id="legacy-ebook-purchase-results-tbody"></tbody>
        </table>
      </div>
      <p
        class="help-hub-admin__empty legacy-ebook-lookup__purchase-empty is-hidden"
        id="legacy-ebook-purchase-empty"
        hidden
      >
        No legacy eBook purchases found for this email.
      </p>
    </section>

    <script
      id="legacy-ebook-purchases-data"
      type="application/json"
      set:html={purchaseClientJson}
    />

    <dl class="legacy-ebook-lookup__stats" aria-live="polite">
      <div>
        <dt>Total books</dt>
        <dd>{totalBooks}</dd>
      </div>
      <div>
        <dt>Active books</dt>
        <dd>{activeBooks}</dd>
      </div>
      <div>
        <dt>Active books with filenames</dt>
        <dd>{activeBooksWithFilenames}</dd>
      </div>
      <div>
        <dt>Active files found</dt>
        <dd class:list={["legacy-ebook-lookup__stat-ok", activeFilesMissing === 0 && activeBooksWithFilenames > 0]}>
          {activeFilesFound}
        </dd>
      </div>
      <div>
        <dt>Active files missing</dt>
        <dd class:list={["legacy-ebook-lookup__stat-warn", activeFilesMissing > 0]}>
          {activeFilesMissing}
        </dd>
      </div>
      <div>
        <dt>Inactive books</dt>
        <dd>{inactiveBooks}</dd>
      </div>
      <div>
        <dt>Files in shop folder</dt>
        <dd>{shopFiles.length}</dd>
      </div>
      <div>
        <dt>Books with filenames</dt>
        <dd>{booksWithFilenames}</dd>
      </div>
      <div>
        <dt>Files found (all)</dt>
        <dd>{filesFound}</dd>
      </div>
      <div>
        <dt>Missing files (all)</dt>
        <dd class:list={["legacy-ebook-lookup__stat-warn", missingFiles > 0]}>
          {missingFiles}
        </dd>
      </div>
      <div>
        <dt>Books with no filename</dt>
        <dd>{booksWithNoFilename}</dd>
      </div>
      <div>
        <dt>Unmatched shop files</dt>
        <dd>{unmatchedShopFiles.length}</dd>
      </div>
    </dl>
    {activeFilesMissing === 0 && activeBooksWithFilenames > 0 ? (
      <p class="legacy-ebook-lookup__success-note">
        All {activeBooksWithFilenames} active catalog titles with a filename have a
        matching file in <code>public/downloads/shop/</code>.
      </p>
    ) : activeFilesMissing > 0 ? (
      <div class="legacy-ebook-lookup__alert legacy-ebook-lookup__alert--error">
        <p>
          <strong>{activeFilesMissing}</strong> active title(s) still missing a shop file.
          Enable <strong>Show inactive titles</strong> to review inactive gaps.
        </p>
        <ul class="legacy-ebook-lookup__alert-list">
          {activeMissingRows.map((book) => (
            <li>
              <strong>{book.legacyId}</strong> — {book.title}
              {book.downloadFile && (
                <>
                  {" "}
                  (<code>{book.downloadFile}</code>)
                </>
              )}
            </li>
          ))}
        </ul>
      </div>
    ) : null}

    <section
      class="admin-panel help-hub-admin__table-panel"
      aria-labelledby="legacy-ebook-inventory-heading"
    >
      <h2 id="legacy-ebook-inventory-heading" class="visually-hidden">
        Legacy eBook inventory
      </h2>
      {books.length === 0 ? (
        <p class="help-hub-admin__empty">No legacy eBooks in catalog.</p>
      ) : (
        <>
        <div class="legacy-ebook-lookup__table-controls">
          <label class="legacy-ebook-lookup__show-inactive">
            <input
              type="checkbox"
              id="legacy-ebook-show-inactive"
              name="show-inactive-titles"
            />
            Show inactive titles
          </label>
          <label class="legacy-ebook-lookup__show-inactive">
            <input
              type="checkbox"
              id="legacy-ebook-show-missing-only"
              name="show-missing-files-only"
            />
            Show missing files only
          </label>
          <p class="legacy-ebook-lookup__visible-count" id="legacy-ebook-visible-count" aria-live="polite">
            Showing {activeBooks} active title{activeBooks === 1 ? "" : "s"}
            ({inactiveBooks} inactive hidden)
          </p>
        </div>
        <div class="help-hub-admin__table-wrap">
          <table
            id="legacy-ebook-inventory-table"
            class="help-hub-admin__table legacy-ebook-lookup__table"
          >
            <thead>
              <tr>
                <th
                  scope="col"
                  class="legacy-ebook-lookup__th-sortable is-sorted"
                  data-sort-column="legacyId"
                  aria-sort="ascending"
                >
                  <span class="legacy-ebook-lookup__th-label">Legacy ID</span>
                  <span class="legacy-ebook-lookup__sort-indicator" aria-hidden="true"
                    >↑</span
                  >
                </th>
                <th
                  scope="col"
                  class="legacy-ebook-lookup__th-sortable"
                  data-sort-column="title"
                  aria-sort="none"
                >
                  <span class="legacy-ebook-lookup__th-label">Title</span>
                  <span class="legacy-ebook-lookup__sort-indicator" aria-hidden="true"
                  ></span>
                </th>
                <th
                  scope="col"
                  class="legacy-ebook-lookup__th-sortable"
                  data-sort-column="filename"
                  aria-sort="none"
                >
                  <span class="legacy-ebook-lookup__th-label">Filename</span>
                  <span class="legacy-ebook-lookup__sort-indicator" aria-hidden="true"
                  ></span>
                </th>
                <th
                  scope="col"
                  class="legacy-ebook-lookup__th-sortable"
                  data-sort-column="active"
                  aria-sort="none"
                >
                  <span class="legacy-ebook-lookup__th-label">Active</span>
                  <span class="legacy-ebook-lookup__sort-indicator" aria-hidden="true"
                  ></span>
                </th>
                <th
                  scope="col"
                  class="legacy-ebook-lookup__th-sortable"
                  data-sort-column="fileStatus"
                  aria-sort="none"
                >
                  <span class="legacy-ebook-lookup__th-label">File Status</span>
                  <span class="legacy-ebook-lookup__sort-indicator" aria-hidden="true"
                  ></span>
                </th>
              </tr>
            </thead>
            <tbody id="legacy-ebook-inventory-tbody">
              {books.map((book) => (
                <tr
                  class:list={[
                    book.fileStatus === "missing" && "legacy-ebook-lookup__row--missing-file",
                    book.active === true &&
                      book.fileStatus === "missing" &&
                      "legacy-ebook-lookup__row--active-missing",
                  ]}
                  data-inactive-title={book.active === false ? "true" : "false"}
                  data-missing-file={book.fileStatus === "missing" ? "true" : "false"}
                  data-legacy-id={book.legacyId}
                  data-title={book.title}
                  data-filename={book.downloadFile ?? ""}
                  data-active={
                    book.active === true
                      ? "2"
                      : book.active === false
                        ? "1"
                        : "0"
                  }
                  data-file-status={fileStatusSortKey(book.fileStatus)}
                >
                  <td class="legacy-ebook-lookup__col-id">
                    {formatLegacyCell(book.legacyId)}
                  </td>
                  <td class="legacy-ebook-lookup__col-title">
                    {formatLegacyCell(book.title)}
                  </td>
                  <td class="legacy-ebook-lookup__col-file">
                    {book.fileStatus === "found" &&
                    book.matchedShopFile &&
                    book.downloadFile ? (
                      <a
                        href={getLegacyShopDownloadPublicUrl(book.matchedShopFile)!}
                        class="legacy-ebook-lookup__file-link"
                        target="_blank"
                        rel="noopener noreferrer"
                        title={
                          book.matchedShopFile &&
                          book.matchedShopFile !== book.downloadFile
                            ? `Open ${book.matchedShopFile}`
                            : `Open ${book.downloadFile}`
                        }
                      >
                        <code>{book.downloadFile}</code>
                      </a>
                    ) : book.downloadFile ? (
                      <code>{book.downloadFile}</code>
                    ) : (
                      "—"
                    )}
                  </td>
                  <td
                    class:list={[
                      "legacy-ebook-lookup__col-active",
                      book.active === true && "is-active",
                      book.active === false && "is-inactive",
                    ]}
                  >
                    {formatActiveLabel(book.active)}
                  </td>
                  <td
                    class:list={[
                      "legacy-ebook-lookup__col-file-status",
                      book.fileStatus === "found" && "is-found",
                      book.fileStatus === "missing" && "is-missing",
                      book.fileStatus === "no-filename" && "is-no-filename",
                    ]}
                    title={
                      book.matchedShopFile &&
                      book.downloadFile &&
                      book.matchedShopFile !== book.downloadFile
                        ? `On disk: ${book.matchedShopFile}`
                        : undefined
                    }
                  >
                    {formatFileStatusLabel(book.fileStatus)}
                    {book.matchedShopFile &&
                      book.downloadFile &&
                      book.matchedShopFile.toLowerCase() !==
                        book.downloadFile.toLowerCase() && (
                        <span class="legacy-ebook-lookup__on-disk">
                          <code>{book.matchedShopFile}</code>
                        </span>
                      )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        </>
      )}
    </section>

    <section
      class="admin-panel legacy-ebook-lookup__unmatched-panel"
      aria-labelledby="unmatched-shop-files-heading"
    >
      <h2 id="unmatched-shop-files-heading" class="legacy-ebook-lookup__section-title">
        Unmatched files in public/downloads/shop
      </h2>
      <p class="legacy-ebook-lookup__section-sub">
        PDF and ZIP files on disk that are not linked to any legacy catalog row by the
        audit rules above. Compare these against rows marked <strong>Missing file</strong>
        when filenames were renamed.
      </p>
      {unmatchedWithMissingId.length > 0 && (
        <p class="legacy-ebook-lookup__hint-note">
          {unmatchedWithMissingId.length} unmatched file(s) use a legacy ID prefix that
          matches a catalog row still marked missing — likely renamed on disk.
        </p>
      )}
      {unmatchedShopFiles.length === 0 ? (
        <p class="help-hub-admin__empty">All PDF/ZIP files in the shop folder are matched.</p>
      ) : (
        <div class="help-hub-admin__table-wrap">
          <table class="help-hub-admin__table legacy-ebook-lookup__unmatched-table">
            <thead>
              <tr>
                <th scope="col">Filename</th>
                <th scope="col">Type</th>
                <th scope="col">Size</th>
                <th scope="col">Legacy ID prefix</th>
              </tr>
            </thead>
            <tbody>
              {unmatchedShopFiles.map((file) => (
                <tr
                  class:list={[
                    file.legacyIdPrefix &&
                      missingLegacyIds.has(file.legacyIdPrefix) &&
                      "legacy-ebook-lookup__unmatched--likely-renamed",
                  ]}
                >
                  <td class="legacy-ebook-lookup__col-file">
                    <code>{file.filename}</code>
                  </td>
                  <td>{file.fileType}</td>
                  <td class="legacy-ebook-lookup__col-size">
                    {formatShopFileSizeKb(file.sizeKb)}
                  </td>
                  <td class="legacy-ebook-lookup__col-id">
                    {file.legacyIdPrefix ?? "—"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </main>

  <style>
    :global(body.help-hub-admin-body) {
      margin: 0;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .help-hub-admin {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 1.25rem 1.5rem 3rem;
      box-sizing: border-box;
    }

    .help-hub-admin__head {
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e2e8f0;
    }

    .help-hub-admin__title {
      margin: 0 0 0.35rem 0;
      font-size: 1.65rem;
      color: #243015;
    }

    .help-hub-admin__sub {
      margin: 0;
      font-size: 0.95rem;
      color: #475569;
      max-width: 56rem;
    }

    .help-hub-admin__sub code {
      font-size: 0.88em;
      background: #f1f5f9;
      padding: 0.12rem 0.35rem;
      border-radius: 4px;
    }

    .help-hub-admin__toolbar {
      margin-bottom: 1rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1rem;
    }

    .legacy-ebook-lookup__stats {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
      margin: 0 0 1rem 0;
      padding: 0;
    }

    .legacy-ebook-lookup__stats div {
      margin: 0;
    }

    .legacy-ebook-lookup__stats dt {
      margin: 0;
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #64748b;
    }

    .legacy-ebook-lookup__stats dd {
      margin: 0.15rem 0 0 0;
      font-size: 1.1rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: #243015;
    }

    .legacy-ebook-lookup__table-controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1.5rem;
      margin-bottom: 1rem;
    }

    .legacy-ebook-lookup__show-inactive {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.95rem;
      color: #374151;
      cursor: pointer;
      user-select: none;
    }

    .legacy-ebook-lookup__show-inactive input {
      width: 1rem;
      height: 1rem;
      margin: 0;
      cursor: pointer;
    }

    .legacy-ebook-lookup__visible-count {
      margin: 0;
      font-size: 0.9rem;
      color: #64748b;
    }

    .legacy-ebook-lookup__row--hidden-inactive {
      display: none;
    }

    .legacy-ebook-lookup__stat-ok {
      color: #166534;
    }

    .legacy-ebook-lookup__stat-warn {
      color: #b91c1c;
    }

    .legacy-ebook-lookup__success-note {
      margin: 0 0 1rem 0;
      font-size: 0.95rem;
      color: #166534;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 8px;
      padding: 0.65rem 0.85rem;
      max-width: 56rem;
    }

    .legacy-ebook-lookup__success-note code {
      font-size: 0.88em;
      background: #dcfce7;
      padding: 0.1rem 0.3rem;
      border-radius: 4px;
    }

    .legacy-ebook-lookup__alert {
      margin: 0 0 1rem 0;
      border-radius: 8px;
      padding: 0.65rem 0.85rem;
      max-width: 56rem;
    }

    .legacy-ebook-lookup__alert p {
      margin: 0 0 0.5rem 0;
      font-size: 0.95rem;
    }

    .legacy-ebook-lookup__alert--error {
      color: #7f1d1d;
      background: #fef2f2;
      border: 1px solid #fecaca;
    }

    .legacy-ebook-lookup__alert-list {
      margin: 0;
      padding-left: 1.25rem;
      font-size: 0.92rem;
    }

    .legacy-ebook-lookup__alert-list code {
      font-size: 0.88em;
      background: #fee2e2;
      padding: 0.08rem 0.3rem;
      border-radius: 4px;
    }

    .legacy-ebook-lookup__row--missing-file {
      background: #fef2f2;
    }

    .legacy-ebook-lookup__row--missing-file:hover {
      background: #fee2e2;
    }

    .legacy-ebook-lookup__row--active-missing {
      outline: 2px solid #b91c1c;
      outline-offset: -2px;
    }

    .admin-panel {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 1rem;
    }

    .help-hub-admin__empty {
      margin: 0;
      color: #64748b;
    }

    .help-hub-admin__table-wrap {
      overflow-x: auto;
    }

    .help-hub-admin__table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.92rem;
    }

    .help-hub-admin__table th,
    .help-hub-admin__table td {
      border-bottom: 1px solid #e5e7eb;
      padding: 0.65rem 0.5rem;
      text-align: left;
      vertical-align: top;
    }

    .help-hub-admin__table th {
      font-weight: 700;
      color: #243015;
      background: #f8fafc;
    }

    .legacy-ebook-lookup__table thead th.legacy-ebook-lookup__th-sortable {
      cursor: pointer;
      user-select: none;
    }

    .legacy-ebook-lookup__th-label {
      display: inline;
    }

    .legacy-ebook-lookup__sort-indicator {
      display: inline-block;
      min-width: 1ch;
      margin-left: 0.2rem;
      font-size: 0.85em;
      font-weight: 600;
      color: #526b2d;
    }

    .legacy-ebook-lookup__th-sortable:not(.is-sorted) .legacy-ebook-lookup__sort-indicator {
      visibility: hidden;
    }

    .help-hub-admin__table tbody tr:hover {
      background: #fafafa;
    }

    .legacy-ebook-lookup__col-id {
      font-variant-numeric: tabular-nums;
      color: #475569;
      white-space: nowrap;
      width: 5rem;
    }

    .legacy-ebook-lookup__col-title {
      font-weight: 600;
      color: #111827;
      max-width: 24rem;
    }

    .legacy-ebook-lookup__col-file code {
      font-size: 0.85em;
      background: #f1f5f9;
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      word-break: break-all;
    }

    .legacy-ebook-lookup__file-link {
      color: #1d4ed8;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .legacy-ebook-lookup__file-link:hover {
      color: #1e3a8a;
    }

    .legacy-ebook-lookup__file-link code {
      background: #eff6ff;
    }

    .legacy-ebook-lookup__file-link:hover code {
      background: #dbeafe;
    }

    .legacy-ebook-lookup__col-active {
      white-space: nowrap;
      width: 6rem;
    }

    .legacy-ebook-lookup__col-active.is-active {
      color: #166534;
      font-weight: 600;
    }

    .legacy-ebook-lookup__col-active.is-inactive {
      color: #64748b;
    }

    .legacy-ebook-lookup__col-file-status {
      white-space: nowrap;
      min-width: 7rem;
    }

    .legacy-ebook-lookup__col-file-status.is-found {
      color: #166534;
      font-weight: 600;
    }

    .legacy-ebook-lookup__col-file-status.is-missing {
      color: #b91c1c;
      font-weight: 600;
    }

    .legacy-ebook-lookup__col-file-status.is-no-filename {
