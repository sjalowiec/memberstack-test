---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Videos Admin | Knit it Now"
  description="Browse and manage the public video catalog (videos-public.json)"
  bodyClass="videos-admin-body help-hub-admin-body"
>
  <main class="help-hub-admin">
    <header class="help-hub-admin__head">
      <h1 class="help-hub-admin__title">Videos Admin</h1>
      <p class="help-hub-admin__sub">
        Search by KIN ID, title, or Vimeo ID.
        Favorite totals and Tip of the Week dates are calculated from saved records.
      </p>
    </header>

    <p id="videos-admin-status" class="help-hub-admin__status" aria-live="polite"></p>
    <p id="videos-admin-data-note" class="videos-admin__note" hidden></p>

    <div class="help-hub-admin__toolbar">
      <a href="/admin/videos-edit" class="kbm-btn kbm-btn-primary">+ New video</a>
      <p class="videos-admin__sub-nav">
        <a href="/admin/lessons-admin">Lessons admin</a>
        ·
        <a href="/admin/tips-admin">Help Hub tips</a>
      </p>
    </div>

    <section class="videos-admin-search" aria-labelledby="videos-admin-search-label">
      <div class="videos-admin-search__head">
        <label id="videos-admin-search-label" for="videos-admin-search">Search videos</label>
        <p id="videos-admin-search-count" class="videos-admin-search__count" aria-live="polite"></p>
      </div>
      <p class="videos-admin-search__hint">KIN ID, title, or Vimeo ID. For example, 707.</p>
      <div class="videos-admin-search__row">
        <input
          type="search"
          id="videos-admin-search"
          class="videos-admin__search"
          placeholder="707, hung hem, or 151859846"
          autocomplete="off"
          enterkeyhint="search"
        />
        <button type="button" id="videos-admin-search-clear" class="kbm-btn kbm-btn-outline">
          Clear search
        </button>
      </div>
    </section>

    <section id="videos-admin-match" class="videos-admin-match" hidden aria-live="polite">
      <h2 id="videos-admin-match-title" class="videos-admin-match__title"></h2>
      <dl class="videos-admin-match__facts">
        <div>
          <dt>KIN ID</dt>
          <dd id="videos-admin-match-number"></dd>
        </div>
        <div>
          <dt>Vimeo ID</dt>
          <dd>
            <code id="videos-admin-match-vimeo"></code>
          </dd>
        </div>
      </dl>
      <p class="videos-admin-match__actions">
        <a id="videos-admin-match-edit" class="kbm-btn kbm-btn-primary" href="/admin/videos-edit">Edit video</a>
      </p>
    </section>

    <section class="admin-panel help-hub-admin__table-panel" aria-labelledby="list-heading">
      <h2 id="list-heading" class="visually-hidden">All videos</h2>
      <p id="videos-admin-loading" class="help-hub-admin__loading">Loading…</p>
      <div id="videos-table-wrap" class="help-hub-admin__table-wrap" hidden>
        <table id="videos-admin-table" class="help-hub-admin__table">
          <thead>
            <tr>
              <th scope="col" data-sort-column="kinId" aria-sort="ascending">
                <button type="button" class="videos-admin__sort">KIN ID <span class="videos-admin__sort-mark" aria-hidden="true">↑</span></button>
              </th>
              <th scope="col" data-sort-column="title" aria-sort="none">
                <button type="button" class="videos-admin__sort">Title <span class="videos-admin__sort-mark" aria-hidden="true"></span></button>
              </th>
              <th scope="col" data-sort-column="status" aria-sort="none">
                <button type="button" class="videos-admin__sort">Status <span class="videos-admin__sort-mark" aria-hidden="true"></span></button>
              </th>
              <th scope="col" data-sort-column="access" aria-sort="none">
                <button type="button" class="videos-admin__sort">Access <span class="videos-admin__sort-mark" aria-hidden="true"></span></button>
              </th>
              <th scope="col" data-sort-column="vimeoId" aria-sort="none">
                <button type="button" class="videos-admin__sort">Vimeo ID <span class="videos-admin__sort-mark" aria-hidden="true"></span></button>
              </th>
              <th scope="col" data-sort-column="favorites" aria-sort="none">
                <button type="button" class="videos-admin__sort">Favorites <span class="videos-admin__sort-mark" aria-hidden="true"></span></button>
              </th>
              <th scope="col" data-sort-column="tip" aria-sort="none">
                <button type="button" class="videos-admin__sort">Tip of the Week <span class="videos-admin__sort-mark" aria-hidden="true"></span></button>
              </th>
              <th scope="col" class="help-hub-admin__th-actions">Actions</th>
            </tr>
          </thead>
          <tbody id="videos-table-body"></tbody>
        </table>
      </div>
      <p id="videos-admin-empty" class="help-hub-admin__empty" hidden>No videos in catalog.</p>
    </section>
  </main>

  <style>
    :global(body.help-hub-admin-body) {
      margin: 0;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .help-hub-admin {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 1.25rem 1.5rem 3rem;
      box-sizing: border-box;
    }

    .help-hub-admin__head {
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e2e8f0;
    }

    .help-hub-admin__title {
      margin: 0 0 0.35rem 0;
      font-size: 1.65rem;
      color: #243015;
    }

    .help-hub-admin__sub {
      margin: 0;
      font-size: 0.95rem;
      color: #475569;
      max-width: 56rem;
    }

    .help-hub-admin__sub code {
      font-size: 0.88em;
      background: #f1f5f9;
      padding: 0.12rem 0.35rem;
      border-radius: 4px;
    }

    .help-hub-admin__status {
      min-height: 1.4em;
      margin: 0 0 1rem 0;
      font-size: 0.95rem;
      color: #374151;
    }

    .help-hub-admin__status.is-error {
      color: #b91c1c;
      font-weight: 600;
    }

    .help-hub-admin__status.is-ok {
      color: #166534;
    }

    .videos-admin__note {
      margin: -0.35rem 0 1rem;
      max-width: 56rem;
      color: #9a3412;
      font-size: 0.92rem;
    }

    .help-hub-admin__toolbar {
      margin-bottom: 1rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1rem;
    }

    .videos-admin__sub-nav {
      margin: 0;
      font-size: 0.95rem;
    }

    .videos-admin-search {
      position: sticky;
      top: 0.75rem;
      z-index: 20;
      margin: 0 0 1rem;
      padding: 1rem 1.1rem;
      background: #fff;
      border: 2px solid #5d7340;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(36, 48, 21, 0.08);
    }

    .videos-admin-search__head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.35rem 1rem;
    }

    .videos-admin-search label {
      font-size: 1.15rem;
      font-weight: 800;
      color: #243015;
    }

    .videos-admin-search__count {
      margin: 0;
      font-size: 1rem;
      font-weight: 700;
      color: #3f6212;
    }

    .videos-admin-search__hint {
      margin: 0.2rem 0 0.7rem;
      color: #475569;
      font-size: 0.95rem;
    }

    .videos-admin-search__row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
    }

    .videos-admin__search {
      flex: 1 1 16rem;
      width: 100%;
      min-height: 3rem;
      box-sizing: border-box;
      border: 2px solid #243015;
      border-radius: 8px;
      padding: 0.65rem 0.8rem;
      background: #fff;
      color: #111827;
      font: inherit;
      font-size: 1.05rem;
      font-weight: 600;
    }

    .videos-admin__search:focus {
      outline: 3px solid #84a15a;
      border-color: #5d7340;
    }

    .videos-admin-search__row .kbm-btn {
      min-height: 3rem;
    }

    .videos-admin-match {
      margin: 0 0 1rem 0;
      background: #fff;
      border: 1px solid #d6e0c8;
      border-radius: 12px;
      padding: 1rem 1.1rem;
    }

    .videos-admin-match__title {
      margin: 0 0 0.75rem 0;
      font-size: 1.25rem;
      color: #243015;
    }

    .videos-admin-match__facts {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 2rem;
      margin: 0;
    }

    .videos-admin-match__facts dt {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: #64748b;
    }

    .videos-admin-match__facts dd {
      margin: 0.2rem 0 0 0;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.05rem;
    }

    .videos-admin-match__facts code {
      font-size: 1rem;
      background: #f1f5f9;
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
    }

    .videos-admin-match__actions {
      margin: 0.9rem 0 0 0;
    }

    .admin-panel {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 1rem;
    }

    .help-hub-admin__loading {
      margin: 0;
      color: #64748b;
      font-size: 0.95rem;
    }

    .help-hub-admin__empty {
      margin: 0;
      color: #64748b;
    }

    .help-hub-admin__table-wrap {
      overflow-x: auto;
    }

    .help-hub-admin__table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.84rem;
    }

    .help-hub-admin__table th,
    .help-hub-admin__table td {
      border-bottom: 1px solid #e5e7eb;
      padding: 0.4rem 0.4rem;
      text-align: left;
      vertical-align: top;
    }

    .help-hub-admin__table th {
      font-weight: 700;
      color: #243015;
      background: #f8fafc;
    }

    .help-hub-admin__table tbody tr:hover {
      background: #fafafa;
    }

    .help-hub-admin__th-actions {
      width: 1%;
    }

    .help-hub-admin__table thead th {
      white-space: nowrap;
    }

    .videos-admin__sort {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .videos-admin__sort:focus-visible {
      outline: 2px solid #5d7340;
      outline-offset: 2px;
    }

    .help-hub-admin__table thead th[aria-sort="ascending"],
    .help-hub-admin__table thead th[aria-sort="descending"] {
      background: #ecfdf5;
      color: #14532d;
    }

    .videos-admin__sort-mark {
      font-size: 0.75rem;
    }

    .help-hub-admin__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      align-items: center;
    }

    .help-hub-admin__actions .kbm-btn {
      font-size: 0.85rem;
      padding: 0.35rem 0.6rem;
    }

    .col-title {
      font-weight: 600;
      color: #111827;
      max-width: 18rem;
    }

    .col-id,
    .col-vimeo,
    .col-count {
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .videos-admin__tip span {
      display: block;
      white-space: nowrap;
      line-height: 1.35;
    }

    .videos-admin__gap {
      color: #9a3412;
      font-weight: 700;
    }
  </style>

  <script>
    import { fetchAdminJson, promptAdminSignIn } from "../../lib/admin/adminAuthClient";
    import { stableVideoKey } from "../../lib/lessonVideo";
    import { videoMatchesAdminSearch, vimeoIdKey } from "../../lib/videos/videoAdminSearch";
    import {
      favoriteCountForVideo,
      orderVideoAdminRows,
      tipSummaryForVideo,
      videoAdminAccessLabel,
      videoAdminDataNotes,
      videoAdminKinId,
      videoAdminStatusLabel,
      videoAdminTipLines,
      type VideoAdminFavoritesSource,
      type VideoAdminSortColumn,
      type VideoAdminSortable,
      type VideoAdminTipsSource,
    } from "../../lib/videos/videoAdminPlanning";

    const API_BASE = "/api/admin/videos";
    const PLANNING_API = "/api/admin/videos/planning";

    type VideoRow = Record<string, unknown>;
    type SortDirection = "asc" | "desc";
    type ListedVideo = VideoAdminSortable & { video: VideoRow; key: string; tipLines: string[] | null };

    let videos: VideoRow[] = [];
    let favoritesSource: VideoAdminFavoritesSource = {
      ok: false,
      error: "Favorite counts have not loaded.",
    };
    let tipsSource: VideoAdminTipsSource = {
      ok: false,
      error: "Tip of the Week history has not loaded.",
    };
    let sortColumn: VideoAdminSortColumn = "kinId";
    let sortDirection: SortDirection = "asc";

    const statusEl = document.getElementById("videos-admin-status");
    const dataNoteEl = document.getElementById("videos-admin-data-note");
    const tableEl = document.getElementById("videos-admin-table");
    const loadingEl = document.getElementById("videos-admin-loading");
    const tableWrapEl = document.getElementById("videos-table-wrap");
    const tbodyEl = document.getElementById("videos-table-body");
    const emptyEl = document.getElementById("videos-admin-empty");
    const SEARCH_STORAGE_KEY = "videos-admin-search";

    function readStoredSearch(): string {
      try {
        return sessionStorage.getItem(SEARCH_STORAGE_KEY) ?? "";
      } catch {
        return "";
      }
    }

    function storeSearch(value: string) {
      try {
        if (value.trim()) sessionStorage.setItem(SEARCH_STORAGE_KEY, value);
        else sessionStorage.removeItem(SEARCH_STORAGE_KEY);
      } catch {
        /* The box still filters this visit. */
      }
    }

    const searchEl = document.getElementById("videos-admin-search");
    const searchCountEl = document.getElementById("videos-admin-search-count");
    const searchClearEl = document.getElementById("videos-admin-search-clear");
    const matchEl = document.getElementById("videos-admin-match");
    const matchTitleEl = document.getElementById("videos-admin-match-title");
    const matchNumberEl = document.getElementById("videos-admin-match-number");
    const matchVimeoEl = document.getElementById("videos-admin-match-vimeo");
    const matchEditEl = document.getElementById("videos-admin-match-edit");
    let searchQuery = readStoredSearch();
    if (searchEl instanceof HTMLInputElement) searchEl.value = searchQuery;

    function setStatus(message: string, kind: "ok" | "err" | "neutral" = "neutral") {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.toggle("is-error", kind === "err");
      statusEl.classList.toggle("is-ok", kind === "ok");
    }

    function asString(v: unknown) {
      return v === null || v === undefined ? "" : String(v);
    }

    function vimeoLabel(v: VideoRow) {
      return vimeoIdKey(v.vimeo_id);
    }

    function isSortColumn(value: string | undefined): value is VideoAdminSortColumn {
      return (
        value === "kinId" ||
        value === "title" ||
        value === "status" ||
        value === "access" ||
        value === "vimeoId" ||
        value === "favorites" ||
        value === "tip"
      );
    }

    function listedVideos(): ListedVideo[] {
      const prepared = videos.flatMap((video) => {
        const key = stableVideoKey(video as Parameters<typeof stableVideoKey>[0]);
        if (!key || !videoMatchesAdminSearch(video, searchQuery)) return [];
        const favoriteCount = favoriteCountForVideo(favoritesSource, video.content_id);
        const tip = tipSummaryForVideo(tipsSource, video.content_id);
        return [
          {
            video,
            key,
            kinId: videoAdminKinId(video.content_id),
            title: asString(video.title),
            status: videoAdminStatusLabel(video.status),
            access: videoAdminAccessLabel(video.access_level),
            vimeoId: vimeoLabel(video),
            favoriteCount,
            tipSortDate: tip ? (tip.latestStart ?? "") : null,
            tipLines: tip ? videoAdminTipLines(tip) : null,
            stableKey: key,
          },
        ];
      });
      return orderVideoAdminRows(prepared, sortColumn, sortDirection);
    }

    function updateSortHeaders() {
      if (!(tableEl instanceof HTMLTableElement)) return;
      const headers = tableEl.querySelectorAll("th[data-sort-column]");
      for (const header of headers) {
        if (!(header instanceof HTMLTableCellElement)) continue;
        const column = header.dataset.sortColumn;
        const active = column === sortColumn;
        header.setAttribute("aria-sort", active ? (sortDirection === "asc" ? "ascending" : "descending") : "none");
        const mark = header.querySelector(".videos-admin__sort-mark");
        if (mark) mark.textContent = active ? (sortDirection === "asc" ? "↑" : "↓") : "";
      }
    }

    function renderMatch(rows: ListedVideo[]) {
      if (!matchEl || !matchTitleEl || !matchNumberEl || !matchVimeoEl || !matchEditEl) return;
      const query = searchQuery.trim();
      if (!query || rows.length !== 1) {
        matchEl.hidden = true;
        return;
      }
      const { video, key, kinId, vimeoId } = rows[0];
      matchTitleEl.textContent = asString(video.title) || key;
      matchNumberEl.textContent = kinId || "None";
      matchVimeoEl.textContent = vimeoId || "None";
      matchEditEl.href = `/admin/videos-edit?key=${encodeURIComponent(key)}`;
      matchEl.hidden = false;
    }

    function favoriteCell(count: number | null) {
      if (count === null) return `<td class="videos-admin__gap">Unavailable</td>`;
      return `<td class="col-count">${count}</td>`;
    }

    function tipCell(lines: string[] | null) {
      if (!lines) return `<td class="videos-admin__gap">Unavailable</td>`;
      return `<td class="videos-admin__tip">${lines.map((line) => `<span>${escapeHtml(line)}</span>`).join("")}</td>`;
    }

    function renderTable() {
      if (!tbodyEl || !tableWrapEl || !emptyEl || !loadingEl) return;
      loadingEl.hidden = true;
      const rows = listedVideos();
      renderMatch(rows);
      updateSortHeaders();
      if (rows.length === 0) {
        tableWrapEl.hidden = true;
        emptyEl.hidden = false;
        emptyEl.textContent = searchQuery.trim() ? "No matching videos" : "No videos in catalog.";
        tbodyEl.innerHTML = "";
        return;
      }
      emptyEl.hidden = true;
      tableWrapEl.hidden = false;

      tbodyEl.innerHTML = rows
        .map((row) => {
          const href = `/admin/videos-edit?key=${encodeURIComponent(row.key)}`;
          return `<tr>
            <td class="col-id">${escapeHtml(row.kinId)}</td>
            <td class="col-title">${escapeHtml(row.title)}</td>
            <td>${escapeHtml(row.status)}</td>
            <td>${escapeHtml(row.access)}</td>
            <td class="col-vimeo">${escapeHtml(row.vimeoId)}</td>
            ${favoriteCell(row.favoriteCount)}
            ${tipCell(row.tipLines)}
            <td class="help-hub-admin__actions">
              <a class="kbm-btn kbm-btn-outline" href="${href}">Edit</a>
            </td>
          </tr>`;
        })
        .join("");
    }

    function escapeHtml(s: string) {
      return s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function reportSearch() {
      const query = searchQuery.trim();
      const shown = query ? listedVideos().length : videos.length;
      if (searchCountEl) {
        if (!videos.length && !query) searchCountEl.textContent = "";
        else if (!query) searchCountEl.textContent = `${videos.length} videos`;
        else searchCountEl.textContent = shown === 1 ? "1 match" : `${shown} matches`;
      }
      if (searchClearEl instanceof HTMLButtonElement) searchClearEl.disabled = query.length === 0;
      if (!query) {
        setStatus(`${videos.length} video(s) loaded.`, "ok");
        return;
      }
      setStatus(shown === 1 ? "1 match." : `${shown} matches.`, shown ? "ok" : "neutral");
    }

    function showDataNotes() {
      if (!dataNoteEl) return;
      const notes = videoAdminDataNotes({ favorites: favoritesSource, tips: tipsSource });
      dataNoteEl.hidden = notes.length === 0;
      dataNoteEl.textContent = notes.join(" ");
    }

    async function load() {
      setStatus("Loading catalog…");
      try {
        const [catalogResult, planningResult] = await Promise.all([
          fetchAdminJson<{ videos?: VideoRow[] }>(API_BASE, { method: "GET" }),
          fetchAdminJson<{
            favorites?: VideoAdminFavoritesSource;
            tips?: VideoAdminTipsSource;
          }>(PLANNING_API, { method: "GET" }),
        ]);
        if (!catalogResult.ok || !Array.isArray(catalogResult.data.videos)) {
          if (catalogResult.needsSignIn) promptAdminSignIn("/admin/videos-admin");
          setStatus(catalogResult.error || "Load failed.", "err");
          return;
        }
        videos = catalogResult.data.videos;
        if (
          planningResult.ok &&
          planningResult.data.favorites &&
          planningResult.data.tips &&
          typeof planningResult.data.favorites.ok === "boolean" &&
          typeof planningResult.data.tips.ok === "boolean"
        ) {
          favoritesSource = planningResult.data.favorites;
          tipsSource = planningResult.data.tips;
        } else {
          if (planningResult.needsSignIn) promptAdminSignIn("/admin/videos-admin");
          const message =
            planningResult.error ||
            "Favorite counts and Tip of the Week history could not be loaded.";
          favoritesSource = { ok: false, error: message };
          tipsSource = { ok: false, error: message };
        }
        showDataNotes();
        reportSearch();
        renderTable();
      } catch {
        setStatus("Network error loading videos.", "err");
      }
    }

    searchEl?.addEventListener("input", () => {
      if (!(searchEl instanceof HTMLInputElement)) return;
      searchQuery = searchEl.value;
      storeSearch(searchQuery);
      reportSearch();
      renderTable();
    });

    searchClearEl?.addEventListener("click", () => {
      searchQuery = "";
      if (searchEl instanceof HTMLInputElement) {
        searchEl.value = "";
        searchEl.focus();
      }
      storeSearch("");
      reportSearch();
      renderTable();
    });

    tableEl?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const header = target.closest("th[data-sort-column]");
      if (!(header instanceof HTMLTableCellElement)) return;
      const column = header.dataset.sortColumn;
      if (!isSortColumn(column)) return;
      if (column === sortColumn) sortDirection = sortDirection === "asc" ? "desc" : "asc";
      else {
        sortColumn = column;
        sortDirection = "asc";
      }
      renderTable();
    });

    load();
  </script>
</BaseLayout>
