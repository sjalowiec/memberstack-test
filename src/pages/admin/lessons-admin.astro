---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Lessons Admin | Knit it Now"
  description="Browse and manage lessons (lessons.json)"
  skipGlobalHyvor={true}
  bodyClass="lessons-admin-body help-hub-admin-body"
>
  <Fragment slot="head">
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jquery.tablesorter/2.31.3/js/jquery.tablesorter.min.js"></script>
  </Fragment>
  <main class="help-hub-admin">
    <header class="help-hub-admin__head">
      <h1 class="help-hub-admin__title">Lessons Admin</h1><a href="tips-admin">💡Help Hub Tips</a>
      <p class="help-hub-admin__sub">
        Data lives in <code>src/data/lessons.json</code> and is updated via <code>/api/admin/lessons</code>. Use Edit to change a lesson; IDs are permanent. Videos are selected from <code>src/data/videos-public.json</code> in the lesson editor (field <code>videoSlug</code>).
      </p>
    </header>

    <p id="lessons-admin-status" class="help-hub-admin__status" aria-live="polite"></p>

    <div class="help-hub-admin__toolbar">
      <a href="/admin/lessons-edit" class="kbm-btn kbm-btn-primary">+ New Lesson</a>
      <p class="lessons-admin__sub-nav">
        <a href="/admin/videos-admin">Video catalog</a>
        ·
        <a href="/admin/tips-admin">Help Hub tips</a>
      </p>
    </div>

    <section class="admin-panel help-hub-admin__table-panel" aria-labelledby="list-heading">
      <h2 id="list-heading" class="visually-hidden">All lessons</h2>
      <p id="lessons-admin-loading" class="help-hub-admin__loading">Loading…</p>
      <div id="lessons-table-wrap" class="help-hub-admin__table-wrap" hidden>
        <table id="lessons-admin-table" class="help-hub-admin__table">
          <thead>
            <tr>
              <th scope="col" class="help-hub-admin__th-remove"><span class="visually-hidden">Delete</span></th>
              <th scope="col">ID</th>
              <th scope="col">Title</th>
              <th scope="col">Slug</th>
              <th scope="col">Access</th>
              <th scope="col">Associated Tip</th>
              <th scope="col" class="help-hub-admin__th-actions">Actions</th>
            </tr>
          </thead>
          <tbody id="lessons-table-body"></tbody>
        </table>
      </div>
      <p id="lessons-admin-empty" class="help-hub-admin__empty" hidden>No lessons yet.</p>
    </section>
  </main>

  <style>
    :global(body.help-hub-admin-body) {
      margin: 0;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .help-hub-admin {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 1.25rem 1.5rem 3rem;
      box-sizing: border-box;
    }

    .help-hub-admin__head {
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e2e8f0;
    }

    .help-hub-admin__title {
      margin: 0 0 0.35rem 0;
      font-size: 1.65rem;
      color: #243015;
    }

    .help-hub-admin__sub {
      margin: 0;
      font-size: 0.95rem;
      color: #475569;
      max-width: 56rem;
    }

    .help-hub-admin__sub code {
      font-size: 0.88em;
      background: #f1f5f9;
      padding: 0.12rem 0.35rem;
      border-radius: 4px;
    }

    .help-hub-admin__status {
      min-height: 1.4em;
      margin: 0 0 1rem 0;
      font-size: 0.95rem;
      color: #374151;
    }

    .help-hub-admin__status.is-error {
      color: #b91c1c;
      font-weight: 600;
    }

    .help-hub-admin__status.is-ok {
      color: #166534;
    }

    .help-hub-admin__toolbar {
      margin-bottom: 1rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1rem;
    }

    .lessons-admin__sub-nav {
      margin: 0;
      font-size: 0.95rem;
    }

    .admin-panel {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 1rem;
    }

    .help-hub-admin__loading {
      margin: 0;
      color: #64748b;
      font-size: 0.95rem;
    }

    .help-hub-admin__empty {
      margin: 0;
      color: #64748b;
    }

    .help-hub-admin__table-wrap {
      overflow-x: auto;
    }

    .help-hub-admin__table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.92rem;
    }

    .help-hub-admin__table th,
    .help-hub-admin__table td {
      border-bottom: 1px solid #e5e7eb;
      padding: 0.65rem 0.5rem;
      text-align: left;
      vertical-align: top;
    }

    .help-hub-admin__table th {
      font-weight: 700;
      color: #243015;
      background: #f8fafc;
    }

    .help-hub-admin__table tbody tr:hover {
      background: #fafafa;
    }

    .help-hub-admin__table .col-remove {
      width: 1%;
      padding-left: 0.35rem;
      padding-right: 0.35rem;
      vertical-align: middle;
      text-align: center;
    }

    .help-hub-admin__row-remove {
      appearance: none;
      background: transparent;
      border: none;
      padding: 0.15rem 0.35rem;
      margin: 0;
      line-height: 1;
      font-size: 16px;
      font-weight: 700;
      color: #999;
      cursor: pointer;
      border-radius: 4px;
    }

    .help-hub-admin__row-remove:hover:not(:disabled),
    .help-hub-admin__row-remove:focus-visible:not(:disabled) {
      color: #b91c1c;
      background: #fef2f2;
    }

    .help-hub-admin__row-remove:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .help-hub-admin__table .col-id {
      font-variant-numeric: tabular-nums;
      color: #475569;
      white-space: nowrap;
      width: 4rem;
    }

    .help-hub-admin__table .col-title {
      font-weight: 600;
      color: #111827;
      max-width: 22rem;
    }

    .help-hub-admin__table .col-slug code {
      font-size: 0.85em;
      background: #f1f5f9;
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      word-break: break-all;
    }

    .help-hub-admin__table .col-access {
      white-space: nowrap;
      width: 6rem;
    }

    .help-hub-admin__table .col-associated-tip {
      color: #475569;
      max-width: 14rem;
      word-break: break-word;
    }

    .help-hub-admin__th-actions,
    .help-hub-admin__th-remove {
      width: 1%;
    }

    .help-hub-admin__table thead th {
      cursor: pointer;
      user-select: none;
    }

    .help-hub-admin__table thead th.help-hub-admin__th-actions,
    .help-hub-admin__table thead th.help-hub-admin__th-remove {
      cursor: default;
      user-select: auto;
    }

    .help-hub-admin__table thead th.tablesorter-headerAsc,
    .help-hub-admin__table thead th.tablesorter-headerDesc {
      background: #ecfdf5;
      color: #14532d;
    }

    .help-hub-admin__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      align-items: center;
    }

    .help-hub-admin__actions .kbm-btn {
      font-size: 0.85rem;
      padding: 0.35rem 0.6rem;
    }
  </style>

  <script>
    const API_BASE = "/api/admin/lessons";

    type LessonRow = Record<string, unknown>;

    let lessons: LessonRow[] = [];

    const statusEl = document.getElementById("lessons-admin-status");
    const loadingEl = document.getElementById("lessons-admin-loading");
    const tableWrapEl = document.getElementById("lessons-table-wrap");
    const tbodyEl = document.getElementById("lessons-table-body");
    const emptyEl = document.getElementById("lessons-admin-empty");

    function setStatus(message: string, kind: "ok" | "err" | "neutral" = "neutral") {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.toggle("is-error", kind === "err");
      statusEl.classList.toggle("is-ok", kind === "ok");
    }

    function getLessonId(row: LessonRow): number | null {
      const v = row?.id;
      const n = typeof v === "number" ? v : parseInt(String(v ?? ""), 10);
      return Number.isFinite(n) ? n : null;
    }

    function asString(v: unknown) {
      return v === null || v === undefined ? "" : String(v);
    }

    function associatedTipLabel(row: LessonRow): string {
      const t = asString(row.associatedTip).trim();
      return t || "—";
    }

    let tableSorterInited = false;

    function refreshTableSorter() {
      const w = window as unknown as {
        jQuery?: (sel: string) => {
          length: number;
          tablesorter: (opts?: object) => unknown;
          trigger: (name: string, ...args: unknown[]) => unknown;
        };
      };
      const $ = w.jQuery;
      if (!$) return;
      const $tab = $("#lessons-admin-table");
      if ($tab.length === 0) return;
      if (lessons.length === 0) {
        if (tableSorterInited) {
          $tab.trigger("destroy");
          tableSorterInited = false;
        }
        return;
      }
      if (!tableSorterInited) {
        $tab.tablesorter({
          headers: {
            0: { sorter: false },
            1: { sorter: "digit" },
            6: { sorter: false },
          },
          sortList: [[1, 1]],
        });
        tableSorterInited = true;
      } else {
        $tab.trigger("update");
      }
    }

    async function postLessons(next: LessonRow[]) {
      const res = await fetch(API_BASE, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(next),
      });
      const data = await res.json();
      if (!res.ok || !data?.ok || !Array.isArray(data.lessons)) {
        setStatus(data?.error || `Save failed (${res.status})`, "err");
        return false;
      }
      lessons = data.lessons as LessonRow[];
      return true;
    }

    async function deleteLesson(id: number) {
      if (!confirm(`Delete lesson id ${id}? This cannot be undone.`)) return;
      setStatus("Deleting…");
      const next = lessons.filter((l) => getLessonId(l) !== id);
      const ok = await postLessons(next);
      if (!ok) return;
      setStatus(`Deleted lesson id ${id}.`, "ok");
      renderTable();
    }

    function renderTable() {
      if (!tbodyEl || !loadingEl || !tableWrapEl || !emptyEl) return;
      loadingEl.hidden = true;
      if (lessons.length === 0) {
        tableWrapEl.hidden = true;
        emptyEl.hidden = false;
        tbodyEl.innerHTML = "";
        if (tableSorterInited) {
          const w = window as unknown as { jQuery?: (sel: string) => { trigger: (name: string) => unknown } };
          w.jQuery?.("#lessons-admin-table").trigger("destroy");
          tableSorterInited = false;
        }
        return;
      }
      emptyEl.hidden = true;
      tableWrapEl.hidden = false;
      tbodyEl.innerHTML = "";

      for (const row of lessons) {
        const id = getLessonId(row);
        const title = asString(row.title) || "(no title)";
        const slug = asString(row.slug).trim();
        const access = asString(row.access).trim() || "—";
        const tr = document.createElement("tr");

        const tdRemove = document.createElement("td");
        tdRemove.className = "col-remove";
        const rmBtn = document.createElement("button");
        rmBtn.type = "button";
        rmBtn.className = "help-hub-admin__row-remove";
        rmBtn.textContent = "×";
        rmBtn.setAttribute("aria-label", `Delete lesson: ${title}`);
        rmBtn.disabled = id === null;
        rmBtn.addEventListener("click", () => {
          if (id === null) return;
          void deleteLesson(id);
        });
        tdRemove.appendChild(rmBtn);

        const tdId = document.createElement("td");
        tdId.className = "col-id";
        tdId.textContent = id !== null ? String(id) : "—";

        const tdTitle = document.createElement("td");
        tdTitle.className = "col-title";
        tdTitle.textContent = title;

        const tdSlug = document.createElement("td");
        tdSlug.className = "col-slug";
        const code = document.createElement("code");
        code.textContent = slug || "—";
        tdSlug.appendChild(code);

        const tdAccess = document.createElement("td");
        tdAccess.className = "col-access";
        tdAccess.textContent = access;

        const tdTip = document.createElement("td");
        tdTip.className = "col-associated-tip";
        tdTip.textContent = associatedTipLabel(row);

        const tdActions = document.createElement("td");
        const wrap = document.createElement("div");
        wrap.className = "help-hub-admin__actions";

        const editLink = document.createElement("a");
        editLink.className = "kbm-btn kbm-btn-outline";
        editLink.href = id !== null ? `/admin/lessons-edit?id=${id}` : "/admin/lessons-edit";
        editLink.textContent = "Edit";

        wrap.appendChild(editLink);
        tdActions.appendChild(wrap);

        tr.appendChild(tdRemove);
        tr.appendChild(tdId);
        tr.appendChild(tdTitle);
        tr.appendChild(tdSlug);
        tr.appendChild(tdAccess);
        tr.appendChild(tdTip);
        tr.appendChild(tdActions);
        tbodyEl.appendChild(tr);
      }

      refreshTableSorter();
    }

    async function fetchLessons() {
      setStatus("Loading lessons…", "neutral");
      try {
        const res = await fetch(API_BASE);
        const data = (await res.json()) as { ok?: boolean; lessons?: LessonRow[]; error?: string };
        if (!res.ok || !data.ok || !Array.isArray(data.lessons)) {
          setStatus(data.error || `Failed to load (${res.status})`, "err");
          if (loadingEl) loadingEl.hidden = false;
          if (tableWrapEl) tableWrapEl.hidden = true;
          if (emptyEl) emptyEl.hidden = true;
          return;
        }
        lessons = data.lessons;
        setStatus(`Loaded ${lessons.length} lesson(s).`, "ok");
        renderTable();
      } catch {
        setStatus("Network error loading lessons.", "err");
        if (loadingEl) loadingEl.hidden = false;
      }
    }

    void fetchLessons();
  </script>
</BaseLayout>
