---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GlossaryTermModal from "../../components/glossary/GlossaryTermModal.astro";
import { isCourseContentAdminAllowed } from "../../lib/legacy_kin/courseContentAdmin";
import "../../styles/course-preview.css";
import "../../styles/course-content-editor.css";

export const prerender = false;

if (
  !isCourseContentAdminAllowed(Astro.url.hostname, {
    isViteDev: import.meta.env.DEV,
    publicSiteEnv: import.meta.env.PUBLIC_SITE_ENV,
  })
) {
  return Astro.redirect("/admin/");
}
---
<style>
  /* Room to scroll add-item buttons above the fixed Memberstack badge */
  body.course-editor-body .course-editor__center {
    padding-bottom: 6rem;
  }
</style>
<BaseLayout
  title="Course Content Editor | Admin"
  description="Edit legacy KIN course lesson content"
  skipGlobalHyvor={true}
  bodyClass="course-editor-body"
>
  <p id="course-editor-loading" class="course-editor__loading">Loading course data…</p>

  <div id="course-editor-app" class="course-editor" hidden>
    <header class="course-editor__header">
      <div class="course-editor__brand">
        <span class="course-editor__brand-icon" aria-hidden="true">📖</span>
        <span>Course editor</span>
        <span id="course-editor-save-hint" class="course-editor__save-hint">Saved</span>
      </div>
      <div class="course-editor__header-actions">
        <a href="/admin" class="kbm-btn kbm-btn-outline">Admin</a>
        <a
          id="course-editor-preview-link"
          class="kbm-btn kbm-btn-outline"
          href="/dev/course-preview"
          target="_blank"
          rel="noopener noreferrer"
        >
          Preview
        </a>
        <button type="button" id="course-editor-reload" class="kbm-btn kbm-btn-outline">
          Reload course
        </button>
        <button type="button" id="course-editor-advanced-toggle" class="kbm-btn kbm-btn-outline" aria-expanded="false">
          Lesson JSON
        </button>
        <button type="button" id="course-editor-revert" class="kbm-btn kbm-btn-outline" disabled>
          Revert
        </button>
        <button type="button" id="course-editor-save" class="kbm-btn kbm-btn-accent" disabled>
          Save lesson
        </button>
      </div>
    </header>

    <p id="course-editor-status" class="course-editor__status-bar" aria-live="polite"></p>

    <div class="course-editor__layout">
      <aside class="course-editor__sidebar">
        <div class="course-editor__sidebar-head">
          <span class="course-editor__sidebar-label">Course</span>
          <input
            id="course-editor-course-title"
            class="course-editor__course-title"
            type="text"
            readonly
            aria-readonly="true"
            title="Course title (read-only — edit in source file if needed)"
          />
          <div class="course-editor__course-status">
            <label class="course-editor__status-field" for="course-editor-published">
              <span class="course-editor__status-label">Publication</span>
              <select
                id="course-editor-published"
                class="course-editor__input course-editor__status-select"
                aria-label="Publication status"
              >
                <option value="false">Draft / unpublished</option>
                <option value="true">Published</option>
              </select>
            </label>
            <label class="course-editor__status-field" for="course-editor-active">
              <span class="course-editor__status-label">Catalog</span>
              <select
                id="course-editor-active"
                class="course-editor__input course-editor__status-select"
                aria-label="Catalog visibility"
              >
                <option value="true">Active — listed on /courses</option>
                <option value="false">Inactive — hidden from public site</option>
              </select>
            </label>
            <p class="course-editor__field-hint course-editor__status-hint">
              Staging preview still works when inactive. Save after changing visibility.
            </p>
            <button
              type="button"
              id="course-editor-status-save"
              class="kbm-btn kbm-btn-outline course-editor__status-save"
              disabled
            >
              Save visibility settings
            </button>
          </div>
          <select id="course-editor-course" class="course-editor__course-select" aria-label="Select course"></select>
        </div>
        <details id="course-editor-settings-panel" class="course-editor__settings-panel">
          <summary class="course-editor__settings-summary">Course settings</summary>
          <div class="course-editor__course-settings">
            <label class="course-editor__status-field" for="course-editor-content-status">
              <span class="course-editor__status-label">Content status</span>
              <select
                id="course-editor-content-status"
                class="course-editor__input course-editor__status-select"
                aria-label="Editorial content status"
              >
                <option value="in_progress">In progress — migration / cleanup ongoing</option>
                <option value="cleaned">Cleaned — hand-edited and ready</option>
              </select>
            </label>
            <p class="course-editor__field-hint">
              Tracks editorial cleanup only. Does not control public publication or catalog visibility.
            </p>
            <label class="course-editor__sidebar-label" for="course-editor-thumbnail">
              Course thumbnail
            </label>
            <div class="course-editor__thumbnail-path">
              <span class="course-editor__thumbnail-prefix" aria-hidden="true">/images/courses/</span>
              <input
                id="course-editor-thumbnail"
                class="course-editor__input course-editor__thumbnail-input"
                type="text"
                placeholder="beginner.webp"
                autocomplete="off"
                spellcheck="false"
              />
            </div>
            <p class="course-editor__field-hint">
              Enter the filename only. Saved as <code>/images/courses/…</code> on the public
              <a href="/courses/" target="_blank" rel="noopener noreferrer">/courses</a> catalog card.
            </p>
            <div id="course-editor-thumbnail-preview-wrap" class="course-editor__thumbnail-preview-wrap" hidden>
              <img
                id="course-editor-thumbnail-preview"
                class="course-editor__thumbnail-preview"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
            <p id="course-editor-thumbnail-preview-empty" class="course-editor__field-hint" hidden>
              No preview — enter a path above or clear to use the catalog placeholder.
            </p>
            <label class="course-editor__sidebar-label" for="course-editor-catalog-description">
              Catalog description
            </label>
            <p
              id="course-editor-catalog-description-source"
              class="course-editor__catalog-description-source"
              aria-live="polite"
            ></p>
            <textarea
              id="course-editor-catalog-description"
              class="course-editor__input course-editor__textarea course-editor__catalog-description"
              rows="3"
              placeholder="Uses catalog fallback when left unchanged"
              aria-label="Catalog description"
              aria-describedby="course-editor-catalog-description-source course-editor-catalog-description-hint"
              spellcheck="true"
            ></textarea>
            <p id="course-editor-catalog-description-hint" class="course-editor__field-hint">
              Shows the description used on
              <a href="/courses/" target="_blank" rel="noopener noreferrer">/courses</a>.
              Edit only to override; otherwise the catalog fallback applies automatically.
            </p>
            <button
              type="button"
              id="course-editor-catalog-description-clear"
              class="kbm-btn kbm-btn-outline course-editor__catalog-description-clear"
              disabled
            >
              Clear custom description
            </button>
            <button
              type="button"
              id="course-editor-settings-save"
              class="kbm-btn kbm-btn-outline course-editor__settings-save"
              disabled
            >
              Save course settings
            </button>
          </div>
        </details>
        <div class="course-editor__lessons-head">
          <span class="course-editor__sidebar-label">Lessons</span>
          <button type="button" id="course-editor-add-lesson" class="course-editor__add-lesson-btn">
            + Add Lesson
          </button>
        </div>
        <div id="course-editor-lessons" class="course-editor__lessons"></div>
      </aside>

      <main class="course-editor__center">
        <div class="course-editor__center-inner">
          <header class="course-editor__lesson-header">
            <span class="course-editor__hierarchy-label">Lesson</span>
            <div class="course-editor__lesson-toolbar">
              <div class="course-editor__lesson-title-wrap">
                <input
                  id="course-editor-lesson-title"
                  class="course-editor__input course-editor__lesson-title-input"
                  type="text"
                  placeholder="Untitled lesson"
                  aria-label="Lesson title"
                  autocomplete="off"
                  spellcheck="true"
                  disabled
                />
              </div>
              <button
                type="button"
                id="course-editor-delete-lesson"
                class="kbm-btn kbm-btn-outline course-editor__delete-lesson-btn"
                hidden
              >
                Delete lesson
              </button>
            </div>
          </header>

          <div class="course-editor__section-toolbar">
            <details class="course-editor__add-block-toolbar-menu" id="course-editor-add-block-menu">
              <summary class="course-editor__add-block-toolbar-btn">+ Add Block</summary>
              <p id="course-editor-add-block-target" class="course-editor__add-block-target-hint">
                Expand a section in the outline below, then pick a block type.
              </p>
              <div class="course-editor__add-block-types" id="course-editor-add-block-types"></div>
            </details>
            <details class="course-editor__add-section-menu" id="course-editor-add-section-menu">
              <summary class="course-editor__add-section-btn">+ New Section</summary>
              <p class="course-editor__add-section-hint">
                Adds a new heading to the lesson with one starting block. Use this for a new topic — not for adding more content under an existing heading.
              </p>
              <div class="course-editor__add-section-types" id="course-editor-add-section-types"></div>
            </details>
          </div>

          <p class="course-editor__outline-label">Lesson outline</p>
          <p id="course-editor-items-empty" class="course-editor__empty-lesson" hidden>
            This lesson has no sections yet. Add a section to start building the outline.
          </p>
          <div id="course-editor-items" class="course-editor__outline"></div>
        </div>
      </main>

      <aside class="course-editor__panel" id="course-editor-edit-panel">
        <div class="course-editor__panel-main">
          <div id="course-editor-edit-empty" class="course-editor__panel-empty">
            <p>Select a block from the lesson outline.</p>
          </div>
          <div id="course-editor-edit-form" hidden>
            <div id="course-editor-edit-head" class="course-editor__panel-head"></div>
            <div id="course-editor-edit-fields" class="course-editor__panel-body"></div>
          </div>
        </div>

        <details class="course-editor__snippets" id="course-editor-snippets">
          <summary class="course-editor__snippets-summary">Common HTML Snippets</summary>
          <p class="course-editor__snippets-hint">
            Copy common patterns while cleaning lesson HTML. Insert adds to the focused field above.
          </p>
          <div id="course-editor-snippets-list" class="course-editor__snippets-list"></div>
        </details>
      </aside>
    </div>

    <section id="course-editor-advanced" class="course-editor__advanced" aria-label="Raw lesson JSON">
      <div class="course-editor__advanced-grid">
        <div>
          <p class="course-editor__sidebar-label">Raw lesson JSON</p>
          <p style="font-size:0.82rem;color:#64748b;margin:0 0 0.5rem">
            Full lesson structure including blocks and legacy fields. Saves overwrite the selected lesson on disk
            (with backup).
          </p>
          <textarea
            id="course-editor-raw-lesson"
            class="course-editor__textarea"
            spellcheck="false"
            style="min-height:14rem"
            aria-label="Raw lesson JSON"
          ></textarea>
          <p id="course-editor-raw-error" class="course-editor__status-bar is-error" hidden></p>
        </div>
        <div class="course-editor__footer" style="border:none;padding:0">
          <button type="button" id="course-editor-advanced-save" class="kbm-btn kbm-btn-accent" disabled>
            Save lesson from JSON
          </button>
        </div>
      </div>
    </section>
  </div>

  <div id="course-editor-toast" class="course-editor__toast" aria-live="polite"></div>

  <GlossaryTermModal />

  <script>
    import { initCourseContentEditor } from "../../scripts/courseContentEditor.ts";
    initCourseContentEditor();
  </script>
</BaseLayout>
