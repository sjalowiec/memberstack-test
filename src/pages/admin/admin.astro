          {showPatternValidationDev && (
            <section
              id="kbm-pattern-validation-dev"
              style="margin-top: 2rem; padding: 1rem; border: 1px solid #ccc; max-width: 100%;"
            >
              <h2>Developer: Pattern validation</h2>
              <p style="margin: 0.5rem 0 1rem;">
                Runs <code>npm test</code> on this machine (dev server only). Not available in production builds.
              </p>
              <button type="button" id="kbm-run-pattern-validation">Run Pattern Validation</button>
              <div id="kbm-pattern-validation-status" style="margin-top: 0.75rem; font-weight: 700;"></div>
              <pre
                id="kbm-pattern-validation-output"
                style="margin-top: 0.5rem; padding: 0.75rem; background: #f5f5f5; overflow: auto; max-height: 50vh; white-space: pre-wrap; word-break: break-word; font-size: 12px;"
              ></pre>
              <script is:inline>
                (function () {
                  var btn = document.getElementById("kbm-run-pattern-validation");
                  var statusEl = document.getElementById("kbm-pattern-validation-status");
                  var outEl = document.getElementById("kbm-pattern-validation-output");
                  if (!btn || !statusEl || !outEl) return;
                  btn.addEventListener("click", function () {
                    statusEl.textContent = "Running...";
                    statusEl.style.color = "";
                    outEl.textContent = "";
                    btn.disabled = true;
                    fetch("/api/dev/run-pattern-validation", { method: "POST" })
                      .then(function (r) {
                        return r.json().then(function (data) {
                          return { r: r, data: data };
                        });
                      })
                      .then(function (_ref) {
                        var r = _ref.r;
                        var data = _ref.data;
                        if (r.status === 403) {
                          statusEl.textContent = "Failed";
                          statusEl.style.color = "#b91c1c";
                          outEl.textContent =
                            (data && data.stderr) ||
                            "This endpoint is disabled outside development.";
                          return;
                        }
                        var ok = !!(data && data.success);
                        statusEl.textContent = ok ? "Passed" : "Failed";
                        statusEl.style.color = ok ? "#15803d" : "#b91c1c";
                        var parts = [];
                        if (data.stdout) parts.push(data.stdout);
                        if (data.stderr) parts.push("--- stderr ---\n" + data.stderr);
                        if (typeof data.exitCode === "number")
                          parts.push("\n---\nexitCode: " + data.exitCode);
                        outEl.textContent = parts.length ? parts.join("\n") : "(no output)";
                      })
                      .catch(function (e) {
                        statusEl.textContent = "Failed";
                        statusEl.style.color = "#b91c1c";
                        outEl.textContent = String(e && e.message ? e.message : e);
                      })
                      .finally(function () {
                        btn.disabled = false;
                      });
                  });
                })();
              </script>
            </section>
          )}

</main>
  </main>

</Layout>