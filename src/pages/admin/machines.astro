---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HtmlHelperToolbar from "../../components/admin/HtmlHelperToolbar.astro";
import "../../styles/admin-machines.css";
---

<BaseLayout
  title="Machine Database | Knit it Now"
  description="Admin: add, edit, and review knitting machine records."
  bodyClass="admin-machines-body"
>
  <main class="am">
    <header class="am__head">
      <h1 class="am__title">Machine Database</h1>
      <p class="am__sub">
        Add or edit any machine or accessory in <code>data/machines.json</code>.
        Search the full catalog below, open a listed item from
        <strong>For Sale Machines</strong>, or use <strong>Add New Machine</strong>.
      </p>
    </header>

    <p id="am-status" class="am__status" role="status" aria-live="polite"></p>

    <div class="am__actionbar">
      <a href="/admin/machines/for-sale" class="am__btn am__btn--accent">
        For Sale Machines →
      </a>
      <button type="button" id="am-add" class="am__btn am__btn--outline">
        + Add New Machine
      </button>
    </div>

    <section
      class="am__panel am__form-panel"
      id="am-form-panel"
      aria-labelledby="am-form-heading"
      hidden
    >
      <div class="am__form-topbar">
        <h2 id="am-form-heading" class="am__panel-title">Edit machine</h2>
        <div class="am__form-topbar-actions">
          <span id="am-form-status-top" class="am__form-status" role="status" aria-live="polite"></span>
          <button type="button" id="am-save-top" class="am__btn am__btn--primary">Save</button>
          <button type="button" id="am-cancel-top" class="am__btn am__btn--outline">Cancel</button>
        </div>
      </div>
      <p id="am-mode" class="am__mode"></p>
      <p id="am-editing-id" class="am__editing-id" hidden></p>

      <form id="am-form" class="am__form" autocomplete="off">
        <fieldset class="am__sales">
          <legend class="am__sales-legend">Sales</legend>
          <p class="am__sales-intro">
            Records with <strong>For sale</strong> checked appear on the shop:
            <strong>Machine</strong> → <code>/shop/machines</code>,
            <strong>Accessory</strong> → <code>/shop/accessories</code>.
            Buy Now shows only when status is <em>Available</em> and a Stripe
            Payment Link is set. Paste the full Stripe link — do not use a
            truncated URL with <code>...</code>.
          </p>

          <div class="am__sales-grid">
            <label>
              <span>Shop Product Type <em class="req">*</em></span>
              <select name="productType" id="am-field-productType" required>
                <option value="machine">Machine</option>
                <option value="accessory">Accessory</option>
              </select>
            </label>

            <label class="am__check">
              <input type="checkbox" name="saleForSale" id="am-field-saleForSale" />
              <span>For sale (list on shop page)</span>
            </label>
            <label class="am__check">
              <input type="checkbox" name="saleFeatured" id="am-field-saleFeatured" />
              <span>Feature on /shop/machines</span>
            </label>

            <label>
              <span>Status</span>
              <select name="saleStatus" id="am-field-saleStatus">
                <option value="available">Available</option>
                <option value="sold-out">Sold Out</option>
                <option value="coming-soon">Coming Soon</option>
                <option value="inquiry-only">Inquiry Only</option>
              </select>
            </label>
            <label>
              <span>Price (USD)</span>
              <input
                type="number"
                name="salePrice"
                id="am-field-salePrice"
                step="0.01"
                min="0"
                placeholder="e.g. 999"
              />
            </label>

            <label>
              <span>Availability</span>
              <select name="saleAvailabilityStatus" id="am-field-saleAvailabilityStatus">
                <option value="available">Available</option>
                <option value="backorder">Backorder</option>
                <option value="unavailable">Unavailable</option>
              </select>
            </label>
            <label>
              <span>Expected date</span>
              <input type="date" name="saleExpectedDate" id="am-field-saleExpectedDate" />
              <span class="am__hint">
                Optional. Shown as e.g. “Expected September 1” when Availability
                is <em>Backorder</em>.
              </span>
            </label>

            <label class="am__full">
              <span>Stripe Payment Link</span>
              <input
                type="text"
                name="saleStripeLink"
                id="am-field-saleStripeLink"
                class="am__stripe-input"
                spellcheck="false"
                autocomplete="off"
                placeholder="https://buy.stripe.com/"
              />
            </label>

            <div
              id="am-checkout-summary"
              class="am__checkout-summary am__full"
              aria-live="polite"
            ></div>

            <label class="am__full">
              <span>Short Description (HTML)</span>
              <HtmlHelperToolbar target="am-field-saleShortDescriptionHtml" />
              <textarea
                name="saleShortDescriptionHtml"
                id="am-field-saleShortDescriptionHtml"
                rows="3"
              ></textarea>
              <span class="am__hint">
                HTML allowed. Shown on the shop cards/listings at
                <code>/shop/machines</code>. Basic formatting (paragraphs, links,
                lists, <strong>bold</strong>, <em>italics</em>) is preserved.
              </span>
            </label>

            <label class="am__full">
              <span>Long Description (HTML)</span>
              <HtmlHelperToolbar target="am-field-saleLongDescriptionHtml" />
              <textarea
                name="saleLongDescriptionHtml"
                id="am-field-saleLongDescriptionHtml"
                rows="8"
              ></textarea>
              <span class="am__hint">
                HTML allowed. Shown on the machine detail page at
                <code>/shop/machines/[slug]</code>. Falls back to the Short
                Description when empty.
              </span>
              <span class="am__hint am__hint--note">
                Glossary modal link:
                <code>&lt;a href="/glossary/TERM-SLUG" class="glossary-link"&gt;TERM NAME&lt;/a&gt;</code>
                Example (ID 352 Intarsia):
                <code>&lt;a href="/glossary/intarsia-picture-knitting" class="glossary-link"&gt;Intarsia&lt;/a&gt;</code>
              </span>
            </label>

            <label class="am__full">
              <span>Ordering Information</span>
              <HtmlHelperToolbar target="am-field-saleShippingNotes" />
              <textarea
                name="saleShippingNotes"
                id="am-field-saleShippingNotes"
                rows="8"
              ></textarea>
              <span class="am__hint">
                HTML allowed. Shown on the machine detail page. For new machines,
                a brand-based default is filled in automatically (Silver Reed,
                Titexma) until you edit it.
              </span>
            </label>
          </div>
        </fieldset>

        <div class="am__grid">
          <label>
            <span>machineId (immutable — do not confuse with similar models)</span>
            <input type="text" name="machineId" id="am-field-machineId" class="am__machine-id-field" readonly />
          </label>
          <label>
            <span>Brand <em class="req">*</em></span>
            <input type="text" name="brand" id="am-field-brand" />
          </label>
          <label>
            <span>Model <em class="req">*</em></span>
            <input type="text" name="model" id="am-field-model" />
          </label>
          <label>
            <span>Bed</span>
            <input type="text" name="bed" id="am-field-bed" placeholder="Metal / Plastic" />
          </label>
          <label>
            <span>Gauge</span>
            <input
              type="text"
              name="gauge"
              id="am-field-gauge"
              placeholder="4.5 / Standard Gauge / Bulky/Chunky"
            />
          </label>
          <label>
            <span>Needle count</span>
            <input type="number" name="needleCount" id="am-field-needleCount" step="1" />
          </label>
          <label>
            <span>Machine style</span>
            <input
              type="text"
              name="machineStyle"
              id="am-field-machineStyle"
              placeholder="Punchcard / Button / Electronic"
            />
          </label>
          <label>
            <span>Punchcard width</span>
            <input type="number" name="punchcardWidth" id="am-field-punchcardWidth" step="1" />
          </label>
          <label>
            <span>Year</span>
            <input type="number" name="year" id="am-field-year" step="1" />
          </label>

          <label class="am__full">
            <span>Images</span>
            <textarea
              name="images"
              id="am-field-images"
              rows="3"
              autocomplete="off"
              spellcheck="false"
              placeholder="sk840_1.jpg | main"
            ></textarea>
            <span class="am__hint">
              One image filename per line.<br />
              Store files in: <code>public/images/machines/</code><br />
              Example: <code>sk840_1.jpg | main</code>
            </span>
          </label>
        </div>

        <div class="am__form-actions">
          <button type="button" id="am-save" class="am__btn am__btn--primary">Save</button>
          <button type="button" id="am-cancel" class="am__btn am__btn--outline">Cancel</button>
          <span id="am-form-status" class="am__form-status" role="status" aria-live="polite"></span>
        </div>
      </form>

      <details class="am__adv">
        <summary class="am__adv-summary">Advanced / JSON</summary>
        <div class="am__preview-wrap">
          <h3 class="am__preview-title">Current record (preview)</h3>
          <pre id="am-preview" class="am__preview" aria-live="polite"></pre>
        </div>
      </details>
    </section>

    <details class="am__panel am__find" id="am-find" open>
      <summary class="am__find-summary">
        <span class="am__find-title">All products</span>
        <span id="am-count" class="am__count"></span>
      </summary>
      <div class="am__find-body">
        <div class="am__toolbar">
          <label class="am__search-label">
            <span class="sr-only">Filter by product type</span>
            <select id="am-type-filter" aria-label="Filter by product type">
              <option value="all">All types</option>
              <option value="machine">Machines</option>
              <option value="accessory">Accessories</option>
            </select>
          </label>
          <label class="am__search-label">
            <span class="sr-only">Search products</span>
            <input
              type="search"
              id="am-search"
              placeholder="Search brand, model, id, type…"
              autocomplete="off"
            />
          </label>
        </div>

        <div class="am__table-wrap">
          <table class="am__table">
            <thead>
              <tr>
                <th scope="col">Brand</th>
                <th scope="col">Model</th>
                <th scope="col">Type</th>
                <th scope="col">For sale</th>
                <th scope="col" class="am__num">ID</th>
                <th scope="col"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody id="am-rows"></tbody>
          </table>
        </div>
      </div>
    </details>
  </main>

  <script>
    import {
      asString,
      numberOrNull,
      stringOrNull,
      machineId as readMachineId,
      nextMachineId,
      brandModelKey,
      parseImages,
      serializeImages,
      normalizeImages,
      normalizeProductType,
      normalizeSale,
      defaultOrderingInfoHtml,
      buildSaleCheckoutSummary,
      formatEditingMachineIdLabel,
      getSaleAdminWarnings,
      validateStripePaymentLink,
      type MachineRecord,
      type ShopProductType,
    } from "../../lib/machines/machineAdminFields";
    import {
      API_BASE,
      machineCatalogRowHtml,
      matchesQuery,
      persistMachine,
      sortMachines,
    } from "../../lib/machines/adminListShared";
    import {
      assertMachineEditIdentity,
      parseEditQueryParam,
      selectMachineForEdit,
    } from "../../lib/machines/machineAdminSave";
    import { initHtmlHelperToolbars } from "../../lib/machines/htmlHelperToolbar";

    type EditorMode = "none" | "edit" | "new";

    let machines: MachineRecord[] = [];
    let mode: EditorMode = "none";
    /** machineId of the record loaded in the form (edit mode). */
    let editingId: number | null = null;
    /**
     * True once the Ordering Information field holds content we must not clobber
     * (a user edit, or an existing record's value). While false and creating a
     * new machine, the field tracks the brand's default template.
     */
    let orderingInfoDirty = false;
    /** Guards against duplicate full-form saves while a request is in flight. */
    let saving = false;

    const statusEl = document.getElementById("am-status");
    const formStatusEls = [
      document.getElementById("am-form-status"),
      document.getElementById("am-form-status-top"),
    ];
    const saveButtons = [
      document.getElementById("am-save"),
      document.getElementById("am-save-top"),
    ].filter((el): el is HTMLButtonElement => el instanceof HTMLButtonElement);
    const countEl = document.getElementById("am-count");
    const searchEl = document.getElementById("am-search") as HTMLInputElement | null;
    const typeFilterEl = document.getElementById("am-type-filter") as HTMLSelectElement | null;
    const rowsEl = document.getElementById("am-rows");
    const formPanel = document.getElementById("am-form-panel");
    const form = document.getElementById("am-form") as HTMLFormElement | null;
    const modeEl = document.getElementById("am-mode");
    const editingIdEl = document.getElementById("am-editing-id");
    const checkoutSummaryEl = document.getElementById("am-checkout-summary");
    const previewEl = document.getElementById("am-preview");
    const findEl = document.getElementById("am-find") as HTMLDetailsElement | null;

    function setFindOpen(open: boolean) {
      if (findEl) findEl.open = open;
    }

    function setStatus(message: string, kind: "ok" | "err" | "neutral" = "neutral") {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.toggle("is-error", kind === "err");
      statusEl.classList.toggle("is-ok", kind === "ok");
    }

    /** Page-level + form-adjacent save feedback (mirrors help-hub dual status). */
    function setFormSaveStatus(message: string, kind: "ok" | "err" | "neutral" = "neutral") {
      setStatus(message, kind);
      for (const el of formStatusEls) {
        if (!el) continue;
        el.textContent = message;
        el.classList.toggle("is-error", kind === "err");
        el.classList.toggle("is-ok", kind === "ok");
      }
    }

    function clearFormSaveStatus() {
      for (const el of formStatusEls) {
        if (!el) continue;
        el.textContent = "";
        el.classList.remove("is-error", "is-ok");
      }
    }

    function setSaveButtonsBusy(busy: boolean) {
      for (const btn of saveButtons) {
        btn.disabled = busy;
        btn.textContent = busy ? "Saving…" : "Save";
        btn.setAttribute("aria-busy", busy ? "true" : "false");
      }
    }

    function deepClone<T>(x: T): T {
      return JSON.parse(JSON.stringify(x)) as T;
    }

    function fieldEl(name: string): HTMLInputElement | HTMLTextAreaElement | null {
      const el = form?.elements?.namedItem(name);
      return el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement ? el : null;
    }

    function selectEl(name: string): HTMLSelectElement | null {
      const el = form?.elements?.namedItem(name);
      return el instanceof HTMLSelectElement ? el : null;
    }

    function textVal(name: string): string {
      return fieldEl(name)?.value ?? "";
    }

    function setField(name: string, value: string) {
      const el = fieldEl(name);
      if (el) el.value = value;
    }

    function checkVal(name: string): boolean {
      const el = fieldEl(name);
      return el instanceof HTMLInputElement && el.type === "checkbox" ? el.checked : false;
    }

    function setCheck(name: string, checked: boolean) {
      const el = fieldEl(name);
      if (el instanceof HTMLInputElement && el.type === "checkbox") el.checked = checked;
    }

    function selectVal(name: string): string {
      return selectEl(name)?.value ?? "";
    }

    function setSelect(name: string, value: string) {
      const el = selectEl(name);
      if (el) el.value = value;
    }

    /**
     * For a new machine whose Ordering Information hasn't been touched, keep the
     * field in sync with the selected brand's default template. Assigning
     * `.value` here does not fire an `input` event, so it never marks the field
     * dirty. Existing/edited content is left untouched.
     */
    function applyOrderingInfoDefault() {
      if (mode !== "new" || orderingInfoDirty) return;
      const template = defaultOrderingInfoHtml(textVal("brand"));
      if (template !== null) setField("saleShippingNotes", template);
      refreshPreview();
    }

    // ----- catalog list ------------------------------------------------------

    function renderTable() {
      if (!rowsEl || !countEl) return;
      const q = (searchEl?.value || "").trim().toLowerCase();
      const typeFilter = (typeFilterEl?.value || "all") as "all" | ShopProductType;
      const filtered = sortMachines(
        machines.filter((m) => {
          if (typeFilter !== "all" && normalizeProductType(m.productType) !== typeFilter) {
            return false;
          }
          return matchesQuery(m, q);
        })
      );

      countEl.textContent = `${filtered.length} of ${machines.length} product(s)`;
      rowsEl.innerHTML = filtered
        .map((m) => {
          const id = readMachineId(m);
          return machineCatalogRowHtml(m, {
            activeId: editingId,
            actionHtml: `<button type="button" class="am__btn am__btn--small" data-edit="${id ?? ""}">Edit</button>`,
          });
        })
        .join("");
    }

    // ----- form <-> record ---------------------------------------------------

    function findById(id: number | null): MachineRecord | undefined {
      if (id === null) return undefined;
      return selectMachineForEdit(machines, id);
    }

    /** Keep `?edit=<machineId>` in sync with the loaded record so refresh cannot reopen the wrong product. */
    function syncEditUrl(id: number | null) {
      const url = new URL(window.location.href);
      if (id === null) url.searchParams.delete("edit");
      else url.searchParams.set("edit", String(id));
      const next = url.pathname + url.search + url.hash;
      if (next !== window.location.pathname + window.location.search + window.location.hash) {
        history.replaceState({}, "", next);
      }
    }

    function loadToForm(id: number, opts?: { scroll?: boolean; keepSaveStatus?: boolean }) {
      const m = findById(id);
      if (!m || !form || !formPanel) return;
      mode = "edit";
      editingId = id;
      // Existing records keep their stored Ordering Information; never auto-fill.
      orderingInfoDirty = true;
      if (!opts?.keepSaveStatus) clearFormSaveStatus();
      formPanel.hidden = false;
      // Clear every control first so fields from the previously opened product cannot linger.
      form.reset();

      setField("machineId", asString(m.machineId));
      setField("brand", asString(m.brand));
      setField("model", asString(m.model));
      setSelect("productType", normalizeProductType(m.productType));
      setField("bed", asString(m.bed));
      setField("gauge", asString(m.gauge));
      setField("needleCount", asString(m.needleCount));
      setField("machineStyle", asString(m.machineStyle));
      setField("punchcardWidth", asString(m.punchcardWidth));
      setField("year", asString(m.year));
      setField("images", serializeImages(m.images));

      const sale = normalizeSale(m.sale);
      setCheck("saleForSale", sale?.forSale ?? false);
      setCheck("saleFeatured", sale?.featured ?? false);
      setSelect("saleStatus", sale?.status ?? "available");
      setField("salePrice", sale?.price != null ? String(sale.price) : "");
      setSelect("saleAvailabilityStatus", sale?.availabilityStatus ?? "available");
      setField("saleExpectedDate", sale?.expectedDate ?? "");
      setField("saleStripeLink", sale?.stripePaymentLink ?? "");
      setField("saleShortDescriptionHtml", sale?.shortDescriptionHtml ?? "");
      setField("saleLongDescriptionHtml", sale?.longDescriptionHtml ?? "");
      setField("saleShippingNotes", sale?.shippingNotes ?? "");

      syncEditUrl(id);

      if (modeEl) {
        modeEl.textContent = `Editing: ${asString(m.brand)} ${asString(m.model)} (machineId ${id})`;
        modeEl.classList.remove("is-new");
      }
      renderTable();
      refreshPreview();
      setFindOpen(false);
      if (opts?.scroll !== false) {
        formPanel.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    function startNew() {
      if (!form || !formPanel) return;
      mode = "new";
      editingId = null;
      // Fresh record: Ordering Information tracks the brand default until edited.
      orderingInfoDirty = false;
      clearFormSaveStatus();
      formPanel.hidden = false;
      form.reset();
      syncEditUrl(null);

      const newId = nextMachineId(machines);
      setField("machineId", String(newId));
      setSelect("productType", "machine");
      if (modeEl) {
        modeEl.textContent = `Creating new machine (machineId ${newId}) — fill in brand and model, then Save.`;
        modeEl.classList.add("is-new");
      }
      renderTable();
      refreshPreview();
      setFindOpen(false);
      formPanel.scrollIntoView({ behavior: "smooth", block: "start" });
      fieldEl("brand")?.focus();
    }

    function buildFromForm(): MachineRecord | null {
      if (mode === "none") return null;

      // Preserve unknown fields on existing records; start fresh for new ones.
      let row: MachineRecord = {};
      if (mode === "edit") {
        const original = findById(editingId);
        if (!original) return null;
        row = deepClone(original);
      }

      row.machineId = numberOrNull(textVal("machineId"));
      row.brand = textVal("brand").trim();
      row.model = textVal("model").trim();
      row.productType = normalizeProductType(selectVal("productType"));
      row.bed = stringOrNull(textVal("bed"));
      row.gauge = stringOrNull(textVal("gauge"));
      row.needleCount = numberOrNull(textVal("needleCount"));
      row.machineStyle = stringOrNull(textVal("machineStyle"));
      row.punchcardWidth = numberOrNull(textVal("punchcardWidth"));
      row.year = numberOrNull(textVal("year"));
      row.images = normalizeImages(parseImages(textVal("images")));

      const sale = normalizeSale({
        forSale: checkVal("saleForSale"),
        featured: checkVal("saleFeatured"),
        status: selectVal("saleStatus"),
        availabilityStatus: selectVal("saleAvailabilityStatus"),
        expectedDate: textVal("saleExpectedDate"),
        price: textVal("salePrice"),
        stripePaymentLink: textVal("saleStripeLink"),
        shortDescriptionHtml: textVal("saleShortDescriptionHtml"),
        longDescriptionHtml: textVal("saleLongDescriptionHtml"),
        shippingNotes: textVal("saleShippingNotes"),
      });
      if (sale === null) delete row.sale;
      else row.sale = sale;

      return row;
    }

    function refreshEditingIdBanner() {
      if (!editingIdEl) return;
      if (mode !== "edit" && mode !== "new") {
        editingIdEl.hidden = true;
        editingIdEl.textContent = "";
        return;
      }
      const id = numberOrNull(textVal("machineId"));
      const label = formatEditingMachineIdLabel(id, mode);
      editingIdEl.textContent = label;
      editingIdEl.hidden = !label;
    }

    function refreshCheckoutSummary() {
      if (!checkoutSummaryEl) return;
      if (mode !== "edit" && mode !== "new") {
        checkoutSummaryEl.innerHTML = "";
        return;
      }

      const summary = buildSaleCheckoutSummary({
        machineId: numberOrNull(textVal("machineId")),
        brand: textVal("brand"),
        model: textVal("model"),
        productType: selectVal("productType"),
        status: selectVal("saleStatus"),
        availabilityStatus: selectVal("saleAvailabilityStatus"),
        expectedDate: textVal("saleExpectedDate"),
        stripePaymentLink: textVal("saleStripeLink"),
      });

      const activeClass = summary.checkoutActive
        ? "am__checkout-summary__active is-yes"
        : "am__checkout-summary__active is-no";

      checkoutSummaryEl.innerHTML = `
        <h3 class="am__checkout-summary__title">Checkout status (live)</h3>
        <dl class="am__checkout-summary__list">
          <div><dt>Product ID</dt><dd data-summary="productId"></dd></div>
          <div><dt>Product name</dt><dd data-summary="productName"></dd></div>
          <div><dt>Product type</dt><dd data-summary="productType"></dd></div>
          <div><dt>Status</dt><dd data-summary="status"></dd></div>
          <div><dt>Availability</dt><dd data-summary="availability"></dd></div>
          <div class="am__checkout-summary__link-row">
            <dt>Stripe Payment Link</dt>
            <dd data-summary="stripePaymentLink" class="am__checkout-summary__link"></dd>
          </div>
          <div class="am__checkout-summary__checkout-row">
            <dt>Checkout</dt>
            <dd data-summary="checkoutActiveLine" class="${activeClass}"></dd>
          </div>
        </dl>
      `;

      const setSummaryText = (key: string, value: string) => {
        const el = checkoutSummaryEl.querySelector(`[data-summary="${key}"]`);
        if (el) el.textContent = value;
      };
      setSummaryText("productId", summary.productId);
      setSummaryText("productName", summary.productName);
      setSummaryText("productType", summary.productType);
      setSummaryText("status", summary.status);
      setSummaryText("availability", summary.availability);
      // Full stored value — never truncated or replaced with a placeholder.
      setSummaryText("stripePaymentLink", summary.stripePaymentLink);
      setSummaryText("checkoutActiveLine", summary.checkoutActiveLine);
    }

    function refreshPreview() {
      if (!previewEl) return;
      const row = buildFromForm();
      previewEl.textContent = row
        ? JSON.stringify(row, null, 2)
        : "// Search All products below, or add a new one, to see its JSON.";
      refreshEditingIdBanner();
      refreshCheckoutSummary();
    }

    async function save() {
      if (saving) return;
      if (mode !== "edit" && mode !== "new") return;

      const row = buildFromForm();
      if (!row) return;

      const id = readMachineId(row);
      if (!asString(row.brand).trim()) return setFormSaveStatus("Brand is required.", "err");
      if (!asString(row.model).trim()) return setFormSaveStatus("Model is required.", "err");
      if (id === null) return setFormSaveStatus("Could not determine machineId.", "err");

      const stripeCheck = validateStripePaymentLink(textVal("saleStripeLink"));
      if (!stripeCheck.ok) return setFormSaveStatus(stripeCheck.error, "err");

      // Route id, loaded id, and submitted id must all agree before any write.
      const routeMachineId = parseEditQueryParam(window.location.search);
      const identity = assertMachineEditIdentity({
        mode,
        editingId,
        submittedId: id,
        routeMachineId,
      });
      if (!identity.ok) return setFormSaveStatus(identity.error, "err");

      // Prevent creating NEW duplicate brand + model combinations.
      const key = brandModelKey(row);
      const clash = machines.find((m) => readMachineId(m) !== id && brandModelKey(m) === key);
      if (clash) {
        setFormSaveStatus(
          `A machine with brand "${asString(row.brand)}" and model "${asString(row.model)}" already exists (machineId ${readMachineId(clash)}).`,
          "err"
        );
        return;
      }

      if (mode === "new" && machines.some((m) => readMachineId(m) === id)) {
        return setFormSaveStatus(`machineId ${id} already exists. Reload and try again.`, "err");
      }
      if (mode === "edit" && !findById(editingId)) {
        return setFormSaveStatus("Original machine not found; reload the page.", "err");
      }

      const warnings = getSaleAdminWarnings({
        forSale: checkVal("saleForSale"),
        productType: selectVal("productType"),
        featured: checkVal("saleFeatured"),
        stripePaymentLink: textVal("saleStripeLink"),
        status: selectVal("saleStatus"),
      });
      if (warnings.length > 0) {
        const proceed = window.confirm(
          `Please confirm before saving:\n\n• ${warnings.join("\n• ")}\n\nSave anyway?`
        );
        if (!proceed) {
          setFormSaveStatus("Save cancelled — review the Sales fields above.", "err");
          return;
        }
      }

      saving = true;
      setSaveButtonsBusy(true);
      setFormSaveStatus("Saving…", "neutral");
      try {
        // Single-record upsert by exact machineId (server rejects identity mismatches).
        machines = await persistMachine({
          machine: row,
          expectedMachineId: id,
          mode,
          routeMachineId,
        });
        setFormSaveStatus("Machine saved successfully.", "ok");
        // Stay on the form; do not scroll away from the nearby success message.
        loadToForm(id, { scroll: false, keepSaveStatus: true });
      } catch (err) {
        const detail = err instanceof Error ? err.message.trim() : "";
        const base = "The machine could not be saved. Please try again.";
        setFormSaveStatus(detail ? `${base} ${detail}` : base, "err");
      } finally {
        saving = false;
        setSaveButtonsBusy(false);
      }
    }

    function cancel() {
      mode = "none";
      editingId = null;
      clearFormSaveStatus();
      if (form) form.reset();
      if (formPanel) formPanel.hidden = true;
      if (editingIdEl) {
        editingIdEl.hidden = true;
        editingIdEl.textContent = "";
      }
      if (checkoutSummaryEl) checkoutSummaryEl.innerHTML = "";
      syncEditUrl(null);
      renderTable();
      setFindOpen(true);
    }

    async function init() {
      setStatus("Loading machines…");
      try {
        const res = await fetch(API_BASE);
        const data = await res.json();
        if (!res.ok || !data?.ok || !Array.isArray(data.machines)) {
          setStatus(data?.error || `Load failed (${res.status})`, "err");
          return;
        }
        machines = data.machines as MachineRecord[];
        setStatus(`${machines.length} product(s) loaded.`, "ok");
        renderTable();
        openFromUrl();
      } catch {
        setStatus("Network error loading machines.", "err");
        return;
      }

      searchEl?.addEventListener("input", renderTable);
      typeFilterEl?.addEventListener("change", renderTable);
      document.getElementById("am-add")?.addEventListener("click", startNew);
      document.getElementById("am-save")?.addEventListener("click", () => void save());
      document.getElementById("am-cancel")?.addEventListener("click", cancel);
      document.getElementById("am-save-top")?.addEventListener("click", () => void save());
      document.getElementById("am-cancel-top")?.addEventListener("click", cancel);

      rowsEl?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const btn = target.closest("[data-edit]");
        if (!(btn instanceof HTMLElement)) return;
        const id = Number.parseInt(btn.getAttribute("data-edit") || "", 10);
        if (Number.isFinite(id)) loadToForm(id);
      });

      const onFormEdited = () => {
        // Drop stale success feedback once the user edits again.
        if (formStatusEls.some((el) => el?.classList.contains("is-ok"))) {
          clearFormSaveStatus();
          if (statusEl?.classList.contains("is-ok")) {
            statusEl.textContent = "";
            statusEl.classList.remove("is-ok");
          }
        }
        refreshPreview();
      };
      form?.addEventListener("input", onFormEdited);
      form?.addEventListener("change", onFormEdited);

      // Auto-fill Ordering Information from the brand default on new machines,
      // and stop as soon as the user edits the field themselves.
      fieldEl("brand")?.addEventListener("input", applyOrderingInfoDefault);
      fieldEl("saleShippingNotes")?.addEventListener("input", () => {
        orderingInfoDirty = true;
      });

      initHtmlHelperToolbars();
    }

    /** Open a machine's form directly when linked as `?edit=<machineId>`. */
    function openFromUrl() {
      const id = parseEditQueryParam(window.location.search);
      if (id !== null && findById(id)) loadToForm(id);
    }

    void init();
  </script>

</BaseLayout>
