---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Edit Video | Knit it Now"
  description="Create or edit a catalog video (videos-public.json)"
  bodyClass="videos-admin-body help-hub-admin-body"
>
  <main class="help-hub-admin">
    <header class="help-hub-admin__head">
      <h1 class="help-hub-admin__title">Video Editor</h1>
      <p class="help-hub-admin__sub">
        <a href="/admin/videos-admin">Back to videos list</a>
        ·
        <a href="/admin/lessons-admin">Lessons admin</a> uses <code>videoSlug</code> matching the <strong>Key</strong> (slug, or <code>content_id</code> if slug is empty).
      </p>
    </header>

    <p id="videos-edit-save-target" class="videos-edit-save-target" hidden></p>
    <p id="videos-edit-status" class="help-hub-admin__status" aria-live="polite"></p>

    <section id="videos-edit-result" class="videos-edit-result" hidden aria-live="polite" aria-labelledby="videos-edit-result-title">
      <h2 id="videos-edit-result-title" class="videos-edit-result__title">Save result</h2>
      <ol id="videos-edit-steps" class="videos-edit-steps"></ol>
      <p class="videos-edit-result__actions">
        <button type="button" id="btn-check-live" class="kbm-btn kbm-btn-outline" hidden>Check live</button>
        <a id="videos-edit-result-preview" class="kbm-btn kbm-btn-outline" href="#" hidden target="_blank" rel="noopener">Open preview</a>
        <a id="videos-edit-result-public" class="kbm-btn kbm-btn-outline" href="#" hidden target="_blank" rel="noopener">Open video page</a>
      </p>
    </section>

    <section class="admin-panel help-hub-admin__form-panel" aria-labelledby="form-heading">
      <h2 id="form-heading">Edit video</h2>
      <p id="videos-edit-mode" class="help-hub-admin__mode">Loading…</p>
      <p id="videos-edit-state" class="videos-edit-state" hidden></p>

      <form id="videos-edit-form" class="help-hub-admin__form" autocomplete="off">
        <div class="field-grid">
          <label>
            <span>Video number</span>
            <input type="text" name="content_id" id="field-content_id" readonly aria-readonly="true" />
            <span id="field-content_id-hint" class="field-hint">Assigned automatically. Video numbers never change.</span>
          </label>
          <label class="field-full">
            <span>title <em class="req">*</em></span>
            <input type="text" name="title" id="field-title" required />
          </label>
          <div class="field-full slug-field">
            <label for="field-slug">
              <span>slug <em class="req">*</em></span>
              <input type="text" name="slug" id="field-slug" required spellcheck="false" />
            </label>
            <button type="button" id="btn-slug-from-title" class="kbm-btn kbm-btn-outline">Make from title</button>
            <span id="field-slug-hint" class="field-hint">Lowercase words joined by hyphens. Filled in from the title until you edit it.</span>
          </div>
          <label class="field-full">
            <span>description</span>
            <textarea name="description" id="field-description" rows="4"></textarea>
          </label>
          <label>
            <span>Access</span>
            <select name="access_level" id="field-access_level">
              <option value="member">Members only</option>
              <option value="public">Free for everyone</option>
            </select>
          </label>
          <div class="field-full poster-field">
            <label for="field-posterUrl">
              <span>posterUrl</span>
              <input type="text" name="posterUrl" id="field-posterUrl" />
            </label>
            <button type="button" id="btn-refresh-vimeo-thumbnail" class="kbm-btn kbm-btn-outline">
              Refresh thumbnail from Vimeo
            </button>
            <span class="field-hint">
              Uses this form's Vimeo ID. Save afterward so the library, video page, and Tip of the Week share the new picture.
            </span>
            <img id="poster-preview" class="poster-preview" alt="" hidden />
          </div>
          <label>
            <span>category</span>
            <input type="text" name="category" id="field-category" />
          </label>
          <label>
            <span>subcategory</span>
            <input type="text" name="subcategory" id="field-subcategory" />
          </label>
          <div class="vimeo-id-field">
            <label for="field-vimeo_id">
              <span>vimeo_id <em class="req">*</em></span>
              <input type="number" name="vimeo_id" id="field-vimeo_id" required min="1" step="1" />
            </label>
            <button type="button" id="btn-copy-vimeo" class="kbm-btn kbm-btn-outline">Copy Vimeo ID</button>
          </div>
          <label class="checkbox-label field-full tip-current-wrap">
            <input type="checkbox" name="tipOfWeek" id="field-tipOfWeek" />
            <span>Current Tip of the Week</span>
          </label>
          <label class="field-full">
            <span>Tip of the Week Headline</span>
            <input type="text" name="tipHeadline" id="field-tipHeadline" />
          </label>
          <label class="field-full">
            <span>Tip of the Week Note</span>
            <textarea name="tipNote" id="field-tipNote" rows="3"></textarea>
          </label>
          <label>
            <span>videoType</span>
            <select name="videoType" id="field-videoType">
              <option value="">(not set)</option>
              <option value="full">full</option>
              <option value="clip">clip</option>
            </select>
          </label>
          <label>
            <span>sourceVideoId</span>
            <input type="text" name="sourceVideoId" id="field-sourceVideoId" placeholder="Parent content_id for clips" />
          </label>
          <label class="field-full">
            <span>clips (one content_id per line)</span>
            <textarea name="clips" id="field-clips" rows="3" placeholder="249-1&#10;249-2"></textarea>
          </label>
          <div class="field-full vtt-field">
            <label for="field-vtt">
              <span>English transcript (VTT file)</span>
              <input type="file" id="field-vtt" accept=".vtt,text/vtt" />
            </label>
            <p id="vtt-current" class="field-hint">No transcript uploaded yet.</p>
            <p id="vtt-selected" class="vtt-selected" hidden></p>
            <button type="button" id="btn-clear-vtt" class="kbm-btn kbm-btn-outline" hidden>Don't upload this file</button>
            <span class="field-hint">
              Uploading replaces the current transcript when you save. Draft transcripts appear on the video page once the video is published.
              Member videos keep their transcript for members only.
            </span>
          </div>
          <label class="checkbox-label field-full">
            <input type="checkbox" name="search_ready" id="field-search_ready" />
            <span>search_ready (future indexing)</span>
          </label>
        </div>

        <section class="field-full tip-history-panel" aria-labelledby="tip-history-heading">
          <div class="tip-history-head">
            <h3 id="tip-history-heading">Tip of the Week History</h3>
            <p id="tip-history-summary" class="tip-history-summary">Used 0 times</p>
          </div>
          <p id="tip-history-badge" class="tip-history-badge" hidden>Used as Tip of the Week before</p>
          <p id="tip-current-badge" class="tip-current-badge" hidden>Currently featured as Tip of the Week</p>
          <p id="tip-multi-warning" class="tip-multi-warning" hidden></p>
          <div id="tip-history-list" class="tip-history-list"></div>
          <button type="button" id="btn-add-tip-history" class="kbm-btn kbm-btn-outline">Add history entry</button>
        </section>

        <div class="help-hub-admin__form-actions help-hub-admin__form-actions--sticky">
          <button type="button" id="btn-save-draft" class="kbm-btn kbm-btn-outline" data-save-status="draft">Save draft</button>
          <button type="button" id="btn-publish" class="kbm-btn kbm-btn-primary" data-save-status="published">Publish</button>
          <button type="button" id="btn-save-published" class="kbm-btn kbm-btn-primary" data-save-status="published" hidden>Save changes</button>
          <button type="button" id="btn-unpublish" class="kbm-btn kbm-btn-outline" data-save-status="draft" hidden>Move to draft</button>
          <button type="button" id="btn-archive" class="kbm-btn kbm-btn-accent" data-save-status="archived" hidden>Archive</button>
          <a id="btn-preview-video" class="kbm-btn kbm-btn-outline" href="#" target="_blank" rel="noopener" hidden>Preview</a>
          <button type="button" id="btn-cancel-video" class="kbm-btn kbm-btn-outline">Back to list</button>
          <button type="button" id="btn-refresh-video-json-preview" class="kbm-btn kbm-btn-outline">Refresh JSON preview</button>
        </div>
      </form>

      <div class="help-hub-admin__preview-wrap">
        <h3 class="help-hub-admin__preview-title">Current record (preview)</h3>
        <pre id="videos-json-preview" class="help-hub-admin__preview" aria-live="polite"></pre>
      </div>
    </section>
  </main>

  <style>
    :global(body.help-hub-admin-body) {
      margin: 0;
    }
    .help-hub-admin {
      width: 100%;
      max-width: 960px;
      margin: 0 auto;
      padding: 1rem 1.25rem 2rem;
      box-sizing: border-box;
    }
    .help-hub-admin__head {
      margin-bottom: 0.75rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid #e2e8f0;
    }
    .help-hub-admin__title {
      margin: 0 0 0.35rem 0;
      font-size: 1.65rem;
      color: #243015;
    }
    .help-hub-admin__sub {
      margin: 0;
      font-size: 0.95rem;
      color: #475569;
    }
    .help-hub-admin__sub code {
      font-size: 0.88em;
      background: #f1f5f9;
      padding: 0.12rem 0.35rem;
      border-radius: 4px;
    }
    .help-hub-admin__status {
      min-height: 1.4em;
      margin: 0 0 0.75rem 0;
      font-size: 0.95rem;
      color: #374151;
    }
    .help-hub-admin__status.is-error {
      color: #b91c1c;
      font-weight: 600;
    }
    .help-hub-admin__status.is-ok {
      color: #166534;
    }
    .admin-panel {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 0.85rem;
    }
    .help-hub-admin__mode {
      margin: 0 0 0.75rem 0;
      padding: 0.5rem 0.65rem;
      border-radius: 8px;
      background: #f1f5f9;
      border: 1px solid #e2e8f0;
      font-weight: 600;
      color: #243015;
      font-size: 0.95rem;
    }
    .help-hub-admin__form .field-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }
    @media (min-width: 720px) {
      .help-hub-admin__form .field-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
    .field-full {
      grid-column: 1 / -1;
    }
    .vimeo-id-field {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.45rem;
    }
    .vimeo-id-field label {
      width: 100%;
    }
    .slug-field,
    .vtt-field {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.45rem;
    }
    .slug-field label,
    .vtt-field label {
      width: 100%;
    }
    .slug-field .field-hint.is-warning {
      color: #92400e;
      font-weight: 600;
    }
    .vtt-selected {
      margin: 0;
      font-weight: 600;
      color: #3f6212;
    }
    .vtt-selected.is-error {
      color: #b91c1c;
    }
    input[readonly] {
      background: #f1f5f9;
      color: #334155;
    }
    .videos-edit-save-target {
      margin: 0 0 0.75rem;
      padding: 0.6rem 0.85rem;
      border-radius: 8px;
      background: #f6f9f1;
      border: 1px solid #d6e0c8;
      color: #243015;
      font-size: 0.95rem;
    }
    .videos-edit-save-target.is-warning {
      background: #fef2f2;
      border-color: #fca5a5;
      color: #7f1d1d;
    }
    .videos-edit-state {
      margin: -0.25rem 0 0.75rem;
      font-weight: 700;
      color: #243015;
    }
    .videos-edit-result {
      margin: 0 0 1rem;
      padding: 1rem 1.1rem;
      background: #fff;
      border: 2px solid #5d7340;
      border-radius: 12px;
    }
    .videos-edit-result.is-error {
      border-color: #b91c1c;
    }
    .videos-edit-result__title {
      margin: 0 0 0.5rem;
      font-size: 1.15rem;
      color: #243015;
    }
    .videos-edit-steps {
      margin: 0;
      padding-left: 1.4rem;
      display: grid;
      gap: 0.35rem;
    }
    .videos-edit-steps li.is-done::marker {
      color: #3f6212;
    }
    .videos-edit-steps li.is-error {
      color: #b91c1c;
      font-weight: 600;
    }
    .videos-edit-steps li.is-waiting {
      color: #92400e;
    }
    .videos-edit-steps code {
      font-size: 0.9em;
      background: #f1f5f9;
      padding: 0.05rem 0.3rem;
      border-radius: 4px;
    }
    .videos-edit-result__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0.75rem 0 0;
    }
    .help-hub-admin__form label {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .checkbox-label {
      flex-direction: row !important;
      align-items: center;
      gap: 0.5rem !important;
    }
    .checkbox-label input {
      width: auto !important;
    }
    .help-hub-admin__form label > span:first-of-type {
      font-size: 0.95rem;
      font-weight: 600;
      color: #2e3a18;
    }
    .req {
      color: #b91c1c;
      font-style: normal;
    }
    .field-hint {
      font-size: 0.82rem;
      font-weight: 400;
      color: #64748b;
      line-height: 1.45;
    }
    .poster-field {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .poster-field label {
      width: 100%;
    }
    .poster-preview {
      display: block;
      width: min(100%, 320px);
      height: auto;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      background: #f8fafc;
    }
    .help-hub-admin__form input,
    .help-hub-admin__form select,
    .help-hub-admin__form textarea {
      width: 100%;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 0.55rem 0.65rem;
      font: inherit;
      color: #111827;
      background: #fff;
      box-sizing: border-box;
    }
    .help-hub-admin__form textarea {
      resize: vertical;
      min-height: 72px;
    }
    .help-hub-admin__form-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1.1rem;
    }
    .help-hub-admin__form-actions--sticky {
      position: sticky;
      bottom: 0;
      z-index: 8;
      padding: 0.6rem 0;
      margin-top: 1rem;
      background: linear-gradient(to top, #fff 78%, rgba(255, 255, 255, 0));
      border-top: 1px solid #e5e7eb;
    }
    .help-hub-admin__preview-wrap {
      margin-top: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid #e5e7eb;
    }
    .help-hub-admin__preview-title {
      margin: 0 0 0.5rem 0;
      font-size: 1rem;
      color: #243015;
    }
    .help-hub-admin__preview {
      margin: 0;
      padding: 0.85rem;
      border-radius: 8px;
      background: #0f172a;
      color: #e2e8f0;
      overflow: auto;
      font-size: 0.78rem;
      line-height: 1.45;
      max-height: 360px;
    }
    .tip-current-wrap {
      padding: 0.55rem 0.7rem;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      background: #f8fafc;
    }
    .tip-current-wrap.is-current-tip {
      border-color: #15803d;
      background: #dcfce7;
    }
    .tip-history-panel {
      margin-top: 0.9rem;
      padding: 0.8rem;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      background: #f8fafc;
    }
    .tip-history-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }
    .tip-history-head h3 {
      margin: 0;
      color: #243015;
      font-size: 1rem;
    }
    .tip-history-summary {
      margin: 0;
      font-size: 0.9rem;
      font-weight: 600;
      color: #334155;
    }
    .tip-history-badge,
    .tip-current-badge,
    .tip-multi-warning {
      margin: 0 0 0.5rem 0;
      font-size: 0.9rem;
      border-radius: 8px;
      padding: 0.38rem 0.52rem;
    }
    .tip-history-badge {
      background: #e2e8f0;
      color: #1e293b;
    }
    .tip-current-badge {
      background: #dcfce7;
      color: #166534;
      border: 1px solid #86efac;
    }
    .tip-multi-warning {
      background: #fef2f2;
      color: #991b1b;
      border: 1px solid #fecaca;
      font-weight: 600;
    }
    .tip-history-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin: 0.75rem 0;
    }
    .tip-history-item {
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 0.7rem;
      background: #fff;
    }
    .tip-history-item-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.5rem;
    }
    .tip-history-item-head strong {
      color: #334155;
      font-size: 0.9rem;
    }
    .tip-history-item .field-grid {
      margin-bottom: 0.5rem;
    }
    .tip-history-empty {
      margin: 0;
      font-size: 0.9rem;
      color: #64748b;
    }
  </style>

  <script>
    import { fetchAdminJson, promptAdminSignIn } from "../../lib/admin/adminAuthClient";

    import { slugFromTitle, uniqueVideoSlug } from "../../lib/videos/videoSlug";

    const API_BASE = "/api/admin/videos";
    const SAVE_API = "/api/admin/videos/save";
    const STATUS_API = "/api/admin/videos/status";
    type VideoRow = Record<string, unknown>;
    type TipHistoryEntry = { date: string; headline?: string; note?: string };
    type SaveStatus = "draft" | "published" | "archived";
    type TranscriptState = "published" | "draft" | "none";
    type SaveInfo = { canSave: boolean; mode?: string; branch?: string; warning?: string };

    let videos: VideoRow[] = [];
    let transcripts: Record<string, TranscriptState> = {};
    let saveInfo: SaveInfo = { canSave: false };
    let nextContentId = 0;
    let baseline: VideoRow | null = null;
    /** Stable key (slug or content_id) when editing; null when creating */
    let editingKey: string | null = null;
    /** True once the slug was typed by hand, so title edits stop replacing it. */
    let slugTouched = false;
    let pendingVtt: { filename: string; text: string } | null = null;
    let saving = false;
    let liveTimer: number | null = null;

    const params = new URLSearchParams(window.location.search);
    const keyParam = params.get("key")?.trim() ?? "";

    const statusEl = document.getElementById("videos-edit-status");
    const modeEl = document.getElementById("videos-edit-mode");
    const form = document.getElementById("videos-edit-form") as HTMLFormElement | null;
    const jsonPreviewEl = document.getElementById("videos-json-preview");
    const tipHistoryListEl = document.getElementById("tip-history-list");
    const tipHistorySummaryEl = document.getElementById("tip-history-summary");
    const tipHistoryBadgeEl = document.getElementById("tip-history-badge");
    const tipCurrentBadgeEl = document.getElementById("tip-current-badge");
    const tipMultiWarningEl = document.getElementById("tip-multi-warning");
    const tipCurrentWrapEl = form?.querySelector(".tip-current-wrap");

    let tipHistoryDraft: TipHistoryEntry[] = [];

    function stableVideoKey(v: VideoRow): string {
      const s = typeof v.slug === "string" ? v.slug.trim() : "";
      if (s) return s;
      return String(v.content_id ?? "");
    }

    function setStatus(message: string, kind: "ok" | "err" | "neutral" = "neutral") {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.toggle("is-error", kind === "err");
      statusEl.classList.toggle("is-ok", kind === "ok");
    }

    function deepClone<T>(x: T): T {
      return JSON.parse(JSON.stringify(x)) as T;
    }

    function textVal(name: string) {
      const el = form?.elements?.namedItem(name);
      return el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement
        ? el.value.trim()
        : "";
    }

    function setField(name: string, value: string) {
      const el = form?.elements?.namedItem(name);
      if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) {
        el.value = value;
      }
    }

    function setCheckbox(name: string, checked: boolean) {
      const el = form?.elements?.namedItem(name);
      if (el instanceof HTMLInputElement && el.type === "checkbox") el.checked = checked;
    }

    function linesFromTextarea(name: string): string[] {
      const el = form?.elements?.namedItem(name);
      if (!(el instanceof HTMLTextAreaElement)) return [];
      return el.value
        .split(/\r?\n/)
        .map((l) => l.trim())
        .filter((l) => l.length > 0);
    }

    function linesToText(lines: unknown): string {
      return Array.isArray(lines) ? lines.map((x) => String(x)).join("\n") : "";
    }

    function parseContentIdField(raw: string): string | number {
      const t = raw.trim();
      if (!t) return "";
      if (/^-?\d+$/.test(t)) {
        const n = parseInt(t, 10);
        if (Number.isFinite(n)) return n;
      }
      return t;
    }

    function tipHistoryFromUnknown(value: unknown): TipHistoryEntry[] {
      if (!Array.isArray(value)) return [];
      const out: TipHistoryEntry[] = [];
      for (const item of value) {
        if (!item || typeof item !== "object" || Array.isArray(item)) continue;
        const rec = item as Record<string, unknown>;
        const date = typeof rec.date === "string" ? rec.date.trim() : "";
        if (!date) continue;
        const entry: TipHistoryEntry = { date };
        const headline = typeof rec.headline === "string" ? rec.headline.trim() : "";
        const note = typeof rec.note === "string" ? rec.note.trim() : "";
        if (headline) entry.headline = headline;
        if (note) entry.note = note;
        out.push(entry);
      }
      return out;
    }

    function updateTipVisualState() {
      const currentChecked = Boolean(
        (form?.elements?.namedItem("tipOfWeek") as HTMLInputElement | null)?.checked
      );
      tipCurrentWrapEl?.classList.toggle("is-current-tip", currentChecked);
      if (tipCurrentBadgeEl) tipCurrentBadgeEl.hidden = !currentChecked;
      if (tipHistorySummaryEl) {
        const times = tipHistoryDraft.length;
        tipHistorySummaryEl.textContent = `Used ${times} ${times === 1 ? "time" : "times"}`;
      }
      if (tipHistoryBadgeEl) tipHistoryBadgeEl.hidden = tipHistoryDraft.length === 0;

      if (tipMultiWarningEl) {
        let trueCount = videos.reduce((count, v) => {
          const value = stableVideoKey(v) === editingKey ? currentChecked : Boolean(v.tipOfWeek ?? v.isTipOfWeek);
          return count + (value ? 1 : 0);
        }, 0);
        if (editingKey === null && currentChecked) trueCount += 1;
        if (trueCount > 1) {
          tipMultiWarningEl.textContent = `Warning: ${trueCount} videos are marked as Current Tip of the Week.`;
          tipMultiWarningEl.hidden = false;
        } else {
          tipMultiWarningEl.textContent = "";
          tipMultiWarningEl.hidden = true;
        }
      }
    }

    function renderTipHistoryEditor() {
      if (!tipHistoryListEl) return;
      tipHistoryListEl.innerHTML = "";
      if (!tipHistoryDraft.length) {
        const empty = document.createElement("p");
        empty.className = "tip-history-empty";
        empty.textContent = "No history entries yet.";
        tipHistoryListEl.appendChild(empty);
        updateTipVisualState();
        return;
      }

      tipHistoryDraft.forEach((entry, idx) => {
        const card = document.createElement("article");
        card.className = "tip-history-item";

        const head = document.createElement("div");
        head.className = "tip-history-item-head";
        const title = document.createElement("strong");
        title.textContent = `Entry ${idx + 1}`;
        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className = "kbm-btn kbm-btn-accent";
        removeBtn.setAttribute("data-remove-tip-history", String(idx));
        removeBtn.textContent = "Remove";
        head.append(title, removeBtn);

        const grid = document.createElement("div");
        grid.className = "field-grid";

        const dateLabel = document.createElement("label");
        const dateLabelText = document.createElement("span");
        dateLabelText.textContent = "Date";
        const dateInput = document.createElement("input");
        dateInput.type = "date";
        dateInput.setAttribute("data-tip-date", String(idx));
        dateInput.value = entry.date;
        dateLabel.append(dateLabelText, dateInput);

        const headlineLabel = document.createElement("label");
        headlineLabel.className = "field-full";
        const headlineLabelText = document.createElement("span");
        headlineLabelText.textContent = "Headline";
        const headlineInput = document.createElement("input");
        headlineInput.type = "text";
        headlineInput.setAttribute("data-tip-headline", String(idx));
        headlineInput.value = entry.headline ?? "";
        headlineLabel.append(headlineLabelText, headlineInput);

        const noteLabel = document.createElement("label");
        noteLabel.className = "field-full";
        const noteLabelText = document.createElement("span");
        noteLabelText.textContent = "Note";
        const noteInput = document.createElement("textarea");
        noteInput.setAttribute("data-tip-note", String(idx));
        noteInput.rows = 3;
        noteInput.value = entry.note ?? "";
        noteLabel.append(noteLabelText, noteInput);

        grid.append(dateLabel, headlineLabel, noteLabel);
        card.append(head, grid);
        tipHistoryListEl.appendChild(card);
      });
      updateTipVisualState();
    }

    function syncTipHistoryDraftFromDom() {
      if (!tipHistoryListEl) return;
      tipHistoryDraft = tipHistoryDraft
        .map((_, idx) => {
          const dateEl = tipHistoryListEl.querySelector(`[data-tip-date="${idx}"]`);
          const headlineEl = tipHistoryListEl.querySelector(`[data-tip-headline="${idx}"]`);
          const noteEl = tipHistoryListEl.querySelector(`[data-tip-note="${idx}"]`);
          const date =
            dateEl instanceof HTMLInputElement && typeof dateEl.value === "string" ? dateEl.value.trim() : "";
          const headline =
            headlineEl instanceof HTMLInputElement && typeof headlineEl.value === "string"
              ? headlineEl.value.trim()
              : "";
          const note =
            noteEl instanceof HTMLTextAreaElement && typeof noteEl.value === "string" ? noteEl.value.trim() : "";
          const next: TipHistoryEntry = { date };
          if (headline) next.headline = headline;
          if (note) next.note = note;
          return next;
        });
      updateTipVisualState();
    }

    function updatePosterPreview() {
      const img = document.getElementById("poster-preview");
      if (!(img instanceof HTMLImageElement)) return;
      const url = textVal("posterUrl");
      if (!url) {
        img.hidden = true;
        img.removeAttribute("src");
        img.alt = "";
        return;
      }
      img.hidden = false;
      img.alt = "Current video thumbnail";
      if (img.getAttribute("src") !== url) img.src = url;
    }

    function refreshJsonPreview() {
      if (!jsonPreviewEl) return;
      const row = buildVideoFromForm({ silent: true });
      if (row) jsonPreviewEl.textContent = JSON.stringify(row, null, 2);
      else jsonPreviewEl.textContent = "// Fix validation errors to see full JSON.";
      updatePosterPreview();
    }

    async function refreshVimeoThumbnail() {
      const button = document.getElementById("btn-refresh-vimeo-thumbnail");
      const vimeoRaw = textVal("vimeo_id");
      const vimeoId = parseInt(vimeoRaw, 10);
      if (!/^\d+$/.test(vimeoRaw) || !Number.isFinite(vimeoId) || vimeoId <= 0) {
        setStatus("Enter a Vimeo ID before refreshing the thumbnail.", "err");
        return;
      }

      const params = new URLSearchParams({ vimeo_id: String(vimeoId) });
      const baselineId = baseline && typeof baseline.vimeo_id === "number" ? baseline.vimeo_id : null;
      const baselineHash =
        baseline && typeof baseline.vimeo_hash === "string" ? baseline.vimeo_hash.trim() : "";
      if (baselineId === vimeoId && /^[A-Za-z0-9]+$/.test(baselineHash)) {
        params.set("vimeo_hash", baselineHash);
      }

      if (button instanceof HTMLButtonElement) button.disabled = true;
      setStatus("Loading the current Vimeo thumbnail…");
      try {
        const result = await fetchAdminJson<{ posterUrl?: string }>(
          `/api/admin/videos/vimeo-thumbnail?${params.toString()}`,
          { method: "GET" },
        );
        const posterUrl = typeof result.data.posterUrl === "string" ? result.data.posterUrl.trim() : "";
        if (!result.ok || !posterUrl) {
          if (result.needsSignIn) promptAdminSignIn(window.location.pathname + window.location.search);
          setStatus(result.error || "Vimeo did not return a thumbnail for that video.", "err");
          return;
        }
        const previous = textVal("posterUrl");
        setField("posterUrl", posterUrl);
        refreshJsonPreview();
        if (previous === posterUrl) {
          setStatus("This video already has the current Vimeo thumbnail. Save if you still need to store it.", "ok");
        } else {
          setStatus("Thumbnail updated in the form. Save to store it for every page that uses this video.", "ok");
        }
      } catch {
        setStatus("Could not reach Vimeo to refresh the thumbnail.", "err");
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    }

    function buildVideoFromForm(options?: { silent?: boolean }): VideoRow | null {
      const silent = options?.silent === true;
      const slug = textVal("slug");
      const title = textVal("title");
      if (!slug || !title) {
        if (!silent) setStatus("Title and slug are required.", "err");
        return null;
      }

      const vimeoRaw = textVal("vimeo_id");
      const vimeo_id = parseInt(vimeoRaw, 10);
      if (!/^\d+$/.test(vimeoRaw) || !Number.isFinite(vimeo_id) || vimeo_id <= 0) {
        if (!silent) setStatus("Enter the Vimeo ID (numbers only).", "err");
        return null;
      }

      const base = baseline ? deepClone(baseline) : {};
      const row: VideoRow = { ...base };

      if (baseline) row.content_id = baseline.content_id;
      else delete row.content_id;
      row.slug = slug;
      row.title = title;
      row.vimeo_id = vimeo_id;

      const desc = textVal("description");
      if (desc) row.description = desc;
      else delete row.description;

      const al = textVal("access_level");
      if (al) row.access_level = al;
      else delete row.access_level;

      const poster = textVal("posterUrl");
      if (poster) row.posterUrl = poster;
      else delete row.posterUrl;

      const cat = textVal("category");
      if (cat) row.category = cat;
      else delete row.category;

      const sub = textVal("subcategory");
      if (sub) row.subcategory = sub;
      else delete row.subcategory;

      const vt = textVal("videoType");
      if (vt) row.videoType = vt;
      else delete row.videoType;

      const src = textVal("sourceVideoId");
      if (src) {
        const p = parseContentIdField(src);
        if (p !== "") row.sourceVideoId = p;
        else delete row.sourceVideoId;
      } else delete row.sourceVideoId;

      const clipLines = linesFromTextarea("clips");
      if (clipLines.length) row.clips = clipLines;
      else delete row.clips;

      row.search_ready = Boolean(
        (form?.elements?.namedItem("search_ready") as HTMLInputElement | null)?.checked
      );

      row.tipOfWeek = Boolean((form?.elements?.namedItem("tipOfWeek") as HTMLInputElement | null)?.checked);
      row.isTipOfWeek = row.tipOfWeek;

      const tipHeadline = textVal("tipHeadline");
      if (tipHeadline) row.tipHeadline = tipHeadline;
      else delete row.tipHeadline;

      const tipNote = textVal("tipNote");
      if (tipNote) row.tipNote = tipNote;
      else delete row.tipNote;

      syncTipHistoryDraftFromDom();
      if (!silent) {
        const badEntry = tipHistoryDraft.find((entry) => !entry.date);
        if (badEntry) {
          setStatus("Every Tip of the Week History entry must include a date.", "err");
          return null;
        }
      }
      if (tipHistoryDraft.length) row.tipHistory = deepClone(tipHistoryDraft);
      else delete row.tipHistory;

      return row;
    }

    function currentStatus(): SaveStatus | null {
      if (!baseline) return null;
      const raw = typeof baseline.status === "string" ? baseline.status.trim().toLowerCase() : "";
      if (raw === "draft" || raw === "archived") return raw;
      return "published";
    }

    function contentIdOf(row: VideoRow | null): string {
      return row ? String(row.content_id ?? "").trim() : "";
    }

    function setAccessField(value: string) {
      const select = document.getElementById("field-access_level");
      if (!(select instanceof HTMLSelectElement)) return;
      const normalized = value.trim().toLowerCase() || "member";
      select.querySelectorAll("option[data-stored]").forEach((option) => option.remove());
      if (!Array.from(select.options).some((option) => option.value === normalized)) {
        // Keep a stored value the editor does not offer (for example "draft") until it is changed.
        const option = document.createElement("option");
        option.value = normalized;
        option.textContent = `${normalized} (current, members only)`;
        option.dataset.stored = "true";
        select.appendChild(option);
      }
      select.value = normalized;
    }

    const TRANSCRIPT_TEXT: Record<TranscriptState, string> = {
      published: "A transcript is saved and shows on the video page.",
      draft: "A transcript is saved. It will show on the video page once the video is published.",
      none: "No transcript uploaded yet.",
    };

    /** Show the buttons that fit this video's current status. */
    function renderState() {
      const status = currentStatus();
      const show = (id: string, visible: boolean) => {
        const el = document.getElementById(id);
        if (el) el.hidden = !visible;
      };
      show("btn-save-draft", status === null || status === "draft");
      show("btn-publish", status !== "published");
      show("btn-save-published", status === "published");
      show("btn-unpublish", status === "published");
      show("btn-archive", status === "draft" || status === "published");
      const publishBtn = document.getElementById("btn-publish");
      if (publishBtn) publishBtn.textContent = status === null ? "Save and publish" : "Publish";

      const id = contentIdOf(baseline);
      const preview = document.getElementById("btn-preview-video");
      if (preview instanceof HTMLAnchorElement) {
        preview.hidden = !id;
        if (id) preview.href = `/admin/videos-preview/${encodeURIComponent(id)}`;
      }

      const stateEl = document.getElementById("videos-edit-state");
      if (stateEl) {
        stateEl.hidden = status === null;
        stateEl.textContent =
          status === "published"
            ? "Status: Published. Visitors can see this video."
            : status === "draft"
              ? "Status: Draft. Hidden from the Learning Library, search, and the video page."
              : status === "archived"
                ? "Status: Archived. Hidden everywhere. Publish to bring it back."
                : "";
      }

      const vttCurrent = document.getElementById("vtt-current");
      if (vttCurrent) vttCurrent.textContent = TRANSCRIPT_TEXT[transcripts[id] ?? "none"];

      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-save-status]")) {
        button.disabled = saving || !saveInfo.canSave;
      }
      updateSlugHint();
    }

    function updateSlugHint() {
      const hint = document.getElementById("field-slug-hint");
      if (!hint) return;
      const stored = typeof baseline?.slug === "string" ? baseline.slug : "";
      const changedPublished = currentStatus() === "published" && stored && textVal("slug") !== stored;
      hint.classList.toggle("is-warning", Boolean(changedPublished));
      hint.textContent = changedPublished
        ? `Changing the slug of a published video can break links that use “${stored}”. Keep it unless you are sure.`
        : baseline
          ? "Lowercase words joined by hyphens."
          : "Lowercase words joined by hyphens. Filled in from the title until you edit it.";
    }

    function fillSlugFromTitle(force: boolean) {
      if (!force && (slugTouched || baseline)) return;
      const base = slugFromTitle(textVal("title"));
      if (!base) return;
      setField("slug", uniqueVideoSlug(base, videos, contentIdOf(baseline) || undefined));
      if (force) slugTouched = true;
      updateSlugHint();
      refreshJsonPreview();
    }

    function clearPendingVtt() {
      pendingVtt = null;
      const input = document.getElementById("field-vtt");
      if (input instanceof HTMLInputElement) input.value = "";
      const selected = document.getElementById("vtt-selected");
      if (selected) {
        selected.hidden = true;
        selected.textContent = "";
        selected.classList.remove("is-error");
      }
      const clear = document.getElementById("btn-clear-vtt");
      if (clear) clear.hidden = true;
    }

    async function readVttFile(file: File) {
      const selected = document.getElementById("vtt-selected");
      const clear = document.getElementById("btn-clear-vtt");
      pendingVtt = null;
      const fail = (message: string) => {
        if (selected) {
          selected.hidden = false;
          selected.textContent = message;
          selected.classList.add("is-error");
        }
        if (clear) clear.hidden = false;
      };
      if (file.size > 2 * 1024 * 1024) return fail(`${file.name} is larger than 2 MB.`);
      const text = await file.text();
      if (!/^﻿?WEBVTT/.test(text)) return fail(`${file.name} does not start with WEBVTT, so it is not a caption file.`);
      pendingVtt = { filename: file.name, text };
      if (selected) {
        selected.hidden = false;
        selected.classList.remove("is-error");
        selected.textContent = `Ready to upload ${file.name}. It is processed when you save.`;
      }
      if (clear) clear.hidden = false;
    }

    function loadRowToForm(row: VideoRow) {
      baseline = deepClone(row);
      editingKey = stableVideoKey(row);
      slugTouched = true;

      setField("content_id", String(row.content_id ?? ""));
      const hint = document.getElementById("field-content_id-hint");
      if (hint) hint.textContent = "Video numbers never change.";
      setField("slug", typeof row.slug === "string" ? row.slug : "");
      setField("title", typeof row.title === "string" ? row.title : "");
      setField("description", typeof row.description === "string" ? row.description : "");
      setAccessField(typeof row.access_level === "string" ? row.access_level : "member");
      setField("posterUrl", typeof row.posterUrl === "string" ? row.posterUrl : "");
      setField("category", typeof row.category === "string" ? row.category : "");
      setField("subcategory", typeof row.subcategory === "string" ? row.subcategory : "");
      setField("vimeo_id", row.vimeo_id !== undefined ? String(row.vimeo_id) : "");
      setCheckbox("tipOfWeek", Boolean(row.tipOfWeek ?? row.isTipOfWeek));
      setField("tipHeadline", typeof row.tipHeadline === "string" ? row.tipHeadline : "");
      setField("tipNote", typeof row.tipNote === "string" ? row.tipNote : "");
      tipHistoryDraft = tipHistoryFromUnknown(row.tipHistory);
      renderTipHistoryEditor();
      setField("videoType", typeof row.videoType === "string" ? row.videoType : "");
      setField(
        "sourceVideoId",
        row.sourceVideoId !== undefined && row.sourceVideoId !== null ? String(row.sourceVideoId) : ""
      );
      setField("clips", linesToText(row.clips));
      setCheckbox("search_ready", Boolean(row.search_ready));

      if (modeEl) modeEl.textContent = `Editing video ${String(row.content_id ?? "")}: ${String(row.title ?? editingKey)}`;
      clearPendingVtt();
      renderState();
      refreshJsonPreview();
    }

    function clearFormNew() {
      baseline = null;
      editingKey = null;
      slugTouched = false;
      setField("content_id", nextContentId ? `${nextContentId} (assigned when you save)` : "Assigned when you save");
      const hint = document.getElementById("field-content_id-hint");
      if (hint) hint.textContent = "The next unused number is assigned when you save, even if someone else adds a video first.";
      setField("slug", "");
      setField("title", "");
      setField("description", "");
      setAccessField("member");
      setField("posterUrl", "");
      setField("category", "");
      setField("subcategory", "");
      setField("vimeo_id", "");
      setCheckbox("tipOfWeek", false);
      setField("tipHeadline", "");
      setField("tipNote", "");
      tipHistoryDraft = [];
      renderTipHistoryEditor();
      setField("videoType", "");
      setField("sourceVideoId", "");
      setField("clips", "");
      setCheckbox("search_ready", false);
      if (modeEl) modeEl.textContent = "New video. Fill in the details, then save a draft or publish.";
      clearPendingVtt();
      renderState();
      refreshJsonPreview();
    }

    type StepKind = "done" | "error" | "waiting";
    function renderSteps(steps: Array<{ text: string; kind: StepKind }>, failed = false) {
      const panel = document.getElementById("videos-edit-result");
      const list = document.getElementById("videos-edit-steps");
      if (!panel || !list) return;
      panel.hidden = false;
      panel.classList.toggle("is-error", failed);
      list.innerHTML = "";
      for (const step of steps) {
        const item = document.createElement("li");
        item.className = `is-${step.kind}`;
        item.textContent = step.text;
        list.appendChild(item);
      }
    }

    let lastSaveSteps: Array<{ text: string; kind: StepKind }> = [];

    function stopLiveChecks() {
      if (liveTimer !== null) window.clearInterval(liveTimer);
      liveTimer = null;
    }

    /** Ask the site whether this deploy serves the saved version yet. */
    async function checkLive(contentId: string, options: { quiet?: boolean } = {}) {
      const result = await fetchAdminJson<{ live?: boolean; record?: string; transcriptLive?: boolean }>(
        `${STATUS_API}?content_id=${encodeURIComponent(contentId)}`,
        { method: "GET" },
      );
      const steps = lastSaveSteps.slice(0, -1);
      if (!result.ok) {
        if (!options.quiet) renderSteps([...steps, { text: result.error || "Could not check the site.", kind: "error" }], true);
        return false;
      }
      const status = currentStatus();
      if (result.data.live) {
        stopLiveChecks();
        const text =
          status === "published"
            ? "Live. The Learning Library, search, and video page now show this version."
            : "Done. The site has rebuilt with this change, and the video stays hidden from visitors.";
        lastSaveSteps = [...steps, { text, kind: "done" }];
        renderSteps(lastSaveSteps);
        const publicLink = document.getElementById("videos-edit-result-public");
        if (publicLink instanceof HTMLAnchorElement && status === "published") {
          publicLink.hidden = false;
          publicLink.href = `/videos/${encodeURIComponent(contentId)}`;
        }
        return true;
      }
      const waiting = `Site rebuilding. Last checked ${new Date().toLocaleTimeString()}. This usually takes a few minutes.`;
      lastSaveSteps = [...steps, { text: waiting, kind: "waiting" }];
      renderSteps(lastSaveSteps);
      return false;
    }

    function startLiveChecks(contentId: string) {
      stopLiveChecks();
      const started = Date.now();
      liveTimer = window.setInterval(() => {
        if (Date.now() - started > 20 * 60 * 1000) {
          stopLiveChecks();
          return;
        }
        void checkLive(contentId, { quiet: true });
      }, 30 * 1000);
    }

    async function saveVideo(status: SaveStatus) {
      if (saving) return;
      if (!saveInfo.canSave) {
        setStatus(saveInfo.warning || "Saving is turned off on this site.", "err");
        return;
      }
      const row = buildVideoFromForm();
      if (!row) return;
      if (status === "archived" && !confirm("Archive this video? It disappears from the Learning Library, search, and its video page until you publish it again.")) {
        return;
      }
      const previous = currentStatus();
      if (previous === "published" && status === "draft" && !confirm("Move this video to draft? Visitors will no longer see it.")) {
        return;
      }

      saving = true;
      stopLiveChecks();
      renderState();
      const isNew = baseline === null;
      setStatus(isNew ? "Saving the new video…" : "Saving…");
      renderSteps([{ text: pendingVtt ? "Checking the details and processing the transcript…" : "Checking the details…", kind: "waiting" }]);

      try {
        const result = await fetchAdminJson<{
          contentId?: string;
          video?: VideoRow;
          transcript?: TranscriptState;
          summary?: string[];
          persistedVia?: string;
          branch?: string | null;
          commitSha?: string | null;
          posterWarning?: string;
          step?: string;
        }>(SAVE_API, {
          method: "POST",
          body: {
            action: isNew ? "create" : "update",
            contentId: isNew ? undefined : baseline?.content_id,
            status,
            video: row,
            vtt: pendingVtt,
          },
        });
        if (!result.ok || !result.data.video || !result.data.contentId) {
          if (result.needsSignIn) promptAdminSignIn(window.location.pathname + window.location.search);
          const stage = result.data.step === "check" ? "Not saved: " : "Save failed: ";
          renderSteps([{ text: `${stage}${result.error || "unknown error"}`, kind: "error" }], true);
          setStatus(result.error || "Save failed.", "err");
          return;
        }

        const data = result.data;
        const saved = data.video!;
        const contentId = data.contentId!;
        const index = videos.findIndex((video) => contentIdOf(video) === contentId);
        if (index >= 0) videos[index] = saved;
        else videos.push(saved);
        transcripts[contentId] = data.transcript ?? "none";
        if (isNew) nextContentId = Math.max(nextContentId, Number(contentId) + 1 || 0);
        loadRowToForm(saved);

        const where =
          data.persistedVia === "github"
            ? `Saved to GitHub (${data.branch ?? "branch"}), commit ${String(data.commitSha ?? "").slice(0, 7)}.`
            : "Saved to the local catalog files.";
        const statusWord = status === "published" ? "published" : status === "draft" ? "a draft" : "archived";
        lastSaveSteps = [
          { text: `${isNew ? `Created video ${contentId}` : `Updated video ${contentId}`} as ${statusWord}.`, kind: "done" },
          ...(data.summary ?? []).map((text) => ({ text, kind: "done" as StepKind })),
          { text: where, kind: "done" },
        ];
        if (data.posterWarning) lastSaveSteps.push({ text: data.posterWarning, kind: "error" });
        lastSaveSteps.push({ text: "Site rebuilding. This usually takes a few minutes.", kind: "waiting" });
        renderSteps(lastSaveSteps);
        setStatus(`Saved video ${contentId}.`, "ok");

        const checkBtn = document.getElementById("btn-check-live");
        if (checkBtn) {
          checkBtn.hidden = false;
          checkBtn.dataset.contentId = contentId;
        }
        const previewLink = document.getElementById("videos-edit-result-preview");
        if (previewLink instanceof HTMLAnchorElement) {
          previewLink.hidden = false;
          previewLink.href = `/admin/videos-preview/${encodeURIComponent(contentId)}`;
        }
        const publicLink = document.getElementById("videos-edit-result-public");
        if (publicLink) publicLink.hidden = true;

        const url = new URL(window.location.href);
        url.searchParams.set("key", stableVideoKey(saved));
        window.history.replaceState({}, "", url.toString());
        if (data.persistedVia === "github") startLiveChecks(contentId);
        else void checkLive(contentId, { quiet: true });
      } catch {
        renderSteps([{ text: "Save failed: the site could not be reached. Nothing was saved.", kind: "error" }], true);
        setStatus("Network error. Nothing was saved.", "err");
      } finally {
        saving = false;
        renderState();
      }
    }

    async function copyVimeoId() {
      const value = textVal("vimeo_id");
      const button = document.getElementById("btn-copy-vimeo");
      if (!/^\d+$/.test(value)) {
        setStatus("Enter a Vimeo ID to copy.", "err");
        return;
      }
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        const area = document.createElement("textarea");
        area.value = value;
        document.body.appendChild(area);
        area.select();
        document.execCommand("copy");
        area.remove();
      }
      if (button instanceof HTMLButtonElement) {
        const previous = button.textContent;
        button.textContent = "Copied";
        window.setTimeout(() => {
          button.textContent = previous;
        }, 1600);
      }
      setStatus(`Copied Vimeo ID ${value}.`, "ok");
    }

    function renderSaveTarget() {
      const el = document.getElementById("videos-edit-save-target");
      if (!el) return;
      el.hidden = false;
      el.classList.toggle("is-warning", !saveInfo.canSave);
      el.textContent = !saveInfo.canSave
        ? saveInfo.warning || "Saving is turned off on this site."
        : saveInfo.mode === "github"
          ? `Saves are committed to GitHub (${saveInfo.branch ?? "branch"}). The site then rebuilds, usually within a few minutes.`
          : "Local workspace: saves update the catalog files in this checkout.";
    }

    async function init() {
      setStatus("Loading catalog…");
      try {
        const result = await fetchAdminJson<{
          videos?: VideoRow[];
          transcripts?: Record<string, TranscriptState>;
          nextContentId?: number;
          save?: SaveInfo;
        }>(API_BASE, { method: "GET" });
        if (!result.ok || !Array.isArray(result.data.videos)) {
          if (result.needsSignIn) promptAdminSignIn(window.location.pathname + window.location.search);
          setStatus(result.error || "Load failed.", "err");
          if (modeEl) modeEl.textContent = "Error";
          return;
        }
        videos = result.data.videos;
        transcripts = result.data.transcripts ?? {};
        nextContentId = Number(result.data.nextContentId) || 0;
        saveInfo = result.data.save ?? { canSave: false };
      } catch {
        setStatus("Network error.", "err");
        if (modeEl) modeEl.textContent = "Error";
        return;
      }
      renderSaveTarget();

      if (keyParam) {
        const row = videos.find((v) => stableVideoKey(v) === keyParam || contentIdOf(v) === keyParam);
        if (row) {
          loadRowToForm(row);
          setStatus("");
        } else {
          clearFormNew();
          setStatus(`No video found for key "${keyParam}".`, "err");
        }
      } else {
        clearFormNew();
        setStatus("");
      }

      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-save-status]")) {
        button.addEventListener("click", () => void saveVideo(button.dataset.saveStatus as SaveStatus));
      }
      document.getElementById("btn-check-live")?.addEventListener("click", (event) => {
        const id = (event.currentTarget as HTMLElement).dataset.contentId;
        if (id) void checkLive(id);
      });
      document.getElementById("btn-copy-vimeo")?.addEventListener("click", () => void copyVimeoId());
      document.getElementById("btn-cancel-video")?.addEventListener("click", () => {
        window.location.href = "/admin/videos-admin";
      });
      document.getElementById("btn-slug-from-title")?.addEventListener("click", () => fillSlugFromTitle(true));
      document.getElementById("field-title")?.addEventListener("input", () => fillSlugFromTitle(false));
      document.getElementById("field-slug")?.addEventListener("input", () => {
        slugTouched = true;
        updateSlugHint();
      });
      document.getElementById("field-vtt")?.addEventListener("change", (event) => {
        const file = (event.currentTarget as HTMLInputElement).files?.[0];
        if (file) void readVttFile(file);
        else clearPendingVtt();
      });
      document.getElementById("btn-clear-vtt")?.addEventListener("click", clearPendingVtt);
      document.getElementById("btn-refresh-video-json-preview")?.addEventListener("click", refreshJsonPreview);
      document.getElementById("btn-refresh-vimeo-thumbnail")?.addEventListener("click", () => {
        void refreshVimeoThumbnail();
      });
      form?.addEventListener("input", refreshJsonPreview);
      form?.addEventListener("change", refreshJsonPreview);
      form?.addEventListener("change", updateTipVisualState);
      tipHistoryListEl?.addEventListener("input", () => {
        syncTipHistoryDraftFromDom();
        refreshJsonPreview();
      });
      tipHistoryListEl?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const removeIdxRaw = target.getAttribute("data-remove-tip-history");
        if (removeIdxRaw === null) return;
        const idx = Number.parseInt(removeIdxRaw, 10);
        if (!Number.isFinite(idx)) return;
        tipHistoryDraft = tipHistoryDraft.filter((_, i) => i !== idx);
        renderTipHistoryEditor();
        refreshJsonPreview();
      });
      document.getElementById("btn-add-tip-history")?.addEventListener("click", () => {
        syncTipHistoryDraftFromDom();
        const today = new Date().toISOString().slice(0, 10);
        tipHistoryDraft.push({ date: today, headline: "", note: "" });
        renderTipHistoryEditor();
        refreshJsonPreview();
      });
    }

    init();
  </script>
</BaseLayout>
