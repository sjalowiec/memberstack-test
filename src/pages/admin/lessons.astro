---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ADMIN_ROUTES } from "../../lib/adminRoutes";
import lessons from "../../data/lessons.json";
import GlossaryTooltip from "../../components/common/GlossaryTooltip.astro";

const entries = Array.isArray(lessons) ? lessons : [];

type LessonEntry = {
  id?: number;
  slug?: string;
  status?: string;
  title?: string;
};

function lessonTitle(entry: LessonEntry): string {
  const t = entry.title?.trim();
  return t || "Untitled";
}

function displayStatus(entry: LessonEntry): string {
  if (entry.status === "draft") return "draft";
  if (entry.status === "published") return "published";
  if (entry.status?.trim()) return entry.status.trim();
  return "published";
}

const publishedLessons = entries.filter(
  (e): e is (typeof entries)[number] =>
    Boolean(e) && (e as LessonEntry).status !== "draft"
);
const draftLessons = entries.filter(
  (e): e is (typeof entries)[number] =>
    Boolean(e) && (e as LessonEntry).status === "draft"
);

const lessonSections = [
  {
    headingId: "published-lessons-heading",
    panelTitle: "Published Lessons",
    items: publishedLessons,
  },
  {
    headingId: "draft-lessons-heading",
    panelTitle: "Draft Lessons",
    items: draftLessons,
  },
] as const;
---

<BaseLayout
  title="Lessons Admin | Knit it Now"
  description="View and manage lesson entries."
  bodyClass="lessons-admin-body"
>
  <main class="lessons-admin help-hub-dash">
    <header class="lessons-admin__head">
      <h1 class="lessons-admin__title">Lessons Admin</h1>
      <p class="lessons-admin__sub">
        View and manage lesson entries.
      </p>
    </header>

    <div class="lessons-admin__toolbar help-hub-dash__toolbar">
      <a href={ADMIN_ROUTES.lessonEdit} class="kbm-btn kbm-btn-primary"
        >Create New Lesson</a
      >
      <a href={ADMIN_ROUTES.dashboard} class="kbm-btn kbm-btn-outline"
        >Back to Creator Control Panel</a
      >
    </div>

    {
      entries.length === 0 ? (
        <p class="help-hub-dash__placeholder">No lessons yet.</p>
      ) : (
        <div class="help-hub-dash__sections lessons-admin__sections">
          {lessonSections.map(({ headingId, panelTitle, items }) => (
            <section
              class="admin-panel help-hub-dash__panel"
              aria-labelledby={headingId}
            >
              <h2 id={headingId} class="help-hub-dash__panel-title">
                {panelTitle}
              </h2>
              {items.length === 0 ? (
                <p class="help-hub-dash__placeholder">No lessons yet.</p>
              ) : (
                <ul class="help-hub-dash__list">
                  {items.map((raw) => {
                    const lesson = raw as LessonEntry;
                    const slug = lesson.slug ?? "";
                    return (
                      <li class="help-hub-dash__entry">
                        <div class="help-hub-dash__entry-line">
                          <span class="help-hub-dash__entry-q">
                            {lessonTitle(lesson)}
                          </span>
                          {typeof lesson.id === "number" &&
                          Number.isFinite(lesson.id) ? (
                            <span class="help-hub-dash__entry-id">
                              ID: {lesson.id}
                            </span>
                          ) : null}
                        </div>
                        <div class="help-hub-dash__entry-meta">
                          <span class="help-hub-dash__entry-status">
                            {displayStatus(lesson)}
                          </span>
                          {slug ? (
                            <a
                              class="help-hub-dash__entry-edit"
                              href={`${ADMIN_ROUTES.lessonEdit}?slug=${encodeURIComponent(slug)}`}
                            >
                              Edit
                            </a>
                          ) : (
                            <span class="help-hub-dash__entry-edit help-hub-dash__entry-edit--disabled">
                              Edit (no slug)
                            </span>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ul>
              )}
            </section>
          ))}
        </div>
      )
    }
  </main>

  <style>
    :global(body.lessons-admin-body) {
      margin: 0;
    }

    .lessons-admin {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 1.25rem 1.5rem 3rem;
      box-sizing: border-box;
    }

    .lessons-admin__head {
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e2e8f0;
    }

    .lessons-admin__title {
      margin: 0 0 0.35rem 0;
      font-size: 1.65rem;
      color: #243015;
    }

    .lessons-admin__sub {
      margin: 0;
      font-size: 0.95rem;
      color: #475569;
      max-width: 56rem;
    }

    .lessons-admin__toolbar {
      margin-bottom: 1.5rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem 1rem;
    }

    .admin-panel {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 1rem 1.1rem;
    }

    .help-hub-dash__sections {
      display: grid;
      gap: 1rem;
      grid-template-columns: 1fr;
    }

    @media (min-width: 900px) {
      .lessons-admin__sections {
        grid-template-columns: repeat(2, 1fr);
        align-items: start;
      }
    }

    .help-hub-dash__panel-title {
      margin: 0 0 0.65rem 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #243015;
    }

    .help-hub-dash__placeholder {
      margin: 0;
      font-size: 0.92rem;
      color: #64748b;
      line-height: 1.45;
    }

    .help-hub-dash__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .help-hub-dash__entry {
      margin: 0;
      padding: 0.55rem 0.65rem;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #f8fafc;
    }

    .help-hub-dash__entry-line {
      margin-bottom: 0.35rem;
    }

    .help-hub-dash__entry-q {
      font-size: 0.92rem;
      font-weight: 600;
      color: #1e293b;
      line-height: 1.35;
    }

    .help-hub-dash__entry-id {
      display: block;
      margin-top: 0.15rem;
      font-size: 0.75rem;
      font-weight: 400;
      color: #94a3b8;
      line-height: 1.3;
    }

    .help-hub-dash__entry-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.85rem;
      font-size: 0.85rem;
    }

    .help-hub-dash__entry-status {
      color: #64748b;
      text-transform: capitalize;
    }

    .help-hub-dash__entry-edit {
      color: #3f6212;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .help-hub-dash__entry-edit:hover {
      color: #243015;
    }

    .help-hub-dash__entry-edit--disabled {
      color: #94a3b8;
      font-weight: 500;
      text-decoration: none;
    }
  </style>
</BaseLayout>
