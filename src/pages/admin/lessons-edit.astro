---
import BaseLayout from "../../layouts/BaseLayout.astro";
import lessonsData from "../../data/lessons.json";

const entries = Array.isArray(lessonsData) ? lessonsData : [];
const slug = Astro.url.searchParams.get("slug");
const currentEntry = slug
  ? entries.find((entry) => entry.slug === slug)
  : null;
const isEditing = Boolean(currentEntry);

function lessonNumericId(
  entry: Record<string, unknown> | null | undefined
): number | null {
  if (!entry) return null;
  const id = entry.id;
  if (typeof id === "number" && Number.isFinite(id)) return id;
  if (typeof id === "string" && /^\s*\d+\s*$/.test(id)) {
    const n = parseInt(id.trim(), 10);
    return Number.isFinite(n) ? n : null;
  }
  return null;
}

const maxLessonId = entries.reduce((max, e) => {
  const n = lessonNumericId(e as Record<string, unknown>);
  return n != null ? Math.max(max, n) : max;
}, 0);

const nextLessonId = maxLessonId + 1;

const pageTitle = isEditing
  ? "Edit Lesson | Knit it Now"
  : "Create Lesson | Knit it Now";

const rawEntry = currentEntry as Record<string, unknown> | null;
const existingLessonId = isEditing ? lessonNumericId(rawEntry) : null;

function stringifyValue(v: unknown): string {
  if (v === undefined || v === null) return "";
  if (Array.isArray(v)) return v.map(String).join("\n");
  if (typeof v === "object") return "";
  return String(v);
}

function valueFor(key: string, fallback = ""): string {
  if (!rawEntry) return fallback;

  if (key === "intro") {
    const direct = rawEntry.intro;
    if (direct !== undefined && direct !== null && typeof direct !== "object")
      return stringifyValue(direct);
    if (typeof rawEntry.summary === "string") return rawEntry.summary;
    return fallback;
  }

  if (key === "mediaUrl") {
    const direct = rawEntry.mediaUrl ?? rawEntry.videoSlug;
    return stringifyValue(direct) || fallback;
  }

  if (key === "thumbnailAlt") {
    const direct = rawEntry.thumbnailAlt ?? rawEntry.supportImageAlt;
    return stringifyValue(direct) || fallback;
  }

  if (key === "mediaType") {
    const mt = stringifyValue(rawEntry.mediaType);
    const allowed = ["image", "vimeo", "youtube"];
    if (mt && allowed.includes(mt)) return mt;
    const legacyType = stringifyValue(rawEntry.type).toLowerCase();
    if (legacyType === "video") return "youtube";
    return fallback || "image";
  }

  if (key === "status") {
    const s = stringifyValue(rawEntry.status).toLowerCase();
    if (s === "published" || s === "draft") return s;
    return fallback;
  }

  const v = rawEntry[key];
  if (v === undefined) return fallback;
  if (Array.isArray(v)) return v.map(String).join("\n");
  if (typeof v === "object" && v !== null) return fallback;
  return stringifyValue(v);
}

const entryLabel = currentEntry as {
  title?: string;
  slug?: string;
} | null;

type LessonBlockText = { type: "text"; content: string };
type LessonBlockVimeo = { type: "vimeo"; title: string; vimeoId: string };
type LessonBlockEditor = LessonBlockText | LessonBlockVimeo;

function normalizeBlocksForEditor(raw: unknown): LessonBlockEditor[] {
  if (!Array.isArray(raw)) return [{ type: "text", content: "" }];
  const out: LessonBlockEditor[] = [];
  for (const item of raw) {
    if (!item || typeof item !== "object") continue;
    const o = item as Record<string, unknown>;
    if (o.type === "text") {
      out.push({
        type: "text",
        content: typeof o.content === "string" ? o.content : "",
      });
    } else if (o.type === "vimeo") {
      const idRaw = o.vimeoId;
      const vimeoId =
        typeof idRaw === "string"
          ? idRaw
          : typeof idRaw === "number" && Number.isFinite(idRaw)
            ? String(Math.trunc(idRaw))
            : "";
      out.push({
        type: "vimeo",
        title: typeof o.title === "string" ? o.title : "",
        vimeoId,
      });
    }
  }
  if (out.length === 0) return [{ type: "text", content: "" }];
  return out;
}

const initialEditorBlocks = normalizeBlocksForEditor(rawEntry?.blocks);
/** Safe for embedding in HTML (avoids `</script>`-style breaks). */
const initialEditorBlocksJsonSafe = JSON.stringify(initialEditorBlocks).replace(/</g, "\\u003c");
---

<BaseLayout
  title={pageTitle}
  description="Draft title, slug, lesson content, media, related links, and metadata for a lesson entry."
  bodyClass="help-hub-admin-body"
>
  <main class="help-hub-admin help-hub-dash help-hub-edit">
    <header class="help-hub-admin__head">
      <h1 class="help-hub-admin__title">
        {isEditing ? "Edit Lesson" : "Create Lesson"}
      </h1>
      <p class="help-hub-admin__sub">
        Draft title, slug, status, lesson content, media, related links, and metadata.
        JSON preview updates as you type; saving is not wired yet.
      </p>
      <p class="help-hub-edit__context">
        {
          isEditing && entryLabel
            ? `Editing: ${entryLabel.title || entryLabel.slug || ""}`
            : "New lesson"
        }
      </p>
    </header>

    <div class="help-hub-admin__toolbar help-hub-dash__toolbar">
      <a href="/admin" class="kbm-btn kbm-btn-outline">Back to Admin</a>
    </div>

    <form
      class="help-hub-edit__form lessons-edit__form"
      novalidate
      data-next-lesson-id={String(nextLessonId)}
      data-original-lesson-id={existingLessonId != null ? String(existingLessonId) : ""}
    >
      <div class="help-hub-edit__sections help-hub-dash__sections">
        <section
          class="admin-panel help-hub-dash__panel"
          aria-labelledby="lessons-core-heading"
        >
          <h2 id="lessons-core-heading" class="help-hub-dash__panel-title">
            Core Details
          </h2>
          <div class="help-hub-edit__fields">
            <div class="help-hub-edit__field">
              <label for="lesson-title" class="help-hub-edit__label">Title</label>
              <input
                id="lesson-title"
                class="help-hub-edit__input"
                type="text"
                name="title"
                value={valueFor("title", "")}
              />
            </div>
            <div class="help-hub-edit__field">
              <label for="lesson-slug" class="help-hub-edit__label">Slug</label>
              <input
                id="lesson-slug"
                class="help-hub-edit__input"
                type="text"
                name="slug"
                value={valueFor("slug", "")}
              />
            </div>
            <div class="help-hub-edit__field">
              <label for="lesson-id" class="help-hub-edit__label">Lesson ID</label>
              <input
                id="lesson-id"
                class="help-hub-edit__input"
                type="number"
                name="id"
                min="0"
                step="1"
                value={valueFor("id", String(nextLessonId))}
              />
            </div>
            <div class="help-hub-edit__field">
              <label for="lesson-status" class="help-hub-edit__label">Status</label>
              <select
                id="lesson-status"
                class="help-hub-edit__select"
                name="status"
              >
                <option value="draft" selected={valueFor("status", "draft") === "draft"}>
                  draft
                </option>
                <option
                  value="published"
                  selected={valueFor("status", "draft") === "published"}
                >
                  published
                </option>
              </select>
            </div>
          </div>
        </section>

        <section
          class="admin-panel help-hub-dash__panel"
          aria-labelledby="lessons-content-heading"
        >
          <h2 id="lessons-content-heading" class="help-hub-dash__panel-title">
            Lesson Content
          </h2>
          <div class="help-hub-edit__fields">
            <div class="help-hub-edit__field">
              <label for="lesson-intro" class="help-hub-edit__label">Intro</label>
              <textarea
                id="lesson-intro"
                class="help-hub-edit__textarea"
                name="intro"
                rows={4}>{valueFor("intro", "")}</textarea>
            </div>
            <div class="help-hub-edit__field">
              <label for="lesson-content" class="help-hub-edit__label">Main Content</label>
              <textarea
                id="lesson-content"
                class="help-hub-edit__textarea"
                name="content"
                rows={10}>{valueFor("content", "")}</textarea>
            </div>
          </div>
        </section>

        <section
          class="admin-panel help-hub-dash__panel"
          aria-labelledby="lessons-blocks-heading"
        >
          <h2 id="lessons-blocks-heading" class="help-hub-dash__panel-title">
            Lesson blocks
          </h2>
          <script
            type="application/json"
            id="lesson-editor-blocks-initial"
            set:html={initialEditorBlocksJsonSafe}
          />
          <div class="lesson-blocks-editor">
            <div id="lesson-blocks-list" class="lesson-blocks-editor__list" aria-live="polite">
            </div>
            <div class="lesson-blocks-editor__actions">
              <button type="button" class="kbm-btn kbm-btn-outline" id="lesson-blocks-add-text">
                Add text block
              </button>
              <button type="button" class="kbm-btn kbm-btn-outline" id="lesson-blocks-add-vimeo">
                Add Vimeo block
              </button>
            </div>
          </div>
        </section>

        <section
          class="admin-panel help-hub-dash__panel"
          aria-labelledby="lessons-media-heading"
        >
          <h2 id="lessons-media-heading" class="help-hub-dash__panel-title">Media</h2>
          <div class="help-hub-edit__fields">
            <div class="help-hub-edit__field">
              <label for="lesson-media-type" class="help-hub-edit__label">Media Type</label>
              <select
                id="lesson-media-type"
                class="help-hub-edit__select"
                name="mediaType"
              >
                <option
                  value="image"
                  selected={valueFor("mediaType", "image") === "image"}
                >
                  image
                </option>
                <option
                  value="vimeo"
                  selected={valueFor("mediaType", "image") === "vimeo"}
                >
                  vimeo
                </option>
                <option
                  value="youtube"
                  selected={valueFor("mediaType", "image") === "youtube"}
                >
                  youtube
                </option>
              </select>
            </div>
            <div class="help-hub-edit__field">
              <label for="lesson-media-url" class="help-hub-edit__label">
                Media URL or ID
              </label>
              <input
                id="lesson-media-url"
                class="help-hub-edit__input"
                type="text"
                name="mediaUrl"
                value={valueFor("mediaUrl", "")}
              />
            </div>
            <div class="help-hub-edit__field">
              <label for="lesson-thumb-alt" class="help-hub-edit__label">
                Thumbnail Alt
              </label>
              <textarea
                id="lesson-thumb-alt"
                class="help-hub-edit__textarea"
                name="thumbnailAlt"
                rows={2}>{valueFor("thumbnailAlt", "")}</textarea>
            </div>
          </div>
        </section>

        <section
          class="admin-panel help-hub-dash__panel"
          aria-labelledby="lessons-resources-heading"
        >
          <h2 id="lessons-resources-heading" class="help-hub-dash__panel-title">
            Resources
          </h2>
          <div class="help-hub-edit__fields">
            <div class="help-hub-edit__field">
              <label for="lesson-related-help" class="help-hub-edit__label">
                Related Help Hubs
              </label>
              <textarea
                id="lesson-related-help"
                class="help-hub-edit__textarea"
                name="relatedHelpHubs"
                rows={5}>{valueFor("relatedHelpHubs", valueFor("associatedTip", ""))}</textarea>
              <p class="help-hub-edit__hint">One slug per line.</p>
            </div>
            <div class="help-hub-edit__field">
              <label for="lesson-related-lessons" class="help-hub-edit__label">
                Related Lessons
              </label>
              <textarea
                id="lesson-related-lessons"
                class="help-hub-edit__textarea"
                name="relatedLessons"
                rows={5}>{valueFor("relatedLessons", "")}</textarea>
              <p class="help-hub-edit__hint">One slug per line.</p>
            </div>
          </div>
        </section>

        <section
          class="admin-panel help-hub-dash__panel"
          aria-labelledby="lessons-metadata-heading"
        >
          <h2 id="lessons-metadata-heading" class="help-hub-dash__panel-title">
            Metadata
          </h2>
          <div class="help-hub-edit__fields">
            <div class="help-hub-edit__field">
              <label for="lesson-category" class="help-hub-edit__label">Category</label>
              <input
                id="lesson-category"
                class="help-hub-edit__input"
                type="text"
                name="category"
                value={valueFor("category", "")}
              />
            </div>
            <div class="help-hub-edit__field">
              <label for="lesson-tags" class="help-hub-edit__label">Tags</label>
              <textarea
                id="lesson-tags"
                class="help-hub-edit__textarea"
                name="tags"
                rows={3}>{valueFor("tags", "")}</textarea>
              <p class="help-hub-edit__hint">Comma- or newline-separated.</p>
            </div>
          </div>
        </section>

        <section
          class="admin-panel help-hub-dash__panel"
          aria-labelledby="lessons-json-preview-heading"
        >
          <h2 id="lessons-json-preview-heading" class="help-hub-dash__panel-title">
            JSON Preview
          </h2>
          <div class="help-hub-edit__json-preview">
            <div class="help-hub-edit__json-preview-actions">
              <button type="button" id="copyLessonJson" class="kbm-btn kbm-btn-outline">
                Copy JSON
              </button>
              <button type="button" id="previewLesson" class="kbm-btn kbm-btn-outline">
                Preview Lesson
              </button>
              <span id="copyLessonJsonStatus" class="help-hub-edit__copy-status" aria-live="polite"></span>
            </div>
            <div class="help-hub-edit__json-preview-actions">
              <button type="button" id="copyLessonCursorPrompt" class="kbm-btn kbm-btn-outline">
                Copy Cursor Save Prompt
              </button>
              <span id="copyLessonCursorStatus" class="help-hub-edit__copy-status" aria-live="polite"></span>
            </div>
            <pre id="lessonJsonPreview" class="help-hub-edit__json-pre"></pre>
          </div>
        </section>
      </div>
    </form>
  </main>

  <style>
    :global(body.help-hub-admin-body) {
      margin: 0;
    }

    .help-hub-admin {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 1.25rem 1.5rem 3rem;
      box-sizing: border-box;
    }

    .help-hub-admin__head {
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e2e8f0;
    }

    .help-hub-admin__title {
      margin: 0 0 0.35rem 0;
      font-size: 1.65rem;
      color: #243015;
    }

    .help-hub-admin__sub {
      margin: 0;
      font-size: 0.95rem;
      color: #475569;
      max-width: 56rem;
    }

    .help-hub-admin__toolbar {
      margin-bottom: 1.5rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem 1rem;
    }

    .admin-panel {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 1rem 1.1rem;
    }

    .help-hub-dash__sections {
      display: grid;
      gap: 1rem;
      grid-template-columns: 1fr;
    }

    .help-hub-edit__sections {
      max-width: 56rem;
    }

    .help-hub-dash__panel-title {
      margin: 0 0 0.65rem 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #243015;
    }

    .help-hub-edit__context {
      margin: 0.5rem 0 0 0;
      font-size: 0.85rem;
      color: #94a3b8;
      line-height: 1.4;
    }

    .help-hub-edit__form {
      margin: 0;
    }

    .help-hub-edit__fields {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .help-hub-edit__field {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .help-hub-edit__label {
      font-size: 0.8rem;
      font-weight: 600;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .help-hub-edit__input,
    .help-hub-edit__select,
    .help-hub-edit__textarea {
      font-size: 0.92rem;
      line-height: 1.45;
      color: #1e293b;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 0.45rem 0.55rem;
      background: #fff;
      box-sizing: border-box;
      width: 100%;
      font-family: inherit;
    }

    .help-hub-edit__textarea {
      resize: vertical;
      min-height: 2.5rem;
    }

    .help-hub-edit__select {
      max-width: 20rem;
    }

    .help-hub-edit__hint {
      margin: 0;
      font-size: 0.85rem;
      color: #94a3b8;
      line-height: 1.4;
    }

    .help-hub-edit__json-preview-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      margin-bottom: 0.5rem;
    }

    .help-hub-edit__json-preview-actions:last-of-type {
      margin-bottom: 0.65rem;
    }

    .help-hub-edit__copy-status {
      font-size: 0.85rem;
      color: #16a34a;
      min-height: 1.2em;
    }

    .help-hub-edit__copy-status--error {
      color: #b91c1c;
    }

    .help-hub-edit__json-preview-actions .kbm-btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .lesson-blocks-editor__list {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin-bottom: 0.85rem;
    }

    .lesson-blocks-editor__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 0.65rem;
    }

    .lesson-block-card {
      border: 1px solid #ccc;
      padding: 10px;
      margin-bottom: 20px;
      background: #fff;
    }

    .lesson-block-card:last-child {
      margin-bottom: 0;
    }

    .lesson-block-card__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 8px;
    }

    .lesson-block-card__label {
      font-size: 13px;
      font-weight: 600;
    }

    .lesson-block-card__body {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .lesson-block-card input,
    .lesson-block-card textarea {
      display: block;
      width: 100%;
    }

    .lesson-block-card textarea {
      min-height: 120px;
      line-height: 1.4;
    }

    .lesson-block-card__remove {
      font-size: 0.8rem;
      padding: 0.25rem 0.5rem;
      cursor: pointer;
    }

    .editor-hint {
      display: none !important;
    }

    .help-hub-edit__json-pre {
      margin: 0;
      padding: 0.75rem 0.85rem;
      font-size: 0.8rem;
      line-height: 1.45;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
        "Courier New", monospace;
      color: #1e293b;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      overflow: auto;
      max-height: min(70vh, 32rem);
      white-space: pre-wrap;
      word-break: break-word;
    }
  </style>

  <script is:inline>
    (function () {
      var FIELD_ORDER = [
        "title",
        "slug",
        "id",
        "status",
        "intro",
        "content",
        "mediaType",
        "mediaUrl",
        "thumbnailAlt",
        "relatedHelpHubs",
        "relatedLessons",
        "category",
        "tags",
      ];

      var MEDIA_TYPES = ["image", "vimeo", "youtube"];

      function trimmedFieldValue(form, name) {
        var el = form.elements.namedItem(name);
        if (!el) return "";
        if ("value" in el) return String(el.value).trim();
        return "";
      }

      function splitTags(text) {
        if (!text) return [];
        return text
          .split(/[\r\n,]+/)
          .map(function (s) {
            return s.trim();
          })
          .filter(Boolean);
      }

      function splitLines(text) {
        if (!text) return [];
        return text
          .split(/\r?\n/)
          .map(function (s) {
            return s.trim();
          })
          .filter(Boolean);
      }

      function normalizeMediaType(raw) {
        var t = String(raw || "").trim().toLowerCase();
        if (MEDIA_TYPES.indexOf(t) !== -1) return t;
        return "";
      }

      function parseLessonIdInput(s) {
        if (s === undefined || s === null) return null;
        var t = String(s).trim();
        if (t === "") return null;
        var n = parseInt(t, 10);
        if (!Number.isFinite(n) || n < 0) return null;
        return n;
      }

      function resolveLessonId(form) {
        var fromInput = parseLessonIdInput(trimmedFieldValue(form, "id"));
        if (fromInput !== null) return fromInput;
        var fromOrig = parseLessonIdInput(form.getAttribute("data-original-lesson-id") || "");
        if (fromOrig !== null) return fromOrig;
        var fromNext = parseLessonIdInput(form.getAttribute("data-next-lesson-id") || "");
        if (fromNext !== null) return fromNext;
        return 1;
      }

      function buildLessonObject(form) {
        var out = {};
        var i;
        var key;
        var v;
        var arr;
        var mt;

        for (i = 0; i < FIELD_ORDER.length; i++) {
          key = FIELD_ORDER[i];
          if (key === "id") {
            out.id = resolveLessonId(form);
            continue;
          }
          if (key === "tags") {
            arr = splitTags(trimmedFieldValue(form, "tags"));
            if (arr.length) out.tags = arr;
            continue;
          }
          if (key === "relatedHelpHubs") {
            arr = splitLines(trimmedFieldValue(form, "relatedHelpHubs"));
            if (arr.length) out.relatedHelpHubs = arr;
            continue;
          }
          if (key === "relatedLessons") {
            arr = splitLines(trimmedFieldValue(form, "relatedLessons"));
            if (arr.length) out.relatedLessons = arr;
            continue;
          }
          if (key === "mediaType") {
            mt = normalizeMediaType(trimmedFieldValue(form, "mediaType"));
            if (mt) out.mediaType = mt;
            continue;
          }
          v = trimmedFieldValue(form, key);
          if (v !== "") out[key] = v;
        }

        out.blocks = collectBlocksFromDom(form);
        return out;
      }

      function collectBlocksFromDom(form) {
        var list = form.querySelector("#lesson-blocks-list");
        if (!list) return [{ type: "text", content: "" }];
        var cards = list.querySelectorAll(".lesson-block-card");
        var out = [];
        var i;
        var card;
        var type;
        var ta;
        var titleIn;
        var idIn;
        for (i = 0; i < cards.length; i++) {
          card = cards[i];
          type = card.getAttribute("data-block-type");
          if (type === "text") {
            ta = card.querySelector('[data-field="content"]');
            out.push({ type: "text", content: ta ? String(ta.value) : "" });
          } else if (type === "vimeo") {
            titleIn = card.querySelector('[data-field="title"]');
            idIn = card.querySelector('[data-field="vimeoId"]');
            out.push({
              type: "vimeo",
              title: titleIn ? String(titleIn.value).trim() : "",
              vimeoId: idIn ? String(idIn.value).trim() : "",
            });
          }
        }
        if (!out.length) out.push({ type: "text", content: "" });
        return out;
      }

      function createBlockCard(block) {
        var wrap = document.createElement("div");
        wrap.className = "lesson-block-card lesson-card";
        var head = document.createElement("div");
        head.className = "lesson-block-card__head";
        var body = document.createElement("div");
        body.className = "lesson-block-card__body";
        var label = document.createElement("span");
        label.className = "lesson-block-card__label";
        var btnUp = document.createElement("button");
        btnUp.type = "button";
        btnUp.className = "btn-move-up";
        btnUp.textContent = "↑";
        var btnDown = document.createElement("button");
        btnDown.type = "button";
        btnDown.className = "btn-move-down";
        btnDown.textContent = "↓";
        var rm = document.createElement("button");
        rm.type = "button";
        rm.className = "lesson-block-card__remove";
        rm.setAttribute("data-action", "remove-lesson-block");
        rm.textContent = "Remove";
        head.appendChild(label);
        head.appendChild(btnUp);
        head.appendChild(btnDown);
        head.appendChild(rm);
        wrap.appendChild(head);
        wrap.appendChild(body);

        if (block && block.type === "vimeo") {
          wrap.setAttribute("data-block-type", "vimeo");
          label.textContent = "Vimeo block";
          var in1 = document.createElement("input");
          in1.className = "help-hub-edit__input";
          in1.type = "text";
          in1.setAttribute("data-field", "title");
          in1.setAttribute("aria-label", "Title");
          in1.value = block.title ? String(block.title) : "";
          var in2 = document.createElement("input");
          in2.className = "help-hub-edit__input";
          in2.type = "text";
          in2.setAttribute("data-field", "vimeoId");
          in2.setAttribute("aria-label", "Vimeo ID");
          in2.value = block.vimeoId ? String(block.vimeoId) : "";
          body.appendChild(in1);
          body.appendChild(in2);
        } else {
          wrap.setAttribute("data-block-type", "text");
          label.textContent = "Text block";
          var ta = document.createElement("textarea");
          ta.className = "help-hub-edit__textarea";
          ta.rows = 6;
          ta.setAttribute("data-field", "content");
          ta.value = block && block.content ? String(block.content) : "";
          body.appendChild(ta);
        }
        return wrap;
      }

      function parseInitialBlocksFromPage() {
        var initialEl = document.getElementById("lesson-editor-blocks-initial");
        var fallback = [{ type: "text", content: "" }];
        if (!initialEl || !initialEl.textContent) return fallback;
        try {
          var parsed = JSON.parse(initialEl.textContent);
          if (!Array.isArray(parsed) || !parsed.length) return fallback;
          return parsed;
        } catch (e) {
          return fallback;
        }
      }

      function initLessonBlocksEditor(form) {
        var list = document.getElementById("lesson-blocks-list");
        var addText = document.getElementById("lesson-blocks-add-text");
        var addVimeo = document.getElementById("lesson-blocks-add-vimeo");
        if (!list || !addText || !addVimeo) return;

        function blockCount() {
          return list.querySelectorAll(".lesson-block-card").length;
        }

        function appendBlock(block) {
          list.appendChild(createBlockCard(block));
        }

        var initial = parseInitialBlocksFromPage();
        var j;
        for (j = 0; j < initial.length; j++) {
          appendBlock(initial[j]);
        }

        addText.addEventListener("click", function () {
          appendBlock({ type: "text", content: "" });
          form.dispatchEvent(new Event("input", { bubbles: true }));
        });
        addVimeo.addEventListener("click", function () {
          appendBlock({ type: "vimeo", title: "", vimeoId: "" });
          form.dispatchEvent(new Event("input", { bubbles: true }));
        });

        list.addEventListener("click", function (ev) {
          var t = ev.target;
          if (!t || !t.closest) return;
          var card;
          if (t.classList && t.classList.contains("btn-move-up")) {
            ev.preventDefault();
            card = t.closest(".lesson-card");
            if (!card || card.parentNode !== list) return;
            var prev = card.previousElementSibling;
            if (!prev) return;
            list.insertBefore(card, prev);
            form.dispatchEvent(new Event("input", { bubbles: true }));
            return;
          }
          if (t.classList && t.classList.contains("btn-move-down")) {
            ev.preventDefault();
            card = t.closest(".lesson-card");
            if (!card || card.parentNode !== list) return;
            var next = card.nextElementSibling;
            if (!next) return;
            list.insertBefore(next, card);
            form.dispatchEvent(new Event("input", { bubbles: true }));
            return;
          }
          if (!t.getAttribute) return;
          if (t.getAttribute("data-action") !== "remove-lesson-block") return;
          ev.preventDefault();
          if (blockCount() <= 1) return;
          card = t.closest(".lesson-block-card");
          if (card && card.parentNode === list) {
            list.removeChild(card);
            form.dispatchEvent(new Event("input", { bubbles: true }));
          }
        });

      }

      var CURSOR_SAVE_PROMPT_PREFIX =
        "Update src/data/lessons.json.\n\n" +
        "Merge the lesson entry below into the existing entry by slug.\n\n" +
        "If the slug already exists, update only the fields included in ENTRY JSON and preserve any existing fields that are not included.\n" +
        "If the slug does not exist, add it as a new object.\n" +
        "Keep the JSON valid.\n" +
        "Preserve existing entries.\n" +
        "Do not modify any other files.\n\n" +
        "ENTRY JSON:\n";

      function sanitizeSlugValue(raw) {
        return String(raw)
          .toLowerCase()
          .replace(/\s+/g, "-")
          .replace(/[^a-z0-9-]/g, "");
      }

      function hasRequiredFields(form) {
        return (
          trimmedFieldValue(form, "title") !== "" &&
          trimmedFieldValue(form, "slug") !== "" &&
          trimmedFieldValue(form, "status") !== ""
        );
      }

      function init() {
        var form = document.querySelector(".lessons-edit__form");
        var pre = document.getElementById("lessonJsonPreview");
        var copyBtn = document.getElementById("copyLessonJson");
        var status = document.getElementById("copyLessonJsonStatus");
        var cursorBtn = document.getElementById("copyLessonCursorPrompt");
        var cursorStatus = document.getElementById("copyLessonCursorStatus");
        var previewBtn = document.getElementById("previewLesson");
        if (!form || !pre || !copyBtn || !status || !cursorBtn || !cursorStatus) return;

        initLessonBlocksEditor(form);

        var jsonCopyTimerHolder = { current: null };
        var cursorCopyTimerHolder = { current: null };

        function copyToClipboard(text, statusEl, timerHolder) {
          function showCopied() {
            statusEl.textContent = "Copied";
            if (timerHolder.current) clearTimeout(timerHolder.current);
            timerHolder.current = window.setTimeout(function () {
              statusEl.textContent = "";
              timerHolder.current = null;
            }, 2000);
          }

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(showCopied).catch(function () {
              statusEl.textContent = "";
            });
          } else {
            try {
              var ta = document.createElement("textarea");
              ta.value = text;
              ta.setAttribute("readonly", "");
              ta.style.position = "fixed";
              ta.style.left = "-9999px";
              document.body.appendChild(ta);
              ta.select();
              document.execCommand("copy");
              document.body.removeChild(ta);
              showCopied();
            } catch (e) {
              statusEl.textContent = "";
            }
          }
        }

        function updatePreview() {
          var obj = buildLessonObject(form);
          pre.textContent = JSON.stringify(obj, null, 2);
        }

        function updateCopyUi() {
          var ok = hasRequiredFields(form);
          copyBtn.disabled = !ok;
          cursorBtn.disabled = !ok;
          if (!ok) {
            status.textContent = "Missing required fields";
            cursorStatus.textContent = "Missing required fields";
            status.classList.add("help-hub-edit__copy-status--error");
            cursorStatus.classList.add("help-hub-edit__copy-status--error");
          } else {
            status.textContent = "";
            cursorStatus.textContent = "";
            status.classList.remove("help-hub-edit__copy-status--error");
            cursorStatus.classList.remove("help-hub-edit__copy-status--error");
          }
        }

        function onFormActivity(ev) {
          var t = ev.target;
          if (t && t.getAttribute && t.getAttribute("name") === "slug") {
            var before = t.value;
            var after = sanitizeSlugValue(before);
            if (after !== before) {
              t.value = after;
            }
          }
          updatePreview();
          updateCopyUi();
        }

        form.addEventListener("input", onFormActivity);
        form.addEventListener("change", onFormActivity);
        updatePreview();
        updateCopyUi();

        copyBtn.addEventListener("click", function () {
          if (!hasRequiredFields(form)) return;
          var text = JSON.stringify(buildLessonObject(form), null, 2);
          copyToClipboard(text, status, jsonCopyTimerHolder);
        });

        cursorBtn.addEventListener("click", function () {
          if (!hasRequiredFields(form)) return;
          var entryJson = JSON.stringify(buildLessonObject(form), null, 2);
          var promptText = CURSOR_SAVE_PROMPT_PREFIX + entryJson;
          copyToClipboard(promptText, cursorStatus, cursorCopyTimerHolder);
        });

        if (previewBtn) {
          previewBtn.addEventListener("click", function () {
            var obj = buildLessonObject(form);
            var data = btoa(JSON.stringify(obj));
            var url = "/lessons/preview?data=" + encodeURIComponent(data);
            window.open(url, "_blank", "noopener,noreferrer");
          });
        }
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>
</BaseLayout>
