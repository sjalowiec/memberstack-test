---
import BaseLayout from "../../layouts/BaseLayout.astro";
import categoriesData from "../../data/help-hub-categories.json";
import lessonsData from "../../data/lessons.json";

const lessonsList = Array.isArray(lessonsData) ? lessonsData : [];
const relatedLessonsSelectSize = Math.min(10, Math.max(4, lessonsList.length || 4));

const categoryOptions = Array.isArray(categoriesData)
  ? categoriesData
      .filter((c) => c && typeof c === "object")
      .map((c) => ({
        key: String((c as { key?: unknown }).key ?? "").trim(),
        label: String((c as { label?: unknown }).label ?? "").trim(),
      }))
      .filter((c) => c.key.length > 0)
  : [];
---

<BaseLayout
  title="Edit Help Hub Tip | Knit it Now"
  description="Create or edit a Help Hub tip"
  skipGlobalHyvor={true}
  bodyClass="tips-admin-body help-hub-admin-body"
>
  <main class="help-hub-admin">
    <header class="help-hub-admin__head">
      <h1 class="help-hub-admin__title">Help Hub Tip Editor</h1>
      <p class="help-hub-admin__sub">
        <a href="/admin/tips-admin">Back to tips list</a>
      </p>
    </header>

    <p id="help-hub-admin-status" class="help-hub-admin__status" aria-live="polite"></p>
    <div class="help-hub-admin__edit-layout">
      <section class="admin-panel help-hub-admin__form-panel help-hub-admin__edit-col help-hub-admin__edit-col--form" aria-labelledby="form-heading">
      <h2 id="form-heading">Edit tip</h2>
      <p id="help-hub-admin-mode" class="help-hub-admin__mode">Loading...</p>
      <form id="help-hub-admin-form" class="help-hub-admin__form" autocomplete="off">
        <div class="field-grid">
          <label><span>id (read-only)</span><input type="text" id="field-id" name="idDisplay" readonly disabled placeholder="(assigned on save)" /></label>
          <label class="field-full"><span>Title <em class="req">*</em></span><input type="text" name="title" id="field-title" required /></label>
          <label class="field-full"><span>Slug <em class="req">*</em></span><input type="text" name="slug" id="field-slug" required /><span class="field-hint">Lowercase, hyphens. Auto-filled from title on new until you edit slug.</span></label>
          <label class="field-full"><span>Meta Title</span><input type="text" name="metaTitle" id="field-metaTitle" placeholder="Short title for search results" /></label>
          <label class="field-full"><span>Meta Description</span><textarea name="metaDescription" id="field-metaDescription" rows="2" placeholder="1-2 sentence summary of the tip"></textarea></label>

          <label class="checkbox-label field-full"><input type="checkbox" name="allMachines" id="field-allMachines" /><span>All Machines</span></label>
          <label class="field-full"><span>Applies To</span><input type="text" name="appliesTo" id="field-appliesTo" placeholder="Brother KH-series, Silver Reed, LK150" /><span class="field-hint">Comma-separated list of machine names.</span></label>

          <label class="field-full"><span>Hook</span><input type="text" name="hook" id="field-hook" /></label>
          <label class="field-full"><span>Question</span><textarea name="question" id="field-question" rows="2"></textarea></label>
          <label class="field-full"><span>Bubble Answer</span><textarea name="bubbleAnswer" id="field-bubbleAnswer" rows="3"></textarea></label>

          <label class="field-full"><span>Media URL (Vimeo or Image)</span><input type="text" name="mediaUrl" id="field-mediaUrl" placeholder="/images/help-hub/example.webp or videos/123" /></label>
          <label class="field-full"><span>mediaType</span><input type="text" name="mediaType" id="field-mediaType" placeholder="vimeo, video, image" /></label>
          <label class="field-full"><span>Media alt</span><input type="text" name="mediaAlt" id="field-mediaAlt" /></label>

          <fieldset class="field-full help-hub-admin__about-fieldset">
            <legend class="help-hub-admin__about-legend">What's this about</legend>
            <div class="help-hub-admin__about-fieldset-inner">
              <label class="field-full"><span>What's this about title</span><input type="text" name="aboutTitle" id="field-aboutTitle" /></label>
              <label class="field-full"><span>What's this about text</span><textarea name="bridge" id="field-bridge" rows="3"></textarea></label>
            </div>
          </fieldset>

          <label><span>Try This title</span><input type="text" name="tryThisTitle" id="field-tryThisTitle" /></label>
          <label><span>Try This subtitle</span><input type="text" name="quickActionTitle" id="field-quickActionTitle" /></label>
          <label class="field-full">
            <span>Try This quick action</span>
            <textarea name="quickAction" id="field-quickAction" rows="5"></textarea>
            <span class="field-hint">One per line; saved as tryThis.quickAction.</span>
          </label>
          <label class="field-full">
            <span>Try This note</span>
            <textarea name="quickActionNote" id="field-quickActionNote" rows="4" placeholder="Optional note below the checklist"></textarea>
            <span class="field-hint">Shown below the Try This checklist on the public tip page. HTML allowed.</span>
          </label>

          <div class="field-full help-hub-admin__related-lessons">
            <label for="relatedLessons" class="help-hub-admin__related-lessons-label">
              <span>Lesson selection</span>
            </label>
            <p class="help-hub-admin__related-lessons-help">
              Select one or more lessons to display with this tip.
            </p>
            <select
              multiple
              id="relatedLessons"
              name="relatedLessons"
              class="help-hub-admin__related-lessons-select"
              size={relatedLessonsSelectSize}
            >
              {lessonsList.map((lesson: { id?: unknown; slug?: string }) => {
                const slug = typeof lesson.slug === "string" ? lesson.slug.trim() : "";
                if (!slug) return null;
                const idStr =
                  typeof lesson.id === "number" && Number.isFinite(lesson.id)
                    ? String(Math.trunc(lesson.id))
                    : typeof lesson.id === "string" && lesson.id.trim() !== ""
                      ? lesson.id.trim()
                      : "?";
                return (
                  <option value={slug}>
                    [{idStr}] {slug}
                  </option>
                );
              })}
            </select>
            <span class="field-hint">
              Hold Ctrl (Windows) or ⌘ (Mac) to select multiple, or remove items below.
            </span>
            <p class="help-hub-admin__related-lessons-chosen-heading">Selected lessons</p>
            <ul
              id="relatedLessons-chosen"
              class="help-hub-admin__related-lessons-chosen"
              aria-label="Selected related lessons"
            ></ul>
          </div>

          <label class="checkbox-label field-full help-hub-admin__active-toggle">
            <input type="checkbox" name="tipActive" id="field-tipActive" />
            <span>Active on Help Hub</span>
          </label>
          <p class="field-hint field-full help-hub-admin__active-hint">
            New tips start inactive (<code>draft</code>) until you check this. Checked = live (<code>published</code>); unchecked = hidden (<code>draft</code>).
          </p>
          <label><span>sortOrder</span><input type="number" name="sortOrder" id="field-sortOrder" step="1" /></label>
          <label class="checkbox-label"><input type="checkbox" name="isNew" id="field-isNew" /><span>isNew</span></label>
          <label class="checkbox-label"><input type="checkbox" name="featured" id="field-featured" /><span>featured</span></label>
          <label><span>category <em class="req">*</em></span><select name="category" id="field-category" required><option value="">Select a category</option>{categoryOptions.map((opt) => (<option value={opt.key}>{opt.label || opt.key}</option>))}</select></label>
          <label><span>categoryPill</span><input type="text" name="categoryPill" id="field-categoryPill" /></label>
  <!--<label><span>memberHeading</span><input type="text" name="memberHeading" id="field-memberHeading" /></label>
          <label class="field-full"><span>memberText</span><textarea name="memberText" id="field-memberText" rows="2"></textarea></label>
        -->  <!--<label class="field-full"><span>trySteps (one per line)</span><textarea name="trySteps" id="field-trySteps" rows="4"></textarea></label> -->
          <!-- <label class="field-full"><span>proExercise (one per line) → tryThis.proExercise</span><textarea name="proExercise" id="field-proExercise" rows="4"></textarea></label>
          <label class="field-full"><span>proExercise (one per line) → tryThis.proExercise</span><textarea name="proExercise" id="field-proExercise" rows="4"></textarea></label>-->
        </div>
        <div class="help-hub-admin__form-actions help-hub-admin__form-actions--sticky">
          <button type="button" id="btn-save-tip" class="kbm-btn kbm-btn-primary">Save</button>
          <button type="button" id="btn-cancel-edit" class="kbm-btn kbm-btn-outline">Cancel edit</button>
          <button type="button" id="btn-delete-tip" class="kbm-btn kbm-btn-accent">Delete</button>
          <button type="button" id="btn-refresh-tip-preview" class="kbm-btn kbm-btn-outline">Refresh Preview</button>
        </div>
      </form>
      <div class="help-hub-admin__preview-wrap">
        <div class="help-hub-admin__preview-head">
          <h3 class="help-hub-admin__preview-title">Current record (preview)</h3>
          <button type="button" id="btn-refresh-preview" class="kbm-btn kbm-btn-outline">Refresh JSON preview</button>
        </div>
        <pre id="help-hub-json-preview" class="help-hub-admin__preview" aria-live="polite"></pre>
      </div>
      </section>
      <section class="admin-panel help-hub-admin__tip-preview-panel help-hub-admin__edit-col help-hub-admin__edit-col--preview" aria-labelledby="tip-preview-heading">
        <div class="help-hub-admin__tip-preview-sticky">
          <h2 id="tip-preview-heading" class="help-hub-admin__tip-preview-heading">Tip Preview</h2>
          <p class="help-hub-admin__tip-preview-open-row">
            <a
              id="help-hub-tip-preview-open"
              class="help-hub-admin__tip-preview-open-link"
              href="about:blank"
              target="_blank"
              rel="noopener noreferrer"
              aria-disabled="true"
            >Open Preview</a>
          </p>
          <p id="help-hub-tip-preview-no-slug" class="help-hub-admin__tip-preview-placeholder">
            Add a slug to preview this tip.
          </p>
          <div id="help-hub-tip-preview-frame-shell" class="help-hub-admin__tip-preview-frame-shell" hidden>
            <iframe
              id="help-hub-tip-preview-frame"
              class="help-hub-admin__tip-preview-frame"
              title="Help Hub tip public page preview"
              src="about:blank"
            ></iframe>
          </div>
        </div>
      </section>
    </div>
  </main>

  <style>
    :global(body.help-hub-admin-body) { margin: 0; }
    .help-hub-admin { width: 100%; max-width: none; margin: 0; padding: 1rem 1.25rem 2rem; box-sizing: border-box; }
    .help-hub-admin__edit-layout { display: flex; flex-direction: column; gap: 1rem; align-items: stretch; }
    @media (min-width: 1024px) {
      .help-hub-admin__edit-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
      }
      /* Preview column fills row height so position:sticky has room while the form scrolls */
      .help-hub-admin__edit-col--preview {
        align-self: stretch;
        display: flex;
        flex-direction: column;
        min-height: 0;
      }
      /* Single 0.85rem inset like the form panel — padding lives on sticky, not doubled */
      .help-hub-admin__tip-preview-panel {
        padding: 0;
      }
      .help-hub-admin__tip-preview-sticky {
        position: sticky;
        top: 20px;
        z-index: 2;
        box-sizing: border-box;
        padding: 0.85rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      }
    }
    .help-hub-admin__edit-col { min-width: 0; }
    .help-hub-admin__head { margin-bottom: 0.75rem; padding-bottom: 0.75rem; border-bottom: 1px solid #e2e8f0; }
    .help-hub-admin__title { margin: 0 0 0.35rem 0; font-size: 1.65rem; color: #243015; }
    .help-hub-admin__sub { margin: 0; font-size: 0.95rem; }
    .help-hub-admin__status { min-height: 1.4em; margin: 0 0 0.75rem 0; font-size: 0.95rem; color: #374151; }
    .help-hub-admin__status.is-error { color: #b91c1c; font-weight: 600; }
    .help-hub-admin__status.is-ok { color: #166534; }
    .admin-panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 0.85rem; }
    .help-hub-admin__mode { margin: 0 0 0.75rem 0; padding: 0.5rem 0.65rem; border-radius: 8px; background: #f1f5f9; border: 1px solid #e2e8f0; font-weight: 600; color: #243015; font-size: 0.95rem; }
    .help-hub-admin__form .field-grid { display: grid; grid-template-columns: 1fr; gap: 0.65rem; }
    @media (min-width: 720px) { .help-hub-admin__form .field-grid { grid-template-columns: 1fr 1fr; } }
    .field-full { grid-column: 1 / -1; }
    .help-hub-admin__about-fieldset {
      margin: 0;
      padding: 0.55rem 0.75rem 0.75rem;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      background: #fafafa;
      box-sizing: border-box;
      min-width: 0;
    }
    .help-hub-admin__about-legend {
      padding: 0 0.35rem;
      font-size: 0.95rem;
      font-weight: 600;
      color: #2e3a18;
    }
    .help-hub-admin__about-fieldset-inner {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      margin-top: 0.25rem;
    }
    .help-hub-admin__form label { display: flex; flex-direction: column; gap: 0.35rem; }
    .help-hub-admin__form label > span { font-size: 0.95rem; font-weight: 600; color: #2e3a18; }
    .req { color: #b91c1c; font-style: normal; }
    .field-hint { font-size: 0.82rem; font-weight: 400; color: #64748b; line-height: 1.45; }
    .help-hub-admin__form input, .help-hub-admin__form select, .help-hub-admin__form textarea { width: 100%; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.55rem 0.65rem; font: inherit; color: #111827; background: #fff; box-sizing: border-box; }
    .help-hub-admin__form input:disabled { background: #f1f5f9; color: #64748b; }
    .help-hub-admin__form textarea { resize: vertical; min-height: 72px; }
    .checkbox-label { flex-direction: row !important; align-items: center; gap: 0.5rem !important; margin-top: 0.25rem; }
    .checkbox-label input { width: auto !important; margin: 0; }
    .help-hub-admin__active-hint { margin: -0.35rem 0 0 0; }
    .help-hub-admin__form-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.1rem; }
    .help-hub-admin__form-actions--sticky { position: sticky; bottom: 0; z-index: 8; padding: 0.6rem 0; margin-top: 1rem; background: linear-gradient(to top, #fff 78%, rgba(255, 255, 255, 0)); border-top: 1px solid #e5e7eb; }
    .help-hub-admin__preview-wrap { margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid #e5e7eb; }
    .help-hub-admin__preview-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem; margin-bottom: 0.5rem; }
    .help-hub-admin__preview-title { margin: 0; font-size: 1rem; color: #243015; }
    .help-hub-admin__preview { margin: 0; padding: 0.85rem; border-radius: 8px; background: #0f172a; color: #e2e8f0; overflow: auto; font-size: 0.78rem; line-height: 1.45; max-height: 320px; }
    .help-hub-admin__tip-preview-panel { padding: 0.85rem; }
    .help-hub-admin__tip-preview-sticky { display: flex; flex-direction: column; gap: 0.65rem; min-width: 0; }
    .help-hub-admin__tip-preview-heading { margin: 0; font-size: 1.1rem; color: #243015; }
    .help-hub-admin__tip-preview-open-row { margin: 0; font-size: 0.9rem; }
    .help-hub-admin__tip-preview-open-link {
      color: #2563eb; font-weight: 600; text-decoration: underline; text-underline-offset: 2px;
    }
    .help-hub-admin__tip-preview-open-link[aria-disabled="true"] {
      color: #94a3b8; pointer-events: none; text-decoration: none; cursor: default;
    }
    .help-hub-admin__tip-preview-placeholder {
      margin: 0; padding: 1rem 1.1rem; border-radius: 8px; border: 1px dashed #cbd5e1; background: #f8fafc; color: #475569; font-size: 0.95rem; line-height: 1.5;
    }
    .help-hub-admin__tip-preview-frame-shell {
      width: 100%;
      box-sizing: border-box;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
    }
    .help-hub-admin__tip-preview-frame {
      display: block;
      width: 100%;
      height: calc(100vh - 120px);
      min-height: 280px;
      border: 0;
      background: #fff;
    }
    .help-hub-admin__related-lessons-label span { font-size: 0.95rem; font-weight: 600; color: #2e3a18; }
    .help-hub-admin__related-lessons-help { margin: 0 0 0.4rem 0; font-size: 0.9rem; line-height: 1.45; color: #475569; }
    .help-hub-admin__related-lessons-select { min-height: 6.5rem; }
    .help-hub-admin__related-lessons-chosen-heading { margin: 0.65rem 0 0.35rem 0; font-size: 0.9rem; font-weight: 600; color: #2e3a18; }
    .help-hub-admin__related-lessons-chosen { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
    .help-hub-admin__related-lessons-chosen li {
      display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
      padding: 0.45rem 0.55rem; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; font-size: 0.9rem; color: #1e293b;
    }
    .help-hub-admin__related-lessons-chosen li span { flex: 1; min-width: 0; }
    .help-hub-admin__related-lessons-chosen .kbm-btn { flex-shrink: 0; padding: 0.35rem 0.55rem; font-size: 0.82rem; }
    .help-hub-admin__related-lessons-chosen li.help-hub-admin__related-lessons-empty {
      justify-content: flex-start; border-style: dashed; color: #64748b; font-size: 0.88rem; font-weight: 400;
    }
  </style>

  <script>
    const API_BASE = "/api/admin/help-hub";
    type TipRow = Record<string, any>;
    let editingId: number | null = null;
    let baseline: TipRow | null = null;
    let slugManual = false;
    let tips: TipRow[] = [];
    const params = new URLSearchParams(window.location.search);
    const rawSlug = params.get("slug");
    const loadSlug = rawSlug !== null && rawSlug.trim() !== "" ? rawSlug.trim() : null;
    const rawId = params.get("id");
    if (rawId && /^\d+$/.test(rawId)) editingId = parseInt(rawId, 10);
    /** True when the URL means “edit existing” (slug and/or numeric id param), even before fetch finishes. */
    const urlRequestsEdit = loadSlug !== null || (rawId !== null && /^\d+$/.test(rawId));

    const statusEl = document.getElementById("help-hub-admin-status");
    const modeEl = document.getElementById("help-hub-admin-mode");
    const previewEl = document.getElementById("help-hub-json-preview");
    const form = document.getElementById("help-hub-admin-form") as HTMLFormElement | null;
    const fieldId = document.getElementById("field-id") as HTMLInputElement | null;
    const tipPreviewIframe = document.getElementById("help-hub-tip-preview-frame") as HTMLIFrameElement | null;
    const tipPreviewShell = document.getElementById("help-hub-tip-preview-frame-shell");
    const tipPreviewNoSlugEl = document.getElementById("help-hub-tip-preview-no-slug");
    const tipPreviewOpenLink = document.getElementById("help-hub-tip-preview-open") as HTMLAnchorElement | null;
    /** Slug segment last assigned to the iframe `src` (valid slug only). */
    let loadedPublicPreviewSlug: string | null = null;
    let tipPreviewDebounce: ReturnType<typeof setTimeout> | null = null;
    const TIP_PREVIEW_DEBOUNCE_MS = 450;
    /** Fields that should trigger a debounced public-page iframe reload (server JSON; save to see unsaved edits). */
    const TIP_PREVIEW_RELOAD_FIELD_IDS = new Set([
      "field-title",
      "field-slug",
      "field-tipActive",
      "field-question",
      "field-hook",
      "field-bubbleAnswer",
      "field-mediaUrl",
      "field-mediaType",
      "field-mediaAlt",
      "field-tryThisTitle",
      "field-quickActionTitle",
      "field-quickAction",
      "field-quickActionNote",
    ]);

    /** Raw slug from the form (trimmed); may be invalid for URLs. */
    function getPreviewSlugRaw(): string {
      const slugEl = document.getElementById("field-slug") as HTMLInputElement | null;
      return String(slugEl?.value ?? "").trim();
    }
    /** True when non-empty and safe as a single URL path segment under `/help-hub/`. */
    function isValidPublicTipSlug(s: string): boolean {
      if (!s) return false;
      if (s === "." || s === "..") return false;
      if (/[/\\?#\s]/.test(s)) return false;
      return true;
    }
    function getValidPreviewSlug(): string | null {
      const s = getPreviewSlugRaw();
      return isValidPublicTipSlug(s) ? s : null;
    }
    /** Public tip URL with preview (no cache-buster — for “Open Preview” link). */
    function tipPreviewPublicAbsoluteUrl(slug: string): string {
      const path = `/help-hub/${encodeURIComponent(slug)}?preview=true`;
      return new URL(path, window.location.origin).href;
    }
    /** Iframe URL: same as public preview plus `_` cache-buster so reloads always fetch fresh HTML. */
    function tipPreviewIframeUrl(slug: string): string {
      const u = new URL(`/help-hub/${encodeURIComponent(slug)}`, window.location.origin);
      u.searchParams.set("preview", "true");
      u.searchParams.set("_", String(Date.now()));
      return u.href;
    }
    function setTipPreviewOpenLink(slug: string | null): void {
      const a = tipPreviewOpenLink;
      if (!a) return;
      if (!slug) {
        a.href = "about:blank";
        a.setAttribute("aria-disabled", "true");
        return;
      }
      a.href = tipPreviewPublicAbsoluteUrl(slug);
      a.removeAttribute("aria-disabled");
    }
    function syncPublicTipPreview(): void {
      const slug = getValidPreviewSlug();
      setTipPreviewOpenLink(slug);
      if (!tipPreviewNoSlugEl || !tipPreviewShell) return;
      if (!slug) {
        tipPreviewNoSlugEl.hidden = false;
        tipPreviewShell.hidden = true;
        return;
      }
      tipPreviewNoSlugEl.hidden = true;
      tipPreviewShell.hidden = false;
    }
    function clearTipPreviewToBlank(): void {
      loadedPublicPreviewSlug = null;
      if (tipPreviewIframe) tipPreviewIframe.src = "about:blank";
      syncPublicTipPreview();
    }
    function scheduleDebouncedPublicTipPreviewReload(): void {
      if (tipPreviewDebounce !== null) clearTimeout(tipPreviewDebounce);
      tipPreviewDebounce = setTimeout(() => {
        tipPreviewDebounce = null;
        reloadPublicTipPreview();
      }, TIP_PREVIEW_DEBOUNCE_MS);
    }
    function shouldSchedulePreviewReloadFromEventTarget(t: EventTarget | null): boolean {
      if (!(t instanceof HTMLElement)) return false;
      if (t.id && TIP_PREVIEW_RELOAD_FIELD_IDS.has(t.id)) return true;
      if (t.id === "relatedLessons") return true;
      return false;
    }
    function reloadPublicTipPreview(): void {
      const slug = getValidPreviewSlug();
      if (!tipPreviewIframe) {
        syncPublicTipPreview();
        return;
      }
      if (!slug) {
        clearTipPreviewToBlank();
        return;
      }
      tipPreviewIframe.src = tipPreviewIframeUrl(slug);
      loadedPublicPreviewSlug = slug;
      syncPublicTipPreview();
    }
    function applyPublicTipPreviewAfterLoad(): void {
      loadedPublicPreviewSlug = null;
      if (tipPreviewIframe) tipPreviewIframe.src = "about:blank";
      reloadPublicTipPreview();
    }

    function setStatus(message: string, kind: "ok" | "err" | "neutral" = "neutral") {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.toggle("is-error", kind === "err");
      statusEl.classList.toggle("is-ok", kind === "ok");
    }
    function updateSaveButtonState() {
      const btn = document.getElementById("btn-save-tip");
      if (!(btn instanceof HTMLButtonElement)) return;
      if (urlRequestsEdit) {
        const waiting = baseline === null || editingId === null;
        btn.disabled = waiting;
        btn.title = waiting ? "Loading tip — Save is enabled after the record loads." : "";
      } else {
        btn.disabled = false;
        btn.title = "";
      }
    }
    function getTipId(row: TipRow) { const v = row?.id; const n = parseInt(String(v ?? ""), 10); return Number.isFinite(n) ? n : null; }
    function slugifyTitle(raw: string) { const s = raw.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 96); return s || "help-hub-tip"; }
    function linesFromTextarea(name: string) { const el = form?.elements?.namedItem(name); if (!(el instanceof HTMLTextAreaElement)) return []; return el.value.split(/\r?\n/).map((l) => l.trim()).filter(Boolean); }
    /** tryThis.quickActionNote: exact textarea value, no trim (HTML preserved). */
    function rawQuickActionNote(): string {
      const el = form?.elements?.namedItem("quickActionNote");
      return el instanceof HTMLTextAreaElement ? el.value : "";
    }
    function textVal(name: string) {
      if (name === "bridge") {
        const byId = document.getElementById("field-bridge");
        if (byId instanceof HTMLTextAreaElement) return byId.value.trim();
      }
      const el = form?.elements?.namedItem(name);
      return el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement ? el.value.trim() : "";
    }
    function checked(name: string) { const el = form?.elements?.namedItem(name); return el instanceof HTMLInputElement && el.type === "checkbox" ? el.checked : false; }
    function setField(name: string, value: string) {
      if (name === "bridge") {
        const byId = document.getElementById("field-bridge");
        if (byId instanceof HTMLTextAreaElement) {
          byId.value = value;
          return;
        }
      }
      const el = form?.elements?.namedItem(name);
      if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) el.value = value;
    }
    function setChecked(name: string, value: boolean) { const el = form?.elements?.namedItem(name); if (el instanceof HTMLInputElement && el.type === "checkbox") el.checked = value; }
    function linesToText(lines: unknown) { return Array.isArray(lines) ? lines.map((x: unknown) => String(x)).join("\n") : ""; }
    function deepClone<T>(x: T): T { return JSON.parse(JSON.stringify(x)) as T; }
    function parseCommaList(raw: string) {
      return raw.split(",").map((item) => item.trim()).filter((item) => item.length > 0);
    }

    function relatedLessonsFromSelect(): string[] {
      const el = document.getElementById("relatedLessons");
      if (!(el instanceof HTMLSelectElement)) return [];
      const seen = new Set<string>();
      const out: string[] = [];
      for (const opt of Array.from(el.selectedOptions)) {
        const v = opt.value.trim();
        if (v.length > 0 && !seen.has(v)) {
          seen.add(v);
          out.push(v);
        }
      }
      return out;
    }

    function setRelatedLessonsSelection(slugs: string[]): void {
      const el = document.getElementById("relatedLessons");
      if (!(el instanceof HTMLSelectElement)) return;
      const seen = new Set<string>();
      const uniq: string[] = [];
      for (const s of slugs.map((s) => s.trim()).filter(Boolean)) {
        if (!seen.has(s)) {
          seen.add(s);
          uniq.push(s);
        }
      }
      const set = new Set(uniq);
      for (let i = 0; i < el.options.length; i++) {
        const opt = el.options[i];
        opt.selected = set.has(opt.value);
      }
    }

    function lessonLabelForSlug(slug: string): string {
      const el = document.getElementById("relatedLessons");
      if (!(el instanceof HTMLSelectElement)) return slug;
      const opt = Array.from(el.options).find((o) => o.value === slug);
      return opt?.textContent?.trim() || slug;
    }

    function renderRelatedLessonsChosenList(): void {
      const ul = document.getElementById("relatedLessons-chosen");
      if (!ul) return;
      ul.replaceChildren();
      const slugs = relatedLessonsFromSelect();
      if (slugs.length === 0) {
        const li = document.createElement("li");
        li.className = "help-hub-admin__related-lessons-empty";
        li.textContent = "None selected.";
        ul.appendChild(li);
        return;
      }
      for (const slug of slugs) {
        const li = document.createElement("li");
        const span = document.createElement("span");
        span.textContent = lessonLabelForSlug(slug);
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "kbm-btn kbm-btn-outline";
        btn.textContent = "Remove";
        btn.setAttribute("aria-label", `Remove related lesson ${slug}`);
        btn.addEventListener("click", () => {
          const next = relatedLessonsFromSelect().filter((s) => s !== slug);
          setRelatedLessonsSelection(next);
          renderRelatedLessonsChosenList();
          refreshPreview();
          scheduleDebouncedPublicTipPreviewReload();
        });
        li.appendChild(span);
        li.appendChild(btn);
        ul.appendChild(li);
      }
    }

    function buildRow() {
      const base = baseline ? deepClone(baseline) : {};
      delete base.status;
      const tryThisPrev = base.tryThis && typeof base.tryThis === "object" && !Array.isArray(base.tryThis) ? base.tryThis : {};
      const sortRaw = textVal("sortOrder");
      const sortOrder = sortRaw === "" ? undefined : parseInt(sortRaw, 10);
      const tryThisOut: Record<string, unknown> = {
        ...tryThisPrev,
        quickActionTitle: textVal("quickActionTitle"),
        quickAction: linesFromTextarea("quickAction"),
      };
      delete tryThisOut.proExerciseTitle;
      delete tryThisOut.proExercise;
      const quickActionNoteRaw = rawQuickActionNote();
      if (quickActionNoteRaw === "") delete tryThisOut.quickActionNote;
      else tryThisOut.quickActionNote = quickActionNoteRaw;
      const row: TipRow = {
        ...base, title: textVal("title"), slug: textVal("slug"), featured: checked("featured"),
        metaTitle: textVal("metaTitle"),
        metaDescription: textVal("metaDescription"),
        appliesTo: parseCommaList(textVal("appliesTo")),
        allMachines: checked("allMachines"),
        category: textVal("category"), categoryPill: textVal("categoryPill"), question: textVal("question"), bubbleAnswer: textVal("bubbleAnswer"),
        hook: textVal("hook"), mediaType: textVal("mediaType"), mediaUrl: textVal("mediaUrl"), mediaAlt: textVal("mediaAlt"),
        aboutTitle: textVal("aboutTitle"), bridge: textVal("bridge"), tryThisTitle: textVal("tryThisTitle"), memberHeading: textVal("memberHeading"), memberText: textVal("memberText"),
        isNew: checked("isNew"),
        tryThis: tryThisOut,
        relatedLessons: relatedLessonsFromSelect(),
      };
      delete row.lessonCta;
      delete row.relatedLessonId;
      delete row.relatedLesson;
      delete row.lessonIDs;
      delete row.readyToPublish;
      const trySteps = linesFromTextarea("trySteps");
      if (trySteps.length) row.trySteps = trySteps; else delete row.trySteps;
      if (Number.isFinite(sortOrder)) row.sortOrder = sortOrder; else if (sortRaw === "") delete row.sortOrder;
      if (editingId !== null) row.id = editingId;
      row.status = checked("tipActive") ? "published" : "draft";
      return row;
    }

    function refreshPreview() { if (previewEl) previewEl.textContent = JSON.stringify(buildRow(), null, 2); }
    function loadRowToForm(row: TipRow) {
      baseline = deepClone(row);
      const id = getTipId(row);
      if (id !== null) editingId = id;
      if (fieldId) { fieldId.value = id !== null ? String(id) : ""; fieldId.placeholder = id !== null ? String(id) : "(assigned on save)"; }
      setField("title", String(row.title ?? ""));
      setField("slug", String(row.slug ?? ""));
      {
        const statusStr = typeof row.status === "string" ? row.status.trim() : "";
        const stLower = statusStr.toLowerCase();
        setChecked("tipActive", statusStr === "" || stLower === "published");
      }
      setChecked("featured", row.featured === true);
      setField("metaTitle", String(row.metaTitle ?? ""));
      setField("metaDescription", String(row.metaDescription ?? ""));
      setField("category", String(row.category ?? "")); setField("categoryPill", String(row.categoryPill ?? "")); setField("question", String(row.question ?? "")); setField("bubbleAnswer", String(row.bubbleAnswer ?? ""));
      setField("hook", String(row.hook ?? "")); setField("mediaType", String(row.mediaType ?? "")); setField("mediaUrl", String(row.mediaUrl ?? ""));
      setField("mediaAlt", String(row.mediaAlt ?? "")); setField("aboutTitle", String(row.aboutTitle ?? "")); setField("bridge", String(row.bridge ?? "")); setField("tryThisTitle", String(row.tryThisTitle ?? ""));
      const tt = row.tryThis && typeof row.tryThis === "object" && !Array.isArray(row.tryThis) ? row.tryThis : {};
      setField("quickActionTitle", String(tt.quickActionTitle ?? "")); setField("quickAction", linesToText(tt.quickAction));
      setField("quickActionNote", typeof tt.quickActionNote === "string" ? tt.quickActionNote : "");
      setField("memberHeading", String(row.memberHeading ?? "")); setField("memberText", String(row.memberText ?? ""));
      setChecked("allMachines", row.allMachines === true);
      setField("appliesTo", Array.isArray(row.appliesTo) ? row.appliesTo.map((v: unknown) => String(v).trim()).filter(Boolean).join(", ") : "");
      const relRaw = Array.isArray(row.relatedLessons) && row.relatedLessons.length > 0
        ? row.relatedLessons.map((s: unknown) => String(s).trim()).filter(Boolean)
        : typeof (row as { relatedLesson?: string }).relatedLesson === "string" && (row as { relatedLesson?: string }).relatedLesson!.trim()
          ? [(row as { relatedLesson?: string }).relatedLesson!.trim()]
          : [];
      const rel = [...new Set(relRaw)];
      setRelatedLessonsSelection(rel);
      renderRelatedLessonsChosenList();
      setField("sortOrder", row.sortOrder !== undefined && row.sortOrder !== null ? String(row.sortOrder) : "");
      setChecked("isNew", row.isNew === true); setField("trySteps", linesToText(row.trySteps));
      slugManual = true; refreshPreview();
      applyPublicTipPreviewAfterLoad();
      updateSaveButtonState();
    }
    function clearFormNew() {
      editingId = null; baseline = null; slugManual = false;
      if (fieldId) { fieldId.value = ""; fieldId.placeholder = "(assigned on save)"; }
      ["title","metaTitle","metaDescription","slug","category","categoryPill","question","bubbleAnswer","hook","mediaType","mediaUrl","mediaAlt","aboutTitle","bridge","tryThisTitle","quickActionTitle","quickAction","quickActionNote","memberHeading","memberText","appliesTo","sortOrder","trySteps"].forEach((n) => setField(n, ""));
      setChecked("allMachines", true);
      setRelatedLessonsSelection([]);
      renderRelatedLessonsChosenList();
      const tipActiveEl = document.getElementById("field-tipActive");
      if (tipActiveEl instanceof HTMLInputElement) tipActiveEl.checked = false;
      setChecked("featured", false); setChecked("isNew", false);
      if (modeEl) modeEl.textContent = "New tip — slug will follow title until you edit slug";
      refreshPreview();
      applyPublicTipPreviewAfterLoad();
      updateSaveButtonState();
    }

    async function fetchTips() {
      try {
        const res = await fetch(API_BASE);
        const data = await res.json();
        if (!res.ok || !data?.ok || !Array.isArray(data.tips)) {
          setStatus(data?.error || `Failed to load (${res.status})`, "err");
          return;
        }
        tips = data.tips;

        if (loadSlug) {
          const row = tips.find((t) => typeof t.slug === "string" && t.slug.trim() === loadSlug);
          if (!row) {
            setStatus(`No tip with slug "${loadSlug}".`, "err");
            clearFormNew();
            return;
          }
          loadRowToForm(row);
          if (modeEl) modeEl.textContent = `Editing: ${loadSlug}`;
          setStatus(`Loaded tip "${loadSlug}".`, "ok");
          return;
        }

        if (editingId !== null) {
          const row = tips.find((t) => getTipId(t) === editingId);
          if (!row) {
            setStatus(`Tip id ${editingId} not found.`, "err");
            clearFormNew();
            return;
          }
          loadRowToForm(row);
          if (modeEl) modeEl.textContent = `Editing tip id ${editingId}`;
          setStatus(`Loaded tip id ${editingId}.`, "ok");
          return;
        }

        clearFormNew();
        setStatus("New tip — fill the form and save.", "neutral");
      } catch {
        setStatus("Network error loading tips.", "err");
      } finally {
        updateSaveButtonState();
      }
    }

    async function saveTip() {
      if (urlRequestsEdit) {
        if (baseline === null || editingId === null) {
          setStatus("Still loading this tip — Save stays disabled until the record and id are ready.", "err");
          return;
        }
      }
      const row = buildRow();
      const titleEl = document.getElementById("field-title") as HTMLInputElement | null;
      const slugEl = document.getElementById("field-slug") as HTMLInputElement | null;
      const title = String(titleEl?.value ?? row.title ?? "").trim();
      const slug = String(slugEl?.value ?? row.slug ?? "").trim();
      row.title = title;
      row.slug = slug;
      const bridgeEl = document.getElementById("field-bridge");
      row.bridge =
        bridgeEl instanceof HTMLTextAreaElement
          ? bridgeEl.value.trim()
          : String(row.bridge ?? "").trim();
      const category = String(row.category ?? "").trim();
      if (!title || !slug || !category) { setStatus("Fill required fields: title, slug, category.", "err"); return; }
      row.status = checked("tipActive") ? "published" : "draft";
      const payload = deepClone(row);
      payload.title = title;
      payload.slug = slug;
      delete payload.id;
      async function parseSaveResponse(res: Response): Promise<Record<string, unknown>> {
        const rawText = await res.text();
        const snippet = rawText.trim().replace(/\s+/g, " ").slice(0, 200);
        if (!rawText.trim()) {
          return { ok: false, error: `Save failed: HTTP ${res.status} with empty body.` };
        }
        try {
          return JSON.parse(rawText) as Record<string, unknown>;
        } catch (e) {
          console.error("[tips-edit save] Non-JSON response", res.status, rawText.slice(0, 400), e);
          return {
            ok: false,
            error: `Save failed: HTTP ${res.status}, body was not JSON.${snippet ? ` Preview: ${snippet}` : ""}`,
          };
        }
      }
      try {
        if (!urlRequestsEdit) {
          const res = await fetch(API_BASE, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
          const data = await parseSaveResponse(res);
          if (!res.ok || !data?.ok || !data.tip) {
            setStatus(String(data?.error || `Save failed (${res.status})`), "err");
            return;
          }
          setStatus("Saved.", "ok");
          window.location.href = "/admin/tips-admin";
        } else {
          const res = await fetch(`${API_BASE}/${editingId}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ...payload, id: editingId, title, slug }),
          });
          const data = await parseSaveResponse(res);
          if (!res.ok || !data?.ok || !data.tip) {
            setStatus(String(data?.error || `Save failed (${res.status})`), "err");
            return;
          }
          setStatus("Saved.", "ok");
          window.location.href = "/admin/tips-admin";
        }
      } catch (e) {
        console.error("[tips-edit save] Thrown error", e);
        setStatus("Network error while saving.", "err");
      }
    }
    async function deleteTip(id: number) {
      try {
        const res = await fetch(`${API_BASE}/${id}`, { method: "DELETE" });
        const data = await res.json();
        if (!res.ok || !data?.ok) { setStatus(data?.error || `Delete failed (${res.status})`, "err"); return; }
        setStatus(`Deleted tip id ${id}.`, "ok");
        window.location.href = "/admin/tips-admin";
      } catch { setStatus("Network error while deleting.", "err"); }
    }

    document.getElementById("btn-cancel-edit")?.addEventListener("click", () => { window.location.href = "/admin/tips-admin"; });
    document.getElementById("btn-save-tip")?.addEventListener("click", () => { void saveTip(); });
    document.getElementById("btn-delete-tip")?.addEventListener("click", () => {
      if (editingId === null) { setStatus("Only saved tips can be deleted.", "err"); return; }
      if (!confirm(`Delete tip id ${editingId}? This cannot be undone.`)) return;
      void deleteTip(editingId);
    });
    document.getElementById("btn-refresh-preview")?.addEventListener("click", () => { refreshPreview(); setStatus("Preview refreshed.", "ok"); });
    document.getElementById("btn-refresh-tip-preview")?.addEventListener("click", () => {
      if (!getValidPreviewSlug()) {
        setStatus("Add a slug to preview this tip.", "neutral");
        syncPublicTipPreview();
        return;
      }
      reloadPublicTipPreview();
      setStatus("Preview refreshed.", "ok");
    });
    tipPreviewOpenLink?.addEventListener("click", (e) => {
      if (!getValidPreviewSlug()) {
        e.preventDefault();
      }
    });
    form?.addEventListener("submit", (e) => e.preventDefault());
    document.getElementById("field-title")?.addEventListener("input", () => {
      if (editingId !== null || slugManual) return;
      setField("slug", slugifyTitle(textVal("title")));
    });
    document.getElementById("field-slug")?.addEventListener("input", () => {
      if (editingId === null) slugManual = true;
    });
    form?.addEventListener("input", (ev) => {
      refreshPreview();
      if (shouldSchedulePreviewReloadFromEventTarget(ev.target)) {
        scheduleDebouncedPublicTipPreviewReload();
      }
    });
    form?.addEventListener("change", (ev) => {
      refreshPreview();
      if (shouldSchedulePreviewReloadFromEventTarget(ev.target)) {
        scheduleDebouncedPublicTipPreviewReload();
      }
    });
    document.getElementById("relatedLessons")?.addEventListener("change", () => {
      renderRelatedLessonsChosenList();
    });
    renderRelatedLessonsChosenList();
    syncPublicTipPreview();
    updateSaveButtonState();
    void fetchTips();
  </script>
</BaseLayout>
