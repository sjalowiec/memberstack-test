---
import BaseLayout from "../../layouts/BaseLayout.astro";
import helpHubData from "../../data/help-hub.json";
import lessons from "../../data/lessons.json";

const entries = Array.isArray(helpHubData) ? helpHubData : [];
const lessonRecords = Array.isArray(lessons) ? lessons : [];

const lessonReferenceLines = lessonRecords.reduce<
  { id: number; title: string }[]
>((acc, lesson) => {
  const rec = lesson as Record<string, unknown>;
  const id = rec.id;
  if (typeof id !== "number" || !Number.isFinite(id)) return acc;
  const title = rec.title;
  const titleStr =
    typeof title === "string" ? title : title != null ? String(title) : "";
  acc.push({ id, title: titleStr });
  return acc;
}, []);
const slugParam = Astro.url.searchParams.get("slug");
const slug =
  typeof slugParam === "string" && slugParam.trim() !== ""
    ? slugParam.trim()
    : "";
const slugNormalized = slug.toLowerCase();
const currentEntry = slug
  ? entries.find((entry) => {
      const entrySlug =
        typeof entry.slug === "string" && entry.slug.trim() !== ""
          ? entry.slug.trim()
          : "";
      return entrySlug.toLowerCase() === slugNormalized;
    }) ?? null
  : null;
const isEditing = Boolean(currentEntry);

const pageTitle = isEditing
  ? "Edit Help Hub Entry | Knit it Now"
  : "Create Help Hub Entry | Knit it Now";

const rawEntry = currentEntry as Record<string, unknown> | null;

function stringifyValue(v: unknown): string {
  if (v === undefined || v === null) return "";
  if (Array.isArray(v)) return v.map(String).join("\n");
  if (typeof v === "object") return "";
  return String(v);
}

const multiKeyFields: Record<string, string[]> = {
  thumbnailAlt: ["thumbnailAlt", "mediaAlt"],
  solutionText: ["solutionText", "bridge"],
  intro: ["intro", "aboutTitle"],
  aboutTitle: ["aboutTitle"],
  bridge: ["bridge", "solutionText"],
  atAGlance: ["atAGlance"],
  specificMention: ["specificMention"],
  tags: ["tags"],
  resources: ["resources"],
};

function tryThisIntroForForm(entry: Record<string, unknown>): string {
  const t = entry.tryThis;
  if (typeof t === "string") return t;
  if (t && typeof t === "object" && !Array.isArray(t)) {
    const o = t as { quickActionTitle?: unknown };
    if (typeof o.quickActionTitle === "string") return o.quickActionTitle;
  }
  return "";
}

function tryStepsLinesForForm(entry: Record<string, unknown>): string {
  const s = entry.trySteps;
  if (!Array.isArray(s)) return "";
  return s.map(String).join("\n");
}

function valueFor(key: string, fallback = ""): string {
  if (!rawEntry) return fallback;

  if (key === "tryThis") {
    return tryThisIntroForForm(rawEntry) || fallback;
  }
  if (key === "trySteps") {
    return tryStepsLinesForForm(rawEntry) || fallback;
  }

  if (key === "relatedLessons") {
    const rl = rawEntry.relatedLessons;
    if (!Array.isArray(rl)) return fallback;
    const parts = rl
      .map((x) => {
        if (typeof x === "number" && Number.isFinite(x)) return String(x);
        if (typeof x === "string") {
          const t = x.trim();
          return t.length > 0 ? t : "";
        }
        return "";
      })
      .filter((s) => s.length > 0);
    return parts.length ? parts.join(", ") : fallback;
  }

  if (key === "mediaType") {
    const mt = stringifyValue(rawEntry.mediaType);
    const normalized = mt === "video" ? "youtube" : mt;
    const allowed = ["placeholder", "image", "vimeo", "youtube"];
    if (normalized && allowed.includes(normalized)) return normalized;
    return fallback;
  }

  const keysToTry = multiKeyFields[key] ?? [key];
  for (const jsonKey of keysToTry) {
    const v = rawEntry[jsonKey];
    if (v === undefined) continue;
    if (Array.isArray(v)) {
      return v.map(String).join("\n");
    }
    if (typeof v === "object" && v !== null) continue;
    return stringifyValue(v);
  }

  return fallback;
}

const entryLabel = currentEntry as {
  question?: string;
  title?: string;
  slug?: string;
} | null;
---

<BaseLayout
  title={pageTitle}
  description="Draft the question, solution, metadata, media, resources, and CTA content for a Help Hub entry."
  skipGlobalHyvor={true}
  bodyClass="help-hub-admin-body"
>
  <main class="help-hub-admin help-hub-dash help-hub-edit">
    <header class="help-hub-admin__head">
      <h1 class="help-hub-admin__title">
        {isEditing ? "Edit Help Hub Entry" : "Create Help Hub Entry"}
      </h1>
      <p class="help-hub-admin__sub">
        Draft the question, solution, metadata, media, resources, and CTA content
        for a Help Hub entry. Use <strong>Save</strong> to write changes directly to
        <code>src/data/help-hub.json</code>.
      </p>
      <p class="help-hub-edit__context">
        {
          isEditing && entryLabel
            ? `Editing: ${entryLabel.question || entryLabel.title || entryLabel.slug || ""}`
            : "New entry"
        }
      </p>
    </header>

    <div class="help-hub-admin__toolbar help-hub-dash__toolbar">
      <a href="/admin/help-hub" class="kbm-btn kbm-btn-outline">Back to Help Hub Admin</a>
      <span id="saveHelpHubStatusTop" class="help-hub-edit__save-status" aria-live="polite"></span>
    </div>

    <form class="help-hub-edit__form" novalidate>
      <div class="help-hub-edit__sections help-hub-dash__sections">
        <section
          class="admin-panel help-hub-dash__panel"
          aria-labelledby="core-details-heading"
        >
