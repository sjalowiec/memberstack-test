  <script
    type="application/json"
    id="help-hub-current-entry"
    set:html={JSON.stringify(currentEntry ?? null)}
  />

  <script is:inline>
    (function () {
      var currentEntryEl = document.getElementById("help-hub-current-entry");
      var INITIAL_HELP_HUB = currentEntryEl
        ? JSON.parse(currentEntryEl.textContent || "null")
        : null;

      var FIELD_ORDER = [
        "question",
        "slug",
        "status",
        "bubbleAnswer",
        "hook",
        "category",
        "categoryPill",
        "tags",
        "solutionType",
        "successPathLevel",
        "relatedLessons",
        "mediaType",
        "mediaUrl",
        "thumbnailAlt",
        "intro",
        "atAGlance",
        "solutionText",
        "specificMention",
        "aboutTitle",
        "bridge",
        "tryThis",
        "trySteps",
        "tryNote",
        "tryImage",
        "tryImageAlt",
        "tryImageCaption",
        "memberHeading",
        "memberText",
        "resources",
      ];

      function trimmedFieldValue(form, name) {
        var el = form.elements.namedItem(name);
        if (!el) return "";
        if ("value" in el) return String(el.value).trim();
        return "";
      }

      function splitTags(text) {
        if (!text) return [];
        return text
          .split(/[\r\n,]+/)
          .map(function (s) {
            return s.trim();
          })
          .filter(Boolean);
      }

      function splitLines(text) {
        if (!text) return [];
        return text
          .split(/\r?\n/)
          .map(function (s) {
            return s.trim();
          })
          .filter(Boolean);
      }

      function parseRelatedLessonIds(text) {
        if (!text) return [];
        return text
          .split(",")
          .map(function (s) {
            return s.trim();
          })
          .filter(Boolean)
          .map(function (s) {
            if (/^\d+$/.test(s)) {
              var n = Number(s);
              if (typeof n === "number" && !isNaN(n) && isFinite(n)) return n;
            }
            return s;
          });
      }

      function buildHelpHubObject(form) {
        var out = JSON.parse(JSON.stringify(window.currentHelpHub || {}));
        var i;
        var key;
        var v;
        var arr;

        for (i = 0; i < FIELD_ORDER.length; i++) {
          key = FIELD_ORDER[i];
          if (key === "tags") {
            arr = splitTags(trimmedFieldValue(form, "tags"));
            if (arr.length) out.tags = arr;
            continue;
          }
          if (key === "atAGlance") {
            arr = splitLines(trimmedFieldValue(form, "atAGlance"));
            if (arr.length) out.atAGlance = arr;
            continue;
          }
          if (key === "resources") {
            arr = splitLines(trimmedFieldValue(form, "resources"));
            if (arr.length) out.resources = arr;
            continue;
          }
          if (key === "trySteps") {
            arr = splitLines(trimmedFieldValue(form, "trySteps"));
            if (arr.length) out.trySteps = arr;
            continue;
          }
          if (key === "relatedLessons") {
            arr = parseRelatedLessonIds(trimmedFieldValue(form, "relatedLessons"));
            if (arr.length) out.relatedLessons = arr;
            continue;
          }
          v = trimmedFieldValue(form, key);
          if (key === "tryThis") {
            var existing = out.tryThis;

            if (existing && typeof existing === "object" && !Array.isArray(existing)) {
              if (v !== "") {
                existing.quickActionTitle = v;
                out.tryThis = existing;
              }
            } else {
              if (v !== "") out.tryThis = v;
            }
            continue;
          }
          if (v !== "") out[key] = v;
        }

        if (!out.status) {
          out.status = "draft";
        }

        return out;
      }

      var CURSOR_SAVE_PROMPT_PREFIX =
        "Update src/data/help-hub.json.\n\n" +
        "Merge the Help Hub entry below into the existing entry by slug.\n\n" +
        "If the slug already exists, update only the fields included in ENTRY JSON and preserve any existing fields that are not included.\n" +
        "If the slug does not exist, add it as a new object.\n" +
        "Keep the JSON valid.\n" +
        "Preserve existing entries.\n" +
        "Do not modify any other files.\n\n" +
        "ENTRY JSON:\n";

      function sanitizeSlugValue(raw) {
        return String(raw)
          .toLowerCase()
          .replace(/\s+/g, "-")
          .replace(/[^a-z0-9-]/g, "");
      }

      function hasRequiredFields(form) {
        return getMissingRequiredFields(form).length === 0;
      }

      function getMissingRequiredFields(form) {
        var built = buildHelpHubObject(form);
        var required = ["question", "slug", "status", "category"];
        var missing = [];
        var i;
        var name;
        for (i = 0; i < required.length; i++) {
          name = required[i];
          if (!built[name] || String(built[name]).trim() === "") {
            missing.push(name);
          }
        }
        return missing;
      }

      function prepareApiPayload(form) {
        var built = buildHelpHubObject(form);
        if (!built.title || String(built.title).trim() === "") {
          built.title = built.question || built.slug || "Untitled";
        }
        return built;
      }

      function setSaveStatus(message, kind) {
        var els = [
          document.getElementById("saveHelpHubStatus"),
          document.getElementById("saveHelpHubStatusTop"),
        ];
        els.forEach(function (el) {
          if (!el) return;
          el.textContent = message;
          el.classList.toggle("is-error", kind === "err");
          el.classList.toggle("is-ok", kind === "ok");
        });
      }

      async function saveHelpHubEntry(form, saveBtn) {
        var missing = getMissingRequiredFields(form);
        if (missing.length) {
          setSaveStatus("Missing required fields: " + missing.join(", "), "err");
          return false;
        }

        var payload = prepareApiPayload(form);
        var id =
          window.currentHelpHub &&
          window.currentHelpHub.id !== undefined &&
          window.currentHelpHub.id !== null
            ? window.currentHelpHub.id
            : null;
        var url =
          id !== null && String(id).trim() !== ""
            ? "/api/admin/help-hub/" + encodeURIComponent(String(id))
            : "/api/admin/help-hub";
        var method = id !== null && String(id).trim() !== "" ? "PUT" : "POST";

        if (saveBtn) saveBtn.disabled = true;
        setSaveStatus("Saving…", null);

        try {
          var res = await fetch(url, {
            method: method,
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          var data = await res.json().catch(function () {
            return {};
          });
          if (!res.ok || !data.ok) {
            setSaveStatus(data.error || "Save failed (" + res.status + ")", "err");
            return false;
          }

          if (data.tip && typeof data.tip === "object") {
            window.currentHelpHub = JSON.parse(JSON.stringify(data.tip));
          }

          setSaveStatus("Saved to help-hub.json", "ok");

          if (method === "POST" && data.tip && data.tip.slug) {
            window.setTimeout(function () {
              window.location.href =
                "/admin/help-hub-edit?slug=" + encodeURIComponent(String(data.tip.slug));
            }, 400);
            return true;
          }

          return true;
        } catch (e) {
          setSaveStatus("Save failed — network error", "err");
          return false;
        } finally {
          if (saveBtn) saveBtn.disabled = false;
        }
      }

      function init() {
        window.currentHelpHub =
          INITIAL_HELP_HUB && typeof INITIAL_HELP_HUB === "object"
            ? JSON.parse(JSON.stringify(INITIAL_HELP_HUB))
            : {};

        var form = document.querySelector(".help-hub-edit__form");
        var pre = document.getElementById("helpHubJsonPreview");
        var copyBtn = document.getElementById("copyHelpHubJson");
        var status = document.getElementById("copyHelpHubJsonStatus");
        var cursorBtn = document.getElementById("copyHelpHubCursorPrompt");
        var cursorStatus = document.getElementById("copyHelpHubCursorStatus");
        var previewBtn = document.getElementById("previewHelpHub");
        var saveBtn = document.getElementById("saveHelpHubBtn");
        if (!form || !pre || !copyBtn || !status || !cursorBtn || !cursorStatus) return;

        var jsonCopyTimerHolder = { current: null };
        var cursorCopyTimerHolder = { current: null };

        function copyToClipboard(text, statusEl, timerHolder) {
          function showCopied() {
            statusEl.textContent = "Copied";
            if (timerHolder.current) clearTimeout(timerHolder.current);
            timerHolder.current = window.setTimeout(function () {
              statusEl.textContent = "";
              timerHolder.current = null;
            }, 2000);
          }

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(showCopied).catch(function () {
              statusEl.textContent = "";
            });
          } else {
            try {
              var ta = document.createElement("textarea");
              ta.value = text;
              ta.setAttribute("readonly", "");
              ta.style.position = "fixed";
              ta.style.left = "-9999px";
              document.body.appendChild(ta);
              ta.select();
              document.execCommand("copy");
              document.body.removeChild(ta);
              showCopied();
            } catch (e) {
              statusEl.textContent = "";
            }
          }
        }

        function updatePreview() {
          var obj = buildHelpHubObject(form);
          pre.textContent = JSON.stringify(obj, null, 2);
        }

        function updateCopyUi() {
          var missing = getMissingRequiredFields(form);
          var ok = missing.length === 0;
          var missingText =
            "Missing required fields: " + missing.join(", ");

          copyBtn.disabled = !ok;
          cursorBtn.disabled = !ok;
          if (previewBtn) previewBtn.disabled = !ok;
          if (saveBtn) saveBtn.disabled = !ok;
          if (!ok) {
            status.textContent = missingText;
            cursorStatus.textContent = missingText;
            status.classList.add("help-hub-edit__copy-status--error");
            cursorStatus.classList.add("help-hub-edit__copy-status--error");
          } else {
            status.textContent = "";
            cursorStatus.textContent = "";
            status.classList.remove("help-hub-edit__copy-status--error");
            cursorStatus.classList.remove("help-hub-edit__copy-status--error");
          }
        }

        function onFormActivity(ev) {
          var t = ev.target;
          if (t && t.getAttribute && t.getAttribute("name") === "slug") {
            var before = t.value;
            var after = sanitizeSlugValue(before);
            if (after !== before) {
              t.value = after;
            }
          }
          updatePreview();
          updateCopyUi();
        }

        form.addEventListener("input", onFormActivity);
        form.addEventListener("change", onFormActivity);
        updatePreview();
        updateCopyUi();

        copyBtn.addEventListener("click", function () {
          if (!hasRequiredFields(form)) {
            updateCopyUi();
            return;
          }
          var text = JSON.stringify(buildHelpHubObject(form), null, 2);
          copyToClipboard(text, status, jsonCopyTimerHolder);
        });

        cursorBtn.addEventListener("click", function () {
          if (!hasRequiredFields(form)) {
            updateCopyUi();
            return;
          }
          var entryJson = JSON.stringify(buildHelpHubObject(form), null, 2);
          var promptText = CURSOR_SAVE_PROMPT_PREFIX + entryJson;
          copyToClipboard(promptText, cursorStatus, cursorCopyTimerHolder);
        });

        if (previewBtn) {
          previewBtn.addEventListener("click", function () {
            if (!hasRequiredFields(form)) {
              updateCopyUi();
              return;
            }
            var obj = buildHelpHubObject(form);
            var data = btoa(JSON.stringify(obj));
            var url = "/help-hub/preview?data=" + encodeURIComponent(data);
            window.open(url, "_blank", "noopener,noreferrer");
          });
        }

        if (saveBtn) {
          saveBtn.addEventListener("click", async function () {
            var saved = await saveHelpHubEntry(form, saveBtn);
            if (saved) {
              updatePreview();
              updateCopyUi();
            }
          });
        }
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>
</BaseLayout>
