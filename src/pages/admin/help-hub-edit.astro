---
import BaseLayout from "../../layouts/BaseLayout.astro";
import videosPublic from "../../data/videos-public.json";
import { loadHelpHubTipBySlug, loadHelpHubTipsForAdmin } from "../../lib/helpHub/loadTips";
import { loadLessonsForAdmin } from "../../lib/lessons/loadLessons";
import type { HelpHubLessonRecord } from "../../lib/helpHubMemberLesson";
import {
  explanationForAdminForm,
  noteForAdminForm,
  helpHubChooserPlacement,
  helpHubEditorEntryChoices,
  helpHubSplitEntryChooserEnabled,
  slugFromQuestion,
  tryStepListForForm,
  tryStepsLinesForForm,
  tryThisIntroForForm,
  topImageFieldsForAdminForm,
} from "../../lib/helpHub/adminForm";
import { detectSiteEnvironment } from "../../lib/env/siteEnvironment";
import { helpHubAdminEditorPayload } from "../../lib/helpHub/adminPageGate";
import { helpHubCategoryChoices } from "../../lib/helpHub/categories";
import { loadManagedHelpHubCategories } from "../../lib/helpHub/loadCategories";
import {
  libraryVideosForPicker,
  memberLessonsForResourcePicker,
} from "../../lib/helpHub/memberResources";

export const prerender = false;

const slugParam = Astro.url.searchParams.get("slug");
const slug =
  typeof slugParam === "string" && slugParam.trim() !== "" ? slugParam.trim() : "";

const currentEntry = slug ? await loadHelpHubTipBySlug(slug) : null;
const isEditing = Boolean(currentEntry);

const lessonRecords = (await loadLessonsForAdmin()) as HelpHubLessonRecord[];
const libraryPickerItems = libraryVideosForPicker(Array.isArray(videosPublic) ? videosPublic : []);
const lessonPickerItems = memberLessonsForResourcePicker(lessonRecords);

const clientPayload = helpHubAdminEditorPayload({
  entry: currentEntry as Record<string, unknown> | null,
  lessons: lessonPickerItems,
  library: libraryPickerItems,
  allLessons: lessonRecords.map((lesson) => ({
    id: lesson.id,
    title: lesson.title,
    slug: lesson.slug,
    status: lesson.status,
  })),
});

const categoryOptions = helpHubCategoryChoices(await loadManagedHelpHubCategories());

const pageTitle = isEditing
  ? "Edit Help Hub Entry | Knit it Now"
  : "Create Help Hub Entry | Knit it Now";

const rawEntry = currentEntry as Record<string, unknown> | null;

function stringifyValue(v: unknown): string {
  if (v === undefined || v === null) return "";
  if (Array.isArray(v)) return v.map(String).join("\n");
  if (typeof v === "object") return "";
  return String(v);
}

function valueFor(key: string, fallback = ""): string {
  if (!rawEntry) return fallback;
  if (key === "tryThis") return tryThisIntroForForm(rawEntry) || fallback;
  if (key === "trySteps") return tryStepsLinesForForm(rawEntry) || fallback;
  if (key === "solutionText") return explanationForAdminForm(rawEntry) || fallback;
  if (key === "slug" && !isEditing) return fallback;
  const v = rawEntry[key];
  if (v === undefined || v === null) return fallback;
  if (Array.isArray(v) || typeof v === "object") return fallback;
  return stringifyValue(v);
}

const statusValue = valueFor("status", "draft");
const categoryValue = valueFor("category", "");
const knownKeys = categoryOptions.map((opt) => opt.key);
const showLegacyOption = categoryValue !== "" && !knownKeys.includes(categoryValue);
const isNewChecked = rawEntry?.isNew === true;
const entryLabel = currentEntry as { question?: string; title?: string; slug?: string } | null;
const initialSlug = isEditing ? valueFor("slug", "") : slugFromQuestion(valueFor("question", ""));
const topImage = topImageFieldsForAdminForm(rawEntry);
const trySteps = tryStepListForForm(rawEntry);
const importantNote = noteForAdminForm(rawEntry);
const tryIntro = valueFor("tryThis", "");
const supportImage = valueFor("tryImage", "");
const supportAlt = valueFor("tryImageAlt", "");
const supportCaption = valueFor("tryImageCaption", "");
const publicVideoUrl = valueFor("publicVideoUrl", "");
const publicVideoTitle = valueFor("publicVideoTitle", "");
const ctaEyebrow = valueFor("relatedToolEyebrow", "");
const ctaTitle = valueFor("relatedToolTitle", "");
const ctaNote = valueFor("relatedToolNote", "");
const ctaLabel = valueFor("relatedToolLabel", "");
const ctaUrl = valueFor("relatedToolUrl", "");

function hasAny(...values: string[]): boolean {
  return values.some((value) => value.trim() !== "");
}

function entryHasLessons(entry: Record<string, unknown> | null): boolean {
  if (!entry) return false;
  const lessons = entry.relatedLessons;
  const library = entry.relatedLibraryVideos;
  return (
    (Array.isArray(lessons) && lessons.length > 0) ||
    (Array.isArray(library) && library.length > 0)
  );
}

const imageOpen = hasAny(topImage.url, topImage.alt, topImage.caption);
const videoOpen = hasAny(publicVideoUrl, publicVideoTitle);
const tryOpen = hasAny(tryIntro, trySteps.join("\n"));
const noteOpen = hasAny(importantNote);
const supportOpen = hasAny(supportImage, supportAlt, supportCaption);
const ctaOpen = hasAny(ctaEyebrow, ctaTitle, ctaNote, ctaLabel, ctaUrl);
const lessonsOpen = entryHasLessons(rawEntry);
const entryChoices = helpHubEditorEntryChoices(await loadHelpHubTipsForAdmin());
const entryGroups = (
  [
    { label: "Published", items: entryChoices.published },
    { label: "Drafts", items: entryChoices.draft },
    { label: "Needs review", items: entryChoices.review },
  ] as const
).filter((group) => group.items.length > 0);
const splitEntryChooser = helpHubSplitEntryChooserEnabled(
  detectSiteEnvironment(Astro.url.hostname, {
    isViteDev: import.meta.env.DEV,
    publicSiteEnv: import.meta.env.PUBLIC_SITE_ENV,
  }),
);
const openLabel = (entryLabel?.question || entryLabel?.title || entryLabel?.slug || "").trim();
const openPlacement = helpHubChooserPlacement(statusValue);
const chooserBoxes = [
  {
    key: "draft" as const,
    title: "Draft Help Hubs",
    headingId: "help-hub-drafts-heading",
    empty: "No saved drafts yet.",
    hint:
      entryChoices.review.length > 0
        ? "Private until you publish. Needs review entries are included."
        : "Private until you publish.",
    items: [...entryChoices.draft, ...entryChoices.review],
    action: "Open" as const,
  },
  {
    key: "published" as const,
    title: "Published Help Hubs",
    headingId: "help-hub-published-heading",
    empty: "No published entries yet.",
    hint: "On the public Help Hub.",
    items: entryChoices.published,
    action: "Edit" as const,
  },
];
---

<BaseLayout
  title={pageTitle}
  description="Write a public Help Hub answer and choose an existing member lesson."
  bodyClass="help-hub-admin-body"
>
  <main class="help-hub-admin help-hub-dash help-hub-edit">
    <header class="help-hub-admin__head">
      <h1 class="help-hub-admin__title">
        {isEditing ? "Edit Help Hub Entry" : "Create Help Hub Entry"}
      </h1>
      <p class="help-hub-admin__sub">
        Write the public answer on the left. The preview uses the public Help Hub page and
        updates as you type, before you save.
      </p>
      <p class="help-hub-edit__context" id="helpHubEditingContext">
        {splitEntryChooser
          ? isEditing
            ? `Editing: ${openLabel || "Untitled"} — ${openPlacement.statusLabel}`
            : "New entry — not saved"
          : isEditing && entryLabel
            ? `Editing: ${openLabel}`
            : "New entry"}
      </p>
    </header>

    <div class="help-hub-admin__toolbar help-hub-dash__toolbar">
      <a href="/admin/help-hub" class="kbm-btn kbm-btn-outline">Back to Help Hub Admin</a>
      <span id="saveHelpHubStatusTop" class="help-hub-edit__save-status" aria-live="polite"></span>
    </div>

    {splitEntryChooser ? (
      <div class="help-hub-edit__chooser" data-help-hub-chooser="split">
        <a href="/admin/help-hub-edit" class="kbm-btn kbm-btn-primary help-hub-edit__create" id="helpHubCreateNew">
          Create new Help Hub
        </a>
        <p id="helpHubCurrentEntry" class="help-hub-edit__current" role="status">
          <span class="help-hub-edit__current-kicker">Open now</span>
          <strong id="helpHubCurrentTitle">{isEditing ? openLabel || "Untitled" : "New Help Hub"}</strong>
          <span
            id="helpHubCurrentStatus"
            class="help-hub-edit__status-pill"
            data-status={isEditing ? openPlacement.key : "unsaved"}
          >
            {isEditing ? openPlacement.statusLabel : "Not saved"}
          </span>
        </p>
        <input
          id="helpHubEntrySearch"
          class="help-hub-edit__input"
          type="search"
          placeholder="Search by question"
          autocomplete="off"
          aria-label="Search Help Hubs by question"
        />
        <div class="help-hub-edit__chooser-grid">
          {chooserBoxes.map((box) => (
            <section
              class:list={[
                "help-hub-edit__chooser-box",
                box.key === "draft" && "help-hub-edit__chooser-box--drafts",
              ]}
              aria-labelledby={box.headingId}
              data-chooser-box={box.key}
            >
              <h2 id={box.headingId} class="help-hub-edit__chooser-title">{box.title}</h2>
              <p class="help-hub-edit__hint">{box.hint}</p>
              <p class="help-hub-edit__chooser-empty" data-chooser-empty hidden={box.items.length > 0}>
                {box.empty}
              </p>
              <ul class="help-hub-edit__chooser-list" data-chooser-list={box.key}>
                {box.items.map((item) => {
                  const current = item.slug === slug;
                  return (
                    <li
                      class:list={["help-hub-edit__chooser-item", current && "is-current"]}
                      data-entry-slug={item.slug}
                      data-entry-status={item.status}
                      aria-current={current ? "true" : undefined}
                    >
                      <div class="help-hub-edit__chooser-main">
                        <span class="help-hub-edit__chooser-label">{item.label}</span>
                        <span class="help-hub-edit__chooser-badge" hidden={item.status !== "review"}>
                          Needs review
                        </span>
                      </div>
                      {current ? (
                        <span class="help-hub-edit__chooser-current" data-chooser-action="current">Open now</span>
                      ) : (
                        <a
                          class="kbm-btn kbm-btn-outline help-hub-edit__chooser-action"
                          data-chooser-action="link"
                          href={`/admin/help-hub-edit?slug=${encodeURIComponent(item.slug)}`}
                        >
                          {box.action}
                        </a>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </div>
    ) : (
      <div class="help-hub-edit__open">
        <label for="helpHubOpenEntry" class="help-hub-edit__label">Open an existing entry</label>
        <p class="help-hub-edit__hint">
          Published and draft entries. Choosing one fills this form. Unsaved text on this page is not kept.
        </p>
        <input
          id="helpHubEntrySearch"
          class="help-hub-edit__input"
          type="search"
          placeholder="Search by question"
          autocomplete="off"
        />
        <select id="helpHubOpenEntry" class="help-hub-edit__select help-hub-edit__open-list" size="8">
          <option value="" selected={slug === ""}>New entry</option>
          {
            entryGroups.map((group) => (
              <optgroup label={group.label}>
                {group.items.map((item) => (
                  <option value={item.slug} selected={item.slug === slug}>
                    {item.label}
                  </option>
                ))}
              </optgroup>
            ))
          }
        </select>
      </div>
    )}

          <div id="helpHubDraftRecovery" class="help-hub-edit__recovery" role="alert" hidden>
            <span class="help-hub-edit__recovery-text">Recovered unsaved draft available.</span>
            <div class="help-hub-edit__recovery-actions">
              <button type="button" id="helpHubRestoreDraft" class="kbm-btn kbm-btn-primary">
                Restore Draft
              </button>
              <button type="button" id="helpHubDiscardDraft" class="kbm-btn kbm-btn-outline">
                Discard Draft
              </button>
            </div>
          </div>

    <div class="help-hub-edit__modes" role="tablist" aria-label="Editor or preview">
      <button
        type="button"
        id="helpHubModeEdit"
        class="help-hub-edit__mode"
        role="tab"
        aria-selected="true"
        aria-controls="helpHubEditor"
      >
        Edit
      </button>
      <button
        type="button"
        id="helpHubModePreview"
        class="help-hub-edit__mode"
        role="tab"
        aria-selected="false"
        aria-controls="helpHubPreviewPane"
      >
        Preview
      </button>
    </div>

    <div class="help-hub-edit__workspace" data-mode="edit">
      <div class="help-hub-edit__editor" id="helpHubEditor">
          <form class="help-hub-edit__form" novalidate>
                        <div class="help-hub-edit__sections help-hub-dash__sections">
              <section
                class="admin-panel help-hub-dash__panel"
                data-editor-group="question"
                aria-labelledby="question-heading"
              >
                <p class="help-hub-edit__kind">On the public page</p>
                <h2 id="question-heading" class="help-hub-dash__panel-title">Question and quick answer</h2>
                <div class="help-hub-edit__fields">
                  <div class="help-hub-edit__field">
                    <label for="help-hub-hook" class="help-hub-edit__label">Hook</label>
                    <textarea
                      id="help-hub-hook"
                      class="help-hub-edit__textarea"
                      name="hook"
                      rows="2">{valueFor("hook", "")}</textarea>
                    <p class="help-hub-edit__hint">Appears above the question. Leave blank to hide it.</p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-question" class="help-hub-edit__label">Question</label>
                    <textarea
                      id="help-hub-question"
                      class="help-hub-edit__textarea"
                      name="question"
                      rows="3">{valueFor("question", "")}</textarea>
                    <p class="help-hub-edit__hint">The large question bubble.</p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-bubble" class="help-hub-edit__label">Quick answer</label>
                    <textarea
                      id="help-hub-bubble"
                      class="help-hub-edit__textarea"
                      name="bubbleAnswer"
                      rows="3">{valueFor("bubbleAnswer", "")}</textarea>
                    <p class="help-hub-edit__hint">The short reply in the answer bubble. Leave blank to hide it.</p>
                  </div>
                </div>
              </section>

              <details
                class="admin-panel help-hub-dash__panel"
                data-editor-group="image"
                open={imageOpen ? true : undefined}
              >
                <summary class="help-hub-edit__summary">
                  <span class="help-hub-edit__summary-title">Main image and caption</span>
                  <span class="help-hub-edit__summary-note">Optional</span>
                </summary>
                <p class="help-hub-edit__kind">On the public page</p>
                <p class="help-hub-edit__section-intro">
                  Shown beside the question and quick answer. Leave the address blank to hide the image.
                </p>
                <div class="help-hub-edit__fields" data-image-fields>
                  <div class="help-hub-edit__thumb" data-image-thumb hidden>
                    <img alt="" />
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-top-image" class="help-hub-edit__label">Image address</label>
                    <input
                      id="help-hub-top-image"
                      class="help-hub-edit__input"
                      type="text"
                      name="mediaUrl"
                      data-image-url
                      value={topImage.url}
                    />
                    <p class="help-hub-edit__hint">
                      Choosing an image fills this in. You can also paste a site path.
                    </p>
                    <div class="help-hub-edit__upload">
                      <button type="button" class="kbm-btn kbm-btn-outline" data-image-choose>
                        Choose image
                      </button>
                      <input
                        type="file"
                        accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                        data-image-file
                        hidden
                      />
                      <p class="help-hub-edit__hint" data-image-upload-status></p>
                    </div>
                    <p class="help-hub-edit__hint">
                      JPG, PNG, or WebP from your computer. The address is filled in after the upload.
                    </p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-top-image-alt" class="help-hub-edit__label">Alt text</label>
                    <input
                      id="help-hub-top-image-alt"
                      class="help-hub-edit__input"
                      type="text"
                      name="mediaAlt"
                      data-image-alt
                      value={topImage.alt}
                    />
                    <p class="help-hub-edit__hint">Read aloud for someone who cannot see the image. Not shown as the caption.</p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-top-image-caption" class="help-hub-edit__label">Caption</label>
                    <textarea
                      id="help-hub-top-image-caption"
                      class="help-hub-edit__textarea"
                      name="mediaCaption"
                      data-image-caption
                      rows="2">{topImage.caption}</textarea>
                    <p class="help-hub-edit__hint">Shown under the image. Leave blank to hide the caption.</p>
                  </div>
                  <button type="button" class="kbm-btn kbm-btn-outline" data-image-remove>
                    Remove image
                  </button>
                  <p class="help-hub-edit__hint">
                    Removing an image takes it off this entry only. The file stays on the site.
                  </p>
                </div>
              </details>

              <section
                class="admin-panel help-hub-dash__panel"
                data-editor-group="explanation"
                aria-labelledby="explanation-heading"
              >
                <p class="help-hub-edit__kind">On the public page</p>
                <h2 id="explanation-heading" class="help-hub-dash__panel-title">Explanation</h2>
                <div class="help-hub-edit__fields">
                  <div class="help-hub-edit__field">
                    <label for="help-hub-about-title" class="help-hub-edit__label">Heading</label>
                    <input
                      id="help-hub-about-title"
                      class="help-hub-edit__input"
                      type="text"
                      name="aboutTitle"
                      value={valueFor("aboutTitle", "")}
                    />
                    <p class="help-hub-edit__hint">
                      Leave blank to use “Why This Works.”
                    </p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-solution-text" class="help-hub-edit__label">Explanation</label>
                    <button type="button" id="helpHubInsertSolutionImage" class="kbm-btn kbm-btn-outline help-hub-edit__insert-image">
                      Insert image
                    </button>
                    <textarea
                      id="help-hub-solution-text"
                      class="help-hub-edit__textarea"
                      name="solutionText"
                      rows="6">{valueFor("solutionText", "")}</textarea>
                    <p class="help-hub-edit__hint">
                      The section under the question. Insert an image and add a short paragraph if you want one. Leave blank to hide it.
                    </p>
                  </div>
                </div>
              </section>

              <details
                class="admin-panel help-hub-dash__panel"
                data-editor-group="video"
                open={videoOpen ? true : undefined}
              >
                <summary class="help-hub-edit__summary">
                  <span class="help-hub-edit__summary-title">Public video</span>
                  <span class="help-hub-edit__summary-note">Optional</span>
                </summary>
                <p class="help-hub-edit__kind">On the public page</p>
                <p class="help-hub-edit__section-intro">
                  Appears after the explanation. Leave the address blank to hide the video.
                </p>
                <div class="help-hub-edit__fields">
                  <div class="help-hub-edit__field">
                    <label for="help-hub-public-video-url" class="help-hub-edit__label">
                      Public video URL or Vimeo ID
                    </label>
                    <input
                      id="help-hub-public-video-url"
                      class="help-hub-edit__input"
                      type="text"
                      name="publicVideoUrl"
                      value={publicVideoUrl}
                    />
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-public-video-title" class="help-hub-edit__label">
                      Public video title
                    </label>
                    <input
                      id="help-hub-public-video-title"
                      class="help-hub-edit__input"
                      type="text"
                      name="publicVideoTitle"
                      value={publicVideoTitle}
                    />
                    <p class="help-hub-edit__hint">Optional heading shown with the video.</p>
                  </div>
                </div>
              </details>

              <details
                class="admin-panel help-hub-dash__panel"
                data-editor-group="try"
                open={tryOpen ? true : undefined}
              >
                <summary class="help-hub-edit__summary">
                  <span class="help-hub-edit__summary-title">Try This</span>
                  <span class="help-hub-edit__summary-note">Optional</span>
                </summary>
                <p class="help-hub-edit__kind">On the public page</p>
                <p class="help-hub-edit__section-intro">
                  The Try This list under the explanation. Hidden on the public page when this, the note, and the supporting image are all empty.
                </p>
                <div class="help-hub-edit__fields">
                  <div class="help-hub-edit__field">
                    <label for="help-hub-try-this-intro" class="help-hub-edit__label">Introduction</label>
                    <textarea
                      id="help-hub-try-this-intro"
                      class="help-hub-edit__textarea"
                      name="tryThis"
                      rows="2">{tryIntro}</textarea>
                    <p class="help-hub-edit__hint">A short line under the Try This heading.</p>
                  </div>
                  <div class="help-hub-edit__field">
                    <span class="help-hub-edit__label" id="help-hub-try-steps-label">Steps</span>
                    <div
                      id="help-hub-try-step-list"
                      class="help-hub-edit__steps"
                      data-try-step-list
                      aria-labelledby="help-hub-try-steps-label"
                    >
                      {trySteps.map((step, index) => (
                        <div class="help-hub-edit__step" data-try-step-row>
                          <span class="help-hub-edit__step-label">Step {index + 1}</span>
                          <textarea class="help-hub-edit__textarea" data-try-step rows="2">{step}</textarea>
                          <div class="help-hub-edit__step-actions">
                            <button type="button" data-step-action="up">Move up</button>
                            <button type="button" data-step-action="down">Move down</button>
                            <button type="button" data-step-action="remove">Remove</button>
                          </div>
                        </div>
                      ))}
                    </div>
                    <textarea id="help-hub-try-steps" name="trySteps" hidden>{trySteps.join("\n")}</textarea>
                    <button type="button" id="helpHubAddStep" class="kbm-btn kbm-btn-outline">Add step</button>
                    <p class="help-hub-edit__hint">Each step is one item in the Try This list.</p>
                  </div>
                </div>
              </details>

              <details
                class="admin-panel help-hub-dash__panel"
                data-editor-group="note"
                open={noteOpen ? true : undefined}
              >
                <summary class="help-hub-edit__summary">
                  <span class="help-hub-edit__summary-title">Important note</span>
                  <span class="help-hub-edit__summary-note">Optional</span>
                </summary>
                <p class="help-hub-edit__kind">On the public page</p>
                <div class="help-hub-edit__fields">
                  <div class="help-hub-edit__field">
                    <label for="help-hub-try-note" class="help-hub-edit__label">Important note</label>
                    <textarea
                      id="help-hub-try-note"
                      class="help-hub-edit__textarea"
                      name="tryNote"
                      rows="3">{importantNote}</textarea>
                    <p class="help-hub-edit__hint">Shown with Try This. Leave blank to hide it.</p>
                  </div>
                </div>
              </details>

              <details
                class="admin-panel help-hub-dash__panel"
                data-editor-group="support"
                open={supportOpen ? true : undefined}
              >
                <summary class="help-hub-edit__summary">
                  <span class="help-hub-edit__summary-title">Supporting image</span>
                  <span class="help-hub-edit__summary-note">Optional</span>
                </summary>
                <p class="help-hub-edit__kind">On the public page</p>
                <p class="help-hub-edit__section-intro">
                  Shown beside the Try This steps. Leave the address blank to hide it.
                </p>
                <div class="help-hub-edit__fields" data-image-fields>
                  <div class="help-hub-edit__thumb" data-image-thumb hidden>
                    <img alt="" />
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-try-image" class="help-hub-edit__label">Image address</label>
                    <input
                      id="help-hub-try-image"
                      class="help-hub-edit__input"
                      type="text"
                      name="tryImage"
                      data-image-url
                      value={supportImage}
                    />
                    <div class="help-hub-edit__upload">
                      <button type="button" class="kbm-btn kbm-btn-outline" data-image-choose>
                        Choose image
                      </button>
                      <input
                        type="file"
                        accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                        data-image-file
                        hidden
                      />
                      <p class="help-hub-edit__hint" data-image-upload-status></p>
                    </div>
                    <p class="help-hub-edit__hint">
                      JPG, PNG, or WebP from your computer. The address is filled in after the upload.
                    </p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-try-image-alt" class="help-hub-edit__label">Alt text</label>
                    <input
                      id="help-hub-try-image-alt"
                      class="help-hub-edit__input"
                      type="text"
                      name="tryImageAlt"
                      data-image-alt
                      value={supportAlt}
                    />
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-try-image-caption" class="help-hub-edit__label">Caption</label>
                    <textarea
                      id="help-hub-try-image-caption"
                      class="help-hub-edit__textarea"
                      name="tryImageCaption"
                      data-image-caption
                      rows="2">{supportCaption}</textarea>
                    <p class="help-hub-edit__hint">Shown under the supporting image.</p>
                  </div>
                  <button type="button" class="kbm-btn kbm-btn-outline" data-image-remove>
                    Remove image
                  </button>
                  <p class="help-hub-edit__hint">
                    Removing an image takes it off this entry only. The file stays on the site.
                  </p>
                </div>
              </details>

              <details
                class="admin-panel help-hub-dash__panel"
                data-editor-group="cta"
                open={ctaOpen ? true : undefined}
              >
                <summary class="help-hub-edit__summary">
                  <span class="help-hub-edit__summary-title">Call to action</span>
                  <span class="help-hub-edit__summary-note">Optional</span>
                </summary>
                <p class="help-hub-edit__kind">On the public page</p>
                <p class="help-hub-edit__section-intro">
                  Shown after Try This. Hidden until the button label and link are both filled in.
                </p>
                <div class="help-hub-edit__fields">
                  <div class="help-hub-edit__field">
                    <label for="help-hub-related-tool-eyebrow" class="help-hub-edit__label">Eyebrow</label>
                    <input
                      id="help-hub-related-tool-eyebrow"
                      class="help-hub-edit__input"
                      type="text"
                      name="relatedToolEyebrow"
                      value={ctaEyebrow}
                    />
                    <p class="help-hub-edit__hint">Small label at the top of the call to action.</p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-related-tool-title" class="help-hub-edit__label">Title</label>
                    <input
                      id="help-hub-related-tool-title"
                      class="help-hub-edit__input"
                      type="text"
                      name="relatedToolTitle"
                      value={ctaTitle}
                    />
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-related-tool-note" class="help-hub-edit__label">Note</label>
                    <textarea
                      id="help-hub-related-tool-note"
                      class="help-hub-edit__textarea"
                      name="relatedToolNote"
                      rows="2">{ctaNote}</textarea>
                    <p class="help-hub-edit__hint">Optional. Leave blank to hide the note.</p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-related-tool-label" class="help-hub-edit__label">Button label</label>
                    <input
                      id="help-hub-related-tool-label"
                      class="help-hub-edit__input"
                      type="text"
                      name="relatedToolLabel"
                      value={ctaLabel}
                    />
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-related-tool-url" class="help-hub-edit__label">Link</label>
                    <input
                      id="help-hub-related-tool-url"
                      class="help-hub-edit__input"
                      type="text"
                      name="relatedToolUrl"
                      value={ctaUrl}
                    />
                    <p class="help-hub-edit__hint">
                      A site path such as /reference/repairs, or a full https://knititnow.com link.
                      Opens in the same tab.
                    </p>
                  </div>
                </div>
              </details>

              <details
                class="admin-panel help-hub-dash__panel"
                data-editor-group="lessons"
                open={lessonsOpen ? true : undefined}
              >
                <summary class="help-hub-edit__summary">
                  <span class="help-hub-edit__summary-title">Related member lessons</span>
                  <span class="help-hub-edit__summary-note">Optional</span>
                </summary>
                <p class="help-hub-edit__kind">On the public page</p>
                <h2 id="complete-lesson-heading" class="help-hub-dash__panel-title">
                  Related member lessons
                </h2>
                <p class="help-hub-edit__section-intro">
                  Choose existing Knit It Now lessons for members who want the complete
                  demonstration. You do not need to create another lesson or enter a Vimeo ID.
                  Nothing is added to the public page when no lesson is selected.
                </p>
                <div class="help-hub-edit__fields">
                  <div class="help-hub-edit__field">
                    <label for="member-resources-search" class="help-hub-edit__label">
                      Find an existing lesson
                    </label>
                    <input id="help-hub-related-lessons" type="hidden" name="relatedLessons" value="" />
                    <input
                      id="help-hub-related-library"
                      type="hidden"
                      name="relatedLibraryVideos"
                      value=""
                    />
                    <input
                      id="help-hub-member-resource-order"
                      type="hidden"
                      name="memberResourceOrder"
                      value=""
                    />
                    <div class="related-lessons-picker" data-member-resource-picker>
                      <p class="related-lessons-picker__list-label" id="related-lessons-label">
                        Related Lessons
                      </p>
                      <ul
                        class="related-lessons-picker__selected"
                        id="member-resources-selected"
                        aria-labelledby="related-lessons-label"
                      ></ul>
                      <input
                        id="member-resources-search"
                        class="help-hub-edit__input"
                        type="search"
                        autocomplete="off"
                        placeholder="Search by lesson number, title, or URL"
                      />
                      <ul
                        class="related-lessons-picker__options"
                        id="member-resources-options"
                        aria-label="Matching Knit It Now lessons"
                        hidden
                      ></ul>
                      <p class="help-hub-edit__hint">
                        Search for a lesson, then select it to add it. You can add more than one.
                      </p>
                    </div>
                  </div>
                </div>
              </details>

              <section
                class="admin-panel help-hub-dash__panel help-hub-edit__group--admin"
                data-editor-group="publishing"
                aria-labelledby="publishing-heading"
              >
                <p class="help-hub-edit__kind help-hub-edit__kind--admin">Admin only</p>
                <h2 id="publishing-heading" class="help-hub-dash__panel-title">Publishing settings</h2>
                <p class="help-hub-edit__section-intro">
                  Not part of the public answer. Draft and Needs review stay private.
                </p>
                <div class="help-hub-edit__fields">
                  <div class="help-hub-edit__field">
                    <label for="help-hub-category" class="help-hub-edit__label">Category</label>
                    <select id="help-hub-category" class="help-hub-edit__select" name="category">
                      <option value="" selected={categoryValue === ""}>
                        — Select a category —
                      </option>
                      {categoryOptions.map((opt) => (
                        <option value={opt.key} selected={categoryValue === opt.key}>
                          {opt.label}
                        </option>
                      ))}
                      {showLegacyOption && (
                        <option value={categoryValue} selected>
                          {categoryValue} (legacy)
                        </option>
                      )}
                    </select>
                    <p class="help-hub-edit__hint">Used to group this entry in the Help Hub index.</p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-slug" class="help-hub-edit__label">URL name</label>
                    <input
                      id="help-hub-slug"
                      class="help-hub-edit__input"
                      type="text"
                      name="slug"
                      value={initialSlug}
                    />
                    <p class="help-hub-edit__hint">
                      Used in the page address. An existing entry keeps its address until you change
                      this. A new entry starts from the question.
                    </p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-status" class="help-hub-edit__label">Status</label>
                    <select id="help-hub-status" class="help-hub-edit__select" name="status">
                      <option value="draft" selected={statusValue === "draft"}>
                        Draft
                      </option>
                      <option value="review" selected={statusValue === "review"}>
                        Needs review
                      </option>
                      <option value="published" selected={statusValue === "published"}>
                        Published
                      </option>
                    </select>
                    <p class="help-hub-edit__hint">
                      Save draft does not publish. Update keeps a published entry published unless you
                      change this.
                    </p>
                  </div>
                  <div class="help-hub-edit__field help-hub-edit__field--checkbox">
                    <label class="help-hub-edit__checkbox-label">
                      <input
                        id="help-hub-is-new"
                        type="checkbox"
                        name="isNew"
                        checked={isNewChecked}
                      />
                      Show in “New in the Help Hub”
                    </label>
                    <p class="help-hub-edit__hint">Controls the New list on the Help Hub index.</p>
                  </div>
                </div>
              </section>

              <div class="help-hub-admin__form-actions help-hub-admin__form-actions--sticky">
                <button type="button" id="saveHelpHubBtn" class="kbm-btn kbm-btn-primary">
                  Save draft
                </button>
                <button type="button" id="publishHelpHubBtn" class="kbm-btn kbm-btn-outline">
                  Publish
                </button>
                {isEditing && (
                  <button type="button" id="deleteHelpHubBtn" class="kbm-btn kbm-btn-outline">
                    Delete
                  </button>
                )}
                <a href="/admin/help-hub" class="kbm-btn kbm-btn-outline">Cancel</a>
                <span id="saveHelpHubStatus" class="help-hub-edit__save-status" aria-live="polite"></span>
              </div>
              <p class="help-hub-edit__hint" id="helpHubSaveHint">
                Save draft keeps this private. Publish makes it public. Neither runs on its own.
              </p>
            </div>
          </form>
      </div>

      <aside class="help-hub-edit__preview" id="helpHubPreviewPane" aria-label="Public page preview">
        <div class="help-hub-edit__preview-head">
          <h2 class="help-hub-dash__panel-title">Public page</h2>
          <div class="help-hub-edit__audience" role="group" aria-label="Preview as">
            <button
              type="button"
              id="helpHubAudienceVisitor"
              class="help-hub-edit__audience-btn"
              data-preview-audience="visitor"
              aria-pressed="true"
            >
              Visitor
            </button>
            <button
              type="button"
              id="helpHubAudienceMember"
              class="help-hub-edit__audience-btn"
              data-preview-audience="member"
              aria-pressed="false"
            >
              Member
            </button>
          </div>
          <button type="button" id="previewHelpHub" class="kbm-btn kbm-btn-outline">
            Open full page
          </button>
          <p class="help-hub-edit__hint">
            Visitor and member change this preview only. They do not change who can open the saved page.
            Unsaved text stays in this private preview.
          </p>
          <span id="helpHubPreviewStatus" class="help-hub-edit__save-status" aria-live="polite"></span>
        </div>
        <p id="helpHubPreviewPlaceholder" class="help-hub-edit__preview-placeholder">
          Add a question to see the public page.
        </p>
        <iframe
          id="helpHubLivePreview"
          class="help-hub-edit__preview-frame"
          title="Help Hub public page preview"
          hidden
        ></iframe>
      </aside>
    </div>

  </main>

  <style>
    :global(body.help-hub-admin-body) {
      margin: 0;
    }

    .help-hub-admin {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 1.25rem 1.5rem 3rem;
      box-sizing: border-box;
    }

    .help-hub-admin__head {
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e2e8f0;
    }

    .help-hub-admin__title {
      margin: 0 0 0.35rem 0;
      font-size: 1.65rem;
      color: #243015;
    }

    .help-hub-admin__sub {
      margin: 0;
      font-size: 0.95rem;
      color: #475569;
      max-width: 56rem;
    }

    .help-hub-admin__toolbar {
      margin-bottom: 1.5rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem 1rem;
    }

    .help-hub-edit__open {
      display: grid;
      gap: 0.35rem;
      max-width: 42rem;
      margin-bottom: 1.25rem;
    }

    .help-hub-edit__open-list {
      max-width: none;
    }

    .help-hub-edit__chooser {
      display: grid;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    .help-hub-edit .help-hub-edit__create.kbm-btn {
      justify-self: start;
      font-size: 1.05rem;
      padding: 0.7rem 1.15rem;
    }

    .help-hub-edit__current {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem 0.7rem;
      margin: 0;
      padding: 0.75rem 0.9rem;
      border: 1px solid #c5d4a8;
      border-radius: 10px;
      background: #f4f7ef;
      color: #243015;
    }

    .help-hub-edit__current-kicker {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #3f6212;
    }

    .help-hub-edit__current strong {
      font-size: 1rem;
    }

    .help-hub-edit__status-pill {
      display: inline-block;
      padding: 0.12rem 0.55rem;
      border-radius: 999px;
      background: #fef3c7;
      color: #92400e;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .help-hub-edit__status-pill[data-status="published"] {
      background: #dcfce7;
      color: #166534;
    }

    .help-hub-edit__status-pill[data-status="review"] {
      background: #e2e8f0;
      color: #334155;
    }

    .help-hub-edit__status-pill[data-status="unsaved"] {
      background: #f1f5f9;
      color: #475569;
    }

    .help-hub-edit__chooser-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 1rem;
      align-items: stretch;
    }

    .help-hub-edit__chooser-box {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      min-width: 0;
      padding: 0.9rem 1rem 1rem;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      background: #fff;
    }

    .help-hub-edit__chooser-box--drafts {
      border-color: #52682d;
      box-shadow: inset 0 0 0 1px #52682d;
      background: #fbfcf8;
    }

    .help-hub-edit__chooser-title {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #243015;
    }

    .help-hub-edit__chooser-empty {
      margin: 0;
      font-size: 0.9rem;
      color: #64748b;
    }

    .help-hub-edit__chooser-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      max-height: 18rem;
      overflow: auto;
    }

    .help-hub-edit__chooser-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem;
      padding: 0.45rem 0.55rem;
      border: 1px solid transparent;
      border-radius: 8px;
    }

    .help-hub-edit__chooser-item.is-current {
      background: #eef4e6;
      border-color: #52682d;
    }

    .help-hub-edit__chooser-main {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      min-width: 0;
    }

    .help-hub-edit__chooser-label {
      font-size: 0.92rem;
      font-weight: 600;
      color: #1e293b;
    }

    .help-hub-edit__chooser-badge,
    .help-hub-edit__chooser-current {
      font-size: 0.75rem;
      font-weight: 700;
      color: #3f6212;
    }

    .help-hub-edit__chooser-badge {
      color: #475569;
    }

    .help-hub-edit .help-hub-edit__chooser-action.kbm-btn {
      flex-shrink: 0;
      padding: 0.28rem 0.7rem;
      font-size: 0.85rem;
      white-space: nowrap;
    }

    .help-hub-edit__chooser-item[hidden],
    .help-hub-edit__chooser-empty[hidden],
    .help-hub-edit__chooser-badge[hidden] {
      display: none;
    }

    @media (max-width: 800px) {
      .help-hub-edit__chooser-grid {
        grid-template-columns: 1fr;
      }
    }

    .help-hub-edit__recovery {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem 1rem;
      margin-bottom: 1.5rem;
      padding: 0.75rem 1rem;
      background: #fef9c3;
      border: 1px solid #fde047;
      border-radius: 10px;
    }

    .help-hub-edit__recovery[hidden] {
      display: none;
    }

    .help-hub-edit__recovery-text {
      font-size: 0.92rem;
      font-weight: 600;
      color: #713f12;
    }

    .help-hub-edit__recovery-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .admin-panel {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 1rem 1.1rem;
    }

    .help-hub-dash__sections {
      display: grid;
      gap: 1rem;
      grid-template-columns: 1fr;
    }

    .help-hub-edit__modes {
      display: flex;
      gap: 0.4rem;
      margin: 0 0 0.75rem;
    }

    .help-hub-edit__mode,
    .help-hub-edit__audience-btn {
      appearance: none;
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #334155;
      border-radius: 999px;
      padding: 0.35rem 0.8rem;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .help-hub-edit__mode[aria-selected="true"],
    .help-hub-edit__audience-btn[aria-pressed="true"] {
      background: #52682d;
      border-color: #52682d;
      color: #fff;
    }

    .help-hub-edit__workspace {
      display: block;
    }

    .help-hub-edit__editor,
    .help-hub-edit__preview {
      min-width: 0;
    }

    .help-hub-edit__preview {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 0.85rem;
    }

    .help-hub-edit__preview-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      margin-bottom: 0.75rem;
    }

    .help-hub-edit__preview-head .help-hub-dash__panel-title {
      margin: 0;
    }

    .help-hub-edit__preview-head .help-hub-edit__hint {
      flex-basis: 100%;
    }

    .help-hub-edit__audience {
      display: flex;
      gap: 0.35rem;
    }

    .help-hub-edit__preview-placeholder {
      margin: 0;
      padding: 2rem 1rem;
      text-align: center;
      color: #64748b;
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 12px;
    }

    .help-hub-edit__preview-frame {
      width: 100%;
      min-height: 70vh;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      background: #fff;
    }

    .help-hub-edit__preview-frame[hidden],
    .help-hub-edit__preview-placeholder[hidden],
    .help-hub-edit__thumb[hidden] {
      display: none;
    }

    @media (max-width: 1099px) {
      .help-hub-edit__workspace[data-mode="edit"] .help-hub-edit__preview {
        display: none;
      }

      .help-hub-edit__workspace[data-mode="preview"] .help-hub-edit__editor {
        display: none;
      }
    }

    @media (min-width: 1100px) {
      .help-hub-edit__modes {
        display: none;
      }

      .help-hub-edit__workspace {
        display: grid;
        grid-template-columns: minmax(340px, 420px) minmax(560px, 1fr);
        gap: 1rem;
        align-items: start;
      }

      .help-hub-edit__editor,
      .help-hub-edit__preview {
        max-height: calc(100vh - 12.5rem);
        overflow: auto;
        overscroll-behavior: contain;
      }

      .help-hub-edit__preview {
        position: sticky;
        top: 0.75rem;
        display: flex;
        flex-direction: column;
      }

      .help-hub-edit__preview-frame {
        flex: 1 1 auto;
        min-height: 640px;
      }
    }

    .help-hub-dash__panel-title {
      margin: 0 0 0.65rem 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #243015;
    }

    .help-hub-edit__section-intro {
      margin: 0 0 0.85rem;
      font-size: 0.95rem;
      color: #475569;
      line-height: 1.5;
    }

    .help-hub-dash__placeholder {
      margin: 0 0 1rem;
      font-size: 0.92rem;
      color: #64748b;
      line-height: 1.45;
    }

    .help-hub-edit__context {
      margin: 0.5rem 0 0 0;
      font-size: 0.85rem;
      color: #94a3b8;
      line-height: 1.4;
    }

    .help-hub-edit__form {
      margin: 0;
    }

    .help-hub-edit__fields {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .help-hub-edit__field {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .help-hub-edit__label {
      font-size: 0.92rem;
      font-weight: 700;
      color: #1e293b;
    }

    .help-hub-edit__kind {
      display: inline-block;
      margin: 0 0 0.45rem;
      padding: 0.15rem 0.45rem;
      border-radius: 999px;
      background: #eef4e6;
      color: #3f4b35;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .help-hub-edit__kind--admin {
      background: #e2e8f0;
      color: #334155;
    }

    .help-hub-edit__group--admin {
      background: #f8fafc;
    }

    .help-hub-edit__summary {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.75rem;
      cursor: pointer;
      font-weight: 700;
      color: #243015;
    }

    .help-hub-edit__summary-note {
      font-size: 0.8rem;
      font-weight: 600;
      color: #64748b;
    }

    details.admin-panel > .help-hub-edit__kind,
    details.admin-panel > .help-hub-edit__section-intro,
    details.admin-panel > .help-hub-edit__fields {
      margin-top: 0.75rem;
    }

    .help-hub-edit__thumb {
      width: 8.5rem;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #e2e8f0;
      background: #f8fafc;
    }

    .help-hub-edit__thumb img {
      display: block;
      width: 100%;
      height: 6rem;
      object-fit: cover;
    }

    .help-hub-edit__steps {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .help-hub-edit__step {
      display: grid;
