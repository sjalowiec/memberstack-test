---
import BaseLayout from "../../layouts/BaseLayout.astro";
import helpHubCategories from "../../data/help-hub-categories.json";
import videosPublic from "../../data/videos-public.json";
import { loadHelpHubTipBySlug } from "../../lib/helpHub/loadTips";
import { loadLessonsForAdmin } from "../../lib/lessons/loadLessons";
import type { HelpHubLessonRecord } from "../../lib/helpHubMemberLesson";
import {
  explanationForAdminForm,
  slugFromQuestion,
  tryStepsLinesForForm,
  tryThisIntroForForm,
} from "../../lib/helpHub/adminForm";
import { helpHubAdminEditorPayload } from "../../lib/helpHub/adminPageGate";
import {
  libraryVideosForPicker,
  memberLessonsForResourcePicker,
} from "../../lib/helpHub/memberResources";

export const prerender = false;

const slugParam = Astro.url.searchParams.get("slug");
const slug =
  typeof slugParam === "string" && slugParam.trim() !== "" ? slugParam.trim() : "";

const currentEntry = slug ? await loadHelpHubTipBySlug(slug) : null;
const isEditing = Boolean(currentEntry);

const lessonRecords = (await loadLessonsForAdmin()) as HelpHubLessonRecord[];
const libraryPickerItems = libraryVideosForPicker(Array.isArray(videosPublic) ? videosPublic : []);
const lessonPickerItems = memberLessonsForResourcePicker(lessonRecords);

const clientPayload = helpHubAdminEditorPayload({
  entry: currentEntry as Record<string, unknown> | null,
  lessons: lessonPickerItems,
  library: libraryPickerItems,
  allLessons: lessonRecords.map((lesson) => ({
    id: lesson.id,
    title: lesson.title,
    slug: lesson.slug,
    status: lesson.status,
  })),
});

const categoryOptions = (Array.isArray(helpHubCategories) ? helpHubCategories : []).reduce<
  { key: string; label: string }[]
>((acc, cat) => {
  const rec = cat as Record<string, unknown>;
  const key = typeof rec.key === "string" ? rec.key.trim() : "";
  if (!key) return acc;
  const label =
    typeof rec.label === "string" && rec.label.trim() !== "" ? rec.label.trim() : key;
  acc.push({ key, label });
  return acc;
}, []);

const pageTitle = isEditing
  ? "Edit Help Hub Entry | Knit it Now"
  : "Create Help Hub Entry | Knit it Now";

const rawEntry = currentEntry as Record<string, unknown> | null;

function stringifyValue(v: unknown): string {
  if (v === undefined || v === null) return "";
  if (Array.isArray(v)) return v.map(String).join("\n");
  if (typeof v === "object") return "";
  return String(v);
}

function valueFor(key: string, fallback = ""): string {
  if (!rawEntry) return fallback;
  if (key === "tryThis") return tryThisIntroForForm(rawEntry) || fallback;
  if (key === "trySteps") return tryStepsLinesForForm(rawEntry) || fallback;
  if (key === "solutionText") return explanationForAdminForm(rawEntry) || fallback;
  if (key === "slug" && !isEditing) return fallback;
  const v = rawEntry[key];
  if (v === undefined || v === null) return fallback;
  if (Array.isArray(v) || typeof v === "object") return fallback;
  return stringifyValue(v);
}

const statusValue = valueFor("status", "draft");
const categoryValue = valueFor("category", "");
const knownKeys = categoryOptions.map((opt) => opt.key);
const showLegacyOption = categoryValue !== "" && !knownKeys.includes(categoryValue);
const isNewChecked = rawEntry?.isNew === true;
const entryLabel = currentEntry as { question?: string; title?: string; slug?: string } | null;
const initialSlug = isEditing ? valueFor("slug", "") : slugFromQuestion(valueFor("question", ""));
---

<BaseLayout
  title={pageTitle}
  description="Write a public Help Hub answer and choose an existing member lesson."
  bodyClass="help-hub-admin-body"
>
  <main class="help-hub-admin help-hub-dash help-hub-edit">
    <header class="help-hub-admin__head">
      <h1 class="help-hub-admin__title">
        {isEditing ? "Edit Help Hub Entry" : "Create Help Hub Entry"}
      </h1>
      <p class="help-hub-admin__sub">
        Fill in the public answer, choose an existing lesson for members, then preview and
        publish.
      </p>
      <p class="help-hub-edit__context">
        {isEditing && entryLabel
          ? `Editing: ${entryLabel.question || entryLabel.title || entryLabel.slug || ""}`
          : "New entry"}
      </p>
    </header>

    <div class="help-hub-admin__toolbar help-hub-dash__toolbar">
      <a href="/admin/help-hub" class="kbm-btn kbm-btn-outline">Back to Help Hub Admin</a>
      <span id="saveHelpHubStatusTop" class="help-hub-edit__save-status" aria-live="polite"></span>
    </div>

          <div id="helpHubDraftRecovery" class="help-hub-edit__recovery" role="alert" hidden>
            <span class="help-hub-edit__recovery-text">Recovered unsaved draft available.</span>
            <div class="help-hub-edit__recovery-actions">
              <button type="button" id="helpHubRestoreDraft" class="kbm-btn kbm-btn-primary">
                Restore Draft
              </button>
              <button type="button" id="helpHubDiscardDraft" class="kbm-btn kbm-btn-outline">
                Discard Draft
              </button>
            </div>
          </div>

          <form class="help-hub-edit__form" novalidate>
            <div class="help-hub-edit__sections help-hub-dash__sections">
              <section class="admin-panel help-hub-dash__panel" aria-labelledby="free-answer-heading">
                <h2 id="free-answer-heading" class="help-hub-dash__panel-title">
                  Free Answer: Everyone Sees This
                </h2>
                <p class="help-hub-edit__section-intro">
                  This information appears on the public Help Hub page.
                </p>
                <div class="help-hub-edit__fields">
                  <div class="help-hub-edit__field">
                    <label for="help-hub-question" class="help-hub-edit__label">Question</label>
                    <textarea
                      id="help-hub-question"
                      class="help-hub-edit__textarea"
                      name="question"
                      rows="3">{valueFor("question", "")}</textarea>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-bubble" class="help-hub-edit__label">Short answer</label>
                    <textarea
                      id="help-hub-bubble"
                      class="help-hub-edit__textarea"
                      name="bubbleAnswer"
                      rows="3">{valueFor("bubbleAnswer", "")}</textarea>
                    <p class="help-hub-edit__hint">The quick answer shown in the speech bubble.</p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-hook" class="help-hub-edit__label">One-line hook</label>
                    <textarea
                      id="help-hub-hook"
                      class="help-hub-edit__textarea"
                      name="hook"
                      rows="2">{valueFor("hook", "")}</textarea>
                    <p class="help-hub-edit__hint">A short introduction above the question and answer.</p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-about-title" class="help-hub-edit__label">
                      Explanation heading
                    </label>
                    <input
                      id="help-hub-about-title"
                      class="help-hub-edit__input"
                      type="text"
                      name="aboutTitle"
                      value={valueFor("aboutTitle", "")}
                    />
                    <p class="help-hub-edit__hint">
                      Leave blank to use the default heading, “Why This Works.”
                    </p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-solution-text" class="help-hub-edit__label">Explanation</label>
                    <textarea
                      id="help-hub-solution-text"
                      class="help-hub-edit__textarea"
                      name="solutionText"
                      rows="6">{valueFor("solutionText", "")}</textarea>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-try-this-intro" class="help-hub-edit__label">
                      Try This introduction
                    </label>
                    <textarea
                      id="help-hub-try-this-intro"
                      class="help-hub-edit__textarea"
                      name="tryThis"
                      rows="2">{valueFor("tryThis", "")}</textarea>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-try-steps" class="help-hub-edit__label">Try This steps</label>
                    <textarea
                      id="help-hub-try-steps"
                      class="help-hub-edit__textarea"
                      name="trySteps"
                      rows="8">{valueFor("trySteps", "")}</textarea>
                    <p class="help-hub-edit__hint">One step per line.</p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-try-note" class="help-hub-edit__label">
                      Important note, optional
                    </label>
                    <textarea
                      id="help-hub-try-note"
                      class="help-hub-edit__textarea"
                      name="tryNote"
                      rows="3">{valueFor("tryNote", "")}</textarea>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-try-image" class="help-hub-edit__label">
                      Optional supporting image URL
                    </label>
                    <input
                      id="help-hub-try-image"
                      class="help-hub-edit__input"
                      type="text"
                      name="tryImage"
                      value={valueFor("tryImage", "")}
                    />
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-try-image-alt" class="help-hub-edit__label">
                      Image alt text
                    </label>
                    <input
                      id="help-hub-try-image-alt"
                      class="help-hub-edit__input"
                      type="text"
                      name="tryImageAlt"
                      value={valueFor("tryImageAlt", "")}
                    />
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-try-image-caption" class="help-hub-edit__label">
                      Image caption
                    </label>
                    <textarea
                      id="help-hub-try-image-caption"
                      class="help-hub-edit__textarea"
                      name="tryImageCaption"
                      rows="2">{valueFor("tryImageCaption", "")}</textarea>
                  </div>
                </div>
              </section>

              <section
                class="admin-panel help-hub-dash__panel"
                aria-labelledby="complete-lesson-heading"
              >
                <h2 id="complete-lesson-heading" class="help-hub-dash__panel-title">
                  Complete Lesson: Members Only
                </h2>
                <p class="help-hub-edit__section-intro">
                  Choose an existing Knit It Now lesson for members who want the complete
                  demonstration. You do not need to create another lesson or enter a Vimeo ID.
                </p>
                <div class="help-hub-edit__fields">
                  <div class="help-hub-edit__field">
                    <label for="member-resources-search" class="help-hub-edit__label">
                      Find an existing lesson
                    </label>
                    <input id="help-hub-related-lessons" type="hidden" name="relatedLessons" value="" />
                    <input
                      id="help-hub-related-library"
                      type="hidden"
                      name="relatedLibraryVideos"
                      value=""
                    />
                    <div class="related-lessons-picker" data-member-resource-picker>
                      <ul
                        class="related-lessons-picker__selected"
                        id="member-resources-selected"
                        aria-label="Selected member lessons"
                      ></ul>
                      <input
                        id="member-resources-search"
                        class="help-hub-edit__input"
                        type="search"
                        autocomplete="off"
                        placeholder="Search by lesson number or title, for example 1027"
                      />
                      <ul
                        class="related-lessons-picker__options"
                        id="member-resources-options"
                        aria-label="Existing Knit It Now lessons"
                      ></ul>
                      <p class="help-hub-edit__hint">
                        Search the Learning Library and member lessons by number, title, or URL name.
                      </p>
                    </div>
                  </div>
                </div>
              </section>

              <section class="admin-panel help-hub-dash__panel" aria-labelledby="find-this-heading">
                <h2 id="find-this-heading" class="help-hub-dash__panel-title">
                  Help People Find This
                </h2>
                <div class="help-hub-edit__fields">
                  <div class="help-hub-edit__field">
                    <label for="help-hub-category" class="help-hub-edit__label">Category</label>
                    <select id="help-hub-category" class="help-hub-edit__select" name="category">
                      <option value="" selected={categoryValue === ""}>
                        — Select a category —
                      </option>
                      {categoryOptions.map((opt) => (
                        <option value={opt.key} selected={categoryValue === opt.key}>
                          {opt.label}
                        </option>
                      ))}
                      {showLegacyOption && (
                        <option value={categoryValue} selected>
                          {categoryValue} (legacy)
                        </option>
                      )}
                    </select>
                  </div>
                  <div class="help-hub-edit__field help-hub-edit__field--checkbox">
                    <label class="help-hub-edit__checkbox-label">
                      <input
                        id="help-hub-is-new"
                        type="checkbox"
                        name="isNew"
                        checked={isNewChecked}
                      />
                      Show in “New in the Help Hub”
                    </label>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-slug" class="help-hub-edit__label">URL name</label>
                    <input
                      id="help-hub-slug"
                      class="help-hub-edit__input"
                      type="text"
                      name="slug"
                      value={initialSlug}
                    />
                    <p class="help-hub-edit__hint">
                      Used in the page address. For a new entry it is created from the question; you
                      can still edit it.
                    </p>
                  </div>
                  <div class="help-hub-edit__field">
                    <label for="help-hub-status" class="help-hub-edit__label">Status</label>
                    <select id="help-hub-status" class="help-hub-edit__select" name="status">
                      <option value="draft" selected={statusValue === "draft"}>
                        Draft
                      </option>
                      <option value="review" selected={statusValue === "review"}>
                        Needs review
                      </option>
                      <option value="published" selected={statusValue === "published"}>
                        Published
                      </option>
                    </select>
                  </div>
                </div>
              </section>

              <section
                class="admin-panel help-hub-dash__panel"
                aria-labelledby="preview-publish-heading"
              >
                <h2 id="preview-publish-heading" class="help-hub-dash__panel-title">
                  Preview and Publish
                </h2>
                <p class="help-hub-edit__section-intro">
                  Preview the public page, then save. Drafts stay private until you publish.
                </p>
              </section>

              <div class="help-hub-admin__form-actions help-hub-admin__form-actions--sticky">
                <button type="button" id="saveHelpHubBtn" class="kbm-btn kbm-btn-primary">
                  Save draft
                </button>
                <button type="button" id="previewHelpHub" class="kbm-btn kbm-btn-outline">
                  Preview
                </button>
                {isEditing && (
                  <button type="button" id="deleteHelpHubBtn" class="kbm-btn kbm-btn-outline">
                    Delete
                  </button>
                )}
                <a href="/admin/help-hub" class="kbm-btn kbm-btn-outline">Cancel</a>
                <button type="button" id="helpHubAdminSignIn" class="kbm-btn kbm-btn-outline" hidden>
                  Sign in
                </button>
                <span id="saveHelpHubStatus" class="help-hub-edit__save-status" aria-live="polite"></span>
              </div>
            </div>
          </form>
  </main>

  <style>
    :global(body.help-hub-admin-body) {
      margin: 0;
    }

    .help-hub-admin {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 1.25rem 1.5rem 3rem;
      box-sizing: border-box;
    }

    .help-hub-admin__head {
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e2e8f0;
    }

    .help-hub-admin__title {
      margin: 0 0 0.35rem 0;
      font-size: 1.65rem;
      color: #243015;
    }

    .help-hub-admin__sub {
      margin: 0;
      font-size: 0.95rem;
      color: #475569;
      max-width: 56rem;
    }

    .help-hub-admin__toolbar {
      margin-bottom: 1.5rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem 1rem;
    }

    .help-hub-edit__recovery {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem 1rem;
      margin-bottom: 1.5rem;
      padding: 0.75rem 1rem;
      background: #fef9c3;
      border: 1px solid #fde047;
      border-radius: 10px;
    }

    .help-hub-edit__recovery[hidden] {
      display: none;
    }

    .help-hub-edit__recovery-text {
      font-size: 0.92rem;
      font-weight: 600;
      color: #713f12;
    }

    .help-hub-edit__recovery-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .admin-panel {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 1rem 1.1rem;
    }

    .help-hub-dash__sections {
      display: grid;
      gap: 1rem;
      grid-template-columns: 1fr;
    }

    .help-hub-edit__sections {
      max-width: 56rem;
    }

    .help-hub-dash__panel-title {
      margin: 0 0 0.65rem 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #243015;
    }

    .help-hub-edit__section-intro {
      margin: 0 0 0.85rem;
      font-size: 0.95rem;
      color: #475569;
      line-height: 1.5;
    }

    .help-hub-dash__placeholder {
      margin: 0 0 1rem;
      font-size: 0.92rem;
      color: #64748b;
      line-height: 1.45;
    }

    .help-hub-edit__context {
      margin: 0.5rem 0 0 0;
      font-size: 0.85rem;
      color: #94a3b8;
      line-height: 1.4;
    }

    .help-hub-edit__form {
      margin: 0;
    }

    .help-hub-edit__fields {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .help-hub-edit__field {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .help-hub-edit__label {
      font-size: 0.8rem;
      font-weight: 600;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .help-hub-edit__checkbox-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.95rem;
      color: #1e293b;
      font-weight: 600;
    }

    .help-hub-edit__input,
    .help-hub-edit__select,
    .help-hub-edit__textarea {
      font-size: 0.92rem;
      line-height: 1.45;
      color: #1e293b;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 0.45rem 0.55rem;
      background: #fff;
      box-sizing: border-box;
      width: 100%;
      font-family: inherit;
    }

    .help-hub-edit__textarea {
      resize: vertical;
      min-height: 2.5rem;
    }

    .help-hub-edit__select {
      max-width: 20rem;
    }

    .help-hub-edit__hint {
      margin: 0;
      font-size: 0.85rem;
      color: #64748b;
      line-height: 1.4;
    }

    .help-hub-edit__save-status {
      font-size: 0.9rem;
      color: #475569;
      align-self: center;
      min-height: 1.2em;
    }

    .help-hub-edit__save-status.is-error {
      color: #b91c1c;
    }

    .help-hub-edit__save-status.is-ok {
      color: #166534;
    }

    .help-hub-admin__form-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1.1rem;
      align-items: center;
    }

    .help-hub-admin__form-actions--sticky {
      position: sticky;
      bottom: 0;
      z-index: 8;
      padding: 0.6rem 0;
      margin-top: 1rem;
      background: linear-gradient(to top, #fff 78%, rgba(255, 255, 255, 0));
      border-top: 1px solid #e5e7eb;
    }

    .related-lessons-picker__selected,
    .related-lessons-picker__options {
      list-style: none;
      margin: 0 0 0.65rem;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .related-lessons-picker__options {
      max-height: 16rem;
      overflow: auto;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 0.35rem;
      background: #fff;
    }

    .related-lessons-picker__option,
    .related-lessons-picker__chip,
    .member-resource-picker__card {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.4rem 0.5rem;
      border-radius: 6px;
    }

    .related-lessons-picker__option {
      cursor: pointer;
    }

    .related-lessons-picker__option:hover,
    .related-lessons-picker__option.is-selected {
      background: #f1f5f0;
    }

    .related-lessons-picker__title {
      font-size: 0.92rem;
      font-weight: 600;
      color: #1e293b;
    }

    .related-lessons-picker__id {
      font-size: 0.8rem;
      color: #64748b;
      white-space: nowrap;
    }

    .member-resource-picker__card {
      flex-direction: column;
      align-items: stretch;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
    }

    .member-resource-picker__card.is-missing,
    .member-resource-picker__card.is-unpublished {
      background: #fef2f2;
      border-color: #fecaca;
    }

    .member-resource-picker__confirm {
      margin: 0;
      font-size: 0.95rem;
      font-weight: 600;
      color: #1e293b;
    }

    .member-resource-picker__source {
      margin: 0;
      font-size: 0.85rem;
      color: #64748b;
    }

    .related-lessons-picker__warn {
      font-size: 0.8rem;
      color: #b91c1c;
      margin: 0.15rem 0 0;
    }

    .related-lessons-picker__remove {
      appearance: none;
      background: none;
      border: 0;
      color: #64748b;
      cursor: pointer;
      font: inherit;
      font-weight: 600;
      align-self: flex-end;
    }
  </style>

  <script
    type="application/json"
    id="help-hub-current-entry"
    set:html={JSON.stringify(clientPayload.entry ?? null).replace(/</g, "\\u003c")}
  />
  <script
    type="application/json"
    id="help-hub-member-resource-data"
    set:html={JSON.stringify(clientPayload.picker).replace(/</g, "\\u003c")}
  />

  <script>
    import { installHelpHubAdminBrowser } from "../../lib/helpHub/adminEditorClient";
    import { bootHelpHubAdminEditor } from "../../lib/helpHub/adminEditorFormClient";

    installHelpHubAdminBrowser();
    bootHelpHubAdminEditor();
  </script>
</BaseLayout>
