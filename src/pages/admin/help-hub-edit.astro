      resize: vertical;
      min-height: 2.5rem;
    }

    .help-hub-edit__select {
      max-width: 20rem;
    }

    .help-hub-edit__hint {
      margin: 0;
      font-size: 0.85rem;
      color: #94a3b8;
      line-height: 1.4;
    }

