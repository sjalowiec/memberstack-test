      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      margin-bottom: 0.5rem;
    }

    .help-hub-edit__json-preview-actions:last-of-type {
      margin-bottom: 0.65rem;
    }

    .help-hub-edit__copy-status {
      font-size: 0.85rem;
      color: #16a34a;
      min-height: 1.2em;
