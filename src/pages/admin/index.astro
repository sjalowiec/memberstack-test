---
import BaseLayout from "../../layouts/BaseLayout.astro";

type DashCard = {
  href: string;
  label: string;
  description: string;
};

type DashSection = {
  id: string;
  title: string;
  cards: DashCard[];
};

const sections: DashSection[] = [
  {
    id: "content-admin",
    title: "Content Admin",
    cards: [
      {
        href: "/admin/help-hub",
        label: "Help Hub Admin",
        description:
          "View, edit, preview, and save Help Hub entries.",
      },
      {
        href: "/admin/help-hub-edit",
        label: "Create Help Hub Entry",
        description: "Start a new Help Hub entry.",
      },
      {
        href: "/admin/lessons",
        label: "Lessons Admin",
        description: "View and manage lesson entries.",
      },
      {
        href: "/admin/lessons-edit",
        label: "Create Lesson",
        description:
          "Create or edit a lesson with preview and JSON save prompt.",
      },
      {
        href: "/admin/bookshelf-editor",
        label: "Bookshelf Editor",
        description:
          "Edit the Machine Knitter's Bookshelf catalog (bookshelf.json) — titles, authors, tags, links, and covers.",
      },
      {
        href: "/admin/machines",
        label: "Machine Database",
        description:
          "Add, edit, and review machine records, images, manuals, accessories, and technique assignments.",
      },
    ],
  },
  {
    id: "private-project-workspaces",
    title: "Private Project Workspaces",
    cards: [
      {
        href: "/admin/private-projects",
        label: "Manage Projects",
        description:
          "Create and manage custom knitter project pages with videos, downloads, and conversation.",
      },
    ],
  },
  {
    id: "reporting",
    title: "Reporting",
    cards: [
      {
        href: "/admin/reports/membership",
        label: "Membership & Revenue",
        description:
          "Active members by plan, new members, cancellations, and an MRR/ARR estimate (live Memberstack snapshot).",
      },
      {
        href: "/admin/bookshelf-activity",
        label: "Bookshelf Activity",
        description:
          "Machine Knitter's Bookshelf usage — views, searches, filters, and My Library adds.",
      },
      {
        href: "/admin/bookshelf-suggestions",
        label: "Bookshelf Suggestions",
        description:
          "Review reader-submitted books — approve, reject, edit, or delete pending suggestions.",
      },
    ],
  },
  {
    id: "legacy-admin",
    title: "Legacy Admin",
    cards: [
      {
        href: "/admin/videos-admin",
        label: "Videos Admin",
        description: "Existing video admin.",
      },
      {
        href: "/admin/videos/access",
        label: "Video Access Manager",
        description:
          "Audit all catalog videos and edit access_level (public, member, draft) in one sortable table.",
      },
      {
        href: "/admin/glossary",
        label: "Glossary Admin",
        description: "Existing glossary admin.",
      },
      {
        href: "/admin/legacy-ebook-lookup",
        label: "Legacy eBook Lookup",
        description:
          "Look up legacy eBook purchases and download records.",
      },
      {
        href: "/admin/course-content",
        label: "Legacy Course Content",
        description:
          "Edit richText HTML in LK-150 course POC JSON with preview, cleanup tools, and backup on save.",
      },
      {
        href: "/admin/embedded-tools",
        label: "Tools Admin",
        description:
          "Manage every site tool — status, category, member access, and course-embedding metadata.",
      },
    ],
  },
  {
    id: "utilities",
    title: "Utilities",
    cards: [
      {
        href: "/stitch",
        label: "Stitch Browser",
        description: "Browse stitch patterns and filtered views.",
      },
      {
        href: "/stitch?machine=lk150&category=tuck",
        label: "LK150 Tuck Stitches",
        description:
          "Direct filtered view for LK150-friendly tuck stitches.",
      },
    ],
  },
];
---

<BaseLayout
  title="Creator Control Panel | Knit it Now"
  description="Admin dashboard for creating and managing Knit It Now content."
  bodyClass="admin-dash-body"
>
  <main class="admin-dash">
    <header class="admin-dash__head">
      <h1 class="admin-dash__title">Creator Control Panel</h1>
      <p class="admin-dash__intro">
        A clean starting point for creating and managing Knit It Now content.
      </p>
    </header>

    <section class="admin-dash__section" aria-labelledby="env-status-heading">
      <h2 id="env-status-heading" class="admin-dash__section-title">
        Environment Status
      </h2>
      <div class="admin-dash__env-card">
        <dl class="admin-dash__env-list">
          <div class="admin-dash__env-row">
            <dt class="admin-dash__env-label">Environment</dt>
            <dd class="admin-dash__env-value">
              <span class="admin-dash__env-badge" data-env-environment>Detecting…</span>
            </dd>
          </div>
          <div class="admin-dash__env-row">
            <dt class="admin-dash__env-label">Memberstack Mode</dt>
            <dd class="admin-dash__env-value">
              <span class="admin-dash__env-badge" data-env-ms-mode>Detecting…</span>
            </dd>
          </div>
          <div class="admin-dash__env-row">
            <dt class="admin-dash__env-label">Logged In User</dt>
            <dd class="admin-dash__env-value" data-env-user>Checking…</dd>
          </div>
        </dl>
      </div>
    </section>

    {
      sections.map((section) => (
        <section
          class="admin-dash__section"
          aria-labelledby={`${section.id}-heading`}
        >
          <h2 id={`${section.id}-heading`} class="admin-dash__section-title">
            {section.title}
          </h2>
          <div class="admin-dash__grid">
            {section.cards.map((card) => (
              <a class="admin-dash__card" href={card.href}>
                <span class="admin-dash__card-label">{card.label}</span>
                <span class="admin-dash__card-desc">{card.description}</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <section
      class="admin-dash__section"
      aria-labelledby="pattern-activity-heading"
    >
      <h2 id="pattern-activity-heading" class="admin-dash__section-title">
        Pattern Activity
      </h2>
      <div class="admin-dash__activity">
        <div class="admin-dash__activity-filters" data-activity-filters>
          <label class="admin-dash__activity-filter">
            <span>Date</span>
            <select data-activity-date-preset>
              <option value="today">Today</option>
              <option value="week" selected>This Week</option>
              <option value="month">This Month</option>
              <option value="all">All</option>
              <option value="custom">Custom range</option>
            </select>
          </label>
          <label class="admin-dash__activity-filter" data-activity-custom-range hidden>
            <span>From</span>
            <input type="date" data-activity-date-from />
          </label>
          <label class="admin-dash__activity-filter" data-activity-custom-range hidden>
            <span>To</span>
            <input type="date" data-activity-date-to />
          </label>
          <label class="admin-dash__activity-filter">
            <span>Pattern system</span>
            <select data-activity-system>
              <option value="">All</option>
              <option value="hat">Hat</option>
              <option value="sleeveless">Sleeveless</option>
              <option value="drop-shoulder">Drop Shoulder</option>
            </select>
          </label>
          <label class="admin-dash__activity-filter">
            <span>Membership</span>
            <select data-activity-membership>
              <option value="all">All</option>
              <option value="free">Free</option>
              <option value="member">Member</option>
              <option value="unknown">Unknown</option>
            </select>
          </label>
          <label class="admin-dash__activity-filter">
            <span>Event</span>
            <select data-activity-event>
              <option value="">All</option>
            </select>
          </label>
        </div>

        <div class="admin-dash__stats">
          <div class="admin-dash__stat">
            <span class="admin-dash__stat-value" data-activity-total>—</span>
            <span class="admin-dash__stat-label">Total events</span>
          </div>
          <div class="admin-dash__stat">
            <span class="admin-dash__stat-value" data-activity-users>—</span>
            <span class="admin-dash__stat-label">Unique users</span>
          </div>
          <div class="admin-dash__stat">
            <span class="admin-dash__stat-value" data-activity-generated>—</span>
            <span class="admin-dash__stat-label">Generated patterns</span>
          </div>
          <div class="admin-dash__stat">
            <span class="admin-dash__stat-value" data-activity-saved>—</span>
            <span class="admin-dash__stat-label">Saved patterns</span>
          </div>
        </div>

        <p class="admin-dash__activity-status" data-activity-status>
          Loading recent activity…
        </p>
        <p class="admin-dash__activity-note" data-activity-note hidden></p>

        <div class="admin-dash__table-wrap" data-activity-table-wrap hidden>
          <table class="admin-dash__table admin-dash__table--sortable">
            <thead>
              <tr>
                <th scope="col">
                  <button type="button" data-activity-sort="createdAt">Created</button>
                </th>
                <th scope="col">
                  <button type="button" data-activity-sort="userEmail">User email</button>
                </th>
                <th scope="col">
                  <button type="button" data-activity-sort="membership">Membership</button>
                </th>
                <th scope="col">
                  <button type="button" data-activity-sort="eventType">Event</button>
                </th>
                <th scope="col">
                  <button type="button" data-activity-sort="patternSystem">Pattern system</button>
                </th>
                <th scope="col">
                  <button type="button" data-activity-sort="patternTitle">Pattern title</button>
                </th>
              </tr>
            </thead>
            <tbody data-activity-rows></tbody>
          </table>
        </div>
        <div class="admin-dash__activity-pager" data-activity-pager hidden>
          <button type="button" class="admin-dash__activity-page-btn" data-activity-prev>
            Previous
          </button>
          <span data-activity-page-label></span>
          <button type="button" class="admin-dash__activity-page-btn" data-activity-next>
            Next
          </button>
        </div>
      </div>
    </section>

    <section
      class="admin-dash__section"
      aria-labelledby="video-jump-link-heading"
    >
      <h2 id="video-jump-link-heading" class="admin-dash__section-title">
        Video Jump Link Generator
      </h2>
      <div class="admin-dash__tool-card">
        <label class="admin-dash__tool-label" for="vjl-input">
          Timestamps and labels
        </label>
        <textarea
          id="vjl-input"
          class="admin-dash__tool-textarea"
          rows="8"
          placeholder="00:00 Introduction&#10;01:12 Cast on&#10;03:23 Neckline shaping"
          spellcheck="false"
        ></textarea>
        <p class="admin-dash__tool-hint">
          Paste one timestamp + label per line.
        </p>
        <fieldset class="admin-dash__tool-format">
          <legend class="admin-dash__tool-label">Output format</legend>
          <label class="admin-dash__tool-format-option">
            <input
              type="radio"
              name="vjl-format"
              value="html"
              checked
            />
            <span class="admin-dash__tool-format-name">HTML Buttons</span>
            <span class="admin-dash__tool-format-desc">
              For rendered pattern sections and inline HTML output.
            </span>
          </label>
          <label class="admin-dash__tool-format-option">
            <input type="radio" name="vjl-format" value="js" />
            <span class="admin-dash__tool-format-name">JS jumpLinks Array</span>
            <span class="admin-dash__tool-format-desc">
              For shared video configuration objects such as
              sleevelessPatternPageShared.ts
            </span>
          </label>
        </fieldset>
        <div class="admin-dash__tool-actions">
          <button type="button" class="admin-dash__tool-btn" id="vjl-generate">
            Generate Output
          </button>
          <button
            type="button"
            class="admin-dash__tool-btn admin-dash__tool-btn--secondary"
            id="vjl-copy"
            disabled
          >
            Copy Output
          </button>
          <span class="admin-dash__tool-copied" id="vjl-copied" hidden>
            Copied!
          </span>
        </div>
        <label class="admin-dash__tool-label" for="vjl-output"
          >Generated Output</label
        >
        <textarea
          id="vjl-output"
          class="admin-dash__tool-textarea admin-dash__tool-textarea--output"
          rows="8"
          readonly
          placeholder="Generated output appears here…"
          spellcheck="false"
        ></textarea>
        <p class="admin-dash__tool-hint admin-dash__tool-hint--output">
          HTML Buttons are used in rendered pattern markup. JS jumpLinks
          entries are pasted into shared video config objects.
        </p>
      </div>
    </section>

    <section
      class="admin-dash__section"
      aria-labelledby="sleeveless-reset-heading"
      id="sleeveless-reset-section"
      hidden
    >
      <h2 id="sleeveless-reset-heading" class="admin-dash__section-title">
        Sleeveless Pattern Access Reset
      </h2>
      <div class="admin-dash__tool-card admin-dash__tool-card--danger">
        <p class="admin-dash__tool-badge">
          Support / admin utility — not a customer-facing feature
        </p>
        <p class="admin-dash__tool-hint">
          Look up a member by email and reset their one-time free Sleeveless
          Pattern build claim.
        </p>

        <form class="admin-dash__lookup" id="sleeveless-lookup-form">
          <label class="admin-dash__tool-label" for="sleeveless-lookup-email">
            Member email
          </label>
          <div class="admin-dash__lookup-row">
            <input
              type="email"
              id="sleeveless-lookup-email"
              class="admin-dash__tool-input"
              placeholder="member@example.com"
              autocomplete="off"
              spellcheck="false"
              required
            />
            <button type="submit" class="admin-dash__tool-btn" id="sleeveless-lookup-btn">
              Look up
            </button>
          </div>
        </form>

        <div class="admin-dash__lookup-result" id="sleeveless-lookup-result" hidden>
          <dl class="admin-dash__lookup-list">
            <div class="admin-dash__lookup-item">
              <dt class="admin-dash__lookup-key">Name</dt>
              <dd class="admin-dash__lookup-val" data-result-name>—</dd>
            </div>
            <div class="admin-dash__lookup-item">
              <dt class="admin-dash__lookup-key">Email</dt>
              <dd class="admin-dash__lookup-val" data-result-email>—</dd>
            </div>
            <div class="admin-dash__lookup-item">
              <dt class="admin-dash__lookup-key">Member ID</dt>
              <dd class="admin-dash__lookup-val" data-result-id>—</dd>
            </div>
            <div class="admin-dash__lookup-item">
              <dt class="admin-dash__lookup-key">Free claim used</dt>
              <dd class="admin-dash__lookup-val" data-result-claimed>—</dd>
            </div>
            <div class="admin-dash__lookup-item">
              <dt class="admin-dash__lookup-key">Free claim pattern ID</dt>
              <dd class="admin-dash__lookup-val" data-result-pattern-id>—</dd>
            </div>
          </dl>
          <div class="admin-dash__tool-actions">
            <button
              type="button"
              class="admin-dash__tool-btn"
              id="sleeveless-reset-btn"
            >
              Reset free Sleeveless claim
            </button>
          </div>
        </div>

        <p
          class="admin-dash__tool-status"
          id="sleeveless-reset-status"
          role="status"
          aria-live="polite"
          hidden
        ></p>
      </div>
    </section>
  </main>

  <script>
    import {
      detectMemberstackMode,
      detectSiteEnvironment,
      memberstackModeLabel,
      siteEnvironmentLabel,
    } from "../../lib/env/siteEnvironment";
    import { memberEmailFromMemberstackPayload as envMemberEmail } from "../../lib/patterns/memberstackMember";

    function applyEnvStatus(): void {
      const envEl = document.querySelector("[data-env-environment]");
      if (envEl instanceof HTMLElement) {
        const env = detectSiteEnvironment(window.location.hostname, {
          publicSiteEnv: import.meta.env.PUBLIC_SITE_ENV,
          isViteDev: import.meta.env.DEV,
        });
        envEl.textContent = siteEnvironmentLabel(env);
        envEl.dataset.envState = env;
      }
    }

    function applyMemberstackMode(): void {
      const modeEl = document.querySelector("[data-env-ms-mode]");
      if (modeEl instanceof HTMLElement) {
        const mode = detectMemberstackMode(window);
        modeEl.textContent = memberstackModeLabel(mode);
        modeEl.dataset.modeState = mode;
      }
    }

    async function applyLoggedInUser(): Promise<void> {
      const userEl = document.querySelector("[data-env-user]");
      if (!(userEl instanceof HTMLElement)) return;
      try {
        const ms = window.$memberstackDom;
        if (!ms?.getCurrentMember) {
          userEl.textContent = "Memberstack unavailable";
          return;
        }
        const payload = await ms.getCurrentMember();
        const email = envMemberEmail(payload);
        userEl.textContent = email || "Not signed in";
      } catch {
        userEl.textContent = "Unknown";
      }
    }

    applyEnvStatus();
    // Memberstack loads asynchronously; retry the mode + user reads briefly.
    let envAttempts = 0;
    const envTimer = window.setInterval(() => {
      envAttempts += 1;
      applyMemberstackMode();
      void applyLoggedInUser();
      if (window.$memberstackDom?.getCurrentMember || envAttempts >= 25) {
        window.clearInterval(envTimer);
      }
    }, 200);
  </script>

  <script>
    import {
      summarizePatternActivity,
      PATTERN_ACTIVITY_LOG_ENDPOINT,
      type PatternActivityEvent,
    } from "../../lib/patterns/patternActivityLog";
    import {
      authHeadersForCustomPatternProjects,
      resolveCustomPatternProjectAuth,
    } from "../../lib/patterns/customPatternProjectAuth";
    import { memberEmailFromMemberstackPayload } from "../../lib/patterns/memberstackMember";
    import {
      activityMembershipDisplay,
      dateRangeForPreset,
      DEFAULT_PATTERN_ACTIVITY_FILTERS,
      filterPatternActivityEvents,
      patternActivityEventLabel,
      patternActivityEventTypeOptions,
      patternActivitySystemLabel,
      patternActivitySystemFilterOptions,
      sortPatternActivityEvents,
      type PatternActivityDatePreset,
      type PatternActivityReportFilters,
      type PatternActivitySortDirection,
      type PatternActivitySortKey,
    } from "../../lib/patterns/patternActivityReport";

    const PAGE_SIZE = 50;
    const FETCH_LIMIT = 2000;

    let loadedEvents: PatternActivityEvent[] = [];
    let truncated = false;
    let sortKey: PatternActivitySortKey = "createdAt";
    let sortDirection: PatternActivitySortDirection = "desc";
    let page = 0;

    function setText(selector: string, value: string): void {
      const el = document.querySelector(selector);
      if (el instanceof HTMLElement) el.textContent = value;
    }

    function setStatus(message: string): void {
      const el = document.querySelector("[data-activity-status]");
      if (el instanceof HTMLElement) {
        el.textContent = message;
        el.hidden = !message;
      }
    }

    function setNote(message: string): void {
      const el = document.querySelector("[data-activity-note]");
      if (el instanceof HTMLElement) {
        el.textContent = message;
        el.hidden = !message;
      }
    }

    function formatDate(iso: string): string {
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return iso;
      return d.toLocaleString();
    }

    function selectedValue(selector: string): string {
      const el = document.querySelector(selector);
      return el instanceof HTMLSelectElement || el instanceof HTMLInputElement
        ? el.value
        : "";
    }

    function readFilters(): PatternActivityReportFilters {
      const datePreset = (selectedValue("[data-activity-date-preset]") ||
        "week") as PatternActivityDatePreset;
      return {
        ...DEFAULT_PATTERN_ACTIVITY_FILTERS,
        datePreset,
        customFrom: selectedValue("[data-activity-date-from]"),
        customTo: selectedValue("[data-activity-date-to]"),
        patternSystem: selectedValue("[data-activity-system]"),
        membership: (selectedValue("[data-activity-membership]") ||
          "all") as PatternActivityReportFilters["membership"],
        eventType: selectedValue("[data-activity-event]"),
      };
    }

    function fillSelect(
      selector: string,
      options: { value: string; label: string }[],
      keepValue: string,
    ): void {
      const el = document.querySelector(selector);
      if (!(el instanceof HTMLSelectElement)) return;
      const current = keepValue;
      el.replaceChildren();
      const all = document.createElement("option");
      all.value = "";
      all.textContent = "All";
      el.appendChild(all);
      for (const option of options) {
        const node = document.createElement("option");
        node.value = option.value;
        node.textContent = option.label;
        el.appendChild(node);
      }
      el.value = options.some((option) => option.value === current) ? current : "";
    }

    function syncCustomRangeVisibility(): void {
      const preset = selectedValue("[data-activity-date-preset]");
      document.querySelectorAll("[data-activity-custom-range]").forEach((el) => {
        if (el instanceof HTMLElement) el.hidden = preset !== "custom";
      });
    }

    function syncSortHeaders(): void {
      document.querySelectorAll<HTMLButtonElement>("[data-activity-sort]").forEach((btn) => {
        const key = btn.dataset.activitySort;
        const active = key === sortKey;
        btn.dataset.sortActive = active ? "true" : "false";
        btn.dataset.sortDirection = active ? sortDirection : "";
        const th = btn.closest("th");
        if (th) th.setAttribute("aria-sort", active ? `${sortDirection}ending` : "none");
      });
    }

    function renderRows(events: PatternActivityEvent[]): void {
      const tbody = document.querySelector("[data-activity-rows]");
      const wrap = document.querySelector("[data-activity-table-wrap]");
      if (!(tbody instanceof HTMLElement) || !(wrap instanceof HTMLElement)) return;
      tbody.replaceChildren();
      for (const event of events) {
        const tr = document.createElement("tr");
        const cells = [
          formatDate(event.createdAt),
          event.userEmail ?? "—",
          activityMembershipDisplay(event),
          patternActivityEventLabel(event.eventType),
          patternActivitySystemLabel(event.patternSystem ?? ""),
          event.patternTitle ?? "—",
        ];
        for (const value of cells) {
          const td = document.createElement("td");
          td.textContent = value;
          tr.appendChild(td);
        }
        tbody.appendChild(tr);
      }
      wrap.hidden = events.length === 0;
    }

    function renderPager(totalRows: number): void {
      const pager = document.querySelector("[data-activity-pager]");
      const label = document.querySelector("[data-activity-page-label]");
      const prev = document.querySelector("[data-activity-prev]");
      const next = document.querySelector("[data-activity-next]");
      if (!(pager instanceof HTMLElement)) return;
      const pageCount = Math.max(1, Math.ceil(totalRows / PAGE_SIZE));
      if (page > pageCount - 1) page = pageCount - 1;
      pager.hidden = totalRows <= PAGE_SIZE;
      if (label instanceof HTMLElement) {
        label.textContent = `Page ${page + 1} of ${pageCount}`;
      }
      if (prev instanceof HTMLButtonElement) prev.disabled = page <= 0;
      if (next instanceof HTMLButtonElement) next.disabled = page >= pageCount - 1;
    }

    function applyReport(): void {
      const filters = readFilters();
      const filtered = filterPatternActivityEvents(loadedEvents, {
        ...filters,
        datePreset: "all",
      });
      const sorted = sortPatternActivityEvents(filtered, sortKey, sortDirection);
      const summary = summarizePatternActivity(sorted, { recentLimit: 0 });
      setText("[data-activity-total]", String(summary.totalEvents));
      setText("[data-activity-users]", String(summary.uniqueUsers));
      setText("[data-activity-generated]", String(summary.generatedCount));
      setText("[data-activity-saved]", String(summary.savedCount));

      const start = page * PAGE_SIZE;
      renderRows(sorted.slice(start, start + PAGE_SIZE));
      renderPager(sorted.length);
      syncSortHeaders();

      if (sorted.length === 0) {
        setStatus("No pattern activity matches these filters.");
      } else {
        setStatus("");
      }
      if (truncated) {
        setNote(
          `Showing the ${FETCH_LIMIT} most recent events in this range. Narrow the date range to see older activity.`,
        );
      } else {
        setNote("");
      }
    }

    async function resolveMemberEmailHeader(): Promise<Record<string, string>> {
      try {
        const ms = window.$memberstackDom;
        if (!ms?.getCurrentMember) return {};
        const payload = await ms.getCurrentMember();
        const email = memberEmailFromMemberstackPayload(payload);
        return email ? { "X-KBM-Member-Email": email } : {};
      } catch {
        return {};
      }
    }

    async function loadPatternActivity(): Promise<void> {
      syncCustomRangeVisibility();
      try {
        const auth = await resolveCustomPatternProjectAuth();
        if (auth.mode === "none") {
          setStatus("Sign in to view pattern activity.");
          return;
        }
        const filters = readFilters();
        const range = dateRangeForPreset(filters.datePreset, new Date(), {
          from: filters.customFrom,
          to: filters.customTo,
        });
        const params = new URLSearchParams({ limit: String(FETCH_LIMIT) });
        if (range.fromIso) params.set("from", range.fromIso);
        if (range.toIso) params.set("to", range.toIso);

        const emailHeader = await resolveMemberEmailHeader();
        const res = await fetch(`${PATTERN_ACTIVITY_LOG_ENDPOINT}?${params}`, {
          method: "GET",
          headers: { ...authHeadersForCustomPatternProjects(auth), ...emailHeader },
        });
        if (res.status === 403) {
          let message = "You don't have admin access to view pattern activity.";
          try {
            const denied = (await res.json()) as {
              allowlistDebug?: {
                userId?: string;
                email?: string;
                userIdMatched?: boolean;
                emailMatched?: boolean;
                emailsConfigured?: boolean;
                memberIdsConfigured?: boolean;
                emailLookupSucceeded?: boolean;
                emailLookupSkippedDueToEnvMismatch?: boolean;
              };
            };
            const d = denied?.allowlistDebug;
            if (d) {
              message +=
                ` [TEMP diagnostic] userId=${d.userId || "(empty)"}` +
                ` email=${d.email || "(empty)"}` +
                ` userIdMatched=${String(d.userIdMatched)}` +
                ` emailMatched=${String(d.emailMatched)}` +
                ` emailsConfigured=${String(d.emailsConfigured)}` +
                ` memberIdsConfigured=${String(d.memberIdsConfigured)}` +
                ` emailLookupSucceeded=${String(d.emailLookupSucceeded)}` +
                ` emailLookupSkippedDueToEnvMismatch=${String(d.emailLookupSkippedDueToEnvMismatch)}`;
            }
          } catch {
            /* keep the generic 403 copy */
          }
          setStatus(message);
          return;
        }
        const data = (await res.json()) as {
          ok?: boolean;
          events?: unknown[];
          truncated?: boolean;
          error?: string;
        };
        if (!res.ok || !data.ok || !Array.isArray(data.events)) {
          setStatus("Unable to load pattern activity right now.");
          return;
        }

        loadedEvents = data.events.filter(
          (row): row is PatternActivityEvent =>
            Boolean(row && typeof row === "object" && typeof (row as PatternActivityEvent).createdAt === "string"),
        );
        truncated = Boolean(data.truncated) || loadedEvents.length >= FETCH_LIMIT;
        page = 0;

        const systemKeep = selectedValue("[data-activity-system]");
        fillSelect("[data-activity-system]", patternActivitySystemFilterOptions(loadedEvents), systemKeep);
        fillSelect(
          "[data-activity-event]",
          patternActivityEventTypeOptions(),
          selectedValue("[data-activity-event]"),
        );
        applyReport();
      } catch {
        setStatus("Unable to load pattern activity right now.");
      }
    }

    document.querySelector("[data-activity-date-preset]")?.addEventListener("change", () => {
      syncCustomRangeVisibility();
      void loadPatternActivity();
    });
    document.querySelector("[data-activity-date-from]")?.addEventListener("change", () => {
      void loadPatternActivity();
    });
    document.querySelector("[data-activity-date-to]")?.addEventListener("change", () => {
      void loadPatternActivity();
    });
    document.querySelector("[data-activity-system]")?.addEventListener("change", () => {
      page = 0;
      applyReport();
    });
    document.querySelector("[data-activity-membership]")?.addEventListener("change", () => {
      page = 0;
      applyReport();
    });
    document.querySelector("[data-activity-event]")?.addEventListener("change", () => {
      page = 0;
      applyReport();
    });
    document.querySelectorAll<HTMLButtonElement>("[data-activity-sort]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.activitySort as PatternActivitySortKey | undefined;
        if (!key) return;
        if (sortKey === key) {
          sortDirection = sortDirection === "desc" ? "asc" : "desc";
        } else {
          sortKey = key;
          sortDirection = key === "createdAt" ? "desc" : "asc";
        }
        page = 0;
        applyReport();
      });
    });
    document.querySelector("[data-activity-prev]")?.addEventListener("click", () => {
      if (page > 0) {
        page -= 1;
        applyReport();
      }
    });
    document.querySelector("[data-activity-next]")?.addEventListener("click", () => {
      page += 1;
      applyReport();
    });

    void loadPatternActivity();
  </script>

  <script>
    const inputEl = document.getElementById("vjl-input");
    const outputEl = document.getElementById("vjl-output");
    const generateBtn = document.getElementById("vjl-generate");
    const copyBtn = document.getElementById("vjl-copy");
    const copiedEl = document.getElementById("vjl-copied");

    type ParsedEntry = { label: string; seconds: number };

    function parseTimestampLine(line: string): ParsedEntry | null {
      const trimmed = line.trim();
      if (!trimmed) return null;

      const match = trimmed.match(
        /^(\d{1,2}):(\d{2})(?::(\d{2}))?\s+(.+)$/
      );
      if (!match) return null;

      const [, a, b, c, label] = match;
      let totalSeconds: number;
      if (c !== undefined) {
        totalSeconds =
          parseInt(a, 10) * 3600 + parseInt(b, 10) * 60 + parseInt(c, 10);
      } else {
        totalSeconds = parseInt(a, 10) * 60 + parseInt(b, 10);
      }

      return { label, seconds: totalSeconds };
    }

    function escapeHtml(text: string): string {
      return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function escapeJsString(text: string): string {
      return text.replace(/\\/g, "\\\\").replace(/"/g, '\\"');
    }

    function formatEntry(entry: ParsedEntry, format: "html" | "js"): string {
      if (format === "js") {
        return `{ label: "${escapeJsString(entry.label)}", seconds: ${entry.seconds} },`;
      }
      return `<button data-vimeo-jump="${entry.seconds}">${escapeHtml(entry.label)}</button>`;
    }

    function getSelectedFormat(): "html" | "js" {
      const checked = document.querySelector<HTMLInputElement>(
        'input[name="vjl-format"]:checked'
      );
      return checked?.value === "js" ? "js" : "html";
    }

    function generateOutput() {
      if (!(inputEl instanceof HTMLTextAreaElement)) return;
      if (!(outputEl instanceof HTMLTextAreaElement)) return;

      const format = getSelectedFormat();
      const lines = inputEl.value.split(/\r?\n/);
      const entries = lines
        .map(parseTimestampLine)
        .filter((entry): entry is ParsedEntry => entry !== null);

      outputEl.value = entries
        .map((entry) => formatEntry(entry, format))
        .join("\n");
      if (copyBtn instanceof HTMLButtonElement) {
        copyBtn.disabled = entries.length === 0;
      }
    }

    async function copyOutput() {
      if (!(outputEl instanceof HTMLTextAreaElement)) return;
      if (!outputEl.value) return;

      outputEl.select();
      try {
        await navigator.clipboard.writeText(outputEl.value);
      } catch {
        document.execCommand("copy");
      }
      showCopiedMessage();
    }

    let copiedTimeout: number | undefined;
    function showCopiedMessage() {
      if (!(copiedEl instanceof HTMLElement)) return;
      copiedEl.hidden = false;
      clearTimeout(copiedTimeout);
      copiedTimeout = window.setTimeout(() => {
        copiedEl.hidden = true;
      }, 2000);
    }

    generateBtn?.addEventListener("click", generateOutput);
    copyBtn?.addEventListener("click", copyOutput);

    outputEl?.addEventListener("click", () => {
      if (outputEl instanceof HTMLTextAreaElement) {
        outputEl.select();
      }
    });

    outputEl?.addEventListener("focus", () => {
      if (outputEl instanceof HTMLTextAreaElement) {
        outputEl.select();
      }
    });
  </script>

  <script>
    import {
      checkPatternActivityAdminAccess,
    } from "../../lib/patterns/patternActivityLog";
    import {
      authHeadersForCustomPatternProjects,
      resolveCustomPatternProjectAuth,
    } from "../../lib/patterns/customPatternProjectAuth";
    import { memberEmailFromMemberstackPayload } from "../../lib/patterns/memberstackMember";

    const RESET_ENDPOINT =
      "/.netlify/functions/admin-sleeveless-access-reset";
    const LOOKUP_ERROR_MESSAGE =
      "Could not look up that member. Check the email address and try again.";
    const RESET_ERROR_MESSAGE =
      "Could not reset the claim. Check the email address and try again.";

    type SupportMember = {
      memberId: string | null;
      email: string | null;
      name: string | null;
      freeSleevelessPatternClaimed: boolean;
      freeSleevelessPatternId: string | null;
      hasMemberJson: boolean;
    };

    const resetSection = document.getElementById("sleeveless-reset-section");
    const lookupForm = document.getElementById("sleeveless-lookup-form");
    const emailInput = document.getElementById("sleeveless-lookup-email");
    const lookupBtn = document.getElementById("sleeveless-lookup-btn");
    const resultBox = document.getElementById("sleeveless-lookup-result");
    const resetBtn = document.getElementById("sleeveless-reset-btn");
    const statusEl = document.getElementById("sleeveless-reset-status");

    let currentMember: SupportMember | null = null;

    // Admin-only: stay hidden by default; reveal only once admin access is confirmed (fails closed).
    void (async () => {
      try {
        if (await checkPatternActivityAdminAccess()) {
          if (resetSection instanceof HTMLElement) resetSection.hidden = false;
        }
      } catch {
        /* leave hidden */
      }
    })();

    function setStatus(message: string, isError: boolean): void {
      if (!(statusEl instanceof HTMLElement)) return;
      statusEl.textContent = message;
      statusEl.hidden = !message;
      statusEl.classList.toggle("admin-dash__tool-status--error", isError);
    }

    function setResultText(selector: string, value: string): void {
      const el = document.querySelector(`[${selector}]`);
      if (el instanceof HTMLElement) el.textContent = value;
    }

    function renderMember(member: SupportMember | null): void {
      currentMember = member;
      if (!(resultBox instanceof HTMLElement)) return;
      if (!member) {
        resultBox.hidden = true;
        return;
      }
      setResultText("data-result-name", member.name || "—");
      setResultText("data-result-email", member.email || "—");
      setResultText("data-result-id", member.memberId || "—");
      setResultText(
        "data-result-claimed",
        member.freeSleevelessPatternClaimed ? "Yes" : "No",
      );
      setResultText(
        "data-result-pattern-id",
        member.freeSleevelessPatternId || "—",
      );
      resultBox.hidden = false;
      if (resetBtn instanceof HTMLButtonElement) {
        resetBtn.disabled = !member.memberId && !member.email;
      }
    }

    // Reuse the same auth + member-email headers the activity dashboard sends; the Netlify function
    // re-checks admin access server-side, so these are an identity hint only (never trusted alone).
    async function adminHeaders(): Promise<Record<string, string> | null> {
      const auth = await resolveCustomPatternProjectAuth();
      if (auth.mode === "none") return null;
      const headers: Record<string, string> = {
        ...authHeadersForCustomPatternProjects(auth),
      };
      try {
        const ms = window.$memberstackDom;
        if (auth.mode === "member" && ms?.getCurrentMember) {
          const email = memberEmailFromMemberstackPayload(await ms.getCurrentMember());
          if (email) headers["X-KBM-Member-Email"] = email;
        }
      } catch {
        /* identity hint only */
      }
      return headers;
    }

    async function lookupMember(email: string): Promise<void> {
      setStatus("", false);
      const headers = await adminHeaders();
      if (!headers) {
        setStatus(LOOKUP_ERROR_MESSAGE, true);
        return;
      }
      const url = `${RESET_ENDPOINT}?email=${encodeURIComponent(email)}`;
      const res = await fetch(url, { method: "GET", headers });
      const data = (await res.json().catch(() => null)) as
        | { ok?: boolean; member?: SupportMember }
        | null;
      if (!res.ok || !data?.ok || !data.member) {
        renderMember(null);
        setStatus(
          res.status === 404
            ? `No member found for ${email}.`
            : LOOKUP_ERROR_MESSAGE,
          true,
        );
        return;
      }
      renderMember(data.member);
    }

    async function resetMember(member: SupportMember): Promise<void> {
      const headers = await adminHeaders();
      if (!headers) {
        setStatus(RESET_ERROR_MESSAGE, true);
        return;
      }
      const res = await fetch(RESET_ENDPOINT, {
        method: "POST",
        headers: { ...headers, "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "reset",
          memberId: member.memberId ?? undefined,
          email: member.email ?? undefined,
        }),
      });
      const data = (await res.json().catch(() => null)) as
        | { ok?: boolean; member?: SupportMember }
        | null;
      if (!res.ok || !data?.ok) {
        setStatus(RESET_ERROR_MESSAGE, true);
        return;
      }
      if (data.member) renderMember(data.member);
      const label = member.email || member.memberId || "this member";
      setStatus(`Free Sleeveless build claim reset for ${label}.`, false);
    }

    lookupForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(emailInput instanceof HTMLInputElement)) return;
      const email = emailInput.value.trim();
      if (!email) return;
      renderMember(null);
      if (lookupBtn instanceof HTMLButtonElement) lookupBtn.disabled = true;
      try {
        await lookupMember(email);
      } catch (err) {
        console.error("Sleeveless lookup threw:", err);
        setStatus(LOOKUP_ERROR_MESSAGE, true);
      } finally {
        if (lookupBtn instanceof HTMLButtonElement) lookupBtn.disabled = false;
      }
    });

    resetBtn?.addEventListener("click", async () => {
      if (!currentMember) return;
      const label = currentMember.email || currentMember.memberId || "this member";
      if (!window.confirm(`Reset the free Sleeveless build claim for ${label}?`)) {
        return;
      }
      if (resetBtn instanceof HTMLButtonElement) resetBtn.disabled = true;
      try {
        await resetMember(currentMember);
      } catch (err) {
        console.error("Sleeveless free-claim reset threw:", err);
        setStatus(RESET_ERROR_MESSAGE, true);
      } finally {
        if (resetBtn instanceof HTMLButtonElement) resetBtn.disabled = false;
      }
    });
  </script>

