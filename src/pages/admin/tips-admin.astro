---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Help Hub Tips | Knit it Now"
  description="Browse and manage Help Hub tips (help-hub.json)"
  skipGlobalHyvor={true}
  bodyClass="tips-admin-body help-hub-admin-body"
>
  <Fragment slot="head">
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jquery.tablesorter/2.31.3/js/jquery.tablesorter.min.js"></script>
  </Fragment>
  <main class="help-hub-admin">
    <header class="help-hub-admin__head">
      <h1 class="help-hub-admin__title">Help Hub Tips </h1><a href="lessons-admin">💡Lessons Admin</a>
      <p class="help-hub-admin__sub">
        Data lives in <code>src/data/help-hub.json</code> and is updated via <code>/api/admin/help-hub</code>. Use Edit to change a tip; IDs are permanent.
      </p>
    </header>

    <p id="help-hub-admin-status" class="help-hub-admin__status" aria-live="polite"></p>

    <div class="help-hub-admin__toolbar">
      <a href="/admin/tips-edit" class="kbm-btn kbm-btn-primary">+ New Tip</a>
    </div>

    <section class="admin-panel help-hub-admin__table-panel" aria-labelledby="list-heading">
      <h2 id="list-heading" class="visually-hidden">All tips</h2>
      <p id="help-hub-admin-loading" class="help-hub-admin__loading">Loading…</p>
      <div id="help-hub-table-wrap" class="help-hub-admin__table-wrap" hidden>
        <table id="help-hub-admin-table" class="help-hub-admin__table">
          <thead>
            <tr>
              <th scope="col" class="help-hub-admin__th-remove"><span class="visually-hidden">Delete</span></th>
              <th scope="col">ID</th>
              <th scope="col">Title</th>
              <th scope="col">Status</th>
              <th scope="col">Slug</th>
              <th scope="col">Applies</th>
              <th scope="col" class="help-hub-admin__th-actions">Actions</th>
            </tr>
          </thead>
          <tbody id="help-hub-tip-tbody"></tbody>
        </table>
      </div>
      <p id="help-hub-admin-empty" class="help-hub-admin__empty" hidden>No tips yet.</p>
    </section>
  </main>

  <style>
    :global(body.help-hub-admin-body) {
      margin: 0;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .help-hub-admin {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 1.25rem 1.5rem 3rem;
      box-sizing: border-box;
    }

    .help-hub-admin__head {
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e2e8f0;
    }

    .help-hub-admin__title {
      margin: 0 0 0.35rem 0;
      font-size: 1.65rem;
      color: #243015;
    }

    .help-hub-admin__sub {
      margin: 0;
      font-size: 0.95rem;
      color: #475569;
      max-width: 56rem;
    }

    .help-hub-admin__sub code {
      font-size: 0.88em;
      background: #f1f5f9;
      padding: 0.12rem 0.35rem;
      border-radius: 4px;
    }

    .help-hub-admin__status {
      min-height: 1.4em;
      margin: 0 0 1rem 0;
      font-size: 0.95rem;
      color: #374151;
    }

    .help-hub-admin__status.is-error {
      color: #b91c1c;
      font-weight: 600;
    }

    .help-hub-admin__status.is-ok {
      color: #166534;
    }

    .help-hub-admin__toolbar {
      margin-bottom: 1rem;
    }

    .admin-panel {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 1rem;
    }

    .help-hub-admin__loading {
      margin: 0;
      color: #64748b;
      font-size: 0.95rem;
    }

    .help-hub-admin__empty {
      margin: 0;
      color: #64748b;
    }

    .help-hub-admin__table-wrap {
      overflow-x: auto;
    }

    .help-hub-admin__table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.92rem;
    }

    .help-hub-admin__table th,
    .help-hub-admin__table td {
      border-bottom: 1px solid #e5e7eb;
      padding: 0.65rem 0.5rem;
      text-align: left;
      vertical-align: top;
    }

    .help-hub-admin__table th {
      font-weight: 700;
      color: #243015;
      background: #f8fafc;
    }

    .help-hub-admin__table tbody tr:hover {
      background: #fafafa;
    }

    .help-hub-admin__table .col-remove {
      width: 1%;
      padding-left: 0.35rem;
      padding-right: 0.35rem;
      vertical-align: middle;
      text-align: center;
    }

    .help-hub-admin__row-remove {
      appearance: none;
      background: transparent;
      border: none;
      padding: 0.15rem 0.35rem;
      margin: 0;
      line-height: 1;
      font-size: 16px;
      font-weight: 700;
      color: #999;
      cursor: pointer;
      border-radius: 4px;
    }

    .help-hub-admin__row-remove:hover:not(:disabled),
    .help-hub-admin__row-remove:focus-visible:not(:disabled) {
      color: #b91c1c;
      background: #fef2f2;
    }

    .help-hub-admin__row-remove:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .help-hub-admin__table .col-id {
      font-variant-numeric: tabular-nums;
      color: #475569;
      white-space: nowrap;
      width: 4rem;
    }

    .help-hub-admin__table .col-title {
      font-weight: 600;
      color: #111827;
      max-width: 22rem;
    }

    .help-hub-admin__table .col-slug code {
      font-size: 0.85em;
      background: #f1f5f9;
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      word-break: break-all;
    }

    .help-hub-admin__table .col-applies {
      color: #475569;
      max-width: 16rem;
    }

    .help-hub-admin__table .col-status {
      white-space: nowrap;
      width: 6.5rem;
    }

    .help-hub-admin__status-pill {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      letter-spacing: 0.02em;
    }

    .help-hub-admin__status-pill--active {
      background: #dcfce7;
      color: #166534;
      border: 1px solid #86efac;
    }

    .help-hub-admin__status-pill--inactive {
      background: #f1f5f9;
      color: #64748b;
      border: 1px solid #e2e8f0;
    }

    .help-hub-admin__th-actions,
    .help-hub-admin__th-remove {
      width: 1%;
    }

    .help-hub-admin__table thead th {
      cursor: pointer;
      user-select: none;
    }

    .help-hub-admin__table thead th.help-hub-admin__th-actions,
    .help-hub-admin__table thead th.help-hub-admin__th-remove {
      cursor: default;
      user-select: auto;
    }

    .help-hub-admin__table thead th.tablesorter-headerAsc,
    .help-hub-admin__table thead th.tablesorter-headerDesc {
      background: #ecfdf5;
      color: #14532d;
    }

    .help-hub-admin__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      align-items: center;
    }

    .help-hub-admin__actions .kbm-btn {
      font-size: 0.85rem;
      padding: 0.35rem 0.6rem;
    }
  </style>

  <script>
    const API_BASE = "/api/admin/help-hub";

    type TipRow = Record<string, unknown>;

    let tips: TipRow[] = [];

    const statusEl = document.getElementById("help-hub-admin-status");
    const loadingEl = document.getElementById("help-hub-admin-loading");
    const tableWrapEl = document.getElementById("help-hub-table-wrap");
    const tbodyEl = document.getElementById("help-hub-tip-tbody");
    const emptyEl = document.getElementById("help-hub-admin-empty");

    function setStatus(message: string, kind: "ok" | "err" | "neutral" = "neutral") {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.toggle("is-error", kind === "err");
      statusEl.classList.toggle("is-ok", kind === "ok");
    }

    function getTipId(row: TipRow): number | null {
      const v = row.id;
      if (typeof v === "number" && Number.isFinite(v)) return v;
      if (typeof v === "string" && v.trim()) {
        const n = parseInt(v.trim(), 10);
        return Number.isFinite(n) ? n : null;
      }
      return null;
    }

    function appliesLabel(tip: TipRow): string {
      if (tip.allMachines === true) return "All machines";
      const list = tip.appliesTo;
      if (Array.isArray(list) && list.length > 0) {
        const parts = list.map((x) => String(x).trim()).filter(Boolean);
        if (parts.length === 0) return "—";
        if (parts.length <= 2) return parts.join(", ");
        return `${parts.slice(0, 2).join(", ")}…`;
      }
      return "—";
    }

    /** Active = published or missing; anything else (e.g. draft) = Inactive. */
    function listTipIsActive(tip: TipRow): boolean {
      const s = tip.status;
      if (s === undefined || s === null) return true;
      if (typeof s !== "string") return false;
      const t = s.trim();
      if (t === "") return true;
      return t.toLowerCase() === "published";
    }

    let tableSorterInited = false;

    function refreshTableSorter() {
      const w = window as unknown as { jQuery?: (sel: string) => { length: number; tablesorter: (opts?: object) => unknown; trigger: (name: string, ...args: unknown[]) => unknown } };
      const $ = w.jQuery;
      if (!$) return;
      const $tab = $("#help-hub-admin-table");
      if ($tab.length === 0) return;
      if (tips.length === 0) {
        if (tableSorterInited) {
          $tab.trigger("destroy");
          tableSorterInited = false;
        }
        return;
      }
      if (!tableSorterInited) {
        $tab.tablesorter({
          headers: {
            0: { sorter: false },
            1: { sorter: "digit" },
            6: { sorter: false },
          },
          sortList: [[1, 1]],
        });
        tableSorterInited = true;
      } else {
        $tab.trigger("update");
      }
    }

    async function deleteTip(id: number, title: string, slug: string) {
      if (!confirm(`Delete tip "${title}" (${slug})? This cannot be undone.`)) return;
      try {
        const res = await fetch(`${API_BASE}/${id}`, { method: "DELETE" });
        const data = (await res.json()) as { ok?: boolean; tips?: TipRow[]; error?: string };
        if (!res.ok || !data.ok || !Array.isArray(data.tips)) {
          setStatus(data.error || `Delete failed (${res.status})`, "err");
          return;
        }
        tips = data.tips;
        setStatus(`Deleted tip id ${id}.`, "ok");
        renderTable();
      } catch {
        setStatus("Network error while deleting.", "err");
      }
    }

    function renderTable() {
      if (!tbodyEl || !loadingEl || !tableWrapEl || !emptyEl) return;
      loadingEl.hidden = true;
      if (tips.length === 0) {
        tableWrapEl.hidden = true;
        emptyEl.hidden = false;
        tbodyEl.innerHTML = "";
        return;
      }
      emptyEl.hidden = true;
      tableWrapEl.hidden = false;
      tbodyEl.innerHTML = "";

      for (const tip of tips) {
        const id = getTipId(tip);
        const title = String(tip.title ?? "(no title)");
        const slug = typeof tip.slug === "string" ? tip.slug.trim() : "";
        const tr = document.createElement("tr");

        const tdRemove = document.createElement("td");
        tdRemove.className = "col-remove";
        const rmBtn = document.createElement("button");
        rmBtn.type = "button";
        rmBtn.className = "help-hub-admin__row-remove";
        rmBtn.textContent = "×";
        rmBtn.setAttribute("aria-label", `Delete tip: ${title}`);
        rmBtn.disabled = id === null;
        rmBtn.addEventListener("click", () => {
          if (id === null) return;
          void deleteTip(id, title, slug || String(id));
        });
        tdRemove.appendChild(rmBtn);

        const tdId = document.createElement("td");
        tdId.className = "col-id";
        tdId.textContent = id !== null ? String(id) : "—";

        const tdTitle = document.createElement("td");
        tdTitle.className = "col-title";
        tdTitle.textContent = title;

        const active = listTipIsActive(tip);
        const tdStatus = document.createElement("td");
        tdStatus.className = "col-status";
        const pill = document.createElement("span");
        pill.className = active
          ? "help-hub-admin__status-pill help-hub-admin__status-pill--active"
          : "help-hub-admin__status-pill help-hub-admin__status-pill--inactive";
        pill.textContent = active ? "Active" : "Inactive";
        tdStatus.appendChild(pill);

        const tdSlug = document.createElement("td");
        tdSlug.className = "col-slug";
        const code = document.createElement("code");
        code.textContent = slug || "—";
        tdSlug.appendChild(code);

        const tdApplies = document.createElement("td");
        tdApplies.className = "col-applies";
        tdApplies.textContent = appliesLabel(tip);

        const tdActions = document.createElement("td");
        const wrap = document.createElement("div");
        wrap.className = "help-hub-admin__actions";

        const editLink = document.createElement("a");
        editLink.className = "kbm-btn kbm-btn-outline";
        editLink.href =
          slug && id !== null
            ? `/admin/tips-edit?slug=${encodeURIComponent(slug)}&id=${id}`
            : slug
              ? `/admin/tips-edit?slug=${encodeURIComponent(slug)}`
              : "/admin/tips-edit";
        editLink.textContent = "Edit";

        wrap.appendChild(editLink);
        tdActions.appendChild(wrap);

        tr.appendChild(tdRemove);
        tr.appendChild(tdId);
        tr.appendChild(tdTitle);
        tr.appendChild(tdStatus);
        tr.appendChild(tdSlug);
        tr.appendChild(tdApplies);
        tr.appendChild(tdActions);
        tbodyEl.appendChild(tr);
      }

      refreshTableSorter();
    }

    async function fetchTips() {
      setStatus("Loading tips…", "neutral");
      try {
        const res = await fetch(API_BASE);
        const data = (await res.json()) as { ok?: boolean; tips?: TipRow[]; error?: string };
        if (!res.ok || !data.ok || !Array.isArray(data.tips)) {
          setStatus(data.error || `Failed to load (${res.status})`, "err");
          if (loadingEl) loadingEl.hidden = false;
          if (tableWrapEl) tableWrapEl.hidden = true;
          if (emptyEl) emptyEl.hidden = true;
          return;
        }
        tips = data.tips;
        setStatus(`Loaded ${tips.length} tip(s).`, "ok");
        renderTable();
      } catch {
        setStatus("Network error loading tips.", "err");
        if (loadingEl) loadingEl.hidden = false;
      }
    }

    void fetchTips();
  </script>
</BaseLayout>
