---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Marketing calendar" description="Sync ActiveCampaign campaigns to the KIN marketing calendar.">
  <main class="marketing-sync">
    <h1>Marketing calendar</h1>
    <p>
      Sync scheduled and sent ActiveCampaign campaigns onto the KIN marketing calendar.
      Event titles use the campaign name. Existing manual events and repeating reminders stay as they are.
    </p>
    <button id="marketing-sync-now" type="button">Sync now</button>
    <p id="marketing-sync-status" role="status"></p>
    <ul id="marketing-sync-results"></ul>
  </main>
</BaseLayout>

<script>
  import { fetchAdminJson } from "../../lib/admin/adminAuthClient";
  import {
    MARKETING_CALENDAR_SYNCING_MESSAGE,
    marketingCalendarSyncMessage,
  } from "../../lib/marketingCalendar/syncJobClient";

  const button = document.querySelector<HTMLButtonElement>("#marketing-sync-now");
  const status = document.querySelector<HTMLParagraphElement>("#marketing-sync-status");
  const results = document.querySelector<HTMLUListElement>("#marketing-sync-results");

  type SyncChange = { action: string; title: string; date: string | null; campaignId: string };
  type SyncBody = {
    status?: string;
    jobId?: string;
    created?: number;
    updated?: number;
    skipped?: number;
    error?: string | null;
    changes?: SyncChange[];
    proposedDeletions?: Array<{ title: string; campaignId: string }>;
    skippedConflicts?: Array<{ title: string; manualSummary: string }>;
  };

  function wait(ms: number): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  function showResult(data: SyncBody): void {
    if (!status || !results) return;
    results.replaceChildren();
    if (data.status === "failed") {
      status.textContent = marketingCalendarSyncMessage(data);
      return;
    }
    status.textContent = marketingCalendarSyncMessage(data);
    for (const change of data.changes ?? []) {
      const item = document.createElement("li");
      item.textContent = `${change.action === "create" ? "Added" : "Updated"}: ${change.title} (${change.date || "no date"})`;
      results.append(item);
    }
    for (const deletion of data.proposedDeletions ?? []) {
      const item = document.createElement("li");
      item.textContent = `Not deleted: ${deletion.title} (campaign ${deletion.campaignId})`;
      results.append(item);
    }
    for (const conflict of data.skippedConflicts ?? []) {
      const item = document.createElement("li");
      item.textContent = `Left alone because it matches “${conflict.manualSummary}”: ${conflict.title}`;
      results.append(item);
    }
  }

  button?.addEventListener("click", async () => {
    if (!button || !status || !results) return;
    button.disabled = true;
    status.textContent = MARKETING_CALENDAR_SYNCING_MESSAGE;
    results.replaceChildren();
    try {
      const response = await fetchAdminJson<SyncBody>("/api/admin/marketing-calendar/sync", {
        method: "POST",
        body: {},
      });
      if (!response.ok || !response.data.jobId) {
        status.textContent = response.error || "Marketing calendar sync failed.";
        return;
      }
      const deadline = Date.now() + 16 * 60 * 1000;
      while (Date.now() < deadline) {
        const poll = await fetchAdminJson<SyncBody>(
          `/api/admin/marketing-calendar/sync?job=${encodeURIComponent(response.data.jobId)}`,
          { method: "GET" },
        );
        if (!poll.ok) {
          status.textContent = poll.error || "Marketing calendar sync failed.";
          return;
        }
        if (poll.data.status === "running") {
          status.textContent = MARKETING_CALENDAR_SYNCING_MESSAGE;
          await wait(2000);
          continue;
        }
        showResult(poll.data);
        return;
      }
      status.textContent = "The sync did not finish. Run it again.";
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .marketing-sync {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1.25rem 1rem 3rem;
  }

  .marketing-sync h1 {
    margin: 0 0 0.75rem;
    font-size: 1.6rem;
  }

  .marketing-sync p {
    margin: 0 0 1rem;
    line-height: 1.45;
  }

  #marketing-sync-now {
    width: 100%;
    min-height: 3rem;
    border: 0;
    border-radius: 999px;
    background: #3f6212;
    color: white;
    font: inherit;
    font-weight: 700;
    font-size: 1.05rem;
  }

  #marketing-sync-now:disabled {
    opacity: 0.7;
  }

  #marketing-sync-results {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
  }

  #marketing-sync-results li {
    margin: 0.35rem 0;
  }
</style>
