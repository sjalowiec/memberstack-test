---
import Layout from "../../layouts/Layout.astro";
import WizardBackLink from "../../components/wizards/WizardBackLink.astro";
import ToolPageHeader from "../../components/tools/ToolPageHeader.astro";
import YarnEstimatorCalculator from "../../components/tools/YarnEstimatorCalculator.astro";
import ToolGate from "../../components/ui/ToolGate.astro";
import toolsData from "../../../data/tools.json";
import "../../styles/wizard.css";

const tools = toolsData as Array<{
  href?: string;
  title?: string;
  icon?: string;
  membersonly?: boolean;
}>;
const tool = tools.find((t) => t.href === Astro.url.pathname) ?? null;
const toolPrintTitle = tool?.title ?? "Yarn Estimator";
---

<Layout
  title="Yarn Estimator | Knit by Machine"
  description="Estimate how much yarn you need by weighing a swatch and comparing swatch area and weight to the finished dimensions of each pattern piece."
  toolPrintTitle={toolPrintTitle}
>
  <main class="wizard-page">
    <div class="wizard-shell">
      <WizardBackLink className="back-link" />

      <section class="wizard-hero ye-hero">
        <ToolPageHeader tool={tool} fallbackTitle="Yarn Estimator" />
        <p class="page-subtitle">Determine if you have enough yarn to finish your project.</p>
        <p class="wizard-intro ye-hero-intro">
          A swatch, a scale, and a few measurements can help you estimate how much yarn your project will need.
        </p>
      </section>

      <div class="ye-tool-wrap">
        <YarnEstimatorCalculator instanceId="page" />

        <ToolGate tool={tool} />
      </div>
    </div>
  </main>

  <style>
    .ye-hero .page-subtitle {
      margin: 0.35rem 0 0.5rem;
      max-width: 44rem;
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--kbm-green);
      line-height: 1.4;
    }

    .ye-hero .ye-hero-intro {
      margin: 0;
      max-width: 44rem;
    }

    .wizard-page .wizard-shell {
      max-width: 56rem;
      margin: 0 auto;
      padding: 0 1rem;
    }

    .ye-tool-wrap {
      position: relative;
      margin-bottom: 2rem;
    }
  </style>
</Layout>
