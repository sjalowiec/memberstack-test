---
import Layout from "../../layouts/Layout.astro";
import WizardBackLink from "../../components/wizards/WizardBackLink.astro";
import ToolPageHeader from "../../components/tools/ToolPageHeader.astro";
import toolsData from "../../../data/tools.json";
import "../../styles/wizard.css";

const tools = toolsData as Array<{ href?: string; title?: string; icon?: string }>;
const tool = tools.find((t) => t.href === Astro.url.pathname) ?? null;
---

<Layout
  title="Triangle Tool | Knit by Machine"
  description="Preview of the Triangle Tool: symmetrical triangle shaping from your gauge—shawls, scarves, wraps, and more."
>
  <main class="wizard-page">
    <div class="wizard-shell triangle-tool-preview">
      <WizardBackLink className="back-link" />

      <div class="triangle-tool-layout">
        <div class="triangle-tool-text">
          <ToolPageHeader tool={tool} fallbackTitle="Triangle Tool" />

          <p class="triangle-tool-intro">
            Let our magical calculator create your perfect triangle for your project. Enter your gauge, and the tool will figure out the increases or decreases for you.
          </p>

          <div class="triangle-tool-body">
            <p>
              Whether you want to start wide and decrease to a point, or begin at the tip and grow outward, the Triangle Tool helps you build a clean, balanced shape without doing the math yourself.
            </p>
            <ul class="triangle-tool-list">
              <li>Work a shawl or wrap with smooth, consistent shaping</li>
              <li>Design scarves or decorative panels</li>
              <li>Plan blanket sections or corners</li>
              <li>Experiment with your own ideas</li>
            </ul>
          </div>
        </div>

        <aside class="triangle-tool-visual" aria-label="Triangle tool illustration">
          <img
            src="/images/glossary/triangle.webp"
            alt="Triangle knitting tool example for shawls, scarves, and blanket designs"
            loading="lazy"
            decoding="async"
            class="triangle-tool-image"
          />
        </aside>
      </div>

      <p class="triangle-tool-status">Member tool — coming soon</p>
    </div>
  </main>

  <style>
    .triangle-tool-preview {
      max-width: 56rem;
      margin-left: auto;
      margin-right: auto;
      padding-left: 1rem;
      padding-right: 1rem;
      padding-bottom: 2.5rem;
    }

    .triangle-tool-layout {
      display: grid;
      gap: 2rem;
      margin-top: 0.5rem;
    }

    @media (min-width: 768px) {
      .triangle-tool-layout {
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 2.5rem;
        align-items: stretch;
      }
    }

    .triangle-tool-text {
      min-width: 0;
    }

    .triangle-tool-text :global(.tool-title) {
      margin-bottom: 0.75rem;
    }

    .triangle-tool-intro {
      font-size: 1.075rem;
      line-height: 1.65;
      color: #374151;
      margin: 0 0 1.75rem;
    }

    .triangle-tool-body > p {
      margin: 0 0 0.85rem;
      line-height: 1.65;
      color: #4b5563;
    }

    .triangle-tool-body > p:last-child {
      margin-bottom: 0;
    }

    .triangle-tool-list {
      margin: 0 0 0.85rem;
      padding-left: 1.25rem;
      line-height: 1.65;
      color: #4b5563;
    }

    .triangle-tool-list li {
      margin-bottom: 0.4rem;
    }

    .triangle-tool-list li:last-child {
      margin-bottom: 0;
    }

    .triangle-tool-visual {
      min-width: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .triangle-tool-image {
      width: 100%;
      max-width: 100%;
      height: auto;
      border-radius: 12px;
      display: block;
      box-sizing: border-box;
      border: 3px solid #52682d;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    }

    @media (min-width: 768px) {
      .triangle-tool-image {
        max-width: min(100%, 26rem);
        margin-left: auto;
        margin-right: auto;
      }
    }

    .triangle-tool-status {
      margin-top: 2.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid #e5e7eb;
      font-size: 0.9rem;
      color: #6b7280;
      text-align: center;
    }
  </style>
</Layout>
