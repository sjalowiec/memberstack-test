---
import Layout from "../../layouts/Layout.astro";
import CardRibbon from "../../components/ui/CardRibbon.astro";
import tools from "../../../data/tools.json";

// Launch: render only working tools (active === true). Coming-soon entries
// remain in tools.json but are hidden from the index (display-only change).
const listedTools = tools.filter(
  (tool: { active?: boolean }) => tool.active === true
);
const groupedTools = Object.groupBy(listedTools, (tool) => tool.category);

// Newest tool to feature with a "NEW" ribbon (brand-new to Knit It Now).
const NEW_TOOL_HREF = "/tools/stitch-multiple-calculator";
---
<Layout title="Charting Tools" bodyClass="page--tight-header">

<section class="tools-page">

  <h1>Charting Tools</h1>

  <p class="tools-intro">
    Need to adjust a pattern, resize a project, or make the numbers work for your machine? These tools handle the math so you can spend more time knitting.
  </p>

  <div class="tools-filters">
    <div class="tools-filter-row tools-access-toolbar">
      <div id="tool-access-filters" class="filter-pills tools-access-filters">
        <button type="button" class="filter-pill active" data-filter="all">All</button>
        <button type="button" class="filter-pill" data-filter="false">Free</button>
        <button type="button" class="filter-pill" data-filter="true">Member</button>
      </div>
      <div id="tools-search-panel" class="tools-search-panel">
        <button
          type="button"
          id="tools-search-toggle"
          class="filter-pill tools-search-toggle"
          aria-label="Focus search"
        >
          <svg class="tools-search-toggle__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
        </button>
        <input
          type="search"
          id="tools-search-input"
          class="tools-search-input"
          placeholder="Search tools…"
          autocomplete="off"
          enterkeyhint="search"
          aria-label="Search tools"
        />
        <button type="button" id="tools-search-clear" class="filter-pill tools-search-clear" hidden>Clear</button>
      </div>
    </div>

    <p id="tools-search-results-line" class="tools-search-results-line small text-muted" hidden>
      Showing results for: <span id="tools-search-term-display" class="tools-search-term-display"></span>
    </p>
  </div>

  <p id="tools-search-empty" class="tools-search-empty small text-muted" hidden>No tools match your search. Try another word or clear the search.</p>

  {Object.entries(groupedTools).map(([category, items]) => (
    <section class="tool-category" data-category-section={category}>
      <div class="tool-category-inner">
        <h2>{category}</h2>
        <div class="tools-grid">
          {(items ?? []).map((tool) => {
            const membersOnly = tool.membersonly ?? false;
            const isComingSoon = tool.status === "coming-soon";
            const isNew = tool.href === NEW_TOOL_HREF;
            const searchBlob = `${tool.title} ${tool.description}`
              .toLowerCase()
              .replace(/\s+/g, " ")
              .trim();
            const cardAttrs = {
              class: `kbm-card active tool-card-link${isComingSoon ? " disabled" : ""}`,
              "data-membersonly": String(membersOnly),
              "data-category": tool.category,
              "data-coming-soon": isComingSoon ? "true" : "false",
              "data-tool-search": searchBlob,
            };
            const inner = (
              <>
                {isComingSoon && <CardRibbon label="Coming Soon" variant="soon" />}
                {isNew && <CardRibbon label="New" variant="new" />}
                <img
                  src={`/icons/tools/${tool.icon}`}
                  alt=""
                  class="tool-icon"
                />
                <h3>{tool.title} </h3>
                <p>{tool.description}</p>
                {membersOnly && !isNew && (
                  <span class="tool-member-lock">
                    <svg
                      class="tool-member-lock__icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                      <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <span class="sr-only">Member tool</span>
                  </span>
                )}
              </>
            );
            return isComingSoon ? (
              <div {...cardAttrs} aria-disabled="true">
                {inner}
              </div>
            ) : (
              <a href={tool.href} {...cardAttrs}>
                {inner}
              </a>
            );
          })}
        </div>
        <div class="tools-coming-soon">
          <span class="tools-coming-soon-icon">✦</span>
          <span>More tools coming - including member-only tools for advanced shaping and pattern planning</span>
        </div>
      </div>
    </section>
  ))}

</section>

<script>
  const toolsPage = document.querySelector<HTMLElement>(".tools-page");
  const accessButtons = document.querySelectorAll<HTMLButtonElement>("#tool-access-filters .filter-pill");
  const categorySections = document.querySelectorAll<HTMLElement>(".tool-category[data-category-section]");
  const cards = document.querySelectorAll<HTMLElement>(".tools-grid .kbm-card");
  const searchToggle = document.getElementById("tools-search-toggle");
  const searchInput = document.getElementById("tools-search-input") as HTMLInputElement | null;
  const searchClearBtn = document.getElementById("tools-search-clear");
  const searchResultsLine = document.getElementById("tools-search-results-line");
  const searchTermDisplay = document.getElementById("tools-search-term-display");
  const searchEmptyMsg = document.getElementById("tools-search-empty");

  let activeAccessFilter = "all";

  function getSearchQuery(): string {
    return (searchInput?.value ?? "").trim().toLowerCase();
  }

  function updateSearchChrome() {
    const q = getSearchQuery();
    const hasQuery = q.length > 0;

    toolsPage?.classList.toggle("tools-page--search-query", hasQuery);
    searchToggle?.classList.toggle("active", hasQuery);

    if (searchResultsLine && searchTermDisplay) {
      searchResultsLine.hidden = !hasQuery;
      searchTermDisplay.textContent = hasQuery ? (searchInput?.value ?? "").trim() : "";
    }

    if (searchClearBtn) searchClearBtn.hidden = !hasQuery;
  }

  function applyToolFilters() {
    const q = getSearchQuery();

    cards.forEach((card) => {
      const isMember = card.dataset.membersonly === "true";
      const blob = card.dataset.toolSearch ?? "";

      const matchesAccess =
        activeAccessFilter === "all" ||
        (activeAccessFilter === "false" && !isMember) ||
        (activeAccessFilter === "true" && isMember);

      const matchesSearch = !q || blob.includes(q);

      card.style.display = matchesAccess && matchesSearch ? "" : "none";
    });

    categorySections.forEach((section) => {
      const visibleInSection = section.querySelectorAll<HTMLElement>(
        ".tools-grid .kbm-card"
      );
      let any = false;
      visibleInSection.forEach((c) => {
        if (c.style.display !== "none") any = true;
      });
      section.style.display = any ? "" : "none";
    });

    updateSearchChrome();

    let visibleCount = 0;
    cards.forEach((c) => {
      if (c.style.display !== "none") visibleCount++;
    });
    if (searchEmptyMsg) {
      searchEmptyMsg.hidden = !(q.length > 0 && visibleCount === 0);
    }
  }

  searchToggle?.addEventListener("click", () => {
    searchInput?.focus();
  });

  searchClearBtn?.addEventListener("click", () => {
    if (searchInput) searchInput.value = "";
    applyToolFilters();
    searchInput?.focus();
  });

  searchInput?.addEventListener("input", () => {
    applyToolFilters();
  });

  searchInput?.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      e.preventDefault();
      searchInput?.blur();
      searchToggle?.focus();
    }
  });

  accessButtons.forEach((button) => {
    button.addEventListener("click", () => {
      accessButtons.forEach((b) => b.classList.remove("active"));
      button.classList.add("active");
      activeAccessFilter = button.dataset.filter || "all";
      applyToolFilters();
    });
  });

  applyToolFilters();
</script>

<style>

.tools-page{
  max-width:1100px;
  margin:auto;
  padding:12px 20px 40px;
}

.tools-page > h1 {
  margin-bottom: 0.35rem;
}

.tools-intro{
  max-width:100%;
  margin-bottom: 0.85rem;
}

.tools-page .small.text-muted {
  font-size: 0.875rem;
  color: var(--text-muted, #6b7280);
  margin: 0.75rem 0 0;
  line-height: 1.5;
}

.tools-filters {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-top: 0.35rem;
}

.tools-filter-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.tools-access-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-top: 0;
}

.tools-access-filters.filter-pills {
  flex: 1 1 auto;
  min-width: 0;
  margin-bottom: 0;
}

.tools-search-panel {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  flex: 1 1 200px;
  min-width: min(100%, 12rem);
}

.tools-search-toggle.filter-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 12px;
  flex-shrink: 0;
}

.tools-search-toggle__icon {
  display: block;
}

.tools-search-input {
  appearance: none;
  -webkit-appearance: none;
  flex: 1 1 10rem;
  min-width: 0;
  max-width: 22rem;
  box-sizing: border-box;
  margin: 0;
  padding: 6px 14px;
  font-family: var(--font);
  font-size: 0.85rem;
  line-height: 1.2;
  color: #243015;
  background: #fff;
  border: 1px solid #d7e2c8;
  border-radius: 999px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.tools-search-input::-webkit-search-decoration,
.tools-search-input::-webkit-search-cancel-button {
  -webkit-appearance: none;
  appearance: none;
}

.tools-search-input::placeholder {
  color: var(--text-muted, #6b7280);
  opacity: 1;
}

.tools-search-input:focus {
  outline: 2px solid rgba(82, 104, 45, 0.25);
  outline-offset: 2px;
  border-color: var(--kbm-green, #52682d);
}

.tools-search-clear.filter-pill {
  flex-shrink: 0;
  padding: 6px 14px;
  font-weight: 600;
}

.tools-search-results-line {
  margin-top: 0;
  margin-bottom: 0;
}

.tools-search-term-display {
  font-weight: 600;
  color: var(--text-muted, #4b5563);
}

.tools-search-empty {
  margin: 1rem 0 0;
}

.tools-page--search-query .tool-category {
  margin-top: 1.25rem;
}

.tools-page--search-query .tool-category h2 {
  display: none;
}

.tools-page--search-query .tools-coming-soon {
  display: none;
}

#tool-access-filters.filter-pills {
  margin-top: 0;
  gap: 6px;
}

.tool-category{
  margin-top:60px;
}

.tool-category-inner{
  max-width:1100px;
  margin:auto;
}

.tool-category h2{
  background:var(--kbm-green);
  color:white;
  padding:12px 20px;
  border-radius:6px;
  font-size:18px;
  font-weight:600;
  margin-bottom:24px;
}

.tools-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:28px;
  margin-top:18px;
}

.tool-card{
  position:relative;
  display:block;
  text-decoration:none;
  color:inherit;
  padding:32px 26px;
  text-align:center;
  border-radius:20px;
  border:1px solid #e5e7eb;
  background:white;
}

.tool-badge{
  position:absolute;
  top:0;
  right:0;
  font-size:11px;
  font-weight:600;
  padding:5px 10px;
  border-bottom-left-radius:8px;
  line-height:1.2;
  z-index:2;
}

.tool-badge.coming{
  background:#f3f3f3;
  color:#888;
}

.tool-card.active{
  transition:transform 0.15s ease, box-shadow 0.15s ease;
}

.tool-card.active:hover{
  transform:translateY(-2px);
  box-shadow:0 14px 28px rgba(0,0,0,.08);
}

.tool-card.inactive{
  opacity:0.6;
  cursor:default;
}

.tool-card.inactive h3,
.tool-card.inactive p{
  color:inherit;
}

.tools-grid .kbm-card .tool-icon,
.tools-grid .tool-card .tool-icon{
  display:block;
  margin-left:auto;
  margin-right:auto;
  width:64px;
  height:64px;
  margin-bottom:16px;
}

.tool-card h3{
  margin:8px 0;
  text-decoration:none;
}

.tool-card p{
  font-size:14px;
  color:#555;
  text-decoration:none;
}

.tool-member-lock{
  position:absolute;
  top:14px;
  right:14px;
  z-index:3;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  color:var(--kbm-green,#52682d);
}

.tool-member-lock__icon{
  width:34px;
  height:34px;
  display:block;
}

.sr-only{
  position:absolute;
  width:1px;
  height:1px;
  padding:0;
  margin:-1px;
  overflow:hidden;
  clip:rect(0,0,0,0);
  white-space:nowrap;
  border:0;
}

.tools-coming-soon {
  margin-top: 1rem;
  font-size: 0.875rem;
  color: #666;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.tools-coming-soon-icon {
  color: var(--kbm-green, #52682d);
}

</style>
