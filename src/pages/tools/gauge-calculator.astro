---
import Layout from "../../layouts/Layout.astro";
import WizardBackLink from "../../components/wizards/WizardBackLink.astro";
import ToolPageHeader from "../../components/tools/ToolPageHeader.astro";
import UnitToggle from "../../components/wizards/UnitToggle.astro";
import FloatingInput from "../../components/tools/FloatingInput.astro";
import PrintButton from "../../components/common/PrintButton.astro";
import ToolResultCard from "../../components/tools/ToolResultCard.astro";
import ToolGate from "../../components/ui/ToolGate.astro";
import toolsData from "../../../data/tools.json";
import "../../styles/wizard.css";

export const prerender = true;

const tools = toolsData as Array<{
  href?: string;
  title?: string;
  icon?: string;
  membersonly?: boolean;
}>;
const tool = tools.find((t) => t.href === Astro.url.pathname) ?? null;
const toolPrintTitle = tool?.title ?? "Gauge Calculator";
---

<Layout
  title="Gauge Calculator | Knit by Machine"
  description="Figure out stitch gauge and row gauge from your swatch measurements. Enter stitches, rows, width, and height for results per 4 inches or 10 cm."
  toolPrintTitle={toolPrintTitle}
>
  <main class="wizard-page">
    <div class="wizard-shell">
      <WizardBackLink className="back-link" />

      <section class="wizard-hero gauge-hero">
        <ToolPageHeader tool={tool} fallbackTitle="Gauge Calculator" />
        <h2 class="gauge-tagline">Skip the Math!</h2>
        <p class="wizard-intro gauge-hero-intro">
          The Gauge Calculator helps you figure out the stitch gauge and row gauge of your knitted swatch.
        </p>
        <p class="wizard-intro gauge-hero-intro">
          Accurate gauge measurements help your projects turn out the way you expect.
        </p>
      </section>

      <div class="gauge-tool-wrap">
        <div class="gauge-calculator-panel kbm-tool-calculator-area">
          <form id="wizard-form" class="gauge-form" novalidate>
            <div class="gauge-tool-layout">
              <div class="gauge-input-column">
                <h2 class="gauge-form-section-title gauge-form-section-title--inline-help">
                  <span class="gauge-form-heading-text">Enter your measurements</span>
                  <button
                    type="button"
                    class="gauge-help-trigger"
                    id="gauge-measure-help-open"
                    aria-haspopup="dialog"
                    aria-controls="gauge-measure-dialog"
                    aria-label="How to measure"
                    title="How to measure"
                  >
                    <img
                      src="/images/help.svg"
                      alt=""
                      width="18"
                      height="32"
                      decoding="async"
                    />
                  </button>
                </h2>

                <div class="gauge-units-block">
                  <UnitToggle id="gauge-units" />
                </div>

                <div class="gauge-input-grid">
                  <div class="gauge-field">
                    <FloatingInput
                      id="measuredStitches"
                      name="measuredStitches"
                      label="Measured Stitches"
                      type="number"
                      min={1}
                      step={1}
                      inputmode="numeric"
                      placeholder=" "
                    />
                    <p class="gauge-field-hint"Measure stitches between markers only.</p>
                  </div>
                  <div class="gauge-field">
                    <FloatingInput
                      id="measuredRows"
                      name="measuredRows"
                      label="Measured Rows"
                      type="number"
                      min={1}
                      step={1}
                      inputmode="numeric"
                      placeholder=" "
                    />
                    <p class="gauge-field-hint">Measure rows between markers only.</p>
                  </div>
                  <div class="gauge-field">
                    <FloatingInput
                      id="widthMeasured"
                      name="widthMeasured"
                      label="Width Measured"
                      type="number"
                      min={0.01}
                      step={0.01}
                      inputmode="decimal"
                      placeholder=" "
                    />
                    <p class="gauge-field-hint">Width across those stitches.</p>
                  </div>
                  <div class="gauge-field">
                    <FloatingInput
                      id="heightMeasured"
                      name="heightMeasured"
                      label="Height Measured"
                      type="number"
                      min={0.01}
                      step={0.01}
                      inputmode="decimal"
                      placeholder=" "
                    />
                    <p class="gauge-field-hint">Height across those rows.</p>
                  </div>
                </div>

                <div class="gauge-actions">
                  <button type="submit" class="wizard-button" id="gaugeCalculateBtn">Calculate Gauge</button>
                </div>

                <div id="gaugeValidation" class="gauge-validation" role="alert" hidden></div>
              </div>

              <aside class="gauge-image-panel" aria-label="Swatch measurement reference">
                <div class="gauge-image-panel__card">
                  <img
                    src="/images/tools/gauge-generator.png"
                    alt=""
                    class="gauge-reference-image"
                    width="520"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </aside>
            </div>
          </form>
        </div>

        <ToolResultCard
          id="gauge-results"
          hidden
          title="Your gauge"
          resultsContentId="gaugeResultsContent"
          singleColumn={true}
        >
          <PrintButton slot="actions" label="" ariaLabel="Print gauge results" />
          <div class="gauge-results-body">
            <div class="gauge-result-row">
              <div class="gauge-result-row__label">Stitch Gauge</div>
              <div class="gauge-result-row__value" id="stitchGaugeResult"></div>
            </div>
            <div class="gauge-result-row">
              <div class="gauge-result-row__label">Row Gauge</div>
              <div class="gauge-result-row__value" id="rowGaugeResult"></div>
            </div>
          </div>
        </ToolResultCard>

        <ToolGate tool={tool} />
      </div>
    </div>

    <dialog id="gauge-measure-dialog" class="gauge-measure-dialog" aria-labelledby="gauge-measure-dialog-title">
      <div class="gauge-measure-dialog__shell">
        <div class="gauge-measure-dialog__header">
          <h2 id="gauge-measure-dialog-title" class="gauge-measure-dialog__title">How to measure</h2>
          <button type="button" class="gauge-measure-dialog__close" id="gauge-measure-dialog-close" aria-label="Close">
            ✕
          </button>
        </div>
        <div class="gauge-measure-dialog__body">
          <p><strong>Choose inches or cm</strong></p>
          <p>Select the unit you used to measure your swatch.</p>

          <p><strong>Enter stitch count</strong></p>
          <p>Enter the total number of stitches you measured across your swatch.</p>
          <p>Measure between the marked stitches, not across the entire swatch.</p>

          <p><strong>Enter row count</strong></p>
          <p>Enter the total number of rows you measured from top to bottom.</p>
          <p>Measure between the marked rows, not the entire swatch.</p>

          <p><strong>Enter width measurement</strong></p>
          <p>Enter the width of the measured stitches in inches or cm.</p>

          <p><strong>Enter height measurement</strong></p>
          <p>Enter the height of the measured rows in inches or cm.</p>

          <p><strong>Click Calculate Gauge</strong></p>
          <p>The tool will calculate:</p>
          <ul class="gauge-measure-dialog__list">
            <li><strong>Stitch Gauge:</strong> stitches per 4" or 10 cm</li>
            <li><strong>Row Gauge:</strong> rows per 4" or 10 cm</li>
          </ul>

          <p><strong>Tips for more accurate gauge:</strong></p>
          <ul class="gauge-measure-dialog__list">
            <li>Measure your swatch after it has rested and been blocked</li>
            <li>Use a ruler with clear markings</li>
            <li>Measure more than one area of the swatch and average the results when needed</li>
          </ul>
        </div>
      </div>
    </dialog>
  </main>

  <style>
    /* Compact hero — form stays high on the page (Dart-style) */
    .gauge-hero .gauge-tagline {
      margin: 0.2rem 0 0.35rem;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--kbm-green);
      line-height: 1.25;
    }

    .gauge-hero .gauge-hero-intro {
      margin: 0.2rem 0;
      max-width: 44rem;
    }

    .gauge-hero .gauge-hero-intro:last-of-type {
      margin-bottom: 0.65rem;
    }

    .gauge-tool-wrap {
      position: relative;
      margin-bottom: 2rem;
    }

    /* Match Dart Formula calculator panel */
    .gauge-calculator-panel {
      background: #fff;
      padding: 1.75rem;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      margin-bottom: 1.5rem;
    }

    @media (max-width: 640px) {
      .gauge-calculator-panel {
        padding: 1.25rem;
      }
    }

    .gauge-tool-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      align-items: start;
    }

    .gauge-input-column {
      min-width: 0;
      max-width: 100%;
    }

    .gauge-image-panel {
      min-width: 0;
      order: -1;
      max-width: min(480px, 100%);
      margin: 0 auto;
      width: 100%;
    }

    @media (min-width: 992px) {
      .gauge-tool-layout {
        grid-template-columns: minmax(0, 380px) minmax(480px, 1.65fr);
        gap: 1.5rem 2rem;
      }

      .gauge-input-column {
        max-width: 380px;
      }

      .gauge-image-panel {
        order: 0;
        max-width: none;
        margin: 0;
        width: auto;
      }
    }

    .gauge-image-panel__card {
      background: #fafaf8;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
      height: 100%;
    }

    .gauge-reference-image {
      width: 100%;
      max-width: 100%;
      height: auto;
      display: block;
      margin: 0 auto;
      border-radius: 8px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    }

    .gauge-form-section-title--inline-help {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      flex-wrap: wrap;
      margin: 0 0 0.5rem;
      font-size: 1.25rem;
      font-weight: 700;
      color: #2f3a2f;
      line-height: 1.3;
    }

    .gauge-form-heading-text {
      margin: 0;
    }

    .gauge-help-trigger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin: 0;
      padding: 0;
      border: none;
      background: transparent;
      cursor: pointer;
      border-radius: 4px;
      line-height: 0;
      opacity: 0.8;
    }

    .gauge-help-trigger:hover {
      opacity: 1;
    }

    .gauge-help-trigger:focus-visible {
      outline: 2px solid #52682d;
      outline-offset: 2px;
      opacity: 1;
    }

    .gauge-help-trigger img {
      display: block;
      width: 17px;
      height: auto;
    }

    /* Native <dialog> — same pattern as glossary modal (positioning below fixed header) */
    dialog.gauge-measure-dialog {
      position: fixed;
      top: calc(var(--header-offset, 170px) + 12px);
      left: 50%;
      transform: translateX(-50%);
      width: min(480px, 92vw);
      max-height: calc(100vh - var(--header-offset, 170px) - 24px);
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 12px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      z-index: 99999;
    }

    dialog.gauge-measure-dialog::backdrop {
      background: rgba(0, 0, 0, 0.45);
    }

    .gauge-measure-dialog__shell {
      display: flex;
      flex-direction: column;
      max-height: inherit;
      min-height: 0;
    }

    .gauge-measure-dialog__header {
      position: relative;
      flex: 0 0 auto;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      padding: 1rem 2.75rem 0.75rem 1.25rem;
      border-bottom: 1px solid #e5e7eb;
    }

    .gauge-measure-dialog__title {
      margin: 0;
      font-size: 1.2rem;
      font-weight: 700;
      color: #1f2937;
      line-height: 1.3;
    }

    .gauge-measure-dialog__close {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 40px;
      height: 40px;
      margin: 0;
      padding: 0;
      line-height: 1;
      border-radius: 10px;
      border: 1px solid rgba(0, 0, 0, 0.12);
      background: #fff;
      color: #374151;
      font-size: 1.1rem;
      cursor: pointer;
    }

    .gauge-measure-dialog__close:hover {
      background: #f3f4f6;
    }

    .gauge-measure-dialog__body {
      flex: 1 1 auto;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      padding: 1rem 1.25rem 1.25rem;
      font-size: 0.9375rem;
      line-height: 1.55;
      color: #4b5563;
    }

    .gauge-measure-dialog__body p {
      margin: 0 0 0.5rem;
    }

    .gauge-measure-dialog__body p strong {
      color: #374151;
    }

    .gauge-measure-dialog__list {
      margin: 0 0 0.75rem;
      padding-left: 1.2rem;
    }

    .gauge-measure-dialog__list li + li {
      margin-top: 0.25rem;
    }

    .gauge-units-block {
      margin-bottom: 0.65rem;
    }

    .gauge-input-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.65rem 1rem;
    }

    @media (max-width: 640px) {
      .gauge-input-grid {
        grid-template-columns: 1fr;
      }
    }

    .gauge-field-hint {
      margin: 0.2rem 0 0;
      font-size: 0.8rem;
      line-height: 1.35;
      color: #6b7280;
    }

    .gauge-actions {
      margin-top: 0.85rem;
    }

    .gauge-actions .wizard-button {
      padding: 12px 22px;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 8px;
      background: #52682d;
      color: #fff;
      border: none;
      cursor: pointer;
      transition: background 0.2s;
    }

    .gauge-actions .wizard-button:hover {
      background: #445626;
    }

    .gauge-validation {
      margin-top: 1.25rem;
      padding: 14px 18px;
      border-left: 6px solid #d9534f;
      background: #fff4f4;
      border-radius: 6px;
      font-size: 0.95rem;
      color: #333;
    }

    .gauge-validation[hidden] {
      display: none;
    }

    .gauge-validation:not([hidden]) {
      display: block;
    }

    :global(#gaugeResultsContent) {
      line-height: 1.55;
    }

    .gauge-results-body {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .gauge-result-row__label {
      font-size: 0.95rem;
      font-weight: 600;
      color: #52682d;
      margin-bottom: 0.35rem;
    }

    .gauge-result-row__value {
      font-size: 1.45rem;
      font-weight: 700;
      line-height: 1.3;
      color: #1f2937;
    }
  </style>

  <script>
    const form = document.getElementById("wizard-form") as HTMLFormElement | null;
    const validationEl = document.getElementById("gaugeValidation");
    const resultsCard = document.getElementById("gauge-results");
    const stitchGaugeResult = document.getElementById("stitchGaugeResult");
    const rowGaugeResult = document.getElementById("rowGaugeResult");

    if (!form || !validationEl || !resultsCard || !stitchGaugeResult || !rowGaugeResult) {
      throw new Error("Gauge calculator: missing DOM elements");
    }

    const formEl = form;
    const validationElEl = validationEl;
    const resultsCardEl = resultsCard;
    const stitchGaugeResultEl = stitchGaugeResult;
    const rowGaugeResultEl = rowGaugeResult;

    function getUnit(): "in" | "cm" {
      const el = document.getElementById("gauge-units-unit") as HTMLInputElement | null;
      const v = el?.value?.trim();
      return v === "cm" ? "cm" : "in";
    }

    /** Always show two decimal places. */
    function formatGaugeValue(value: number): string {
      const rounded = Math.round(value * 100) / 100;
      return rounded.toFixed(2);
    }

    function parsePositiveNumber(raw: string): number | null {
      const t = raw.trim();
      if (t === "") return null;
      const n = parseFloat(t);
      if (Number.isNaN(n) || n <= 0) return null;
      return n;
    }

    function validateAndCollect():
      | { ok: true; stitches: number; rows: number; width: number; height: number }
      | { ok: false; message: string } {
      const fd = new FormData(formEl);
      const stitchesRaw = (fd.get("measuredStitches") ?? "").toString();
      const rowsRaw = (fd.get("measuredRows") ?? "").toString();
      const widthRaw = (fd.get("widthMeasured") ?? "").toString();
      const heightRaw = (fd.get("heightMeasured") ?? "").toString();

      const stitches = parsePositiveNumber(stitchesRaw);
      const rows = parsePositiveNumber(rowsRaw);
      const width = parsePositiveNumber(widthRaw);
      const height = parsePositiveNumber(heightRaw);

      const missing: string[] = [];
      if (stitches === null) missing.push("measured stitches");
      if (rows === null) missing.push("measured rows");
      if (width === null) missing.push("width measured");
      if (height === null) missing.push("height measured");

      if (missing.length > 0) {
        return {
          ok: false,
          message: `Please enter every field with a number greater than zero. Check: ${missing.join(", ")}.`,
        };
      }

      return { ok: true, stitches: stitches!, rows: rows!, width: width!, height: height! };
    }

    function hideResults(): void {
      resultsCardEl.hidden = true;
    }

    formEl.addEventListener("input", () => {
      validationElEl.hidden = true;
      hideResults();
    });

    formEl.addEventListener("submit", (e) => {
      e.preventDefault();
      validationElEl.hidden = true;

      const parsed = validateAndCollect();
      if (!parsed.ok) {
        validationElEl.hidden = false;
        validationElEl.textContent = parsed.message;
        hideResults();
        return;
      }

      const unit = getUnit();
      let stitchGauge: number;
      let rowGauge: number;
      let stitchLine: string;
      let rowLine: string;

      if (unit === "in") {
        stitchGauge = (parsed.stitches / parsed.width) * 4;
        rowGauge = (parsed.rows / parsed.height) * 4;
        stitchLine = `${formatGaugeValue(stitchGauge)} stitches per 4″`;
        rowLine = `${formatGaugeValue(rowGauge)} rows per 4″`;
      } else {
        stitchGauge = (parsed.stitches / parsed.width) * 10;
        rowGauge = (parsed.rows / parsed.height) * 10;
        stitchLine = `${formatGaugeValue(stitchGauge)} stitches per 10 cm`;
        rowLine = `${formatGaugeValue(rowGauge)} rows per 10 cm`;
      }

      stitchGaugeResultEl.textContent = stitchLine;
      rowGaugeResultEl.textContent = rowLine;
      resultsCardEl.hidden = false;
      const resultsEl = document.getElementById("gauge-results");
      if (resultsEl) {
        resultsEl.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });

    window.addEventListener("kbm:units-change", () => {
      validationElEl.hidden = true;
      hideResults();
    });

    const measureDialog = document.getElementById("gauge-measure-dialog") as HTMLDialogElement | null;
    const measureHelpOpen = document.getElementById("gauge-measure-help-open");
    const measureDialogClose = document.getElementById("gauge-measure-dialog-close");

    function closeMeasureDialog(): void {
      measureDialog?.close();
    }

    measureHelpOpen?.addEventListener("click", () => {
      measureDialog?.showModal();
      measureDialogClose?.focus();
    });

    measureDialogClose?.addEventListener("click", closeMeasureDialog);

    measureDialog?.addEventListener("click", (e) => {
      if (e.target === measureDialog) closeMeasureDialog();
    });
  </script>
</Layout>
