---
import Layout from "../../layouts/Layout.astro";
import WizardBackLink from "../../components/wizards/WizardBackLink.astro";
import ToolPageHeader from "../../components/tools/ToolPageHeader.astro";
import UnitToggle from "../../components/wizards/UnitToggle.astro";
import FloatingInput from "../../components/tools/FloatingInput.astro";
import MemberLockOverlay from "../../components/ui/MemberLockOverlay.astro";
import toolsData from "../../../data/tools.json";
import "../../styles/wizard.css";

const tools = toolsData as Array<{
  href?: string;
  title?: string;
  icon?: string;
  membersonly?: boolean;
}>;
const tool = tools.find((t) => t.href === Astro.url.pathname) ?? null;
const isMemberOnly = tool?.membersonly === true;
const toolPrintTitle = tool?.title ?? "Gauge Calculator";
---

<Layout
  title="Gauge Calculator | Knit by Machine"
  description="Calculate stitch and row gauge from a measured section of your swatch. Enter stitch and row counts with the width and height of that same section."
  toolPrintTitle={toolPrintTitle}
>
  <main class="wizard-page">
    <div class="wizard-shell">
      <WizardBackLink fallback="/help-hub" className="back-link" label="← Back" />

      <section class="wizard-hero">
        <ToolPageHeader tool={tool} fallbackTitle="Gauge Calculator" />
        <h2 class="gauge-hero-heading">Skip the math. Just measure your swatch.</h2>
        <p class="wizard-intro">
          Enter your stitches, rows, width, and height—we’ll calculate your gauge.
        </p>
      </section>

      <div class="gauge-tool-wrap">
        <div class="gauge-calculator-panel kbm-tool-calculator-area">
          <form id="wizard-form" class="gauge-form" novalidate>
            <div class="dart-tool-layout">
              <div class="dart-input-column">
                <div class="section-header-with-toggle">
                  <h2>Enter your measurements</h2>
                  <UnitToggle id="gauge-units" />
                </div>

                <div class="gauge-input-grid">
                  <FloatingInput
                    id="numStitches"
                    name="numStitches"
                    label="Measured stitch count"
                    type="number"
                    min={1}
                    step={1}
                    inputmode="numeric"
                    placeholder=" "
                  />
                  <FloatingInput
                    id="numRows"
                    name="numRows"
                    label="Measured row count"
                    type="number"
                    min={1}
                    step={1}
                    inputmode="numeric"
                    placeholder=" "
                  />
                  <FloatingInput
                    id="measuredWidth"
                    name="measuredWidth"
                    label="Measured width (inches)"
                    labelId="measuredWidthLabel"
                    type="number"
                    min={0.01}
                    step={0.01}
                    inputmode="decimal"
                    placeholder=" "
                  />
                  <FloatingInput
                    id="measuredHeight"
                    name="measuredHeight"
                    label="Measured height (inches)"
                    labelId="measuredHeightLabel"
                    type="number"
                    min={0.01}
                    step={0.01}
                    inputmode="decimal"
                    placeholder=" "
                  />
                </div>

                <div class="gauge-actions">
                  <button type="submit" class="wizard-button" id="gaugeCalculateBtn">Calculate</button>
                </div>

                <div id="gaugeValidation" class="gauge-validation" role="alert" hidden></div>

                <div id="gaugeResults" class="gauge-results" hidden>
                  <div class="gauge-result-card">
                    <div class="gauge-result-label">Stitch Gauge</div>
                    <div class="gauge-result-primary" id="stitchGaugeResult"></div>
                  </div>
                  <div class="gauge-result-card">
                    <div class="gauge-result-label">Row Gauge</div>
                    <div class="gauge-result-primary" id="rowGaugeResult"></div>
                  </div>
                </div>
              </div>

              <aside class="dart-image-panel" aria-label="Gauge illustration">
                <img
                  src="/images/tools/gauge-generator.png"
                  alt=""
                  class="dart-reference-image"
                  width="520"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              </aside>
            </div>
          </form>
        </div>

        {isMemberOnly && (
          <div data-ms-content="!paid-plans">
            <MemberLockOverlay
              title="This tool is for members"
              message="You’ll need an active membership to use this tool."
              ctaText="Become a member"
            />
          </div>
        )}
      </div>

      <div class="gauge-below-calculator">
        <div class="gauge-important-note" role="note">
          <strong>Important:</strong> Measure between your markers, not across the entire swatch.
        </div>
        <p class="gauge-note-follow">
          Enter the number of stitches and rows measured inside that marked area, then enter the width and height of that same section.
        </p>
      </div>
    </div>
  </main>

  <style>
    .gauge-hero-heading {
      margin: 0.35rem 0 0.75rem;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--kbm-green);
      line-height: 1.25;
    }

    .gauge-tool-wrap {
      position: relative;
      margin-bottom: 1.5rem;
    }

    .gauge-below-calculator {
      max-width: 42rem;
      margin-bottom: 2rem;
    }

    .gauge-below-calculator .gauge-important-note {
      margin-top: 0;
    }

    .gauge-calculator-panel {
      background: #fff;
      padding: 1.75rem;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      margin-bottom: 1.5rem;
    }

    @media (max-width: 640px) {
      .gauge-calculator-panel {
        padding: 1.25rem;
      }
    }

    /* Same two-column layout as Dart Formula tool */
    .dart-tool-layout {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      align-items: flex-start;
    }
    .dart-input-column {
      flex: 1 1 320px;
      min-width: 0;
    }
    .dart-input-column > :global(.units-toggle) {
      margin-bottom: 1rem;
    }
    .dart-image-panel {
      flex: 0 1 280px;
      min-width: 0;
      margin: 0 auto;
    }
    @media (max-width: 767px) {
      .dart-image-panel {
        display: none;
      }
    }
    .dart-reference-image {
      width: 100%;
      max-width: 280px;
      height: auto;
      display: block;
      border-radius: 12px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    }

    .section-header-with-toggle {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }

    .section-header-with-toggle h2 {
      margin: 0;
      font-size: 1.25rem;
    }

    .gauge-input-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 8px;
    }

    @media (max-width: 640px) {
      .gauge-input-grid {
        grid-template-columns: 1fr;
      }
    }

    .gauge-actions {
      margin-top: 1.25rem;
    }

    .gauge-actions .wizard-button {
      padding: 12px 22px;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 8px;
      background: #52682d;
      color: #fff;
      border: none;
      cursor: pointer;
    }

    .gauge-actions .wizard-button:hover {
      background: #445626;
    }

    .gauge-validation {
      margin-top: 1.25rem;
      padding: 14px 18px;
      border-left: 6px solid #d9534f;
      background: #fff4f4;
      border-radius: 6px;
      font-size: 0.95rem;
      color: #333;
    }

    .gauge-validation[hidden] {
      display: none;
    }

    .gauge-validation:not([hidden]) {
      display: block;
    }

    .gauge-results {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .gauge-result-card {
      background: #f8f8f5;
      border: 1px solid #e3e5de;
      border-radius: 14px;
      padding: 1.25rem;
    }

    .gauge-result-label {
      font-size: 0.95rem;
      font-weight: 600;
      color: #52682d;
      margin-bottom: 0.5rem;
    }

    .gauge-result-primary {
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1.25;
      color: #1f2937;
    }

    @media (max-width: 640px) {
      .gauge-results {
        grid-template-columns: 1fr;
      }
    }

    .gauge-important-note {
      margin: 1.25rem 0 0.5rem;
      padding: 14px 18px;
      border-left: 4px solid #52682d;
      background: #f9fafb;
      border-radius: 8px;
      font-size: 0.95rem;
      line-height: 1.5;
      color: #374151;
    }

    .gauge-note-follow {
      margin: 0 0 0.5rem;
      font-size: 0.95rem;
      line-height: 1.55;
      color: #6b7280;
    }
  </style>

  <script>
    const form = document.getElementById("wizard-form") as HTMLFormElement | null;
    const validationEl = document.getElementById("gaugeValidation");
    const resultsPanel = document.getElementById("gaugeResults");
    const stitchGaugeResult = document.getElementById("stitchGaugeResult");
    const rowGaugeResult = document.getElementById("rowGaugeResult");
    const widthLabel = document.getElementById("measuredWidthLabel");
    const heightLabel = document.getElementById("measuredHeightLabel");

    if (!form || !validationEl || !resultsPanel || !stitchGaugeResult || !rowGaugeResult || !widthLabel || !heightLabel) {
      throw new Error("Gauge calculator: missing DOM elements");
    }

    const formEl = form;
    const validationElEl = validationEl;
    const resultsPanelEl = resultsPanel;
    const stitchGaugeResultEl = stitchGaugeResult;
    const rowGaugeResultEl = rowGaugeResult;
    const widthLabelEl = widthLabel;
    const heightLabelEl = heightLabel;

    function getUnit(): "in" | "cm" {
      const el = document.getElementById("unit") as HTMLInputElement | null;
      const v = el?.value?.trim();
      return v === "cm" ? "cm" : "in";
    }

    function updateDimensionLabels(unit: "in" | "cm"): void {
      if (unit === "cm") {
        widthLabelEl.textContent = "Measured width (cm)";
        heightLabelEl.textContent = "Measured height (cm)";
      } else {
        widthLabelEl.textContent = "Measured width (inches)";
        heightLabelEl.textContent = "Measured height (inches)";
      }
    }

    /** Round to 2 decimals; trim trailing zeros (32 not 32.00; 32.5 not 32.50). */
    function formatGaugeValue(value: number): string {
      const rounded = Math.round(value * 100) / 100;
      if (Number.isInteger(rounded)) return String(rounded);
      return rounded.toFixed(2).replace(/0+$/, "").replace(/\.$/, "");
    }

    function parsePositiveNumber(raw: string): number | null {
      const t = raw.trim();
      if (t === "") return null;
      const n = parseFloat(t);
      if (Number.isNaN(n) || n <= 0) return null;
      return n;
    }

    function validateAndCollect(): { ok: true; stitches: number; rows: number; width: number; height: number } | { ok: false; message: string } {
      const fd = new FormData(formEl);
      const stitchesRaw = (fd.get("numStitches") ?? "").toString();
      const rowsRaw = (fd.get("numRows") ?? "").toString();
      const widthRaw = (fd.get("measuredWidth") ?? "").toString();
      const heightRaw = (fd.get("measuredHeight") ?? "").toString();

      const stitches = parsePositiveNumber(stitchesRaw);
      const rows = parsePositiveNumber(rowsRaw);
      const width = parsePositiveNumber(widthRaw);
      const height = parsePositiveNumber(heightRaw);

      const missing: string[] = [];
      if (stitches === null) missing.push("stitch count");
      if (rows === null) missing.push("row count");
      if (width === null) missing.push("width");
      if (height === null) missing.push("height");

      if (missing.length > 0) {
        return {
          ok: false,
          message: `Please enter every field with a number greater than zero. Check: ${missing.join(", ")}.`,
        };
      }

      return { ok: true, stitches: stitches!, rows: rows!, width: width!, height: height! };
    }

    function hideResults(): void {
      resultsPanelEl.hidden = true;
    }

    formEl.addEventListener("input", () => {
      validationElEl.hidden = true;
      hideResults();
    });

    formEl.addEventListener("submit", (e) => {
      e.preventDefault();
      validationElEl.hidden = true;

      const parsed = validateAndCollect();
      if (!parsed.ok) {
        validationElEl.hidden = false;
        validationElEl.textContent = parsed.message;
        hideResults();
        return;
      }

      const unit = getUnit();
      let stitchGauge: number;
      let rowGauge: number;
      let stitchLine: string;
      let rowLine: string;

      if (unit === "in") {
        stitchGauge = (parsed.stitches / parsed.width) * 4;
        rowGauge = (parsed.rows / parsed.height) * 4;
        stitchLine = `${formatGaugeValue(stitchGauge)} sts per 4″`;
        rowLine = `${formatGaugeValue(rowGauge)} rows per 4″`;
      } else {
        stitchGauge = (parsed.stitches / parsed.width) * 10;
        rowGauge = (parsed.rows / parsed.height) * 10;
        stitchLine = `${formatGaugeValue(stitchGauge)} sts per 10 cm`;
        rowLine = `${formatGaugeValue(rowGauge)} rows per 10 cm`;
      }

      stitchGaugeResultEl.textContent = stitchLine;
      rowGaugeResultEl.textContent = rowLine;
      resultsPanelEl.hidden = false;
    });

    window.addEventListener("kbm:units-change", (ev: Event) => {
      const unit = (ev as CustomEvent<{ unit?: string }>).detail?.unit === "cm" ? "cm" : "in";
      updateDimensionLabels(unit);
      validationElEl.hidden = true;
      hideResults();
    });

    function syncLabelsFromUnit(): void {
      updateDimensionLabels(getUnit());
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", syncLabelsFromUnit);
    } else {
      syncLabelsFromUnit();
    }
  </script>
</Layout>
