---
import Layout from "../../layouts/Layout.astro";
import BandPickupTool from "../../components/tools/BandPickupTool.astro";
import { findToolByRequestPath } from "../../lib/tools/toolMembership";

export const prerender = true;

// Match the catalog even when the request has a trailing slash. Prerender
// builds this page at `/tools/band-pickup/`, and the Help Hub link uses that
// form, while tools.json stores `/tools/band-pickup`.
const tool = findToolByRequestPath(Astro.url.pathname);
const toolPrintTitle = tool?.title ?? "Band Pickup";
---

<Layout
  title="Band Pickup | Knit by Machine"
  description="Estimate how many stitches to pick up along a cardigan front edge for a band. Enter your band gauge and the rows along the front edge for a starting point in inches or cm."
  toolPrintTitle={toolPrintTitle}
>
  <BandPickupTool tool={tool} context="page" />
</Layout>
