---
import Layout from "../../layouts/Layout.astro";
import WizardBackLink from "../../components/wizards/WizardBackLink.astro";
import ToolPageHeader from "../../components/tools/ToolPageHeader.astro";
import UnitToggle from "../../components/wizards/UnitToggle.astro";
import GaugeInput from "../../components/wizards/GaugeInput.astro";
import FloatingSelect from "../../components/tools/FloatingSelect.astro";
import FloatingInput from "../../components/tools/FloatingInput.astro";
import PrintButton from "../../components/common/PrintButton.astro";
import ToolResultCard from "../../components/tools/ToolResultCard.astro";
import ToolGate from "../../components/ui/ToolGate.astro";
import ToolPreviewGate from "../../components/ui/ToolPreviewGate.astro";
import toolsData from "../../../data/tools.json";
import { DART_CUP_SIZES, formatDartCupOptionLabel } from "../../lib/tools/dartFormulaMath";
import "../../styles/wizard.css";

const pageTitle = "Dart Formula | Knit by Machine";
const pageDescription =
  "Calculate short-row bust dart shaping from cup size and gauge. Clear machine-knitting hold instructions.";

const tools = toolsData as Array<{
  href?: string;
  title?: string;
  icon?: string;
  membersonly?: boolean;
}>;
const tool = tools.find((t) => t.href === Astro.url.pathname) ?? null;
const toolPrintTitle = tool?.title ?? "Dart Formula";

const cupOptions = DART_CUP_SIZES.map((value) => ({
  label: formatDartCupOptionLabel(value, "in"),
  value,
}));
---

<Layout title={pageTitle} description={pageDescription} toolPrintTitle={toolPrintTitle}>
  <main class="wizard-page">
    <div class="wizard-shell">
      <WizardBackLink className="back-link" />

      <section class="wizard-hero">
        <ToolPageHeader tool={tool} fallbackTitle="Dart Formula" />
        <p class="wizard-intro">
          Choose inches or centimeters, your cup size, then stitch and row gauge for your swatch (per 4″ or 10&nbsp;cm). Adjust dart width and depth if needed — the tool figures out how many needles to hold on every other row.
        </p>
      </section>

      <ToolGate tool={tool} />

      <ToolPreviewGate tool={tool}>
      <div class="dart-tool-wrap">
        <div class="dart-calculator-panel kbm-tool-calculator-area">
          <form id="wizard-form" class="dart-form" novalidate>
            <div class="dart-tool-layout">
              <div class="dart-input-column">
                <UnitToggle id="dart-units" />

                <FloatingSelect
                  id="cupSize"
                  name="cupSize"
                  label="Cup size"
                  placeholder="Select Cup Size"
                  options={cupOptions}
                  required
                  dataTestid="select-cup-size"
                />

                <div class="dart-dim-fields">
                  <FloatingInput
                    id="dartWidth"
                    name="dartWidth"
                    label="Dart width (in)"
                    type="number"
                    min={0.01}
                    step="any"
                    inputmode="decimal"
                    required
                    labelId="dartWidth-label"
                    dataTestid="input-dart-width"
                  />
                  <FloatingInput
                    id="dartDepth"
                    name="dartDepth"
                    label="Dart depth (in)"
                    type="number"
                    min={0.01}
                    step="any"
                    inputmode="decimal"
                    required
                    labelId="dartDepth-label"
                    dataTestid="input-dart-depth"
                  />
                </div>
                <p id="dartCustomizedBadge" class="dart-customized-badge" hidden>Customized</p>

                <GaugeInput id="dart" showTitle={false} showToggle={false} toggleId="dart-units" />

                <div id="validationSummary" class="validation-msg validation-summary" role="alert" hidden></div>

                <div class="form-actions">
                  <button type="submit" class="wizard-button" id="calculateDartBtn">Get Dart Instructions</button>
                </div>
              </div>

              <aside class="dart-image-panel" aria-label="Dart measurement reference">
                <img
                  src="/images/tools/dart-input.svg"
                  alt="Diagram of dart width and depth on a knitted piece"
                  class="dart-reference-image"
                  width="560"
                  height="420"
                  loading="lazy"
                  decoding="async"
                />
              </aside>
            </div>
          </form>
        </div>

        <ToolResultCard
          id="dartResults"
          hidden
          title="Your dart shaping"
          resultsContentId="dartResultsContent"
          singleColumn
        >
          <PrintButton slot="actions" label="" ariaLabel="Print instructions" />
        </ToolResultCard>
      </div>
      </ToolPreviewGate>
    </div>
  </main>

  <style>
    .dart-tool-wrap {
      position: relative;
    }
    .dart-calculator-panel {
      background: #fff;
      padding: 1.75rem;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      margin-bottom: 1.5rem;
    }
    @media (max-width: 640px) {
      .dart-calculator-panel {
        padding: 1.25rem;
      }
    }
    .dart-tool-layout {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      align-items: flex-start;
    }
    .dart-input-column {
      flex: 1 1 320px;
      min-width: 0;
    }
    .dart-input-column > :global(.units-toggle) {
      margin-bottom: 1rem;
    }
    .dart-dim-fields {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      margin: 0.75rem 0 0.35rem;
      min-width: 0;
    }
    @media (max-width: 480px) {
      .dart-dim-fields {
        grid-template-columns: 1fr;
      }
    }
    .dart-customized-badge {
      margin: 0 0 0.75rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: #52682d;
    }
    .dart-image-panel {
      flex: 0 1 280px;
      min-width: 0;
      margin: 0 auto;
    }
    @media (max-width: 767px) {
      .dart-image-panel {
        display: none;
      }
    }
    .dart-reference-image {
      width: 100%;
      max-width: 280px;
      height: auto;
      display: block;
      border-radius: 12px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    }
    .validation-msg {
      color: #dc3545;
      font-size: 0.9rem;
      margin-top: 0.5rem;
    }
    .validation-summary {
      margin-bottom: 0.5rem;
    }
    .form-actions {
      margin-top: 1.25rem;
    }
    .wizard-button {
      padding: 12px 22px;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 8px;
      background: #52682d;
      color: white;
      border: none;
      cursor: pointer;
      transition: background 0.2s;
    }
    .wizard-button:hover {
      background: #445626;
    }
    /* Injected into ToolResultCard #dartResultsContent (component root is unscoped) */
    :global(#dartResultsContent) {
      line-height: 1.6;
    }
    :global(#dartResultsContent) p {
      margin: 0.5rem 0;
    }
    :global(#dartResultsContent) .results-summary {
      font-weight: 600;
      color: #374151;
      margin-top: 0.75rem;
    }
    .dart-summary-table {
      width: 100%;
      max-width: 100%;
      border-collapse: collapse;
      font-size: 0.95rem;
      margin: 0.75rem 0 1rem;
    }
    .dart-summary-table th,
    .dart-summary-table td {
      text-align: left;
      padding: 0.35rem 0.5rem 0.35rem 0;
      border-bottom: 1px solid #e5e7eb;
      vertical-align: top;
    }
    .dart-summary-table th {
      font-weight: 600;
      color: #374151;
      width: 48%;
    }
    .dart-summary-table td {
      color: #4b5563;
    }
    .results-instruction-block {
      margin-top: 1rem;
      padding: 0.75rem;
      background: #fff;
      border-radius: 8px;
      border-left: 4px solid var(--kbm-green);
    }
    .results-instruction-block ul {
      margin: 0.5rem 0 0;
      padding-left: 1.25rem;
    }
    .results-instruction-block li {
      margin-bottom: 0.35rem;
    }
  </style>

  <script>
    import {
      computeDartShaping,
      convertDartLength,
      DART_CUP_SIZES,
      dartDimensionUnitLabel,
      displayDartLengthFromInches,
      formatDartCupOptionLabel,
      getCupDartPresetInches,
      isCustomDartDimensions,
      isDartCupSize,
      parsePositiveDartMeasurement,
      roundToTwoDecimals,
      type DartCupSize,
      type DartFormulaUnit,
    } from "../../lib/tools/dartFormulaMath.ts";
    import { buildDartFormulaResultsHtml } from "../../lib/tools/dartFormulaInstructions.ts";

    function getUnitFromForm(): DartFormulaUnit {
      const el = document.getElementById("dart-units-unit");
      const v = el && "value" in el ? String((el as HTMLInputElement).value).trim() : "";
      return v === "cm" ? "cm" : "in";
    }

    function syncCupSizeOptionLabels(unit: DartFormulaUnit): void {
      const sel = document.getElementById("cupSize");
      if (!sel || !("options" in sel)) return;
      const opts = (sel as HTMLSelectElement).options;
      for (let i = 0; i < opts.length; i++) {
        const opt = opts[i];
        const key = String(opt.value).trim();
        if (!key || !(DART_CUP_SIZES as readonly string[]).includes(key)) continue;
        opt.textContent = formatDartCupOptionLabel(key as DartCupSize, unit);
      }
    }

    function syncDimFieldLabels(unit: DartFormulaUnit): void {
      const suffix = dartDimensionUnitLabel(unit);
      const widthLabel = document.getElementById("dartWidth-label");
      const depthLabel = document.getElementById("dartDepth-label");
      if (widthLabel) widthLabel.textContent = `Dart width (${suffix})`;
      if (depthLabel) depthLabel.textContent = `Dart depth (${suffix})`;
    }

    function readNumber(id: string): number {
      const el = document.getElementById(id);
      if (!el || !("value" in el)) return NaN;
      const raw = String((el as HTMLInputElement).value).trim();
      if (raw === "") return NaN;
      return Number.parseFloat(raw);
    }

    function setNumberInput(id: string, value: number | null): void {
      const el = document.getElementById(id);
      if (!el || !("value" in el)) return;
      (el as HTMLInputElement).value = value == null ? "" : String(value);
      el.dispatchEvent(new Event("input", { bubbles: true }));
    }

    function loadPresetIntoFields(cupKey: DartCupSize, unit: DartFormulaUnit): void {
      const preset = getCupDartPresetInches(cupKey);
      setNumberInput("dartWidth", displayDartLengthFromInches(preset.dartWidthInches, unit));
      setNumberInput("dartDepth", displayDartLengthFromInches(preset.dartDepthInches, unit));
      updateCustomizedBadge(unit);
    }

    function updateCustomizedBadge(unit: DartFormulaUnit): void {
      const badge = document.getElementById("dartCustomizedBadge");
      if (!badge) return;
      const cupEl = document.getElementById("cupSize");
      const cupKey =
        cupEl && "value" in cupEl ? String((cupEl as HTMLSelectElement).value).trim() : "";
      const width = parsePositiveDartMeasurement(readNumber("dartWidth"));
      const depth = parsePositiveDartMeasurement(readNumber("dartDepth"));
      if (!isDartCupSize(cupKey) || width == null || depth == null) {
        badge.hidden = true;
        return;
      }
      const wIn = unit === "cm" ? width / 2.54 : width;
      const dIn = unit === "cm" ? depth / 2.54 : depth;
      badge.hidden = !isCustomDartDimensions(cupKey, wIn, dIn);
    }

    function validateAndCompute() {
      const errors: string[] = [];
      const cupEl = document.getElementById("cupSize");
      const cupKey =
        cupEl && "value" in cupEl ? String((cupEl as HTMLSelectElement).value).trim() : "";
      if (!cupKey) errors.push("Select a cup size.");

      const stitchGauge = readNumber("dart-stitch-gauge");
      const rowGauge = readNumber("dart-row-gauge");
      if (Number.isNaN(stitchGauge) || stitchGauge <= 0) {
        errors.push("Stitch gauge must be greater than 0.");
      }
      if (Number.isNaN(rowGauge) || rowGauge <= 0) {
        errors.push("Row gauge must be greater than 0.");
      }

      const dartWidth = readNumber("dartWidth");
      const dartDepth = readNumber("dartDepth");
      if (Number.isNaN(dartWidth) || dartWidth <= 0) {
        errors.push("Dart width must be greater than 0.");
      }
      if (Number.isNaN(dartDepth) || dartDepth <= 0) {
        errors.push("Dart depth must be greater than 0.");
      }

      const unit = getUnitFromForm();

      if (errors.length) {
        return { ok: false as const, errors };
      }

      const computed = computeDartShaping({
        cupKey,
        stitchGauge,
        rowGauge,
        unit,
        dartWidth,
        dartDepth,
      });

      if (!computed.ok) {
        return { ok: false as const, errors: [computed.error] };
      }

      return { ok: true as const, result: computed };
    }

    const form = document.getElementById("wizard-form");
    const validationSummary = document.getElementById("validationSummary");
    const resultsEl = document.getElementById("dartResults");
    const resultsContent = document.getElementById("dartResultsContent");
    let lastUnit: DartFormulaUnit = getUnitFromForm();

    function runCalculation(): void {
      if (!validationSummary || !resultsEl || !resultsContent) return;

      validationSummary.hidden = true;
      validationSummary.textContent = "";

      const outcome = validateAndCompute();
      if (!outcome.ok) {
        resultsEl.hidden = true;
        validationSummary.textContent = (outcome.errors || []).join(" ");
        validationSummary.hidden = false;
        return;
      }

      resultsContent.innerHTML = buildDartFormulaResultsHtml(outcome.result);
      resultsEl.hidden = false;
      resultsEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        runCalculation();
      });
    }

    document.getElementById("cupSize")?.addEventListener("change", () => {
      const unit = getUnitFromForm();
      const cupEl = document.getElementById("cupSize");
      const cupKey =
        cupEl && "value" in cupEl ? String((cupEl as HTMLSelectElement).value).trim() : "";
      if (isDartCupSize(cupKey)) {
        loadPresetIntoFields(cupKey, unit);
      }
    });

    document.getElementById("dartWidth")?.addEventListener("input", () => {
      updateCustomizedBadge(getUnitFromForm());
    });
    document.getElementById("dartDepth")?.addEventListener("input", () => {
      updateCustomizedBadge(getUnitFromForm());
    });

    function onUnitsMaybeChanged(nextUnit?: DartFormulaUnit): void {
      const unit = nextUnit ?? getUnitFromForm();
      syncCupSizeOptionLabels(unit);
      syncDimFieldLabels(unit);
      if (unit !== lastUnit) {
        const width = readNumber("dartWidth");
        const depth = readNumber("dartDepth");
        if (!Number.isNaN(width) && width > 0) {
          setNumberInput("dartWidth", roundToTwoDecimals(convertDartLength(width, lastUnit, unit)));
        }
        if (!Number.isNaN(depth) && depth > 0) {
          setNumberInput("dartDepth", roundToTwoDecimals(convertDartLength(depth, lastUnit, unit)));
        }
        lastUnit = unit;
      }
      updateCustomizedBadge(unit);
    }

    window.addEventListener("kbm:units-change", (e) => {
      const d = (e as CustomEvent<{ unit?: string }>).detail;
      const u: DartFormulaUnit = d && d.unit === "cm" ? "cm" : "in";
      onUnitsMaybeChanged(u);
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => onUnitsMaybeChanged());
    } else {
      onUnitsMaybeChanged();
    }
  </script>
</Layout>
