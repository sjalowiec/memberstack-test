---
import Layout from "../../layouts/Layout.astro";
import WizardBackLink from "../../components/wizards/WizardBackLink.astro";
import ToolPageHeader from "../../components/tools/ToolPageHeader.astro";
import toolsData from "../../../data/tools.json";
import "../../styles/wizard.css";
import FloatingInput from "../../components/tools/FloatingInput.astro";
import ToolResultCard from "../../components/tools/ToolResultCard.astro";
import Tooltip from "../../components/Tooltip.astro";

const tools = toolsData as Array<{ href?: string; title?: string; icon?: string }>;
const tool = tools.find((t) => t.href === Astro.url.pathname) ?? null;
const toolPrintTitle = tool?.title ?? "Increase / Decrease Evenly Calculator";
---

<Layout title="Increase / Decrease Evenly Calculator | Knit it Now" description="Increase / Decrease Evenly Calculator: space stitch-count changes evenly across one row (ruffles, gathers, or other one-row adjustments). Enter starting and ending stitch counts for clear machine-knitting instructions." toolPrintTitle={toolPrintTitle}>
  <main class="wizard-page">
    <div class="wizard-shell">
      <WizardBackLink className="back-link" />

      <section class="wizard-hero">
        <ToolPageHeader tool={tool} fallbackTitle="Increase / Decrease Evenly Calculator" />
        <p class="wizard-intro">
          Stop guessing. Get precise instructions to change from your starting stitch count to your ending stitch count, worked evenly across one row.
        </p>
        <p class="wizard-intro-sub">
          Before you begin: Remove your work from the machine — either by <Tooltip term="scrap off">scrap off</Tooltip> or onto a <Tooltip text="Transfer stitches onto a circular or straight knitting needle to hold them, then rehang from the needle as you work across.">hand knitting needle</Tooltip> — then rehang as you work across the row.
        </p>
      </section>

      <div class="dist-calculator-panel kbm-tool-calculator-area">
        <h2>Enter Your Numbers</h2>
        <form id="distForm">
          <div class="dist-input-grid">
            <FloatingInput
              id="startingStitches"
              name="startingStitches"
              label="Starting stitches"
              type="number"
              min={1}
              step={1}
              placeholder=" "
            />
            <FloatingInput
              id="endingStitches"
              name="endingStitches"
              label="Ending stitches"
              type="number"
              min={1}
              step={1}
              placeholder=" "
            />
          </div>
         
          <div class="dist-actions">
            <button type="button" id="calculateDist" class="wizard-button">
              Calculate
            </button>
          </div>
          <div id="distValidation" class="dist-validation" role="alert" hidden></div>
        </form>
      </div>

      <template id="dist-before-you-begin-fragment">
        <p><strong>Before you begin:</strong></p>
        <p>
          Remove the work from the machine (<Tooltip term="scrap off">scrap off</Tooltip> or place onto a <Tooltip text="Transfer stitches onto a circular or straight knitting needle to hold them, then rehang from the needle as you work across.">hand knitting needle</Tooltip>).
        </p>
      </template>

      <ToolResultCard id="distResults" hidden title="Your One-Row Distribution" resultsContentId="distResultsContent" singleColumn={true} />
    </div>
  </main>

  <style>
    .wizard-hero .wizard-intro-sub {
      margin-top: 0.5rem;
      font-size: 0.95rem;
      color: #6b7280;
    }

    .dist-calculator-panel {
      background: #fff;
      padding: 1.75rem;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      margin-bottom: 1.5rem;
    }

    @media (max-width: 640px) {
      .dist-calculator-panel {
        padding: 1.25rem;
      }
    }

    .dist-input-grid {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-top: 16px;
    }

    .dist-form-tip {
      margin-top: 1.25rem;
      padding: 14px 18px;
      background: #f4f7ef;
      border-left: 4px solid #52682d;
      border-radius: 6px;
      font-size: 0.95rem;
      line-height: 1.5;
      color: #374151;
    }

    .dist-form-tip strong {
      color: #2f3a2f;
    }

    .dist-actions {
      margin-top: 20px;
    }

    .dist-actions .wizard-button {
      padding: 12px 22px;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 8px;
      background: #52682D;
      color: white;
      border: none;
      cursor: pointer;
    }

    .dist-actions .wizard-button:hover {
      background: #445925;
    }

    .dist-validation {
      margin-top: 20px;
      padding: 14px 18px;
      border-left: 6px solid #d9534f;
      background: #fff4f4;
      border-radius: 6px;
      font-size: 0.95rem;
      color: #333;
    }

    .dist-validation:not([hidden]) {
      display: block;
    }

    .dist-result-summary {
      font-size: 1.2rem;
      font-weight: 700;
      color: #52682D;
      margin-bottom: 1rem;
    }

    .dist-summary-list {
      margin: 0 0 1.25rem 0;
      padding-left: 1.25rem;
      line-height: 1.6;
    }

    .dist-summary-list li {
      margin-bottom: 0.35rem;
    }

    .dist-instructions-block {
      border-left: 4px solid #52682D;
      padding-left: 16px;
      margin: 1rem 0;
      font-size: 1rem;
      line-height: 1.6;
    }

    .dist-instructions-block p {
      margin: 0 0 0.5em 0;
    }

    .dist-instructions-block p:last-child {
      margin-bottom: 0;
    }

    .dist-tip-block {
      margin-top: 1.25rem;
      padding: 14px 18px;
      background: #f4f7ef;
      border-left: 4px solid #52682D;
      border-radius: 6px;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .dist-tip-block strong {
      display: block;
      margin-bottom: 4px;
    }
  </style>

  <script>
    const form = document.getElementById("distForm") as HTMLFormElement | null;
    const calculateBtn = document.getElementById("calculateDist");
    const resultsCard = document.getElementById("distResults");
    const resultsContent = document.getElementById("distResultsContent");
    const validationEl = document.getElementById("distValidation");

    if (!form || !calculateBtn || !resultsCard || !resultsContent || !validationEl) {
      throw new Error("Distribution tool: required elements not found");
    }

    type Mode = "decrease" | "increase" | "none";

    interface DistResult {
      mode: Mode;
      startingStitches: number;
      endingStitches: number;
      totalChange: number;
    }

    function parseInputs(): { start: number; end: number } {
      const startRaw = (form!.querySelector("#startingStitches") as HTMLInputElement)?.value ?? "";
      const endRaw = (form!.querySelector("#endingStitches") as HTMLInputElement)?.value ?? "";
      return {
        start: parseInt(startRaw, 10) || 0,
        end: parseInt(endRaw, 10) || 0,
      };
    }

    function validate(start: number, end: number): string[] {
      const errors: string[] = [];
      if (start < 1) errors.push("Starting stitches must be at least 1.");
      if (end < 1) errors.push("Ending stitches must be at least 1.");
      return errors;
    }

    function computeDistribution(start: number, end: number): DistResult | null {
      if (end === start) {
        return {
          mode: "none",
          startingStitches: start,
          endingStitches: end,
          totalChange: 0,
        };
      }

      if (end < start) {
        return {
          mode: "decrease",
          startingStitches: start,
          endingStitches: end,
          totalChange: start - end,
        };
      }

      return {
        mode: "increase",
        startingStitches: start,
        endingStitches: end,
        totalChange: end - start,
      };
    }

    function pointWord(n: number): string {
      return n === 1 ? "point" : "points";
    }

    function getBeforeYouBeginHtml(): string {
      const el = document.getElementById("dist-before-you-begin-fragment") as HTMLTemplateElement | null;
      return el?.innerHTML.trim() ?? "";
    }

    /** Centered needle span for final stitch count (odd totals split floor/ceil). */
    function buildRehangCenteredHtml(end: number): string {
      const left = Math.floor(end / 2);
      const right = Math.ceil(end / 2);
      return `<p>Rehang the work centered on the needle bed.</p><p>Start at Left ${left} and rehang across to Right ${right}.</p>`;
    }

    /** Fewer stitches in work: pair onto needles at evenly spaced points. */
    function buildFewerStitchesRowHtml(points: number): string {
      return `<p><strong>Across the row:</strong></p><p>Place 2 stitches on 1 needle at ${points} ${pointWord(points)} across the row, spacing them evenly.</p>`;
    }

    /** More stitches in work: empty needles at evenly spaced points, then fill from row below. */
    function buildMoreStitchesRowHtml(points: number): string {
      return `<p><strong>Across the row:</strong></p><p>Leave 1 needle empty at ${points} ${pointWord(points)} across the row, spacing them evenly.</p><p><strong>Then:</strong> Put the empty needles back into work and fill each one by picking up the strand from the row below.</p>`;
    }

    function buildShapedResultHtml(result: DistResult): string {
      const summary = `<p class="dist-result-summary">Change from ${result.startingStitches} to ${result.endingStitches} stitches evenly across the row.</p>`;
      let list = `<ul class="dist-summary-list">`;
      list += `<li>Start: ${result.startingStitches} sts</li>`;
      list += `<li>End: ${result.endingStitches} sts</li>`;
      list += `</ul>`;

      const rehang = buildRehangCenteredHtml(result.endingStitches);
      const action =
        result.mode === "decrease"
          ? buildFewerStitchesRowHtml(result.totalChange)
          : buildMoreStitchesRowHtml(result.totalChange);
      const beforeBegin = getBeforeYouBeginHtml();
      const tip =
        result.mode === "decrease"
          ? `<div class="dist-tip-block" role="note">
          <strong>Tip</strong>
          Push empty needles back before knitting the next row.
        </div>`
          : `<div class="dist-tip-block" role="note">
          <strong>Tip</strong>
          If you do not fill the empty needles, you will create holes.
        </div>`;

      return `${summary}${list}<div class="dist-instructions-block">${beforeBegin}${rehang}${action}</div>${tip}`;
    }

    function renderResult(result: DistResult): void {
      if (result.mode === "none") {
        const html = `
          <p class="dist-result-summary">No change needed across this row.</p>
          <p>Starting and ending stitch counts are the same (${result.startingStitches} stitches). Knit the row with no changes.</p>`;
        resultsContent!.innerHTML = html;
        resultsCard!.hidden = false;
        return;
      }

      resultsContent!.innerHTML = buildShapedResultHtml(result);
      resultsCard!.hidden = false;
    }

    calculateBtn.addEventListener("click", () => {
      const { start, end } = parseInputs();
      validationEl.hidden = true;
      validationEl.textContent = "";

      const errors = validate(start, end);
      if (errors.length > 0) {
        validationEl.textContent = errors.join(" ");
        validationEl.hidden = false;
        resultsCard.hidden = true;
        return;
      }

      const result = computeDistribution(start, end);
      if (result) renderResult(result);
    });
  </script>
</Layout>
