---
import Layout from "../../layouts/Layout.astro";
import WizardBackLink from "../../components/wizards/WizardBackLink.astro";
import UnitToggle from "../../components/wizards/UnitToggle.astro";
import GlossaryTooltip from "../../components/common/GlossaryTooltip.astro";
import FavoriteStar from "../../components/favorites/FavoriteStar.astro";
import FavoritesRuntime from "../../components/favorites/FavoritesRuntime.astro";
import toolsData from "../../../data/tools.json";
import "../../styles/favorites.css";

const tools = toolsData as Array<{ id?: number; href?: string; title?: string }>;
const tool = tools.find((t) => t.href === Astro.url.pathname) ?? null;
const toolTitle = tool?.title ?? "Gauge Comparison";
const toolContentId = tool?.id != null ? String(tool.id) : "34";
---

<Layout
  title="Gauge Comparison | Knit it Now"
  description="See how even a small difference in gauge can dramatically change the finished size of your knitting across a range of stitch counts."
  toolPrintTitle="Gauge Comparison"
>

<style>
.wizard-page {
  padding-top: 0;
  padding-bottom: 3rem;
  min-height: 100vh;
  background: var(--page-bg);
}

.page-header {
  max-width: 800px;
  margin: 0 auto 2rem;
  padding: 0 1rem;
}

.page-header h1 {
  color: var(--kbm-green);
  font-size: 2rem;
  font-weight: 700;
  margin: 0 0 0.75rem;
  text-align: center;
}

.page-header .lede {
  color: var(--kbm-green);
  font-size: 1.25rem;
  font-weight: 700;
  text-align: center;
  margin: 0 0 1rem;
}

.page-header p {
  color: #6b7280;
  font-size: 1.05rem;
  line-height: 1.6;
  text-align: center;
}

.wizard-container {
  max-width: 800px;
  margin: 0 auto;
  background: white;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.input-section {
  margin-top: 0.75rem;
}

.input-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem 1.25rem;
}

.field {
  min-width: 0;
}

.gauge-input-label {
  display: block;
  margin-bottom: 0.35rem;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--kbm-green);
}

.field-hint {
  margin: 0.35rem 0 0;
  font-size: 0.8rem;
  line-height: 1.35;
  color: #6b7280;
}

.gauge-input {
  display: block;
  width: 100%;
  max-width: 160px;
  padding: 0.55rem 0.65rem;
  border: 2px solid #9aa38f;
  border-radius: 8px;
  background: #fff;
  font-size: 1.05rem;
  font-weight: 600;
  text-align: center;
  color: #1f2937;
  cursor: text;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.gauge-input:hover {
  border-color: var(--kbm-green);
}

.gauge-input:focus {
  outline: none;
  border-color: var(--kbm-green);
  box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.2);
}

.result-block {
  margin-top: 1.5rem;
  padding: 1.75rem 1.5rem 1.5rem;
  background: linear-gradient(180deg, #f6f8f2 0%, #f9fafb 100%);
  border: 2px solid rgba(82, 104, 45, 0.18);
  border-radius: 12px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  color: #374151;
  line-height: 1.5;
}

.result-block :global(.result-summary) {
  margin: 0 0 1.35rem;
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  letter-spacing: -0.01em;
  color: var(--kbm-green);
}

.result-block :global(.result-metrics) {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.85rem;
  margin: 0;
}

.result-block :global(.result-metric) {
  min-width: 0;
  padding: 0.85rem 0.75rem;
  text-align: center;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}

.result-block :global(.result-metric__label) {
  display: block;
  margin-bottom: 0.35rem;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #6b7280;
}

.result-block :global(.result-metric__value) {
  display: block;
  font-size: clamp(1.15rem, 2vw, 1.35rem);
  font-weight: 700;
  line-height: 1.25;
  color: #1f2937;
}

.result-block :global(.result-placeholder) {
  margin: 0;
  padding: 0.75rem 0;
  font-size: 1rem;
  line-height: 1.5;
  text-align: center;
  color: #6b7280;
}

.tension-guide {
  margin-top: 1.25rem;
}

.tension-guide img {
  display: block;
  width: 100%;
  max-width: 728px;
  height: auto;
  margin: 0 auto;
  border-radius: 6px;
}

.gauge-help {
  margin-top: 1rem;
}

.gauge-help__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  cursor: pointer;
  font-weight: 700;
  color: var(--kbm-green);
  list-style: none;
}

.gauge-help__summary::-webkit-details-marker {
  display: none;
}

.gauge-help__summary::marker {
  content: "";
}

.gauge-help__summary::after {
  content: "+";
  flex-shrink: 0;
  font-size: 1.25rem;
  font-weight: 400;
  line-height: 1;
  color: #6b7280;
  transition: transform 0.2s ease;
}

.gauge-help[open] .gauge-help__summary::after {
  transform: rotate(45deg);
}

.gauge-help__body {
  margin-top: 0.85rem;
  padding-top: 0.85rem;
  border-top: 1px solid #e5e7eb;
}

.gauge-help__tips {
  margin: 0.75rem 0 0;
  padding-left: 1.15rem;
}

.gauge-help__tips li + li {
  margin-top: 0.65rem;
}

.note {
  margin-top: 1.5rem;
  padding: 0.9rem 1.1rem;
  background: #f9fafb;
  border-left: 4px solid var(--kbm-green);
  border-radius: 6px;
  color: #4b5563;
  font-size: 0.95rem;
  line-height: 1.6;
}

.note + .note {
  margin-top: 1rem;
}

.note p {
  margin: 0;
}

.note p + p {
  margin-top: 0.75rem;
}

.note-title {
  font-weight: 700;
  color: var(--kbm-green);
}

@media (max-width: 640px) {
  .page-header h1 {
    font-size: 1.6rem;
  }

  .wizard-container {
    padding: 1.25rem;
  }

  .input-grid {
    grid-template-columns: 1fr;
  }

  .gauge-input {
    max-width: 100%;
    font-size: 1rem;
  }

  .result-block :global(.result-metrics) {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .result-block :global(.result-metric) {
    text-align: left;
    padding: 0.9rem 1rem;
  }
}

/* Print styles - hide input sections */
@media print {
  .wizard-page {
    padding-top: 0 !important;
    background: white !important;
  }

  .back-link,
  .units-toggle,
  .input-section,
  .no-print {
    display: none !important;
  }

  .wizard-container {
    box-shadow: none !important;
    padding: 0 !important;
    background: white !important;
    border: none !important;
  }

  .result-block {
    border: none !important;
    padding: 0 !important;
    background: white !important;
  }

  .gauge-help__summary {
    display: none;
  }

  .gauge-help__body {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
}
</style>

  <div class="wizard-page">
    <div style="max-width: 800px; margin: 0 auto; padding: 0 1rem;">
      <WizardBackLink fallback="/tools" />
    </div>

    <div class="page-header">
      <div class="favorite-title-row" style="justify-content: center;">
        <h1>{toolTitle}</h1>
        <FavoriteStar contentType="tool" contentId={toolContentId} title={toolTitle} />
      </div>
      <FavoritesRuntime contentType="tool" />
      <p class="lede">Small Difference, Big Impact</p>
      <p id="lede-description">
        See how a small gauge difference can add or subtract inches from your project.
      </p>
    </div>

    <div class="wizard-container">
      <UnitToggle id="gaugecompare" defaultUnit="in" />

      <div class="input-section no-print">
        <div class="input-grid">
          <div class="field">
            <label class="gauge-input-label" id="gauge1-label" for="gauge1">Pattern Gauge (sts/4")</label>
            <input type="number" id="gauge1" class="gauge-input" min="0.1" step="0.1" value="24" inputmode="decimal" />
          </div>
          <div class="field">
            <label class="gauge-input-label" id="gauge2-label" for="gauge2">Your Gauge (sts/4")</label>
            <input type="number" id="gauge2" class="gauge-input" min="0.1" step="0.1" value="25" inputmode="decimal" />
          </div>
          <div class="field">
            <label class="gauge-input-label" for="totalStitches">Total Stitches in Your Pattern</label>
            <input type="number" id="totalStitches" class="gauge-input" min="1" step="1" value="200" inputmode="numeric" />
            <p class="field-hint">e.g., cast-on stitches or chest width stitches</p>
          </div>
        </div>
      </div>

      <div class="result-block" id="gauge-result" aria-live="polite"></div>

      <div class="tension-guide">
        <img
          src="/images/reference/tension-guide.webp"
          alt="Knitting machine tension dial guide showing that smaller tension numbers create tighter fabric and larger tension numbers create looser fabric."
          width="728"
          height="381"
          loading="lazy"
          decoding="async"
        />
      </div>

      <details class="note gauge-help">
        <summary class="gauge-help__summary">Need help adjusting your tension?</summary>
        <div class="gauge-help__body">
          <p class="note-title">Gauge doesn't match?</p>
          <ul class="gauge-help__tips">
            <li>Too many stitches? Your fabric is too tight. Turn the tension dial to a higher number.</li>
            <li>Too few stitches? Your fabric is too loose. Turn the tension dial to a lower number.</li>
          </ul>
        </div>
      </details>

      <div class="note">
        Always knit and measure a <GlossaryTooltip id={843}>proper swatch</GlossaryTooltip> before starting your project.
      </div>
    </div>
  </div>

<script>
  let units = 'in';

  const inputs = {
    gauge1: document.getElementById('gauge1'),
    gauge2: document.getElementById('gauge2'),
    totalStitches: document.getElementById('totalStitches'),
  };

  const ledeDescriptionEl = document.getElementById('lede-description');
  const resultEl = document.getElementById('gauge-result');
  const inputLabels = {
    gauge1: document.getElementById('gauge1-label'),
    gauge2: document.getElementById('gauge2-label'),
  };

  const PLACEHOLDER_MESSAGE = 'Enter your gauges and stitch count to compare the finished width.';

  function inputValue(el) {
    return el instanceof HTMLInputElement ? el.value : '';
  }

  function getGaugeUnitLabel() {
    return units === 'cm' ? 'sts/10 cm' : 'sts/4"';
  }

  function getPatternGaugeLabel() {
    return `Pattern Gauge (${getGaugeUnitLabel()})`;
  }

  function getYourGaugeLabel() {
    return `Your Gauge (${getGaugeUnitLabel()})`;
  }

  function getWidthUnitLabel() {
    return units === 'cm' ? 'cm' : 'inches';
  }

  function formatWidth(value) {
    return value.toFixed(1);
  }

  function formatSignedDifference(diff) {
    const rounded = Number(diff.toFixed(1));
    if (rounded === 0) return `0.0 ${getWidthUnitLabel()}`;
    const sign = rounded > 0 ? '+' : '';
    return `${sign}${rounded.toFixed(1)} ${getWidthUnitLabel()}`;
  }

  function updateUnitLabels() {
    if (inputLabels.gauge1) inputLabels.gauge1.textContent = getPatternGaugeLabel();
    if (inputLabels.gauge2) inputLabels.gauge2.textContent = getYourGaugeLabel();
    if (ledeDescriptionEl) {
      const measure = units === 'in' ? 'inches' : 'centimeters';
      ledeDescriptionEl.textContent =
        `See how a small gauge difference can add or subtract ${measure} from your project.`;
    }
  }

  function showPlaceholder() {
    if (!resultEl) return;
    resultEl.innerHTML = `<p class="result-placeholder">${PLACEHOLDER_MESSAGE}</p>`;
  }

  function calculate() {
    const patternGauge = parseFloat(inputValue(inputs.gauge1));
    const yourGauge = parseFloat(inputValue(inputs.gauge2));
    const totalStitches = parseFloat(inputValue(inputs.totalStitches));

    const valid =
      Number.isFinite(patternGauge) && patternGauge > 0 &&
      Number.isFinite(yourGauge) && yourGauge > 0 &&
      Number.isFinite(totalStitches) && totalStitches > 0;

    if (!valid || !resultEl) {
      showPlaceholder();
      return;
    }

    const factor = units === 'in' ? 4 : 10;
    const expectedWidth = (totalStitches / patternGauge) * factor;
    const yourWidth = (totalStitches / yourGauge) * factor;
    const difference = yourWidth - expectedWidth;

    if (
      !Number.isFinite(expectedWidth) ||
      !Number.isFinite(yourWidth) ||
      !Number.isFinite(difference)
    ) {
      showPlaceholder();
      return;
    }

    const unitLabel = getWidthUnitLabel();
    const absDiff = Math.abs(Number(difference.toFixed(1)));
    let summary;

    if (absDiff === 0) {
      summary = 'Your project should match the expected width.';
    } else if (difference < 0) {
      summary = `Your project will be ${formatWidth(absDiff)} ${unitLabel} too small.`;
    } else {
      summary = `Your project will be ${formatWidth(absDiff)} ${unitLabel} too large.`;
    }

    resultEl.innerHTML = `
      <p class="result-summary">${summary}</p>
      <div class="result-metrics">
        <div class="result-metric">
          <span class="result-metric__label">Expected Width</span>
          <span class="result-metric__value">${formatWidth(expectedWidth)} ${unitLabel}</span>
        </div>
        <div class="result-metric">
          <span class="result-metric__label">Your Width</span>
          <span class="result-metric__value">${formatWidth(yourWidth)} ${unitLabel}</span>
        </div>
        <div class="result-metric">
          <span class="result-metric__label">Difference</span>
          <span class="result-metric__value">${formatSignedDifference(difference)}</span>
        </div>
      </div>
    `;
  }

  Object.values(inputs).forEach((el) => {
    if (!el) return;
    el.addEventListener('input', calculate);
  });

  window.addEventListener('kbm:units-change', (e) => {
    const detail = /** @type {CustomEvent<{ unit?: string; toggleId?: string }>} */ (e).detail;
    if (detail?.toggleId && detail.toggleId !== 'gaugecompare') return;
    units = detail?.unit === 'cm' ? 'cm' : 'in';
    updateUnitLabels();
    calculate();
  });

  updateUnitLabels();
  calculate();
</script>

</Layout>
