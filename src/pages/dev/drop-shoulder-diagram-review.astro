---
/**
 * Dev-only visual QA for generated Drop Shoulder diagrams.
 * Route: /dev/drop-shoulder-diagram-review
 *
 * Ungated: no Memberstack, no membership checks, no site chrome.
 * Production hosts 404 via middleware and this page.
 */
import {
  isDropShoulderDiagramReviewProductionBlocked,
} from "../../lib/dev/dropShoulderDiagramReviewAccess";
import { buildDropShoulderDiagramReviewCases } from "../../lib/patterns/dropShoulderDiagramReviewFixtures";

export const prerender = false;

if (
  isDropShoulderDiagramReviewProductionBlocked(Astro.url.hostname, {
    isViteDev: import.meta.env.DEV,
    publicSiteEnv: import.meta.env.PUBLIC_SITE_ENV,
  })
) {
  return new Response("Not found", { status: 404 });
}

const fixtures = buildDropShoulderDiagramReviewCases();

function headingLine(fixture: (typeof fixtures)[number]): string {
  const garment = fixture.values.garment === "cardigan" ? "Cardigan" : "Pullover";
  const neck = fixture.values.neckline === "v" ? "V-Neck" : "Round Neck";
  const size = fixture.title.includes("Misses 8") ? "Misses 8" : "Kids 10";
  return `${garment} · ${neck} · ${size}`;
}

function summaryLine(fixture: (typeof fixtures)[number]): string {
  const shape =
    fixture.values.bodyShape === "aline"
      ? "A-line body"
      : fixture.values.bodyShape === "shaped"
        ? "Shaped body"
        : "Straight body";
  const gauge = String(fixture.values.gauge).replace(/ over 4 in$/, ' over 4"');
  const arm = String(fixture.values.armholeDepthLabel);
  const armInches = arm.includes(" / ") ? arm.split(" / ")[1] : arm;
  return `${shape} · ${gauge} · Armhole depth ${armInches}`;
}

const views = fixtures.map((fixture) => ({
  ...fixture,
  heading: headingLine(fixture),
  summaryLine: summaryLine(fixture),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>DEV: Drop Shoulder diagram review</title>
    <style is:global>
      :root {
        color-scheme: light;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
        margin: 0;
        overflow: hidden;
      }
      body {
        display: flex;
        flex-direction: column;
        padding: 10px 14px 12px;
        font-family: Arial, Helvetica, sans-serif;
        color: #1a1a1a;
        background: #f8faf8;
      }
      .toolbar {
        flex: 0 0 auto;
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        gap: 8px 16px;
        margin: 0 0 8px;
      }
      .toolbar label {
        display: flex;
        flex-direction: column;
        gap: 3px;
        font-size: 0.72rem;
        font-weight: 600;
        color: #4b5563;
      }
      .toolbar select {
        min-width: 22rem;
        max-width: 100%;
        font-size: 0.95rem;
        padding: 6px 8px;
      }
      .piece-tabs {
        display: flex;
        gap: 0;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
      }
      .piece-tabs button {
        appearance: none;
        border: 0;
        background: #fff;
        color: #1a1a1a;
        font-size: 0.9rem;
        font-weight: 600;
        padding: 6px 16px;
        cursor: pointer;
      }
      .piece-tabs button[aria-pressed="true"] {
        background: #52682d;
        color: #fff;
      }
      .fixture {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
      }
      .heading {
        flex: 0 0 auto;
        margin: 0 0 2px;
        font-size: 1.15rem;
      }
      .summary {
        flex: 0 0 auto;
        margin: 0 0 8px;
        color: #4b5563;
        font-size: 0.9rem;
      }
      .compare {
        flex: 1 1 auto;
        min-height: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }
      figure {
        min-width: 0;
        min-height: 0;
        margin: 0;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        padding: 8px 10px 10px;
        background: #fff;
        display: flex;
        flex-direction: column;
      }
      figcaption {
        flex: 0 0 auto;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: #374151;
        margin-bottom: 6px;
      }
      .diagram-frame {
        flex: 1 1 auto;
        min-height: 0;
        min-width: 0;
        position: relative;
      }
      .diagram-frame svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
      }
      details.debug {
        flex: 0 0 auto;
        margin-top: 8px;
        max-width: 52rem;
      }
      details.debug summary {
        cursor: pointer;
        font-size: 0.78rem;
        font-weight: 600;
        color: #6b7280;
      }
      .values {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
        gap: 6px 16px;
        font-size: 0.82rem;
        background: #f4f6f1;
        padding: 12px;
        border-radius: 6px;
        margin: 8px 0 0;
        max-height: 22vh;
        overflow: auto;
      }
      .values div {
        display: flex;
        justify-content: space-between;
        gap: 12px;
      }
      .values dt {
        color: #4b5563;
      }
      .values dd {
        margin: 0;
        font-variant-numeric: tabular-nums;
        text-align: right;
      }
      [hidden] {
        display: none !important;
      }
    </style>
  </head>
  <body data-pagefind-ignore>
    <div class="toolbar">
      <label>
        Configuration
        <select id="fixture-select" data-review-config-select>
          {
            views.map((fixture) => (
              <option value={fixture.id}>{fixture.title}</option>
            ))
          }
        </select>
      </label>
      <div class="piece-tabs" role="tablist" aria-label="Garment piece">
        <button type="button" data-review-piece-btn="back" aria-pressed="true">Back</button>
        <button type="button" data-review-piece-btn="front" aria-pressed="false">Front</button>
      </div>
    </div>

    {
      views.map((fixture, index) => (
        <section
          class="fixture"
          data-review-fixture={fixture.id}
          hidden={index !== 0}
        >
          <h1 class="heading">{fixture.heading}</h1>
          <p class="summary">{fixture.summaryLine}</p>
          {
            fixture.pieces.map((piece) => (
              <div
                class="compare"
                data-review-piece={piece.piece}
                hidden={piece.piece !== "back"}
              >
                <figure>
                  <figcaption>Current</figcaption>
                  <div class="diagram-frame">
                    <Fragment set:html={piece.legacySvg} />
                  </div>
                </figure>
                <figure>
                  <figcaption>Generated</figcaption>
                  <div class="diagram-frame">
                    <Fragment set:html={piece.generatedSvg} />
                  </div>
                </figure>
              </div>
            ))
          }
          <details class="debug">
            <summary>Debug values</summary>
            <dl class="values">
              {
                Object.entries(fixture.values).map(([key, value]) => (
                  <div>
                    <dt>{key}</dt>
                    <dd>{value}</dd>
                  </div>
                ))
              }
            </dl>
          </details>
        </section>
      ))
    }

    <script>
      const select = document.querySelector("[data-review-config-select]");
      const pieceButtons = Array.from(
        document.querySelectorAll("[data-review-piece-btn]"),
      );
      const fixtures = Array.from(document.querySelectorAll("[data-review-fixture]"));
      const ids = fixtures.map((el) => el.getAttribute("data-review-fixture") || "");

      function readState() {
        const params = new URLSearchParams(window.location.search);
        const fixture =
          params.get("c") && ids.includes(params.get("c") || "")
            ? params.get("c")
            : ids[0] || "";
        const piece = params.get("p") === "front" ? "front" : "back";
        return { fixture, piece };
      }

      function writeState(fixture, piece) {
        const params = new URLSearchParams();
        params.set("c", fixture);
        params.set("p", piece);
        const next = `${window.location.pathname}?${params.toString()}`;
        window.history.replaceState(null, "", next);
      }

      function applyState(fixture, piece) {
        if (select instanceof HTMLSelectElement) select.value = fixture;
        for (const btn of pieceButtons) {
          if (!(btn instanceof HTMLButtonElement)) continue;
          btn.setAttribute(
            "aria-pressed",
            btn.getAttribute("data-review-piece-btn") === piece ? "true" : "false",
          );
        }
        for (const section of fixtures) {
          const id = section.getAttribute("data-review-fixture");
          const on = id === fixture;
          section.hidden = !on;
          if (!on) continue;
          const pieces = section.querySelectorAll("[data-review-piece]");
          for (const panel of pieces) {
            if (!(panel instanceof HTMLElement)) continue;
            panel.hidden = panel.getAttribute("data-review-piece") !== piece;
          }
        }
      }

      const initial = readState();
      applyState(initial.fixture, initial.piece);

      select?.addEventListener("change", () => {
        if (!(select instanceof HTMLSelectElement)) return;
        const piece = readState().piece;
        writeState(select.value, piece);
        applyState(select.value, piece);
      });

      for (const btn of pieceButtons) {
        btn.addEventListener("click", () => {
          if (!(btn instanceof HTMLButtonElement)) return;
          const piece = btn.getAttribute("data-review-piece-btn") === "front" ? "front" : "back";
          const fixture =
            select instanceof HTMLSelectElement ? select.value : readState().fixture;
          writeState(fixture, piece);
          applyState(fixture, piece);
        });
      }
    </script>
  </body>
</html>
