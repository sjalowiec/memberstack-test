---
/**
 * Legacy redirect: /dev/course-preview/[lesson] → course 50 lesson URLs.
 */
import {
  DEFAULT_PREVIEW_COURSE_ID,
  getSortedLessons,
} from "../../../lib/legacy_kin/coursePreviewPoc";

export const prerender = true;

export function getStaticPaths() {
  return getSortedLessons(DEFAULT_PREVIEW_COURSE_ID).map((lesson) => ({
    params: { lesson: lesson.slug },
  }));
}

const target = `/dev/course-preview/${DEFAULT_PREVIEW_COURSE_ID}/${Astro.params.lesson}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Redirecting…</title>
    <script define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p><a href={target}>Continue to course preview</a></p>
  </body>
</html>
