---
/**
 * Dev-only course preview landing.
 * Route: /dev/course-preview
 * Optional query: ?course=50 or ?course=51 redirects to the course overview.
 */
import Layout from "../../../layouts/Layout.astro";
import {
  coursePreviewHref,
  getCoursePreviewData,
  getPreviewCourseIds,
  getSortedLessons,
} from "../../../lib/legacy_kin/coursePreviewPoc";
import "../../../styles/course-preview.css";

export const prerender = true;

const courses = getPreviewCourseIds().map((courseId) => {
  const data = getCoursePreviewData(courseId)!;
  const lessons = getSortedLessons(courseId);
  return {
    courseId,
    title: data.course.title,
    slug: data.course.slug,
    lessonCount: lessons.length,
    blockCount: lessons.reduce((total, lesson) => total + lesson.blocks.length, 0),
    href: coursePreviewHref(courseId),
  };
});

const pageTitle = "DEV Preview: LK-150 Courses";
---

<Layout title={pageTitle} description="Internal dev preview of legacy KIN course POC JSON." skipGlobalHyvor>
  {/* Dev-only POC, production-blocked in middleware: keep it out of Pagefind. */}
  <main class="course-preview" data-pagefind-ignore>
    <p class="course-preview__banner" role="status">
      <strong>Dev preview</strong> — legacy KIN course POC JSON. Not production content.
    </p>

    <header class="course-preview__header">
      <h1 class="course-preview__title">LK-150 Course Preview</h1>
      <p class="course-preview__meta">
        Choose a course below, or open a course directly with <code>?course=50</code> or{" "}
        <code>?course=51</code>.
      </p>
    </header>

    <section aria-labelledby="course-preview-courses-heading">
      <h2 id="course-preview-courses-heading">Courses</h2>
      <ol class="course-preview__lesson-list">
        {
          courses.map((course) => (
            <li>
              <a href={course.href}>
                {course.title}
              </a>
              <span class="course-preview__meta">
                {" "}
                · course {course.courseId} · {course.lessonCount} lessons ·{" "}
                {course.blockCount} blocks
              </span>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <script>
    const params = new URLSearchParams(window.location.search);
    const course = params.get("course");
    if (course === "50" || course === "51") {
      window.location.replace(`/dev/course-preview/${course}`);
    }
  </script>
</Layout>
