---
/**
 * Dev-only lesson entry — redirects to the customer-facing item route.
 * Route: /dev/course-preview/[courseId]/[lesson]
 */
import {
  getCoursePreviewData,
  getSortedLessons,
  parseCourseId,
} from "../../../../lib/legacy_kin/coursePreviewCatalog";
import {
  getFirstLessonContentItemSlug,
  urlLessonSlug,
} from "../../../../lib/legacy_kin/courseLessonContentItems";
import { legacyLessonItemHref } from "../../../../lib/legacy_kin/legacyCourseLoader";

export const prerender = false;

const courseId = parseCourseId(Astro.params.courseId);
const lesson = getSortedLessons(courseId).find((item) => item.slug === Astro.params.lesson);
if (!lesson) {
  return Astro.redirect(`/dev/course-preview/${courseId}`);
}
const course = getCoursePreviewData(courseId)!.course;
const lessons = getSortedLessons(courseId);
const firstItemSlug = getFirstLessonContentItemSlug(lesson);

if (firstItemSlug) {
  return Astro.redirect(
    legacyLessonItemHref(course.slug, urlLessonSlug(lessons, lesson.slug), firstItemSlug),
  );
}

return Astro.redirect(`/dev/course-preview/${courseId}`);
---
