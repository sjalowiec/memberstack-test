---
/**
 * Dev-only lesson entry — redirects to the customer-facing item route.
 * Route: /dev/course-preview/[courseId]/[lesson]
 */
import {
  getCoursePreviewData,
  getPreviewCourseIds,
  getSortedLessons,
  parseCourseId,
  type CourseLesson,
} from "../../../../lib/legacy_kin/coursePreviewPoc";
import { getFirstLessonContentItemSlug } from "../../../../lib/legacy_kin/courseLessonContentItems";
import { legacyLessonItemHref } from "../../../../lib/legacy_kin/legacyCourseLoader";

export const prerender = true;

export function getStaticPaths() {
  return getPreviewCourseIds().flatMap((courseId) =>
    getSortedLessons(courseId).map((lesson) => ({
      params: {
        courseId: String(courseId),
        lesson: lesson.slug,
      },
      props: { courseId, lesson },
    })),
  );
}

interface Props {
  courseId: number;
  lesson: CourseLesson;
}

const { courseId: rawCourseId, lesson } = Astro.props;
const courseId = parseCourseId(rawCourseId);
const course = getCoursePreviewData(courseId)!.course;
const firstItemSlug = getFirstLessonContentItemSlug(lesson);

if (firstItemSlug) {
  return Astro.redirect(
    legacyLessonItemHref(course.slug, lesson.slug, firstItemSlug),
  );
}

return Astro.redirect(`/dev/course-preview/${courseId}`);
---
