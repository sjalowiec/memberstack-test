---
/**
 * Temporary DEV visual review for generated Sleeveless Front Stitches & Rows.
 * Route: /dev/sleeveless-front-sts-rows-preview
 *
 * Ungated: no Memberstack, no membership checks, no site chrome.
 * Production hosts 404 via middleware and this page.
 * Does not replace the live pattern-tab diagrams.
 */
import {
  isSleevelessFrontStsRowsPreviewProductionBlocked,
} from "../../lib/dev/sleevelessFrontStsRowsPreviewAccess";
import {
  buildSleevelessFrontStsRowsPreviewCases,
  buildSleevelessFrontStsRowsRoundNeckPreviewCases,
  buildSleevelessFrontStsRowsSameBodyRoundVsVCases,
  buildSleevelessFrontStsRowsSameSizeVNeckComparisonCases,
} from "../../lib/patterns/sleevelessFrontStsRowsPreviewFixtures";

export const prerender = false;

if (
  isSleevelessFrontStsRowsPreviewProductionBlocked(Astro.url.hostname, {
    isViteDev: import.meta.env.DEV,
    publicSiteEnv: import.meta.env.PUBLIC_SITE_ENV,
  })
) {
  return new Response("Not found", { status: 404 });
}

const sections = [
  {
    id: "same-size-round-neck",
    title: "Same-garment-size round neck",
    lede:
      "Typical and shallow round on the same misses body. Neck depth should change the U scoop without changing bust, after-armhole, shoulder, or neckline widths.",
    cases: buildSleevelessFrontStsRowsRoundNeckPreviewCases(),
  },
  {
    id: "same-body-round-vs-v",
    title: "Same body · round vs V",
    lede:
      "Identical garment measurements. Only the neckline style changes, so upper-body width should match and the opening should be a U versus a V.",
    cases: buildSleevelessFrontStsRowsSameBodyRoundVsVCases(),
  },
  {
    id: "same-size-v-neck",
    title: "Same-garment-size V-neck comparison",
    lede:
      "Identical bust, armhole shaping, stitches after armhole, shoulder stitches, and neckline stitches. Only V-neck depth and the neckline start row change, so the V shape should move without changing upper-body width.",
    cases: buildSleevelessFrontStsRowsSameSizeVNeckComparisonCases(),
  },
  {
    id: "mixed-garment-sizes",
    title: "Mixed garment sizes",
    lede:
      "Same fixtures as the renderer tests: shallow V, Amanda (normal / overlap), and a mens deep V before the armhole.",
    cases: buildSleevelessFrontStsRowsPreviewCases(),
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>DEV: Sleeveless Front Stitches &amp; Rows preview</title>
    <style is:global>
      :root {
        color-scheme: light;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        padding: 16px 20px 32px;
        font-family: Arial, Helvetica, sans-serif;
        color: #1a1a1a;
        background: #f8faf8;
      }
      .banner {
        margin: 0 0 8px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #52682d;
      }
      h1 {
        margin: 0 0 6px;
        font-size: 1.35rem;
      }
      .lede {
        margin: 0 0 18px;
        color: #4b5563;
        max-width: 46rem;
      }
      section {
        margin: 0 0 28px;
      }
      section h2 {
        margin: 0 0 6px;
        font-size: 1.1rem;
      }
      .section-lede {
        margin: 0 0 12px;
        color: #4b5563;
        max-width: 46rem;
        font-size: 0.92rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }
      @media (max-width: 1100px) {
        .grid {
          grid-template-columns: 1fr;
        }
      }
      figure {
        margin: 0;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        padding: 10px 12px 12px;
        background: #fff;
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      figcaption h3 {
        margin: 0 0 2px;
        font-size: 1.05rem;
      }
      figcaption p {
        margin: 0 0 10px;
        color: #4b5563;
        font-size: 0.85rem;
      }
      .diagram {
        min-height: 420px;
        background: #fff;
      }
      .diagram :global(svg) {
        display: block;
        width: 100%;
        height: auto;
      }
      .missing {
        margin: 0;
        padding: 2rem 1rem;
        color: #9b2c2c;
        text-align: center;
      }
      details {
        margin-top: 10px;
      }
      details summary {
        cursor: pointer;
        font-size: 0.78rem;
        font-weight: 600;
        color: #6b7280;
      }
      dl {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 4px 12px;
        margin: 8px 0 0;
        font-size: 0.8rem;
      }
      dt {
        color: #4b5563;
      }
      dd {
        margin: 0;
        font-variant-numeric: tabular-nums;
        text-align: right;
      }
    </style>
  </head>
  <body data-pagefind-ignore>
    <p class="banner">Developer preview · not connected to the pattern tab</p>
    <h1>Sleeveless Front Stitches &amp; Rows</h1>
    <p class="lede">
      Generated pullover Front diagrams from the canonical model: same-size round depths, same-body
      round vs V, same-size V depths, then the mixed-size renderer-test fixtures.
    </p>
    {
      sections.map((section) => (
        <section data-preview-section={section.id}>
          <h2>{section.title}</h2>
          <p class="section-lede">{section.lede}</p>
          <div class="grid">
            {section.cases.map((item) => (
              <figure data-preview-fixture={item.id}>
                <figcaption>
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                </figcaption>
                <div class="diagram">
                  {item.svg ? <Fragment set:html={item.svg} /> : <p class="missing">Diagram unavailable</p>}
                </div>
                <details>
                  <summary>Model values</summary>
                  <dl>
                    {Object.entries(item.values).map(([key, value]) => (
                      <Fragment>
                        <dt>{key}</dt>
                        <dd>{String(value)}</dd>
                      </Fragment>
                    ))}
                  </dl>
                </details>
              </figure>
            ))}
          </div>
        </section>
      ))
    }
  </body>
</html>
