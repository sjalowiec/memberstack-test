---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import "../components/talk-bubbles.css";
import helpHubData from "../data/help-hub.json";
import lessonsData from "../data/lessons.json";

type TipTryThis = {
  quickActionTitle?: string;
  quickAction?: string[];
  proExerciseTitle?: string;
  proExercise?: string[];
};

type LessonForTip = {
  slug: string;
  url?: string;
  associatedTip?: string;
};

type TipRecord = {
  content_id?: number;
  slug?: string;
  status?: string;
  readyToPublish?: boolean;
  startDate?: string | null;
  endDate?: string | null;
  hook?: string;
  question?: string;
  title?: string;
  quickAnswer?: string;
  /** Help-hub style short answer (alias for quickAnswer). */
  bubbleAnswer?: string;
  bridge?: string;
  videoUrl?: string;
  /** Help-hub style video URL (alias for videoUrl). */
  mediaUrl?: string;
  mediaType?: string;
  mediaAlt?: string;
  mediaPoster?: string;
  tryTitle?: string;
  tryThisTitle?: string;
  trySteps?: string[];
  tryThis?: TipTryThis;
  memberHeading?: string;
  memberText?: string;
  memberLink?: string;
  memberButton?: string;
  memberLessonUrl?: string;
  communityHeading?: string;
  communityText?: string;
  communityLink?: string;
  communityButton?: string;
  /** Optional long-form body for “About This Tip”; falls back to `bridge` when absent. */
  description?: string;
  /** Future: in-page anchor links; render nav only when present and non-empty. */
  jumpLinks?: { label: string; href: string }[];
};

function getTodayIso(): string {
  const now = new Date();
  const y = now.getFullYear();
  const m = String(now.getMonth() + 1).padStart(2, "0");
  const d = String(now.getDate()).padStart(2, "0");
  return `${y}-${m}-${d}`;
}

const today = getTodayIso();
const tips = Array.isArray(helpHubData) ? (helpHubData as TipRecord[]) : [];

const rawLiveTip = tips.find((tip) => {
  if (tip.status !== "published") return false;
  const startDate = typeof tip.startDate === "string" ? tip.startDate.trim() : "";
  const endDate = typeof tip.endDate === "string" ? tip.endDate.trim() : "";
  if (startDate && endDate) {
    return (
      tip.readyToPublish === true &&
      startDate <= today &&
      endDate >= today
    );
  }
  if (tip.readyToPublish === false) return false;
  return true;
});

/** Single live tip with help-hub field names merged into Tuesday-tip shape used by the template. */
const liveTip: TipRecord | undefined = rawLiveTip
  ? {
      ...rawLiveTip,
      quickAnswer: rawLiveTip.quickAnswer ?? rawLiveTip.bubbleAnswer,
      videoUrl: rawLiveTip.videoUrl ?? rawLiveTip.mediaUrl,
      tryTitle: rawLiveTip.tryTitle ?? rawLiveTip.tryThisTitle,
      trySteps:
        rawLiveTip.trySteps ??
        (rawLiveTip.tryThis
          ? [
              ...(Array.isArray(rawLiveTip.tryThis.quickAction)
                ? rawLiveTip.tryThis.quickAction
                : []),
              ...(Array.isArray(rawLiveTip.tryThis.proExercise)
                ? rawLiveTip.tryThis.proExercise
                : []),
            ]
          : undefined),
    }
  : undefined;

const debugLiveExplanation = !liveTip
  ? 'No record matched the live rule: status must be "published", readyToPublish must be true, startDate and endDate must be set (YYYY-MM-DD), and startDate ≤ today ≤ endDate (string compare).'
  : "";

/** Toggle to show the temporary tips debug panel (today / records / live match / table). */
const showTipsPageDebug = false;

const tipAboutDescription = liveTip
  ? typeof liveTip.description === "string" && liveTip.description.trim() !== ""
    ? liveTip.description.trim()
    : typeof liveTip.bridge === "string" && liveTip.bridge.trim() !== ""
      ? liveTip.bridge.trim()
      : ""
  : "";

const tipJumpLinks: { label: string; href: string }[] =
  liveTip && Array.isArray(liveTip.jumpLinks)
    ? liveTip.jumpLinks.filter(
        (j): j is { label: string; href: string } =>
          !!j &&
          typeof j.label === "string" &&
          j.label.trim() !== "" &&
          typeof j.href === "string" &&
          j.href.trim() !== ""
      )
    : [];

const validTrySteps: string[] =
  liveTip && Array.isArray(liveTip?.tryThis?.quickAction)
    ? liveTip.tryThis.quickAction.filter(
        (step): step is string =>
          typeof step === "string" &&
          step.trim() !== "" &&
          step.trim() !== "..."
      )
    : [];

const lessons = Array.isArray(lessonsData) ? (lessonsData as LessonForTip[]) : [];
const liveTipSlug =
  liveTip && typeof liveTip.slug === "string" && liveTip.slug.trim() !== ""
    ? liveTip.slug.trim()
    : "";
const lesson: LessonForTip | undefined = liveTipSlug
  ? lessons.find(
      (l) =>
        typeof l.associatedTip === "string" && l.associatedTip === liveTipSlug
    )
  : undefined;
---

<Layout
  title={
    liveTip?.question
      ? `Tuesday Tip — ${liveTip.question.length > 55 ? `${liveTip.question.slice(0, 55)}…` : liveTip.question} | Knit it Now`
      : "Tuesday Tip Coming Soon | Knit it Now"
  }
  description={
    liveTip?.quickAnswer ||
    "A new Tuesday Tip is not live right now. Please check back soon."
  }
>
  {/*
    When a live tip exists, question + quickAnswer appear only in speech bubbles (not in PageHead),
    so we don’t duplicate the same text as a page title + subhead.
  */}
  <PageHead
    title="Tuesday Tip Coming Soon"
    subhead={
      liveTip
        ? undefined
        : "A new Tuesday Tip is not live right now. Please check back soon."
    }
    hideTitle={!!liveTip}
  />

  <section class="container py-5 tips-page-section">
    {liveTip ? (
      <>
        <div class="tuesday-tip-hero">
          <div class="tuesday-tip-hero__content">
            <div class="tuesday-tip-bubbles">
              {typeof liveTip.hook === "string" && liveTip.hook.trim() !== "" && (
                <p class="bubble-hook" data-placeholder="short subtitle/supporting sentence">
                  {liveTip.hook}
                </p>
              )}

              {(liveTip.question || liveTip.title) && (
                <div class="talk-row talk-left tuesday-tip-bubble-row">
                  <h1 class="talk-bubble bubble-bl bubble-question tuesday-tip__question" data-placeholder="title">
                    {liveTip.question || liveTip.title || "Help Hub Question Title"}
                  </h1>
                </div>
              )}

              {liveTip.quickAnswer && String(liveTip.quickAnswer).trim() !== "" && (
                <div class="talk-row talk-right tuesday-tip-bubble-row" aria-label="Quick answer">
                  <div class="talk-bubble bubble-br bubble-answer tuesday-tip__answer">
                    <div class="tuesday-tip__answer-inner">
                      <img
                        src="/images/KINlogo.svg"
                        alt="Knit it Now"
                        class="tuesday-tip__logo"
                        width="60"
                        height="60"
                      />
                      <div
                        class="tuesday-tip__answer-text"
                        data-placeholder="quick answer"
                        set:html={String(liveTip.quickAnswer)}
                      />
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>

          <aside class="tuesday-tip-hero__media" aria-label="Free visual">
            
            <div class="tuesday-tip-video-shell" data-placeholder="hero media">
              <div class="tuesday-tip-video-aspect">
                {liveTip.mediaType === "image" && liveTip.mediaUrl ? (
                  <img
                    src={liveTip.mediaUrl}
                    alt={liveTip.mediaAlt || ""}
                    class="tuesday-tip-media-image"
                    loading="lazy"
                  />
                ) : liveTip.mediaType === "vimeo" && liveTip.mediaUrl ? (
                  <div class="help-hub-media">
                    <iframe
                      src={`https://player.vimeo.com/video/${liveTip.mediaUrl}`}
                      class="tuesday-tip-video-iframe"
                      title={liveTip.question || "Help Hub video"}
                      frameborder="0"
                      allow="autoplay; fullscreen; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  </div>
                ) : (
                  <div class="tuesday-tip-video-fallback">
                    <p class="tuesday-tip-video-fallback__text">Add mediaType/image URL or a Vimeo video ID to show free visual guidance here.</p>
                  </div>
                )}
              </div>
            </div>
          </aside>
        </div>

        <section class="tuesday-tip__section tuesday-tip__section--why" aria-label="Why this works">
          <h2 class="tuesday-tip__section-heading">Why This Works</h2>
          <div class="tuesday-tip__section-card">
            <p class="tuesday-tip__description" data-placeholder="why this works text">
              {tipAboutDescription ||
                "Explain briefly why this approach solves the problem and what to expect when trying it."}
            </p>
            {tipJumpLinks.length > 0 && (
              <nav class="tuesday-tip__jump-links" aria-label="Jump to sections on this page">
                <ul class="tuesday-tip__jump-links-list">
                  {tipJumpLinks.map((j) => (
                    <li>
                      <a href={j.href.trim()}>{j.label.trim()}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
            {/* Transcript: render inside `.tuesday-tip__transcript` when `liveTip.transcript` (or similar) exists in JSON */}
            <section class="tuesday-tip__transcript" data-placeholder="transcript"></section>
            <div class="tip-help-cta">
              <p class="tip-help-text">
                Want a little extra help?
              </p>

              <div class="tip-help-actions">
                <a href="/your-sprint-link" class="kbm-button">
                  Work With Me (3-Week Sprint)
                </a>

                <a href="/help/quick-help" class="kbm-button">
                  Get Quick Help (15-Min SOS Call)
                </a>
              </div>
            </div>
          </div>
        </section>

        {showTipsPageDebug && (
          <div class="tips-debug-panel" aria-label="Tuesday Tip data debug (temporary)">
            <p class="tips-debug-panel__title"><strong>Temporary debug</strong> — JSON load &amp; live match</p>
            <ul class="tips-debug-panel__list">
              <li><strong>Today (page):</strong> {today}</li>
              <li><strong>help-hub.json loaded:</strong> {tips.length > 0 ? `yes (${tips.length} record${tips.length === 1 ? "" : "s"})` : "no / empty"}</li>
              <li><strong>Live tip found:</strong> {liveTip ? "yes" : "no"}</li>
            </ul>
            {liveTip ? (
              <div class="tips-debug-panel__live">
                <p class="tips-debug-panel__subhead">Matched record (first match):</p>
                <ul class="tips-debug-panel__list">
                  <li><strong>content_id:</strong> {liveTip.content_id ?? "—"}</li>
                  <li><strong>slug:</strong> {liveTip.slug ?? "—"}</li>
                  <li><strong>status:</strong> {liveTip.status ?? "—"}</li>
                  <li><strong>readyToPublish:</strong> {String(liveTip.readyToPublish)}</li>
                  <li><strong>startDate:</strong> {liveTip.startDate ?? "—"}</li>
                  <li><strong>endDate:</strong> {liveTip.endDate ?? "—"}</li>
                </ul>
              </div>
            ) : (
              <p class="tips-debug-panel__explain">{debugLiveExplanation}</p>
            )}
            <p class="tips-debug-panel__subhead">All records in help-hub.json</p>
            <div class="tips-debug-table-wrap">
              <table class="tips-debug-table">
                <thead>
                  <tr>
                    <th>content_id</th>
                    <th>slug</th>
                    <th>status</th>
                    <th>readyToPublish</th>
                    <th>startDate</th>
                    <th>endDate</th>
                  </tr>
                </thead>
                <tbody>
                  {tips.length === 0 ? (
                    <tr>
                      <td colspan="6">(no rows)</td>
                    </tr>
                  ) : (
                    tips.map((row) => (
                      <tr>
                        <td>{row.content_id ?? "—"}</td>
                        <td>{row.slug ?? "—"}</td>
                        <td>{row.status ?? "—"}</td>
                        <td>{String(row.readyToPublish)}</td>
                        <td>{row.startDate ?? "—"}</td>
                        <td>{row.endDate ?? "—"}</td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </div>
        )}

        <!-- Try This -->
        {validTrySteps.length > 0 && (
          <section class="tuesday-tip__section tuesday-tip__try-section">
            <div class="tuesday-tip__try-card">
              <h2 class="tuesday-tip__section-heading tuesday-tip__try-heading">Try This:</h2>
              {typeof liveTip.tryThis?.quickActionTitle === "string" &&
                liveTip.tryThis.quickActionTitle.trim() !== "" && (
                <p>{liveTip.tryThis.quickActionTitle}</p>
              )}
              <div class="tuesday-tip__try-body">
                <ul data-placeholder="try this checklist">
                  {validTrySteps.map((step) => <li set:html={step}></li>)}
                </ul>
              </div>
            </div>
          </section>
        )}

        {/* Optional full-lesson link (JSON-driven) */}
        {(liveTip.memberHeading ||
          liveTip.memberText ||
          (typeof liveTip.memberLessonUrl === "string" && liveTip.memberLessonUrl.trim() !== "")) && (
          <section class="tuesday-tip__section tuesday-tip__member-lesson">
            <h2 class="tuesday-tip__section-heading">{liveTip.memberHeading || "Watch the Full Lesson"}</h2>
            <div class="kbm-card tuesday-tip__member-card">
              <div class="kbm-card-body tuesday-tip__member-body">
                <div class="tuesday-tip__member-thumb" data-placeholder="lesson thumbnail">
                  {liveTip.mediaPoster ? (
                    <img
                      src={liveTip.mediaPoster}
                      alt={liveTip.mediaAlt || "Member lesson thumbnail"}
                      loading="lazy"
                    />
                  ) : (
                    <span>Lesson Thumbnail</span>
                  )}
                </div>
                <div class="tuesday-tip__member-content">
                  <h3 class="tuesday-tip__member-title" data-placeholder="lesson title">
                    {liveTip.title || "Member Lesson Title"}
                  </h3>
                  <p class="tuesday-tip__member-text" data-placeholder="lesson description">
                    {liveTip.memberText ||
                      "Go deeper with the complete walkthrough and see the full sequence start to finish."}
                  </p>
                  {typeof liveTip.memberLessonUrl === "string" &&
                    liveTip.memberLessonUrl.trim() !== "" && (
                    <>
                      <a
                        href={liveTip.memberLessonUrl.trim()}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="kbm-btn kbm-btn-primary"
                        data-placeholder="lesson button"
                      >
                        {liveTip.memberButton || "Watch the Full Lesson"}
                      </a>
                      <p class="kbm-member-note">
                        Opens in the Knit it Now lesson library.
                      </p>
                    </>
                  )}
                </div>
              </div>
            </div>
          </section>
        )}

        {lesson && lesson.url && (
          <section class="help-hub-lesson-cta" aria-labelledby="lesson-cta-title">
            <div class="help-hub-lesson-cta__content">
              <p class="help-hub-lesson-cta__eyebrow">Next step</p>

              <h2 id="lesson-cta-title" class="help-hub-lesson-cta__title">
                Ready to do this step-by-step?
              </h2>

              <p class="help-hub-lesson-cta__text">
                This lesson walks you through each step so you can follow along with confidence on your machine.
              </p>

              <div class="help-hub-lesson-cta__actions">
                <a href={lesson.url} class="help-hub-lesson-cta__button">
                  Open Step-by-Step Lesson →
                </a>

                <p class="help-hub-lesson-cta__note">
                  Included with Knit it Now membership
                </p>
              </div>
            </div>
          </section>
        )}

        <section class="tuesday-tip__section tuesday-tip-discussion">
          <h2>Tried this? I’d love to hear how it went</h2>
            Join the discussion below! Our community loves helping each other master new skills.
          <div
            id="hyvor-talk-view"
            data-hyvor-website="14706"
            data-talk-id={typeof liveTip.slug === "string" && liveTip.slug.trim() !== ""
              ? liveTip.slug.trim()
              : String(liveTip.content_id ?? "")}
          >
          </div>
          <script is:inline>
            (function () {
              var el = document.getElementById("hyvor-talk-view");
              if (!el) return;
              var talkId = el.getAttribute("data-talk-id") || "";
              var websiteStr = el.getAttribute("data-hyvor-website") || "14706";
              var websiteId = parseInt(websiteStr, 10);
              if (!Number.isFinite(websiteId)) websiteId = 14706;
              console.log("Hyvor talk id:", talkId);
              console.log("Hyvor website id:", websiteId);
              window.HYVOR_TALK_WEBSITE = websiteId;
              window.HYVOR_TALK_CONFIG = {
                url: window.location.href,
                id: talkId,
              };
              var s = document.createElement("script");
              s.async = true;
              s.type = "text/javascript";
              s.src = "https://talk.hyvor.com/web-api/embed";
              if (el.parentNode) {
                el.parentNode.insertBefore(s, el.nextSibling);
              } else {
                (document.head || document.documentElement).appendChild(s);
              }
            })();
          </script>
        </section>
      </>
    ) : (
      <>
        <div class="tuesday-tip-header">
          <img
            src="/images/help-hub.svg"
            alt="Tuesday Tip"
            class="tuesday-tip-logo"
            loading="eager"
          />
        </div>
        {showTipsPageDebug && (
          <div class="tips-debug-panel" aria-label="Tuesday Tip data debug (temporary)">
            <p class="tips-debug-panel__title"><strong>Temporary debug</strong> — JSON load &amp; live match</p>
            <ul class="tips-debug-panel__list">
              <li><strong>Today (page):</strong> {today}</li>
              <li><strong>help-hub.json loaded:</strong> {tips.length > 0 ? `yes (${tips.length} record${tips.length === 1 ? "" : "s"})` : "no / empty"}</li>
              <li><strong>Live tip found:</strong> no</li>
            </ul>
            <p class="tips-debug-panel__explain">{debugLiveExplanation}</p>
            <p class="tips-debug-panel__subhead">All records in help-hub.json</p>
            <div class="tips-debug-table-wrap">
              <table class="tips-debug-table">
                <thead>
                  <tr>
                    <th>content_id</th>
                    <th>slug</th>
                    <th>status</th>
                    <th>readyToPublish</th>
                    <th>startDate</th>
                    <th>endDate</th>
                  </tr>
                </thead>
                <tbody>
                  {tips.length === 0 ? (
                    <tr>
                      <td colspan="6">(no rows)</td>
                    </tr>
                  ) : (
                    tips.map((row) => (
                      <tr>
                        <td>{row.content_id ?? "—"}</td>
                        <td>{row.slug ?? "—"}</td>
                        <td>{row.status ?? "—"}</td>
                        <td>{String(row.readyToPublish)}</td>
                        <td>{row.startDate ?? "—"}</td>
                        <td>{row.endDate ?? "—"}</td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </div>
        )}
        {/*
          Title + “coming soon” message come from PageHead only (no second heading here).
        */}
        <section class="mt-4">
          <div class="kbm-card">
            <div class="kbm-card-body">
              <h3>Want to ask a question now?</h3>
              <p>Join the conversation in the community and connect with other machine knitters.</p>
              <a href="/community" class="btn btn-primary">
                Go to the Community
              </a>
            </div>
          </div>
        </section>
      </>
    )}
  </section>
</Layout>

<style>
  .tips-page-section {
    max-width: min(1180px, 100%);
    margin-left: auto;
    margin-right: auto;
  }

  /* Help Hub detail page structure */
  .tuesday-tip-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
    margin-bottom: 1.75rem;
    padding: clamp(1rem, 2.5vw, 1.4rem);
    border: 1px solid rgba(82, 104, 45, 0.18);
    border-radius: 16px;
    background: #f8faf6;
  }

  @media (min-width: 980px) {
    .tuesday-tip-hero {
      grid-template-columns: minmax(320px, 1fr) minmax(420px, 1fr);
      gap: clamp(1.2rem, 2.5vw, 2rem);
      align-items: start;
    }
  }

  .tuesday-tip-hero__content {
    min-width: 0;
  }

  .tuesday-tip-bubbles {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .tuesday-tip-bubbles .bubble-hook {
    margin: 0;
    font-size: clamp(0.98rem, 1.45vw, 1.06rem);
    font-weight: 400;
    line-height: 1.55;
    color: #5e6c4d;
  }

  .tuesday-tip-bubble-row.talk-row {
    margin: 0;
  }

  .tuesday-tip-bubble-row.talk-left {
    margin-top: 0.3rem;
  }

  .tuesday-tip-bubbles .talk-bubble {
    max-width: 100%;
  }

  .talk-bubble.tuesday-tip__question {
    font-size: clamp(1.45rem, 2.6vw, 1.95rem);
    font-weight: 650;
    line-height: 1.16;
    margin: 0;
    color: #6f8550;
  }

  .talk-bubble.tuesday-tip__answer {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.55;
    padding: 16px 20px 16px 20px;
    margin-left: 60px;
  }

  .tuesday-tip__answer-inner {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .tuesday-tip__logo {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
  }

  .tuesday-tip__answer-text {
    flex: 1;
  }

  .tuesday-tip-hero__media {
    min-width: 0;
  }

  .tuesday-tip-hero__media-heading {
    margin: 0 0 0.55rem;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--kbm-green, #52682d);
  }

  .tuesday-tip-video-shell {
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 0.5rem;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    width: 100%;
    max-width: 100%;
  }

  .tuesday-tip-video-aspect {
    position: relative;
    width: 100%;
    padding-bottom: 60%;
    height: 0;
    border-radius: 8px;
    background: #0f172a;
  }

  .tuesday-tip-video-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .help-hub-media {
    position: absolute;
    inset: 0;
  }

  .tuesday-tip-media-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tuesday-tip-video-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: linear-gradient(160deg, #f1f5f9 0%, #e2e8f0 100%);
  }

  .tuesday-tip-video-fallback__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #64748b;
    text-align: center;
    max-width: 16rem;
  }

  .tuesday-tip-header {
    text-align: center;
    margin: 20px 0 30px;
  }

  .tuesday-tip-logo {
    display: block;
    max-width: 220px;
    width: 100%;
    height: auto;
    margin-left: auto;
    margin-right: auto;
  }

  .tips-debug-panel {
    margin-bottom: 1.75rem;
    padding: 1rem 1.1rem;
    border: 2px dashed #64748b;
    border-radius: 8px;
    background: #f8fafc;
    font-size: 0.9rem;
    line-height: 1.45;
    color: #1e293b;
  }

  .tips-debug-panel__title {
    margin: 0 0 0.65rem 0;
    font-size: 0.95rem;
