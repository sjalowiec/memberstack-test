---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import "../components/talk-bubbles.css";
import helpHubData from "../data/help-hub.json";

type TipTryThis = {
  quickActionTitle?: string;
  quickAction?: string[];
  proExerciseTitle?: string;
  proExercise?: string[];
};

type TipRecord = {
  content_id?: number;
  slug?: string;
  status?: string;
  readyToPublish?: boolean;
  startDate?: string | null;
  endDate?: string | null;
  hook?: string;
  question?: string;
  quickAnswer?: string;
  /** Help-hub style short answer (alias for quickAnswer). */
  bubbleAnswer?: string;
  bridge?: string;
  videoUrl?: string;
  /** Help-hub style video URL (alias for videoUrl). */
  mediaUrl?: string;
  tryTitle?: string;
  tryThisTitle?: string;
  trySteps?: string[];
  tryThis?: TipTryThis;
  memberHeading?: string;
  memberText?: string;
  memberLink?: string;
  memberButton?: string;
  memberLessonUrl?: string;
  communityHeading?: string;
  communityText?: string;
  communityLink?: string;
  communityButton?: string;
  /** Optional long-form body for “About This Tip”; falls back to `bridge` when absent. */
  description?: string;
  /** Future: in-page anchor links; render nav only when present and non-empty. */
  jumpLinks?: { label: string; href: string }[];
};

function getTodayIso(): string {
  const now = new Date();
  const y = now.getFullYear();
  const m = String(now.getMonth() + 1).padStart(2, "0");
  const d = String(now.getDate()).padStart(2, "0");
  return `${y}-${m}-${d}`;
}

const today = getTodayIso();
const tips = Array.isArray(helpHubData) ? (helpHubData as TipRecord[]) : [];

const rawLiveTip = tips.find((tip) => {
  if (tip.status !== "published") return false;
  const startDate = typeof tip.startDate === "string" ? tip.startDate.trim() : "";
  const endDate = typeof tip.endDate === "string" ? tip.endDate.trim() : "";
  if (startDate && endDate) {
    return (
      tip.readyToPublish === true &&
      startDate <= today &&
      endDate >= today
    );
  }
  if (tip.readyToPublish === false) return false;
  return true;
});

/** Single live tip with help-hub field names merged into Tuesday-tip shape used by the template. */
const liveTip: TipRecord | undefined = rawLiveTip
  ? {
      ...rawLiveTip,
      quickAnswer: rawLiveTip.quickAnswer ?? rawLiveTip.bubbleAnswer,
      videoUrl: rawLiveTip.videoUrl ?? rawLiveTip.mediaUrl,
      tryTitle: rawLiveTip.tryTitle ?? rawLiveTip.tryThisTitle,
      trySteps:
        rawLiveTip.trySteps ??
        (rawLiveTip.tryThis
          ? [
              ...(Array.isArray(rawLiveTip.tryThis.quickAction)
                ? rawLiveTip.tryThis.quickAction
                : []),
              ...(Array.isArray(rawLiveTip.tryThis.proExercise)
                ? rawLiveTip.tryThis.proExercise
                : []),
            ]
          : undefined),
    }
  : undefined;

const debugLiveExplanation = !liveTip
  ? 'No record matched the live rule: status must be "published", readyToPublish must be true, startDate and endDate must be set (YYYY-MM-DD), and startDate ≤ today ≤ endDate (string compare).'
  : "";

/** Toggle to show the temporary tips debug panel (today / records / live match / table). */
const showTipsPageDebug = false;

const tipAboutDescription = liveTip
  ? typeof liveTip.description === "string" && liveTip.description.trim() !== ""
    ? liveTip.description.trim()
    : typeof liveTip.bridge === "string" && liveTip.bridge.trim() !== ""
      ? liveTip.bridge.trim()
      : ""
  : "";

const tipJumpLinks: { label: string; href: string }[] =
  liveTip && Array.isArray(liveTip.jumpLinks)
    ? liveTip.jumpLinks.filter(
        (j): j is { label: string; href: string } =>
          !!j &&
          typeof j.label === "string" &&
          j.label.trim() !== "" &&
          typeof j.href === "string" &&
          j.href.trim() !== ""
      )
    : [];
---

<Layout
  title={
    liveTip?.question
      ? `Tuesday Tip — ${liveTip.question.length > 55 ? `${liveTip.question.slice(0, 55)}…` : liveTip.question} | Knit it Now`
      : "Tuesday Tip Coming Soon | Knit it Now"
  }
  description={
    liveTip?.quickAnswer ||
    "A new Tuesday Tip is not live right now. Please check back soon."
  }
>
  {/*
    When a live tip exists, question + quickAnswer appear only in speech bubbles (not in PageHead),
    so we don’t duplicate the same text as a page title + subhead.
  */}
  <PageHead
    title="Tuesday Tip Coming Soon"
    subhead={
      liveTip
        ? undefined
        : "A new Tuesday Tip is not live right now. Please check back soon."
    }
    hideTitle={!!liveTip}
  />

  <section class="container py-5 tips-page-section">
    {liveTip ? (
      <>
        <div data-ms-content="logged-in">
        <div class="tuesday-tip-hero">
          <div class="tuesday-tip-bubbles">
            {liveTip.question && (
              <div class="talk-row talk-left tuesday-tip-bubble-row tuesday-tip-bubble-row--hero">
                <h1 class="talk-bubble bubble-bl bubble-question tuesday-tip__question tuesday-tip__question--hero">
                  {liveTip.question}
                </h1>
              </div>
            )}
            {liveTip.question &&
              typeof liveTip.hook === "string" &&
              liveTip.hook.trim() !== "" && (
                <p class="tuesday-tip-hook">{liveTip.hook}</p>
              )}
            {liveTip.quickAnswer && String(liveTip.quickAnswer).trim() !== "" && (
              <div class="talk-row talk-right tuesday-tip-bubble-row tuesday-tip-bubble-row--answer">
                <div class="talk-bubble bubble-br bubble-answer tuesday-tip__answer">
                  <div class="tuesday-tip__answer-inner">
                    <img
                      src="/images/help-hub.svg"
                      alt="Knit it Now"
                      class="tuesday-tip__logo"
                      width="52"
                      height="52"
                    />
                    <div class="tuesday-tip__answer-text" set:html={String(liveTip.quickAnswer)} />
                  </div>
                </div>
              </div>
            )}
          </div>
          <div class="tuesday-tip-hero__media">
            <div class="tuesday-tip-video-shell">
              <div class="tuesday-tip-video-aspect">
                {liveTip.videoUrl ? (
                  <iframe
                    src={liveTip.videoUrl}
                    class="tuesday-tip-video-iframe"
                    title={liveTip.question || "Tuesday Tip video"}
                    allow="autoplay; fullscreen; picture-in-picture"
                    allowfullscreen
                  />
                ) : (
                  <div class="tuesday-tip-video-fallback">
                    <p class="tuesday-tip-video-fallback__text">Video for this tip will appear here when a link is added.</p>
                  </div>
                )}
              </div>
            </div>
            <section class="tuesday-tip__details" aria-label="About this tip">
              <h2 class="tuesday-tip__section-heading">About This Tip</h2>
              {tipAboutDescription && (
                <p class="tuesday-tip__description">{tipAboutDescription}</p>
              )}
              {tipJumpLinks.length > 0 && (
                <nav class="tuesday-tip__jump-links" aria-label="Jump to sections on this page">
                  <ul class="tuesday-tip__jump-links-list">
                    {tipJumpLinks.map((j) => (
                      <li>
                        <a href={j.href.trim()}>{j.label.trim()}</a>
                      </li>
                    ))}
                  </ul>
                </nav>
              )}
              {/* Transcript: render inside `.tuesday-tip__transcript` when `liveTip.transcript` (or similar) exists in JSON */}
              <section class="tuesday-tip__transcript" data-placeholder="transcript"></section>
            </section>
          </div>
        </div>

        {showTipsPageDebug && (
          <div class="tips-debug-panel" aria-label="Tuesday Tip data debug (temporary)">
            <p class="tips-debug-panel__title"><strong>Temporary debug</strong> — JSON load &amp; live match</p>
            <ul class="tips-debug-panel__list">
              <li><strong>Today (page):</strong> {today}</li>
              <li><strong>help-hub.json loaded:</strong> {tips.length > 0 ? `yes (${tips.length} record${tips.length === 1 ? "" : "s"})` : "no / empty"}</li>
              <li><strong>Live tip found:</strong> {liveTip ? "yes" : "no"}</li>
            </ul>
            {liveTip ? (
              <div class="tips-debug-panel__live">
                <p class="tips-debug-panel__subhead">Matched record (first match):</p>
                <ul class="tips-debug-panel__list">
                  <li><strong>content_id:</strong> {liveTip.content_id ?? "—"}</li>
                  <li><strong>slug:</strong> {liveTip.slug ?? "—"}</li>
                  <li><strong>status:</strong> {liveTip.status ?? "—"}</li>
                  <li><strong>readyToPublish:</strong> {String(liveTip.readyToPublish)}</li>
                  <li><strong>startDate:</strong> {liveTip.startDate ?? "—"}</li>
                  <li><strong>endDate:</strong> {liveTip.endDate ?? "—"}</li>
                </ul>
              </div>
            ) : (
              <p class="tips-debug-panel__explain">{debugLiveExplanation}</p>
            )}
            <p class="tips-debug-panel__subhead">All records in help-hub.json</p>
            <div class="tips-debug-table-wrap">
              <table class="tips-debug-table">
                <thead>
                  <tr>
                    <th>content_id</th>
                    <th>slug</th>
                    <th>status</th>
                    <th>readyToPublish</th>
                    <th>startDate</th>
                    <th>endDate</th>
                  </tr>
                </thead>
                <tbody>
                  {tips.length === 0 ? (
                    <tr>
                      <td colspan="6">(no rows)</td>
                    </tr>
                  ) : (
                    tips.map((row) => (
                      <tr>
                        <td>{row.content_id ?? "—"}</td>
                        <td>{row.slug ?? "—"}</td>
                        <td>{row.status ?? "—"}</td>
                        <td>{String(row.readyToPublish)}</td>
                        <td>{row.startDate ?? "—"}</td>
                        <td>{row.endDate ?? "—"}</td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </div>
        )}

        <!-- Try This -->
        {Array.isArray(liveTip.trySteps) && liveTip.trySteps.length > 0 && (
          <section class="tuesday-tip__try-section">
            <div class="tuesday-tip__try-card">
              <h3 class="tuesday-tip__try-heading">{liveTip.tryTitle || "Try This"}</h3>
              <div class="tuesday-tip__try-body">
                <ul>
                  {liveTip.trySteps.map((step) => <li>{step}</li>)}
                </ul>
              </div>
            </div>
          </section>
        )}

        <!-- Member CTA -->
        {(liveTip.memberHeading ||
          liveTip.memberText ||
          (typeof liveTip.memberLessonUrl === "string" && liveTip.memberLessonUrl.trim() !== "")) && (
          <section class="tuesday-tip__cta">
            <div class="kbm-card">
              <div class="kbm-card-body">
                {liveTip.memberHeading && <h3>{liveTip.memberHeading}</h3>}
                {liveTip.memberText && <p>{liveTip.memberText}</p>}
                {typeof liveTip.memberLessonUrl === "string" &&
                  liveTip.memberLessonUrl.trim() !== "" && (
                  <>
                    <a
                      href={liveTip.memberLessonUrl.trim()}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="kbm-btn kbm-btn-primary"
                    >
                      Watch the Full Lesson (Members)
                    </a>
                    <p class="kbm-member-note">
                      This lesson opens in our current Knit It Now library.
                    </p>
                  </>
                )}
              </div>
            </div>
          </section>
        )}

        <section class="tuesday-tip-discussion">
          <h2>Have a question about this technique?</h2>
            Join the discussion below! Our community loves helping each other master new skills.
          <div
            id="hyvor-talk-view"
            data-hyvor-website="14706"
            data-talk-id={typeof liveTip.slug === "string" && liveTip.slug.trim() !== ""
              ? liveTip.slug.trim()
              : String(liveTip.content_id ?? "")}
          >
          </div>
          <script is:inline>
            (function () {
              var el = document.getElementById("hyvor-talk-view");
              if (!el) return;
              var talkId = el.getAttribute("data-talk-id") || "";
              var websiteStr = el.getAttribute("data-hyvor-website") || "14706";
              var websiteId = parseInt(websiteStr, 10);
              if (!Number.isFinite(websiteId)) websiteId = 14706;
              console.log("Hyvor talk id:", talkId);
              console.log("Hyvor website id:", websiteId);
              window.HYVOR_TALK_WEBSITE = websiteId;
              window.HYVOR_TALK_CONFIG = {
                url: window.location.href,
                id: talkId,
              };
              var s = document.createElement("script");
              s.async = true;
              s.type = "text/javascript";
              s.src = "https://talk.hyvor.com/web-api/embed";
              if (el.parentNode) {
                el.parentNode.insertBefore(s, el.nextSibling);
              } else {
                (document.head || document.documentElement).appendChild(s);
              }
            })();
          </script>
        </section>
        </div>

        <div data-ms-content="!logged-in" class="tuesday-tip__locked">

          <p class="tuesday-tip__locked-message">
            Quick step to access this tip — just confirm your email and you're in.
          </p>

          <a href="#" data-ms-modal="login" class="kbm-btn kbm-btn-primary">
            Access This Tip
          </a>

        </div>
      </>
    ) : (
      <>
        <div class="tuesday-tip-header">
          <img
            src="/images/help-hub.svg"
            alt="Tuesday Tip"
            class="tuesday-tip-logo"
            loading="eager"
          />
        </div>
        {showTipsPageDebug && (
          <div class="tips-debug-panel" aria-label="Tuesday Tip data debug (temporary)">
            <p class="tips-debug-panel__title"><strong>Temporary debug</strong> — JSON load &amp; live match</p>
            <ul class="tips-debug-panel__list">
              <li><strong>Today (page):</strong> {today}</li>
              <li><strong>help-hub.json loaded:</strong> {tips.length > 0 ? `yes (${tips.length} record${tips.length === 1 ? "" : "s"})` : "no / empty"}</li>
              <li><strong>Live tip found:</strong> no</li>
            </ul>
            <p class="tips-debug-panel__explain">{debugLiveExplanation}</p>
            <p class="tips-debug-panel__subhead">All records in help-hub.json</p>
            <div class="tips-debug-table-wrap">
              <table class="tips-debug-table">
                <thead>
                  <tr>
                    <th>content_id</th>
                    <th>slug</th>
                    <th>status</th>
                    <th>readyToPublish</th>
                    <th>startDate</th>
                    <th>endDate</th>
                  </tr>
                </thead>
                <tbody>
                  {tips.length === 0 ? (
                    <tr>
                      <td colspan="6">(no rows)</td>
                    </tr>
                  ) : (
                    tips.map((row) => (
                      <tr>
                        <td>{row.content_id ?? "—"}</td>
                        <td>{row.slug ?? "—"}</td>
                        <td>{row.status ?? "—"}</td>
                        <td>{String(row.readyToPublish)}</td>
                        <td>{row.startDate ?? "—"}</td>
                        <td>{row.endDate ?? "—"}</td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </div>
        )}
        {/*
          Title + “coming soon” message come from PageHead only (no second heading here).
        */}
        <section class="mt-4">
          <div class="kbm-card">
            <div class="kbm-card-body">
              <h3>Want to ask a question now?</h3>
              <p>Join the conversation in the community and connect with other machine knitters.</p>
              <a href="/community" class="btn btn-primary">
                Go to the Community
              </a>
            </div>
          </div>
        </section>
      </>
    )}
  </section>
</Layout>

<style>
  .tips-page-section {
    max-width: min(1180px, 100%);
    margin-left: auto;
    margin-right: auto;
  }

  /* —— Hero: intro + bubbles | 16:9 video —— */
  .tuesday-tip-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 2.25rem;
  }

  @media (min-width: 1080px) {
    .tuesday-tip-hero {
      grid-template-columns: minmax(300px, 1fr) minmax(460px, 1.12fr);
      gap: clamp(1.5rem, 3.5vw, 2.25rem);
      align-items: start;
    }
  }

  .tuesday-tip-bubbles {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }

  .tuesday-tip-hook {
    font-size: 1.05rem;
    line-height: 1.5;
    color: #4a5568; /* soft gray */
    margin: 0 0 0.4rem 0;
    font-style: italic;
    max-width: 100%;
  }

  .tuesday-tip-bubble-row.talk-row {
    margin: 0;
  }

  .tuesday-tip-bubble-row--hero.talk-row {
    /* Room for bottom-left tail (pseudo-elements don’t extend layout height). */
    padding-bottom: 1.15rem;
    margin-bottom: 0.2rem;
  }

  .tuesday-tip-bubble-row--answer.talk-row {
    margin-top: 0.15rem;
  }

  .tuesday-tip-bubbles .talk-bubble {
    max-width: 100%;
  }

  /* Hero headline: large question bubble, full column width, multi-line wrap */
  .talk-bubble.tuesday-tip__question--hero {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    font-weight: 700;
    font-size: clamp(1.28rem, 3.6vw, 2.05rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
    padding: clamp(1.05rem, 2.4vw, 1.55rem) clamp(1.2rem, 3vw, 1.85rem);
    border-radius: clamp(22px, 4vw, 28px);
    box-shadow: 0 4px 14px rgba(46, 58, 24, 0.12);
  }

  .talk-bubble.tuesday-tip__question--hero:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(46, 58, 24, 0.14);
  }

  /* Slightly larger tail for hero bubble-bl (keeps speech-bubble read) */
  .talk-bubble.tuesday-tip__question--hero.bubble-bl::after {
    bottom: -20px;
    left: clamp(22px, 7vw, 38px);
    border-left: 11px solid transparent;
    border-right: 7px solid transparent;
    border-top: 20px solid #52682d;
  }

  .talk-bubble.tuesday-tip__question--hero.bubble-bl::before {
    bottom: -14px;
    left: clamp(24px, 7vw, 40px);
    border-left: 9px solid transparent;
    border-right: 5px solid transparent;
    border-top: 16px solid #f0f4e8;
  }

  .tuesday-tip-hero__media {
    min-width: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .tuesday-tip-video-shell {
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 0.5rem;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    width: 100%;
    max-width: 100%;
  }

  /* 16:9 responsive frame */
  .tuesday-tip-video-aspect {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  height: 0;
  overflow: visible;
  border-radius: 8px;
  background: #0f172a;
}

  .tuesday-tip-video-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .tuesday-tip-video-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: linear-gradient(160deg, #f1f5f9 0%, #e2e8f0 100%);
  }

  .tuesday-tip-video-fallback__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #64748b;
    text-align: center;
    max-width: 16rem;
  }

  .tuesday-tip-header {
    text-align: center;
    margin: 20px 0 30px;
  }

  .tuesday-tip-logo {
    display: block;
    max-width: 220px;
    width: 100%;
    height: auto;
    margin-left: auto;
    margin-right: auto;
  }

  .tips-debug-panel {
    margin-bottom: 1.75rem;
    padding: 1rem 1.1rem;
    border: 2px dashed #64748b;
    border-radius: 8px;
    background: #f8fafc;
    font-size: 0.9rem;
    line-height: 1.45;
    color: #1e293b;
  }

  .tips-debug-panel__title {
    margin: 0 0 0.65rem 0;
    font-size: 0.95rem;
  }

  .tips-debug-panel__list {
    margin: 0 0 0.75rem 1.1rem;
    padding: 0;
  }

  .tips-debug-panel__list li {
    margin-bottom: 0.25rem;
  }

  .tips-debug-panel__subhead {
    margin: 0.85rem 0 0.4rem 0;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #334155;
  }

  .tips-debug-panel__explain {
    margin: 0 0 0.85rem 0;
    padding: 0.6rem 0.75rem;
    background: #fff7ed;
    border: 1px solid #fdba74;
    border-radius: 6px;
    font-size: 0.88rem;
  }

  .tips-debug-panel__live {
    margin-bottom: 0.75rem;
  }

  .tips-debug-table-wrap {
    overflow-x: auto;
    margin-top: 0.35rem;
  }

  .tips-debug-table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    font-size: 0.82rem;
    background: #fff;
  }

  .tips-debug-table th,
  .tips-debug-table td {
    border: 1px solid #cbd5e1;
    padding: 0.35rem 0.5rem;
    text-align: left;
    vertical-align: top;
  }

  .tips-debug-table th {
    background: #e2e8f0;
    font-weight: 700;
    white-space: nowrap;
  }

  .tuesday-tip-discussion {
    margin-top: 40px;
  }

  .tuesday-tip-discussion h2 {
    margin-bottom: 15px;
  }

  .talk-bubble.tuesday-tip__question:not(.tuesday-tip__question--hero) {
    color: #6f8550;
  }

  .talk-bubble.tuesday-tip__question--hero {
    color: #3d4d22;
  }

  /* Answer stays smaller / secondary vs hero question */
  .talk-bubble.tuesday-tip__answer {
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.55;
    padding: 12px 16px;
    margin-left: 0;
    margin-right: 0;
    max-width: min(100%, 36rem);
    margin-inline-start: auto;
  }

  @media (min-width: 480px) {
    .talk-bubble.tuesday-tip__answer {
      margin-inline-start: 2rem;
    }
  }

  .tuesday-tip__answer-inner {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .tuesday-tip__logo {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .tuesday-tip__answer-text {
    flex: 1;
  }

  .tuesday-tip__details {
    text-align: left;
    margin-top: 1.15rem;
    margin-bottom: 0;
    padding-top: 0;
  }

  .tuesday-tip__section-heading {
    margin: 0 0 0.85rem;
    font-size: clamp(1.12rem, 2.1vw, 1.32rem);
    font-weight: 600;
    line-height: 1.3;
    color: #1f2937;
  }

  .tuesday-tip__description {
    margin: 0 0 1rem;
    max-width: 100%;
    font-size: 1rem;
    line-height: 1.65;
    color: #374151;
  }

  .tuesday-tip__jump-links {
    margin: 0 0 1rem;
