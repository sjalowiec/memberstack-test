---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import "../components/talk-bubbles.css";
import tipsContent from "../data/tips-content.json";

type TipRecord = {
  content_id?: number;
  slug?: string;
  status?: string;
  readyToPublish?: boolean;
  startDate?: string | null;
  endDate?: string | null;
  question?: string;
  quickAnswer?: string;
  bridge?: string;
  videoUrl?: string;
  tryTitle?: string;
  trySteps?: string[];
  memberHeading?: string;
  memberText?: string;
  memberLink?: string;
  memberButton?: string;
  communityHeading?: string;
  communityText?: string;
  communityLink?: string;
  communityButton?: string;
};

function getTodayIso(): string {
  const now = new Date();
  const y = now.getFullYear();
  const m = String(now.getMonth() + 1).padStart(2, "0");
  const d = String(now.getDate()).padStart(2, "0");
  return `${y}-${m}-${d}`;
}

const today = getTodayIso();
const tips = Array.isArray(tipsContent) ? (tipsContent as TipRecord[]) : [];

// Live tip is sourced from tips-content.json using published + ready + active date range.
const liveTip = tips.find((tip) => {
  const startDate = typeof tip.startDate === "string" ? tip.startDate.trim() : "";
  const endDate = typeof tip.endDate === "string" ? tip.endDate.trim() : "";
  return (
    tip.status === "published" &&
    tip.readyToPublish === true &&
    !!startDate &&
    !!endDate &&
    startDate <= today &&
    endDate >= today
  );
});

const debugLiveExplanation = !liveTip
  ? 'No record matched the live rule: status must be "published", readyToPublish must be true, startDate and endDate must be set (YYYY-MM-DD), and startDate ≤ today ≤ endDate (string compare).'
  : "";

/** Toggle to show the temporary tips debug panel (today / records / live match / table). */
const showTipsPageDebug = false;
---

<Layout
  title={
    liveTip?.question
      ? `Tuesday Tip — ${liveTip.question.length > 55 ? `${liveTip.question.slice(0, 55)}…` : liveTip.question} | Knit it Now`
      : "Tuesday Tip Coming Soon | Knit it Now"
  }
  description={
    liveTip?.quickAnswer ||
    "A new Tuesday Tip is not live right now. Please check back soon."
  }
>
  {/*
    When a live tip exists, question + quickAnswer appear only in speech bubbles (not in PageHead),
    so we don’t duplicate the same text as a page title + subhead.
  */}
  <PageHead
    title="Tuesday Tip Coming Soon"
    subhead={
      liveTip
        ? undefined
        : "A new Tuesday Tip is not live right now. Please check back soon."
    }
    hideTitle={!!liveTip}
  />

  <section class="container py-5 tips-page-section">
    {liveTip ? (
      <>
        <div data-ms-content="logged-in">
        <div class="tuesday-tip-hero">
          <div class="tuesday-tip-hero__intro">
            <div class="tuesday-tip-header tuesday-tip-header--hero">
              <img
                src="/images/tuesday-tip.svg"
                alt="Tuesday Tip"
                class="tuesday-tip-logo"
                loading="eager"
              />
            </div>
            <div class="tuesday-tip-bubbles">
              {liveTip.question && (
                <div class="talk-row talk-left tuesday-tip-bubble-row">
                  <h2 class="talk-bubble bubble-bl bubble-question tuesday-tip__question">
                    {liveTip.question}
                  </h2>
                </div>
              )}
              
              {liveTip.quickAnswer && (
                <div class="talk-row talk-right tuesday-tip-bubble-row">
                  <div class="talk-bubble bubble-br bubble-answer tuesday-tip__answer">
                    <div class="tuesday-tip__answer-inner">
                      <img
                        src="/images/KINlogo.svg"
                        alt="Knit it Now"
                        class="tuesday-tip__logo"
                        width="60"
                        height="60"
                      />
                      <div class="tuesday-tip__answer-text" set:html={liveTip.quickAnswer} />
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
          <div class="tuesday-tip-hero__media">
            <div class="tuesday-tip-video-shell">
              <div class="tuesday-tip-video-aspect">
                {liveTip.videoUrl ? (
                  <iframe
                    src={liveTip.videoUrl}
                    class="tuesday-tip-video-iframe"
                    title={liveTip.question || "Tuesday Tip video"}
                    allow="autoplay; fullscreen; picture-in-picture"
                    allowfullscreen
                  />
                ) : (
                  <div class="tuesday-tip-video-fallback">
                    <p class="tuesday-tip-video-fallback__text">Video for this tip will appear here when a link is added.</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>

        {showTipsPageDebug && (
          <div class="tips-debug-panel" aria-label="Tuesday Tip data debug (temporary)">
            <p class="tips-debug-panel__title"><strong>Temporary debug</strong> — JSON load &amp; live match</p>
            <ul class="tips-debug-panel__list">
              <li><strong>Today (page):</strong> {today}</li>
              <li><strong>tips-content.json loaded:</strong> {tips.length > 0 || tipsContent !== undefined ? `yes (${tips.length} record${tips.length === 1 ? "" : "s"})` : "no / empty"}</li>
              <li><strong>Live tip found:</strong> {liveTip ? "yes" : "no"}</li>
            </ul>
            {liveTip ? (
              <div class="tips-debug-panel__live">
                <p class="tips-debug-panel__subhead">Matched record (first match):</p>
                <ul class="tips-debug-panel__list">
                  <li><strong>content_id:</strong> {liveTip.content_id ?? "—"}</li>
                  <li><strong>slug:</strong> {liveTip.slug ?? "—"}</li>
                  <li><strong>status:</strong> {liveTip.status ?? "—"}</li>
                  <li><strong>readyToPublish:</strong> {String(liveTip.readyToPublish)}</li>
                  <li><strong>startDate:</strong> {liveTip.startDate ?? "—"}</li>
                  <li><strong>endDate:</strong> {liveTip.endDate ?? "—"}</li>
                </ul>
              </div>
            ) : (
              <p class="tips-debug-panel__explain">{debugLiveExplanation}</p>
            )}
            <p class="tips-debug-panel__subhead">All records in tips-content.json</p>
            <div class="tips-debug-table-wrap">
              <table class="tips-debug-table">
                <thead>
                  <tr>
                    <th>content_id</th>
                    <th>slug</th>
                    <th>status</th>
                    <th>readyToPublish</th>
                    <th>startDate</th>
                    <th>endDate</th>
                  </tr>
                </thead>
                <tbody>
                  {tips.length === 0 ? (
                    <tr>
                      <td colspan="6">(no rows)</td>
                    </tr>
                  ) : (
                    tips.map((row) => (
                      <tr>
                        <td>{row.content_id ?? "—"}</td>
                        <td>{row.slug ?? "—"}</td>
                        <td>{row.status ?? "—"}</td>
                        <td>{String(row.readyToPublish)}</td>
                        <td>{row.startDate ?? "—"}</td>
                        <td>{row.endDate ?? "—"}</td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {liveTip.bridge?.trim() && (
          <p class="tuesday-tip__bridge">{liveTip.bridge}</p>
        )}

        <!-- Try This -->
        {Array.isArray(liveTip.trySteps) && liveTip.trySteps.length > 0 && (
          <section class="tuesday-tip__try-section">
            <div class="tuesday-tip__try-card">
              <h3 class="tuesday-tip__try-heading">{liveTip.tryTitle || "Try This"}</h3>
              <div class="tuesday-tip__try-body">
                <ul>
                  {liveTip.trySteps.map((step) => <li>{step}</li>)}
                </ul>
              </div>
            </div>
          </section>
        )}

        <!-- Member CTA -->
        {(liveTip.memberHeading || liveTip.memberText || liveTip.memberLink || liveTip.memberButton) && (
          <section class="tuesday-tip__cta">
            <div class="kbm-card">
              <div class="kbm-card-body">
                {liveTip.memberHeading && <h3>{liveTip.memberHeading}</h3>}
                {liveTip.memberText && <p>{liveTip.memberText}</p>}
                {liveTip.memberLink && liveTip.memberButton && (
                  <>
                    <a href={liveTip.memberLink} class="btn btn-primary">
                      {liveTip.memberButton}
                    </a>
                    <p class="tip-member-helper">
                      Already a member? Use the lesson link in your Tuesday email for direct access.
                    </p>
                  </>
                )}
              </div>
            </div>
          </section>
        )}

        <section class="tuesday-tip-discussion">
          <h2>Have a question about this technique?</h2>
            Join the discussion below! Our community loves helping each other master new skills.
          <div
            id="hyvor-talk-view"
            data-hyvor-website="14706"
            data-talk-id={typeof liveTip.slug === "string" && liveTip.slug.trim() !== ""
              ? liveTip.slug.trim()
              : String(liveTip.content_id ?? "")}
          >
          </div>
          <script is:inline>
            (function () {
              var el = document.getElementById("hyvor-talk-view");
              if (!el) return;
              var talkId = el.getAttribute("data-talk-id") || "";
              var websiteStr = el.getAttribute("data-hyvor-website") || "14706";
              var websiteId = parseInt(websiteStr, 10);
              if (!Number.isFinite(websiteId)) websiteId = 14706;
              console.log("Hyvor talk id:", talkId);
              console.log("Hyvor website id:", websiteId);
              window.HYVOR_TALK_WEBSITE = websiteId;
              window.HYVOR_TALK_CONFIG = {
                url: window.location.href,
                id: talkId,
              };
              var s = document.createElement("script");
              s.async = true;
              s.type = "text/javascript";
              s.src = "https://talk.hyvor.com/web-api/embed";
              if (el.parentNode) {
                el.parentNode.insertBefore(s, el.nextSibling);
              } else {
                (document.head || document.documentElement).appendChild(s);
              }
            })();
          </script>
        </section>
        </div>

        <div data-ms-content="!logged-in" class="tuesday-tip__locked">

          <p class="tuesday-tip__locked-message">
            Quick step to access this tip — just confirm your email and you're in.
          </p>

          <a href="#" data-ms-modal="login" class="kbm-btn kbm-btn-primary">
            Access This Tip
          </a>

        </div>
      </>
    ) : (
      <>
        <div class="tuesday-tip-header">
          <img
            src="/images/tuesday-tip.svg"
            alt="Tuesday Tip"
            class="tuesday-tip-logo"
            loading="eager"
          />
        </div>
        {showTipsPageDebug && (
          <div class="tips-debug-panel" aria-label="Tuesday Tip data debug (temporary)">
            <p class="tips-debug-panel__title"><strong>Temporary debug</strong> — JSON load &amp; live match</p>
            <ul class="tips-debug-panel__list">
              <li><strong>Today (page):</strong> {today}</li>
              <li><strong>tips-content.json loaded:</strong> {tips.length > 0 || tipsContent !== undefined ? `yes (${tips.length} record${tips.length === 1 ? "" : "s"})` : "no / empty"}</li>
              <li><strong>Live tip found:</strong> no</li>
            </ul>
            <p class="tips-debug-panel__explain">{debugLiveExplanation}</p>
            <p class="tips-debug-panel__subhead">All records in tips-content.json</p>
            <div class="tips-debug-table-wrap">
              <table class="tips-debug-table">
                <thead>
                  <tr>
                    <th>content_id</th>
                    <th>slug</th>
                    <th>status</th>
                    <th>readyToPublish</th>
                    <th>startDate</th>
                    <th>endDate</th>
                  </tr>
                </thead>
                <tbody>
                  {tips.length === 0 ? (
                    <tr>
                      <td colspan="6">(no rows)</td>
                    </tr>
                  ) : (
                    tips.map((row) => (
                      <tr>
                        <td>{row.content_id ?? "—"}</td>
                        <td>{row.slug ?? "—"}</td>
                        <td>{row.status ?? "—"}</td>
                        <td>{String(row.readyToPublish)}</td>
                        <td>{row.startDate ?? "—"}</td>
                        <td>{row.endDate ?? "—"}</td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </div>
        )}
        {/*
          Title + “coming soon” message come from PageHead only (no second heading here).
        */}
        <section class="mt-4">
          <div class="kbm-card">
            <div class="kbm-card-body">
              <h3>Want to ask a question now?</h3>
              <p>Join the conversation in the community and connect with other machine knitters.</p>
              <a href="/community" class="btn btn-primary">
                Go to the Community
              </a>
            </div>
          </div>
        </section>
      </>
    )}
  </section>
</Layout>

<style>
  .tips-page-section {
    max-width: min(1180px, 100%);
    margin-left: auto;
    margin-right: auto;
  }

  /* —— Hero: logo + bubbles | 16:9 video —— */
  .tuesday-tip-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 1080px) {
    .tuesday-tip-hero {
      grid-template-columns: minmax(300px, 1fr) minmax(460px, 1.12fr);
      gap: clamp(1.75rem, 4vw, 2.75rem);
      align-items: center;
    }
  }

  .tuesday-tip-hero__intro {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    min-width: 0;
  }

  .tuesday-tip-header--hero {
    text-align: left;
    margin: 0;
  }

  .tuesday-tip-header--hero .tuesday-tip-logo {
    margin-left: 0;
    margin-right: 0;
  }

  .tuesday-tip-bubbles {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .tuesday-tip-bubble-row.talk-row {
    margin: 0;
  }

  .tuesday-tip-bubbles .talk-bubble {
    max-width: 100%;
  }

  .tuesday-tip-hero__media {
    min-width: 0;
    width: 100%;
  }

  .tuesday-tip-video-shell {
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 0.5rem;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    width: 100%;
    max-width: 100%;
  }

  /* 16:9 responsive frame */
  .tuesday-tip-video-aspect {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  height: 0;
  overflow: visible;
  border-radius: 8px;
  background: #0f172a;
}

  .tuesday-tip-video-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .tuesday-tip-video-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: linear-gradient(160deg, #f1f5f9 0%, #e2e8f0 100%);
  }

  .tuesday-tip-video-fallback__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #64748b;
    text-align: center;
    max-width: 16rem;
  }

  .tuesday-tip-header {
    text-align: center;
    margin: 20px 0 30px;
  }

  .tuesday-tip-logo {
    display: block;
    max-width: 220px;
    width: 100%;
    height: auto;
    margin-left: auto;
    margin-right: auto;
  }

  .tips-debug-panel {
    margin-bottom: 1.75rem;
    padding: 1rem 1.1rem;
    border: 2px dashed #64748b;
    border-radius: 8px;
    background: #f8fafc;
    font-size: 0.9rem;
    line-height: 1.45;
    color: #1e293b;
  }

  .tips-debug-panel__title {
    margin: 0 0 0.65rem 0;
    font-size: 0.95rem;
  }

  .tips-debug-panel__list {
    margin: 0 0 0.75rem 1.1rem;
    padding: 0;
  }

  .tips-debug-panel__list li {
    margin-bottom: 0.25rem;
  }

  .tips-debug-panel__subhead {
    margin: 0.85rem 0 0.4rem 0;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #334155;
  }

  .tips-debug-panel__explain {
    margin: 0 0 0.85rem 0;
    padding: 0.6rem 0.75rem;
    background: #fff7ed;
    border: 1px solid #fdba74;
    border-radius: 6px;
    font-size: 0.88rem;
  }

  .tips-debug-panel__live {
    margin-bottom: 0.75rem;
  }

  .tips-debug-table-wrap {
    overflow-x: auto;
    margin-top: 0.35rem;
  }

  .tips-debug-table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    font-size: 0.82rem;
    background: #fff;
  }

  .tips-debug-table th,
  .tips-debug-table td {
    border: 1px solid #cbd5e1;
    padding: 0.35rem 0.5rem;
    text-align: left;
    vertical-align: top;
  }

  .tips-debug-table th {
    background: #e2e8f0;
    font-weight: 700;
    white-space: nowrap;
  }

  .tuesday-tip-discussion {
    margin-top: 40px;
  }

  .tuesday-tip-discussion h2 {
    margin-bottom: 15px;
  }

  /* Question vs answer: hierarchy only (no size/layout changes) */
  .talk-bubble.tuesday-tip__question {
    color: #6f8550;
  }

  .talk-bubble.tuesday-tip__answer {
    font-weight: 500;
    padding:  16px 20px 16px 20px;
    margin-left: 60px;
  }

  .tuesday-tip__answer-inner {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .tuesday-tip__logo {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
  }

  .tuesday-tip__answer-text {
    flex: 1;
  }

  .tuesday-tip__bridge {
    margin: 12px 0;
    font-size: 0.95rem;
    color: #666;
    font-style: italic;
  }

  .tuesday-tip__try-card {
    width: 70%;
    margin: 24px auto 0;
    padding: 28px;
    border: 2px dashed #52682d;
    border-radius: 12px;
    background: #f9faf9;
  }

  @media (max-width: 768px) {
    .tuesday-tip__try-card {
      width: 95%;
      padding: 22px;
    }
  }

  .tuesday-tip__try-heading {
    text-align: center;
    margin: 0 0 16px;
  }

  .tuesday-tip__try-body ul {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }

  .tuesday-tip__try-body li {
    position: relative;
    padding-left: 1.6rem;
    margin-bottom: 10px;
  }

  .tuesday-tip__try-body li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 10px;
    height: 10px;
    border: 2px solid #52682d;
    border-radius: 2px;
    transform: translateY(-50%);
  }

  .tuesday-tip__try-body .pro-tip {
    color: #6b6b6b;
    font-size: 0.95em;
  }

  .tuesday-tip__cta {
    margin-top: 32px;
  }

  .tip-member-helper {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: #6b7280;
  }

  .tuesday-tip__locked {
    margin-top: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .tuesday-tip__locked-message {
    margin: 0;
    max-width: 36ch;
    font-size: 1rem;
    line-height: 1.55;
    color: #334155;
  }
</style>