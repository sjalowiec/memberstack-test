---
/**
 * Tuesday Tip — single-column video-first layout.
 * Order: tip banner, video, video title, description, transcript / remaining detail content.
 * Data: featured tip from src/data/videos-public.json (isTipOfWeek: true).
 *
 * JSON fields currently used: title, description, content_id, vimeo_id, access_level, isTipOfWeek.
 * Jump links: expected from JSON as "chapters" or "jump_links" (array of { label, time? }); section omitted when absent.
 * Transcript: placeholder at .tuesday-tip__transcript-placeholder when "transcript" is missing in JSON; wire later to same field or shared video data.
 */
import Layout from "../layouts/Layout.astro";
import GatedVimeoEmbed from "../components/videos/GatedVimeoEmbed.astro";
import videos from "../data/videos-public.json";
import { getPreviewMember } from "../lib/getPreviewMember";

interface VideoEntry {
  content_id: number;
  title?: string;
  description?: string;
  vimeo_id: number;
  access_level?: "open" | "member";
  isTipOfWeek?: boolean;
  // Jump links: when available, expect chapters or jump_links array (e.g. { label: string; time?: number }[]) in JSON.
  // chapters?: Array<{ label: string; time?: number }>;
  // transcript?: string;
}

const featuredTipVideo = Array.isArray(videos)
  ? (videos as VideoEntry[]).find((v) => v.isTipOfWeek === true)
  : null;

const tipTitle = featuredTipVideo?.title ?? "";
const description = (featuredTipVideo as VideoEntry)?.description ?? "";
const vimeoId = featuredTipVideo?.vimeo_id ?? 0;
const accessLevel = featuredTipVideo?.access_level ?? "member";
const contentId = featuredTipVideo?.content_id;

// Jump links: render only when chapter/jump link data exists in JSON. Expected field: chapters or jump_links.
const jumpLinks = (featuredTipVideo as any)?.chapters ?? (featuredTipVideo as any)?.jump_links ?? null;
const hasJumpLinks = Array.isArray(jumpLinks) && jumpLinks.length > 0;

// Transcript: use when present in data; otherwise show placeholder.
const transcript = (featuredTipVideo as any)?.transcript ?? "";
const hasTranscript = Boolean(transcript && transcript.trim());

/** Preview state for dev/testing: member => force member view, nonmember => force non-member, default => normal logic */
const previewMember = getPreviewMember(Astro.url);
const forceMemberView = previewMember === "member" ? true : previewMember === "nonmember" ? false : null;
---

<Layout title="Tuesday Tip" description="A quick win you can try on your machine today.">
  <section class="tuesday-tip-page" aria-labelledby="tuesday-tip-heading">
    <article class="tuesday-tip__content video-detail">
          {/* 1. Tuesday Tip banner (member / non-member message), then video player */}
          {vimeoId ? (
            <>
              <div class={`tip-banner ${forceMemberView === true ? "tip-banner--member" : "tip-banner--nonmember"}`}>
                <img src="/images/tuesday-tip-white-bulb.svg" alt="Tuesday Tip" class="tip-banner-logo" />

                <div class="tip-banner-message">
                  {forceMemberView === true ? (
                    <p>Thank you for your membership. Enjoy this week's tip.</p>
                  ) : (
                    <>
                      <p class="tip-banner-headline">Enjoy this tip? Become a member for more.</p>
                      <p class="tip-banner-sub">
                        Unlock step-by-step tutorials, practical tools, and expert guidance for machine knitters.
                      </p>
                      <a href="/subscribe/plans.cfm" class="tip-banner-btn">Become a Member</a>
                    </>
                  )}
                </div>
              </div>
              <section class="tuesday-tip__player" id="tuesday-tip-player" aria-label="Video player">
                <GatedVimeoEmbed
                videoId={vimeoId}
                title={tipTitle}
                access_level={accessLevel}
                aspect="16/9"
              />
              </section>
            </>
          ) : (
            <div class="tuesday-tip__video-placeholder" aria-hidden="true">
              <p>No tip featured this week. Check back soon.</p>
            </div>
          )}

          {featuredTipVideo && (
            <>
              {/* 2. Video title */}
              <h1 id="tuesday-tip-heading" class="tuesday-tip__video-title">
                {tipTitle || "Tuesday Tip"}
              </h1>

              {/* 3. Description — only show when description exists in JSON */}
              {description.trim() && (
                <section class="video-description tuesday-tip__description" aria-labelledby="tip-desc-heading">
                  <h2 id="tip-desc-heading">Description</h2>
                  <div class="video-desc-text" set:html={description}></div>
                </section>
              )}

              {/* 4. Jump links — render only when chapters/jump_links exist in JSON. Expected field: chapters or jump_links. */}
              {hasJumpLinks && (
                <nav class="video-jumplinks tuesday-tip__jumplinks" aria-label="Jump to section">
                  <div class="jumplinks-head">
                    <h2>Jump to</h2>
                  </div>
                  <ul class="tuesday-tip__jumplinks-list">
                    {jumpLinks.map((item: { label: string; time?: number }, i: number) => (
                      <li>
                        <a href={`#tuesday-tip-player`} data-time={item.time ?? undefined}>
                          {item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              )}

              {/* 5. Transcript — when transcript exists in JSON, render it; otherwise show placeholder structure. */}
              <section class="tuesday-tip__transcript" aria-labelledby="tip-transcript-heading">
                <h2 id="tip-transcript-heading">Transcript</h2>
                {hasTranscript ? (
                  <div class="tuesday-tip__transcript-body" set:html={transcript}></div>
                ) : (
                  /* Transcript content will be inserted here when transcript data is wired into the Tuesday Tip JSON or shared video data structure. */
                  <div class="tuesday-tip__transcript-placeholder" aria-hidden="true">
                    <p class="tuesday-tip__transcript-placeholder-text">Transcript will appear here when available.</p>
                  </div>
                )}
              </section>
            </>
          )}
    </article>
  </section>
</Layout>

<style>
  .tuesday-tip-page {
    padding: 2rem 0 3rem;
    max-width: var(--max-content-width, 1100px);
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  /* Single-column main content */
  .tuesday-tip__content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .tuesday-tip__player {
    margin: 0;
  }

  .tuesday-tip__video-title {
    margin: 0;
    font-size: clamp(1.35rem, 3.5vw, 1.85rem);
    line-height: 1.3;
    color: var(--kbm-green, #52682d);
    font-weight: 700;
  }

  .tuesday-tip__description {
    margin: 0;
  }

  .tuesday-tip__description .video-desc-text {
    margin-top: 0.5rem;
    font-size: var(--text-base, 1rem);
    line-height: 1.6;
    color: #374151;
  }

  .tuesday-tip__description .video-desc-text :global(ul),
  .tuesday-tip__description .video-desc-text :global(ol) {
    margin: 0.5rem 0 0 1.25rem;
  }

  .tuesday-tip__description h2,
  .tuesday-tip__jumplinks .jumplinks-head h2,
  .tuesday-tip__transcript h2 {
    margin: 0 0 0.5rem;
    font-size: var(--text-lg, 1.125rem);
    font-weight: 600;
    color: var(--kbm-green, #52682d);
  }

  .tuesday-tip__jumplinks {
    margin: 0;
  }

  .tuesday-tip__jumplinks-list {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
    list-style: none;
  }

  .tuesday-tip__jumplinks-list li {
    margin-bottom: 0.35rem;
  }

  .tuesday-tip__jumplinks-list a {
    color: var(--kbm-green, #52682d);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tuesday-tip__jumplinks-list a:hover {
    color: #243015;
  }

  .tuesday-tip__transcript {
    margin: 0;
  }

  .tuesday-tip__transcript-body {
    margin-top: 0.5rem;
    font-size: var(--text-base, 1rem);
    line-height: 1.6;
    color: #374151;
  }

  .tuesday-tip__transcript-placeholder {
    margin-top: 0.5rem;
    padding: 1rem 1.25rem;
    background: rgba(82, 104, 45, 0.06);
    border: 1px dashed rgba(82, 104, 45, 0.25);
    border-radius: 10px;
  }

  .tuesday-tip__transcript-placeholder-text {
    margin: 0;
    font-size: var(--text-sm, 0.875rem);
    color: #6b7280;
    font-style: italic;
  }

  @media (min-width: 768px) {
    .tuesday-tip__content {
      gap: 1.5rem;
    }
  }

  @media (min-width: 1025px) {
    .tuesday-tip__content {
      gap: 1.75rem;
    }
  }

  .tuesday-tip__video-placeholder {
    aspect-ratio: 16 / 9;
    background: var(--kbm-bg, #e9ece7);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    color: #6b7280;
  }

  .tuesday-tip__video-placeholder p {
    margin: 0;
  }

  /* Tuesday Tip banner above video (member / non-member message) */
  .tip-banner {
    display: flex;
    align-items: center;
    gap: 24px;

    padding: 10px 18px;
    border-radius: 10px;

    margin-top: 6px;
    margin-bottom: 6px;
  }

  .tip-banner--member {
    background: #eef4e3;
  }

  .tip-banner--nonmember {
    background: #E7C677;
  }

  .tip-banner-logo {
    width: 180px;
    height: auto;
    flex-shrink: 0;
  }

  .tip-banner-message {
    flex: 1;
    line-height: 1.45;
  }

  .tip-banner-message > p {
    margin: 0;
    line-height: 1.4;
  }

  .tip-banner-headline {
    margin: 0 0 6px 0;
    font-weight: 700;
    line-height: 1.25;
  }

  .tip-banner-sub {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
  }

  .tip-banner-btn {
    display: inline-block;
    width: auto;

    margin: 10px auto 0 auto;

    padding: 10px 18px;
    border-radius: 10px;

    background: #ffffff;
    color: #52682d;
    border: 2px solid #52682d;

    font-weight: 700;
    text-decoration: none;
    line-height: 1.2;
  }

  .tip-banner-btn:hover {
    background: #52682d;
    color: white;
  }
</style>
