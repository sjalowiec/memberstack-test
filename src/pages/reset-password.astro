---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

const title = "Reset your password";
const description =
  "Memberstack password reset: enter the code from your email and choose a new password.";
---

<Layout {title} {description}>
  <h1>Reset your Knit It Now password</h1>
  <p>
    Enter the 6-digit code from your email and choose a new password. Passwords must be at least 8
    characters.
  </p>
  <p>
    <a href="#" data-ms-modal="forgot-password">Open password reset</a>
  </p>
</Layout>
