---
/**
 * Tip of the Week — standalone weekly Learning Library lesson.
 * Featured tip content is managed in Watson (runtime). JSON is a documented
 * dev-only fallback when TIP_OF_THE_WEEK_DEV_JSON=true.
 */
import Layout from "../layouts/Layout.astro";
import TipReactions from "../components/tip-of-the-week/TipReactions.astro";
import WeeklyTipSignup from "../components/tip-of-the-week/WeeklyTipSignup.astro";
import { resolveTipCatalogVideo } from "../lib/tipOfTheWeek";
import { tipPublicCta } from "../lib/tipOfTheWeek/map";
import {
  loadPublicTipOfTheWeekPage,
  loadTipOfTheWeekPreview,
} from "../lib/tipOfTheWeek/publicPage";
import { isWatsonSessionAuthenticated } from "../lib/watson/watsonAuth";
import {
  billboardMessageHasText,
  billboardMessagePlainText,
  sanitizeBillboardHtml,
} from "../lib/whatsNew/sanitizeBillboardHtml";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");

const previewId = Astro.url.searchParams.get("preview")?.trim() || "";
const watsonAuthed = isWatsonSessionAuthenticated(Astro.cookies);

const pageState =
  previewId && watsonAuthed
    ? await loadTipOfTheWeekPreview(previewId)
    : await loadPublicTipOfTheWeekPage();

const featured = pageState.kind === "featured" ? pageState.model : null;
const isPreview = Boolean(featured?.isPreview);
const tip = featured?.tip ?? null;
const video = tip ? resolveTipCatalogVideo({ videoContentId: tip.videoContentId }) : null;
const relatedLinks = featured?.relatedLinks ?? [];
const availableThroughDisplay = featured?.availableThroughDisplay ?? "";
const availabilityFooter = featured?.availabilityFooter ?? "";
const tryCopyHtml = tip ? sanitizeBillboardHtml(tip.tryCopy) : "";
const hasTryCopy = billboardMessageHasText(tryCopyHtml);
const sueTipHtml = tip ? sanitizeBillboardHtml(tip.sueTipCopy) : "";
const hasSueTipCopy = billboardMessageHasText(sueTipHtml);
const sueTipPlain = billboardMessagePlainText(sueTipHtml);
const introHtml = tip ? sanitizeBillboardHtml(tip.intro) : "";
const introPlain = billboardMessagePlainText(introHtml);
const totwCopyHasRichMarkup = (html: string) =>
  /<(?:strong|em|ul|ol|li|a|br)\b/i.test(html) ||
  (html.match(/<p\b/gi) || []).length > 1;
const introHasRichMarkup = totwCopyHasRichMarkup(introHtml);
const sueHasRichMarkup = totwCopyHasRichMarkup(sueTipHtml);
const pageTitle = tip?.title ?? "Tip of the Week";
const pageDescription =
  introPlain ||
  "A free weekly knitting lesson from the Knit It Now Learning Library.";
const cta = tipPublicCta(tip);
---

<Layout
  title={`${isPreview ? "Preview: " : ""}${pageTitle} | Tip of the Week | Knit it Now`}
  description={pageDescription}
  bodyClass="page--tight-header"
>
  {
    featured && tip ? (
      <article
        class:list={["totw", "page-wrap", "totw--featured", isPreview && "totw--preview"]}
        data-tip-of-the-week
        data-tip-id={tip.tipId}
        data-tip-source={featured.source}
        data-tip-preview={isPreview ? "true" : undefined}
      >
        {
          isPreview ? (
            <p class="totw-preview-banner" role="status" data-testid="totw-preview-banner">
              Watson preview — not publicly live. Status: {tip.status}. Free window:{" "}
              {tip.availableFrom} through {tip.availableThrough} (America/Los_Angeles).
            </p>
          ) : null
        }
        <header class="totw-intro">
          <div class="totw-intro__layout" data-totw-intro-layout>
            <img
              class="totw-intro__icon"
              src="/images/tow_lightbulb.svg"
              alt=""
              width="70"
              height="127"
              decoding="async"
              aria-hidden="true"
              data-testid="totw-lightbulb"
            />
            <div class="totw-intro__copy">
              <p class="totw-meta">
                <span class="totw-eyebrow">{tip.eyebrow}</span>
                <span class="totw-meta__sep" aria-hidden="true">·</span>
                <span
                  class="totw-availability"
                  data-tip-available-through={tip.availableThrough}
                >
                  Free to watch through {availableThroughDisplay}
                </span>
              </p>
              <h1 class="totw-title">{tip.title}</h1>
              {introHasRichMarkup ? (
                <div class="totw-lede" set:html={introHtml} />
              ) : (
                <p class="totw-lede">{introPlain}</p>
              )}
              <WeeklyTipSignup variant="inline" />
            </div>
          </div>
        </header>

        {tip.learnPoints.length > 0 ? (
          <section
            class="totw-section totw-section--learn"
            aria-labelledby="totw-learn-heading"
          >
            <div class="totw-learn-card kbm-card">
              <h2 id="totw-learn-heading" class="totw-learn-card__title">
                What You’ll Learn
              </h2>
              <ul class="totw-learn-list">
                {tip.learnPoints.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </section>
        ) : null}

        <section class="totw-video" aria-labelledby="totw-video-heading">
          <h2 id="totw-video-heading" class="totw-sr-only">Featured video</h2>
          {video ? (
            <div class="totw-video__shell">
              <button
                type="button"
                class="totw-video__trigger kbm-kin-catalog-video tip-of-week-card"
                data-vimeo-id={video.vimeoId}
                data-video-title={tip.title}
                aria-label={`Play video: ${tip.title}`}
                data-testid="totw-video-trigger"
              >
                {video.posterUrl ? (
                  <span class="tip-thumb-wrap">
                    <img
                      src={video.posterUrl}
                      alt=""
                      class="tip-image totw-video__poster"
                      width="1280"
                      height="720"
                      decoding="async"
                      fetchpriority="high"
                    />
                    <span class="tip-play" aria-hidden="true">
                      <svg viewBox="0 0 68 68" class="tip-play__icon" focusable="false">
                        <circle cx="34" cy="34" r="34" />
                        <polygon points="28,22 28,46 48,34" />
                      </svg>
                    </span>
                  </span>
                ) : (
                  <span class="totw-video__fallback tip-image-placeholder">Play video</span>
                )}
              </button>
              <p class="totw-video__caption">
                From the Learning Library: {video.catalogTitle}
              </p>
            </div>
          ) : (
            <p class="totw-video__missing" role="status">
              The featured video could not be resolved from the Learning Library catalog.
              Check that video content_id {tip.videoContentId} exists in videos-public.json
              with a numeric Vimeo id.
            </p>
          )}
        </section>

        <TipReactions tipId={tip.tipId} />

        {hasTryCopy ? (
          <section class="totw-section" aria-labelledby="totw-try-heading">
            <h2 id="totw-try-heading" class="totw-section__title">
              Try It
            </h2>
            <div class="totw-section__copy" set:html={tryCopyHtml} />
          </section>
        ) : null}

        {hasSueTipCopy ? (
          <section class="totw-sue" aria-labelledby="totw-sue-heading">
            <h2 id="totw-sue-heading" class="totw-sue__title">
              Sue’s Tip
            </h2>
            {sueHasRichMarkup ? (
              <div class="totw-sue__copy" set:html={sueTipHtml} />
            ) : (
              <p class="totw-sue__copy">{sueTipPlain}</p>
            )}
          </section>
        ) : null}

        {cta ? (
          <section class="totw-cta" aria-label="Call to action" data-totw-cta>
            <a
              class="kbm-btn kbm-btn-primary totw-cta__btn"
              href={cta.href}
              {...(cta.external
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >
              {cta.text}
            </a>
          </section>
        ) : null}

        {relatedLinks.length > 0 ? (
          <section class="totw-section" aria-labelledby="totw-related-heading">
            <h2 id="totw-related-heading" class="totw-section__title">
              Related Help
            </h2>
            <ul class="totw-related">
              {relatedLinks.map((link) => (
                <li class="totw-related__item" data-related-type={link.type}>
                  <a
                    class="totw-related__link"
                    href={link.href}
                    {...(link.external
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {link.type === "video" ? (
                      <span class="totw-related__play" aria-hidden="true">
                        <svg
                          viewBox="0 0 24 24"
                          class="totw-related__play-icon"
                          focusable="false"
                        >
                          <circle cx="12" cy="12" r="11" />
                          <polygon points="10,8 10,16 17,12" />
                        </svg>
                      </span>
                    ) : null}
                    {link.label}
                  </a>
                  {link.note ? <span class="totw-related__note">{link.note}</span> : null}
                </li>
              ))}
            </ul>
          </section>
        ) : null}

        <WeeklyTipSignup variant="secondary" />

        <footer class="totw-footer" data-tip-available-through={tip.availableThrough}>
          <p>{availabilityFooter}</p>
        </footer>

        <WeeklyTipSignup variant="modal" />
      </article>
    ) : (
      <article
        class="totw page-wrap totw--coming-soon"
        data-tip-of-the-week
        data-tip-coming-soon
      >
        <header class="totw-intro">
          <div class="totw-intro__layout" data-totw-intro-layout>
            <img
              class="totw-intro__icon"
              src="/images/tow_lightbulb.svg"
              alt=""
              width="70"
              height="127"
              decoding="async"
              aria-hidden="true"
              data-testid="totw-lightbulb"
            />
            <div class="totw-intro__copy">
              <p class="totw-eyebrow">TIP OF THE WEEK</p>
              <h1 class="totw-title">Tip of the Week</h1>
              <p class="totw-lede" data-testid="totw-coming-soon">
                The next Tip of the Week is coming soon.
              </p>
              <p class="totw-section__copy">
                Check back for a free weekly lesson from the Learning Library — or browse the
                library anytime if you’re a member.
              </p>
              <WeeklyTipSignup variant="coming-soon" />
              <p class="totw-coming-soon__actions">
                <a class="kbm-btn kbm-btn-primary" href="/videos/">
                  Browse the Learning Library
                </a>
              </p>
            </div>
          </div>
        </header>

        <WeeklyTipSignup variant="modal" />
      </article>
    )
  }
</Layout>

<style>
  /* Match What's New: widen past default .page-wrap 860px, tighten header gap locally. */
  .totw.page-wrap {
    max-width: min(var(--max-content-width, 1100px), 960px);
    margin-left: auto;
    margin-right: auto;
    padding-top: 0.75rem;
    padding-bottom: 2.5rem;
  }

  .totw-intro {
    margin-bottom: 1.25rem;
  }

  .totw-intro__layout {
    display: flex;
    align-items: flex-start;
    gap: 1rem 1.15rem;
  }

  .totw-intro__icon {
    flex: none;
    width: 70px;
    height: auto;
    display: block;
  }

  .totw-intro__copy {
    flex: 1;
    min-width: 0;
  }

  .totw-preview-banner {
    margin: 0 0 1rem;
    padding: 0.65rem 0.85rem;
    border-radius: 8px;
    border: 1px solid #c4b39a;
    background: #fff8e8;
    color: #6b4f1d;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .totw-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.45rem;
    margin: 0 0 0.4rem;
    max-width: 42rem;
  }

  .totw-eyebrow {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--kbm-green, #52682d);
  }

  .totw-meta__sep {
    color: #9ca3af;
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1;
  }

  .totw-availability {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.35;
    color: #6b7280;
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
  }

  .totw-title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.45rem, 3.5vw, 1.85rem);
    line-height: 1.25;
    color: #1f2937;
    font-weight: 650;
  }

  .totw-lede {
    margin: 0 0 0.85rem;
    font-size: 1.02rem;
    line-height: 1.55;
    color: #374151;
    max-width: 42rem;
  }

  .totw-lede p {
    margin: 0;
  }

  .totw-lede p:not(:last-child) {
    margin-bottom: 0.65rem;
  }

  .totw-lede ul,
  .totw-lede ol {
    margin: 0.35rem 0 0.65rem;
    padding-left: 1.35rem;
  }

  .totw-lede a {
    color: #1f5f7a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .totw-video {
    margin: 0 0 0.25rem;
    max-width: 860px;
  }

  .totw-video__shell {
    margin: 0;
  }

  .totw-video__trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    text-align: left;
    border-radius: 12px;
  }

  .totw-video__trigger:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 3px;
  }

  .totw-video__trigger .tip-thumb-wrap {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    background: #e5e7eb;
  }

  .totw-video__poster,
  .totw-video__trigger .tip-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }

  .totw-video__trigger .tip-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .totw-video__trigger .tip-play__icon {
    width: 68px;
    height: 68px;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.22));
    transition: transform 0.18s ease;
  }

  .totw-video__trigger .tip-play__icon circle {
    fill: rgba(0, 0, 0, 0.45);
  }

  .totw-video__trigger .tip-play__icon polygon {
    fill: #ffffff;
  }

  .totw-video__trigger:hover .tip-play__icon,
  .totw-video__trigger:focus-visible .tip-play__icon {
    transform: scale(1.04);
  }

  .totw-video__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    background: linear-gradient(135deg, #e5e7eb 0%, #d1d5db 100%);
    color: #374151;
    font-weight: 600;
  }

  .totw-video__caption {
    margin: 0.55rem 0 0;
    font-size: 0.88rem;
    color: var(--text-muted, #6b7280);
  }

  .totw-video__missing {
    margin: 0;
    padding: 1rem;
    border-radius: 10px;
    background: #fef3c7;
    color: #92400e;
    font-size: 0.95rem;
  }

  .totw-section {
    margin-top: 1.75rem;
    max-width: 42rem;
  }

  /* Compact learn block above the video so the player stays prominent. */
  .totw-section--learn {
    margin-top: 1.1rem;
    margin-bottom: 1rem;
  }

  .totw-section__title {
    margin: 0 0 0.65rem;
    font-size: 1.2rem;
    font-weight: 650;
    color: #1f2937;
  }

  .totw-section__copy {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: #374151;
    max-width: 42rem;
  }

  .totw-section__copy p {
    margin: 0 0 0.65rem;
  }

  .totw-section__copy p:last-child {
    margin-bottom: 0;
  }

  .totw-section__copy ul,
  .totw-section__copy ol {
    margin: 0.35rem 0 0.65rem;
    padding-left: 1.35rem;
  }

  .totw-section__copy a {
    color: #1f5f7a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .totw-learn-card {
    margin: 0;
    max-width: 42rem;
    padding: 1.2rem 1.2rem 1.15rem;
    box-sizing: border-box;
  }

  .totw-learn-card__title {
    margin: 0 0 0.7rem;
    font-size: 1.2rem;
    font-weight: 650;
    color: #1f2937;
    line-height: 1.3;
  }

  .totw-learn-list {
    margin: 0;
    padding: 0 0 0 1.15rem;
    list-style: disc;
  }

  .totw-learn-list li {
    margin: 0.35rem 0;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: #374151;
  }

  .totw-learn-list li:first-child {
    margin-top: 0;
  }

  .totw-learn-list li:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .totw-learn-card {
      padding: 1rem;
    }

    .totw-learn-card__title {
      margin-bottom: 0.65rem;
    }
  }

  .totw-sue {
    margin-top: 1.75rem;
    padding: 1rem 1.15rem;
    border-left: 3px solid var(--kbm-green-2, #738c52);
    background: linear-gradient(180deg, #f4f6f1 0%, #eef1ea 100%);
    border-radius: 0 10px 10px 0;
    max-width: 42rem;
  }

  .totw-sue__title {
    margin: 0 0 0.45rem;
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--kbm-green, #52682d);
  }

  .totw-sue__copy {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.55;
    color: #374151;
  }

  .totw-sue__copy p {
    margin: 0;
  }

  .totw-sue__copy p:not(:last-child) {
    margin-bottom: 0.65rem;
  }

  .totw-sue__copy ul,
  .totw-sue__copy ol {
    margin: 0.35rem 0 0.65rem;
    padding-left: 1.35rem;
  }

  .totw-sue__copy a {
    color: #1f5f7a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .totw-cta {
    margin-top: 1.75rem;
    max-width: 42rem;
  }

  .totw-related {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
    max-width: 42rem;
  }

  .totw-related__item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--ring, #e5e8e0);
    border-radius: 10px;
    background: #fff;
  }

  .totw-related__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--kbm-green, #52682d);
    text-decoration: none;
  }

  .totw-related__play {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 0.95em;
    height: 0.95em;
  }

  .totw-related__play-icon {
    display: block;
    width: 100%;
    height: 100%;
  }

  .totw-related__play-icon circle {
    fill: var(--kbm-green, #52682d);
  }

  .totw-related__play-icon polygon {
    fill: #fff;
  }

  .totw-related__link:hover,
  .totw-related__link:focus-visible {
    text-decoration: underline;
  }

  .totw-related__note {
    font-size: 0.9rem;
    color: var(--text-muted, #6b7280);
  }

  .totw-footer {
    margin-top: 2rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--ring, #e5e8e0);
    font-size: 0.92rem;
    line-height: 1.5;
    color: #4b5563;
    max-width: 42rem;
  }

  .totw-footer p {
    margin: 0;
  }

  .totw-coming-soon__actions {
    margin-top: 1.25rem;
  }

  .totw-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .totw.page-wrap {
      padding-top: 0.5rem;
    }

    .totw-intro {
      margin-bottom: 1rem;
    }

    .totw-intro__icon {
      width: 48px;
    }

    .totw-title {
      font-size: 1.35rem;
      margin-bottom: 0.55rem;
    }

    .totw-lede {
      font-size: 0.98rem;
      margin-bottom: 0.65rem;
    }

    .totw-video__trigger .tip-play__icon {
      width: 56px;
      height: 56px;
    }

    .totw-section {
      margin-top: 1.4rem;
    }
  }

  /* Narrow phones: stack icon above the heading to avoid a cramped title row. */
  @media (max-width: 480px) {
    .totw-intro__layout {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
    }

    .totw-intro__icon {
      width: 46px;
    }
  }
</style>
