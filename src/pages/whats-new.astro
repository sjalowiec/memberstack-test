---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
export const prerender = true;

const description =
  "See what’s new on Knit it Now — recent additions and what’s coming next.";
const hyvorWebsiteId = import.meta.env.PUBLIC_HYVOR_TALK_WEBSITE_ID ?? "14706";

/** Sue headshot for Note from Sue card + Message Sue modal (swap file here only). */
const sueHeadshot = "/images/sue.gif";
---

<Layout
  title="What's New | Knit it Now"
  description={description}
  bodyClass="page--tight-header page--whats-new"
>
  <section class="whats-new-page" aria-label="What's new at Knit it Now">
    <div class="whats-new-container">
      <section class="whats-new-top" aria-label="Introduction">
        <div class="whats-new-top__lead">
          <div class="whats-new-header" role="banner">
            <PageHead title="What's New" />
            <p class="whats-new-intro">
              If you’ve already taken a look, here’s what’s new — and what’s coming next. This early preview includes two new interactive patterns, a growing Help Hub, and more features on the way.
            </p>
            <div style="text-align:center; margin: 20px 0;">
              <a href="#comments" class="kbm-btn kbm-btn-outline">
                Skip ahead and comment
              </a>
            </div>
          </div>
        </div>

        <footer class="whats-new-footer">
          <div class="whats-new-footer__inner">
            <div class="whats-new-footer__image">
              <img src={sueHeadshot} alt="Sue" width="100" height="100" loading="lazy" decoding="async" />
            </div>

            <div class="whats-new-footer__content">
              <h3>A Note from Sue</h3>
              <p>
                I’m building Knit it Now step by step, and I’m so glad you’re here while it grows. If
                something is especially helpful - or if you’re looking for something you don’t see yet
                - I’d love to hear from you.<br> I read and respond to every message personally.
              </p>

              <div class="whats-new-footer__cta">
                <button
                  type="button"
                  class="kbm-btn kbm-btn-primary whats-new-footer__message-btn"
                  id="whats-new-sue-modal-open"
                  aria-haspopup="dialog"
                  aria-controls="whats-new-sue-modal"
                >
                  Message Sue Directly
                </button>
              </div>
            </div>
          </div>
        </footer>
      </section>

      <div class="whats-new-grid">
        <section class="whats-new-box" aria-labelledby="whats-new-new">
          <h2 class="whats-new-box__title" id="whats-new-new">
            <span class="nav-pill-new">NEW</span> Just Added
          </h2>
          <ul class="whats-new-items">
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title whats-new-item__title--pattern">
                  New: <a href="/patterns/hat">Custom Hat Pattern Builder</a>
                </h3>
                <p class="whats-new-item__desc">
                  Build a hat that fits your head, your gauge, and your machine — with no guesswork.
                </p>
              </div>
            </li>
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title whats-new-item__title--pattern">
                  New: <a href="/patterns/diy-blanket">DIY Blanket Pattern Builder</a>
                </h3>
                <p class="whats-new-item__desc">
                  Design a blanket in the size you want, check the width for your gauge, and plan panels if needed.
                </p>
              </div>
            </li>
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title"><a href="/stitch">improved pattern printing</a></h3>
                <p class="whats-new-item__desc">
                </p>
              </div>
            </li>





            
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title"><a href="/stitch">Stitch Browser</a></h3>
                <p class="whats-new-item__desc">
                  Stitch pattern inspiration for any machine — browse ideas, explore techniques, and spark your next project.
                </p>
              </div>
            </li>
            <!--<li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title"><a href="/help-hub">Help Hub</a> is growing</h3>
                <p class="whats-new-item__desc">
                  A growing collection of quick answers for stuck and frustrated moments.
                </p>
              </div>
            </li>-->
          </ul>
        </section>

        <section class="whats-new-box whats-new-box--coming" aria-labelledby="whats-new-coming-soon">
          <h2 class="whats-new-box__title" id="whats-new-coming-soon">Coming Soon</h2>
          <ul class="whats-new-items">
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title">Full Video Library</h3>
                <p class="whats-new-item__desc">
                  Browse more videos in a clearer, easier-to-use format.
                </p>
              </div>
            </li>
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title">More Help Hub entries</h3>
                <p class="whats-new-item__desc">
                  More quick answers, more examples, and more support.
                </p>
              </div>
            </li>
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title">MK Terms Glossary</h3>
                <p class="whats-new-item__desc">
                  Look up unfamiliar terms quickly and keep moving.
                </p>
              </div>
            </li>
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title">Shop</h3>
                <p class="whats-new-item__desc">
                  Tools, resources, and helpful extras in one place.
                </p>
              </div>
            </li>
          </ul>
        </section>
      </div>

      <section id="comments" class="whats-new-conversation" aria-labelledby="whats-new-conversation-title">
        <h2 id="whats-new-conversation-title">Join the Conversation</h2>
        <p>
          Have thoughts or questions about these updates? I’d love to hear what you’re noticing, what’s working, or what’s still unclear.
        </p>
        <ul class="whats-new-conversation__prompts">
          <li>Have you tried any of these updates yet?</li>
          <li>Is anything still confusing or missing?</li>
          <li>What would you like to see next?</li>
        </ul>
        <div id="hyvor-talk-view" class="whats-new-conversation__comments"></div>
      </section>
    </div>
  </section>

  <!-- Message Sue modal (styles scoped to .wn-sue-modal; headshot: `sueHeadshot` in frontmatter) -->
  <div
    id="whats-new-sue-modal"
    class="wn-sue-modal"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="wn-sue-modal-title"
  >
    <div class="wn-sue-modal__backdrop" id="whats-new-sue-modal-backdrop" tabindex="-1"></div>
    <div class="wn-sue-modal__panel">
      <button
        type="button"
        class="wn-sue-modal__close"
        id="whats-new-sue-modal-close"
        aria-label="Close message form"
      >
        <span aria-hidden="true">&times;</span>
      </button>

      <div class="wn-sue-modal__grid">
        <div class="wn-sue-modal__visual">
          <img
            class="wn-sue-modal__visual-img"
            src={sueHeadshot}
            alt="Sue"
            width="200"
            height="200"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="wn-sue-modal__body">
          <div class="wn-sue-modal__header">
            <h2 id="wn-sue-modal-title" class="wn-sue-modal__title">Message Sue</h2>
            <p class="wn-sue-modal__intro">
              I’m building this site step-by-step and I'd love your feedback on the new features!
            </p>
          </div>

          <div id="wn-sue-modal-form-wrap" class="wn-sue-modal__form-wrap">
            <form
              id="whats-new-sue-form"
              name="contact"
              method="POST"
              action="/.netlify/functions/contact"
              data-netlify="true"
              netlify-honeypot="bot-field"
              class="wn-sue-modal__form"
            >
              <input type="hidden" name="form-name" value="contact" />
              <p class="wn-sue-modal__hp">
                <label>Don’t fill this out: <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
              </p>
              <input type="hidden" name="submission-type" value="contact" />
              <input type="hidden" name="name" value="What's New page" />
              <input type="hidden" name="page_url" id="wnSuePageUrl" />
              <input type="hidden" name="submitted_at" id="wnSueSubmittedAt" />
              <input type="hidden" name="form_source" value="whats-new" />

              <label class="wn-sue-modal__field">
                <span class="wn-sue-modal__label">Email Address</span>
                <input type="email" name="email" required autocomplete="email" class="wn-sue-modal__input" />
              </label>

              <label class="wn-sue-modal__field">
                <span class="wn-sue-modal__label">Message</span>
                <textarea
                  name="message"
                  required
                  rows="7"
                  class="wn-sue-modal__textarea"
                  placeholder="Hi Sue, here is what I'm looking for..."
                ></textarea>
              </label>

              <p id="wn-sue-modal-error" class="wn-sue-modal__error" hidden>
                Something went wrong sending your message. Please try again in a moment, or email
                <a href="mailto:contact@knititnow.com">contact@knititnow.com</a>.
              </p>

              <button type="submit" class="wn-sue-modal__submit kbm-btn kbm-btn-primary" id="wn-sue-modal-submit">
                Send
              </button>
            </form>
          </div>

          <div
            id="wn-sue-modal-success"
            class="wn-sue-modal__success"
            hidden
            tabindex="-1"
            aria-live="polite"
          >
            <p class="wn-sue-modal__success-text">
              Thanks for the note! I'll read this personally as soon as I can. — Sue
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style is:global>
    body.page--whats-new main {
      max-width: min(1240px, 100%);
    }
  </style>

  <style>
    .whats-new-container {
      box-sizing: border-box;
      width: 100%;
      max-width: 1240px;
      margin-left: auto;
      margin-right: auto;
      padding: 1.25rem 0 3rem;
      text-align: left;
      background: #fafafa;
    }

    .whats-new-top {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: flex-start;
      gap: clamp(1.5rem, 3vw, 2.25rem);
      margin-bottom: clamp(1.75rem, 3vw, 2.75rem);
    }

    .whats-new-top__lead {
      flex: 1 1 0;
      min-width: 0;
    }

    .whats-new-top .whats-new-header {
      margin-bottom: 0;
    }

    /* Card fills the right column; same visuals as before (no max-width + auto center). */
    .whats-new-top .whats-new-footer {
      flex: 1 1 0;
      min-width: 0;
      max-width: none;
      margin-left: 0;
      margin-right: 0;
      margin-top: 0;
      margin-block-start: 0;
      align-self: flex-start;
    }

    .whats-new-header {
      max-width: 100%;
      margin-bottom: 32px;
    }

    .whats-new-header :global(.page-head) {
      margin-bottom: 1rem;
    }

    .whats-new-intro {
      margin: 0;
      max-width: 700px;
      font-size: var(--text-lg);
      line-height: 1.6;
      color: #243015;
    }

    .whats-new-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      align-items: stretch;
      margin-bottom: clamp(1.875rem, 3vw, 2.5rem);
    }

    @media (max-width: 768px) {
      .whats-new-top {
        flex-direction: column;
        flex-wrap: nowrap;
        align-items: stretch;
        gap: 1.75rem;
        margin-bottom: 1.75rem;
      }

      .whats-new-top__lead,
      .whats-new-top .whats-new-footer {
        flex: 1 1 auto;
        min-width: 0;
        width: 100%;
        align-self: stretch;
      }

      .whats-new-grid {
        grid-template-columns: 1fr;
      }
    }

    .whats-new-box {
      box-sizing: border-box;
      min-width: 0;
      min-height: 100%;
      display: flex;
      flex-direction: column;
      background: #ffffff;
      border: 1px solid #e5e5e5;
      border-radius: 12px;
      padding: 24px;
    }

    .whats-new-box--coming {
      background: #f8f8f6;
      border: 1px solid #ece9e2;
    }

    .whats-new-box h2,
    .whats-new-box__title {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      margin: 0 0 16px 0;
      padding-bottom: 6px;
      border-bottom: 2px solid #c2614e;
      font-size: 1.2rem;
      font-weight: 700;
      line-height: 1.25;
      color: var(--kbm-green);
    }

    .whats-new-box__title .nav-pill-new {
      margin-right: 0;
      flex-shrink: 0;
      align-self: center;
    }

    .whats-new-box--coming .whats-new-box__title {
      color: rgba(82, 104, 45, 0.88);
      border-bottom-color: rgba(194, 97, 78, 0.55);
    }

    .whats-new-box--coming .whats-new-item__title {
      color: #3a4530;
    }

    .whats-new-box--coming .whats-new-item__desc {
      color: #4a5640;
    }

    .whats-new-box--coming .whats-new-item__glyph {
      color: rgba(82, 104, 45, 0.38);
    }

    .whats-new-items {
      list-style: none;
      margin: 0;
      padding: 0;
      flex: 1;
    }

    .whats-new-box li {
      margin-bottom: 12px;
    }

    .whats-new-box li:last-child {
      margin-bottom: 0;
    }

    .whats-new-item {
      display: flex;
      gap: 0.5rem;
      align-items: flex-start;
    }

    .whats-new-item__glyph {
      flex-shrink: 0;
      font-size: 0.75rem;
      line-height: 1.6;
      color: rgba(82, 104, 45, 0.45);
      padding-top: 0.2em;
    }

    .whats-new-item__body {
      min-width: 0;
    }

    .whats-new-item__title {
      margin: 0 0 0.35rem 0;
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.3;
      color: #2c3820;
    }

    .whats-new-item__title--pattern {
      font-size: 1.1rem;
      font-weight: 700;
    }

    .whats-new-item__title--pattern a {
      color: inherit;
    }

    .whats-new-item__desc {
      margin: 0;
      font-size: var(--text-base);
      line-height: 1.55;
      color: #3d4a2e;
    }

    .whats-new-footer {
      box-sizing: border-box;
      max-width: 700px;
      width: 100%;
      margin-left: auto;
      margin-right: auto;
      margin-top: 0;
      padding: clamp(1.25rem, 2.5vw, 1.75rem);
      text-align: left;
      background: rgba(255, 253, 249, 0.92);
      border: 1px solid rgba(82, 104, 45, 0.065);
      border-radius: 12px;
      box-shadow: 0 1px 3px rgba(82, 104, 45, 0.05);
    }

    .whats-new-footer__inner {
      display: grid;
      grid-template-columns: 100px minmax(0, 1fr);
      gap: 24px;
      align-items: center;
      min-width: 0;
    }

    .whats-new-footer__image {
      width: 100px;
    }

    .whats-new-footer__image img {
      display: block;
      width: 100px;
      height: 100px;
      border-radius: 50%;
      object-fit: cover;
    }

    .whats-new-footer__content {
      min-width: 0;
    }

    .whats-new-footer__content h3 {
      margin-top: 0;
      margin-bottom: 8px;
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--kbm-green);
    }

    .whats-new-footer__content p {
      margin-top: 0;
      margin-bottom: 16px;
      line-height: 1.5;
      font-size: var(--text-base);
      color: #243015;
    }

    .whats-new-footer__cta {
      display: flex;
      justify-content: center;
      width: 100%;
    }

    .whats-new-footer__message-btn {
      font-size: 1rem;
      padding: 0.75rem 1.35rem;
      border-radius: 10px;
      cursor: pointer;
      border: none;
      font-family: inherit;
    }

    .whats-new-conversation {
      margin-top: clamp(1.75rem, 3.2vw, 2.5rem);
    }

    .whats-new-conversation h2 {
      margin: 0 0 0.55rem 0;
      font-size: clamp(1.2rem, 2.2vw, 1.4rem);
      color: var(--kbm-green);
    }

    .whats-new-conversation p {
      margin: 0 0 0.9rem 0;
      max-width: 760px;
      font-size: var(--text-base);
      line-height: 1.55;
      color: #243015;
    }

    .whats-new-conversation__prompts {
      margin: 0 0 1.2rem 1.1rem;
      padding: 0;
      color: #2f3c22;
      line-height: 1.5;
    }

    .whats-new-conversation__prompts li + li {
      margin-top: 0.35rem;
    }

    .whats-new-conversation__comments {
      min-height: 160px;
    }

    /* --- Message Sue modal (page-scoped; class prefix wn-sue-modal) --- */
    .wn-sue-modal {
      position: fixed;
      inset: 0;
      z-index: 10000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: max(16px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right))
        max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
      box-sizing: border-box;
    }

    .wn-sue-modal.wn-sue-modal--open {
      display: flex;
    }

    .wn-sue-modal__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(36, 48, 21, 0.42);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    .wn-sue-modal__panel {
      position: relative;
      z-index: 1;
      width: min(640px, 100%);
      max-height: min(90vh, 720px);
      overflow-y: auto;
      box-sizing: border-box;
      margin: auto;
      padding: clamp(1.25rem, 3vw, 1.75rem);
      background: linear-gradient(165deg, #fffef9 0%, #faf6ee 55%, #f5f0e6 100%);
      border: 1px solid rgba(82, 104, 45, 0.12);
      border-radius: 18px;
      box-shadow:
        0 4px 6px rgba(82, 104, 45, 0.06),
        0 22px 48px rgba(36, 48, 21, 0.14);
    }

    .wn-sue-modal__close {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 2;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.65);
      color: #3d4a2e;
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
      transition:
        background 0.15s ease,
        color 0.15s ease;
    }

    .wn-sue-modal__close:hover,
    .wn-sue-modal__close:focus-visible {
      background: rgba(82, 104, 45, 0.12);
      color: var(--kbm-green, #52682d);
      outline: none;
    }

    .wn-sue-modal__grid {
      display: grid;
      grid-template-columns: minmax(0, 200px) minmax(0, 1fr);
      gap: clamp(1.25rem, 3vw, 1.75rem);
      align-items: start;
      padding-top: 0.25rem;
    }

    .wn-sue-modal__visual {
      display: flex;
      justify-content: center;
    }

    .wn-sue-modal__visual-img {
      width: clamp(120px, 28vw, 180px);
      height: clamp(120px, 28vw, 180px);
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(255, 255, 255, 0.85);
      box-shadow: 0 8px 24px rgba(82, 104, 45, 0.15);
    }

    .wn-sue-modal__body {
      min-width: 0;
    }

    .wn-sue-modal__header {
      margin-bottom: 1.25rem;
    }

    .wn-sue-modal__title {
      margin: 0 0 0.5rem 0;
      font-size: clamp(1.25rem, 2.5vw, 1.45rem);
      font-weight: 700;
      line-height: 1.2;
      color: var(--kbm-green, #52682d);
      letter-spacing: -0.02em;
    }

    .wn-sue-modal__intro {
      margin: 0;
      font-size: var(--text-base, 1rem);
      line-height: 1.55;
      color: #3d4a2e;
    }

    .wn-sue-modal__hp {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    .wn-sue-modal__form {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .wn-sue-modal__field {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin-bottom: 1.1rem;
    }

    .wn-sue-modal__label {
      font-size: 0.95rem;
      font-weight: 600;
      color: #2c3820;
    }

    .wn-sue-modal__input,
    .wn-sue-modal__textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 0.65rem 0.85rem;
      font-size: 1rem;
      font-family: inherit;
      line-height: 1.45;
      color: #243015;
      background: #fffefb;
      border: 1px solid rgba(82, 104, 45, 0.2);
      border-radius: 10px;
      transition:
        border-color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .wn-sue-modal__textarea {
      min-height: 160px;
      resize: vertical;
    }

    .wn-sue-modal__input:focus,
    .wn-sue-modal__textarea:focus {
      outline: none;
      border-color: var(--kbm-green-2, #738c52);
      box-shadow: 0 0 0 3px rgba(106, 129, 65, 0.18);
    }

    .wn-sue-modal__textarea::placeholder {
      color: #9a9a8e;
      font-style: italic;
    }

    .wn-sue-modal__error {
      margin: 0 0 0.75rem 0;
      padding: 0.65rem 0.75rem;
      font-size: 0.9rem;
      line-height: 1.45;
      color: #5c3d38;
      background: rgba(179, 109, 97, 0.12);
      border-radius: 8px;
      border: 1px solid rgba(179, 109, 97, 0.25);
    }

    .wn-sue-modal__error a {
      color: var(--kbm-green, #52682d);
      font-weight: 600;
    }

    .wn-sue-modal__submit {
      width: 100%;
      margin-top: 0.35rem;
      padding: 0.85rem 1.25rem;
      font-size: 1.05rem;
      font-weight: 600;
      border-radius: 12px;
      cursor: pointer;
      border: 2px solid var(--kbm-green, #52682d);
      transition:
        background 0.15s ease,
        transform 0.12s ease;
    }

    .wn-sue-modal__submit:hover:not(:disabled) {
      transform: translateY(-1px);
    }

    .wn-sue-modal__submit:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .wn-sue-modal__success {
      padding: 0.5rem 0 0.25rem;
    }

    .wn-sue-modal__success-text {
      margin: 0;
      font-size: 1.05rem;
      line-height: 1.6;
      color: #2c3820;
    }

    @media (max-width: 700px) {
      .wn-sue-modal__grid {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .wn-sue-modal__visual {
        order: -1;
      }

      .wn-sue-modal__visual-img {
        width: 112px;
        height: 112px;
      }

      .wn-sue-modal__header {
        text-align: center;
      }

      .wn-sue-modal__field {
        text-align: left;
      }

      .whats-new-footer__inner {
        grid-template-columns: 1fr;
        text-align: left;
        align-items: start;
      }

      .whats-new-footer__image {
        justify-self: start;
      }
    }
  </style>

  <script is:inline define:vars={{ hyvorWebsiteId }}>
    window.HYVOR_TALK_WEBSITE = Number(hyvorWebsiteId);
    window.HYVOR_TALK_CONFIG = {
      url: window.location.origin + "/whats-new",
      id: "whats-new",
    };
  </script>

  <script is:inline>
    (function () {
      var mount = document.getElementById("hyvor-talk-view");
      if (!mount) return;

      // Use the same embed path pattern already used on other pages.
      var existing = document.querySelector('script[data-hyvor-embed="whats-new"]');
      if (existing && window.HyvorTalk && typeof window.HyvorTalk.reload === "function") {
        window.HyvorTalk.reload();
        return;
      }

      var s = document.createElement("script");
      s.async = true;
      s.type = "text/javascript";
      s.src = "https://talk.hyvor.com/web-api/embed";
      s.setAttribute("data-hyvor-embed", "whats-new");
      s.onload = function () {
        if (window.HyvorTalk && typeof window.HyvorTalk.reload === "function") {
          window.HyvorTalk.reload();
        }
      };
      (document.body || document.documentElement).appendChild(s);
    })();
  </script>

  <script is:inline>
    (function () {
      const modal = document.getElementById("whats-new-sue-modal");
      const openBtn = document.getElementById("whats-new-sue-modal-open");
      const backdrop = document.getElementById("whats-new-sue-modal-backdrop");
      const closeBtn = document.getElementById("whats-new-sue-modal-close");
      const form = document.getElementById("whats-new-sue-form");
      const formWrap = document.getElementById("wn-sue-modal-form-wrap");
      const successEl = document.getElementById("wn-sue-modal-success");
      const errEl = document.getElementById("wn-sue-modal-error");
      const pageUrl = document.getElementById("wnSuePageUrl");
      const submittedAt = document.getElementById("wnSueSubmittedAt");
      const submitBtn = document.getElementById("wn-sue-modal-submit");

      if (!modal || !openBtn || !form || !formWrap || !successEl || !errEl) return;

      function resetModalState() {
        formWrap.hidden = false;
        successEl.hidden = true;
        errEl.hidden = true;
        form.reset();
      }

      function openModal() {
        resetModalState();
        if (pageUrl) pageUrl.value = window.location.href;
        if (submittedAt) submittedAt.value = new Date().toISOString();
        modal.setAttribute("aria-hidden", "false");
        modal.classList.add("wn-sue-modal--open");
        document.body.style.overflow = "hidden";
        closeBtn?.focus();
      }

      function closeModal() {
        modal.setAttribute("aria-hidden", "true");
        modal.classList.remove("wn-sue-modal--open");
        document.body.style.overflow = "";
        resetModalState();
        openBtn?.focus();
      }

      openBtn.addEventListener("click", function (e) {
        e.preventDefault();
        openModal();
      });

      backdrop?.addEventListener("click", closeModal);
      closeBtn?.addEventListener("click", closeModal);

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && modal.classList.contains("wn-sue-modal--open")) {
          closeModal();
        }
      });

      form.addEventListener("submit", async function (e) {
        e.preventDefault();
        errEl.hidden = true;
        if (submittedAt) {
          const now = new Date();
          submittedAt.value =
            now.toLocaleDateString("en-US") +
            " – " +
            now.toLocaleTimeString("en-US", {
              hour: "numeric",
              minute: "2-digit",
              hour12: true,
            });
        }
        if (pageUrl) pageUrl.value = window.location.href;

        submitBtn.disabled = true;
        try {
          const res = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            redirect: "manual",
          });
          if (res.status === 200 || (res.status >= 300 && res.status < 400)) {
            formWrap.hidden = true;
            successEl.hidden = false;
            successEl.focus();
          } else {
            errEl.hidden = false;
          }
        } catch {
          errEl.hidden = false;
        } finally {
          submitBtn.disabled = false;
        }
      });
    })();
  </script>
</Layout>
