  </style>

  <script is:inline define:vars={{ "hyvorWebsiteId": "14706" }}>
    window.HYVOR_TALK_WEBSITE = Number("14706");
    window.HYVOR_TALK_CONFIG = {
      url: window.location.origin + "/whats-new",
      id: "whats-new",
    };
  </script>

  <script is:inline>
    (function () {
      var mount = document.getElementById("hyvor-talk-view");
      if (!mount) return;

      // Use the same embed path pattern already used on other pages.
      var existing = document.querySelector('script[data-hyvor-embed="whats-new"]');
      if (existing && window.HyvorTalk && typeof window.HyvorTalk.reload === "function") {
        window.HyvorTalk.reload();
        return;
      }

      var s = document.createElement("script");
      s.async = true;
      s.type = "text/javascript";
      s.src = "https://talk.hyvor.com/web-api/embed";
      s.setAttribute("data-hyvor-embed", "whats-new");
      s.onload = function () {
        if (window.HyvorTalk && typeof window.HyvorTalk.reload === "function") {
          window.HyvorTalk.reload();
        }
      };
      (document.body || document.documentElement).appendChild(s);
    })();
  </script>

  <script is:inline>
    (function () {
      const modal = document.getElementById("whats-new-sue-modal");
      const openBtn = document.getElementById("whats-new-sue-modal-open");
      const backdrop = document.getElementById("whats-new-sue-modal-backdrop");
      const closeBtn = document.getElementById("whats-new-sue-modal-close");
      const form = document.getElementById("whats-new-sue-form");
      const formWrap = document.getElementById("wn-sue-modal-form-wrap");
      const successEl = document.getElementById("wn-sue-modal-success");
      const errEl = document.getElementById("wn-sue-modal-error");
      const pageUrl = document.getElementById("wnSuePageUrl");
      const submittedAt = document.getElementById("wnSueSubmittedAt");
      const submitBtn = document.getElementById("wn-sue-modal-submit");

      if (!modal || !openBtn || !form || !formWrap || !successEl || !errEl) return;

      function resetModalState() {
        formWrap.hidden = false;
        successEl.hidden = true;
        errEl.hidden = true;
        form.reset();
      }

      function openModal() {
        resetModalState();
        if (pageUrl) pageUrl.value = window.location.href;
        if (submittedAt) submittedAt.value = new Date().toISOString();
        modal.setAttribute("aria-hidden", "false");
        modal.classList.add("wn-sue-modal--open");
        document.body.style.overflow = "hidden";
        closeBtn?.focus();
      }

      function closeModal() {
        modal.setAttribute("aria-hidden", "true");
        modal.classList.remove("wn-sue-modal--open");
        document.body.style.overflow = "";
        resetModalState();
        openBtn?.focus();
      }

      openBtn.addEventListener("click", function (e) {
        e.preventDefault();
        openModal();
      });

      backdrop?.addEventListener("click", closeModal);
      closeBtn?.addEventListener("click", closeModal);

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && modal.classList.contains("wn-sue-modal--open")) {
          closeModal();
        }
      });

      form.addEventListener("submit", async function (e) {
        e.preventDefault();
        errEl.hidden = true;
        if (submittedAt) {
          const now = new Date();
          submittedAt.value =
            now.toLocaleDateString("en-US") +
            " – " +
            now.toLocaleTimeString("en-US", {
              hour: "numeric",
              minute: "2-digit",
              hour12: true,
            });
        }
        if (pageUrl) pageUrl.value = window.location.href;

        submitBtn.disabled = true;
        try {
          const res = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            redirect: "manual",
          });
          if (res.status === 200 || (res.status >= 300 && res.status < 400)) {
            formWrap.hidden = true;
            successEl.hidden = false;
            successEl.focus();
          } else {
            errEl.hidden = false;
          }
        } catch {
          errEl.hidden = false;
        } finally {
          submitBtn.disabled = false;
        }
      });
    })();
  </script>
</Layout>
