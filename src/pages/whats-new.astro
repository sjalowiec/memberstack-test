---
import Layout from "../layouts/Layout.astro";
import { WHATS_NEW_BOARD_COLUMNS } from "../lib/whatsNew/types";
import {
  whatsNewCategoryCardStyle,
  whatsNewThemeStyle,
} from "../lib/whatsNew/palette";
import {
  billboardHasButton,
  billboardHasVideo,
} from "../lib/whatsNew/billboard";
import {
  boardColumnMeta,
  formatQuietPublishDate,
} from "../lib/whatsNew/public";
import {
  getPublicBillboardSettings,
  getPublicWhatsNewBoard,
} from "../lib/whatsNew/store";
import { sanitizeCardDescriptionHtml } from "../lib/whatsNew/sanitizeBillboardHtml";
import { resolveWhatsNewToolIcon } from "../lib/whatsNew/toolIcon";

const themeStyle = whatsNewThemeStyle();

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");

let loadError: string | null = null;
let board = {
  just_added: [],
  worth_exploring: [],
  in_the_pipeline: [],
} as Awaited<ReturnType<typeof getPublicWhatsNewBoard>>;
let billboard: Awaited<ReturnType<typeof getPublicBillboardSettings>> = null;

try {
  board = await getPublicWhatsNewBoard();
} catch (error) {
  loadError =
    error instanceof Error
      ? error.message
      : "Unable to load What's New right now.";
}

if (!loadError) {
  try {
    billboard = await getPublicBillboardSettings();
  } catch {
    billboard = null;
  }
}

const billboardVideo = billboard && billboardHasVideo(billboard);
const billboardButton = billboard && billboardHasButton(billboard);

const pageTitle = "What's New at Knit It Now";
const description =
  "See what's just been added, worth exploring, and in the pipeline at Knit It Now.";
---

<Layout
  title={`${pageTitle} | Knit it Now`}
  {description}
  bodyClass="page--tight-header"
  skipGlobalHyvor={true}
>
  <article
    class={`whats-new page-wrap${billboard ? " whats-new--with-billboard" : ""}`}
    aria-label={pageTitle}
    style={themeStyle}
  >
    {
      loadError ? (
        <p class="whats-new__status whats-new__status--error" role="alert">
          What's New isn't available yet. If you're previewing locally, apply the Watson What's New
          schema first, then refresh.
        </p>
      ) : null
    }

    {
      !loadError && billboard ? (
        <section
          class={`whats-new__billboard${billboardVideo ? " whats-new__billboard--with-video" : " whats-new__billboard--text"}`}
          aria-labelledby="whats-new-billboard-heading"
        >
          <div class="whats-new__billboard-copy">
            <h2 id="whats-new-billboard-heading">{billboard.headline}</h2>
            <div class="whats-new__billboard-message" set:html={billboard.message} />
            {
              billboardButton ? (
                <a class="kbm-btn kbm-btn-primary whats-new__billboard-cta" href={billboard.buttonDestinationUrl!}>
                  {billboard.buttonText}
                </a>
              ) : null
            }
          </div>
          {
            billboardVideo ? (
              <div class="whats-new__billboard-media vimeo-embed-wrapper">
                <div class="vimeo-embed-container" style="padding-bottom: 56.25%">
                  <iframe
                    src={`${billboard.safeVimeoEmbedUrl}${billboard.safeVimeoEmbedUrl?.includes("?") ? "&" : "?"}title=0&byline=0&portrait=0`}
                    title={billboard.headline}
                    frameborder="0"
                    allow="fullscreen; picture-in-picture; clipboard-write"
                    allowfullscreen
                    loading="lazy"
                  />
                </div>
              </div>
            ) : null
          }
        </section>
      ) : null
    }

    <header class="whats-new__header">
      <h1>{pageTitle}</h1>
    </header>

    <div class="whats-new__board" role="region" aria-label="What's New board">
      {
        WHATS_NEW_BOARD_COLUMNS.map((column) => {
          const meta = boardColumnMeta(column);
          const cards = board[column];
          return (
            <section
              class={`whats-new__column whats-new__column--${column}`}
              aria-labelledby={`whats-new-col-${column}`}
            >
              <div class="whats-new__column-accent" aria-hidden="true"></div>
              <div class="whats-new__column-body">
                <header class="whats-new__column-head">
                  <h2 id={`whats-new-col-${column}`}>{meta.title}</h2>
                  <p class="whats-new__column-sub">{meta.subtitle}</p>
                </header>

                {cards.length === 0 ? (
                  <p class="whats-new__empty">Nothing here yet.</p>
                ) : (
                  <ul class="whats-new__cards">
                    {cards.map((card) => {
                      const toolIcon = resolveWhatsNewToolIcon(card);
                      return (
                        <li
                          class={`whats-new__card kbm-card${card.featured ? " whats-new__card--featured" : ""}`}
                          style={whatsNewCategoryCardStyle(card.category)}
                        >
                          <div class="whats-new__card-top">
                            <div class="whats-new__card-top-lead">
                              {toolIcon ? (
                                <img
                                  class="whats-new__tool-icon"
                                  src={toolIcon}
                                  alt=""
                                  width="48"
                                  height="48"
                                  loading="lazy"
                                  decoding="async"
                                />
                              ) : null}
                              <span class="whats-new__category">{card.categoryLabel}</span>
                            </div>
                            {
                              card.featured ? (
                                <span class="whats-new__badge whats-new__badge--featured">Featured</span>
                              ) : null
                            }
                          </div>
                          <h3 class="whats-new__card-title">{card.title}</h3>
                          <div
                            class="whats-new__card-desc"
                            set:html={sanitizeCardDescriptionHtml(card.description)}
                          />

                          <p class="whats-new__quiet-date">
                            <time datetime={card.publishDate}>
                              {formatQuietPublishDate(card.publishDate)}
                            </time>
                          </p>
                          {card.destinationUrl && card.buttonText ? (
                            <a class="kbm-btn kbm-btn-primary whats-new__cta" href={card.destinationUrl}>
                              {card.buttonText}
                            </a>
                          ) : null}
                        </li>
                      );
                    })}
                  </ul>
                )}
              </div>
            </section>
          );
        })
      }
    </div>
  </article>
</Layout>

<style>
  .whats-new.page-wrap {
    max-width: 1100px;
    padding-top: 0.75rem;
    padding-bottom: 3rem;
  }

  .whats-new--with-billboard {
    padding-top: 1.1rem;
  }

  .whats-new__header {
    margin: 0 0 0.7rem;
  }

  .whats-new__header h1 {
    color: var(--kbm-green, #52682d);
    margin: 0;
  }

  .whats-new__status {
    padding: 0.85rem 1rem;
    border-radius: 10px;
    margin: 0 0 1rem;
  }

  .whats-new__status--error {
    background: #f8ecea;
    color: #7a3428;
    border: 1px solid #e4b7ae;
  }

  .whats-new__billboard {
    margin: 0 0 2rem;
    padding: 1.35rem 1.4rem 1.5rem;
    border-radius: 18px;
    background: linear-gradient(
      135deg,
      var(--wn-video-bg-start) 0%,
      var(--wn-video-bg-mid) 52%,
      var(--wn-video-bg-end) 100%
    );
    border: 1px solid var(--wn-video-border);
    border-left: 6px solid var(--wn-col-just-added);
  }

  /* Text-only: single column, full billboard width ? never reserve a media slot. */
  .whats-new__billboard--text {
    display: block;
  }

  .whats-new__billboard--text .whats-new__billboard-copy {
    width: 100%;
    max-width: none;
  }

  /* Video: stack by default; two columns on wider screens. */
  .whats-new__billboard--with-video {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }

  .whats-new__billboard-copy h2 {
    color: #2b4859;
    margin: 0 0 0.55rem;
    font-size: 1.45rem;
    line-height: 1.25;
  }

  .whats-new__billboard-message {
    margin: 0;
    color: #2c3a57;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .whats-new__billboard-message p {
    margin: 0 0 0.65rem;
  }

  .whats-new__billboard-message p:last-child {
    margin-bottom: 0;
  }

  .whats-new__billboard-message ul,
  .whats-new__billboard-message ol {
    margin: 0.35rem 0 0.65rem;
    padding-left: 1.35rem;
  }

  .whats-new__billboard-message a {
    color: #1f5f7a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .whats-new__billboard-cta {
    display: inline-flex;
    margin-top: 1rem;
    text-decoration: none;
  }

  .whats-new__billboard-media {
    margin: 0;
  }

  .whats-new__board {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  .whats-new__column {
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: var(--wn-column-bg);
    border: 1px solid var(--wn-board-border);
    border-radius: 18px;
    overflow: hidden;
    padding: 0;
  }

  .whats-new__column-accent {
    flex: 0 0 0.55rem;
    width: 100%;
    height: 0.55rem;
    background: var(--wn-col-just-added);
  }

  .whats-new__column--just_added .whats-new__column-accent {
    background: var(--wn-col-just-added);
  }

  .whats-new__column--worth_exploring .whats-new__column-accent {
    background: var(--wn-col-worth-exploring);
  }

  .whats-new__column--in_the_pipeline .whats-new__column-accent {
    background: var(--wn-col-in-the-pipeline);
  }

  .whats-new__column-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: 1rem;
    min-width: 0;
  }

  .whats-new__column-head {
    display: grid;
    grid-template-rows: auto auto;
    gap: 0.25rem;
    margin: 0 0 1rem;
    min-height: 3.85rem;
  }

  .whats-new__column-head h2 {
    margin: 0;
    color: #2c3a57;
    font-size: 1.25rem;
    line-height: 1.3;
    min-height: 1.3em;
  }

  .whats-new__column-sub {
    margin: 0;
    color: var(--text-muted, #6b7280);
    font-size: 0.92rem;
    line-height: 1.45;
    min-height: 1.45em;
  }

  .whats-new__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .whats-new__card {
    display: block;
    padding: 1rem 1rem 1.1rem;
    border-left: 5px solid var(--wn-accent);
    background: #fff;
    box-shadow: none;
  }

  .whats-new__card--featured {
    background: linear-gradient(180deg, var(--wn-soft) 0%, #ffffff 58%);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--wn-accent) 18%, transparent);
  }

  .whats-new__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.55rem;
  }

  .whats-new__card-top-lead {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .whats-new__tool-icon {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    /* Keep the registered icon crisp without stretching or distorting it. */
    object-fit: contain;
  }

  .whats-new__category {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--wn-label);
    background: var(--wn-soft);
    border: 1px solid color-mix(in srgb, var(--wn-accent) 45%, white);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }

  .whats-new__badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    border-radius: 6px;
    padding: 0.15rem 0.4rem;
  }

  .whats-new__badge--featured {
    background: var(--wn-badge-featured-bg);
    color: var(--wn-badge-featured-text);
  }

  .whats-new__card-title {
    margin: 0 0 0.4rem;
    color: var(--kbm-green, #52682d);
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .whats-new__card-desc {
    margin: 0 0 0.65rem;
    /* Inherit the normal site body-text color rather than the card's green. */
    color: #243015;
    font-size: 0.95rem;
    /* Override the global bold .kbm-card weight so the description reads as
       normal body copy while the title stays bold. */
    font-weight: 400 !important;
    line-height: 1.55;
    /* Keep long words/URLs from spilling out of the narrow cards. */
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  /* Compact spacing for formatted descriptions inside the narrow cards. */
  .whats-new__card-desc :global(p) {
    margin: 0 0 0.5rem;
  }

  .whats-new__card-desc :global(p:last-child) {
    margin-bottom: 0;
  }

  .whats-new__card-desc :global(ul),
  .whats-new__card-desc :global(ol) {
    margin: 0.25rem 0 0.5rem;
    padding-left: 1.25rem;
  }

  .whats-new__card-desc :global(li) {
    margin: 0.1rem 0;
  }

  .whats-new__card-desc :global(li:last-child) {
    margin-bottom: 0;
  }

  /* Normal weight for emphasis so descriptions stay readable body copy. */
  .whats-new__card-desc :global(strong) {
    font-weight: 600;
  }

  .whats-new__quiet-date {
    margin: 0 0 0.85rem;
    color: var(--text-muted, #6b7280);
    font-size: 0.8rem;
  }

  .whats-new__cta {
    display: inline-flex;
    text-decoration: none;
  }

  .whats-new__empty {
    margin: 0;
    color: var(--text-muted, #6b7280);
    font-size: 0.92rem;
  }

  @media (min-width: 900px) {
    .whats-new__board {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }

    .whats-new__billboard--with-video {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }
  }
</style>
