---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
export const prerender = true;

const description =
  "What’s new this week on Knit it Now — beta updates, featured tools, and what’s next.";
const hyvorWebsiteId = import.meta.env.PUBLIC_HYVOR_TALK_WEBSITE_ID ?? "14706";

/** Sue headshot for Note from Sue card + Message Sue modal (swap file here only). */
const sueHeadshot = "/images/sue.gif";
---

<Layout
  title="What's New | Knit it Now"
  description={description}
  bodyClass="page--tight-header page--whats-new"
>
  <section class="whats-new-page" aria-label="What's new at Knit it Now">
    <div class="whats-new-container">
      <section class="whats-new-top" aria-label="Introduction">
        <div class="whats-new-top__lead">
          <div class="whats-new-header" role="banner">
            <PageHead title="What's New" />
            <p class="whats-new-updated" role="status">Updated May 13</p>
            <p class="whats-new-intro">
              Here’s what’s new this week and what’s ready for you to explore.
            </p>
          </div>

          <section class="whats-new-box" aria-labelledby="whats-new-featured">
          <h2 class="whats-new-box__title" id="whats-new-featured">Featured This Week</h2>

          <ul class="whats-new-items">
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title whats-new-item__title--pattern">
                  <a href="/patterns/sleeveless-express/">NEW: Express Sweater Pattern System</a>
                </h3>
                <p class="whats-new-item__desc">
                  Create your own sleeveless sweater pattern using your size, gauge, and neckline choices. Generate a printable machine knitting pattern with interactive help built in.
                </p>
                <p class="whats-new-item__links">
                  <a class="whats-new-item__link" href="/patterns/sleeveless-express/">
                    <img
                      class="whats-new-item__link-icon"
                      src="/images/express-icon.svg"
                      alt=""
                      width="18"
                      height="18"
                      decoding="async"
                      aria-hidden="true"
                    />
                    Build Your Pattern
                  </a>
                  <span class="whats-new-item__links-sep" aria-hidden="true"> · </span>
                  <a class="whats-new-item__link" href="/patterns/sleeveless/beta-pattern">
                    <i class="fa-regular fa-file whats-new-item__link-icon whats-new-item__link-icon--fa" aria-hidden="true"></i>
                    View Sample Pattern
                  </a>
                </p>
              </div>
            </li>
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title whats-new-item__title--pattern">
                  <a href="/videos">Videos</a>
                </h3>
                <p class="whats-new-item__desc">
                  Browse and search the Knit it Now video library by title and description.
                </p>
              </div>
            </li>
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title whats-new-item__title--pattern">
                  <a href="/help-hub">Help Hubs</a>
                </h3>
                <p class="whats-new-item__desc">
                  Find focused tips and quick answers for common machine knitting questions.
                </p>
              </div>
            </li>
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title whats-new-item__title--pattern">
                  <a href="/reference">References</a>
                </h3>
                <p class="whats-new-item__desc">
                  Use quick guides for common terms, techniques, and go-to information.
                </p>
              </div>
            </li>
          </ul>
          <p class="whats-new-login-note">
            <em>Note: This is a new platform, so to see the videos, you’ll need to set your password the first time you log in. Just use the "reset password" option to get started.</em>
          </p>
          </section>
        </div>

        <footer class="whats-new-footer">
          <div class="whats-new-footer__inner">
            <div class="whats-new-footer__image">
              <img src={sueHeadshot} alt="Sue" width="100" height="100" loading="lazy" decoding="async" />
            </div>

            <div class="whats-new-footer__content">
              <h3>A Note from Sue</h3>
              <p>
                Every week, more of the new Knit it Now experience is coming online.
              </p>
              <p>
                This week’s biggest update is the new Express Pattern Builder along with pattern updates based directly on beta feedback.
              </p>
              <p>
                The feedback you’ve shared is already shaping what comes next, and I’m excited to keep building this with you.
              </p>
              <p>
                Thank you for being here and helping make the new Knit it Now clearer, easier to use, and more helpful for machine knitters.
              </p>

              <div class="whats-new-footer__cta">
                <a
                  class="kbm-btn kbm-btn-primary whats-new-footer__message-btn"
                  href="#comments"
                  >Share Your Feedback</a>
              </div>
              <p class="whats-new-footer__private-hint">
                Prefer to reach out privately?
                <a
                  href="#"
                  class="whats-new-footer__private-link"
                  id="whats-new-sue-modal-open"
                  aria-haspopup="dialog"
                  aria-controls="whats-new-sue-modal"
                  >Message Sue directly</a>
              </p>
            </div>
          </div>
        </footer>
      </section>

      <section class="whats-new-box whats-new-box--coming whats-new-coming-block" aria-labelledby="whats-new-coming-soon">
          <h2 class="whats-new-box__title" id="whats-new-coming-soon">Coming Soon</h2>
          <ul class="whats-new-items">
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title">More patterns</h3>
              </div>
            </li>
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title">More Help Hub entries</h3>
              </div>
            </li>
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title">Expanded video chapters and jump links</h3>
              </div>
            </li>
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title">Knitting Machine Reference</h3>
              </div>
            </li>
            <li class="whats-new-item">
              <span class="whats-new-item__glyph" aria-hidden="true">✧</span>
              <div class="whats-new-item__body">
                <h3 class="whats-new-item__title">Site bookmarks</h3>
              </div>
            </li>
          </ul>
      </section>
<hr class="whats-new-divider" aria-label="Divider" >
      <section id="comments" class="whats-new-conversation" aria-labelledby="whats-new-conversation-title">
        <h2 id="whats-new-conversation-title">Help Shape What’s Next</h2>
        <p>
          Have thoughts as you explore? I’d love to hear what’s working, what’s confusing, or what you expected to see.
        </p>
               <div id="hyvor-talk-view" class="whats-new-conversation__comments"></div>
      </section>
    </div>
  </section>

  <!-- Message Sue modal (styles scoped to .wn-sue-modal; headshot: `sueHeadshot` in frontmatter) -->
  <div
    id="whats-new-sue-modal"
    class="wn-sue-modal"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="wn-sue-modal-title"
  >
    <div class="wn-sue-modal__backdrop" id="whats-new-sue-modal-backdrop" tabindex="-1"></div>
    <div class="wn-sue-modal__panel">
      <button
        type="button"
        class="wn-sue-modal__close"
        id="whats-new-sue-modal-close"
        aria-label="Close message form"
      >
        <span aria-hidden="true">&times;</span>
      </button>

      <div class="wn-sue-modal__grid">
        <div class="wn-sue-modal__visual">
          <img
            class="wn-sue-modal__visual-img"
            src={sueHeadshot}
            alt="Sue"
            width="200"
            height="200"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="wn-sue-modal__body">
          <div class="wn-sue-modal__header">
            <h2 id="wn-sue-modal-title" class="wn-sue-modal__title">Message Sue</h2>
            <p class="wn-sue-modal__intro">
              I’m building this site step-by-step and I'd love your feedback on the new features!
            </p>
          </div>

          <div id="wn-sue-modal-form-wrap" class="wn-sue-modal__form-wrap">
            <form
              id="whats-new-sue-form"
              name="contact"
              method="POST"
              action="/.netlify/functions/contact"
              data-netlify="true"
              netlify-honeypot="bot-field"
              class="wn-sue-modal__form"
            >
              <input type="hidden" name="form-name" value="contact" />
              <p class="wn-sue-modal__hp">
                <label>Don’t fill this out: <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
              </p>
              <input type="hidden" name="submission-type" value="contact" />
              <input type="hidden" name="name" value="What's New page" />
              <input type="hidden" name="page_url" id="wnSuePageUrl" />
              <input type="hidden" name="submitted_at" id="wnSueSubmittedAt" />
              <input type="hidden" name="form_source" value="whats-new" />

              <label class="wn-sue-modal__field">
                <span class="wn-sue-modal__label">Email Address</span>
                <input type="email" name="email" required autocomplete="email" class="wn-sue-modal__input" />
              </label>

              <label class="wn-sue-modal__field">
                <span class="wn-sue-modal__label">Message</span>
                <textarea
                  name="message"
                  required
                  rows="7"
                  class="wn-sue-modal__textarea"
                  placeholder="Hi Sue, here is what I'm looking for..."
                ></textarea>
              </label>

              <p id="wn-sue-modal-error" class="wn-sue-modal__error" hidden>
                Something went wrong sending your message. Please try again in a moment, or email
                <a href="mailto:contact@knititnow.com">contact@knititnow.com</a>.
              </p>

              <button type="submit" class="wn-sue-modal__submit kbm-btn kbm-btn-primary" id="wn-sue-modal-submit">
                Send
              </button>
            </form>
          </div>

          <div
            id="wn-sue-modal-success"
            class="wn-sue-modal__success"
            hidden
            tabindex="-1"
            aria-live="polite"
          >
            <p class="wn-sue-modal__success-text">
              Thanks for the note! I'll read this personally as soon as I can. — Sue
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style is:global>
    body.page--whats-new main {
      max-width: min(1240px, 100%);
    }
  </style>

  <style>
    .whats-new-container {
      box-sizing: border-box;
      width: 100%;
      max-width: 1240px;
      margin-left: auto;
      margin-right: auto;
      padding: 1.25rem 0 3rem;
      text-align: left;
      background: #fafafa;
    }

    .whats-new-top {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: flex-start;
      gap: clamp(1.5rem, 3vw, 2.25rem);
      margin-bottom: clamp(1.75rem, 3vw, 2.75rem);
    }

    .whats-new-top__lead {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 2.5vw, 1.75rem);
    }

    .whats-new-top .whats-new-header {
      margin-bottom: 0;
    }

    /* Card fills the right column; same visuals as before (no max-width + auto center). */
    .whats-new-top .whats-new-footer {
      flex: 1 1 0;
      min-width: 0;
      max-width: none;
      margin-left: 0;
      margin-right: 0;
      margin-top: 0;
      margin-block-start: 0;
      align-self: flex-start;
    }

    .whats-new-header {
      max-width: 100%;
      margin-bottom: 32px;
    }

    .whats-new-header :global(.page-head) {
      margin-bottom: 0.65rem;
    }

    .whats-new-updated {
      margin: 0 0 0.65rem 0;
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1.35;
      letter-spacing: 0.01em;
      color: rgba(36, 48, 21, 0.58);
    }

    .whats-new-intro {
      margin: 0;
      max-width: 700px;
      font-size: var(--text-lg);
      line-height: 1.6;
      color: #243015;
    }

    .whats-new-coming-block {
      margin-bottom: clamp(1.875rem, 3vw, 2.5rem);
    }

    @media (max-width: 768px) {
      .whats-new-top {
        flex-direction: column;
        flex-wrap: nowrap;
        align-items: stretch;
        gap: 1.75rem;
        margin-bottom: 1.75rem;
      }

      .whats-new-top__lead,
      .whats-new-top .whats-new-footer {
        flex: 1 1 auto;
        min-width: 0;
        width: 100%;
        align-self: stretch;
      }
    }

    .whats-new-box {
      box-sizing: border-box;
      min-width: 0;
      min-height: 100%;
      display: flex;
      flex-direction: column;
      background: #ffffff;
      border: 1px solid #e5e5e5;
      border-radius: 12px;
      padding: 24px;
    }

    .whats-new-box--coming {
      background: #f8f8f6;
      border: 1px solid #ece9e2;
    }

    .whats-new-box h2,
    .whats-new-box__title {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      margin: 0 0 16px 0;
      padding-bottom: 6px;
      border-bottom: 2px solid #c2614e;
      font-size: 1.2rem;
      font-weight: 700;
      line-height: 1.25;
      color: var(--kbm-green);
    }

    .whats-new-box__title .nav-pill-new {
      margin-right: 0;
      flex-shrink: 0;
      align-self: center;
    }

    .whats-new-box--coming .whats-new-box__title {
      color: rgba(82, 104, 45, 0.88);
      border-bottom-color: rgba(194, 97, 78, 0.55);
    }

    .whats-new-box--coming .whats-new-item__title {
      color: #3a4530;
    }

    .whats-new-box--coming .whats-new-item__desc {
      color: #4a5640;
    }

    .whats-new-box--coming .whats-new-item__glyph {
      color: rgba(82, 104, 45, 0.38);
    }

    .whats-new-items {
      list-style: none;
      margin: 0;
      padding: 0;
      flex: 1;
    }

    .whats-new-box li {
      margin-bottom: 12px;
    }

    .whats-new-box li:last-child {
      margin-bottom: 0;
    }

    .whats-new-login-note {
      margin: 0.9rem 0 0;
      font-size: 0.95rem;
      line-height: 1.5;
      color: #4a5640;
    }

    .whats-new-item {
      display: flex;
      gap: 0.5rem;
      align-items: flex-start;
    }

    .whats-new-item__glyph {
      flex-shrink: 0;
      font-size: 0.75rem;
      line-height: 1.6;
      color: rgba(82, 104, 45, 0.45);
      padding-top: 0.2em;
    }

    .whats-new-item__body {
      min-width: 0;
    }

    .whats-new-item__title {
      margin: 0 0 0.35rem 0;
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.3;
      color: #2c3820;
    }

    .whats-new-item__title--pattern {
      font-size: 1.1rem;
      font-weight: 700;
    }

    .whats-new-item__title--pattern a {
      color: inherit;
    }

    .whats-new-item__desc {
      margin: 0;
      font-size: var(--text-base);
      line-height: 1.55;
      color: #3d4a2e;
    }

    .whats-new-item__links {
      margin: 0.5rem 0 0;
      font-size: 0.95rem;
      line-height: 1.45;
    }

    .whats-new-item__links a {
      color: var(--kbm-green);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .whats-new-item__links a:hover,
    .whats-new-item__links a:focus-visible {
      color: #3d5a24;
    }

    .whats-new-item__links a:focus-visible {
      outline: 2px solid var(--kbm-green);
      outline-offset: 2px;
      border-radius: 2px;
    }

    .whats-new-item__link {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      vertical-align: middle;
    }

    .whats-new-item__link-icon {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .whats-new-item__link-icon--fa {
      font-size: 1.125rem;
      line-height: 1;
    }

    @media (max-width: 480px) {
      .whats-new-item__links-sep {
        display: none;
      }

      .whats-new-item__links a {
        display: block;
      }

      .whats-new-item__links a + a {
        margin-top: 0.25rem;
      }
    }

    .whats-new-footer {
      box-sizing: border-box;
      max-width: 700px;
      width: 100%;
      margin-left: auto;
      margin-right: auto;
      margin-top: 0;
      padding: clamp(1.25rem, 2.5vw, 1.75rem);
      text-align: left;
      background: rgba(255, 253, 249, 0.92);
      border: 1px solid rgba(82, 104, 45, 0.065);
      border-radius: 12px;
      box-shadow: 0 1px 3px rgba(82, 104, 45, 0.05);
    }

    .whats-new-footer__inner {
      display: grid;
      grid-template-columns: 100px minmax(0, 1fr);
      gap: 24px;
      align-items: flex-start;
      min-width: 0;
    }

    .whats-new-footer__image {
      width: 100px;
    }

    .whats-new-footer__image img {
      display: block;
      width: 100px;
      height: 100px;
      border-radius: 50%;
      object-fit: cover;
    }

    .whats-new-footer__content {
      min-width: 0;
    }

    .whats-new-footer__content h3 {
      margin-top: 0;
      margin-bottom: 8px;
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--kbm-green);
    }

    .whats-new-footer__content p {
      margin-top: 0;
      margin-bottom: 16px;
      line-height: 1.5;
      font-size: var(--text-base);
      color: #243015;
    }

    .whats-new-footer__cta {
      display: flex;
      justify-content: center;
      width: 100%;
    }

    .whats-new-footer__message-btn {
      font-size: 1rem;
      padding: 0.75rem 1.35rem;
      border-radius: 10px;
      cursor: pointer;
      border: none;
      font-family: inherit;
    }

    .whats-new-footer__private-hint {
      margin: 0.5rem 0 0.65rem;
      text-align: center;
      font-size: var(--text-base);
      line-height: 1.45;
      color: #243015;
      word-wrap: break-word;
      overflow-wrap: anywhere;
    }

    .whats-new-footer__private-hint .whats-new-footer__private-link {
      margin-left: 0.25rem;
    }

    .whats-new-footer__private-link {
      color: var(--kbm-green);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .whats-new-footer__private-link:hover,
    .whats-new-footer__private-link:focus-visible {
      color: #3d5a24;
    }

    .whats-new-footer__private-link:focus-visible {
      outline: 2px solid var(--kbm-green);
      outline-offset: 2px;
      border-radius: 2px;
    }

    .whats-new-conversation {
      margin-top: clamp(1.75rem, 3.2vw, 2.5rem);
      scroll-margin-top: calc(var(--header-height, 5rem) + 0.75rem);
    }

    .whats-new-conversation h2 {
      margin: 0 0 0.55rem 0;
      font-size: clamp(1.2rem, 2.2vw, 1.4rem);
      color: var(--kbm-green);
    }

    .whats-new-conversation p {
      margin: 0 0 0.9rem 0;
      max-width: 760px;
      font-size: var(--text-base);
      line-height: 1.55;
      color: #243015;
    }

    .whats-new-conversation__prompts {
      margin: 0 0 1.2rem 1.1rem;
      padding: 0;
      color: #2f3c22;
      line-height: 1.5;
    }

    .whats-new-conversation__prompts li + li {
      margin-top: 0.35rem;
    }

    .whats-new-conversation__comments {
      min-height: 160px;
    }

    /* --- Message Sue modal (page-scoped; class prefix wn-sue-modal) --- */
    .wn-sue-modal {
      position: fixed;
      inset: 0;
      z-index: 10000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: max(16px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right))
        max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
      box-sizing: border-box;
    }

    .wn-sue-modal.wn-sue-modal--open {
      display: flex;
    }

    .wn-sue-modal__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(36, 48, 21, 0.42);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    .wn-sue-modal__panel {
      position: relative;
      z-index: 1;
      width: min(640px, 100%);
      max-height: min(90vh, 720px);
      overflow-y: auto;
      box-sizing: border-box;
      margin: auto;
      padding: clamp(1.25rem, 3vw, 1.75rem);
      background: linear-gradient(165deg, #fffef9 0%, #faf6ee 55%, #f5f0e6 100%);
      border: 1px solid rgba(82, 104, 45, 0.12);
      border-radius: 18px;
      box-shadow:
        0 4px 6px rgba(82, 104, 45, 0.06),
        0 22px 48px rgba(36, 48, 21, 0.14);
    }

    .wn-sue-modal__close {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 2;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 50%;
