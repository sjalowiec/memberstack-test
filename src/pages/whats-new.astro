---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
export const prerender = true;

const description =
  "Knit It Now patterns are getting a major upgrade — more interactive, more visual, and easier to follow beside your knitting machine.";
const hyvorWebsiteId = import.meta.env.PUBLIC_HYVOR_TALK_WEBSITE_ID ?? "14706";

/** Sue headshot for Note from Sue card + Message Sue modal (swap file here only). */
const sueHeadshot = "/images/sue.gif";
---

<Layout
  title="What's New | Knit it Now"
  description={description}
  bodyClass="page--tight-header page--whats-new"
>
  <section class="whats-new-page" aria-label="What's new at Knit it Now">
    <div class="whats-new-container">
      <section class="whats-new-top" aria-label="Pattern system update">
        <div class="whats-new-top__lead">
          <div class="whats-new-header" role="banner">
            <PageHead title="What's New in Knit It Now Patterns" />
            <p class="whats-new-updated" role="status">Updated June 15</p>
            <p class="whats-new-intro">
              New features and improvements added during beta testing.
            </p>
           </div>

          <section class="whats-new-focus" aria-labelledby="whats-new-focus-heading">
            <p class="whats-new-focus__eyebrow">This Week's Focus</p>
            <h2 class="whats-new-focus__heading" id="whats-new-focus-heading">Neckline Shaping</h2>
            <p class="whats-new-focus__copy">
              Neckline shaping is one of the most challenging parts of garment knitting. Over the past week we've revised the instructions, improved the shaping charts, and added clearer row-by-row guidance to make the process easier to follow.
            </p>
            <p class="whats-new-focus__copy">
              We're looking for feedback from beta testers. Please review the examples and let us know:
            </p>
            <ul class="whats-new-focus__points">
              <li>Are the instructions easy to follow?</li>
              <li>Do the charts make sense?</li>
              <li>Would you feel confident knitting from these instructions?</li>
              <li>Is anything unclear or confusing?</li>
            </ul>
            <div class="whats-new-focus__cta">
              <a class="kbm-btn kbm-btn-primary whats-new-focus__btn" href="/beta/neckline-shaping">Review Neckline Shaping</a>
            </div>
            <p class="whats-new-focus__note">
              Your feedback helps shape the final version of Knit It Now patterns.
            </p>
          </section>

          <section class="whats-new-video" aria-labelledby="whats-new-video-heading">
            <h2 class="whats-new-video__heading" id="whats-new-video-heading">Watch the Pattern Update Walkthrough</h2>
            <p class="whats-new-video__intro">
              A lot has changed in the pattern system. This quick walkthrough shows how saving, editing, copying, and managing patterns now works.
            </p>
            <div class="whats-new-video__embed">
              <iframe
                src="https://player.vimeo.com/video/1198067821"
                title="Pattern Update Walkthrough"
                loading="lazy"
                frameborder="0"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </section>

          
          
        </div>

        <footer class="whats-new-footer">
          <div class="whats-new-footer__inner">
            <div class="whats-new-footer__image">
              <img src={sueHeadshot} alt="Sue" width="100" height="100" loading="lazy" decoding="async" />
            </div>

            <div class="whats-new-footer__content">
              <h3>A Note from Sue</h3>
              <p>Since the beta launch, dozens of knitters have been exploring the new pattern system and sharing their thoughts along the way.</p>

<p>Many of the improvements on this page started as comments, questions, and suggestions from knitters just like you.</p>

<p>Recent updates include pattern saving, pattern editing, a simplified workflow, and new tools to help you plan your projects.</p>

<p><strong>Thank you for being part of this journey. </strong>Every pattern you create, every feature you try, and every piece of feedback helps shape what comes next.</p>

<p>Keep the feedback coming. I'm listening.</p>
              <div class="whats-new-footer__cta">
                <a
                  class="kbm-btn kbm-btn-primary whats-new-footer__message-btn"
                  href="#comments"
                  >Help us shape what's next</a>
              </div>
              <p class="whats-new-footer__private-hint">
                Prefer to reach out privately?
                <a
                  href="#"
                  class="whats-new-footer__private-link"
                  id="whats-new-sue-modal-open"
                  aria-haspopup="dialog"
                  aria-controls="whats-new-sue-modal"
                  >Message Sue directly</a>
              </p>
            </div>
          </div>
        </footer>
      </section>

      <section class="whats-new-beginning-callout" aria-labelledby="whats-new-beginning">
        <h2 class="whats-new-beginning-callout__title" id="whats-new-beginning">This Is Just the Beginning</h2>
        <p class="whats-new-beginning-callout__copy">
          These updates lay the groundwork for more garment styles, new shaping systems, additional interactive knitting tools, and ways to save and revisit your custom projects. We’re building this with you, one step at a time—and your feedback helps shape what comes next.
        </p>
       
      </section>

      <hr class="whats-new-divider" aria-label="Divider">
      <section id="comments" class="whats-new-conversation" aria-labelledby="whats-new-conversation-title">
        <h2 id="whats-new-conversation-title">Help Shape What’s Next</h2>
        <p>
          Have thoughts as you explore the new patterns? I’d love to hear what’s working, what’s confusing, or what you expected to see.
        </p>
               <div id="hyvor-talk-view" class="whats-new-conversation__comments"></div>
      </section>
    </div>
  </section>

  <!-- Message Sue modal (styles scoped to .wn-sue-modal; headshot: `sueHeadshot` in frontmatter) -->
  <div
    id="whats-new-sue-modal"
    class="wn-sue-modal"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="wn-sue-modal-title"
  >
    <div class="wn-sue-modal__backdrop" id="whats-new-sue-modal-backdrop" tabindex="-1"></div>
    <div class="wn-sue-modal__panel">
      <button
        type="button"
        class="wn-sue-modal__close"
        id="whats-new-sue-modal-close"
        aria-label="Close message form"
      >
        <span aria-hidden="true">&times;</span>
      </button>

      <div class="wn-sue-modal__grid">
        <div class="wn-sue-modal__visual">
          <img
            class="wn-sue-modal__visual-img"
            src={sueHeadshot}
            alt="Sue"
            width="200"
            height="200"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="wn-sue-modal__body">
          <div class="wn-sue-modal__header">
            <h2 id="wn-sue-modal-title" class="wn-sue-modal__title">Message Sue</h2>
            <p class="wn-sue-modal__intro">
              I’m building this site step-by-step and I'd love your feedback on the new features!
            </p>
          </div>

          <div id="wn-sue-modal-form-wrap" class="wn-sue-modal__form-wrap">
            <form
              id="whats-new-sue-form"
              name="contact"
              method="POST"
              action="/.netlify/functions/contact"
              data-netlify="true"
              netlify-honeypot="bot-field"
              class="wn-sue-modal__form"
            >
              <input type="hidden" name="form-name" value="contact" />
              <p class="wn-sue-modal__hp">
                <label>Don’t fill this out: <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
              </p>
              <input type="hidden" name="submission-type" value="contact" />
              <input type="hidden" name="name" value="What's New page" />
              <input type="hidden" name="page_url" id="wnSuePageUrl" />
              <input type="hidden" name="submitted_at" id="wnSueSubmittedAt" />
              <input type="hidden" name="form_source" value="whats-new" />

              <label class="wn-sue-modal__field">
                <span class="wn-sue-modal__label">Email Address</span>
                <input type="email" name="email" required autocomplete="email" class="wn-sue-modal__input" />
              </label>

              <label class="wn-sue-modal__field">
                <span class="wn-sue-modal__label">Message</span>
                <textarea
                  name="message"
                  required
                  rows="7"
                  class="wn-sue-modal__textarea"
                  placeholder="Hi Sue, here is what I'm looking for..."
                ></textarea>
              </label>

              <p id="wn-sue-modal-error" class="wn-sue-modal__error" hidden>
                Something went wrong sending your message. Please try again in a moment, or email
                <a href="mailto:contact@knititnow.com">contact@knititnow.com</a>.
              </p>

              <button type="submit" class="wn-sue-modal__submit kbm-btn kbm-btn-primary" id="wn-sue-modal-submit">
                Send
              </button>
            </form>
          </div>

          <div
            id="wn-sue-modal-success"
            class="wn-sue-modal__success"
            hidden
            tabindex="-1"
            aria-live="polite"
          >
            <p class="wn-sue-modal__success-text">
              Thanks for the note! I'll read this personally as soon as I can. — Sue
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style is:global>
    body.page--whats-new main {
      max-width: min(1240px, 100%);
    }
  </style>

  <style>
    .whats-new-container {
      box-sizing: border-box;
      width: 100%;
      max-width: 1240px;
      margin-left: auto;
      margin-right: auto;
      padding: 1.25rem 0 3rem;
      text-align: left;
      background: #fafafa;
    }

    .whats-new-top {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: flex-start;
      gap: clamp(1.5rem, 3vw, 2.25rem);
      margin-bottom: clamp(1.75rem, 3vw, 2.75rem);
    }

    .whats-new-top__lead {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: clamp(1.75rem, 3vw, 2.25rem);
    }

    .whats-new-top .whats-new-header {
      margin-bottom: 0;
    }

    /* Card fills the right column; same visuals as before (no max-width + auto center). */
    .whats-new-top .whats-new-footer {
      flex: 1 1 0;
      min-width: 0;
      max-width: none;
      margin-left: 0;
      margin-right: 0;
      margin-top: 0;
      margin-block-start: 0;
      align-self: flex-start;
    }

    .whats-new-header {
      max-width: 100%;
      margin-bottom: 32px;
    }

    .whats-new-header :global(.page-head) {
      margin-bottom: 0.65rem;
    }

    .whats-new-updated {
      margin: 0 0 0.65rem 0;
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1.35;
      letter-spacing: 0.01em;
      color: rgba(36, 48, 21, 0.58);
    }

    .whats-new-intro {
      margin: 0;
      max-width: 700px;
      font-size: var(--text-lg);
      line-height: 1.6;
      color: #243015;
    }

    .whats-new-hero-cta {
      margin-top: 1.35rem;
    }

    .whats-new-hero-cta__btn,
    .whats-new-bottom-cta__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      padding: 0.8rem 1.45rem;
      border-radius: 10px;
      text-decoration: none;
      font-family: inherit;
    }

    .whats-new-focus {
      box-sizing: border-box;
      position: relative;
      background: linear-gradient(165deg, #fffef9 0%, #f5f2ea 100%);
      border: 1px solid rgba(82, 104, 45, 0.18);
      border-left: 4px solid #c2614e;
      border-radius: 14px;
      padding: clamp(1.35rem, 3vw, 1.85rem) clamp(1.3rem, 3.5vw, 2rem);
      box-shadow: 0 3px 14px rgba(82, 104, 45, 0.08);
    }

    .whats-new-focus__eyebrow {
      margin: 0 0 0.3rem 0;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #c2614e;
    }

    .whats-new-focus__heading {
      margin: 0 0 0.85rem 0;
      font-size: clamp(1.35rem, 2.6vw, 1.6rem);
      font-weight: 700;
      line-height: 1.2;
      color: var(--kbm-green);
    }

    .whats-new-focus__copy {
      margin: 0 0 0.85rem 0;
      max-width: 52rem;
      font-size: var(--text-base);
      line-height: 1.6;
      color: #3d4a2e;
    }

    .whats-new-focus__points {
      margin: 0 0 1.25rem 0;
      padding-left: 1.2rem;
      max-width: 52rem;
      font-size: var(--text-base);
      line-height: 1.55;
      color: #4a5640;
    }

    .whats-new-focus__points li + li {
      margin-top: 0.35rem;
    }

    .whats-new-focus__cta {
      margin: 0 0 0.75rem 0;
    }

    .whats-new-focus__btn {
      font-size: 1.05rem;
      padding: 0.85rem 1.6rem;
      border-radius: 10px;
    }

    .whats-new-focus__note {
      margin: 0;
      font-size: 0.95rem;
      font-style: italic;
      line-height: 1.5;
      color: #4a5640;
    }

    .whats-new-video {
      box-sizing: border-box;
      background: #ffffff;
      border: 1px solid #e5e5e5;
      border-radius: 12px;
      padding: 1.2rem 1.3rem;
    }

    .whats-new-video__heading {
      margin: 0 0 0.45rem 0;
      font-size: 1.2rem;
      font-weight: 700;
      line-height: 1.25;
      color: var(--kbm-green);
    }

    .whats-new-video__intro {
      margin: 0 0 1rem 0;
      font-size: var(--text-base);
      line-height: 1.55;
      color: #3d4a2e;
    }

    .whats-new-video__embed {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 10px;
      overflow: hidden;
      background: #000;
    }

    .whats-new-video__embed iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .whats-new-features {
      margin-top: 0.25rem;
    }

    .whats-new-features__heading {
      margin: 0 0 1.15rem 0;
      padding-bottom: 6px;
      border-bottom: 2px solid #c2614e;
      font-size: 1.2rem;
      font-weight: 700;
      line-height: 1.25;
      color: var(--kbm-green);
    }

    .whats-new-features__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.1rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .whats-new-feature-card {
      box-sizing: border-box;
      min-width: 0;
      display: flex;
      flex-direction: column;
      background: #ffffff;
      border: 1px solid #e5e5e5;
      border-radius: 12px;
      padding: 1.2rem 1.3rem;
    }

    .whats-new-feature-card__title {
      margin: 0 0 0.45rem 0;
      font-size: 1.05rem;
      font-weight: 700;
      line-height: 1.3;
      color: #2c3820;
    }

    .whats-new-feature-card__lead {
      margin: 0 0 0.6rem 0;
      font-size: var(--text-base);
      line-height: 1.5;
      color: #3d4a2e;
    }

    .whats-new-feature-card__points {
      margin: 0;
      padding-left: 1.1rem;
      font-size: 0.94rem;
      line-height: 1.45;
      color: #4a5640;
    }

    .whats-new-feature-card__points li + li {
      margin-top: 0.28rem;
    }

    .whats-new-more {
      padding-top: 0.35rem;
    }

    .whats-new-more__heading {
      margin: 0 0 1rem 0;
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.3;
      color: rgba(82, 104, 45, 0.88);
      letter-spacing: 0.01em;
    }

    .whats-new-more__items {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      max-width: 42rem;
    }

    .whats-new-more__item + .whats-new-more__item {
      padding-top: 1.25rem;
      border-top: 1px solid rgba(82, 104, 45, 0.1);
    }

    .whats-new-more__item {
      min-width: 0;
    }

    .whats-new-more__title {
      margin: 0 0 0.35rem 0;
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.35;
      color: #2c3820;
    }

    .whats-new-more__copy {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.55;
      color: #4a5640;
    }

    .whats-new-beginning-callout {
      box-sizing: border-box;
      width: 100%;
      margin: clamp(2rem, 4vw, 2.75rem) 0 clamp(1.75rem, 3vw, 2.5rem);
      padding: clamp(1.5rem, 3vw, 2rem) clamp(1.5rem, 3.5vw, 2.25rem);
      background: linear-gradient(165deg, #fffef9 0%, #f5f2ea 100%);
      border: 1px solid rgba(82, 104, 45, 0.14);
      border-radius: 14px;
      box-shadow: 0 2px 10px rgba(82, 104, 45, 0.06);
    }

    .whats-new-beginning-callout__title {
      margin: 0 0 0.75rem 0;
      font-size: clamp(1.15rem, 2.2vw, 1.35rem);
      font-weight: 700;
      line-height: 1.25;
      color: var(--kbm-green);
    }

    .whats-new-beginning-callout__copy {
      margin: 0;
      max-width: 52rem;
      font-size: var(--text-base);
      line-height: 1.6;
      color: #3d4a2e;
    }

    .whats-new-bottom-cta {
      display: flex;
      justify-content: flex-start;
      margin-top: 1.35rem;
    }

    .whats-new-divider {
      margin: 0 0 clamp(1.75rem, 3vw, 2.5rem);
      border: 0;
      border-top: 1px solid #e5e5e5;
    }

    @media (max-width: 768px) {
      .whats-new-features__grid {
        grid-template-columns: 1fr;
      }

      .whats-new-hero-cta__btn,
      .whats-new-bottom-cta__btn {
        width: 100%;
      }

      .whats-new-bottom-cta {
        justify-content: stretch;
      }

      .whats-new-focus__btn {
        display: block;
        width: 100%;
        text-align: center;
      }
    }

    @media (max-width: 768px) {
      .whats-new-top {
        flex-direction: column;
        flex-wrap: nowrap;
        align-items: stretch;
        gap: 1.75rem;
        margin-bottom: 1.75rem;
      }

      .whats-new-top__lead,
      .whats-new-top .whats-new-footer {
        flex: 1 1 auto;
        min-width: 0;
        width: 100%;
        align-self: stretch;
      }
    }

    .whats-new-box {
      box-sizing: border-box;
      min-width: 0;
      min-height: 100%;
      display: flex;
      flex-direction: column;
      background: #ffffff;
      border: 1px solid #e5e5e5;
      border-radius: 12px;
      padding: 24px;
    }

    .whats-new-box--coming {
      background: #f8f8f6;
      border: 1px solid #ece9e2;
    }

    .whats-new-box h2,
    .whats-new-box__title {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      margin: 0 0 16px 0;
      padding-bottom: 6px;
      border-bottom: 2px solid #c2614e;
      font-size: 1.2rem;
      font-weight: 700;
      line-height: 1.25;
      color: var(--kbm-green);
    }

    .whats-new-box__title .nav-pill-new {
      margin-right: 0;
      flex-shrink: 0;
      align-self: center;
    }

    .whats-new-box--coming .whats-new-box__title {
      color: rgba(82, 104, 45, 0.88);
      border-bottom-color: rgba(194, 97, 78, 0.55);
    }

    .whats-new-box--coming .whats-new-item__title {
      color: #3a4530;
    }

    .whats-new-box--coming .whats-new-item__desc {
      color: #4a5640;
    }

    .whats-new-box--coming .whats-new-item__glyph {
      color: rgba(82, 104, 45, 0.38);
    }

    .whats-new-items {
      list-style: none;
      margin: 0;
      padding: 0;
      flex: 1;
    }

    .whats-new-box li {
      margin-bottom: 12px;
    }

    .whats-new-box li:last-child {
      margin-bottom: 0;
    }

    .whats-new-login-note {
      margin: 0.9rem 0 0;
      font-size: 0.95rem;
      line-height: 1.5;
      color: #4a5640;
    }

    .whats-new-item {
      display: flex;
      gap: 0.5rem;
      align-items: flex-start;
    }

    .whats-new-item__glyph {
      flex-shrink: 0;
      font-size: 0.75rem;
      line-height: 1.6;
      color: rgba(82, 104, 45, 0.45);
      padding-top: 0.2em;
    }

    .whats-new-item__body {
      min-width: 0;
    }

    .whats-new-item__title {
      margin: 0 0 0.35rem 0;
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.3;
      color: #2c3820;
    }

    .whats-new-item__title--pattern {
      font-size: 1.1rem;
      font-weight: 700;
    }

    .whats-new-item__title--pattern a {
      color: inherit;
    }

    .whats-new-item__desc {
      margin: 0;
      font-size: var(--text-base);
      line-height: 1.55;
      color: #3d4a2e;
    }

    .whats-new-item__links {
      margin: 0.5rem 0 0;
      font-size: 0.95rem;
      line-height: 1.45;
    }

    .whats-new-item__links a {
      color: var(--kbm-green);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .whats-new-item__links a:hover,
    .whats-new-item__links a:focus-visible {
      color: #3d5a24;
    }

    .whats-new-item__links a:focus-visible {
      outline: 2px solid var(--kbm-green);
      outline-offset: 2px;
      border-radius: 2px;
    }

    .whats-new-item__link {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      vertical-align: middle;
    }

    .whats-new-item__link-icon {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .whats-new-item__link-icon--fa {
      font-size: 1.125rem;
      line-height: 1;
    }

    @media (max-width: 480px) {
      .whats-new-item__links-sep {
        display: none;
      }

      .whats-new-item__links a {
        display: block;
      }

      .whats-new-item__links a + a {
        margin-top: 0.25rem;
      }
    }

    .whats-new-footer {
