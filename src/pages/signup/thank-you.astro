---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";

const pageTitle = "Welcome to Knit It Now!";
const description = "Your free Knit It Now account has been created. Start learning, explore tools, browse patterns, or see what membership includes.";

const suePhoto = "/images/knit-by-machine-sue1.png";
const suePhotoAlt = "Sue from Knit It Now at a knitting machine";

const nextSteps = [
  {
    title: "I'm New to Machine Knitting",
    text: "Learn the basics, choose the right machine, and build confidence one step at a time.",
    button: "Start Here",
    href: "/new-to-machine-knitting",
    image: "/images/home/new-to-MK.webp",
    alt: "Blue knitted sweater for someone new to machine knitting",
  },
  {
    title: "I Want to Make Something",
    text: "Explore beginner-friendly projects, patterns, and builders to start knitting.",
    button: "Find a Project",
    // TODO: replace "#" with the final "make something / projects" destination once decided.
    href: "#",
    image: "/images/home/returning.webp",
    alt: "Coral knitted sweater representing making your first project",
  },
  {
    title: "I Want Patterns That Fit",
    text: "Create custom patterns using your measurements, gauge, and machine.",
    button: "Explore Pattern Builders",
    // TODO: replace "#" with the final Pattern Builders destination once decided.
    href: "#",
    image: "/images/home/patterns-that-fit.webp",
    alt: "Green knitted sweater representing custom patterns that fit",
  },
  {
    title: "I Need Help Solving a Problem",
    text: "Find answers with tutorials, the glossary, reference library, and knitting tools.",
    button: "Get Help",
    // TODO: replace "#" with the final help/troubleshooting destination once decided.
    href: "#",
    image: "/images/home/stuck.webp",
    alt: "Tan knitted sweater for when you need help solving a problem",
  },
];
---

<Layout
  title={`${pageTitle} | Knit it Now`}
  {description}
  bodyClass="page--tight-header"
>
  <article class="signup-thank-you page-wrap" aria-labelledby="signup-thank-you-heading">
    <section class="signup-thank-you__hero">
      <div class="signup-thank-you__hero-text">
        <h1 id="signup-thank-you-heading">{pageTitle}</h1>
        <p class="signup-thank-you__subhead">Thank you for trusting us with your email.</p>
        <p class="signup-thank-you__intro">Hi, I'm Sue. I'm so glad you're here.</p>
        <p class="signup-thank-you__intro">
          Knit It Now is here to help you build your machine knitting skills, find practical
          answers, and spend more time knitting with confidence.
        </p>
        <p class="signup-thank-you__intro">When you're ready, choose where you'd like to start.</p>
      </div>
      <div class="signup-thank-you__hero-photo">
        <img src={suePhoto} alt={suePhotoAlt} width="420" height="465" loading="eager" />
      </div>
    </section>

    <section class="signup-thank-you__next" aria-labelledby="signup-thank-you-next-heading">
      <h2 id="signup-thank-you-next-heading">Let's get you headed in the right direction.</h2>
      <div class="signup-thank-you__grid">
        {
          nextSteps.map((step) => (
            <a class="signup-thank-you__card" href={step.href}>
              <div class="signup-thank-you__media">
                <img
                  src={step.image}
                  alt={step.alt}
                  class="signup-thank-you__img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <span class="signup-thank-you__btn">{step.button}</span>
            </a>
          ))
        }
      </div>
    </section>

    <p class="signup-thank-you__note">
      You can always return to the page you came from using your browser back button.
    </p>
  </article>
</Layout>

<style>
  .signup-thank-you.page-wrap {
    padding-top: 0.5rem;
    padding-bottom: 3rem;
    max-width: 64rem;
  }

  .signup-thank-you__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 3rem;
  }

  .signup-thank-you__hero-photo {
    display: flex;
    justify-content: center;
  }

  .signup-thank-you__hero-photo img {
    width: 100%;
    max-width: 320px;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 12px 30px rgba(82, 104, 45, 0.18);
    display: block;
  }

  /* On very small phones the confirmation and next steps matter more than the photo */
  @media (max-width: 479px) {
    .signup-thank-you__hero-photo {
      display: none;
    }
  }

  .signup-thank-you h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.15rem);
    line-height: 1.25;
    color: var(--kbm-green, #52682d);
  }

  .signup-thank-you__subhead {
    margin: 0 0 1.25rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--kbm-green, #52682d);
  }

  .signup-thank-you__intro {
    margin: 0 0 0.85rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: #374151;
  }

  .signup-thank-you__intro:last-child {
    margin-bottom: 0;
  }

  .signup-thank-you__next {
    margin-top: 2rem;
  }

  .signup-thank-you__next h2 {
    margin: 0 0 1.25rem;
    text-align: center;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    line-height: 1.3;
    color: var(--kbm-green, #52682d);
  }

  .signup-thank-you__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    margin-bottom: 40px;
  }

  /* Card style reused from getting-started.astro (sweater image cards) */
  .signup-thank-you__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    background: #fff;
    border: 1px solid rgba(82, 104, 45, 0.12);
    border-radius: 0.85rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .signup-thank-you__card:hover {
    transform: translateY(-3px);
    border-color: rgba(82, 104, 45, 0.35);
    box-shadow: 0 8px 20px rgba(82, 104, 45, 0.1);
  }

  .signup-thank-you__media {
    height: 195px;
    overflow: hidden;
    border-radius: 14px 14px 0 0;
    background: #fff;
  }

  .signup-thank-you__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .signup-thank-you__card h3 {
    margin: 0;
    padding: 1.1rem 1.1rem 0.4rem;
    font-size: 1.02rem;
    line-height: 1.35;
    color: #2c3a57;
  }

  .signup-thank-you__card p {
    margin: 0;
    padding: 0 1.1rem 1rem;
    flex: 1;
    font-size: 0.92rem;
    line-height: 1.55;
    color: #4d5a48;
  }

  .signup-thank-you__btn {
    display: block;
    margin: 0 1.1rem 1.35rem;
    padding: 10px 18px;
    text-align: center;
    background-color: var(--kbm-green);
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 8px;
    transition: background-color 0.2s ease;
  }

  .signup-thank-you__card:hover .signup-thank-you__btn,
  .signup-thank-you__card:focus-visible .signup-thank-you__btn {
    background-color: var(--kbm-green-hover);
  }

  @media (min-width: 640px) {
    .signup-thank-you__hero {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
      gap: 2.5rem;
    }

    .signup-thank-you__hero-photo {
      justify-content: flex-end;
    }

    .signup-thank-you__hero-photo img {
      min-width: 280px;
      max-width: 340px;
    }

    .signup-thank-you__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .signup-thank-you__note {
    margin: 0 auto;
    max-width: 40rem;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #6b7280;
  }
</style>
