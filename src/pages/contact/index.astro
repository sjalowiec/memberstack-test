---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Contact | Knit it Now" bodyClass="page--tight-header">
  <main class="container" style="max-width:720px;margin:0 auto 60px;">
    <h1>Contact</h1>
    <p>Send me a message and I’ll reply within 1–2 business days.</p>

    <form
      id="contact-page-form"
      name="contact"
      method="POST"
      action="/.netlify/functions/contact"
      enctype="multipart/form-data"
      netlify-honeypot="bot-field"
      class="contact-form"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p style="display:none;">
        <label>Don't fill this out: <input name="bot-field" /></label>
      </p>
      <input type="hidden" name="form_source" value="contact_page" />
      <input type="hidden" name="page_url" id="contactPageURL" />
      <input type="hidden" name="submitted_at" id="contactSubmittedAt" />

      <label class="contact-form__field">
        <span>Name *</span>
        <input type="text" name="name" required />
      </label>

      <label class="contact-form__field">
        <span>Email *</span>
        <input type="email" name="email" required />
      </label>

      <label class="contact-form__field">
        <span>Message *</span>
        <textarea name="message" rows="6" required></textarea>
      </label>

      <div class="contact-form__field">
        <span>Add a photo of your knitting or machine (optional)</span>
        <p class="contact-form__hint">A photo can help us see what’s happening.</p>
        <input
          type="file"
          name="images"
          id="contactImages"
          accept="image/jpeg,image/png,image/webp"
          class="contact-form__file"
        />
        <p class="contact-form__note">JPG, PNG, or WEBP • max 5MB</p>
        <p id="contact-image-error" class="contact-form__error" hidden role="alert"></p>
        <p id="contact-submit-error" class="contact-form__error" hidden role="alert"></p>
      </div>

      <button type="submit" class="contact-form__submit" id="contact-page-submit">Send message</button>
    </form>
  </main>

  <style>
    .contact-form__hint {
      margin: 0 0 0.5rem;
      font-size: 0.95rem;
      color: #4b5563;
      line-height: 1.45;
    }

    .contact-form__note {
      margin: 0.35rem 0 0;
      font-size: 0.85rem;
      color: #6b7280;
    }

    .contact-form__file {
      padding: 0.5rem 0;
      font-size: 0.95rem;
      font-family: var(--font);
    }

    .contact-form__error {
      margin: 0.5rem 0 0;
      font-size: 0.9rem;
      color: #b91c1c;
    }

    .contact-form__error[hidden] {
      display: none;
    }
  </style>

  <script>
    import { wireContactFormSubmit } from "../../scripts/contactFormSubmit";

    const form = document.getElementById("contact-page-form");
    if (form instanceof HTMLFormElement) {
      wireContactFormSubmit({
        form,
        fileInput: document.getElementById("contactImages") as HTMLInputElement | null,
        submitBtn: document.getElementById("contact-page-submit") as HTMLButtonElement | null,
        submitErrorEl: document.getElementById("contact-submit-error"),
        imageErrorEl: document.getElementById("contact-image-error"),
        pageUrlInput: document.getElementById("contactPageURL") as HTMLInputElement | null,
        submittedAtInput: document.getElementById("contactSubmittedAt") as HTMLInputElement | null,
      });
    }
  </script>
</Layout>