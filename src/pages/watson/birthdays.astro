---
import WatsonPageShell from "../../components/watson/WatsonPageShell.astro";
import {
  getBirthdayCardsStore,
  listBirthdayCardStatusesForYear,
  type BirthdayCardStatusRecord,
} from "../../lib/watson/birthdayCardsStore";
import { getBirthdayMemberSource, type BirthdayMember } from "../../lib/watson/birthdayMemberSource";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");

const now = new Date();
const initialYear = now.getFullYear();
const initialMonth = now.getMonth() + 1;

let members: BirthdayMember[] = [];
let initialStatuses: BirthdayCardStatusRecord[] = [];
let membersError: string | null = null;
let statusesError: string | null = null;

try {
  members = await getBirthdayMemberSource().listActiveMembersWithBirthdays();
} catch (error) {
  membersError =
    error instanceof Error ? error.message : "Unable to load birthday members.";
}

try {
  const store = getBirthdayCardsStore();
  initialStatuses = await listBirthdayCardStatusesForYear(store, initialYear);
} catch (error) {
  statusesError =
    error instanceof Error ? error.message : "Unable to load card statuses.";
}

const pageError = membersError || statusesError;
---

<WatsonPageShell
  title="Member Birthdays | Watson"
  description="Track handwritten birthday cards for active members."
  heading="Member Birthdays"
  intro="Active members only"
>
  <div
    class="watson-bday"
    data-birthdays-page
    data-initial-year={initialYear}
    data-initial-month={initialMonth}
    data-members-json={JSON.stringify(members)}
    data-initial-statuses-json={JSON.stringify(initialStatuses)}
    data-members-error={pageError || undefined}
  >
    <div class="watson-bday__toolbar">
      <div class="watson-bday__nav">
        <button type="button" class="watson__button watson__button--secondary" data-bday-prev aria-label="Previous month">
          Previous
        </button>
        <button type="button" class="watson__button watson__button--secondary" data-bday-today aria-label="Go to current month">
          Today
        </button>
        <button type="button" class="watson__button watson__button--secondary" data-bday-next aria-label="Next month">
          Next
        </button>
      </div>
      <h2 class="watson-bday__month-label" data-bday-month-label aria-live="polite">
        Loading...
      </h2>
    </div>

    <p class="watson-bday__loading" data-bday-loading hidden></p>
    <p class="watson__status watson__status--error watson-bday__error" data-bday-error hidden></p>

    <div
      class="watson-bday__grid"
      data-bday-grid
      role="grid"
      aria-label="Member birthdays calendar"
    >
      <p class="watson-bday__loading-inline">Loading calendar...</p>
    </div>

    <p class="watson-bday__legend">
      <span class="watson-bday__legend-item">
        <span class="watson-bday__legend-swatch" aria-hidden="true"></span>
        Needs card
      </span>
      <span class="watson-bday__legend-item">
        <span class="watson-bday__legend-swatch watson-bday__legend-swatch--sent" aria-hidden="true"></span>
        Sent
      </span>
    </p>

    <dialog class="watson-bday__dialog" data-bday-dialog aria-labelledby="bday-dialog-title">
      <div class="watson-bday__dialog-form">
        <div class="watson-bday__dialog-head">
          <h3 id="bday-dialog-title" class="watson__panel-title" data-bday-dialog-name>Member</h3>
          <button
            type="button"
            class="watson__button watson__button--secondary"
            data-bday-dialog-close
            aria-label="Close birthday details"
          >
            Close
          </button>
        </div>

        <p class="watson-bday__missing" data-bday-missing-member hidden>
          This birthday is listed, but the member record could not be opened from the current data.
          Use customer search to find them.
        </p>

        <dl class="watson-bday__details">
          <div data-bday-field>
            <dt>Birthday</dt>
            <dd data-bday-dialog-birthday></dd>
          </div>
          <div data-bday-field>
            <dt>Member since</dt>
            <dd data-bday-dialog-since></dd>
          </div>
          <div data-bday-field>
            <dt>Plan</dt>
            <dd data-bday-dialog-plan></dd>
          </div>
          <div>
            <dt>Mailing address</dt>
            <dd class="watson-bday__address" data-bday-dialog-address></dd>
          </div>
          <div data-bday-field>
            <dt>Country</dt>
            <dd data-bday-dialog-country></dd>
          </div>
        </dl>

        <p class="watson-bday__warning" data-bday-no-address hidden>
          No mailing address on file - cannot mail a handwritten card until an address is added.
        </p>

        <div class="watson-bday__links">
          <a class="watson__button" data-bday-profile-link href="/watson/customers">Open Member Record</a>
          <a class="watson__button watson__button--secondary" data-bday-notes-link href="#">View Notes</a>
        </div>

        <label class="watson-bday__sent">
          <input type="checkbox" data-bday-card-sent aria-label="Card sent for this birthday year" />
          <span>Card sent</span>
        </label>
        <p class="watson-bday__mailed" data-bday-mailed-row hidden>
          <span data-bday-mailed-date></span>
        </p>
        <p class="watson__status" data-bday-dialog-status hidden></p>
      </div>
    </dialog>
  </div>
</WatsonPageShell>

<script>
  import { initWatsonBirthdays } from "../../scripts/watsonBirthdays";
  initWatsonBirthdays();
</script>

<style is:global>
  .watson:has(.watson-bday) {
    max-width: 1280px;
  }

  .watson-bday .watson__button--secondary {
    color: #243015;
    background: #fff;
    border: 1px solid #cbd5e1;
  }

  .watson-bday .watson__button--secondary:hover {
    background: #f8fafc;
    border-color: #3f6212;
    color: #3f6212;
  }

  .watson-bday a.watson__button {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .watson-bday__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: 1.25rem;
  }

  .watson-bday__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .watson-bday__month-label {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 700;
    color: #243015;
    min-width: 10rem;
    text-align: right;
  }

  .watson-bday__loading,
  .watson-bday__loading-inline {
    margin: 0 0 0.75rem;
    color: #64748b;
  }

  .watson-bday__error {
    margin-bottom: 0.75rem;
  }

  .watson-bday__grid {
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #fff;
    overflow: hidden;
    min-height: 28rem;
  }

  .watson-bday__weekdays,
  .watson-bday__week {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .watson-bday__weekday {
    padding: 0.75rem 0.5rem;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    color: #475569;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .watson-bday__day {
    min-height: 7.5rem;
    padding: 0.55rem 0.45rem 0.65rem;
    border-right: 1px solid #eef2f7;
    border-bottom: 1px solid #eef2f7;
    background: #fff;
  }

  .watson-bday__week .watson-bday__day:nth-child(7n) {
    border-right: 0;
  }

  .watson-bday__day--outside {
    background: #f8fafc;
    color: #94a3b8;
  }

  .watson-bday__day--today {
    background: #f7fee7;
    box-shadow: inset 0 0 0 2px #3f6212;
  }

  .watson-bday__daynum {
    font-size: 0.95rem;
    font-weight: 700;
    color: #243015;
    margin-bottom: 0.4rem;
    padding-left: 0.15rem;
  }

  .watson-bday__day--outside .watson-bday__daynum {
    color: #94a3b8;
  }

  .watson-bday__entries {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .watson-bday__entry {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    width: 100%;
    margin: 0;
    padding: 0.4rem 0.45rem;
    border: 1px solid #d6d3d1;
    border-radius: 8px;
    background: #fafaf9;
    color: #243015;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .watson-bday__entry:hover,
  .watson-bday__entry:focus-visible {
    outline: 2px solid #3f6212;
    outline-offset: 1px;
    border-color: #3f6212;
  }

  .watson-bday__entry-name {
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1.25;
    word-break: break-word;
  }

  .watson-bday__entry-status {
    font-size: 0.75rem;
    font-weight: 600;
    color: #78716c;
  }

  .watson-bday__entry--sent {
    background: #dcfce7;
    border-color: #86efac;
    color: #166534;
  }

  .watson-bday__entry--sent .watson-bday__entry-status {
    color: #166534;
  }

  .watson-bday__empty {
    margin: 0;
    padding: 1.25rem 1rem 1.5rem;
    text-align: center;
    color: #64748b;
    border-top: 1px solid #eef2f7;
  }

  .watson-bday__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin: 1rem 0 0;
    color: #475569;
    font-size: 0.9rem;
  }

  .watson-bday__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .watson-bday__legend-swatch {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 4px;
    border: 1px solid #d6d3d1;
    background: #fafaf9;
  }

  .watson-bday__legend-swatch--sent {
    background: #dcfce7;
    border-color: #86efac;
  }

  .watson-bday__dialog {
    width: min(28rem, calc(100vw - 2rem));
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0;
    color: #243015;
  }

  .watson-bday__dialog::backdrop {
    background: rgba(15, 23, 42, 0.35);
  }

  .watson-bday__dialog-form {
    padding: 1.15rem 1.2rem 1.25rem;
  }

  .watson-bday__dialog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .watson-bday__dialog-head .watson__panel-title {
    margin: 0;
  }

  .watson-bday__details {
    margin: 0 0 1rem;
  }

  .watson-bday__details > div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.35rem 0.75rem;
    margin-bottom: 0.55rem;
  }

  .watson-bday__details dt {
    margin: 0;
    color: #64748b;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .watson-bday__details dd {
    margin: 0;
    white-space: pre-line;
  }

  .watson-bday__warning {
    margin: 0 0 1rem;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    background: #ffedd5;
    color: #9a3412;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .watson-bday__missing {
    margin: 0 0 1rem;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    background: #fee2e2;
    color: #b91c1c;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .watson-bday__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .watson-bday__sent {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 650;
    cursor: pointer;
  }

  .watson-bday__sent input {
    width: 1.15rem;
    height: 1.15rem;
  }

  .watson-bday__mailed {
    margin: 0.45rem 0 0;
    color: #166534;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .watson-bday__dialog .watson__status {
    margin-top: 0.75rem;
  }

  .watson-bday__dialog .watson__status[data-error="true"] {
    color: #b91c1c;
  }

  @media (max-width: 800px) {
    .watson-bday__month-label {
      text-align: left;
      width: 100%;
    }

    .watson-bday__day {
      min-height: 5.5rem;
      padding: 0.35rem 0.25rem 0.45rem;
    }

    .watson-bday__entry-name {
      font-size: 0.78rem;
    }

    .watson-bday__entry-status {
      font-size: 0.68rem;
    }

    .watson-bday__weekday {
      font-size: 0.75rem;
      padding: 0.55rem 0.2rem;
    }

    .watson-bday__details > div {
      grid-template-columns: 1fr;
    }
  }
</style>
