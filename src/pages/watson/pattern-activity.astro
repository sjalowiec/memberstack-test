---
import WatsonPageShell from "../../components/watson/WatsonPageShell.astro";
import { isKinDevNetlifySite } from "../../../netlify/functions/lib/pattern-activity-store.js";
import { PATTERN_ACTIVITY_LOADING_MESSAGE } from "../../lib/patterns/patternActivityReport";

export const prerender = false;

/** Kin-dev can read its own blob store. Production is a cross-site read and stays opt-in. */
const defaultEnvironment = isKinDevNetlifySite() ? "dev" : "production";
const defaultSource =
  defaultEnvironment === "dev" ? "DEV — kin-dev" : "Production — live site";
---

<WatsonPageShell
  title="Pattern Activity | Watson"
  description="Read-only pattern generation and save activity for Production or DEV."
  heading="Pattern Activity"
  intro="Who generated and saved patterns. Production is the live member site. This page only reads events."
>
  <section class="watson__panel" aria-labelledby="pattern-activity-filters-heading">
    <h2 id="pattern-activity-filters-heading" class="watson__panel-title">Filters</h2>
    <div class="pa-filters">
      <label>
        Environment
        <select data-pa-environment>
          <option value="production" selected={defaultEnvironment === "production"}>Production — live site</option>
          <option value="dev" selected={defaultEnvironment === "dev"}>DEV — kin-dev</option>
        </select>
      </label>
      <label>
        Date
        <select data-pa-date>
          <option value="week">This week</option>
          <option value="today">Today</option>
          <option value="month">This month</option>
          <option value="all" selected>All stored events</option>
          <option value="custom">Custom range</option>
        </select>
      </label>
      <label data-pa-custom hidden>
        From
        <input type="date" data-pa-from />
      </label>
      <label data-pa-custom hidden>
        To
        <input type="date" data-pa-to />
      </label>
      <label>
        Pattern
        <select data-pa-system>
          <option value="">All patterns</option>
        </select>
      </label>
      <label class="pa-check">
        <input type="checkbox" data-pa-exclude-sue />
        Exclude Sue’s account from member totals
      </label>
      <button type="button" class="watson__button" data-pa-apply>Show activity</button>
    </div>
    <p class="pa-source" data-pa-source>Source: {defaultSource}</p>
    <p class="pa-status" data-pa-status data-pa-state="loading" role="status" aria-live="polite">
      {PATTERN_ACTIVITY_LOADING_MESSAGE}
    </p>
  </section>

  <section class="watson__panel" aria-labelledby="pattern-activity-totals-heading">
    <h2 id="pattern-activity-totals-heading" class="watson__panel-title">Totals</h2>
    <dl class="pa-stats">
      <div><dt>People who generated or saved</dt><dd data-pa-people>—</dd></div>
      <div><dt>Total generations</dt><dd data-pa-generated>—</dd></div>
      <div><dt>Distinct saved projects</dt><dd data-pa-saved>—</dd></div>
      <div><dt>Opens</dt><dd data-pa-opens>—</dd></div>
      <div><dt>Edits</dt><dd data-pa-edits>—</dd></div>
      <div><dt>Prints</dt><dd data-pa-prints>—</dd></div>
    </dl>
  </section>

  <section class="watson__panel" aria-labelledby="pattern-activity-people-heading">
    <h2 id="pattern-activity-people-heading" class="watson__panel-title">Members</h2>
    <div data-pa-people-list></div>
  </section>

  <section class="watson__panel" aria-labelledby="pattern-activity-anon-heading">
    <h2 id="pattern-activity-anon-heading" class="watson__panel-title">Anonymous visitors</h2>
    <p>Visitors without a member account. A captured email is shown when the event stored one. Guest ids are not shown as names.</p>
    <div data-pa-anon-list></div>
  </section>
</WatsonPageShell>

<script>
  import type { PatternActivityEvent } from "../../lib/patterns/patternActivityLog";
  import {
    patternActivityEventLabel,
    patternActivitySystemLabel,
    patternActivitySystemFilterOptions,
    dateRangeForPreset,
    patternActivityErrorMessage,
    patternActivityReadyMessage,
    PATTERN_ACTIVITY_ERROR_LIST_MESSAGE,
    PATTERN_ACTIVITY_LOADING_MESSAGE,
    type PatternActivityDatePreset,
    type PatternActivityLoadState,
  } from "../../lib/patterns/patternActivityReport";
  import { buildPatternActivityUsage, type PatternActivityPersonUsage } from "../../lib/patterns/patternActivityUsage";

  const statusEl = document.querySelector("[data-pa-status]");
  const sourceEl = document.querySelector("[data-pa-source]");

  function setStatus(message: string, state: PatternActivityLoadState): void {
    if (!(statusEl instanceof HTMLElement)) return;
    statusEl.textContent = message;
    statusEl.dataset.paState = state;
  }

  function selected(selector: string): string {
    const el = document.querySelector(selector);
    return el instanceof HTMLSelectElement || el instanceof HTMLInputElement ? el.value : "";
  }

  function environmentLabel(value: string): string {
    return value === "dev" ? "DEV — kin-dev" : "Production — live site";
  }

  function renderNotice(host: Element | null, message: string): void {
    if (!host) return;
    host.replaceChildren();
    const note = document.createElement("p");
    note.textContent = message;
    host.appendChild(note);
  }

  function renderPeople(host: Element | null, people: PatternActivityPersonUsage[]): void {
    if (!host) return;
    host.replaceChildren();
    if (people.length === 0) {
      renderNotice(host, "None in this filter.");
      return;
    }
    for (const person of people) {
      const article = document.createElement("article");
      article.className = "pa-person";
      const heading = document.createElement("h3");
      heading.textContent = person.label;
      article.appendChild(heading);
      const meta = document.createElement("p");
      const bits = [
        person.memberId ? `Member ID ${person.memberId}` : "",
        person.patterns.length ? `Patterns: ${person.patterns.join(", ")}` : "",
      ].filter(Boolean);
      meta.textContent = bits.join(" · ");
      article.appendChild(meta);
      const list = document.createElement("ul");
      for (const action of person.actions) {
        const item = document.createElement("li");
        const when = new Date(action.createdAt);
        const stamp = Number.isNaN(when.getTime()) ? action.createdAt : when.toLocaleString();
        item.textContent = `${stamp} — ${patternActivityEventLabel(action.eventType)} — ${patternActivitySystemLabel(action.patternSystem)} — ${action.patternTitle || action.patternId || "Pattern"}`;
        list.appendChild(item);
      }
      article.appendChild(list);
      host.appendChild(article);
    }
  }

  async function loadActivity(): Promise<void> {
    const environment = selected("[data-pa-environment]") === "dev" ? "dev" : "production";
    if (sourceEl) sourceEl.textContent = `Source: ${environmentLabel(environment)}`;
    document.querySelectorAll("[data-pa-custom]").forEach((el) => {
      if (el instanceof HTMLElement) el.hidden = selected("[data-pa-date]") !== "custom";
    });
    setStatus(PATTERN_ACTIVITY_LOADING_MESSAGE, "loading");
    clearTotals();
    document.querySelector("[data-pa-people-list]")?.replaceChildren();
    document.querySelector("[data-pa-anon-list]")?.replaceChildren();
    const preset = (selected("[data-pa-date]") || "all") as PatternActivityDatePreset;
    const range = dateRangeForPreset(preset, new Date(), {
      from: selected("[data-pa-from]"),
      to: selected("[data-pa-to]"),
    });
    const params = new URLSearchParams({ environment });
    if (range.fromIso) params.set("from", range.fromIso);
    if (range.toIso) params.set("to", range.toIso);
    let data: { ok?: boolean; events?: PatternActivityEvent[]; error?: string };
    try {
      const res = await fetch(`/api/watson/pattern-activity?${params}`, {
        credentials: "same-origin",
        headers: { Accept: "application/json" },
      });
      const text = await res.text();
      try {
        data = JSON.parse(text) as { ok?: boolean; events?: PatternActivityEvent[]; error?: string };
      } catch {
        showLoadError(
          res.ok
            ? "Pattern activity returned a page instead of data."
            : `Pattern activity failed (${res.status}). The report did not finish.`,
        );
        return;
      }
      if (!res.ok || !data.ok || !Array.isArray(data.events)) {
        showLoadError(data.error || `Could not load pattern activity (${res.status}).`);
        return;
      }
    } catch {
      showLoadError("Could not load pattern activity. The request did not finish.");
      return;
    }
    const system = selected("[data-pa-system]");
    const options = patternActivitySystemFilterOptions(data.events);
    const select = document.querySelector("[data-pa-system]");
    if (select instanceof HTMLSelectElement && select.options.length <= 1) {
      for (const option of options) {
        const node = document.createElement("option");
        node.value = option.value;
        node.textContent = option.label;
        select.appendChild(node);
      }
      if ([...select.options].some((option) => option.value === system)) select.value = system;
    }
    const report = buildPatternActivityUsage(data.events, {
      datePreset: "all",
      patternSystem: selected("[data-pa-system]"),
      excludeSue: document.querySelector<HTMLInputElement>("[data-pa-exclude-sue]")?.checked === true,
    });
    const set = (selector: string, value: number) => {
      const el = document.querySelector(selector);
      if (el) el.textContent = String(value);
    };
    set("[data-pa-people]", report.peopleWhoGeneratedOrSaved);
    set("[data-pa-generated]", report.totalGenerations);
    set("[data-pa-saved]", report.distinctSavedProjects);
    set("[data-pa-opens]", report.opens);
    set("[data-pa-edits]", report.edits);
    set("[data-pa-prints]", report.prints);
    renderPeople(document.querySelector("[data-pa-people-list]"), report.people);
    renderPeople(document.querySelector("[data-pa-anon-list]"), report.anonymous);
    const loaded = data.events.length;
    const filteredOut = loaded > 0 && report.people.length === 0 && report.anonymous.length === 0;
    setStatus(
      patternActivityReadyMessage(filteredOut ? 0 : loaded, environmentLabel(environment)),
      loaded === 0 || filteredOut ? "empty" : "ready",
    );
  }

  function clearTotals(): void {
    for (const selector of [
      "[data-pa-people]",
      "[data-pa-generated]",
      "[data-pa-saved]",
      "[data-pa-opens]",
      "[data-pa-edits]",
      "[data-pa-prints]",
    ]) {
      const el = document.querySelector(selector);
      if (el) el.textContent = "—";
    }
  }

  function showLoadError(detail: string): void {
    clearTotals();
    setStatus(patternActivityErrorMessage(detail), "error");
    renderNotice(document.querySelector("[data-pa-people-list]"), PATTERN_ACTIVITY_ERROR_LIST_MESSAGE);
    renderNotice(document.querySelector("[data-pa-anon-list]"), PATTERN_ACTIVITY_ERROR_LIST_MESSAGE);
  }

  document.querySelector("[data-pa-apply]")?.addEventListener("click", () => {
    void loadActivity();
  });
  document.querySelector("[data-pa-date]")?.addEventListener("change", () => {
    document.querySelectorAll("[data-pa-custom]").forEach((el) => {
      if (el instanceof HTMLElement) el.hidden = selected("[data-pa-date]") !== "custom";
    });
  });
  document.querySelector("[data-pa-environment]")?.addEventListener("change", () => {
    if (sourceEl) sourceEl.textContent = `Source: ${environmentLabel(selected("[data-pa-environment]"))}`;
  });
  void loadActivity();
</script>

<style>
  .pa-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: end;
  }
  .pa-filters label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
  }
  .pa-check {
    flex-direction: row !important;
    align-items: center;
    gap: 0.4rem;
  }
  .pa-source {
    font-weight: 700;
  }
  .pa-status[data-pa-state="error"] {
    color: #9f1239;
    font-weight: 700;
  }
  .pa-status[data-pa-state="empty"] {
    font-weight: 700;
  }
  .pa-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
  }
  .pa-stats div {
    margin: 0;
  }
  .pa-stats dd {
    margin: 0.15rem 0 0;
    font-size: 1.4rem;
    font-weight: 700;
  }
  .pa-person {
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e5e7eb;
  }
  .pa-person h3 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
  }
  .pa-person ul {
    margin: 0.35rem 0 0;
    padding-left: 1.1rem;
  }
</style>
