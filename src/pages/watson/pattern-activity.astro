---
import WatsonPageShell from "../../components/watson/WatsonPageShell.astro";
import { isKinDevNetlifySite } from "../../../netlify/functions/lib/pattern-activity-store.js";
import { PATTERN_ACTIVITY_LOADING_MESSAGE } from "../../lib/patterns/patternActivityReport";

export const prerender = false;

/** Kin-dev can read its own blob store. Production is a cross-site read and stays opt-in. */
const defaultEnvironment = isKinDevNetlifySite() ? "dev" : "production";
const defaultSource =
  defaultEnvironment === "dev" ? "DEV — kin-dev" : "Production — live site";
---

<WatsonPageShell
  title="Pattern Activity | Watson"
  description="How many people built each pattern on Production or DEV."
  heading="Pattern Activity"
  intro="How many people built each pattern in the selected date range. Production is the live site. This page only reads events."
>
  <section class="watson__panel" aria-labelledby="pattern-activity-filters-heading">
    <h2 id="pattern-activity-filters-heading" class="watson__panel-title">Filters</h2>
    <div class="pa-filters">
      <label>
        Environment
        <select data-pa-environment>
          <option value="production" selected={defaultEnvironment === "production"}>Production — live site</option>
          <option value="dev" selected={defaultEnvironment === "dev"}>DEV — kin-dev</option>
        </select>
      </label>
      <label>
        Date
        <select data-pa-date>
          <option value="week">This week</option>
          <option value="today">Today</option>
          <option value="month">This month</option>
          <option value="all" selected>All stored events</option>
          <option value="custom">Custom range</option>
        </select>
      </label>
      <label data-pa-custom hidden>
        From
        <input type="date" data-pa-from />
      </label>
      <label data-pa-custom hidden>
        To
        <input type="date" data-pa-to />
      </label>
      <label class="pa-check">
        <input type="checkbox" data-pa-exclude-sue />
        Exclude Sue’s account
      </label>
      <button type="button" class="watson__button" data-pa-apply>Show activity</button>
    </div>
    <p class="pa-source" data-pa-source>Source: {defaultSource}</p>
    <p class="pa-status" data-pa-status data-pa-state="loading" role="status" aria-live="polite">
      {PATTERN_ACTIVITY_LOADING_MESSAGE}
    </p>
  </section>

  <section class="watson__panel" aria-labelledby="pattern-activity-builds-heading">
    <h2 id="pattern-activity-builds-heading" class="watson__panel-title">People who built a pattern</h2>
    <p class="pa-note">
      People who built counts stored identities with a generation event for that pattern.
      Someone who only started, opened, saved, edited, or printed is not included.
      Patterns generated counts every generation event, so a repeat build does not add another person.
    </p>
    <p class="pa-note">
      Signed-in people are account ids. These events do not reliably record a paid membership at the time of the build, so this is not a count of paying members.
      Hat guest identities are stored guest ids. Each guest id is not assumed to be a different person.
    </p>
    <p data-pa-pattern-notice></p>
    <div class="pa-table-wrap">
      <table class="watson-table">
        <thead>
          <tr>
            <th scope="col">Pattern</th>
            <th scope="col">People who built</th>
            <th scope="col">Patterns generated</th>
          </tr>
        </thead>
        <tbody data-pa-pattern-rows>
          <tr data-pa-row="hat-guest">
            <th scope="row">Hat — guest identities</th>
            <td data-pa-people>—</td>
            <td data-pa-generated>—</td>
          </tr>
          <tr data-pa-row="hat-signed-in">
            <th scope="row">Hat — signed-in people</th>
            <td data-pa-people>—</td>
            <td data-pa-generated>—</td>
          </tr>
          <tr data-pa-row="sleeveless">
            <th scope="row">Sleeveless</th>
            <td data-pa-people>—</td>
            <td data-pa-generated>—</td>
          </tr>
          <tr data-pa-row="drop-shoulder">
            <th scope="row">Drop Shoulder</th>
            <td data-pa-people>—</td>
            <td data-pa-generated>—</td>
          </tr>
          <tr data-pa-row="socks">
            <th scope="row">Socks</th>
            <td data-pa-people>—</td>
            <td data-pa-generated>—</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div data-pa-extra></div>
  </section>
</WatsonPageShell>

<script>
  import type { PatternActivityEvent } from "../../lib/patterns/patternActivityLog";
  import {
    dateRangeForPreset,
    patternActivityErrorMessage,
    patternActivityReadyMessage,
    PATTERN_ACTIVITY_EMPTY_MESSAGE,
    PATTERN_ACTIVITY_ERROR_LIST_MESSAGE,
    PATTERN_ACTIVITY_LOADING_MESSAGE,
    type PatternActivityDatePreset,
    type PatternActivityLoadState,
  } from "../../lib/patterns/patternActivityReport";
  import {
    buildPatternBuildReport,
    type PatternBuildReport,
    type PatternBuildRow,
  } from "../../lib/patterns/patternActivityUsage";

  const statusEl = document.querySelector("[data-pa-status]");
  const sourceEl = document.querySelector("[data-pa-source]");

  function setStatus(message: string, state: PatternActivityLoadState): void {
    if (!(statusEl instanceof HTMLElement)) return;
    statusEl.textContent = message;
    statusEl.dataset.paState = state;
  }

  function selected(selector: string): string {
    const el = document.querySelector(selector);
    return el instanceof HTMLSelectElement || el instanceof HTMLInputElement ? el.value : "";
  }

  function environmentLabel(value: string): string {
    return value === "dev" ? "DEV — kin-dev" : "Production — live site";
  }

  function setRow(key: string, people: string, generated: string): void {
    const row = document.querySelector(`[data-pa-row="${key}"]`);
    if (!(row instanceof HTMLElement)) return;
    const peopleCell = row.querySelector("[data-pa-people]");
    const generatedCell = row.querySelector("[data-pa-generated]");
    if (peopleCell) peopleCell.textContent = people;
    if (generatedCell) generatedCell.textContent = generated;
  }

  function clearNumbers(): void {
    for (const row of document.querySelectorAll("[data-pa-row]")) {
      if (!(row instanceof HTMLElement)) continue;
      const key = row.dataset.paRow;
      if (!key) continue;
      setRow(key, "—", "—");
    }
    const extra = document.querySelector("[data-pa-extra]");
    if (extra) extra.replaceChildren();
  }

  function renderNotice(message: string): void {
    const note = document.querySelector("[data-pa-pattern-notice]");
    if (note) note.textContent = message;
  }

  function appendExtra(row: PatternBuildRow): void {
    const host = document.querySelector("[data-pa-extra]");
    if (!(host instanceof HTMLElement)) return;
    let table = host.querySelector("table");
    if (!(table instanceof HTMLTableElement)) {
      table = document.createElement("table");
      table.className = "watson-table";
      const body = document.createElement("tbody");
      table.appendChild(body);
      host.appendChild(table);
    }
    const body = table.querySelector("tbody");
    if (!body) return;
    const tr = document.createElement("tr");
    const label = document.createElement("th");
    label.scope = "row";
    label.textContent = row.label;
    const people = document.createElement("td");
    people.textContent = String(row.peopleWhoBuilt);
    const generated = document.createElement("td");
    generated.textContent = String(row.patternsGenerated);
    tr.append(label, people, generated);
    body.appendChild(tr);
  }

  function renderReport(report: PatternBuildReport): void {
    for (const row of report.rows) {
      setRow(row.key, String(row.peopleWhoBuilt), String(row.patternsGenerated));
    }
    const extra = document.querySelector("[data-pa-extra]");
    if (extra) extra.replaceChildren();
    if (report.hatIdentityNotEstablished) appendExtra(report.hatIdentityNotEstablished);
    for (const row of report.otherPatterns) appendExtra(row);
  }

  async function loadActivity(): Promise<void> {
    const environment = selected("[data-pa-environment]") === "dev" ? "dev" : "production";
    if (sourceEl) sourceEl.textContent = `Source: ${environmentLabel(environment)}`;
    document.querySelectorAll("[data-pa-custom]").forEach((el) => {
      if (el instanceof HTMLElement) el.hidden = selected("[data-pa-date]") !== "custom";
    });
    setStatus(PATTERN_ACTIVITY_LOADING_MESSAGE, "loading");
    clearNumbers();
    renderNotice("");
    const preset = (selected("[data-pa-date]") || "all") as PatternActivityDatePreset;
    const range = dateRangeForPreset(preset, new Date(), {
      from: selected("[data-pa-from]"),
      to: selected("[data-pa-to]"),
    });
    const params = new URLSearchParams({ environment });
    if (range.fromIso) params.set("from", range.fromIso);
    if (range.toIso) params.set("to", range.toIso);
    const events: PatternActivityEvent[] = [];
    let offset = 0;
    let total = Number.POSITIVE_INFINITY;
    try {
      while (events.length < total) {
        const pageParams = new URLSearchParams(params);
        if (offset > 0) pageParams.set("offset", String(offset));
        const res = await fetch(`/api/watson/pattern-activity?${pageParams}`, {
          credentials: "same-origin",
          headers: { Accept: "application/json" },
        });
        const text = await res.text();
        let data: { ok?: boolean; events?: PatternActivityEvent[]; error?: string; total?: number };
        try {
          data = JSON.parse(text) as { ok?: boolean; events?: PatternActivityEvent[]; error?: string; total?: number };
        } catch {
          showLoadError(
            res.ok
              ? "Pattern activity returned a page instead of data."
              : `Pattern activity failed (${res.status}). The report did not finish.`,
          );
          return;
        }
        if (!res.ok || !data.ok || !Array.isArray(data.events)) {
          showLoadError(data.error || `Could not load pattern activity (${res.status}).`);
          return;
        }
        events.push(...data.events);
        total = typeof data.total === "number" ? data.total : events.length;
        if (data.events.length === 0) break;
        offset += data.events.length;
      }
    } catch {
      showLoadError("Could not load pattern activity. The request did not finish.");
      return;
    }
    const report = buildPatternBuildReport(events, {
      datePreset: "all",
      patternSystem: "",
      excludeSue: document.querySelector<HTMLInputElement>("[data-pa-exclude-sue]")?.checked === true,
    });
    renderReport(report);
    const loaded = events.length;
    renderNotice(loaded === 0 ? PATTERN_ACTIVITY_EMPTY_MESSAGE : "");
    setStatus(
      patternActivityReadyMessage(loaded, environmentLabel(environment)),
      loaded === 0 ? "empty" : "ready",
    );
  }

  function showLoadError(detail: string): void {
    clearNumbers();
    renderNotice(PATTERN_ACTIVITY_ERROR_LIST_MESSAGE);
    setStatus(patternActivityErrorMessage(detail), "error");
  }

  document.querySelector("[data-pa-apply]")?.addEventListener("click", () => {
    void loadActivity();
  });
  document.querySelector("[data-pa-date]")?.addEventListener("change", () => {
    document.querySelectorAll("[data-pa-custom]").forEach((el) => {
      if (el instanceof HTMLElement) el.hidden = selected("[data-pa-date]") !== "custom";
    });
  });
  document.querySelector("[data-pa-environment]")?.addEventListener("change", () => {
    if (sourceEl) sourceEl.textContent = `Source: ${environmentLabel(selected("[data-pa-environment]"))}`;
  });
  void loadActivity();
</script>

<style>
  .pa-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: end;
  }
  .pa-filters label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
  }
  .pa-check {
    flex-direction: row !important;
    align-items: center;
    gap: 0.4rem;
  }
  .pa-source,
  .pa-status[data-pa-state="empty"] {
    font-weight: 700;
  }
  .pa-note {
    margin: 0.75rem 0 0;
    max-width: 46rem;
  }
  .pa-status[data-pa-state="error"] {
    color: #9f1239;
    font-weight: 700;
  }
  .pa-table-wrap,
  [data-pa-extra] {
    overflow-x: auto;
    margin-top: 0.75rem;
  }
  .pa-table-wrap td,
  [data-pa-extra] td {
    text-align: right;
  }
</style>
