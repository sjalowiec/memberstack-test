---
import WatsonPageShell from "../../components/watson/WatsonPageShell.astro";
import { isKinDevNetlifySite } from "../../../netlify/functions/lib/pattern-activity-store.js";
import { PATTERN_ACTIVITY_LOADING_MESSAGE } from "../../lib/patterns/patternActivityReport";

export const prerender = false;

/** Kin-dev can read its own blob store. Production is a cross-site read and stays opt-in. */
const defaultEnvironment = isKinDevNetlifySite() ? "dev" : "production";
const defaultSource =
  defaultEnvironment === "dev" ? "DEV — kin-dev" : "Production — live site";
---

<WatsonPageShell
  title="Pattern Activity | Watson"
  description="Read-only summary of which patterns were used on Production or DEV."
  heading="Pattern Activity"
  intro="Which patterns were used in the selected date range. Production is the live site. This page only reads events."
>
  <section class="watson__panel" aria-labelledby="pattern-activity-filters-heading">
    <h2 id="pattern-activity-filters-heading" class="watson__panel-title">Filters</h2>
    <div class="pa-filters">
      <label>
        Environment
        <select data-pa-environment>
          <option value="production" selected={defaultEnvironment === "production"}>Production — live site</option>
          <option value="dev" selected={defaultEnvironment === "dev"}>DEV — kin-dev</option>
        </select>
      </label>
      <label>
        Date
        <select data-pa-date>
          <option value="week">This week</option>
          <option value="today">Today</option>
          <option value="month">This month</option>
          <option value="all" selected>All stored events</option>
          <option value="custom">Custom range</option>
        </select>
      </label>
      <label data-pa-custom hidden>
        From
        <input type="date" data-pa-from />
      </label>
      <label data-pa-custom hidden>
        To
        <input type="date" data-pa-to />
      </label>
      <label>
        Pattern
        <select data-pa-system>
          <option value="">All patterns</option>
        </select>
      </label>
      <label class="pa-check">
        <input type="checkbox" data-pa-exclude-sue />
        Exclude Sue’s account
      </label>
      <button type="button" class="watson__button" data-pa-apply>Show activity</button>
    </div>
    <p class="pa-source" data-pa-source>Source: {defaultSource}</p>
    <p class="pa-status" data-pa-status data-pa-state="loading" role="status" aria-live="polite">
      {PATTERN_ACTIVITY_LOADING_MESSAGE}
    </p>
  </section>

  <section class="watson__panel" aria-labelledby="pattern-activity-totals-heading">
    <h2 id="pattern-activity-totals-heading" class="watson__panel-title">Totals</h2>
    <dl class="pa-stats">
      <div><dt>People who generated or saved</dt><dd data-pa-people>—</dd></div>
      <div><dt>Total generations</dt><dd data-pa-generated>—</dd></div>
      <div><dt>Distinct saved projects</dt><dd data-pa-saved>—</dd></div>
      <div><dt>Opens</dt><dd data-pa-opens>—</dd></div>
      <div><dt>Edits</dt><dd data-pa-edits>—</dd></div>
      <div><dt>Prints</dt><dd data-pa-prints>—</dd></div>
    </dl>
    <p class="pa-note">
      People who generated or saved are signed-in accounts. Guest identities are not included in that count.
    </p>
  </section>

  <section class="watson__panel" aria-labelledby="pattern-activity-compare-heading">
    <h2 id="pattern-activity-compare-heading" class="watson__panel-title">Free Hat and member patterns</h2>
    <p class="pa-note">
      Free Hat pattern is activity stored with the hat identifier. Member patterns are the other known pattern identifiers.
      Neither group shows whether a person has paid access. Unknown identifiers stay in their own group so they are not folded into member patterns.
      Generations, saved projects, opens, edits, and prints in these three groups add up to the totals above.
      People do not: someone who used the free Hat pattern and a member pattern is counted in both groups and once in the totals.
    </p>
    <div class="pa-compare">
      <article>
        <h3>Free Hat pattern</h3>
        <dl class="pa-stats">
          <div><dt>People who generated or saved</dt><dd data-pa-free-people>—</dd></div>
          <div><dt>Guest identities</dt><dd data-pa-free-guests>—</dd></div>
          <div><dt>Identity not established</dt><dd data-pa-free-identity>—</dd></div>
          <div><dt>Generations</dt><dd data-pa-free-generated>—</dd></div>
          <div><dt>Distinct saved projects</dt><dd data-pa-free-saved>—</dd></div>
          <div><dt>Opens</dt><dd data-pa-free-opens>—</dd></div>
          <div><dt>Edits</dt><dd data-pa-free-edits>—</dd></div>
          <div><dt>Prints</dt><dd data-pa-free-prints>—</dd></div>
        </dl>
      </article>
      <article>
        <h3>Member patterns</h3>
        <dl class="pa-stats">
          <div><dt>People who generated or saved</dt><dd data-pa-member-people>—</dd></div>
          <div><dt>Guest identities</dt><dd data-pa-member-guests>—</dd></div>
          <div><dt>Identity not established</dt><dd data-pa-member-identity>—</dd></div>
          <div><dt>Generations</dt><dd data-pa-member-generated>—</dd></div>
          <div><dt>Distinct saved projects</dt><dd data-pa-member-saved>—</dd></div>
          <div><dt>Opens</dt><dd data-pa-member-opens>—</dd></div>
          <div><dt>Edits</dt><dd data-pa-member-edits>—</dd></div>
          <div><dt>Prints</dt><dd data-pa-member-prints>—</dd></div>
        </dl>
      </article>
      <article>
        <h3>Unknown</h3>
        <dl class="pa-stats">
          <div><dt>People who generated or saved</dt><dd data-pa-unknown-people>—</dd></div>
          <div><dt>Guest identities</dt><dd data-pa-unknown-guests>—</dd></div>
          <div><dt>Identity not established</dt><dd data-pa-unknown-identity>—</dd></div>
          <div><dt>Generations</dt><dd data-pa-unknown-generated>—</dd></div>
          <div><dt>Distinct saved projects</dt><dd data-pa-unknown-saved>—</dd></div>
          <div><dt>Opens</dt><dd data-pa-unknown-opens>—</dd></div>
          <div><dt>Edits</dt><dd data-pa-unknown-edits>—</dd></div>
          <div><dt>Prints</dt><dd data-pa-unknown-prints>—</dd></div>
        </dl>
      </article>
    </div>
  </section>

  <section class="watson__panel" aria-labelledby="pattern-activity-patterns-heading">
    <h2 id="pattern-activity-patterns-heading" class="watson__panel-title">Patterns</h2>
    <p class="pa-note">
      One row per pattern identifier, sorted by signed-in people who generated or saved, then by generations.
      A person who used more than one pattern is counted in each of those rows and once in the totals above.
      Guest identities and any other id are listed separately. The events do not establish paid access.
    </p>
    <p data-pa-pattern-notice></p>
    <div class="pa-table-wrap">
      <table class="watson-table">
        <thead>
          <tr>
            <th scope="col">Pattern</th>
            <th scope="col">Identifier</th>
            <th scope="col">Group</th>
            <th scope="col">People who generated or saved</th>
            <th scope="col">Guest identities</th>
            <th scope="col">Identity not established</th>
            <th scope="col">Generations</th>
            <th scope="col">Distinct saved projects</th>
            <th scope="col">Opens</th>
            <th scope="col">Edits</th>
            <th scope="col">Prints</th>
          </tr>
        </thead>
        <tbody data-pa-pattern-rows></tbody>
      </table>
    </div>
  </section>
</WatsonPageShell>

<script>
  import type { PatternActivityEvent } from "../../lib/patterns/patternActivityLog";
  import {
    patternActivitySystemFilterOptions,
    dateRangeForPreset,
    patternActivityErrorMessage,
    patternActivityReadyMessage,
    PATTERN_ACTIVITY_EMPTY_MESSAGE,
    PATTERN_ACTIVITY_ERROR_LIST_MESSAGE,
    PATTERN_ACTIVITY_LOADING_MESSAGE,
    type PatternActivityDatePreset,
    type PatternActivityLoadState,
  } from "../../lib/patterns/patternActivityReport";
  import {
    buildPatternActivityPatternSummary,
    buildPatternActivityUsage,
    type PatternActivityPatternGroup,
    type PatternActivityPatternTotals,
  } from "../../lib/patterns/patternActivityUsage";

  const statusEl = document.querySelector("[data-pa-status]");
  const sourceEl = document.querySelector("[data-pa-source]");
  const GROUP_FIELDS = ["people", "guests", "identity", "generated", "saved", "opens", "edits", "prints"] as const;

  function setStatus(message: string, state: PatternActivityLoadState): void {
    if (!(statusEl instanceof HTMLElement)) return;
    statusEl.textContent = message;
    statusEl.dataset.paState = state;
  }

  function selected(selector: string): string {
    const el = document.querySelector(selector);
    return el instanceof HTMLSelectElement || el instanceof HTMLInputElement ? el.value : "";
  }

  function environmentLabel(value: string): string {
    return value === "dev" ? "DEV — kin-dev" : "Production — live site";
  }

  function setText(selector: string, value: string): void {
    const el = document.querySelector(selector);
    if (el) el.textContent = value;
  }

  function groupLabel(group: PatternActivityPatternGroup): string {
    if (group === "free-hat") return "Free Hat pattern";
    if (group === "member-pattern") return "Member pattern";
    return "Unknown";
  }

  function fillGroup(prefix: string, totals: PatternActivityPatternTotals | null): void {
    if (!totals) {
      for (const field of GROUP_FIELDS) setText(`[data-pa-${prefix}-${field}]`, "—");
      return;
    }
    setText(`[data-pa-${prefix}-people]`, String(totals.signedInPeople));
    setText(`[data-pa-${prefix}-guests]`, String(totals.guestPeople));
    setText(`[data-pa-${prefix}-identity]`, String(totals.identityNotEstablished));
    setText(`[data-pa-${prefix}-generated]`, String(totals.generations));
    setText(`[data-pa-${prefix}-saved]`, String(totals.distinctSavedProjects));
    setText(`[data-pa-${prefix}-opens]`, String(totals.opens));
    setText(`[data-pa-${prefix}-edits]`, String(totals.edits));
    setText(`[data-pa-${prefix}-prints]`, String(totals.prints));
  }

  function renderNotice(message: string): void {
    setText("[data-pa-pattern-notice]", message);
  }

  function renderRows(rows: ReturnType<typeof buildPatternActivityPatternSummary>["rows"]): void {
    const body = document.querySelector("[data-pa-pattern-rows]");
    if (!(body instanceof HTMLElement)) return;
    body.replaceChildren();
    for (const row of rows) {
      const tr = document.createElement("tr");
      const cells = [
        row.label,
        row.identifiers.join(", "),
        groupLabel(row.group),
        String(row.signedInPeople),
        String(row.guestPeople),
        String(row.identityNotEstablished),
        String(row.generations),
        String(row.distinctSavedProjects),
        String(row.opens),
        String(row.edits),
        String(row.prints),
      ];
      for (const value of cells) {
        const td = document.createElement("td");
        td.textContent = value;
        tr.appendChild(td);
      }
      body.appendChild(tr);
    }
  }

  async function loadActivity(): Promise<void> {
    const environment = selected("[data-pa-environment]") === "dev" ? "dev" : "production";
    if (sourceEl) sourceEl.textContent = `Source: ${environmentLabel(environment)}`;
    document.querySelectorAll("[data-pa-custom]").forEach((el) => {
      if (el instanceof HTMLElement) el.hidden = selected("[data-pa-date]") !== "custom";
    });
    setStatus(PATTERN_ACTIVITY_LOADING_MESSAGE, "loading");
    clearTotals();
    renderNotice("");
    renderRows([]);
    const preset = (selected("[data-pa-date]") || "all") as PatternActivityDatePreset;
    const range = dateRangeForPreset(preset, new Date(), {
      from: selected("[data-pa-from]"),
      to: selected("[data-pa-to]"),
    });
    const params = new URLSearchParams({ environment });
    if (range.fromIso) params.set("from", range.fromIso);
    if (range.toIso) params.set("to", range.toIso);
    const events: PatternActivityEvent[] = [];
    let offset = 0;
    let total = Number.POSITIVE_INFINITY;
    try {
      while (events.length < total) {
        const pageParams = new URLSearchParams(params);
        if (offset > 0) pageParams.set("offset", String(offset));
        const res = await fetch(`/api/watson/pattern-activity?${pageParams}`, {
          credentials: "same-origin",
          headers: { Accept: "application/json" },
        });
        const text = await res.text();
        let data: { ok?: boolean; events?: PatternActivityEvent[]; error?: string; total?: number };
        try {
          data = JSON.parse(text) as { ok?: boolean; events?: PatternActivityEvent[]; error?: string; total?: number };
        } catch {
          showLoadError(
            res.ok
              ? "Pattern activity returned a page instead of data."
              : `Pattern activity failed (${res.status}). The report did not finish.`,
          );
          return;
        }
        if (!res.ok || !data.ok || !Array.isArray(data.events)) {
          showLoadError(data.error || `Could not load pattern activity (${res.status}).`);
          return;
        }
        events.push(...data.events);
        total = typeof data.total === "number" ? data.total : events.length;
        if (data.events.length === 0) break;
        offset += data.events.length;
      }
    } catch {
      showLoadError("Could not load pattern activity. The request did not finish.");
      return;
    }
    const system = selected("[data-pa-system]");
    const options = patternActivitySystemFilterOptions(events);
    const select = document.querySelector("[data-pa-system]");
    if (select instanceof HTMLSelectElement && select.options.length <= 1) {
      for (const option of options) {
        const node = document.createElement("option");
        node.value = option.value;
        node.textContent = option.label;
        select.appendChild(node);
      }
      if ([...select.options].some((option) => option.value === system)) select.value = system;
    }
    const filters = {
      datePreset: "all" as const,
      patternSystem: selected("[data-pa-system]"),
      excludeSue: document.querySelector<HTMLInputElement>("[data-pa-exclude-sue]")?.checked === true,
    };
    const report = buildPatternActivityUsage(events, filters);
    const summary = buildPatternActivityPatternSummary(events, filters);
    setText("[data-pa-people]", String(report.peopleWhoGeneratedOrSaved));
    setText("[data-pa-generated]", String(report.totalGenerations));
    setText("[data-pa-saved]", String(report.distinctSavedProjects));
    setText("[data-pa-opens]", String(report.opens));
    setText("[data-pa-edits]", String(report.edits));
    setText("[data-pa-prints]", String(report.prints));
    if (!summary.matchesExistingTotals) {
      clearGroups();
      renderRows([]);
      renderNotice(PATTERN_ACTIVITY_ERROR_LIST_MESSAGE);
      setStatus(
        patternActivityErrorMessage("Pattern rows do not match the totals, so the summary was not shown."),
        "error",
      );
      return;
    }
    fillGroup("free", summary.freeHat);
    fillGroup("member", summary.memberPatterns);
    fillGroup("unknown", summary.unknown);
    renderRows(summary.rows);
    const loaded = events.length;
    const filteredOut = summary.rows.length === 0;
    renderNotice(filteredOut ? PATTERN_ACTIVITY_EMPTY_MESSAGE : "");
    setStatus(
      patternActivityReadyMessage(filteredOut ? 0 : loaded, environmentLabel(environment)),
      loaded === 0 || filteredOut ? "empty" : "ready",
    );
  }

  function clearGroups(): void {
    fillGroup("free", null);
    fillGroup("member", null);
    fillGroup("unknown", null);
  }

  function clearTotals(): void {
    for (const selector of [
      "[data-pa-people]",
      "[data-pa-generated]",
      "[data-pa-saved]",
      "[data-pa-opens]",
      "[data-pa-edits]",
      "[data-pa-prints]",
    ]) {
      setText(selector, "—");
    }
    clearGroups();
  }

  function showLoadError(detail: string): void {
    clearTotals();
    renderRows([]);
    renderNotice(PATTERN_ACTIVITY_ERROR_LIST_MESSAGE);
    setStatus(patternActivityErrorMessage(detail), "error");
  }

  document.querySelector("[data-pa-apply]")?.addEventListener("click", () => {
    void loadActivity();
  });
  document.querySelector("[data-pa-date]")?.addEventListener("change", () => {
    document.querySelectorAll("[data-pa-custom]").forEach((el) => {
      if (el instanceof HTMLElement) el.hidden = selected("[data-pa-date]") !== "custom";
    });
  });
  document.querySelector("[data-pa-environment]")?.addEventListener("change", () => {
    if (sourceEl) sourceEl.textContent = `Source: ${environmentLabel(selected("[data-pa-environment]"))}`;
  });
  void loadActivity();
</script>

<style>
  .pa-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: end;
  }
  .pa-filters label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
  }
  .pa-check {
    flex-direction: row !important;
    align-items: center;
    gap: 0.4rem;
  }
  .pa-source {
    font-weight: 700;
  }
  .pa-note {
    margin: 0.75rem 0 0;
    max-width: 52rem;
  }
  .pa-status[data-pa-state="error"] {
    color: #9f1239;
    font-weight: 700;
  }
  .pa-status[data-pa-state="empty"] {
    font-weight: 700;
  }
  .pa-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
  }
  .pa-stats div {
    margin: 0;
  }
  .pa-stats dd {
    margin: 0.15rem 0 0;
    font-size: 1.4rem;
    font-weight: 700;
  }
  .pa-compare {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .pa-compare article {
    margin: 0;
    padding: 0.75rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
  }
  .pa-compare h3 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }
  .pa-table-wrap {
    overflow-x: auto;
    margin-top: 0.75rem;
  }
  .pa-table-wrap td:nth-child(n + 4) {
    text-align: right;
  }
</style>
