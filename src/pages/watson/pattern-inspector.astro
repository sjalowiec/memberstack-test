---
import WatsonPageShell from "../../components/watson/WatsonPageShell.astro";
import {
  inspectSavedPatternByProjectId,
  type PatternInspectorResult,
} from "../../lib/watson/patternInspector";

export const prerender = false;

const EXAMPLE_PROJECT_URL =
  "https://app.knititnow.com/patterns/drop-shoulder/pattern/?project=5b04bde9-914f-485f-b2bc-b0db5eff5ccf";
const EXAMPLE_PROJECT_ID = "5b04bde9-914f-485f-b2bc-b0db5eff5ccf";

const rawProjectId = Astro.url.searchParams.get("projectId") ?? "";
const hasSubmitted = Astro.url.searchParams.has("projectId");

let result: PatternInspectorResult | null = null;
if (hasSubmitted) {
  result = await inspectSavedPatternByProjectId(rawProjectId);
}
---

<WatsonPageShell
  title="Saved Pattern Inspector | Watson"
  description="Look up exactly what a member saved using the project ID from a pattern URL or PDF."
  heading="Saved Pattern Inspector"
  intro="Use this when a member reports a problem with a saved pattern. Look up exactly what they saved - nothing is changed."
>
  <section class="watson__panel watson-pattern-inspector__howto" aria-labelledby="watson-pattern-inspector-howto-heading">
    <h2 id="watson-pattern-inspector-howto-heading" class="watson__panel-title">How to use this tool</h2>
    <p class="watson-pattern-inspector__lede">
      Use this tool when a member reports a problem with a saved pattern.
    </p>
    <ol class="watson-pattern-inspector__steps">
      <li>
        <strong>Find the Project ID.</strong>
        You can copy it from:
        <ul>
          <li>the pattern URL</li>
          <li>the footer of a printed PDF</li>
        </ul>
      </li>
      <li>
        <strong>Copy only the value after</strong> <code>project=</code>
        <p class="watson-pattern-inspector__example-label">Example URL:</p>
        <p class="watson-pattern-inspector__example-url">{EXAMPLE_PROJECT_URL}</p>
        <p class="watson-pattern-inspector__example-id">
          Project ID to paste: <code>{EXAMPLE_PROJECT_ID}</code>
        </p>
      </li>
      <li>
        Paste that Project ID into the box below and click <strong>Find Saved Pattern</strong>.
      </li>
    </ol>
    <p class="watson-pattern-inspector__lede">The inspector will display:</p>
    <ul class="watson-pattern-inspector__shows">
      <li>the saved pattern settings</li>
      <li>custom measurements</li>
      <li>Custom Build overrides</li>
      <li>the Memberstack ID</li>
      <li>the raw saved JSON (optional)</li>
    </ul>
  </section>

  <section class="watson__panel" aria-labelledby="watson-pattern-inspector-lookup-heading">
    <h2 id="watson-pattern-inspector-lookup-heading" class="watson__panel-title">Look up a saved pattern</h2>

    <form class="watson-pattern-inspector__form" method="get" action="/watson/pattern-inspector" role="search">
      <div class="watson-pattern-inspector__label-row">
        <label class="watson-pattern-inspector__label" for="watson-pattern-inspector-project-id">
          Project ID
        </label>
        <details class="watson-pattern-inspector__help">
          <summary class="watson-pattern-inspector__help-summary" aria-label="Where do I find the Project ID?">
            <span class="watson-pattern-inspector__help-icon" aria-hidden="true">?</span>
            <span class="watson-pattern-inspector__help-text">Where do I find the Project ID?</span>
          </summary>
          <div class="watson-pattern-inspector__help-body">
            <p>Copy the Project ID from:</p>
            <ul>
              <li>the pattern URL (the value after <code>project=</code>)</li>
              <li>the footer of a printed PDF</li>
            </ul>
            <p class="watson-pattern-inspector__example-label">Example:</p>
            <p class="watson-pattern-inspector__example-url">{EXAMPLE_PROJECT_URL}</p>
            <p>
              Paste only this part:
              <code>{EXAMPLE_PROJECT_ID}</code>
            </p>
          </div>
        </details>
      </div>

      <div class="watson-pattern-inspector__input-row">
        <input
          id="watson-pattern-inspector-project-id"
          class="watson__search-input"
          type="text"
          name="projectId"
          value={rawProjectId}
          placeholder="Paste Project ID here"
          autocomplete="off"
          spellcheck="false"
          required
        />
        <button class="watson__button" type="submit">Find Saved Pattern</button>
      </div>
    </form>

    {
      !hasSubmitted ? (
        <div class="watson-pattern-inspector__empty" role="status">
          <p class="watson-pattern-inspector__empty-title">No project loaded yet.</p>
          <p class="watson-pattern-inspector__empty-hint">
            Paste the Project ID from a pattern URL or the footer of a printed PDF.
          </p>
        </div>
      ) : null
    }
  </section>

  {
    result?.status === "invalid" ? (
      <section class="watson__panel" aria-label="Invalid Project ID">
        <h2 class="watson__panel-title">That does not look like a Project ID</h2>
        <p class="watson__status watson__status--error" role="alert">
          {result.message}
        </p>
        <p class="watson-pattern-inspector__empty-hint">
          Copy only the value after <code>project=</code> in the pattern URL, or from the PDF footer.
          It looks like: <code>{EXAMPLE_PROJECT_ID}</code>
        </p>
      </section>
    ) : null
  }

  {
    result?.status === "error" ? (
      <section class="watson__panel" aria-label="Lookup error">
        <h2 class="watson__panel-title">Could not look up this pattern</h2>
        <p class="watson__status watson__status--error" role="alert">
          {result.message}
        </p>
        <p class="watson-pattern-inspector__empty-hint">
          Try again in a moment. If it keeps failing, check that you are signed into Watson on the
          production site.
        </p>
      </section>
    ) : null
  }

  {
    result?.status === "none" ? (
      <section class="watson__panel" aria-label="No saved pattern found">
        <h2 class="watson__panel-title">No saved pattern found</h2>
        <p class="watson-pattern-inspector__lede">
          Nothing matched Project ID <code>{result.projectId}</code>.
        </p>
        <p class="watson-pattern-inspector__lede">This can happen when:</p>
        <ul class="watson-pattern-inspector__shows">
          <li>the project was deleted</li>
          <li>it was never cloud-saved</li>
          <li>it belongs to another environment</li>
          <li>the Project ID was copied incorrectly</li>
        </ul>
        <p class="watson-pattern-inspector__empty-hint">
          Double-check the value after <code>project=</code> in the member's URL or PDF footer, then
          try again.
        </p>
      </section>
    ) : null
  }

  {
    result?.status === "many" ? (
      <section class="watson__panel" aria-label="Multiple matches">
        <h2 class="watson__panel-title">More than one match</h2>
        <p class="watson__status watson__status--error" role="alert">
          Several saved patterns share this Project ID. The inspector will not guess which one to
          open - review the matching records below.
        </p>
        <ul class="watson-pattern-inspector__key-list">
          {result.matchingKeys.map((key) => (
            <li>
              <code>{key}</code>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  {
    result?.status === "one" ? (
      <>
        <section class="watson__panel" aria-label="Saved pattern summary">
          <h2 class="watson__panel-title">Summary</h2>
          <dl class="watson-pattern-inspector__dl">
            {result.summary.map((row) => (
              <div class="watson-pattern-inspector__row">
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>

          <div class="watson-pattern-inspector__actions">
            <button
              type="button"
              class="watson__button watson__button--secondary"
              data-copy-text={result.projectId}
            >
              Copy Project ID
            </button>
            {
              result.memberstackUserId ? (
                <button
                  type="button"
                  class="watson__button watson__button--secondary"
                  data-copy-text={result.memberstackUserId}
                >
                  Copy Memberstack ID
                </button>
              ) : null
            }
            <button
              type="button"
              class="watson__button watson__button--secondary"
              data-copy-target="watson-pattern-inspector-sanitized"
            >
              Copy sanitized pattern settings
            </button>
            {
              result.memberstackProfileHref ? (
                <a class="watson__button watson__button--secondary" href={result.memberstackProfileHref}>
                  Open member Watson record
                </a>
              ) : null
            }
          </div>
          <textarea
            id="watson-pattern-inspector-sanitized"
            class="visually-hidden"
            readonly
            aria-hidden="true"
            tabindex="-1">{result.sanitizedSettingsText}</textarea>
          <p class="watson-pattern-inspector__copy-status" data-copy-status hidden></p>
        </section>

        <section class="watson__panel" aria-label="Pattern settings">
          <h2 class="watson__panel-title">Pattern Settings</h2>
          {
            result.settings.length === 0 ? (
              <p class="watson__status">No pattern settings were present on this saved project.</p>
            ) : (
              <dl class="watson-pattern-inspector__dl">
                {result.settings.map((row) => (
                  <div class="watson-pattern-inspector__row">
                    <dt>{row.label}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))}
              </dl>
            )
          }

          {
            result.customBuildOverrides.length > 0 ? (
              <>
                <h3 class="watson-pattern-inspector__subheading">Custom Build overrides</h3>
                <dl class="watson-pattern-inspector__dl">
                  {result.customBuildOverrides.map((row) => (
                    <div class="watson-pattern-inspector__row">
                      <dt>{row.label}</dt>
                      <dd>{row.value}</dd>
                    </div>
                  ))}
                </dl>
              </>
            ) : null
          }
        </section>

        {
          result.notes ? (
            <section class="watson__panel" aria-label="Member pattern notes">
              <h2 class="watson__panel-title">Member pattern notes</h2>
              <p class="watson-pattern-inspector__notes-hint">
                Notes the member saved on this pattern project (not Watson support notes).
              </p>
              <pre class="watson-pattern-inspector__notes">{result.notes}</pre>
            </section>
          ) : null
        }

        <section class="watson__panel" aria-label="Raw saved project JSON">
          <details class="watson-pattern-inspector__details">
            <summary>Raw Saved Project JSON</summary>
            <p class="watson-pattern-inspector__notes-hint">
              Optional detail for deeper investigation. Most support questions only need the summary
              and Pattern Settings above.
            </p>
            <pre class="watson-pattern-inspector__json">{result.rawJson}</pre>
          </details>
        </section>
      </>
    ) : null
  }
</WatsonPageShell>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .watson-pattern-inspector__howto {
    background: #f8fafc;
  }

  .watson-pattern-inspector__lede {
    margin: 0 0 0.65rem;
    color: #475569;
    line-height: 1.5;
  }

  .watson-pattern-inspector__steps {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    color: #334155;
    line-height: 1.55;
  }

  .watson-pattern-inspector__steps li + li {
    margin-top: 0.75rem;
  }

  .watson-pattern-inspector__steps ul {
    margin: 0.35rem 0 0;
    padding-left: 1.2rem;
  }

  .watson-pattern-inspector__shows {
    margin: 0;
    padding-left: 1.2rem;
    color: #334155;
    line-height: 1.55;
  }

  .watson-pattern-inspector__example-label {
    margin: 0.55rem 0 0.25rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: #64748b;
  }

  .watson-pattern-inspector__example-url {
    margin: 0;
    padding: 0.55rem 0.7rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.82rem;
    line-height: 1.45;
    word-break: break-all;
    color: #334155;
  }

  .watson-pattern-inspector__example-id {
    margin: 0.45rem 0 0;
    font-size: 0.9rem;
    color: #475569;
  }

  .watson-pattern-inspector__form {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .watson-pattern-inspector__label-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
  }

  .watson-pattern-inspector__label {
    font-size: 0.95rem;
    font-weight: 700;
    color: #334155;
  }

  .watson-pattern-inspector__help {
    position: relative;
  }

  .watson-pattern-inspector__help-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    list-style: none;
    color: #3f6212;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .watson-pattern-inspector__help-summary::-webkit-details-marker {
    display: none;
  }

  .watson-pattern-inspector__help-summary::marker {
    content: "";
  }

  .watson-pattern-inspector__help-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    border: 1.5px solid #84cc16;
    background: #f7fee7;
    color: #3f6212;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
  }

  .watson-pattern-inspector__help-summary:hover .watson-pattern-inspector__help-icon {
    background: #ecfccb;
  }

  .watson-pattern-inspector__help-body {
    margin-top: 0.65rem;
    padding: 0.85rem 0.95rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #475569;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .watson-pattern-inspector__help-body p {
    margin: 0 0 0.45rem;
  }

  .watson-pattern-inspector__help-body ul {
    margin: 0 0 0.65rem;
    padding-left: 1.2rem;
  }

  .watson-pattern-inspector__input-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }

  .watson-pattern-inspector__input-row .watson__search-input {
    flex: 1 1 16rem;
    min-width: 0;
  }

  .watson-pattern-inspector__empty {
    margin-top: 1rem;
    padding: 0.95rem 1rem;
    border: 1px dashed #cbd5e1;
    border-radius: 10px;
    background: #fff;
  }

  .watson-pattern-inspector__empty-title {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 700;
    color: #243015;
  }

  .watson-pattern-inspector__empty-hint {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: #64748b;
  }

  .watson-pattern-inspector__dl {
    margin: 0;
  }

  .watson-pattern-inspector__row {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) 1fr;
    gap: 0.35rem 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .watson-pattern-inspector__row:last-child {
    border-bottom: none;
  }

  .watson-pattern-inspector__row dt {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 700;
    color: #64748b;
  }

  .watson-pattern-inspector__row dd {
    margin: 0;
    color: #334155;
    word-break: break-word;
  }

  .watson-pattern-inspector__subheading {
    margin: 1.25rem 0 0.65rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #243015;
  }

  .watson-pattern-inspector__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .watson__button--secondary {
    color: #3f6212;
    background: #f7fee7;
    border: 1px solid #d9f99d;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .watson__button--secondary:hover {
    background: #ecfccb;
  }

  .watson-pattern-inspector__copy-status {
    margin: 0.65rem 0 0;
    font-size: 0.88rem;
    color: #3f6212;
  }

  .watson-pattern-inspector__notes,
  .watson-pattern-inspector__json {
    margin: 0;
    padding: 0.85rem 0.95rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.86rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-x: auto;
  }

  .watson-pattern-inspector__notes-hint {
    margin: 0 0 0.65rem;
    font-size: 0.9rem;
    color: #64748b;
  }

  .watson-pattern-inspector__key-list {
    margin: 0.75rem 0 0;
    padding-left: 1.2rem;
    line-height: 1.6;
  }

  .watson-pattern-inspector__details summary {
    cursor: pointer;
    font-weight: 700;
    color: #243015;
  }

  .watson-pattern-inspector__details[open] summary {
    margin-bottom: 0.75rem;
  }

  .watson-pattern-inspector__json {
    max-height: 32rem;
    overflow: auto;
  }
</style>

<script>
  function initCopyButtons(root: ParentNode) {
    const status = root.querySelector<HTMLElement>("[data-copy-status]");

    async function copyText(text: string) {
      try {
        await navigator.clipboard.writeText(text);
        if (status) {
          status.hidden = false;
          status.textContent = "Copied.";
        }
      } catch {
        if (status) {
          status.hidden = false;
          status.textContent = "Could not copy - select the text manually.";
        }
      }
    }

    root.querySelectorAll<HTMLButtonElement>("[data-copy-text]").forEach((button) => {
      button.addEventListener("click", () => {
        void copyText(button.getAttribute("data-copy-text") ?? "");
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-copy-target]").forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.getAttribute("data-copy-target") ?? "";
        const el = id ? document.getElementById(id) : null;
        const text =
          el instanceof HTMLTextAreaElement || el instanceof HTMLInputElement
            ? el.value
            : (el?.textContent ?? "");
        void copyText(text);
      });
    });
  }

  initCopyButtons(document);
</script>
