---
import WatsonPageShell from "../../components/watson/WatsonPageShell.astro";
import {
  inspectSavedPatternByProjectId,
  PATTERN_INSPECTOR_BLOB_STORE,
  PATTERN_INSPECTOR_PREFIX,
  type PatternInspectorResult,
} from "../../lib/watson/patternInspector";

export const prerender = false;

const rawProjectId = Astro.url.searchParams.get("projectId") ?? "";
const hasSubmitted = Astro.url.searchParams.has("projectId");

let result: PatternInspectorResult | null = null;
if (hasSubmitted) {
  result = await inspectSavedPatternByProjectId(rawProjectId);
}
---

<WatsonPageShell
  title="Saved Pattern Inspector | Watson"
  description="Look up exactly what a member saved using the project ID from a pattern URL or PDF."
  heading="Saved Pattern Inspector"
  intro="Paste a project ID from a pattern URL or PDF to see the exact data saved in the cloud. Read-only - nothing is changed."
>
  <form class="watson__search watson-pattern-inspector__form" method="get" action="/watson/pattern-inspector" role="search">
    <label class="watson-pattern-inspector__label" for="watson-pattern-inspector-project-id">
      Project ID
    </label>
    <input
      id="watson-pattern-inspector-project-id"
      class="watson__search-input"
      type="text"
      name="projectId"
      value={rawProjectId}
      placeholder="e.g. e77c684f-c097-4400-aa85-52e4e2e315c8"
      autocomplete="off"
      spellcheck="false"
      required
    />
    <button class="watson__button" type="submit">Find Saved Pattern</button>
  </form>

  {
    !hasSubmitted ? (
      <p class="watson__status">
        Searches production store <code>{PATTERN_INSPECTOR_BLOB_STORE}</code> under prefix{" "}
        <code>{PATTERN_INSPECTOR_PREFIX}</code> (includes Drop Shoulder and Sleeveless projects).
      </p>
    ) : null
  }

  {
    result?.status === "invalid" ? (
      <p class="watson__status watson__status--error" role="alert">
        {result.message}
      </p>
    ) : null
  }

  {
    result?.status === "error" ? (
      <p class="watson__status watson__status--error" role="alert">
        {result.message}
      </p>
    ) : null
  }

  {
    result?.status === "none" ? (
      <section class="watson__panel" aria-label="No saved pattern found">
        <h2 class="watson__panel-title">No saved pattern found</h2>
        <pre class="watson-pattern-inspector__message">{result.message}</pre>
      </section>
    ) : null
  }

  {
    result?.status === "many" ? (
      <section class="watson__panel" aria-label="Multiple matches">
        <h2 class="watson__panel-title">Multiple matches</h2>
        <p class="watson__status watson__status--error" role="alert">
          {result.message}
        </p>
        <p class="watson__status">
          Store: <code>{result.store}</code> | Prefix: <code>{result.prefix}</code>
        </p>
        <ul class="watson-pattern-inspector__key-list">
          {result.matchingKeys.map((key) => (
            <li>
              <code>{key}</code>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  {
    result?.status === "one" ? (
      <>
        <section class="watson__panel" aria-label="Saved pattern summary">
          <h2 class="watson__panel-title">Summary</h2>
          <dl class="watson-pattern-inspector__dl">
            {result.summary.map((row) => (
              <div class="watson-pattern-inspector__row">
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>

          <div class="watson-pattern-inspector__actions">
            <button
              type="button"
              class="watson__button watson__button--secondary"
              data-copy-text={result.projectId}
            >
              Copy Project ID
            </button>
            {
              result.memberstackUserId ? (
                <button
                  type="button"
                  class="watson__button watson__button--secondary"
                  data-copy-text={result.memberstackUserId}
                >
                  Copy Memberstack ID
                </button>
              ) : null
            }
            <button
              type="button"
              class="watson__button watson__button--secondary"
              data-copy-target="watson-pattern-inspector-sanitized"
            >
              Copy sanitized pattern settings
            </button>
            {
              result.memberstackProfileHref ? (
                <a class="watson__button watson__button--secondary" href={result.memberstackProfileHref}>
                  Open member Watson record
                </a>
              ) : null
            }
          </div>
          <textarea
            id="watson-pattern-inspector-sanitized"
            class="visually-hidden"
            readonly
            aria-hidden="true"
            tabindex="-1">{result.sanitizedSettingsText}</textarea>
          <p class="watson-pattern-inspector__copy-status" data-copy-status hidden></p>
        </section>

        <section class="watson__panel" aria-label="Pattern settings">
          <h2 class="watson__panel-title">Pattern Settings</h2>
          {
            result.settings.length === 0 ? (
              <p class="watson__status">No pattern settings were present on this saved project.</p>
            ) : (
              <dl class="watson-pattern-inspector__dl">
                {result.settings.map((row) => (
                  <div class="watson-pattern-inspector__row">
                    <dt>{row.label}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))}
              </dl>
            )
          }

          {
            result.customBuildOverrides.length > 0 ? (
              <>
                <h3 class="watson-pattern-inspector__subheading">Custom Build overrides</h3>
                <dl class="watson-pattern-inspector__dl">
                  {result.customBuildOverrides.map((row) => (
                    <div class="watson-pattern-inspector__row">
                      <dt>{row.label}</dt>
                      <dd>{row.value}</dd>
                    </div>
                  ))}
                </dl>
              </>
            ) : null
          }
        </section>

        {
          result.notes ? (
            <section class="watson__panel" aria-label="Member pattern notes">
              <h2 class="watson__panel-title">Member pattern notes</h2>
              <p class="watson-pattern-inspector__notes-hint">
                Notes the member saved on this pattern project (not Watson support notes).
              </p>
              <pre class="watson-pattern-inspector__notes">{result.notes}</pre>
            </section>
          ) : null
        }

        <section class="watson__panel" aria-label="Raw saved project JSON">
          <details class="watson-pattern-inspector__details">
            <summary>Raw Saved Project JSON</summary>
            <pre class="watson-pattern-inspector__json">{result.rawJson}</pre>
          </details>
        </section>
      </>
    ) : null
  }
</WatsonPageShell>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .watson-pattern-inspector__form {
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
  }

  .watson-pattern-inspector__form .watson__search-input,
  .watson-pattern-inspector__form .watson__button {
    width: auto;
  }

  @media (min-width: 640px) {
    .watson-pattern-inspector__form {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-end;
    }

    .watson-pattern-inspector__label {
      flex: 1 0 100%;
    }

    .watson-pattern-inspector__form .watson__search-input {
      flex: 1 1 16rem;
    }
  }

  .watson-pattern-inspector__label {
    font-size: 0.9rem;
    font-weight: 700;
    color: #334155;
  }

  .watson-pattern-inspector__dl {
    margin: 0;
  }

  .watson-pattern-inspector__row {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) 1fr;
    gap: 0.35rem 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .watson-pattern-inspector__row:last-child {
    border-bottom: none;
  }

  .watson-pattern-inspector__row dt {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 700;
    color: #64748b;
  }

  .watson-pattern-inspector__row dd {
    margin: 0;
    color: #334155;
    word-break: break-word;
  }

  .watson-pattern-inspector__subheading {
    margin: 1.25rem 0 0.65rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #243015;
  }

  .watson-pattern-inspector__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .watson__button--secondary {
    color: #3f6212;
    background: #f7fee7;
    border: 1px solid #d9f99d;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .watson__button--secondary:hover {
    background: #ecfccb;
  }

  .watson-pattern-inspector__copy-status {
    margin: 0.65rem 0 0;
    font-size: 0.88rem;
    color: #3f6212;
  }

  .watson-pattern-inspector__message,
  .watson-pattern-inspector__notes,
  .watson-pattern-inspector__json {
    margin: 0;
    padding: 0.85rem 0.95rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.86rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-x: auto;
  }

  .watson-pattern-inspector__notes-hint {
    margin: 0 0 0.65rem;
    font-size: 0.9rem;
    color: #64748b;
  }

  .watson-pattern-inspector__key-list {
    margin: 0.75rem 0 0;
    padding-left: 1.2rem;
    line-height: 1.6;
  }

  .watson-pattern-inspector__details summary {
    cursor: pointer;
    font-weight: 700;
    color: #243015;
  }

  .watson-pattern-inspector__details[open] summary {
    margin-bottom: 0.75rem;
  }

  .watson-pattern-inspector__json {
    max-height: 32rem;
    overflow: auto;
  }
</style>

<script>
  function initCopyButtons(root: ParentNode) {
    const status = root.querySelector<HTMLElement>("[data-copy-status]");

    async function copyText(text: string) {
      try {
        await navigator.clipboard.writeText(text);
        if (status) {
          status.hidden = false;
          status.textContent = "Copied.";
        }
      } catch {
        if (status) {
          status.hidden = false;
          status.textContent = "Could not copy - select the text manually.";
        }
      }
    }

    root.querySelectorAll<HTMLButtonElement>("[data-copy-text]").forEach((button) => {
      button.addEventListener("click", () => {
        void copyText(button.getAttribute("data-copy-text") ?? "");
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-copy-target]").forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.getAttribute("data-copy-target") ?? "";
        const el = id ? document.getElementById(id) : null;
        const text =
          el instanceof HTMLTextAreaElement || el instanceof HTMLInputElement
            ? el.value
            : (el?.textContent ?? "");
        void copyText(text);
      });
    });
  }

  initCopyButtons(document);
</script>
