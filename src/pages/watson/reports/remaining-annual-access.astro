---
import WatsonOctoberLegacyRenewalReminder from "../../../components/watson/WatsonOctoberLegacyRenewalReminder.astro";
import WatsonPageShell from "../../../components/watson/WatsonPageShell.astro";
import WatsonRemainingAnnualAccessReport from "../../../components/watson/WatsonRemainingAnnualAccessReport.astro";
import {
  loadOctoberLegacyRenewalReminder,
  type OctoberLegacyRenewalReminderReport,
} from "../../../lib/watson/octoberLegacyRenewalReminder";
import {
  loadRemainingAnnualAccessReport,
  type RemainingAnnualAccessReport,
} from "../../../lib/watson/remainingAnnualAccessReport";

export const prerender = false;

let octoberError: string | null = null;
let october: OctoberLegacyRenewalReminderReport | null = null;
let reportError: string | null = null;
let report: RemainingAnnualAccessReport | null = null;

try {
  october = await loadOctoberLegacyRenewalReminder();
} catch (error) {
  octoberError =
    error instanceof Error ? error.message : "October renewal reminder list failed to load.";
}

try {
  report = await loadRemainingAnnualAccessReport();
} catch (error) {
  reportError =
    error instanceof Error ? error.message : "Remaining annual access report failed to load.";
}
---

<WatsonPageShell
  title="Remaining Annual Access | Watson Reports"
  description="October 2026 legacy renewal reminders, plus the migration classification of current non-monthly members."
  heading="Remaining Annual Access"
  intro="October 2026 renewal reminders are the list to use for outreach. The classification table below is the separate migration view and is not the reminder list."
>
  <p class="watson-report__meta">
    <a href="/watson/reports">? All reports</a>
  </p>
  {
    octoberError ? (
      <p class="watson__status watson__status--error" role="alert">
        {octoberError}
      </p>
    ) : october ? (
      <WatsonOctoberLegacyRenewalReminder report={october} />
    ) : null
  }
  {
    reportError ? (
      <p class="watson__status watson__status--error" role="alert">
        {reportError}
      </p>
    ) : report ? (
      <WatsonRemainingAnnualAccessReport report={report} />
    ) : null
  }
</WatsonPageShell>
