---
import WatsonPageShell from "../../../components/watson/WatsonPageShell.astro";
import WatsonStoreSalesByYearReport from "../../../components/watson/WatsonStoreSalesByYearReport.astro";
import { loadStoreSalesByYearReport } from "../../../lib/watson/storeSalesByYearReport";

export const prerender = false;

let reportError: string | null = null;
let report = {
  rows: [],
  totals: {
    orderCount: 0,
    revenueAmount: 0,
    revenueDisplay: "$0.00",
    averageOrderValueAmount: 0,
    averageOrderValueDisplay: "$0.00",
  },
};

try {
  report = await loadStoreSalesByYearReport();
} catch (error) {
  reportError =
    error instanceof Error ? error.message : "Legacy store sales report failed to load.";
}
---

<WatsonPageShell
  title="Reports | Watson"
  description="Historical business reporting from imported legacy Knit It Now data."
  heading="Reports"
  intro="Historical business reporting from imported legacy data."
>
  <nav class="watson-reports__nav" aria-label="Available reports">
    <a class="watson-reports__nav-link" href="#legacy-store-sales-by-year">
      Legacy Store Sales by Year
    </a>
  </nav>

  {
    reportError ? (
      <p class="watson__status watson__status--error" role="alert">
        {reportError}
      </p>
    ) : null
  }

  <WatsonStoreSalesByYearReport report={report} />
</WatsonPageShell>

<style>
  .watson-reports__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .watson-reports__nav-link {
    color: #3f6212;
    font-weight: 600;
    text-decoration: none;
  }

  .watson-reports__nav-link:hover {
    text-decoration: underline;
  }
</style>
