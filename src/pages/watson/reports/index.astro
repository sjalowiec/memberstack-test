---
import WatsonPageShell from "../../../components/watson/WatsonPageShell.astro";
import WatsonStoreSalesByYearReport from "../../../components/watson/WatsonStoreSalesByYearReport.astro";
import { loadStoreSalesByYearReport } from "../../../lib/watson/storeSalesByYearReport";

export const prerender = false;

let reportError: string | null = null;
let report = {
  rows: [],
  totals: {
    orderCount: 0,
    revenueAmount: 0,
    revenueDisplay: "$0.00",
    averageOrderValueAmount: 0,
    averageOrderValueDisplay: "$0.00",
  },
};

try {
  report = await loadStoreSalesByYearReport();
} catch (error) {
  reportError =
    error instanceof Error ? error.message : "Legacy store sales report failed to load.";
}
---

<WatsonPageShell
  title="Reports | Watson"
  description="Historical business reporting from imported legacy Knit It Now data."
  heading="Reports"
  intro="Historical business reporting from imported legacy data."
>
  <nav class="watson-reports__nav" aria-label="Available reports">
    <a class="watson-reports__nav-link" href="/watson/sales/report">
      Sales (collected revenue)
    </a>
    <a class="watson-reports__nav-link" href="/watson/pattern-inspector">
      Saved Pattern Inspector
    </a>
    <a class="watson-reports__nav-link" href="/watson/reports/current-legacy-members">
      Current Legacy Members
    </a>
    <a class="watson-reports__nav-link" href="/watson/reports/remaining-annual-access">
      Remaining Annual Access
    </a>
    <a class="watson-reports__nav-link" href="#legacy-store-sales-by-year">
      Legacy Store Sales by Year
    </a>
  </nav>

  <section class="watson__panel" aria-labelledby="membership-reports-heading">
    <h2 id="membership-reports-heading" class="watson__panel-title">Membership reports</h2>
    <ul class="watson-reports__list">
      <li>
        <a href="/watson/reports/current-legacy-members">Current Legacy Members</a>
        — reproduces the legacy current-member universe from member fields
        (<code>betaactive = 0</code>, <code>subscriptionexpiring &gt;= today</code>).
      </li>
      <li>
        <a href="/watson/reports/remaining-annual-access">Remaining Annual Access</a>
        — classifies current non-monthly members who may need annual/installment migration handling.
      </li>
    </ul>
  </section>

  {
    reportError ? (
      <p class="watson__status watson__status--error" role="alert">
        {reportError}
      </p>
    ) : null
  }

  <WatsonStoreSalesByYearReport report={report} />
</WatsonPageShell>

<style>
  .watson-reports__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .watson-reports__nav-link {
    color: #3f6212;
    font-weight: 600;
    text-decoration: none;
  }

  .watson-reports__nav-link:hover {
    text-decoration: underline;
  }

  .watson-reports__list {
    margin: 0;
    padding-left: 1.2rem;
    color: #475569;
    line-height: 1.55;
  }

  .watson-reports__list a {
    color: #3f6212;
    font-weight: 600;
    text-decoration: none;
  }

  .watson-reports__list a:hover {
    text-decoration: underline;
  }

  .watson-reports__list code {
    font-size: 0.86em;
  }
</style>
