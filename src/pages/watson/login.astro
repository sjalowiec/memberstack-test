---
import { sanitizeStaffLoginNextPath } from "../../lib/watson/watsonAuth";
export const prerender = false;
const params = new URLSearchParams({ next: sanitizeStaffLoginNextPath(Astro.url.searchParams.get("next")) });
if (Astro.url.searchParams.get("error") === "1") params.set("error", "1");
return Astro.redirect(`/admin/login?${params}`, 302);
---
