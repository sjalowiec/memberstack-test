---
import WatsonPageShell from "../../../components/watson/WatsonPageShell.astro";
import { listContactMessages } from "../../../lib/contact/contactMessagesDb";
import {
  RESPONDED_CONTACT_MESSAGE_NOTICE,
  contactFilterHidesResponded,
  contactMessageDetailHref,
  deletedContactMessagesNotice,
  formatContactTimestamp,
  listPreview,
  parseDeletedContactMessageCount,
  readContactMessageListLocation,
  readRespondedContactMessageId,
  respondedContactNoticeLinks,
  statusLabel,
  type ContactMessageFilter,
} from "../../../lib/contact/contactMessageRecord";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");

const FILTERS: { value: ContactMessageFilter; label: string }[] = [
  { value: "new", label: "New" },
  { value: "responded", label: "Responded" },
  { value: "closed", label: "Closed" },
  { value: "all", label: "All" },
];

const listLocation = readContactMessageListLocation(Astro.url.searchParams);
const filter = listLocation.filter;
const deletedCount = parseDeletedContactMessageCount(Astro.url.searchParams.get("deleted"));
const respondedMessageId = readRespondedContactMessageId(Astro.url.searchParams.get("responded"));
const respondedNotice =
  respondedMessageId && contactFilterHidesResponded(filter)
    ? respondedContactNoticeLinks(respondedMessageId, listLocation)
    : null;

function messageHref(id: string): string {
  return contactMessageDetailHref(id, listLocation);
}

let loadError: string | null = null;
let messages: Awaited<ReturnType<typeof listContactMessages>> = [];

try {
  messages = await listContactMessages(filter);
} catch (error) {
  loadError = formatLoadError(error);
}

function formatLoadError(error: unknown): string {
  const message = error instanceof Error ? error.message : "Unable to load contact messages.";
  if (/watson_contact_messages/i.test(message) && /does not exist/i.test(message)) {
    return "Contact messages are not available yet. Apply scripts/sql/watson-contact-messages.sql to the DEV Watson database.";
  }
  return message;
}

function emptyCopy(current: ContactMessageFilter): string {
  switch (current) {
    case "new":
      return "No new contact messages.";
    case "responded":
      return "No responded contact messages.";
    case "closed":
      return "No closed contact messages.";
    default:
      return "No contact messages yet.";
  }
}
---

<WatsonPageShell
  title="Contact Messages | Watson"
  description="Review contact form submissions stored in Watson."
  heading="Contact Messages"
  intro="Every valid contact message is stored here before the notification email is sent. A failed email does not remove the message."
>
  <div data-contact-notices>
    {
      deletedCount ? (
        <p class="watson__status watson__status--success" role="status" data-contact-deleted-notice>
          {deletedContactMessagesNotice(deletedCount)}
        </p>
      ) : null
    }
    {
      respondedNotice ? (
        <p class="watson__status watson__status--success" role="status" data-contact-responded-notice>
          {RESPONDED_CONTACT_MESSAGE_NOTICE}{" "}
          <a href={respondedNotice.viewMessageHref} data-contact-view-message>
            View message
          </a>{" "}
          <a href={respondedNotice.viewRespondedHref} data-contact-view-responded>
            View responded messages
          </a>
        </p>
      ) : null
    }
  </div>

  <nav class="watson-contact__filters" aria-label="Filter contact messages">
    {
      FILTERS.map((item) => (
        <a
          class:list={[
            "watson-contact__filter",
            item.value === filter && "watson-contact__filter--active",
          ]}
          href={`/watson/contact-messages?filter=${item.value}`}
          aria-current={item.value === filter ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  {
    loadError ? (
      <p class="watson__status watson__status--error" role="alert">
        {loadError}
      </p>
    ) : messages.length === 0 ? (
      <p class="watson__status">{emptyCopy(filter)}</p>
    ) : (
      <div
        data-contact-list
        data-contact-filter={filter}
        data-contact-page={listLocation.page ?? 1}
      >
        <p class="watson__status" data-contact-list-empty hidden>
          {emptyCopy(filter)}
        </p>
        <div class="watson-contact__bulk">
          <label class="watson-contact__select-all">
            <input class="watson-contact__checkbox" type="checkbox" data-contact-select-all />
            Select all on this page
          </label>
          <button
            type="button"
            class="watson-contact__action watson-contact__action--danger watson-contact__delete-selected"
            data-contact-delete-selected
            disabled
          >
            Delete selected (0)
          </button>
        </div>
        <p class="watson-contact__bulk-status" data-contact-bulk-status role="alert" hidden></p>
        <div class="watson__table-wrap" data-contact-table-wrap>
          <table class="watson-table watson-contact__table">
            <thead>
              <tr>
                <th class="watson-contact__select-col">Select</th>
                <th>Received</th>
                <th>From</th>
                <th>Message</th>
                <th>Source</th>
                <th>Status</th>
                <th>Open</th>
                <th class="watson-contact__sticky">Actions</th>
              </tr>
            </thead>
            <tbody>
              {messages.map((message) => (
                <tr
                  class:list={[message.status === "new" && "watson-contact__row--new"]}
                  data-contact-row
                  data-contact-row-id={message.id}
                  data-contact-status={message.status}
                  data-contact-label={message.name || message.email}
                >
                  <td class="watson-contact__select-col" data-label="Select">
                    <input
                      class="watson-contact__checkbox"
                      type="checkbox"
                      data-contact-select
                      value={message.id}
                      aria-label={`Select message from ${message.name || message.email}`}
                    />
                  </td>
                  <td data-label="Received">
                    <time datetime={message.createdAt}>{formatContactTimestamp(message.createdAt)}</time>
                  </td>
                  <td data-label="From">
                    <a href={messageHref(message.id)}>
                      {message.name || "(No name)"}
                    </a>
                    <div class="watson-contact__email">{message.email}</div>
                  </td>
                  <td data-label="Message">
                    <a class="watson-contact__message-link" href={messageHref(message.id)}>
                      {listPreview(message.subject, message.message)}
                    </a>
                  </td>
                  <td data-label="Source">{message.source || "—"}</td>
                  <td data-label="Status">
                    <span
                      class:list={[
                        "watson-contact__badge",
                        `watson-contact__badge--${message.status}`,
                      ]}
                      data-contact-status-badge
                    >
                      {statusLabel(message.status)}
                    </span>
                  </td>
                  <td data-label="Open">
                    <a class="watson-contact__open" href={messageHref(message.id)}>
                      Open message
                    </a>
                  </td>
                  <td class="watson-contact__sticky" data-label="Actions">
                    <div class="watson-contact__actions">
                      {
                        message.status === "new" ? (
                          <button
                            type="button"
                            class="watson-contact__action"
                            data-contact-list-respond
                          >
                            Mark Responded
                          </button>
                        ) : null
                      }
                      <button
                        type="button"
                        class="watson-contact__action watson-contact__action--danger"
                        data-contact-list-delete
                      >
                        Delete
                      </button>
                    </div>
                    <p class="watson-contact__row-error" data-contact-row-error role="alert" hidden>
                    </p>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )
  }
</WatsonPageShell>

<style>
  [data-contact-responded-notice] a {
    font-weight: 700;
    margin-left: 0.35rem;
  }

  .watson-contact__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.25rem 0 1rem;
  }

  .watson-contact__filter {
    display: inline-block;
    padding: 0.4rem 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    color: #334155;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    background: #fff;
  }

  .watson-contact__filter--active {
    background: #3f6212;
    border-color: #3f6212;
    color: #fff;
  }

  .watson-contact__table {
    min-width: 40rem;
    /* separate keeps the pinned Actions cells sticky inside the horizontal scroller */
    border-collapse: separate;
    border-spacing: 0;
  }

  .watson-contact__sticky {
    position: sticky;
    right: 0;
    z-index: 1;
    background: var(--page-bg, #f7f8f7);
    box-shadow: -8px 0 6px -6px rgba(15, 23, 42, 0.18);
  }

  .watson-contact__row--new .watson-contact__sticky {
    background: #eff6ff;
  }

  .watson-contact__row--new {
    background: #eff6ff;
  }

  .watson-contact__row--new td[data-label="Received"] {
    box-shadow: inset 3px 0 0 #1d4ed8;
  }

  .watson-contact__bulk {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin: 0 0 0.75rem;
  }

  .watson-contact__select-all {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    color: #334155;
  }

  .watson-contact__select-col {
    width: 4.5rem;
  }

  .watson-contact__checkbox {
    width: 1rem;
    height: 1rem;
    accent-color: #3f6212;
  }

  button.watson-contact__delete-selected:disabled {
    cursor: not-allowed;
  }

  [data-contact-bulk-busy] .watson-contact__delete-selected:disabled {
    cursor: wait;
  }

  .watson-contact__bulk-status {
    margin: 0 0 0.75rem;
    color: #b91c1c;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .watson-contact__message-link {
    color: #243015;
    font-weight: 700;
    text-underline-offset: 0.15em;
  }

  .watson-contact__email {
    color: #475569;
    font-size: 0.85rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .watson-contact__open {
    font-weight: 700;
    white-space: nowrap;
  }

  .watson-contact__badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    background: #e2e8f0;
    color: #334155;
  }

  .watson-contact__badge--new {
    background: #dbeafe;
    color: #1e40af;
  }

  .watson-contact__badge--responded {
    background: #dcfce7;
    color: #166534;
  }

  .watson-contact__badge--closed {
    background: #e2e8f0;
    color: #475569;
  }

  .watson-contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }

  .watson-contact__action {
    padding: 0.28rem 0.55rem;
    border: 1px solid #d9f99d;
    border-radius: 8px;
    background: #f7fee7;
    color: #3f6212;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
    white-space: nowrap;
  }

  .watson-contact__action:hover {
    background: #ecfccb;
  }

  .watson-contact__action:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .watson-contact__action--danger {
    border-color: #fecaca;
    background: #fef2f2;
    color: #991b1b;
  }

  .watson-contact__action--danger:hover {
    background: #fee2e2;
  }

  .watson-contact__row-error {
    margin: 0.35rem 0 0;
    color: #b91c1c;
    font-size: 0.82rem;
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .watson-contact__table {
      min-width: 0;
    }

    .watson-contact__table thead {
      display: none;
    }

    .watson-contact__table,
    .watson-contact__table tbody,
    .watson-contact__table tr,
    .watson-contact__table td {
      display: block;
      width: 100%;
    }

    .watson-contact__table tr {
      margin: 0 0 0.75rem;
      padding: 0.75rem 0.85rem;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      background: #fff;
    }

    .watson-contact__row--new {
      border-color: #93c5fd;
    }

    .watson-contact__table td {
      border: 0;
      padding: 0.2rem 0;
    }

    .watson-contact__table td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.1rem;
      color: #64748b;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .watson-contact__row--new td[data-label="Received"] {
      box-shadow: none;
    }

    .watson-contact__sticky,
    .watson-contact__row--new .watson-contact__sticky {
      position: static;
      right: auto;
      z-index: auto;
      background: transparent;
      box-shadow: none;
    }
  }
</style>

<script>
  import { initWatsonContactMessageList } from "../../../scripts/watsonContactMessages";

  function bootContactMessageList(): void {
    initWatsonContactMessageList(document);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootContactMessageList, { once: true });
  } else {
    bootContactMessageList();
  }

  if (document.documentElement.dataset.contactMessageListBoot !== "true") {
    document.documentElement.dataset.contactMessageListBoot = "true";
    document.addEventListener("astro:page-load", bootContactMessageList);
  }
</script>
