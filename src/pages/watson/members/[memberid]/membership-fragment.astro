---
import WatsonMemberMembershipTable from "../../../../components/watson/WatsonMemberMembershipTable.astro";
import { getMemberMemberships } from "../../../../lib/watson/memberMembership";

export const prerender = false;

const memberid = Astro.params.memberid ? decodeURIComponent(Astro.params.memberid) : "";

if (!memberid) {
  return new Response("Member ID required.", { status: 400 });
}

let records: Awaited<ReturnType<typeof getMemberMemberships>> = [];

try {
  records = await getMemberMemberships(memberid);
} catch (error) {
  const message = error instanceof Error ? error.message : "Unable to load membership history.";
  return new Response(message, { status: 500 });
}
---

<WatsonMemberMembershipTable records={records} />

<script>
  import { initSortableTables } from "../../../../lib/watson/sortableTable";
  initSortableTables(document);
</script>
