---
import WatsonPageShell from "../../components/watson/WatsonPageShell.astro";
import {
  WHATS_NEW_BOARD_COLUMNS,
  WHATS_NEW_CATEGORIES,
  WHATS_NEW_CATEGORY_LABELS,
  WHATS_NEW_DEFAULT_BUTTON_TEXT,
} from "../../lib/whatsNew/types";
import {
  WHATS_NEW_COLUMN_ACCENTS,
  whatsNewCategoryCardStyle,
  whatsNewThemeStyle,
} from "../../lib/whatsNew/palette";
import {
  boardColumnMeta,
  formatQuietPublishDate,
  groupWhatsNewCardsByColumn,
} from "../../lib/whatsNew/public";
import {
  getWhatsNewBillboardSettings,
  listAllWhatsNewCards,
} from "../../lib/whatsNew/store";
import { cardDescriptionPlainText } from "../../lib/whatsNew/sanitizeBillboardHtml";
import { resolveWhatsNewToolIcon } from "../../lib/whatsNew/toolIcon";

export const prerender = false;

const themeStyle = whatsNewThemeStyle();

Astro.response.headers.set("Cache-Control", "no-store");

let loadError: string | null = null;
let activeCards: Awaited<ReturnType<typeof listAllWhatsNewCards>> = [];
let archivedCards: Awaited<ReturnType<typeof listAllWhatsNewCards>> = [];
let billboard: Awaited<ReturnType<typeof getWhatsNewBillboardSettings>> = null;

try {
  const allCards = await listAllWhatsNewCards();
  activeCards = allCards.filter((card) => !card.archived);
  archivedCards = allCards.filter((card) => card.archived);
} catch (error) {
  loadError =
    error instanceof Error
      ? error.message
      : "Unable to load What's New. Apply the schema SQL first.";
}

if (!loadError) {
  try {
    billboard = await getWhatsNewBillboardSettings();
  } catch {
    billboard = null;
  }
}

const board = groupWhatsNewCardsByColumn(activeCards);
const today = new Date().toISOString().slice(0, 10);

function cardDataAttr(card: (typeof activeCards)[number]): string {
  return encodeURIComponent(
    JSON.stringify({
      id: card.id,
      title: card.title,
      description: card.description,
      category: card.category,
      destinationUrl: card.destinationUrl ?? "",
      buttonText: card.buttonText ?? "",
      boardColumn: card.boardColumn,
      publishDate: card.publishDate,
      featured: card.featured,
      status: card.status,
      displayOrder: card.displayOrder,
      archived: card.archived,
    }),
  );
}
---

<WatsonPageShell
  title="What's New | Watson"
  description="Manage the public What's New board and the What's New Billboard."
  heading="What's New"
  intro="Add updates, organize the public board, and manage the What's New Billboard."
>
  <div data-whats-new-admin class="watson-wn" style={themeStyle}>
    <div class="watson-wn__toolbar">
      <button type="button" class="watson__button" data-wn-open-create>Add Update</button>
      <a class="watson__button watson__button--secondary" href="/whats-new" target="_blank" rel="noopener">
        View public page
      </a>
    </div>

    <p class="watson__status watson-wn__flash" data-wn-flash role="status" hidden></p>

    {
      loadError ? (
        <p class="watson__status watson__status--error" role="alert">
          {loadError}
        </p>
      ) : null
    }

    <details class="watson__panel watson-wn__billboard" data-wn-billboard-panel>
      <summary class="watson-wn__billboard-summary">
        <span class="watson-wn__billboard-summary-heading">
          <span class="watson__panel-title watson-wn__billboard-summary-title">
            What's New Billboard
          </span>
          <span
            class={`watson-wn__billboard-status watson-wn__billboard-status--${billboard?.enabled ? "on" : "off"}`}
          >
            {billboard?.enabled ? "Enabled" : "Disabled"}
          </span>
        </span>
        <span class="watson-wn__billboard-summary-meta">
          {
            billboard?.headline ? (
              <span class="watson-wn__billboard-summary-headline">{billboard.headline}</span>
            ) : null
          }
          {
            billboard?.updatedAt ? (
              <span class="watson-wn__billboard-summary-updated">
                Last updated {formatQuietPublishDate(billboard.updatedAt.slice(0, 10))}
              </span>
            ) : null
          }
        </span>
        <span class="watson-wn__billboard-edit-cue">Edit billboard</span>
      </summary>
      <div class="watson-wn__billboard-body">
      <p class="watson-wn__hint">
        Optional top message for /whats-new. Video and button are optional. Dates use America/Los_Angeles
        calendar days. Leave disabled to hide the billboard.
      </p>
      {
        billboard === null && !loadError ? (
          <p class="watson__status watson__status--error" role="status">
            Billboard fields are not available yet. Apply scripts/sql/watson-whats-new-billboard.sql,
            then refresh.
          </p>
        ) : null
      }
      <form class="watson-wn__form" data-wn-video-form>
        <div class="watson-wn__grid">
          <label class="watson-wn__field watson-wn__field--full">
            <span>Headline</span>
            <input
              class="watson__search-input"
              name="headline"
              type="text"
              maxlength="160"
              value={billboard?.headline ?? ""}
            />
          </label>
          <div class="watson-wn__field watson-wn__field--full">
            <span id="wn-billboard-message-label">Short message</span>
            <div class="watson-wn__rte" data-wn-rte>
              <div
                class="watson-wn__rte-toolbar"
                data-wn-rte-toolbar
                role="toolbar"
                aria-label="Message formatting"
              >
                <button type="button" class="watson-wn__rte-btn" data-wn-rte-cmd="bold" title="Bold">
                  <strong>B</strong>
                </button>
                <button type="button" class="watson-wn__rte-btn" data-wn-rte-cmd="italic" title="Italic">
                  <em>I</em>
                </button>
                <button type="button" class="watson-wn__rte-btn" data-wn-rte-cmd="paragraph" title="Paragraph">
                  ?
                </button>
                <button type="button" class="watson-wn__rte-btn" data-wn-rte-cmd="ul" title="Bulleted list">
                  ? List
                </button>
                <button type="button" class="watson-wn__rte-btn" data-wn-rte-cmd="ol" title="Numbered list">
                  1. List
                </button>
                <button type="button" class="watson-wn__rte-btn" data-wn-rte-cmd="link" title="Add or edit link">
                  Link
                </button>
                <button
                  type="button"
                  class="watson-wn__rte-btn"
                  data-wn-rte-cmd="clear"
                  title="Remove formatting"
                >
                  Clear
                </button>
              </div>
              <div
                class="watson-wn__rte-editor"
                data-wn-rte-editor
                contenteditable="true"
                role="textbox"
                aria-multiline="true"
                aria-labelledby="wn-billboard-message-label"
              ></div>
              <textarea
                class="watson-wn__rte-input"
                data-wn-rte-input
                name="message"
                maxlength="5000"
                hidden
                tabindex="-1"
                aria-hidden="true">{billboard?.message ?? ""}</textarea>
            </div>
          </div>
          <label class="watson-wn__field watson-wn__field--full">
            <span>Vimeo URL (optional)</span>
            <input
              class="watson__search-input"
              name="videoUrl"
              type="url"
              maxlength="500"
              placeholder="https://vimeo.com/123456789"
              value={billboard?.originalVideoUrl ?? ""}
            />
          </label>
          <label class="watson-wn__field">
            <span>Button text (optional)</span>
            <input
              class="watson__search-input"
              name="buttonText"
              type="text"
              maxlength="60"
              value={billboard?.buttonText ?? ""}
            />
          </label>
          <label class="watson-wn__field">
            <span>Button destination URL (optional)</span>
            <input
              class="watson__search-input"
              name="buttonDestinationUrl"
              type="text"
              maxlength="500"
              placeholder="/tools or https://..."
              value={billboard?.buttonDestinationUrl ?? ""}
            />
          </label>
          <label class="watson-wn__field">
            <span>Start date (optional)</span>
            <input
              class="watson__search-input"
              name="startDate"
              type="date"
              value={billboard?.startDate ?? ""}
            />
          </label>
          <label class="watson-wn__field">
            <span>End date (optional)</span>
            <input
              class="watson__search-input"
              name="endDate"
              type="date"
              value={billboard?.endDate ?? ""}
            />
          </label>
        </div>
        <div class="watson-wn__actions watson-wn__actions--billboard">
          <label class="watson-wn__check">
            <input type="checkbox" name="enabled" checked={billboard?.enabled === true} />
            <span>Enabled on public page</span>
          </label>
          {
            billboard?.updatedAt ? (
              <p class="watson-wn__updated">
                Last updated: {formatQuietPublishDate(billboard.updatedAt.slice(0, 10))}
              </p>
            ) : null
          }
          <button type="submit" class="watson__button">Save billboard</button>
          <p class="watson__status" data-wn-video-status tabindex="-1" hidden></p>
        </div>
      </form>
      </div>
    </details>

    <section class="watson__panel" aria-labelledby="wn-form-heading" data-wn-form-panel hidden>
      <h2 id="wn-form-heading" class="watson__panel-title" data-wn-form-title>Add Update</h2>
      <form class="watson-wn__form" data-wn-card-form>
        <input type="hidden" name="id" value="" />
        <div class="watson-wn__grid">
          <label class="watson-wn__field watson-wn__field--full">
            <span>Title</span>
            <input class="watson__search-input" name="title" type="text" required maxlength="160" />
          </label>
          <div class="watson-wn__field watson-wn__field--full">
            <span id="wn-card-description-label">Short description</span>
            <div class="watson-wn__rte watson-wn__rte--compact" data-wn-card-rte>
              <div
                class="watson-wn__rte-toolbar"
                data-wn-rte-toolbar
                role="toolbar"
                aria-label="Description formatting"
              >
                <button type="button" class="watson-wn__rte-btn" data-wn-rte-cmd="bold" title="Bold">
                  <strong>B</strong>
                </button>
                <button type="button" class="watson-wn__rte-btn" data-wn-rte-cmd="italic" title="Italic">
                  <em>I</em>
                </button>
                <button type="button" class="watson-wn__rte-btn" data-wn-rte-cmd="ul" title="Bulleted list">
                  ? List
                </button>
                <button type="button" class="watson-wn__rte-btn" data-wn-rte-cmd="ol" title="Numbered list">
                  1. List
                </button>
                <button
                  type="button"
                  class="watson-wn__rte-btn"
                  data-wn-rte-cmd="clear"
                  title="Clear formatting"
                >
                  Clear
                </button>
              </div>
              <div
                class="watson-wn__rte-editor"
                data-wn-rte-editor
                contenteditable="true"
                role="textbox"
                aria-multiline="true"
                aria-labelledby="wn-card-description-label"
              ></div>
              <textarea
                class="watson-wn__rte-input"
                data-wn-rte-input
                name="description"
                maxlength="4000"
                hidden
                tabindex="-1"
                aria-hidden="true"></textarea>
            </div>
          </div>
          <label class="watson-wn__field">
            <span>Category</span>
            <select class="watson__search-input" name="category" required>
              {
                WHATS_NEW_CATEGORIES.map((category) => (
                  <option value={category}>{WHATS_NEW_CATEGORY_LABELS[category]}</option>
                ))
              }
            </select>
          </label>
          <label class="watson-wn__field">
            <span>Board column</span>
            <select class="watson__search-input" name="boardColumn" required>
              {
                WHATS_NEW_BOARD_COLUMNS.map((column) => (
                  <option value={column}>{boardColumnMeta(column).title}</option>
                ))
              }
            </select>
          </label>
          <label class="watson-wn__field watson-wn__field--full">
            <span>Destination URL (optional)</span>
            <input
              class="watson__search-input"
              name="destinationUrl"
              type="text"
              maxlength="500"
              placeholder="/tools/slope or https://..."
            />
          </label>
          <label class="watson-wn__field">
            <span>Button text</span>
            <input
              class="watson__search-input"
              name="buttonText"
              type="text"
              maxlength="60"
              value={WHATS_NEW_DEFAULT_BUTTON_TEXT.tool}
            />
          </label>
          <label class="watson-wn__field">
            <span>Publish date</span>
            <input class="watson__search-input" name="publishDate" type="date" value={today} required />
          </label>
          <label class="watson-wn__field">
            <span>Status</span>
            <select class="watson__search-input" name="status">
              <option value="published" selected>Published</option>
              <option value="draft">Draft</option>
            </select>
          </label>
          <label class="watson-wn__field">
            <span>Display order</span>
            <input class="watson__search-input" name="displayOrder" type="number" value="0" step="1" />
          </label>
          <label class="watson-wn__check">
            <input type="checkbox" name="featured" />
            <span>Featured</span>
          </label>
          <label class="watson-wn__check">
            <input type="checkbox" name="archived" />
            <span>Archived</span>
          </label>
        </div>
        <div class="watson-wn__actions">
          <button type="submit" class="watson__button">Save</button>
          <button type="button" class="watson__button watson__button--secondary" data-wn-cancel-form>
            Cancel
          </button>
          <button type="button" class="watson__button watson__button--secondary" data-wn-open-create>
            Reset as new
          </button>
          <p class="watson__status" data-wn-form-status hidden></p>
        </div>
      </form>
    </section>

    <section class="watson__panel" aria-labelledby="wn-board-heading">
      <div class="watson-wn__board-head">
        <h2 id="wn-board-heading" class="watson__panel-title">Board</h2>
        <button type="button" class="watson__button" data-wn-open-create>Add Update</button>
      </div>

      <div class="watson-wn__board">
        {
          WHATS_NEW_BOARD_COLUMNS.map((column) => {
            const meta = boardColumnMeta(column);
            const cards = board[column];
            return (
              <section
                class={`watson-wn__column watson-wn__column--${column}`}
                style={`--wn-col-accent: ${WHATS_NEW_COLUMN_ACCENTS[column]}`}
                aria-labelledby={`wn-col-${column}`}
              >
                <h3 id={`wn-col-${column}`} class="watson-wn__column-title">
                  {meta.title}
                </h3>
                <p class="watson-wn__column-sub">{meta.subtitle}</p>
                {cards.length === 0 ? (
                  <p class="watson-wn__empty">No cards in this column.</p>
                ) : (
                  <ul class="watson-wn__cards">
                    {cards.map((card) => {
                      const toolIcon = resolveWhatsNewToolIcon(card);
                      return (
                      <li
                        class={`watson-wn__card${card.featured ? " watson-wn__card--featured" : ""}`}
                        style={whatsNewCategoryCardStyle(card.category)}
                      >
                        <div class="watson-wn__card-meta">
                          <span class="watson-wn__category">{card.categoryLabel}</span>
                          <span>{card.status}</span>
                          {card.featured ? (
                            <span class="watson-wn__badge watson-wn__badge--featured">featured</span>
                          ) : null}
                        </div>
                        <div class="watson-wn__card-head">
                          {toolIcon ? (
                            <img
                              class="watson-wn__tool-icon"
                              src={toolIcon}
                              alt=""
                              width="40"
                              height="40"
                              loading="lazy"
                              decoding="async"
                            />
                          ) : null}
                          <strong>{card.title}</strong>
                        </div>
                        <p class="watson-wn__card-desc">{cardDescriptionPlainText(card.description)}</p>
                        <p class="watson-wn__quiet">
                          {formatQuietPublishDate(card.publishDate)}
                          {card.destinationUrl ? ` ? ${card.destinationUrl}` : " ? no URL"}
                          {` ? order ${card.displayOrder}`}
                        </p>
                        <div class="watson-wn__card-actions">
                          <button
                            type="button"
                            class="watson__button watson__button--secondary"
                            data-wn-edit={cardDataAttr(card)}
                          >
                            Edit
                          </button>
                          <label class="watson-wn__move">
                            <span class="visually-hidden">Move to</span>
                            <select class="watson__search-input" data-wn-move data-wn-id={card.id}>
                              {WHATS_NEW_BOARD_COLUMNS.map((option) => (
                                <option value={option} selected={option === card.boardColumn}>
                                  Move to {boardColumnMeta(option).title}
                                </option>
                              ))}
                            </select>
                          </label>
                          <button
                            type="button"
                            class="watson__button watson__button--secondary"
                            data-wn-action={card.featured ? "unfeature" : "feature"}
                            data-wn-id={card.id}
                          >
                            {card.featured ? "Unfeature" : "Feature"}
                          </button>
                          <button
                            type="button"
                            class="watson__button watson__button--secondary"
                            data-wn-action={card.status === "published" ? "unpublish" : "publish"}
                            data-wn-id={card.id}
                          >
                            {card.status === "published" ? "Unpublish" : "Publish"}
                          </button>
                          <button
                            type="button"
                            class="watson__button watson__button--secondary"
                            data-wn-action="archive"
                            data-wn-id={card.id}
                          >
                            Archive
                          </button>
                          {card.status === "draft" || card.archived ? (
                            <button
                              type="button"
                              class="watson__button watson-wn__button--danger"
                              data-wn-delete
                              data-wn-id={card.id}
                              data-wn-title={card.title}
                            >
                              Delete permanently
                            </button>
                          ) : null}
                        </div>
                      </li>
                      );
                    })}
                  </ul>
                )}
              </section>
            );
          })
        }
      </div>
    </section>

    <details class="watson__panel watson-wn__archived">
      <summary class="watson__panel-title">Archived items ({archivedCards.length})</summary>
      <p class="watson-wn__hint">Archiving hides a card from the public page without deleting it.</p>
      {
        archivedCards.length === 0 ? (
          <p class="watson-wn__empty">No archived cards.</p>
        ) : (
          <ul class="watson-wn__cards">
            {archivedCards.map((card) => (
              <li class="watson-wn__card" style={whatsNewCategoryCardStyle(card.category)}>
                <div class="watson-wn__card-meta">
                  <span class="watson-wn__category">{card.categoryLabel}</span>
                  <span>{boardColumnMeta(card.boardColumn).title}</span>
                  <span>{card.status}</span>
                </div>
                <strong>{card.title}</strong>
                <p class="watson-wn__card-desc">{cardDescriptionPlainText(card.description)}</p>
                <div class="watson-wn__card-actions">
                  <button
                    type="button"
                    class="watson__button watson__button--secondary"
                    data-wn-edit={cardDataAttr(card)}
                  >
                    Edit
                  </button>
                  <button
                    type="button"
                    class="watson__button"
                    data-wn-action="restore"
                    data-wn-id={card.id}
                  >
                    Restore
                  </button>
                  <button
                    type="button"
                    class="watson__button watson-wn__button--danger"
                    data-wn-delete
                    data-wn-id={card.id}
                    data-wn-title={card.title}
                  >
                    Delete permanently
                  </button>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </details>
  </div>
</WatsonPageShell>

<script>
  import { initWatsonBillboardRichText } from "../../scripts/watsonBillboardRichText";
  import { initWatsonCardRichText } from "../../scripts/watsonCardRichText";
  import { initWatsonWhatsNew } from "../../scripts/watsonWhatsNew";
  initWatsonBillboardRichText(document);
  initWatsonCardRichText(document);
  initWatsonWhatsNew(document);
</script>

<style>
  .watson-wn__toolbar,
  .watson-wn__board-head,
  .watson-wn__actions,
  .watson-wn__card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }

  .watson-wn__toolbar,
  .watson-wn__board-head {
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .watson-wn__hint,
  .watson-wn__column-sub,
  .watson-wn__quiet,
  .watson-wn__empty {
    color: #5b6470;
    font-size: 0.92rem;
  }

  .watson-wn__form {
    margin-top: 0.75rem;
  }

  .watson-wn__actions--billboard {
    margin-top: 0.85rem;
  }

  .watson-wn__updated {
    margin: 0;
    color: #5b6470;
    font-size: 0.9rem;
  }

  /* Billboard accordion: edited occasionally, so collapsed by default to keep
     the card editor and board within easy reach. Uses native <details>. */
  .watson-wn__billboard-summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.2rem 0.75rem;
    /* Compact: no large minimum height when collapsed. */
    padding: 0.1rem 0;
  }

  .watson-wn__billboard-summary::-webkit-details-marker {
    display: none;
  }

  .watson-wn__billboard-summary-heading {
    grid-column: 1;
    grid-row: 1;
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.3rem 0.5rem;
    min-width: 0;
  }

  .watson-wn__billboard-summary-title {
    margin: 0;
  }

  .watson-wn__billboard-status {
    font-size: 0.92rem;
    font-weight: 600;
  }

  .watson-wn__billboard-status::before {
    content: "\00b7";
    margin-right: 0.5rem;
    color: #9aa2ac;
    font-weight: 400;
  }

  .watson-wn__billboard-status--on {
    color: #2f7d32;
  }

  .watson-wn__billboard-status--off {
    color: #5b6470;
  }

  .watson-wn__billboard-edit-cue {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    justify-self: end;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--kbm-green, #52682d);
    border: 1px solid #c9d0c0;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }

  .watson-wn__billboard[open] .watson-wn__billboard-edit-cue::after {
    content: " \2013 open";
    color: #5b6470;
    font-weight: 400;
  }

  .watson-wn__billboard-summary-meta {
    grid-column: 1 / -1;
    grid-row: 2;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    color: #5b6470;
    font-size: 0.9rem;
    min-width: 0;
  }

  .watson-wn__billboard-summary-meta:empty {
    display: none;
  }

  .watson-wn__billboard-summary-meta > *:not(:first-child)::before {
    content: "\00b7";
    margin-right: 0.35rem;
    color: #9aa2ac;
  }

  .watson-wn__billboard-summary-headline {
    font-weight: 600;
    color: #2c3a57;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: min(48ch, 100%);
  }

  .watson-wn__billboard-summary:focus-visible {
    outline: 2px solid #c5d4b0;
    outline-offset: 3px;
    border-radius: 8px;
  }

  .watson-wn__billboard-body {
    margin-top: 0.85rem;
  }

  .watson-wn__grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .watson-wn__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

