---
import WatsonPageShell from "../../components/watson/WatsonPageShell.astro";
import { loadMemberThankYouPage } from "../../lib/watson/memberThankYouLoad";
import { MEMBER_THANK_YOU_START_YMD } from "../../lib/watson/memberThankYouRules";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");

const page = await loadMemberThankYouPage({
  now: new Date(),
  from: Astro.url.searchParams.get("from"),
  to: Astro.url.searchParams.get("to"),
  filter: Astro.url.searchParams.get("show"),
  origin: Astro.url.origin,
});

const filters = [
  { id: "todo", label: "To Do" },
  { id: "completed", label: "Completed" },
  { id: "all", label: "All" },
  { id: "video", label: "Video needed" },
  { id: "card", label: "Card needed" },
  { id: "address", label: "Missing address" },
] as const;
const videoActionsReady = page.statusesAvailable && page.videoColumnsAvailable;
---

<WatsonPageShell
  title="Member Thank-Yous | Watson"
  description="Track video and handwritten-card thank-yous for annual membership payments."
  heading="Member Thank-Yous"
  intro="Manage your membership thank-you cards and videos."
>
  <div
    class="watson-thanks"
    data-member-thank-yous
    data-thanks-view={page.filter}
    data-statuses-available={page.statusesAvailable ? "true" : "false"}
    data-video-columns={page.videoColumnsAvailable ? "true" : "false"}
  >
    <form class="watson-thanks__filters" method="get" action="/watson/member-thank-yous">
      <label class="watson-thanks__filter">
        <span>Show</span>
        <select name="show">
          {filters.map((filter) => (
            <option value={filter.id} selected={page.filter === filter.id}>
              {filter.label}
            </option>
          ))}
        </select>
      </label>
      <label class="watson-thanks__filter">
        <span>From</span>
        <input type="date" name="from" min={MEMBER_THANK_YOU_START_YMD} value={page.fromCivil} />
      </label>
      <label class="watson-thanks__filter">
        <span>To</span>
        <input type="date" name="to" min={MEMBER_THANK_YOU_START_YMD} value={page.toCivil} />
      </label>
      <button class="watson__button watson-thanks__apply" type="submit">Apply</button>
    </form>

    {page.error ? (
      <p class="watson__status watson__status--error" role="alert">{page.error}</p>
    ) : null}
    {page.warnings.map((warning) => (
      <p class="watson-thanks__warning" role="status">{warning}</p>
    ))}

    <p class="watson-thanks__count" data-thanks-count data-total={page.totalInRange}>
      Showing {page.rows.length} of {page.totalInRange} payment{page.totalInRange === 1 ? "" : "s"} in this date range.
    </p>

    <p class="watson-thanks__empty" data-thanks-empty hidden={page.rows.length > 0 || Boolean(page.error)}>
      No annual membership payments match this view.
    </p>

    <ul class="watson-thanks__list">
      {page.rows.map((row) => (
        <li
          class="watson-thanks__row"
          data-thanks-card
          data-charge-id={row.stripeChargeId}
          data-member-name={row.displayName}
          data-member-email={row.email ?? ""}
          data-completed={row.completed ? "true" : "false"}
        >
          <button type="button" class="watson-thanks__name" data-thanks-open data-thanks-name>
            {row.displayName}
          </button>
          <span class="watson-thanks__date">{row.paymentDateLabel}</span>
          <span class="watson-thanks__status" data-thanks-status>{row.completed ? "Completed" : "To Do"}</span>
          <button type="button" class="watson__button watson__button--secondary watson-thanks__open" data-thanks-open>
            View details
          </button>
          <div class="watson-thanks__details" data-thanks-details data-charge-id={row.stripeChargeId} hidden>
            <p class="watson-thanks__kind">{row.kindLabel}</p>

          <label class="watson-thanks__check watson-thanks__check--complete">
            <input
              type="checkbox"
              data-thanks-completed
              checked={row.completed}
              disabled={!videoActionsReady}
              aria-label={`Completed for ${row.displayName}`}
            />
            <span>
              <span class="watson-thanks__check-label">Completed</span>
              <span class="watson-thanks__sent-date" data-thanks-completed-label hidden={!row.completedLabel}>
                {row.completedLabel}
              </span>
            </span>
          </label>

          {row.email ? (
            <p class="watson-thanks__email-row">
              <a class="watson-thanks__email" href={`mailto:${row.email}`}>{row.email}</a>
              <button type="button" class="watson-thanks__copy" data-thanks-copy data-email={row.email}>
                Copy email
              </button>
              <span class="watson-thanks__copy-note" data-thanks-copy-note></span>
            </p>
          ) : (
            <p class="watson-thanks__email">Email not on file</p>
          )}

          <dl class="watson-thanks__facts">
            <div>
              <dt>Payment date</dt>
              <dd>{row.paymentDateLabel}</dd>
            </div>
            <div>
              <dt>Membership plan</dt>
              <dd>{row.planLabel}</dd>
            </div>
          </dl>

          <div class="watson-thanks__address">
            {row.addressLines ? (
              <>
                <p class="watson-thanks__address-label">{row.addressLabel}</p>
                <p class="watson-thanks__address-lines">{row.addressLines}</p>
              </>
            ) : (
              <p class="watson-thanks__address-missing">{row.noAddressMessage}</p>
            )}
            {row.addressNote ? <p class="watson-thanks__address-flag">{row.addressNote}</p> : null}
          </div>

          {row.profileHref ? (
            <p class="watson-thanks__profile">
              <a href={row.profileHref}>Open member record</a>
            </p>
          ) : null}

          <section class="watson-thanks__video" aria-label={`Thank-you video for ${row.displayName}`}>
            <h3 class="watson-thanks__video-title">Thank-you video</h3>
            {row.email && videoActionsReady ? (
              <form data-thanks-video-form>
                <label class="watson-thanks__filter">
                  <span>Vimeo URL</span>
                  <input
                    type="url"
                    required
                    maxlength="500"
                    data-thanks-vimeo-url
                    value={row.videoOriginalUrl ?? ""}
                    placeholder="https://vimeo.com/123456789/privacyhash"
                  />
                </label>
                <button class="watson__button" type="submit" data-thanks-video-submit>
                  {row.videoReplyId ? "Update thank-you video" : "Add thank-you video"}
                </button>
              </form>
            ) : (
              <p class="watson-thanks__video-note">
                {row.email
                  ? "Video links can be saved after the thank-you video migration is applied."
                  : "This payment has no email, so a viewing link cannot be created."}
              </p>
            )}
            <p class="watson-thanks__save" data-thanks-video-status hidden></p>
            <div data-thanks-video-ready hidden={!row.videoPublicUrl}>
              <label class="watson-thanks__filter">
                <span>Public viewing link</span>
                <input type="text" readonly data-thanks-video-link value={row.videoPublicUrl ?? ""} />
              </label>
              <div class="watson-thanks__video-actions">
                <a
                  data-thanks-video-preview
                  href={row.videoPublicUrl ?? "#"}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Preview
                </a>
                <button type="button" class="watson-thanks__copy" data-thanks-copy-target="link">Copy link</button>
                <button type="button" class="watson-thanks__copy" data-thanks-copy-target="email">Copy email</button>
                <button type="button" class="watson-thanks__copy" data-thanks-copy-target="subject">Copy subject</button>
                <span class="watson-thanks__copy-note" data-thanks-video-copy-note></span>
              </div>
              {row.videoLinkDisabled ? (
                <p class="watson-thanks__address-flag">This viewing link is disabled.</p>
              ) : null}
              <label class="watson-thanks__filter">
                <span>Subject</span>
                <input type="text" readonly data-thanks-subject value={row.emailSubject ?? ""} />
              </label>
              <label class="watson-thanks__filter">
                <span>Message</span>
                <textarea class="watson-thanks__message" rows="8" data-thanks-message>{row.emailMessage ?? ""}</textarea>
              </label>
              <div class="watson-thanks__video-actions">
                <button type="button" class="watson-thanks__copy" data-thanks-copy-target="message">Copy message</button>
                <button
                  type="button"
                  class="watson__button"
                  data-thanks-mark-video-sent
                  disabled={!row.videoPublicUrl || row.videoSent}
                >
                  Mark video email sent
                </button>
              </div>
            </div>
          </section>

          <div class="watson-thanks__checks">
            <label class="watson-thanks__check">
              <input
                type="checkbox"
                data-thanks-field="video"
                checked={row.videoSent}
                disabled={!page.statusesAvailable}
                aria-label={`Video sent for ${row.displayName}`}
              />
              <span>
                <span class="watson-thanks__check-label">Video sent</span>
                <span class="watson-thanks__sent-date" data-thanks-video-date hidden={!row.videoSentLabel}>
                  {row.videoSentLabel}
                </span>
              </span>
            </label>
            <label class="watson-thanks__check">
              <input
                type="checkbox"
                data-thanks-field="card"
                checked={row.cardSent}
                disabled={!page.statusesAvailable}
                aria-label={`Card sent for ${row.displayName}`}
              />
              <span>
                <span class="watson-thanks__check-label">Card sent</span>
                <span class="watson-thanks__sent-date" data-thanks-card-date hidden={!row.cardSentLabel}>
                  {row.cardSentLabel}
                </span>
              </span>
            </label>
          </div>
          <p class="watson-thanks__save" data-thanks-save hidden></p>
          </div>
        </li>
      ))}
    </ul>

    <dialog class="watson-thanks__dialog" data-thanks-dialog aria-labelledby="thanks-dialog-title">
      <div class="watson-thanks__dialog-head">
        <h2 id="thanks-dialog-title" class="watson-thanks__dialog-title" data-thanks-dialog-title>Member</h2>
        <button type="button" class="watson__button watson__button--secondary" data-thanks-close>
          Close
        </button>
      </div>
      <div class="watson-thanks__dialog-body" data-thanks-dialog-body></div>
    </dialog>
  </div>
</WatsonPageShell>

<script>
  import { initWatsonMemberThankYous } from "../../scripts/watsonMemberThankYous";
  initWatsonMemberThankYous();
</script>

<style is:global>
  .watson:has(.watson-thanks) {
    max-width: 56rem;
  }

  .watson-thanks {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .watson-thanks__filters {
    display: grid;
    gap: 0.85rem;
  }

  .watson-thanks__apply {
    min-height: 2.75rem;
    width: 100%;
  }

  .watson-thanks__filter {
    display: grid;
    gap: 0.35rem;
    font-weight: 700;
    color: #243015;
  }

  .watson-thanks__filter span {
    font-size: 0.85rem;
  }

  .watson-thanks__filter select,
  .watson-thanks__filter input {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: 2.75rem;
    padding: 0.45rem 0.7rem;
    font: inherit;
    font-size: 1rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #fff;
  }

  .watson-thanks__warning,
  .watson-thanks__count,
  .watson-thanks__empty {
    margin: 0;
    line-height: 1.45;
  }

  .watson-thanks__warning {
    padding: 0.75rem 0.85rem;
    border: 1px solid #fde68a;
    border-radius: 8px;
    background: #fffbeb;
    color: #92400e;
  }

  .watson-thanks__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid #cbd5e1;
  }

  .watson-thanks__row {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) auto auto auto;
    gap: 0.35rem 1rem;
    align-items: center;
    min-width: 0;
    padding: 0.7rem 0.15rem;
    border-bottom: 1px solid #cbd5e1;
    background: #fff;
  }

  .watson-thanks__name {
    margin: 0;
    padding: 0.35rem 0;
    min-height: 2.75rem;
    border: 0;
    background: transparent;
    color: #243015;
    font: inherit;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    cursor: pointer;
    overflow-wrap: anywhere;
  }

  .watson-thanks__name:hover,
  .watson-thanks__name:focus-visible {
    color: #3f6212;
  }

  .watson-thanks__date {
    color: #243015;
    font-size: 1rem;
    line-height: 1.35;
    white-space: nowrap;
  }

  .watson-thanks__status {
    color: #9a3412;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
  }

  .watson-thanks__row[data-completed="true"] .watson-thanks__status {
    color: #3f6212;
  }

  .watson-thanks__open {
    min-height: 2.75rem;
    white-space: nowrap;
  }

  .watson-thanks__details {
    display: grid;
    gap: 0.85rem;
  }

  .watson-thanks__details[hidden] {
    display: none !important;
  }

  .watson-thanks__dialog {
    width: min(40rem, calc(100vw - 1rem));
    max-height: calc(100dvh - 1rem);
    margin: auto;
    padding: 0;
    overflow: auto;
    color: #243015;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }

  .watson-thanks__dialog::backdrop {
    background: rgba(15, 23, 42, 0.45);
  }

  .watson-thanks__dialog-head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    background: #fff;
    border-bottom: 1px solid #e2e8f0;
  }

  .watson-thanks__dialog-title {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .watson-thanks__dialog-head .watson__button {
    min-height: 2.75rem;
    flex: 0 0 auto;
  }

  .watson-thanks__dialog-body {
    padding: 1rem 1.1rem 1.25rem;
  }

  .watson-thanks__kind {
    margin: 0;
    font-weight: 700;
    color: #3f6212;
  }

  .watson-thanks__email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.75rem;
    margin: 0;
    min-width: 0;
  }

  .watson-thanks__email {
    overflow-wrap: anywhere;
    font-size: 1.05rem;
  }

  .watson-thanks__copy {
    min-height: 2.75rem;
    padding: 0.4rem 0.8rem;
    font: inherit;
    font-weight: 700;
    color: #243015;
    background: #fff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
  }

  .watson-thanks__copy-note {
    font-size: 0.9rem;
    color: #3f6212;
  }

  .watson-thanks__facts {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }

  .watson-thanks__facts div {
    display: grid;
    gap: 0.1rem;
  }

  .watson-thanks__facts dt {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #64748b;
  }

  .watson-thanks__facts dd,
  .watson-thanks__address-lines,
  .watson-thanks__address-label,
  .watson-thanks__address-missing,
  .watson-thanks__address-flag,
  .watson-thanks__profile {
    margin: 0;
  }

  .watson-thanks__address-lines {
    white-space: pre-line;
    overflow-wrap: anywhere;
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .watson-thanks__address-label,
  .watson-thanks__address-missing {
    font-weight: 700;
  }

  .watson-thanks__address-flag {
    color: #9a3412;
    font-weight: 700;
  }

  .watson-thanks__checks {
    display: grid;
    gap: 0.65rem;
  }

  .watson-thanks__check {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    min-height: 3rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    background: #f8fafc;
  }

  .watson-thanks__check--complete {
    border: 2px solid #3f6212;
    background: #f7fee7;
  }

  .watson-thanks__check input {
    width: 1.6rem;
    height: 1.6rem;
    margin-top: 0.1rem;
    accent-color: #3f6212;
  }

  .watson-thanks__check-label {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .watson-thanks__sent-date {
    display: block;
    margin-top: 0.15rem;
    color: #475569;
  }

  .watson-thanks__save {
    margin: 0;
    font-weight: 700;
  }

  .watson-thanks__save--ok {
    color: #3f6212;
  }

  .watson-thanks__save--error {
    color: #b91c1c;
  }

  .watson-thanks a {
    color: #3f6212;
    font-weight: 700;
  }

  .watson-thanks__video {
    display: grid;
    gap: 0.65rem;
    min-width: 0;
  }

  .watson-thanks__video-title {
    margin: 0;
    font-size: 1rem;
  }

  .watson-thanks__video-note,
  .watson-thanks__video form {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }

  .watson-thanks__video-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.75rem;
    align-items: center;
  }

  .watson-thanks__message {
    box-sizing: border-box;
    width: 100%;
    min-height: 9rem;
    padding: 0.55rem 0.7rem;
    font: inherit;
    line-height: 1.45;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    resize: vertical;
  }

  .watson-thanks__name:focus-visible,
  .watson-thanks__open:focus-visible,
  .watson-thanks__dialog-head .watson__button:focus-visible,
  .watson-thanks__copy:focus-visible,
  .watson-thanks__check input:focus-visible {
    outline: 2px solid #3f6212;
    outline-offset: 2px;
  }

  @media (min-width: 720px) {
    .watson-thanks__filters {
      grid-template-columns: minmax(9rem, 0.8fr) minmax(10.5rem, 1fr) minmax(10.5rem, 1fr) auto;
      align-items: end;
      gap: 0.75rem;
    }

    .watson-thanks__apply {
      width: auto;
    }
  }

  @media (max-width: 719px) {
    .watson-thanks__row {
      grid-template-columns: 1fr auto;
      gap: 0.45rem 0.75rem;
      padding: 0.9rem 0.1rem;
    }

    .watson-thanks__name,
    .watson-thanks__open {
      grid-column: 1 / -1;
    }

    .watson-thanks__open {
      width: 100%;
    }

    .watson-thanks__status {
      justify-self: end;
    }
  }
</style>
