---
import WatsonCustomerAccordionInit from "../../components/watson/WatsonCustomerAccordionInit.astro";
import WatsonCustomerAccordionSection from "../../components/watson/WatsonCustomerAccordionSection.astro";
import WatsonPageShell from "../../components/watson/WatsonPageShell.astro";
import { SUPPORT_RESPONSE_TEMPLATES } from "../../lib/watson/supportResponses";

export const prerender = false;
---

<WatsonPageShell
  title="Responses | Watson"
  description="Saved email responses for Knit It Now support."
  heading="Responses"
  intro="Copy a saved email response into your message."
>
  <div
    class="watson-responses"
    data-responses-page
    data-watson-customer-accordion-group
  >
    {
      SUPPORT_RESPONSE_TEMPLATES.map((template) => {
        const fieldId = `watson-response-${template.id}-text`;
        return (
          <WatsonCustomerAccordionSection
            id={`response-${template.id}`}
            title={template.title}
            class="watson-responses__item"
          >
            <div data-response-panel data-response-id={template.id}>
              <label class="watson-responses__label" for={fieldId}>
                Response text
              </label>
              <textarea
                id={fieldId}
                class="watson-responses__textarea"
                rows="22"
                readonly
                data-response-text
              >{template.body}</textarea>

              <div class="watson-responses__actions">
                <button type="button" class="watson__button" data-copy-response>
                  Copy Response
                </button>
                <p
                  class="watson__status watson-responses__copy-status"
                  data-copy-status
                  role="status"
                  aria-live="polite"
                  hidden
                ></p>
              </div>
            </div>
          </WatsonCustomerAccordionSection>
        );
      })
    }
    <WatsonCustomerAccordionInit />
  </div>
</WatsonPageShell>

<style>
  .watson-responses {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .watson-responses__label {
    display: block;
    margin: 0 0 0.45rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #334155;
  }

  .watson-responses__textarea {
    display: block;
    width: 100%;
    box-sizing: border-box;
    min-height: 22rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #f8fafc;
    color: #0f172a;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.5;
    resize: vertical;
  }

  .watson-responses__textarea:focus {
    outline: 2px solid #3f6212;
    outline-offset: 1px;
    border-color: #3f6212;
    background: #fff;
  }

  .watson-responses__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 0.9rem;
  }

  .watson-responses__copy-status {
    margin: 0;
  }
</style>

<script>
  function initWatsonResponses(root: ParentNode = document) {
    const page = root.querySelector("[data-responses-page]");
    if (!(page instanceof HTMLElement)) return;

    const panels = page.querySelectorAll("[data-response-panel]");
    panels.forEach((panel) => {
      if (!(panel instanceof HTMLElement)) return;

      const responseField = panel.querySelector("[data-response-text]");
      const copyButton = panel.querySelector("[data-copy-response]");
      const statusEl = panel.querySelector("[data-copy-status]");
      if (
        !(responseField instanceof HTMLTextAreaElement) ||
        !(copyButton instanceof HTMLButtonElement) ||
        !(statusEl instanceof HTMLElement)
      ) {
        return;
      }

      copyButton.addEventListener("click", () => {
        void (async () => {
          const text = responseField.value;
          try {
            await navigator.clipboard.writeText(text);
            statusEl.hidden = false;
            statusEl.textContent = "Copied";
          } catch {
            statusEl.hidden = false;
            statusEl.textContent = "Could not copy - select the text manually.";
            responseField.focus();
            responseField.select();
          }
        })();
      });
    });
  }

  initWatsonResponses(document);
</script>
