---
import WatsonPageShell from "../../components/watson/WatsonPageShell.astro";
import {
  LEGACY_CREDIT_ENTRIES_LABEL,
  LEGACY_HOME_STUDY_SNAPSHOT,
  LegacyHomeStudyPlanTableMissingError,
  PLACEHOLDER_COURSE_IDS,
  RECREATION_STATUSES,
  listLegacyHomeStudyPlanningCourses,
  mergePlanningCourses,
  filterPlanningCourses,
  planningCourses,
  saveLegacyHomeStudyCoursePlan,
} from "../../lib/watson/legacyHomeStudyCourses";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");

const rawQuery = Astro.url.searchParams.get("q") ?? "";
const savedId = Number(Astro.url.searchParams.get("saved") ?? "");
let loadError: string | null = null;
let formError: string | null = null;
let plansUnavailable = false;
let rows: Awaited<ReturnType<typeof listLegacyHomeStudyPlanningCourses>> = [];

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const postedQuery = String(form.get("q") ?? "");
  try {
    const result = await saveLegacyHomeStudyCoursePlan({
      courseId: form.get("courseId"),
      recreationStatus: form.get("recreationStatus"),
      otherUses: form.get("otherUses"),
      privateNotes: form.get("privateNotes"),
    });
    if (result.ok) {
      const params = new URLSearchParams();
      if (postedQuery.trim()) {
        params.set("q", postedQuery);
      }
      params.set("saved", String(result.value.courseId));
      return Astro.redirect(
        `/watson/legacy-home-study-courses?${params.toString()}#course-${result.value.courseId}`,
        303,
      );
    }
    formError = result.error;
  } catch (error) {
    formError =
      error instanceof LegacyHomeStudyPlanTableMissingError
        ? error.message
        : error instanceof Error
          ? error.message
          : "Unable to save this course plan.";
    if (error instanceof LegacyHomeStudyPlanTableMissingError) {
      plansUnavailable = true;
    }
  }
}

try {
  rows = await listLegacyHomeStudyPlanningCourses(rawQuery);
} catch (error) {
  if (error instanceof LegacyHomeStudyPlanTableMissingError) {
    plansUnavailable = true;
    loadError = error.message;
    rows = mergePlanningCourses(filterPlanningCourses(planningCourses(), rawQuery), []);
  } else {
    loadError = error instanceof Error ? error.message : "Unable to load course plans.";
  }
}

const savedCourse = Number.isInteger(savedId)
  ? rows.find((course) => course.courseId === savedId)
  : undefined;
const listedCount = rows.length;
const planningCount = planningCourses().length;
---

<WatsonPageShell
  title="Legacy Home Study Courses | Watson"
  description="Planning list for legacy Home Study courses. Does not change customer access."
  heading="Legacy Home Study Courses"
  intro="A reference list for deciding what to recreate. Saving a status or note does not change customer course access, Memberstack plans, or purchase classifications."
>
  <section class="watson__panel legacy-courses__snapshot" aria-label="Export snapshot">
    <p>
      Course ID is <strong>{LEGACY_HOME_STUDY_SNAPSHOT.idSource}</strong> from
      {LEGACY_HOME_STUDY_SNAPSHOT.sourceTables}. Library entries, {LEGACY_CREDIT_ENTRIES_LABEL.toLowerCase()},
      and subscriber-free entries are a snapshot from the SQL export dated
      <strong>{LEGACY_HOME_STUDY_SNAPSHOT.exportedOnDisplay}</strong>. These counts do not update automatically.
    </p>
    <p>
      Placeholder rows {PLACEHOLDER_COURSE_IDS.join(", ")} stay in the source file and are omitted
      from this list. {planningCount} courses are listed.
    </p>
  </section>

  <form class="watson-report__filters" method="get" action="/watson/legacy-home-study-courses" role="search">
    <div class="watson-report__filter">
      <label for="legacy-home-study-search">Search title or course ID</label>
      <input
        id="legacy-home-study-search"
        class="watson__search-input"
        type="search"
        name="q"
        value={rawQuery}
        placeholder="Title or HomeStudy course ID"
        autocomplete="off"
      />
    </div>
    <div class="watson-report__actions">
      <button class="watson__button" type="submit">Search</button>
      <a class="watson__button watson__button--secondary" href="/watson/legacy-home-study-courses">Clear</a>
    </div>
  </form>

  {
    savedCourse ? (
      <p class="watson__status watson__status--success" role="status">
        Saved course {savedCourse.courseId}, {savedCourse.title.trim()}.
      </p>
    ) : null
  }
  {
    formError ? (
      <p class="watson__status watson__status--error" role="alert">
        {formError}
      </p>
    ) : null
  }
  {
    loadError ? (
      <p class="watson__status watson__status--error" role="alert">
        {loadError}
      </p>
    ) : (
      <p class="watson__status">
        {listedCount === 0
          ? rawQuery.trim()
            ? `No courses matched "${rawQuery.trim()}".`
            : "No courses to show."
          : `Showing ${listedCount} course${listedCount === 1 ? "" : "s"}${
              rawQuery.trim() ? ` matching "${rawQuery.trim()}"` : ""
            }, sorted by ${LEGACY_CREDIT_ENTRIES_LABEL.toLowerCase()}.`}
      </p>
    )
  }

  {
    rows.length > 0 ? (
      <section class="watson__panel" aria-label="Legacy Home Study course plans">
        <div class="watson__table-wrap">
          <table class="watson-table legacy-courses__table" data-sortable-table>
            <thead>
              <tr>
                <th scope="col" data-sort-key="courseId" data-sort-type="string" tabindex="0">
                  Course ID
                </th>
                <th scope="col" data-sort-key="title" data-sort-type="string" tabindex="0">
                  Title
                </th>
                <th scope="col" data-sort-key="active" data-sort-type="string" tabindex="0">
                  Legacy Active
                </th>
                <th scope="col" data-sort-key="cost" data-sort-type="string" tabindex="0">
                  Course cost
                </th>
                <th scope="col" data-sort-key="library" data-sort-type="string" tabindex="0">
                  Library entries
                </th>
                <th
                  scope="col"
                  data-sort-key="credit"
                  data-sort-type="string"
                  data-sort-default="true"
                  data-sort-default-direction="desc"
                  tabindex="0"
                >
                  {LEGACY_CREDIT_ENTRIES_LABEL}
                </th>
                <th scope="col" data-sort-key="subscriberFree" data-sort-type="string" tabindex="0">
                  Subscriber-free entries
                </th>
                <th scope="col" data-sort-key="status" data-sort-type="string" tabindex="0">
                  Recreation status
                </th>
                <th scope="col" data-sort-key="updated" data-sort-type="date" tabindex="0">
                  Updated
                </th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((course) => (
                  <Fragment>
                    <tr id={`course-${course.courseId}`} data-sort-row>
                      <td data-sort-value={String(course.courseId)}>{course.courseId}</td>
                      <td class="legacy-courses__title" data-sort-value={course.title}>
                        {course.title}
                      </td>
                      <td data-sort-value={course.legacyActiveLabel}>{course.legacyActiveLabel}</td>
                      <td data-sort-value={course.courseCost}>{course.courseCostDisplay}</td>
                      <td data-sort-value={String(course.libraryEntries)}>
                        {course.libraryEntriesDisplay}
                      </td>
                      <td data-sort-value={String(course.creditEntries)}>
                        {course.creditEntriesDisplay}
                      </td>
                      <td data-sort-value={String(course.subscriberFreeEntries)}>
                        {course.subscriberFreeEntriesDisplay}
                      </td>
                      <td data-sort-value={course.recreationStatus}>
                        <label class="legacy-courses__field">
                          <span class="legacy-courses__visually-hidden">
                            Recreation status for course {course.courseId}
                          </span>
                          <select
                            name="recreationStatus"
                            form={`plan-${course.courseId}`}
                            disabled={plansUnavailable}
                          >
                            {RECREATION_STATUSES.map((status) => (
                              <option
                                value={status.value}
                                selected={status.value === course.recreationStatus}
                              >
                                {status.label}
                              </option>
                            ))}
                          </select>
                        </label>
                      </td>
                      <td data-sort-value={course.updatedAtSort}>
                        {course.updatedAtDisplay ?? "Not saved yet"}
                      </td>
                    </tr>
                    <tr data-sort-ignore>
                      <td colspan="9">
                        <form
                          id={`plan-${course.courseId}`}
                          class="legacy-courses__notes"
                          method="post"
                          action="/watson/legacy-home-study-courses"
                        >
                          <input type="hidden" name="courseId" value={course.courseId} />
                          <input type="hidden" name="q" value={rawQuery} />
                          <label>
                            Other uses
                            <textarea
                              name="otherUses"
                              rows="2"
                              maxlength="5000"
                              disabled={plansUnavailable}
                              placeholder="Help Hub, Skill Builder, pattern, Tip of the Week, reusable lesson"
                            >{course.otherUses}</textarea>
                          </label>
                          <label>
                            My private notes
                            <textarea
                              name="privateNotes"
                              rows="2"
                              maxlength="5000"
                              disabled={plansUnavailable}
                            >{course.privateNotes}</textarea>
                          </label>
                          <button class="watson__button" type="submit" disabled={plansUnavailable}>
                            Save
                          </button>
                        </form>
                      </td>
                    </tr>
                  </Fragment>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>
    ) : null
  }
</WatsonPageShell>

<style>
  .legacy-courses__snapshot p {
    margin: 0 0 0.65rem;
  }

  .legacy-courses__snapshot p:last-child {
    margin-bottom: 0;
  }

  .legacy-courses__title {
    min-width: 14rem;
    white-space: pre-wrap;
  }

  .legacy-courses__field,
  .legacy-courses__notes label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.82rem;
    font-weight: 650;
    color: #3f6212;
  }

  .legacy-courses__notes {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) minmax(12rem, 1fr) auto;
    gap: 0.75rem;
    align-items: end;
  }

  .legacy-courses__notes select,
  .legacy-courses__field select,
  .legacy-courses__notes textarea {
    width: 100%;
    padding: 0.45rem 0.6rem;
    font: inherit;
    font-weight: 450;
    color: #243015;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #fff;
  }

  .legacy-courses__notes textarea {
    resize: vertical;
    min-height: 3.2rem;
  }

  .legacy-courses__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 800px) {
    .legacy-courses__notes {
      grid-template-columns: 1fr;
    }
  }
</style>
