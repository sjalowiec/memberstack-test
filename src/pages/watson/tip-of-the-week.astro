---
import WatsonPageShell from "../../components/watson/WatsonPageShell.astro";
import { resolveVideoForTip } from "../../lib/tipOfTheWeek/map";
import { formatTipAvailabilityDate } from "../../lib/tipOfTheWeek/map";
import {
  statusLabel,
  tipLosAngelesCalendarDate,
  tipScheduleBucket,
} from "../../lib/tipOfTheWeek/schedule";
import { listAllTipOfTheWeek } from "../../lib/tipOfTheWeek/store";
import type { TipOfTheWeekRecord } from "../../lib/tipOfTheWeek/types";
import {
  loadTipReactionTotals,
  tipReactionDisplayRows,
} from "../../lib/tipOfTheWeek/reactionsAggregate";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");

let loadError: string | null = null;
let tips: TipOfTheWeekRecord[] = [];
const todayLa = tipLosAngelesCalendarDate();

try {
  tips = await listAllTipOfTheWeek();
} catch (error) {
  loadError =
    error instanceof Error
      ? error.message
      : "Unable to load Tip of the Week. Apply the schema SQL first.";
}

const current = tips.filter((t) => tipScheduleBucket(t, todayLa) === "current");
const scheduled = tips.filter((t) => tipScheduleBucket(t, todayLa) === "scheduled");
const drafts = tips.filter((t) => tipScheduleBucket(t, todayLa) === "draft");
const archived = tips.filter(
  (t) =>
    tipScheduleBucket(t, todayLa) === "archived" ||
    tipScheduleBucket(t, todayLa) === "expired",
);

const reactionSummaries = new Map<
  string,
  Awaited<ReturnType<typeof tipReactionDisplayRows>>
>();

if (!loadError) {
  for (const tip of tips) {
    try {
      const totals = await loadTipReactionTotals(tip.tipId);
      reactionSummaries.set(tip.tipId, tipReactionDisplayRows(totals));
    } catch {
      reactionSummaries.set(tip.tipId, []);
    }
  }
}

function tipDataAttr(tip: TipOfTheWeekRecord): string {
  return encodeURIComponent(JSON.stringify(tip));
}

function renderTipCard(tip: TipOfTheWeekRecord) {
  const video = resolveVideoForTip(tip);
  const bucket = tipScheduleBucket(tip, todayLa);
  const reactions = reactionSummaries.get(tip.tipId) || [];
  return {
    tip,
    video,
    bucket,
    reactions,
    fromLabel: formatTipAvailabilityDate(tip.availableFrom),
    throughLabel: formatTipAvailabilityDate(tip.availableThrough),
  };
}
---

<WatsonPageShell
  title="Tip of the Week | Watson"
  heading="Tip of the Week"
  intro="Manage the free weekly Learning Library lesson: wording, dates, video, and reaction totals."
>
  {
    loadError ? (
      <p class="watson__status watson__status--error" role="alert">
        {loadError} Apply <code>scripts/sql/watson-tip-of-the-week.sql</code> (and the seed
        SQL if needed) against <code>WATSON_DATABASE_URL</code>.
      </p>
    ) : null
  }

  <p class="watson-totw__today" data-totw-today={todayLa}>
    Today in America/Los_Angeles: <strong>{todayLa}</strong>
    · Public page: <a href="/tip-of-the-week" target="_blank" rel="noopener">/tip-of-the-week</a>
  </p>

  <p class="watson-totw__toolbar">
    <button type="button" class="watson-totw__btn" data-totw-new>New tip</button>
    <a
      class="watson-totw__btn watson-totw__btn--link"
      href="/watson/email-signups"
      data-totw-email-signups
    >
      View Email Signups
    </a>
    <a
      class="watson-totw__btn watson-totw__btn--link"
      href="https://knititnow.activehosted.com/app/campaigns"
      target="_blank"
      rel="noopener noreferrer"
      data-totw-activecampaign-calendar
    >
      ActiveCampaign Calendar
    </a>
  </p>

  <div class="watson-totw__status" data-totw-status hidden></div>

  <section class="watson-totw__board" aria-label="Tip lists">
    {
      [
        { key: "current", title: "Current (public)", items: current },
        { key: "scheduled", title: "Scheduled", items: scheduled },
        { key: "draft", title: "Drafts", items: drafts },
        { key: "archived", title: "Archived / past", items: archived },
      ].map((group) => (
        <section class="watson-totw__group" aria-labelledby={`totw-group-${group.key}`}>
          <h2 id={`totw-group-${group.key}`}>{group.title}</h2>
          {group.items.length === 0 ? (
            <p class="watson-totw__empty">None</p>
          ) : (
            <ul class="watson-totw__cards">
              {group.items.map((tip) => {
                const card = renderTipCard(tip);
                return (
                  <li class="watson-totw__card">
                    <div class="watson-totw__card-top">
                      <h3>{tip.title}</h3>
                      <span class="watson-totw__badge">{statusLabel(tip.status)}</span>
                    </div>
                    <p class="watson-totw__meta">
                      tip_id <code>{tip.tipId}</code> · video {tip.videoContentId}
                      {card.video ? ` · ${card.video.catalogTitle}` : " · video unresolved"}
                    </p>
                    <p class="watson-totw__meta">
                      {card.fromLabel} → {card.throughLabel}
                    </p>
                    {card.reactions.length > 0 ? (
                      <ul class="watson-totw__mini-reactions">
                        {card.reactions.map((row) => (
                          <li>
                            {row.label}: <strong>{row.count}</strong>
                          </li>
                        ))}
                      </ul>
                    ) : null}
                    <div class="watson-totw__card-actions">
                      <button
                        type="button"
                        class="watson-totw__btn watson-totw__btn--small"
                        data-totw-edit={tipDataAttr(tip)}
                      >
                        Edit
                      </button>
                      <a
                        class="watson-totw__btn watson-totw__btn--small watson-totw__btn--link"
                        href={`/tip-of-the-week?preview=${tip.id}`}
                        target="_blank"
                        rel="noopener"
                      >
                        Preview
                      </a>
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      ))
    }
  </section>

  <section class="watson-totw__editor" aria-labelledby="totw-form-heading">
    <h2 id="totw-form-heading" data-totw-form-heading>New tip</h2>
    <form class="watson-totw__form" data-totw-form>
      <input type="hidden" name="id" value="" />

      <div class="watson-totw__grid">
        <label>
          Tip ID (stable slug for reactions)
          <input name="tipId" required maxlength="80" placeholder="taming-the-curl-2026-08" />
        </label>
        <label>
          Status
          <select name="status">
            <option value="draft">Draft</option>
            <option value="scheduled">Scheduled</option>
            <option value="active">Active</option>
            <option value="archived">Archived</option>
          </select>
        </label>
        <label>
          Available from
          <input type="date" name="availableFrom" data-totw-available-from required />
        </label>
        <label class="watson-totw__through-field">
          Available through
          <span class="watson-totw__through-row">
            <input type="date" name="availableThrough" data-totw-available-through required />
            <button
              type="button"
              class="watson-totw__btn watson-totw__btn--small"
              data-totw-reset-seven-days
            >
              Reset to 7 days
            </button>
          </span>
          <span class="watson-totw__hint">
            Defaults to a 7-day window (start + 6 days). Edit freely, or reset to recalculate.
          </span>
        </label>
      </div>

      <label>
        Public page title
        <input name="title" required maxlength="160" />
      </label>

      <div class="watson-totw__field">
        <span id="totw-intro-label">Short introduction</span>
        <div class="watson-totw__rte watson-totw__rte--compact" data-totw-rte data-totw-intro-rte>
          <div
            class="watson-totw__rte-toolbar"
            data-wn-rte-toolbar
            role="toolbar"
            aria-label="Introduction formatting"
          >
            <button type="button" class="watson-totw__rte-btn" data-wn-rte-cmd="bold" title="Bold">
              <strong>B</strong>
            </button>
            <button type="button" class="watson-totw__rte-btn" data-wn-rte-cmd="italic" title="Italic">
              <em>I</em>
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="paragraph"
              title="Paragraph"
            >
              ¶
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="ul"
              title="Bulleted list"
            >
              • List
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="ol"
              title="Numbered list"
            >
              1. List
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="link"
              title="Add or edit link"
            >
              Link
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="clear"
              title="Remove formatting"
            >
              Clear
            </button>
          </div>
          <div
            class="watson-totw__rte-editor"
            data-wn-rte-editor
            contenteditable="true"
            role="textbox"
            aria-multiline="true"
            aria-labelledby="totw-intro-label"
          ></div>
          <textarea
            class="watson-totw__rte-input"
            data-wn-rte-input
            name="intro"
            maxlength="1200"
            hidden
            tabindex="-1"
            aria-hidden="true"
          ></textarea>
        </div>
      </div>

      <label>
        Glossary tooltip (optional)
        <span class="watson-totw__hint">
          Enter the glossary slug or phrase to tooltip in the introduction. Only the first occurrence will be linked.
        </span>
        <input name="introGlossarySlug" maxlength="80" placeholder="floats" />
      </label>

      <label>
        Eyebrow
        <input name="eyebrow" maxlength="80" value="TIP OF THE WEEK" />
      </label>

      <label>
        Learning Library content ID
        <span class="watson-totw__hint">
          Enter the catalog content_id (for example 339). Use Resolve to confirm title, Vimeo
          ID, and poster — no Vimeo ID pasting required.
        </span>
        <div class="watson-totw__video-row">
          <input name="videoContentId" required inputmode="numeric" pattern="[0-9]+" />
          <button type="button" class="watson-totw__btn" data-video-resolve>
            Resolve video
          </button>
        </div>
      </label>
      <div class="watson-totw__preview" data-video-preview hidden></div>

      <label>
        Availability notice
        <input name="availabilityNotice" maxlength="120" />
      </label>

      <label>
        Availability footer (must include {"{date}"})
        <textarea name="availabilityFooterTemplate" rows="2" maxlength="2000"></textarea>
      </label>

      <fieldset class="watson-totw__fieldset">
        <legend>What You’ll Learn</legend>
        <div data-learn-points></div>
        <button type="button" class="watson-totw__btn watson-totw__btn--small" data-learn-add>
          Add point
        </button>
      </fieldset>

      <div class="watson-totw__field">
        <span id="totw-try-copy-label">Try It</span>
        <div class="watson-totw__rte watson-totw__rte--compact" data-totw-rte data-totw-try-rte>
          <div
            class="watson-totw__rte-toolbar"
            data-wn-rte-toolbar
            role="toolbar"
            aria-label="Try It formatting"
          >
            <button type="button" class="watson-totw__rte-btn" data-wn-rte-cmd="bold" title="Bold">
              <strong>B</strong>
            </button>
            <button type="button" class="watson-totw__rte-btn" data-wn-rte-cmd="italic" title="Italic">
              <em>I</em>
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="paragraph"
              title="Paragraph"
            >
              ¶
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="ul"
              title="Bulleted list"
            >
              • List
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="ol"
              title="Numbered list"
            >
              1. List
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="link"
              title="Add or edit link"
            >
              Link
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="clear"
              title="Remove formatting"
            >
              Clear
            </button>
          </div>
          <div
            class="watson-totw__rte-editor"
            data-wn-rte-editor
            contenteditable="true"
            role="textbox"
            aria-multiline="true"
            aria-labelledby="totw-try-copy-label"
          ></div>
          <textarea
            class="watson-totw__rte-input"
            data-wn-rte-input
            name="tryCopy"
            maxlength="2000"
            hidden
            tabindex="-1"
            aria-hidden="true"
          ></textarea>
        </div>
      </div>

      <div class="watson-totw__field">
        <span id="totw-sue-copy-label">Sue’s Tip</span>
        <div class="watson-totw__rte watson-totw__rte--compact" data-totw-rte data-totw-sue-rte>
          <div
            class="watson-totw__rte-toolbar"
            data-wn-rte-toolbar
            role="toolbar"
            aria-label="Sue’s Tip formatting"
          >
            <button type="button" class="watson-totw__rte-btn" data-wn-rte-cmd="bold" title="Bold">
              <strong>B</strong>
            </button>
            <button type="button" class="watson-totw__rte-btn" data-wn-rte-cmd="italic" title="Italic">
              <em>I</em>
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="paragraph"
              title="Paragraph"
            >
              ¶
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="ul"
              title="Bulleted list"
            >
              • List
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="ol"
              title="Numbered list"
            >
              1. List
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="link"
              title="Add or edit link"
            >
              Link
            </button>
            <button
              type="button"
              class="watson-totw__rte-btn"
              data-wn-rte-cmd="clear"
              title="Remove formatting"
            >
              Clear
            </button>
          </div>
          <div
            class="watson-totw__rte-editor"
            data-wn-rte-editor
            contenteditable="true"
            role="textbox"
            aria-multiline="true"
            aria-labelledby="totw-sue-copy-label"
          ></div>
          <textarea
            class="watson-totw__rte-input"
            data-wn-rte-input
            name="sueTipCopy"
            maxlength="2000"
            hidden
            tabindex="-1"
            aria-hidden="true"
          ></textarea>
        </div>
      </div>

      <fieldset class="watson-totw__fieldset">
        <legend>Call to Action (optional)</legend>
        <p class="watson-totw__muted">
          Shown on the public page after Sue’s Tip. Leave both blank to hide the button.
        </p>
        <label>
          CTA Text
          <input name="ctaText" maxlength="80" placeholder="Build Your Sock Pattern" />
        </label>
        <label>
          CTA URL
          <span class="watson-totw__hint">
            Site path like /patterns/socks/builder?new=1, or https://…
          </span>
          <input name="ctaUrl" maxlength="500" placeholder="/patterns/socks/builder?new=1" />
        </label>
      </fieldset>

      <fieldset class="watson-totw__fieldset">
        <legend>Related Help</legend>
        <p class="watson-totw__muted">
          Add Learning Library videos by content ID, or links/documents with a title and URL.
          Up to 8 resources.
        </p>
        <div data-related-links></div>
        <button type="button" class="watson-totw__btn watson-totw__btn--small" data-related-add>
          Add Related Resource
        </button>
      </fieldset>

      <section class="watson-totw__reactions" aria-labelledby="totw-reactions-heading">
        <h3 id="totw-reactions-heading">Reaction totals</h3>
        <div data-reaction-totals>
          <p>Save a tip to see reaction totals.</p>
        </div>
      </section>

      <div class="watson-totw__actions">
        <button type="submit" class="watson-totw__btn watson-totw__btn--primary">Save</button>
        <button type="button" class="watson-totw__btn" data-totw-save-draft>Save draft</button>
        <button type="button" class="watson-totw__btn" data-totw-schedule>Schedule</button>
        <button type="button" class="watson-totw__btn" data-totw-activate>Activate</button>
        <button type="button" class="watson-totw__btn" data-totw-archive>Archive</button>
      </div>
    </form>
  </section>
</WatsonPageShell>

<script>
  import { initWatsonTipOfTheWeek } from "../../scripts/watsonTipOfTheWeek";
  initWatsonTipOfTheWeek();
</script>

