---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

const pageTitle = "Welcome to the New Knit It Now";
const description =
  "Knit It Now has moved to a rebuilt site. Log in with your usual email, learn what changed for saved patterns, and contact Sue if you need help.";
---

<Layout
  title={`${pageTitle} | Knit it Now`}
  {description}
  bodyClass="page--tight-header"
  skipGlobalHyvor={true}
>
  <article class="new-site-page page-wrap" aria-label="Welcome to the new Knit It Now">
    <h1>{pageTitle}</h1>

    <div class="new-site-page__intro">
      <p>
        Knit It Now has moved to a completely rebuilt website for machine knitters.
      </p>
    </div>

    <div class="new-site-page__cta">
      <a class="kbm-btn kbm-btn-primary new-site-page__cta-btn" href="/contact/">Contact Sue</a>
    </div>

    <section class="new-site-page__section" aria-labelledby="new-site-account-heading">
      <h2 id="new-site-account-heading">Your Account</h2>
      <p>
        <strong>You do not need to log in to browse the website or use its public resources.</strong></p>

<p><strong>If you have a current membership</strong>, your membership carried over. Log in with the same email address you have always used to access member-only patterns and resources.</p>

<p><strong>If you are not currently a member</strong>, you can continue using the public areas of the site <strong>without an account or password</strong>. You can sign up anytime if you would like to become a member.</p>
      
    </section>

    <section class="new-site-page__section" aria-labelledby="new-site-saved-heading">
      <h2 id="new-site-saved-heading">Saved Patterns</h2>
      <p>
        The former patterns and saved pattern lists did not transfer. Those patterns have been
        retired.
      </p>
      <p>
        If you need help with a pattern you previously saved, contact me and I will do my best to
        point you in the right direction.
      </p>
    </section>

    <section class="new-site-page__section" aria-labelledby="new-site-whats-new-heading">
      <h2 id="new-site-whats-new-heading">Pattern Systems</h2>
      <p>
        The new Pattern Systems are the foundation of the rebuilt site. More Pattern Systems, tools,
        and resources will be added over time. A demo of the new pattern systems is in the works .. stay tuned! 😊
      </p>
    </section>

    <section class="new-site-page__section" aria-labelledby="new-site-help-heading">
      <h2 id="new-site-help-heading">Need Help?</h2>
      <p>Questions about your account, membership, or a previously saved pattern? Contact me.</p>
      <p class="new-site-page__signoff">
        Sue<br />
        Knit It Now
      </p>

      <div class="new-site-page__cta new-site-page__cta--footer">
        <a class="kbm-btn kbm-btn-primary new-site-page__cta-btn" href="/contact/">Contact Sue</a>
      </div>
    </section>
  </article>
</Layout>

<style>
  .new-site-page.page-wrap {
    /* Layout main already clears the fixed header */
    padding-top: 0.5rem;
    max-width: 42rem;
  }

  .new-site-page {
    padding-bottom: 3rem;
  }

  .new-site-page h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(1.75rem, 4vw, 2.15rem);
    line-height: 1.25;
    color: var(--kbm-green, #52682d);
  }

  .new-site-page h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    line-height: 1.3;
    color: var(--kbm-green, #52682d);
  }

  .new-site-page__intro p,
  .new-site-page__section p {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: #374151;
  }

  .new-site-page__list {
    margin: 0 0 1rem;
    padding-left: 1.35rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: #374151;
  }

  .new-site-page__list li + li {
    margin-top: 0.4rem;
  }

  .new-site-page__section {
    margin-top: 2.25rem;
  }

  .new-site-page__signoff {
    margin-top: 1.5rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: #374151;
  }

  .new-site-page__cta {
    margin: 1.5rem 0 0.25rem;
    text-align: center;
  }

  .new-site-page__cta--footer {
    margin-top: 2rem;
  }

  .new-site-page__cta-btn {
    min-width: min(100%, 280px);
    text-align: center;
    box-sizing: border-box;
  }

  /* Short landscape viewports: keep content usable under the fixed header */
  @media (max-height: 500px) and (orientation: landscape) {
    .new-site-page.page-wrap {
      padding-top: 0.25rem;
    }

    .new-site-page h1 {
      margin-bottom: 0.75rem;
      font-size: clamp(1.35rem, 3.5vw, 1.75rem);
    }

    .new-site-page__section {
      margin-top: 1.5rem;
    }

    .new-site-page__intro p,
    .new-site-page__section p,
    .new-site-page__list {
      font-size: 1rem;
      line-height: 1.55;
    }
  }

  @media (max-width: 767px) {
    .new-site-page.page-wrap {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
