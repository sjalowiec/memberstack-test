---
import Layout from "../../layouts/Layout.astro";
import { QUICK_HELP_SESSION } from "../../config/quickHelpSession";

const priceDisplay = "$" + QUICK_HELP_SESSION.price;
---

<Layout
  title="Quick Help Session | Knit it Now"
  description="Book a focused 15-minute Zoom session with Sue for one machine knitting question. $49."
  bodyClass="page--tight-header"
>
  <section class="quick-help-page">
    <div class="quick-help-inner">
      <p class="quick-help-eyebrow">Work with Sue</p>
      <h1>Quick Help Session</h1>
      <p class="quick-help-meta">15 minutes · Zoom · {priceDisplay} one-time</p>

      <div class="quick-help-card">
        <p class="quick-help-card-lead">
          Pay below, then choose a time on the appointment calendar.
        </p>

        <div
          id="quick-help-checkout-status"
          class="quick-help-checkout-status quick-help-checkout-status--info"
          role="status"
          aria-live="polite"
          hidden
        />

        <button type="button" class="quick-help-cta" data-quick-help-checkout>
          Book My Session — {priceDisplay}
        </button>
      </div>

      <p class="quick-help-back">
        <a href="/help-hub/work-with-sue">← Back to Work with Sue</a>
      </p>
    </div>
  </section>

  <script>
    import "../../scripts/quickHelpCheckout.ts";
  </script>

  <style>
    .quick-help-page {
      padding: 0.5rem 1.5rem 3rem;
    }

    .quick-help-inner {
      max-width: 34rem;
      margin: 0 auto;
    }

    .quick-help-eyebrow {
      margin: 0 0 0.5rem;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--kbm-green, #52682d);
    }

    .quick-help-inner h1 {
      margin: 0 0 0.35rem;
      font-size: clamp(1.75rem, 5vw, 2.25rem);
      font-weight: 600;
      line-height: 1.2;
      color: var(--kbm-green, #52682d);
    }

    .quick-help-meta {
      margin: 0 0 1.5rem;
      font-size: 1.05rem;
      font-weight: 600;
      color: #4d5a48;
    }

    .quick-help-card {
      padding: 1.5rem 1.75rem;
      background: #fff;
      border: 1px solid #d6dbc9;
      border-radius: 16px;
      box-shadow: 0 4px 16px rgba(82, 104, 45, 0.08);
    }

    .quick-help-card-lead {
      margin: 0 0 1.25rem;
      font-size: 1.05rem;
      line-height: 1.55;
      color: #243015;
    }

    .quick-help-checkout-status {
      margin: 0 0 1rem;
      padding: 0.75rem 0.85rem;
      border-radius: 10px;
      font-size: var(--text-base, 1rem);
      line-height: 1.5;
    }

    .quick-help-checkout-status[hidden] {
      display: none;
    }

    .quick-help-checkout-status--info {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1e3a8a;
    }

    .quick-help-checkout-status--success {
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      color: #065f46;
    }

    .quick-help-checkout-status--error {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #991b1b;
    }

    .quick-help-cta {
      display: block;
      width: 100%;
      background-color: #c96a4a;
      color: #fff;
      padding: 0.85rem 1.5rem;
      border-radius: 8px;
      border: none;
      font: inherit;
      font-weight: 600;
      font-size: 1.05rem;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(201, 106, 74, 0.35);
    }

    .quick-help-cta:hover {
      background-color: #b85c3e;
    }

    .quick-help-cta:disabled {
      opacity: 0.65;
      cursor: wait;
    }

    .quick-help-back {
      margin: 1.25rem 0 0;
      font-size: 0.95rem;
    }

    .quick-help-back a {
      color: var(--kbm-green, #52682d);
      font-weight: 600;
      text-decoration: none;
    }

    .quick-help-back a:hover {
      text-decoration: underline;
    }

    @media (max-width: 640px) {
      .quick-help-page {
        padding: 0.25rem 1.25rem 2.5rem;
      }

      .quick-help-card {
        padding: 1.25rem 1.35rem;
      }
    }
  </style>
</Layout>
