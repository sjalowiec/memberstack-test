---
import HelpHubTipPage from "../../components/help-hub/HelpHubTipPage.astro";
import { requireAdminForRequest, adminAuthErrorBody } from "../../lib/admin/requireAdminRequest";
import { resolveHelpHubPreviewTip } from "../../lib/helpHub/previewDocument";
import { loadHelpHubTipBySlug } from "../../lib/helpHub/loadTips";
import { loadPublicLessons } from "../../lib/lessons/loadLessons";
import type { HelpHubPageTip } from "../../lib/helpHub/prepareTipPage";

export const prerender = false;

function jsonError(status: number, error: string) {
  return new Response(JSON.stringify({ ok: false, error }), {
    status,
    headers: {
      "Content-Type": "application/json",
      "Cache-Control": "no-store",
      Allow: "POST",
    },
  });
}

if (Astro.request.method !== "POST") {
  return jsonError(405, "Preview requires an authenticated POST.");
}

const auth = await requireAdminForRequest(Astro.request, Astro.cookies);
if (!auth.ok) {
  return new Response(JSON.stringify(adminAuthErrorBody(auth)), {
    status: auth.status,
    headers: { "Content-Type": "application/json", "Cache-Control": "no-store" },
  });
}

if (!Astro.request.headers.get("content-type")?.includes("application/json")) {
  return jsonError(400, "Content-Type must be application/json");
}

let body: unknown;
try {
  body = await Astro.request.json();
} catch {
  return jsonError(400, "Invalid JSON body");
}

const resolved = await resolveHelpHubPreviewTip(body, async (slug) => {
  const saved = await loadHelpHubTipBySlug(slug);
  return saved;
});
if (!resolved.ok) {
  return jsonError(resolved.status, resolved.error);
}

const tip: HelpHubPageTip = resolved.tip;
const lessons = await loadPublicLessons();

Astro.response.headers.set("Cache-Control", "no-store");
---

<HelpHubTipPage tip={tip} preview={true} lessons={lessons} />
