---
import HelpHubTipPage from "../../components/help-hub/HelpHubTipPage.astro";
import { requireAdminForRequest } from "../../lib/admin/requireAdminRequest";
import { loadHelpHubTipBySlug } from "../../lib/helpHub/loadTips";

export const prerender = false;

const auth = await requireAdminForRequest(Astro.request, Astro.cookies);
if (!auth.ok) {
  return new Response(auth.error, { status: auth.status });
}

const slugParam = Astro.url.searchParams.get("slug")?.trim() || "";
if (!slugParam) {
  return new Response("Preview requires a saved slug.", { status: 400 });
}

const tip = await loadHelpHubTipBySlug(slugParam);
if (!tip) {
  return new Response("Not found", { status: 404 });
}
---

<HelpHubTipPage tip={tip} preview={true} />
