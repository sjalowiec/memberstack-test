---
import HelpHubTipPage from "../../components/help-hub/HelpHubTipPage.astro";
import { loadHelpHubTipBySlug } from "../../lib/helpHub/loadTips";

export const prerender = false;

const slugParam =
  typeof Astro.params.slug === "string" ? Astro.params.slug.trim() : "";

const reservedPaths = ["guided-workshops", "preview"];
if (!slugParam || reservedPaths.includes(slugParam)) {
  return new Response("Not found", { status: 404 });
}

const tip = await loadHelpHubTipBySlug(slugParam, { publicOnly: true });
if (!tip) {
  return new Response("Not found", { status: 404 });
}
---

<HelpHubTipPage tip={tip} />
