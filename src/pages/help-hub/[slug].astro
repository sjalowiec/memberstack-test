    <section class="tuesday-tip__section tuesday-tip-discussion">
      <h2>Tried this? I’d love to hear how it went</h2>
      Join the discussion below! Our community loves helping each other master new skills.
      <div
        id="hyvor-talk-view"
        data-hyvor-website="14706"
        data-talk-id={hyvorId}
      >
      </div>
      <script is:inline>
        (function () {
          var el = document.getElementById("hyvor-talk-view");
          if (!el) return;
          var talkId = el.getAttribute("data-talk-id") || "";
          var websiteStr = el.getAttribute("data-hyvor-website") || "14706";
          var websiteId = parseInt(websiteStr, 10);
          if (!Number.isFinite(websiteId)) websiteId = 14706;
          window.HYVOR_TALK_WEBSITE = websiteId;
          window.HYVOR_TALK_CONFIG = {
            url: window.location.href,
            id: talkId,
          };
          var s = document.createElement("script");
          s.async = true;
          s.type = "text/javascript";
          s.src = "https://talk.hyvor.com/web-api/embed";
          if (el.parentNode) {
            el.parentNode.insertBefore(s, el.nextSibling);
          } else {
            (document.head || document.documentElement).appendChild(s);
          }
        })();
      </script>
    </section>
  </section>
</Layout>

<style>
  .tips-page-section {
    max-width: min(1180px, 100%);
    margin-left: auto;
    margin-right: auto;
  }

  .tuesday-tip-hero {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 1.75rem;
    padding: clamp(1rem, 2.5vw, 1.4rem);
    border: 1px solid rgba(82, 104, 45, 0.18);
    border-radius: 16px;
    background: #f8faf6;
    position: relative;
  }

  .tuesday-tip-hero__hook {
    margin: 0 0 1rem 0;
    flex: 0 0 auto;
    order: 0;
  }

  /* Machine meta: direct child of .tuesday-tip-hero only — never inside .tuesday-tip-bubbles */
  .tuesday-tip-hero > .tip-meta-row {
    margin: 0 0 1rem 0;
    width: 100%;
    box-sizing: border-box;
    flex: 0 0 auto;
    order: 1;
    position: relative;
    /* Uncomment to verify DOM placement: outline: 2px solid red; */
  }

  .tip-meta-row .tuesday-tip-applies-to {
    margin: 0;
  }

  .tuesday-tip-hero__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    flex: 0 1 auto;
    order: 2;
    position: relative;
  }

  @media (min-width: 980px) {
    .tuesday-tip-hero__columns {
      grid-template-columns: minmax(320px, 1fr) minmax(420px, 1fr);
      gap: clamp(1.2rem, 2.5vw, 2rem);
      align-items: start;
    }
  }

  .tuesday-tip-hero__content {
    min-width: 0;
  }

  .tuesday-tip-bubbles {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .tuesday-tip-hero > .tuesday-tip-hero__hook.bubble-hook {
    font-size: clamp(0.98rem, 1.45vw, 1.06rem);
    font-weight: 400;
    line-height: 1.55;
    color: #5e6c4d;
  }

  .tuesday-tip-applies-to {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: #475569;
  }

  .machine-pill {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(82, 104, 45, 0.25);
    background: rgba(82, 104, 45, 0.08);
    color: #3f4b35;
    font-size: 0.8rem;
    line-height: 1.2;
    font-weight: 600;
  }

  .tuesday-tip-bubble-row.talk-row {
    margin: 0;
  }

  .tuesday-tip-bubble-row.talk-left {
    margin-top: 0.3rem;
  }

  .tuesday-tip-bubbles .talk-bubble {
    max-width: 100%;
  }

  .talk-bubble.tuesday-tip__question {
    font-size: clamp(1.45rem, 2.6vw, 1.95rem);
    font-weight: 650;
    line-height: 1.16;
    margin: 0;
    color: #6f8550;
  }

  .talk-bubble.tuesday-tip__answer {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.55;
    padding: 16px 20px 16px 20px;
    margin-left: 60px;
  }

  .tuesday-tip__answer-inner {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .tuesday-tip__logo {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
  }

  .tuesday-tip__answer-text {
    flex: 1;
  }

  .tuesday-tip-hero__media {
    min-width: 0;
  }

  .tuesday-tip-video-shell {
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 0.5rem;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    width: 100%;
    max-width: 100%;
  }

  .tuesday-tip-video-aspect {
    position: relative;
    width: 100%;
    padding-bottom: 60%;
    height: 0;
    border-radius: 8px;
    background: #0f172a;
  }

  .tuesday-tip-video-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .tuesday-tip-video-native {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    object-fit: contain;
    background: #000;
  }

  .help-hub-media {
    position: absolute;
    inset: 0;
  }

  .tuesday-tip-media-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tuesday-tip-video-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: linear-gradient(160deg, #f1f5f9 0%, #e2e8f0 100%);
  }

  .tuesday-tip-video-fallback__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #64748b;
    text-align: center;
    max-width: 16rem;
  }

  .tuesday-tip-discussion {
    margin-top: 40px;
  }

  .tuesday-tip-discussion h2 {
    margin-bottom: 15px;
  }

  .tuesday-tip__section {
    margin-top: 2rem;
  }

  .tuesday-tip__section--why {
    margin-top: 0.75rem;
  }

  .tuesday-tip__section-heading {
    margin: 0 0 0.7rem;
    font-size: clamp(1.12rem, 2.1vw, 1.32rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--kbm-green, #52682d);
  }

  .tuesday-tip__section-card {
    border-radius: 12px;
    border: 1px solid rgba(82, 104, 45, 0.16);
    background: #fff;
    padding: clamp(0.95rem, 2.1vw, 1.15rem);
  }

  .tuesday-tip__description {
    margin: 0;
    max-width: 100%;
    font-size: 1rem;
    line-height: 1.65;
    color: #2f3a25;
  }

  .tuesday-tip__jump-links {
    margin: 0 0 1rem;
    max-width: 100%;
  }

  .tuesday-tip__jump-links-list {
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.6;
