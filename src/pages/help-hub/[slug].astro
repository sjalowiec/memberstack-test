---
import Layout from "../../layouts/Layout.astro";
import PageBackLink from "../../components/common/PageBackLink.astro";
import PageHead from "../../components/PageHead.astro";
import "../../components/talk-bubbles.css";
import helpHubData from "../../data/help-hub.json";
import lessons from "../../data/lessons.json";
import videosPublic from "../../data/videos-public.json";
import {
  findPublicVideoByKey,
  vimeoNumericIdFromPublicVideo,
  type PublicVideoRow,
} from "../../lib/lessonVideo";
import { filterPublicCatalogVideos } from "../../lib/videoPublic";
import { helpHubTipIsPublic } from "../../lib/helpHubPublic";
import { buildHelpHubFaqPage, serializeJsonLd } from "../../lib/helpHubFaqSchema";
import {
  resolveHelpHubRelatedLessons,
  type HelpHubLessonRecord,
} from "../../lib/helpHubMemberLesson";

const slugParam =
  typeof Astro.params.slug === "string" ? Astro.params.slug.trim() : "";
type HelpHubTryThis = {
  quickActionTitle?: string;
  quickAction?: string[];
  quickActionNote?: string;
};

/** Current Help Hub tip record shape (src/data/help-hub.json). */
type HelpHubRecord = {
  slug?: string;
  /** When set, overrides `status` for visibility. */
  active?: boolean;
  status?: string;
  title?: string;
  metaTitle?: string;
  metaDescription?: string;
  shortAnswer?: string;
  allMachines?: boolean;
  appliesTo?: string[];
  question?: string;
  hook?: string;
  bubbleAnswer?: string;
  /** Catalog row id: matches `content_id` in videos-public.json. */
  videoId?: string | number;
  mediaType?: string;
  mediaUrl?: string;
  mediaPoster?: string;
  mediaAlt?: string;
  aboutTitle?: string;
  solutionText?: string;
  bridge?: string;
  tryThisTitle?: string;
  tryThis?: HelpHubTryThis;
  trySteps?: string[];
  tryNote?: string;
  tryImage?: string;
  tryImageAlt?: string;
  tryImageCaption?: string;
  /** Lesson slugs, `lessons.json` ids, or Vimeo numeric ids (digits after slug/id checks). */
  relatedLessons?: (string | number)[];
  jumpLinks?: { label: string; href: string }[];
};

type LessonRecord = HelpHubLessonRecord & {
  videoSlug?: string;
  vimeoEmbedUrl?: string;
  /** Inline player shape (`lessons/[slug].astro`). */
  mediaType?: string;
  mediaUrl?: string;
};

const catalogVideosHelpHub = filterPublicCatalogVideos(
  Array.isArray(videosPublic) ? (videosPublic as PublicVideoRow[]) : [],
);

/**
 * Prerendered: only public Help Hub tips are emitted as static pages via
 * getStaticPaths(). Draft, private, and other non-public tips are never
 * generated here, so they can't be reached or indexed. Draft preview stays on
 * the dedicated SSR route (/help-hub/preview), which is unaffected by this change.
 */
export const prerender = true;

export function getStaticPaths() {
  // Slugs reserved for other /help-hub/* routes (kept out of the tip catalog).
  const reservedPaths = ["guided-workshops"];
  const all = Array.isArray(helpHubData) ? (helpHubData as HelpHubRecord[]) : [];
  return all
    .filter((t) => {
      const slug = typeof t.slug === "string" ? t.slug.trim() : "";
      return (
        slug !== "" && !reservedPaths.includes(slug) && helpHubTipIsPublic(t)
      );
    })
    .map((t) => ({
      params: { slug: (t.slug as string).trim() },
      props: { tip: t },
    }));
}

const tip = Astro.props.tip as HelpHubRecord;

const lessonRecords = Array.isArray(lessons)
  ? (lessons as LessonRecord[])
  : [];

const relatedLessonsResolved = resolveHelpHubRelatedLessons(
  tip.relatedLessons,
  lessonRecords,
);

const memberLessonsSectionTitle =
  relatedLessonsResolved.length === 1 ? "Member Lesson" : "Member Lessons";

const whyBodyRaw =
  typeof tip.solutionText === "string" && tip.solutionText.trim() !== ""
    ? tip.solutionText.trim()
    : typeof tip.bridge === "string" && tip.bridge.trim() !== ""
      ? tip.bridge.trim()
      : "";
const whyBody = whyBodyRaw;

const tipJumpLinks: { label: string; href: string }[] =
  Array.isArray(tip.jumpLinks)
    ? tip.jumpLinks.filter(
        (j): j is { label: string; href: string } =>
          !!j &&
          typeof j.label === "string" &&
          j.label.trim() !== "" &&
          typeof j.href === "string" &&
          j.href.trim() !== ""
      )
    : [];

const appliesToList = Array.isArray(tip.appliesTo)
  ? tip.appliesTo
      .map((item) => (typeof item === "string" ? item.trim() : ""))
      .filter((item) => item.length > 0)
  : [];
const showAllMachines = tip.allMachines === true;
const showSpecificMachines = !showAllMachines && appliesToList.length > 0;

function filterTrySteps(steps: unknown): string[] {
  if (!Array.isArray(steps)) return [];
  return steps.filter(
    (step): step is string =>
      typeof step === "string" &&
      step.trim() !== "" &&
      step.trim() !== "..."
  );
}

const quickSteps = filterTrySteps(tip.trySteps ?? tip.tryThis?.quickAction);
const tryImageUrl =
  typeof tip.tryImage === "string" && tip.tryImage.trim() !== ""
    ? tip.tryImage.trim()
    : "";
const tryImageCaptionResolved =
  typeof tip.tryImageCaption === "string" && tip.tryImageCaption.trim() !== ""
    ? tip.tryImageCaption.trim()
    : "";
const hasTrySection =
  quickSteps.length > 0 ||
  (typeof tip.tryThisTitle === "string" && tip.tryThisTitle.trim() !== "");

const mediaType = typeof tip.mediaType === "string" ? tip.mediaType : "";
const mediaUrl = typeof tip.mediaUrl === "string" ? tip.mediaUrl.trim() : "";
const mediaPoster =
  typeof tip.mediaPoster === "string" ? tip.mediaPoster.trim() : "";
const mediaAlt = typeof tip.mediaAlt === "string" ? tip.mediaAlt.trim() : "";

const tipVideoIdRaw = tip.videoId;
const tipVideoId =
  tipVideoIdRaw !== undefined &&
  tipVideoIdRaw !== null &&
  String(tipVideoIdRaw).trim() !== ""
    ? String(tipVideoIdRaw).trim()
    : "";
const catalogVideoForTip =
  tipVideoId !== ""
    ? catalogVideosHelpHub.find(
        (v) => String(v.content_id ?? "") === tipVideoId,
      )
    : undefined;
const catalogVimeoNumericId =
  catalogVideoForTip != null
    ? vimeoNumericIdFromPublicVideo(catalogVideoForTip)
    : null;
const catalogVimeoEmbedUrl =
  catalogVimeoNumericId != null
    ? `https://player.vimeo.com/video/${catalogVimeoNumericId}`
    : "";

const pageTitle =
  (typeof tip.metaTitle === "string" && tip.metaTitle.trim() !== ""
    ? tip.metaTitle.trim()
    : typeof tip.title === "string" && tip.title.trim() !== ""
      ? tip.title.trim()
      : "") || "Help Hub";
const layoutTitle =
  pageTitle.length > 55
    ? `Help Hub — ${pageTitle.slice(0, 55)}… | Knit it Now`
    : `Help Hub — ${pageTitle} | Knit it Now`;

const pageDescription =
  (typeof tip.metaDescription === "string" && tip.metaDescription.trim() !== ""
    ? tip.metaDescription.trim()
    : typeof tip.shortAnswer === "string" && tip.shortAnswer.trim() !== ""
      ? tip.shortAnswer.trim()
      : typeof tip.bubbleAnswer === "string" && tip.bubbleAnswer.trim() !== ""
        ? tip.bubbleAnswer.trim()
        : "") ||
  "Machine knitting help from Knit it Now.";

const aboutHeading =
  typeof tip.aboutTitle === "string" && tip.aboutTitle.trim() !== ""
    ? tip.aboutTitle.trim()
    : "Why This Works";

const tryHeading =
  typeof tip.tryThisTitle === "string" && tip.tryThisTitle.trim() !== ""
    ? tip.tryThisTitle.trim()
    : "Try This";

/**
 * FAQPage JSON-LD, server-rendered, built only from the tip's *visible* Q&A content.
 * Emitted only when there are >= 2 genuine question-shaped Q&A items (no fabricated FAQs).
 */
const faqPage = buildHelpHubFaqPage({
  question: tip.question,
  title: tip.title,
  bubbleAnswer: tip.bubbleAnswer,
  aboutTitle: tip.aboutTitle,
  solutionText: tip.solutionText,
  bridge: tip.bridge,
  tryThisTitle: tip.tryThisTitle,
  tryThis: tip.tryThis,
  trySteps: tip.trySteps,
});
const faqJsonLd = faqPage ? serializeJsonLd(faqPage) : "";
---

<Layout title={layoutTitle} description={pageDescription} bodyClass="page--tight-header">
  {faqJsonLd && (
    <script type="application/ld+json" set:html={faqJsonLd} />
  )}
  <PageHead title="Help Hub" subhead={undefined} hideTitle={true} />

  <section class="container py-5 tips-page-section">
    <PageBackLink href="/help-hub" text="Back to Help Hub" />
    <div class="tuesday-tip-hero">
      {typeof tip.hook === "string" && tip.hook.trim() !== "" && (
        <p class="bubble-hook tuesday-tip-hero__hook" data-placeholder="short subtitle/supporting sentence">
          {tip.hook}
        </p>
      )}

      {(showAllMachines || showSpecificMachines) && (
        <div class="tip-meta-row">
          {showAllMachines ? (
            <span class="machine-pill">All Machines</span>
          ) : (
            <p class="tuesday-tip-applies-to">
              <strong>Works for:</strong> {appliesToList.join(", ")}
            </p>
          )}
        </div>
      )}

      <div class="tuesday-tip-hero__columns">
        <div class="tuesday-tip-hero__content">
          <div class="tuesday-tip-bubbles">
            {(tip.question || tip.title) && (
              <div class="talk-row talk-left tuesday-tip-bubble-row">
                <h1 class="talk-bubble bubble-bl bubble-question tuesday-tip__question" data-placeholder="title">
                  {tip.question || tip.title || "Help Hub"}
                </h1>
              </div>
            )}

            {typeof tip.bubbleAnswer === "string" &&
              tip.bubbleAnswer.trim() !== "" && (
                <div class="talk-row talk-right tuesday-tip-bubble-row" aria-label="Quick answer">
                  <div class="talk-bubble bubble-br bubble-answer tuesday-tip__answer">
                    <div class="tuesday-tip__answer-inner">
                      <img
                        src="/images/KINlogo.svg"
                        alt="Knit it Now"
                        class="tuesday-tip__logo"
                        width="60"
                        height="60"
                      />
                      <div
                        class="tuesday-tip__answer-text"
                        data-placeholder="quick answer"
                        set:html={tip.bubbleAnswer}
                      />
                    </div>
                  </div>
                </div>
              )}
          </div>
        </div>

        <div class="tuesday-tip-hero__media" aria-label="Free visual">
        <div class="tuesday-tip-video-shell" data-placeholder="hero media">
          <div class="tuesday-tip-video-aspect">
            {catalogVimeoEmbedUrl ? (
              <div class="help-hub-media">
                <iframe
                  src={catalogVimeoEmbedUrl}
                  class="tuesday-tip-video-iframe"
                  title={tip.question || tip.title || "Help Hub video"}
                  frameborder="0"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            ) : mediaType === "image" && mediaUrl ? (
              <img
                src={mediaUrl}
                alt={mediaAlt}
                class="tuesday-tip-media-image"
                loading="lazy"
              />
            ) : mediaType === "vimeo" && mediaUrl ? (
              <div class="help-hub-media">
                <iframe
                  src={`https://player.vimeo.com/video/${mediaUrl}`}
                  class="tuesday-tip-video-iframe"
                  title={tip.question || tip.title || "Help Hub video"}
                  frameborder="0"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            ) : mediaType === "video" && mediaUrl ? (
              <video
                class="tuesday-tip-video-native"
                controls
                playsinline
                preload="metadata"
                poster={mediaPoster || undefined}
              >
                <source src={mediaUrl} />
                {mediaAlt ? <p>{mediaAlt}</p> : null}
              </video>
            ) : (
              <div class="tuesday-tip-video-fallback">
                <p class="tuesday-tip-video-fallback__text">
                  Media will appear here when a published media URL is set in the Help Hub
                  record.
                </p>
              </div>
            )}
          </div>
        </div>
        </div>
      </div>
    </div>

    <section
      class="tuesday-tip__section tuesday-tip__section--why"
      aria-labelledby="help-hub-why-heading"
    >
      <h2 id="help-hub-why-heading" class="tuesday-tip__section-heading">
        {aboutHeading}
      </h2>
      <div class="tuesday-tip__section-card">
        {whyBody ? (
          <div
            class="tuesday-tip__description"
            data-placeholder="why this works text"
            set:html={whyBody}
          ></div>
        ) : (
          <p class="tuesday-tip__description" data-placeholder="why this works text">
            More detail for this tip will appear here when the Help Hub record includes a
            bridge.
          </p>
        )}
        {tipJumpLinks.length > 0 && (
          <nav class="tuesday-tip__jump-links" aria-label="Jump to sections on this page">
            <ul class="tuesday-tip__jump-links-list">
              {tipJumpLinks.map((j) => (
                <li>
                  <a href={j.href.trim()}>{j.label.trim()}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <section class="tuesday-tip__transcript" data-placeholder="transcript"></section>
        <p class="help-hub-cta-inline">
          <strong>Need more help?</strong> If you'd like personal guidance,
          <a href="/help-hub/work-with-sue" class="help-hub-cta-link">Work with Sue</a>.
        </p>
      </div>
    </section>

    {hasTrySection && quickSteps.length > 0 && (
      <section class="tuesday-tip__section tuesday-tip__try-section">
        <div class="tuesday-tip__try-card">
          <h2 class="tuesday-tip__section-heading tuesday-tip__try-heading">{tryHeading}</h2>
          {typeof tip.tryThis?.quickActionTitle === "string" &&
            tip.tryThis.quickActionTitle.trim() !== "" && (
              <p class="tuesday-tip__try-subhead">{tip.tryThis.quickActionTitle}</p>
            )}
          <div
            class:list={[
              "tuesday-tip__try-body",
              tryImageUrl && "tuesday-tip__try-body--with-image",
            ]}
          >
            <div class="tuesday-tip__try-checklist">
              <ul data-placeholder="try this checklist">
                {quickSteps.map((step) => (
                  <li set:html={step} />
                ))}
              </ul>
              {tip.tryThis?.quickActionNote && (
                <div class="try-this-note" set:html={tip.tryThis.quickActionNote}></div>
              )}
            </div>
            {tryImageUrl && (
              <div class="tuesday-tip__try-image-wrap">
                <img
                  src={tip.tryImage}
                  alt={tip.tryImageAlt || ""}
                  loading="lazy"
                  class="tuesday-tip__try-image"
                />
                {tryImageCaptionResolved ? (
  <p class="try-image-caption" set:html={tryImageCaptionResolved}></p>
) : null}
              </div>
            )}
            {tip.tryNote && (
            <p class="try-note" set:html={tip.tryNote}></p>)}
          </div>
        </div>
      </section>
    )}

    <section
      class="help-hub-member-lessons"
      aria-labelledby="member-lessons-heading"
      data-help-hub-lessons
    >
      <div class="help-hub-member-lessons__header">
        <div class="help-hub-member-lessons__heading-row">
          <img
            src="/images/KINlogo.svg"
            alt=""
            width="48"
            height="48"
            class="help-hub-member-lessons__logo"
            aria-hidden="true"
          />
          <h2 id="member-lessons-heading" class="help-hub-member-lessons__section-title">
            {memberLessonsSectionTitle}
          </h2>
        </div>
        <p class="help-hub-member-lessons__subhead">
          Go deeper with step-by-step guidance.
        </p>
      </div>

      {relatedLessonsResolved.length === 0 ? (
        <p class="help-hub-member-lessons__empty">No lessons linked to this tip yet.</p>
      ) : (
        <ul class="help-hub-member-lessons__list">
          {relatedLessonsResolved.map((lesson) => {
            const lessonSlug =
              typeof lesson.slug === "string" ? lesson.slug.trim() : "";
            const title =
              typeof lesson.title === "string" && lesson.title.trim() !== ""
                ? lesson.title
                : lessonSlug;
            const summary =
              typeof lesson.summary === "string" ? lesson.summary.trim() : "";
            const hubSlug =
              typeof tip.slug === "string" ? tip.slug.trim() : slugParam;
            const lessonHref =
              lessonSlug.length > 0
                ? `/lessons/${lessonSlug}?from=help-hub&hub=${hubSlug}`
                : `/lessons?from=help-hub&hub=${hubSlug}`;
            return (
              <li class="help-hub-member-lessons__card">
                <h3 class="help-hub-member-lessons__title">{title}</h3>
                {summary ? (
                  <div class="help-hub-member-lessons__summary" set:html={summary}></div>
                ) : null}
                <div class="help-hub-member-lessons__actions">
                  <div
                    class="help-hub-member-lessons__cta-mount"
                    data-hh-lesson-cta
                    data-lesson-href={lessonHref}
                  ></div>
                  <p class="help-hub-member-lessons__note" data-hh-lesson-note hidden>
                    Included with Knit it Now membership.
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>

    <script>
      import { bootHelpHubMemberLessonGates } from "../../scripts/helpHubMemberLessonGateClient";

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bootHelpHubMemberLessonGates);
      } else {
        bootHelpHubMemberLessonGates();
      }
    </script>
  </section>
</Layout>

<style>
  .tips-page-section {
    max-width: min(1180px, 100%);
    margin-left: auto;
    margin-right: auto;
  }

  .tuesday-tip-hero {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 1.75rem;
    padding: clamp(1rem, 2.5vw, 1.4rem);
    border: 1px solid rgba(82, 104, 45, 0.18);
    border-radius: 16px;
    background: #f8faf6;
    position: relative;
  }

  .tuesday-tip-hero__hook {
    margin: 0 0 1rem 0;
    flex: 0 0 auto;
    order: 0;
  }

  /* Machine meta: direct child of .tuesday-tip-hero only — never inside .tuesday-tip-bubbles */
  .tuesday-tip-hero > .tip-meta-row {
    margin: 0 0 1rem 0;
    width: 100%;
    box-sizing: border-box;
    flex: 0 0 auto;
    order: 1;
    position: relative;
    /* Uncomment to verify DOM placement: outline: 2px solid red; */
  }

  .tip-meta-row .tuesday-tip-applies-to {
    margin: 0;
  }

  .tuesday-tip-hero__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    flex: 0 1 auto;
    order: 2;
    position: relative;
  }

  @media (min-width: 980px) {
    .tuesday-tip-hero__columns {
      grid-template-columns: minmax(320px, 1fr) minmax(420px, 1fr);
      gap: clamp(1.2rem, 2.5vw, 2rem);
      align-items: start;
    }
  }

  .tuesday-tip-hero__content {
    min-width: 0;
  }

  .tuesday-tip-bubbles {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .tuesday-tip-hero > .tuesday-tip-hero__hook.bubble-hook {
    font-size: clamp(0.98rem, 1.45vw, 1.06rem);
    font-weight: 400;
    line-height: 1.55;
    color: #5e6c4d;
  }

  .tuesday-tip-applies-to {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: #475569;
  }

  .machine-pill {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(82, 104, 45, 0.25);
    background: rgba(82, 104, 45, 0.08);
    color: #3f4b35;
    font-size: 0.8rem;
    line-height: 1.2;
    font-weight: 600;
  }

  .tuesday-tip-bubble-row.talk-row {
    margin: 0;
  }

  .tuesday-tip-bubble-row.talk-left {
    margin-top: 0.3rem;
  }

  .tuesday-tip-bubbles .talk-bubble {
    max-width: 100%;
  }

  .talk-bubble.tuesday-tip__question {
    font-size: clamp(1.45rem, 2.6vw, 1.95rem);
    font-weight: 650;
    line-height: 1.16;
    margin: 0;
    color: #6f8550;
  }

  .talk-bubble.tuesday-tip__answer {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.55;
    padding: 16px 20px 16px 20px;
    margin-left: 60px;
  }

  .tuesday-tip__answer-inner {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .tuesday-tip__logo {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
  }

  .tuesday-tip__answer-text {
    flex: 1;
  }

  .tuesday-tip-hero__media {
    min-width: 0;
  }

  .tuesday-tip-video-shell {
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 0.5rem;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    width: 100%;
    max-width: 100%;
  }

  .tuesday-tip-video-aspect {
    position: relative;
    width: 100%;
    padding-bottom: 60%;
    height: 0;
    border-radius: 8px;
    background: #0f172a;
  }

  .tuesday-tip-video-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .tuesday-tip-video-native {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    object-fit: contain;
    background: #000;
  }

  .help-hub-media {
    position: absolute;
    inset: 0;
  }

  .tuesday-tip-media-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tuesday-tip-video-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: linear-gradient(160deg, #f1f5f9 0%, #e2e8f0 100%);
  }

  .tuesday-tip-video-fallback__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #64748b;
    text-align: center;
    max-width: 16rem;
  }

  .tuesday-tip__section {
    margin-top: 2rem;
  }

  .tuesday-tip__section--why {
    margin-top: 0.75rem;
  }

  .tuesday-tip__section-heading {
    margin: 0 0 0.7rem;
    font-size: clamp(1.12rem, 2.1vw, 1.32rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--kbm-green, #52682d);
  }

  .tuesday-tip__section-card {
    border-radius: 12px;
    border: 1px solid rgba(82, 104, 45, 0.16);
    background: #fff;
    padding: clamp(0.95rem, 2.1vw, 1.15rem);
  }

  .tuesday-tip__description {
    margin: 0;
    max-width: 100%;
    font-size: 1rem;
    line-height: 1.65;
    color: #2f3a25;
  }

  .tuesday-tip__jump-links {
    margin: 0 0 1rem;
    max-width: 100%;
  }

  .tuesday-tip__jump-links-list {
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.6;
    color: #334155;
  }

  .tuesday-tip__jump-links a {
    color: var(--kbm-green, #52682d);
    text-decoration: none;
  }

  .tuesday-tip__jump-links a:hover {
