---
import Layout from "../../layouts/Layout.astro";
import "../../components/talk-bubbles.css";
import { loadPublicHelpHubTips } from "../../lib/helpHub/loadTips";
import { loadPublicHelpHubCategories } from "../../lib/helpHub/loadCategories";
import {
  helpHubIndexCategorySections,
  helpHubIndexNewCards,
} from "../../lib/helpHub/publicIndex";
import { helpHubTipIsPublic } from "../../lib/helpHubPublic";

export const prerender = false;

const [helpHubData, helpHubCategories] = await Promise.all([
  loadPublicHelpHubTips(),
  loadPublicHelpHubCategories(),
]);

/** Live entries for the top “New in the Help Hub” section (isNew === true). */
const newHelpHubItems = helpHubIndexNewCards(helpHubData);
const categorySections = helpHubIndexCategorySections(helpHubData, helpHubCategories);

const debugHelpHubTip = (Array.isArray(helpHubData) ? helpHubData : []).find(
  (item) => typeof item.slug === "string" && item.slug.trim() === "change-colors-lk150",
);
if (debugHelpHubTip) {
  console.log("[KBM catalog debug] help-hub/index loader", {
    source: "loadPublicHelpHubTips",
    slug: debugHelpHubTip.slug,
    status: debugHelpHubTip.status,
    isNew: debugHelpHubTip.isNew,
    helpHubTipIsPublic: helpHubTipIsPublic(debugHelpHubTip),
    inNewHelpHubItems: newHelpHubItems.some(
      (item) => typeof item.slug === "string" && item.slug.trim() === "change-colors-lk150",
    ),
  });
}
---

<Layout
  title="Knit Fix Hub | Knit it Now"
  description="Clear, focused fixes and guided paths for common machine knitting problems — get back to knitting with confidence."
>
  <section
    class="container py-5 knit-fix-hub"
    aria-labelledby="knit-fix-hub-heading"
  >
    <div class="knit-fix-hub-inner">
      <h2 class="visually-hidden">Browse fixes</h2>

      <div class="fix-hub-banner">
        <div class="fix-hub-banner-logo">
          <img
            id="knit-fix-hub-heading"
            src="/images/help-hub.svg"
            alt="Let's Fix This"
            class="fix-hub-logo help-hub-hero-icon"
          />
        </div>
        <div class="fix-hub-banner-text">
          <p class="fix-hub-tagline">Welcome to the Help Hub.</p>
          <div class="help-hub-intro">
            <p>
              The Help Hub is where you’ll find focused help for common machine knitting
              problems, questions, and next steps. Browse the fixes below to find the one
              that matches what you need.
            </p>
            <p style="margin-top: 10px;">
              Not finding what you need? 
              <strong><a href="#help-request">Tell me where you're stuck →</a></strong>
            </p>
          </div>
        </div>
      </div>

      <div class="fix-hub-divider fix-hub-divider--after-cards"></div>

      {newHelpHubItems.length > 0 && (
        <>
          <section
            class="fix-category-section fix-category-section--new"
            aria-labelledby="help-hub-new-heading"
          >
            <h2 id="help-hub-new-heading" class="fix-category-heading">
              New in the Help Hub
            </h2>
            <div class="fix-bubble-grid">
              {newHelpHubItems.map((item) => (
                <a
                  href={`/help-hub/${item.slug}`}
                  class="talk-bubble bubble-bl bubble-question"
                >
                  <strong>{item.heading}</strong>
                </a>
              ))}
            </div>
          </section>
        </>
      )}

      <div class="fix-category-list">
        {categorySections.map((group) => (
          <section class="fix-category-section">
            <h2 class="fix-category-heading">{group.label}</h2>
            <div class="fix-bubble-grid">
              {group.cards.map((card) => (
                <a
                  href={`/help-hub/${card.slug}`}
                  class="talk-bubble bubble-bl bubble-question"
                >
                  <strong>{card.heading}</strong>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>

      <section id="help-request" class="help-hub-footer">
        <div class="help-hub-request-card">
        <h2>Not finding your answer?</h2>

        <p>
          Send me a quick note about what’s going wrong. I’ll help point you in the right direction — and I can improve the Help Hub for other knitters.
        </p>

        <form
          id="help-hub-question-form"
          name="help-hub-question"
          method="POST"
          action="/.netlify/functions/contact"
          enctype="multipart/form-data"
          netlify-honeypot="bot-field"
          class="help-hub-form"
        >
          <input type="hidden" name="form-name" value="help-hub-question" />
          <p class="help-hub-form__honeypot" aria-hidden="true">
            <label>Don’t fill this out: <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <input type="hidden" name="page_url" id="helpHubFormPageUrl" />
          <input type="hidden" name="submitted_at" id="helpHubFormSubmittedAt" />
          <input type="hidden" name="form_source" value="help-hub" />

          <div class="floating-input">
            <input type="text" id="firstName" name="firstName" placeholder=" " required />
            <label for="firstName" class="floating-label">First name</label>
          </div>

          <div class="floating-input">
            <input type="email" id="email" name="email" placeholder=" " required />
            <label for="email" class="floating-label">Email</label>
          </div>

          <div class="floating-input floating-input--textarea">
            <textarea id="question" name="question" rows="4" placeholder=" " required></textarea>
            <label for="question" class="floating-label">What do you need help with?</label>
          </div>

          <p id="help-hub-submit-error" class="help-hub-form__error" hidden role="alert"></p>

          <button type="submit" class="kbm-btn kbm-btn-primary help-hub-form__submit" id="help-hub-submit-btn">
            Send My Question
          </button>
        </form>
        </div>
      </section>

    </div>
  </section>

  <script>
    import { wireContactFormSubmit } from "../../scripts/contactFormSubmit";

    const form = document.getElementById("help-hub-question-form");
    if (form instanceof HTMLFormElement) {
      wireContactFormSubmit({
        form,
        submitBtn: document.getElementById("help-hub-submit-btn") as HTMLButtonElement | null,
        submitErrorEl: document.getElementById("help-hub-submit-error"),
        pageUrlInput: document.getElementById("helpHubFormPageUrl") as HTMLInputElement | null,
        submittedAtInput: document.getElementById("helpHubFormSubmittedAt") as HTMLInputElement | null,
      });
    }
  </script>

  <style>
    html {
  scroll-behavior: smooth;
}

    .knit-fix-hub-inner {
      max-width: 960px;
      margin: 0 auto;
      padding-bottom: 3rem;
    }

    .fix-hub-banner {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1rem 1.25rem;
      border-radius: 32px;
      margin-top: 0.75rem;
    }

    .fix-hub-banner-logo {
      flex: 0 0 auto;
    }

    .fix-hub-logo {
      width: 100px;
      max-width: 100%;
      height: auto;
      display: block;
    }

    .help-hub-hero-icon {
      max-width: 72px;
      height: auto;
    }

    .fix-hub-banner-text {
      flex: 1 1 auto;
    }

    .fix-hub-tagline {
      font-size: 1.2rem;
      line-height: 1.3;
      font-weight: 600;
      color: var(--kbm-green);
      margin: 0 0 0.5rem 0;
    }

    .fix-hub-banner-text .help-hub-intro p {
      margin: 0;
      font-size: var(--text-base);
      color: #243015;
      line-height: 1.6;
    }

    @media (max-width: 768px) {
      .fix-hub-banner {
        gap: 0.75rem;
        padding: 0.9rem 1rem;
      }

      .fix-hub-logo {
        width: 86px;
      }

      .fix-hub-tagline {
        font-size: 1.1rem;
      }
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .fix-hub-divider {
      height: 1px;
      background: rgba(82, 104, 45, 0.2);
      margin: 2rem 0 2.5rem;
    }

    .fix-hub-divider--after-cards {
      margin: 2.25rem 0 0;
    }

    .fix-category-section {
      margin-bottom: 3rem;
    }

    .fix-category-heading {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--kbm-green);
      margin-bottom: 1rem;
    }

    .fix-bubble-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* row gap, column gap — more room between bubbles without changing layout */
      gap: 3rem 3.5rem;
      align-items: start;
    }

    .fix-bubble-grid .talk-bubble {
      display: block;
      width: 100%;
      max-width: 100%;
      margin: 0 !important;
    }

    .fix-bubble-grid .talk-bubble + .talk-bubble {
      margin-top: 0 !important;
    }

    @media (max-width: 768px) {
      .fix-bubble-grid {
        grid-template-columns: 1fr;
        gap: 1.75rem;
      }
    }

    /* Links use talk-bubble visuals; keep them readable and focusable. */
    .knit-fix-hub .fix-bubble-grid a.talk-bubble {
      text-decoration: none;
      color: inherit;
    }

    .knit-fix-hub .fix-bubble-grid a.talk-bubble:focus-visible {
      outline: 2px solid var(--kbm-green, #52682d);
      outline-offset: 3px;
    }

    .fix-category-section--new {
      margin-bottom: 3rem;
    }

    .help-hub-footer {
      margin-top: 3.5rem;
      padding-top: 0;
      border-top: none;
      max-width: none;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .help-hub-request-card {
      width: 100%;
      max-width: 36rem;
      margin-top: 0;
      padding: 1.75rem 1.5rem 2rem;
      border: 1px solid rgba(82, 104, 45, 0.22);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.72);
      box-shadow: 0 1px 4px rgba(36, 48, 21, 0.06);
    }

    .help-hub-request-card h2 {
      margin-top: 0;
      text-align: center;
    }

    .help-hub-request-card > p {
      text-align: center;
      margin-bottom: 1.25rem;
      color: #374151;
      line-height: 1.55;
    }

    .help-hub-form__honeypot {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .help-hub-form {
      margin-top: 0.25rem;
    }

    .help-hub-form__submit {
      margin-top: 0.5rem;
      display: block;
      margin-left: auto;
      margin-right: auto;
    }

    .help-hub-form__error {
      margin: 0.75rem 0 0;
      font-size: 0.9rem;
      color: #b91c1c;
      text-align: center;
    }

    .help-hub-form__error[hidden] {
      display: none;
    }

    @media (max-width: 768px) {
      .help-hub-request-card {
        padding: 1.35rem 1.15rem 1.65rem;
        max-width: 100%;
      }
    }

    .help-hub-form .floating-input {
      margin-bottom: 0.75rem;
    }
  </style>
</Layout>
