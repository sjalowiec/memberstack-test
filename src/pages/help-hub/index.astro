---
import Layout from "../../layouts/Layout.astro";
import TurnstileWidget from "../../components/TurnstileWidget.astro";
import FavoritesRuntime from "../../components/favorites/FavoritesRuntime.astro";
import FavoriteStar from "../../components/favorites/FavoriteStar.astro";
import "../../components/talk-bubbles.css";
import "../../styles/favorites.css";
import HelpHubTipContent from "../../components/help-hub/HelpHubTipContent.astro";
import { loadPublicHelpHubTips } from "../../lib/helpHub/loadTips";
import { loadPublicHelpHubCategories } from "../../lib/helpHub/loadCategories";
import { loadPublicLessons } from "../../lib/lessons/loadLessons";
import {
  helpHubDiscoveryEntries,
  helpHubFavoriteContentId,
} from "../../lib/helpHub/discovery";
import {
  HELP_HUB_FAVORITES_EMPTY_MESSAGE,
  helpHubFavoriteTipCatalog,
} from "../../lib/helpHub/favoriteTips";
import {
  helpHubIndexCategorySections,
  helpHubIndexNewCards,
  helpHubPublishedPermalinks,
} from "../../lib/helpHub/publicIndex";
import { helpHubTipIsPublic, helpHubTipSearchText, type HelpHubTipRecord } from "../../lib/helpHubPublic";
import { loadMergedVideoCatalog } from "../../lib/videos/videoCatalogStore";

export const prerender = false;

const [helpHubData, helpHubCategories, lessons, catalogVideos] = await Promise.all([
  loadPublicHelpHubTips(),
  loadPublicHelpHubCategories(),
  loadPublicLessons(),
  loadMergedVideoCatalog(),
]);

const tipBySlug = new Map<string, HelpHubTipRecord>();
for (const tip of Array.isArray(helpHubData) ? helpHubData : []) {
  const slug = typeof tip.slug === "string" ? tip.slug.trim() : "";
  if (slug && !tipBySlug.has(slug)) tipBySlug.set(slug, tip);
}

/** Live entries for the first accordion, “New in the Help Hub” (isNew === true, newest first). */
const newHelpHubItems = helpHubIndexNewCards(helpHubData);
const categorySections = helpHubIndexCategorySections(helpHubData, helpHubCategories);
const publishedPermalinks = helpHubPublishedPermalinks(
  Array.isArray(helpHubData) ? helpHubData : [],
);
const discoveryEntries = helpHubDiscoveryEntries(Array.isArray(helpHubData) ? helpHubData : []);
const discoveryEntry = discoveryEntries[0] ?? null;
const discoveryJson = JSON.stringify(discoveryEntries).replace(/</g, "\\u003c");
const discoveryFavoriteId = discoveryEntry ? helpHubFavoriteContentId(discoveryEntry.slug) : "";
const favoriteCatalogJson = JSON.stringify(
  helpHubFavoriteTipCatalog(Array.isArray(helpHubData) ? helpHubData : []),
).replace(/</g, "\\u003c");

const debugHelpHubTip = (Array.isArray(helpHubData) ? helpHubData : []).find(
  (item) => typeof item.slug === "string" && item.slug.trim() === "change-colors-lk150",
);
if (debugHelpHubTip) {
  console.log("[KBM catalog debug] help-hub/index loader", {
    source: "loadPublicHelpHubTips",
    slug: debugHelpHubTip.slug,
    status: debugHelpHubTip.status,
    isNew: debugHelpHubTip.isNew,
    helpHubTipIsPublic: helpHubTipIsPublic(debugHelpHubTip),
    inNewHelpHubItems: newHelpHubItems.some(
      (item) => typeof item.slug === "string" && item.slug.trim() === "change-colors-lk150",
    ),
  });
}
---

<Layout
  title="Knit Fix Hub | Knit it Now"
  description="Clear, focused fixes and guided paths for common machine knitting problems — get back to knitting with confidence."
>
  <section
    class="container py-5 knit-fix-hub"
    aria-labelledby="knit-fix-hub-heading"
    data-help-hub-index
  >
    <div class="knit-fix-hub-inner">
      <h2 class="visually-hidden">Browse fixes</h2>

      <div class="help-hub-welcome">
        <div class="fix-hub-banner-logo">
          <img
            id="knit-fix-hub-heading"
            src="/images/help-hub.svg"
            alt="Let's Fix This"
            class="fix-hub-logo help-hub-hero-icon"
          />
        </div>
        <p class="help-hub-intro">Quick answers and practical ideas for your machine knitting.</p>
      </div>

      <div data-help-hub-browse>
      <div class="help-hub-search">
        <label for="help-hub-search-input">Search the Help Hub</label>
        <input
          id="help-hub-search-input"
          type="search"
          placeholder="Search for a problem, technique, or machine..."
          autocomplete="off"
          enterkeyhint="search"
        />
      </div>

      <div class="help-hub-search-feedback" aria-live="polite">
        <p class="help-hub-search-status" data-help-hub-search-status></p>
        <div class="help-hub-search-empty" data-help-hub-search-empty hidden>
          <h2>No Help Hub answer yet.</h2>
          <ol>
            <li>
              <button type="button" class="help-hub-text-button" data-help-hub-open-site-search>
                Try a site-wide search
              </button>
            </li>
            <li>
              <a href="#help-request">Send me your question</a> using the form below.
            </li>
          </ol>
        </div>
      </div>

      {discoveryEntry && (
        <section
          class="help-hub-discovery"
          aria-labelledby="help-hub-discovery-heading"
          data-help-hub-discovery
        >
          <h2 id="help-hub-discovery-heading" class="visually-hidden">
            A question and a quick answer
          </h2>
          <div class="help-hub-discovery__conversation">
            <div class="help-hub-discovery__question-row">
              <p class="help-hub-discovery__eyebrow">Featured Help Hub</p>
              <div class="help-hub-discovery__question-line">
                <p class="talk-bubble help-hub-discovery__question" data-help-hub-discovery-question>
                  {discoveryEntry.question}
                </p>
                <FavoriteStar
                  contentType="reference"
                  contentId={discoveryFavoriteId}
                  title={discoveryEntry.question}
                  actionTooltip
                />
              </div>
            </div>
            <div class="help-hub-discovery__answer-row">
              <div class="help-hub-discovery__answer-block">
                <div class="talk-bubble help-hub-discovery__answer" data-help-hub-discovery-answer>
                  <p data-help-hub-discovery-answer-text>{discoveryEntry.answer}</p>
                </div>
                <div class="help-hub-discovery__actions">
                  <a
                    class="help-hub-discovery__explore"
                    href={`/help-hub/${discoveryEntry.slug}`}
                    target="_self"
                    data-help-hub-discovery-explore
                  >
                    Read full answer →
                  </a>
                  <button
                    type="button"
                    class="kbm-btn kbm-btn-outline help-hub-discovery__surprise"
                    data-help-hub-discovery-surprise
                    data-tooltip="Show another random question"
                    disabled={discoveryEntries.length < 2}
                  >
                    <i class="fa-solid fa-shuffle help-hub-discovery__surprise-icon" aria-hidden="true"></i>
                    Surprise Me
                  </button>
                </div>
              </div>
            </div>
          </div>
          <p class="visually-hidden" data-help-hub-discovery-status aria-live="polite"></p>
          <script
            type="application/json"
            data-help-hub-discovery-entries
            is:inline
            set:html={discoveryJson}
          ></script>
        </section>
      )}

      <div class="fix-hub-divider fix-hub-divider--after-cards"></div>

      {publishedPermalinks.length > 0 && (
        <nav class="visually-hidden" aria-label="All Help Hub answers" data-help-hub-permalinks>
          <h2>All Help Hub answers</h2>
          <ul>
            {publishedPermalinks.map((link) => (
              <li>
                <a href={`/help-hub/${link.slug}`} tabindex="-1">{link.heading}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="fix-category-list">
        {newHelpHubItems.length > 0 && (
          <details
            class="fix-category-section fix-category-section--new"
            data-help-hub-new
          >
            <summary class="fix-category-summary">
              <h2 id="help-hub-new-heading" class="fix-category-heading">
                <img
                  src="/images/logos/kin_logo.svg"
                  alt=""
                  class="help-hub-accordion-icon"
                  width="20"
                  height="20"
                  aria-hidden="true"
                />
                New in the Help Hub
              </h2>
              <span class="fix-category-toggle__chevron" aria-hidden="true"></span>
            </summary>
            <ul class="help-hub-question-list">
              {newHelpHubItems.map((item) => {
                const tip = tipBySlug.get(item.slug);
                if (!tip) return null;
                const instanceId = `new-${item.slug}`;
                return (
                  <li
                    class="help-hub-question-row"
                    data-help-hub-entry
                    data-help-hub-slug={item.slug}
                    data-help-hub-search={helpHubTipSearchText(tip, helpHubCategories)}
                  >
                    <details class="help-hub-question" data-help-hub-answer>
                      <summary class="help-hub-question-summary">
                        <a class="help-hub-question-permalink" href={`/help-hub/${item.slug}`}>
                          <strong>{item.heading}</strong>
                        </a>
                      </summary>
                      <div class="help-hub-inline-answer" data-pagefind-ignore>
                        <HelpHubTipContent
                          tip={tip}
                          lessons={lessons}
                          videos={catalogVideos}
                          embedded
                          deferMedia
                          idPrefix={instanceId}
                        />
                      </div>
                    </details>
                    <FavoriteStar
                      contentType="reference"
                      contentId={helpHubFavoriteContentId(item.slug)}
                      title={item.heading}
                      actionTooltip
                    />
                  </li>
                );
              })}
            </ul>
          </details>
        )}

        <details class="fix-category-section" data-help-hub-favorites>
          <summary class="fix-category-summary">
            <h2 id="help-hub-favorites-heading" class="fix-category-heading">
              <i class="fa-solid fa-star help-hub-accordion-icon help-hub-accordion-icon--star" aria-hidden="true"></i>
              My Favorites
            </h2>
            <span class="fix-category-toggle__chevron" aria-hidden="true"></span>
          </summary>
          <div class="help-hub-favorites-panel" data-help-hub-favorites-panel>
            <div class="help-hub-favorites-guest" data-help-hub-favorites-guest hidden>
              <p>Sign in to see your saved Help Hub tips.</p>
              <button type="button" class="kbm-btn kbm-btn-outline help-hub-favorites-login" data-help-hub-favorites-login>
                Log in
              </button>
            </div>
            <p class="help-hub-favorites-empty" data-help-hub-favorites-empty hidden>
              {HELP_HUB_FAVORITES_EMPTY_MESSAGE}
            </p>
            <p class="help-hub-favorites-error" data-help-hub-favorites-error hidden>
              Could not load favorites. Please try again.
            </p>
            <ul class="help-hub-question-list" data-help-hub-favorites-list hidden></ul>
          </div>
          <script
            type="application/json"
            data-help-hub-favorite-catalog
            is:inline
            set:html={favoriteCatalogJson}
          ></script>
        </details>

        {categorySections.map((group) => (
          <details class="fix-category-section" data-help-hub-category={group.key}>
            <summary class="fix-category-summary">
              <h2 class="fix-category-heading">{group.label}</h2>
              <span class="fix-category-toggle__chevron" aria-hidden="true"></span>
            </summary>
            <ul class="help-hub-question-list">
              {group.cards.map((card) => {
                const tip = tipBySlug.get(card.slug);
                if (!tip) return null;
                const instanceId = `cat-${group.key}-${card.slug}`;
                return (
                  <li
                    class="help-hub-question-row"
                    data-help-hub-entry
                    data-help-hub-slug={card.slug}
                    data-help-hub-search={helpHubTipSearchText(tip, helpHubCategories)}
                  >
                    <details class="help-hub-question" data-help-hub-answer>
                      <summary class="help-hub-question-summary">
                        <a class="help-hub-question-permalink" href={`/help-hub/${card.slug}`}>
                          <strong>{card.heading}</strong>
                        </a>
                      </summary>
                      <div class="help-hub-inline-answer" data-pagefind-ignore>
                        <HelpHubTipContent
                          tip={tip}
                          lessons={lessons}
                          videos={catalogVideos}
                          embedded
                          deferMedia
                          idPrefix={instanceId}
                        />
                      </div>
                    </details>
                    <FavoriteStar
                      contentType="reference"
                      contentId={helpHubFavoriteContentId(card.slug)}
                      title={card.heading}
                      actionTooltip
                    />
                  </li>
                );
              })}
            </ul>
          </details>
        ))}
      </div>
      <FavoritesRuntime contentType="reference" />
      </div>

      <div
        class="help-hub-article-panel"
        data-help-hub-article-panel
        role="region"
        aria-labelledby="help-hub-article-title"
        hidden
      >
        <p class="help-hub-article-panel__nav">
          <button type="button" class="help-hub-article-back" data-help-hub-article-back>
            Back to Help Hub questions
          </button>
        </p>
        <h2 id="help-hub-article-title" class="help-hub-article-panel__title" data-help-hub-article-title tabindex="-1"></h2>
        <div data-help-hub-article-slot></div>
        <p class="help-hub-article-panel__nav help-hub-article-panel__nav--end">
          <button type="button" class="help-hub-article-back" data-help-hub-article-back>
            Back to Help Hub questions
          </button>
        </p>
      </div>

      <section id="help-request" class="help-hub-footer">
        <div class="help-hub-request-card">
        <h2>Not finding your answer?</h2>

        <p>
          Send me a quick note about what’s going wrong. I’ll help point you in the right direction — and I can improve the Help Hub for other knitters.
        </p>

        <form
          id="help-hub-question-form"
          name="help-hub-question"
          method="POST"
          action="/.netlify/functions/contact"
          enctype="multipart/form-data"
          netlify-honeypot="bot-field"
          class="help-hub-form"
        >
          <input type="hidden" name="form-name" value="help-hub-question" />
          <p class="help-hub-form__honeypot" aria-hidden="true">
            <label>Don’t fill this out: <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <input type="hidden" name="page_url" id="helpHubFormPageUrl" />
          <input type="hidden" name="submitted_at" id="helpHubFormSubmittedAt" />
          <input type="hidden" name="form_source" value="help-hub" />

          <div class="floating-input">
            <input type="text" id="firstName" name="firstName" placeholder=" " required />
            <label for="firstName" class="floating-label">First name</label>
          </div>

          <div class="floating-input">
            <input type="email" id="email" name="email" placeholder=" " required />
            <label for="email" class="floating-label">Email</label>
          </div>

          <div class="floating-input floating-input--textarea">
            <textarea id="question" name="question" rows="4" placeholder=" " required></textarea>
            <label for="question" class="floating-label">What do you need help with?</label>
          </div>

          <TurnstileWidget id="turnstile-help-hub" />

          <p id="help-hub-submit-error" class="help-hub-form__error" hidden role="alert"></p>

          <button type="submit" class="kbm-btn kbm-btn-primary help-hub-form__submit" id="help-hub-submit-btn">
            Send My Question
          </button>
        </form>
        </div>
      </section>

    </div>
  </section>

  <script>
    import { installHelpHubFavoriteAnalytics } from "../../lib/analytics/helpHubGa";
    import { installSearchCommitLogger } from "../../lib/searchActivityClient";
    import { bootHelpHubMemberLessonGates } from "../../scripts/helpHubMemberLessonGateClient";
    import { initHelpHubIndex } from "../../scripts/helpHubIndexClient";
    import { initHelpHubDiscovery } from "../../scripts/helpHubDiscoveryClient";
    import { initHelpHubLandingReturn } from "../../scripts/helpHubLandingReturnClient";
    import { initHelpHubFavorites } from "../../scripts/helpHubFavoritesClient";

    installSearchCommitLogger();
    installHelpHubFavoriteAnalytics();
    const helpHubIndex = document.querySelector("[data-help-hub-index]");
    if (helpHubIndex) {
      initHelpHubIndex(helpHubIndex);
      initHelpHubDiscovery(helpHubIndex);
      initHelpHubFavorites(helpHubIndex);
      initHelpHubLandingReturn(helpHubIndex);
    }
    bootHelpHubMemberLessonGates();
  </script>

  <script>
    import { wireContactFormSubmit } from "../../scripts/contactFormSubmit";

    const form = document.getElementById("help-hub-question-form");
    if (form instanceof HTMLFormElement) {
      wireContactFormSubmit({
        form,
        submitBtn: document.getElementById("help-hub-submit-btn") as HTMLButtonElement | null,
        submitErrorEl: document.getElementById("help-hub-submit-error"),
        pageUrlInput: document.getElementById("helpHubFormPageUrl") as HTMLInputElement | null,
        submittedAtInput: document.getElementById("helpHubFormSubmittedAt") as HTMLInputElement | null,
      });
    }
  </script>

  <style>
    html {
  scroll-behavior: smooth;
}

    .knit-fix-hub.container {
      padding-top: 1.25rem;
    }

    .knit-fix-hub-inner {
      max-width: 960px;
      min-width: 0;
      margin: 0 auto;
      padding-bottom: 3rem;
    }

    .help-hub-welcome {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-top: 0;
      min-width: 0;
    }

    .fix-hub-banner-logo {
      flex: 0 0 auto;
    }

    .fix-hub-logo,
    .help-hub-hero-icon {
      width: 129px;
      max-width: 100%;
      height: auto;
      display: block;
    }

    .help-hub-intro {
      margin: 0;
      min-width: 0;
      font-size: 1.05rem;
      font-weight: 500;
      color: #243015;
      line-height: 1.45;
    }

    @media (max-width: 768px) {
      .help-hub-welcome {
        gap: 0.7rem;
        align-items: center;
      }

      .help-hub-hero-icon {
        width: 101px;
      }

      .help-hub-intro {
        font-size: 1rem;
      }
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .fix-hub-divider {
      height: 1px;
      background: rgba(82, 104, 45, 0.2);
      margin: 2rem 0 2.5rem;
    }

    .fix-hub-divider--after-cards {
      margin: 2.25rem 0 0;
    }

    .help-hub-discovery {
      min-width: 0;
      max-width: 100%;
      margin-top: 0.85rem;
      padding: 1.15rem 1rem 1rem;
      border: 1px solid rgba(36, 48, 21, 0.14);
      border-radius: 12px;
      background: #fff;
      box-shadow: none;
      overflow-x: clip;
      box-sizing: border-box;
    }

    .help-hub-discovery__conversation {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      min-width: 0;
      max-width: 100%;
      padding-inline: 1rem;
      box-sizing: border-box;
    }

    .help-hub-discovery__question-row,
    .help-hub-discovery__answer-row {
      display: flex;
      min-width: 0;
      max-width: 100%;
    }

    .help-hub-discovery__question-row {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 0.35rem;
    }

    .help-hub-discovery__eyebrow {
      margin: 0;
      color: #52682d;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      line-height: 1.3;
    }

    .help-hub-discovery__question-line {
      display: flex;
      align-items: flex-start;
      gap: 0.15rem 0.2rem;
      max-width: 100%;
      min-width: 0;
    }

    .help-hub-discovery__question-line .talk-bubble.help-hub-discovery__question {
      flex: 0 1 auto;
      max-width: calc(100% - 3.25rem);
    }

    :global(.help-hub-discovery__question-line .favorite-star) {
      margin-top: 0.2rem;
    }

    .help-hub-discovery__answer-row {
      justify-content: flex-end;
      padding-left: 1.75rem;
    }

    .help-hub-discovery__answer-block {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: max-content;
      max-width: min(40rem, calc(100% - 1.25rem));
      min-width: 0;
    }

    .help-hub-discovery__answer-block .talk-bubble.help-hub-discovery__answer {
      max-width: 100%;
    }

    .help-hub-discovery .talk-bubble {
      display: block;
      width: auto;
      min-width: 0;
      max-width: min(40rem, calc(100% - 1.25rem));
      margin: 0;
      box-sizing: border-box;
      cursor: default;
      overflow-wrap: anywhere;
      color: #243015;
      font-size: 1.05rem;
      line-height: 1.55;
    }

    .help-hub-discovery .talk-bubble:hover {
      transform: none;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    .help-hub-discovery .talk-bubble.help-hub-discovery__question {
      background: #f0f4e8;
      border-color: #52682d;
      color: #243015;
      font-weight: 700;
    }

    .help-hub-discovery .talk-bubble.help-hub-discovery__question::after,
    .help-hub-discovery .talk-bubble.help-hub-discovery__question::before,
    .help-hub-discovery .talk-bubble.help-hub-discovery__answer::after,
    .help-hub-discovery .talk-bubble.help-hub-discovery__answer::before {
      bottom: auto;
      border: 0;
    }

    .help-hub-discovery .talk-bubble.help-hub-discovery__question::after {
      left: -16px;
      top: 22px;
      border-top: 8px solid transparent;
      border-bottom: 8px solid transparent;
      border-right: 16px solid #52682d;
    }

    .help-hub-discovery .talk-bubble.help-hub-discovery__question::before {
      left: -12px;
      top: 24px;
      border-top: 6px solid transparent;
      border-bottom: 6px solid transparent;
      border-right: 14px solid #f0f4e8;
      z-index: 1;
    }

    .help-hub-discovery .talk-bubble.help-hub-discovery__answer {
      background: color-mix(in srgb, var(--kbm-accent, #c2614e) 10%, #ffffff);
      border-color: color-mix(in srgb, var(--kbm-accent, #c2614e) 42%, #ffffff);
      color: #243015;
    }

    .help-hub-discovery .talk-bubble.help-hub-discovery__answer p {
      margin: 0;
      color: #243015;
    }

    .help-hub-discovery .talk-bubble.help-hub-discovery__answer::after {
      right: -16px;
      top: 22px;
      border-top: 8px solid transparent;
      border-bottom: 8px solid transparent;
      border-left: 16px solid color-mix(in srgb, var(--kbm-accent, #c2614e) 42%, #ffffff);
    }

    .help-hub-discovery .talk-bubble.help-hub-discovery__answer::before {
      right: -12px;
      top: 24px;
      border-top: 6px solid transparent;
      border-bottom: 6px solid transparent;
      border-left: 14px solid color-mix(in srgb, var(--kbm-accent, #c2614e) 10%, #ffffff);
      z-index: 1;
    }

    .help-hub-discovery__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem 1rem;
      width: 100%;
      margin-top: 0.65rem;
      min-width: 0;
    }

    .help-hub-discovery__explore {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0.25rem 0.1rem;
      border: 0;
      background: transparent;
      color: var(--kbm-green, #52682d);
      font: inherit;
      font-weight: 700;
      line-height: 1.3;
      text-decoration: none;
    }

    .help-hub-discovery__explore:hover {
      text-decoration: underline;
    }

    .help-hub-discovery__explore:focus-visible {
      outline: 2px solid var(--kbm-green, #52682d);
      outline-offset: 2px;
      border-radius: 4px;
    }

    .help-hub-discovery__surprise {
      position: relative;
