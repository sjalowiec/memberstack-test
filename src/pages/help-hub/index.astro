---
import Layout from "../../layouts/Layout.astro";
import TurnstileWidget from "../../components/TurnstileWidget.astro";
import "../../components/talk-bubbles.css";
import HelpHubTipContent from "../../components/help-hub/HelpHubTipContent.astro";
import { loadPublicHelpHubTips } from "../../lib/helpHub/loadTips";
import { loadPublicHelpHubCategories } from "../../lib/helpHub/loadCategories";
import { loadPublicLessons } from "../../lib/lessons/loadLessons";
import {
  helpHubIndexCategorySections,
  helpHubIndexNewCards,
} from "../../lib/helpHub/publicIndex";
import { helpHubTipIsPublic, helpHubTipSearchText, type HelpHubTipRecord } from "../../lib/helpHubPublic";

export const prerender = false;

const [helpHubData, helpHubCategories, lessons] = await Promise.all([
  loadPublicHelpHubTips(),
  loadPublicHelpHubCategories(),
  loadPublicLessons(),
]);

const tipBySlug = new Map<string, HelpHubTipRecord>();
for (const tip of Array.isArray(helpHubData) ? helpHubData : []) {
  const slug = typeof tip.slug === "string" ? tip.slug.trim() : "";
  if (slug && !tipBySlug.has(slug)) tipBySlug.set(slug, tip);
}

/** Live entries for the top “New in the Help Hub” section (isNew === true). */
const newHelpHubItems = helpHubIndexNewCards(helpHubData);
const categorySections = helpHubIndexCategorySections(helpHubData, helpHubCategories);

const debugHelpHubTip = (Array.isArray(helpHubData) ? helpHubData : []).find(
  (item) => typeof item.slug === "string" && item.slug.trim() === "change-colors-lk150",
);
if (debugHelpHubTip) {
  console.log("[KBM catalog debug] help-hub/index loader", {
    source: "loadPublicHelpHubTips",
    slug: debugHelpHubTip.slug,
    status: debugHelpHubTip.status,
    isNew: debugHelpHubTip.isNew,
    helpHubTipIsPublic: helpHubTipIsPublic(debugHelpHubTip),
    inNewHelpHubItems: newHelpHubItems.some(
      (item) => typeof item.slug === "string" && item.slug.trim() === "change-colors-lk150",
    ),
  });
}
---

<Layout
  title="Knit Fix Hub | Knit it Now"
  description="Clear, focused fixes and guided paths for common machine knitting problems — get back to knitting with confidence."
>
  <section
    class="container py-5 knit-fix-hub"
    aria-labelledby="knit-fix-hub-heading"
    data-help-hub-index
  >
    <div class="knit-fix-hub-inner">
      <h2 class="visually-hidden">Browse fixes</h2>

      <div class="help-hub-welcome">
        <div class="fix-hub-banner-logo">
          <img
            id="knit-fix-hub-heading"
            src="/images/help-hub.svg"
            alt="Let's Fix This"
            class="fix-hub-logo help-hub-hero-icon"
          />
        </div>
        <div class="help-hub-welcome-bubble">
          <p class="fix-hub-tagline">Welcome to the Help Hub.</p>
          <p class="help-hub-intro">
            The Help Hub is where you’ll find focused help for common machine knitting
            problems, questions, and next steps. Browse the fixes below to find the one
            that matches what you need.
          </p>
        </div>
      </div>

      <div data-help-hub-browse>
      <div class="help-hub-search">
        <label for="help-hub-search-input">Search the Help Hub</label>
        <input
          id="help-hub-search-input"
          type="search"
          placeholder="Search for a problem, technique, or machine..."
          autocomplete="off"
          enterkeyhint="search"
        />
      </div>

      <div class="help-hub-search-feedback" aria-live="polite">
        <p class="help-hub-search-status" data-help-hub-search-status></p>
        <div class="help-hub-search-empty" data-help-hub-search-empty hidden>
          <h2>No Help Hub answer yet.</h2>
          <ol>
            <li>
              <button type="button" class="help-hub-text-button" data-help-hub-open-site-search>
                Try a site-wide search
              </button>
            </li>
            <li>
              <a href="#help-request">Send me your question</a> using the form below.
            </li>
          </ol>
        </div>
      </div>

      <div class="fix-hub-divider fix-hub-divider--after-cards"></div>

      {newHelpHubItems.length > 0 && (
        <section
          class="fix-category-section fix-category-section--new"
          aria-labelledby="help-hub-new-heading"
          data-help-hub-new
        >
          <h2 id="help-hub-new-heading" class="fix-category-heading">
            New in the Help Hub
          </h2>
          <div class="fix-bubble-grid">
            {newHelpHubItems.map((item) => {
              const tip = tipBySlug.get(item.slug);
              if (!tip) return null;
              const instanceId = `new-${item.slug}`;
              return (
                <details
                  class="fix-bubble-item"
                  data-help-hub-entry
                  data-help-hub-answer
                  data-help-hub-slug={item.slug}
                  data-help-hub-search={helpHubTipSearchText(tip, helpHubCategories)}
                >
                  <summary class="talk-bubble bubble-bl bubble-question">
                    <strong>{item.heading}</strong>
                  </summary>
                  <div class="help-hub-inline-answer" data-pagefind-ignore>
                    <HelpHubTipContent
                      tip={tip}
                      lessons={lessons}
                      embedded
                      deferMedia
                      idPrefix={instanceId}
                    />
                  </div>
                </details>
              );
            })}
          </div>
        </section>
      )}

      <div class="fix-category-list">
        {categorySections.map((group) => (
          <details class="fix-category-section" data-help-hub-category={group.key}>
            <summary class="fix-category-summary">
              <h2 class="fix-category-heading">{group.label}</h2>
              <span class="fix-category-toggle__chevron" aria-hidden="true"></span>
            </summary>
            <div class="fix-bubble-grid">
              {group.cards.map((card) => {
                const tip = tipBySlug.get(card.slug);
                if (!tip) return null;
                const instanceId = `cat-${group.key}-${card.slug}`;
                return (
                  <details
                    class="fix-bubble-item"
                    data-help-hub-entry
                    data-help-hub-answer
                    data-help-hub-slug={card.slug}
                    data-help-hub-search={helpHubTipSearchText(tip, helpHubCategories)}
                  >
                    <summary class="talk-bubble bubble-bl bubble-question">
                      <strong>{card.heading}</strong>
                    </summary>
                    <div class="help-hub-inline-answer" data-pagefind-ignore>
                      <HelpHubTipContent
                        tip={tip}
                        lessons={lessons}
                        embedded
                        deferMedia
                        idPrefix={instanceId}
                      />
                    </div>
                  </details>
                );
              })}
            </div>
          </details>
        ))}
      </div>
      </div>

      <div
        class="help-hub-article-panel"
        data-help-hub-article-panel
        role="region"
        aria-labelledby="help-hub-article-title"
        hidden
      >
        <p class="help-hub-article-panel__nav">
          <button type="button" class="help-hub-article-back" data-help-hub-article-back>
            Back to Help Hub questions
          </button>
        </p>
        <h2 id="help-hub-article-title" class="help-hub-article-panel__title" data-help-hub-article-title tabindex="-1"></h2>
        <div data-help-hub-article-slot></div>
        <p class="help-hub-article-panel__nav help-hub-article-panel__nav--end">
          <button type="button" class="help-hub-article-back" data-help-hub-article-back>
            Back to Help Hub questions
          </button>
        </p>
      </div>

      <section id="help-request" class="help-hub-footer">
        <div class="help-hub-request-card">
        <h2>Not finding your answer?</h2>

        <p>
          Send me a quick note about what’s going wrong. I’ll help point you in the right direction — and I can improve the Help Hub for other knitters.
        </p>

        <form
          id="help-hub-question-form"
          name="help-hub-question"
          method="POST"
          action="/.netlify/functions/contact"
          enctype="multipart/form-data"
          netlify-honeypot="bot-field"
          class="help-hub-form"
        >
          <input type="hidden" name="form-name" value="help-hub-question" />
          <p class="help-hub-form__honeypot" aria-hidden="true">
            <label>Don’t fill this out: <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <input type="hidden" name="page_url" id="helpHubFormPageUrl" />
          <input type="hidden" name="submitted_at" id="helpHubFormSubmittedAt" />
          <input type="hidden" name="form_source" value="help-hub" />

          <div class="floating-input">
            <input type="text" id="firstName" name="firstName" placeholder=" " required />
            <label for="firstName" class="floating-label">First name</label>
          </div>

          <div class="floating-input">
            <input type="email" id="email" name="email" placeholder=" " required />
            <label for="email" class="floating-label">Email</label>
          </div>

          <div class="floating-input floating-input--textarea">
            <textarea id="question" name="question" rows="4" placeholder=" " required></textarea>
            <label for="question" class="floating-label">What do you need help with?</label>
          </div>

          <TurnstileWidget id="turnstile-help-hub" />

          <p id="help-hub-submit-error" class="help-hub-form__error" hidden role="alert"></p>

          <button type="submit" class="kbm-btn kbm-btn-primary help-hub-form__submit" id="help-hub-submit-btn">
            Send My Question
          </button>
        </form>
        </div>
      </section>

    </div>
  </section>

  <script>
    import { installSearchCommitLogger } from "../../lib/searchActivityClient";
    import { bootHelpHubMemberLessonGates } from "../../scripts/helpHubMemberLessonGateClient";
    import { initHelpHubIndex } from "../../scripts/helpHubIndexClient";

    installSearchCommitLogger();
    const helpHubIndex = document.querySelector("[data-help-hub-index]");
    if (helpHubIndex) initHelpHubIndex(helpHubIndex);
    bootHelpHubMemberLessonGates();
  </script>

  <script>
    import { wireContactFormSubmit } from "../../scripts/contactFormSubmit";

    const form = document.getElementById("help-hub-question-form");
    if (form instanceof HTMLFormElement) {
      wireContactFormSubmit({
        form,
        submitBtn: document.getElementById("help-hub-submit-btn") as HTMLButtonElement | null,
        submitErrorEl: document.getElementById("help-hub-submit-error"),
        pageUrlInput: document.getElementById("helpHubFormPageUrl") as HTMLInputElement | null,
        submittedAtInput: document.getElementById("helpHubFormSubmittedAt") as HTMLInputElement | null,
      });
    }
  </script>

  <style>
    html {
  scroll-behavior: smooth;
}

    .knit-fix-hub-inner {
      max-width: 960px;
      min-width: 0;
      margin: 0 auto;
      padding-bottom: 3rem;
    }

    .help-hub-welcome {
      display: flex;
      align-items: center;
      gap: 1.15rem;
      margin-top: 0.75rem;
    }

    .fix-hub-banner-logo {
      flex: 0 0 auto;
    }

    .fix-hub-logo {
      width: 100px;
      max-width: 100%;
      height: auto;
      display: block;
    }

    .help-hub-hero-icon {
      width: 92px;
      max-width: 92px;
      height: auto;
    }

    .help-hub-welcome-bubble {
      position: relative;
      flex: 1 1 auto;
      min-width: 0;
      margin: 0;
      padding: 1.15rem 1.35rem 1.2rem;
      border: 2px solid #52682d;
      border-radius: 22px;
      background: #f0f4e8;
      color: #2e3a18;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    .help-hub-welcome-bubble::after,
    .help-hub-welcome-bubble::before {
      content: "";
      position: absolute;
      width: 0;
      height: 0;
    }

    .help-hub-welcome-bubble::after {
      left: -18px;
      top: 28px;
      border-top: 10px solid transparent;
      border-bottom: 8px solid transparent;
      border-right: 18px solid #52682d;
    }

    .help-hub-welcome-bubble::before {
      left: -13px;
      top: 30px;
      border-top: 8px solid transparent;
      border-bottom: 6px solid transparent;
      border-right: 15px solid #f0f4e8;
      z-index: 1;
    }

    .fix-hub-tagline {
      font-size: 1.35rem;
      line-height: 1.25;
      font-weight: 700;
      color: var(--kbm-green);
      margin: 0 0 0.45rem 0;
    }

    .help-hub-welcome-bubble .help-hub-intro {
      margin: 0;
      font-size: 1.05rem;
      color: #243015;
      line-height: 1.6;
    }

    @media (max-width: 768px) {
      .help-hub-welcome {
        gap: 0.85rem;
        align-items: flex-start;
      }

      .help-hub-hero-icon {
        width: 72px;
        max-width: 72px;
      }

      .help-hub-welcome-bubble {
        padding: 1rem 1.05rem 1.05rem;
      }

      .help-hub-welcome-bubble::after {
        top: 18px;
      }

      .help-hub-welcome-bubble::before {
        top: 20px;
      }

      .fix-hub-tagline {
        font-size: 1.15rem;
      }

      .help-hub-welcome-bubble .help-hub-intro {
        font-size: 1rem;
      }
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .fix-hub-divider {
      height: 1px;
      background: rgba(82, 104, 45, 0.2);
      margin: 2rem 0 2.5rem;
    }

    .fix-hub-divider--after-cards {
      margin: 2.25rem 0 0;
    }

    .help-hub-search {
      margin-top: 1.5rem;
    }

    .help-hub-search label {
      display: block;
      margin: 0 0 0.45rem;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--kbm-green);
    }

    .help-hub-search input {
      display: block;
      width: 100%;
      box-sizing: border-box;
      margin: 0;
      padding: 0.8rem 0.95rem;
      border: 2px solid rgba(82, 104, 45, 0.45);
      border-radius: 12px;
      background: #fff;
      color: #243015;
      font: inherit;
      font-size: 1rem;
      line-height: 1.4;
    }

    .help-hub-search input:focus-visible {
      outline: 2px solid var(--kbm-green, #52682d);
      outline-offset: 2px;
    }

    .help-hub-search-feedback {
      margin-top: 0.85rem;
    }

    .help-hub-search-status {
      margin: 0;
      min-height: 0;
      color: #3f4b35;
      font-size: 0.95rem;
    }

    .help-hub-search-status:empty {
      display: none;
    }

    .help-hub-search-empty {
      margin-top: 0.35rem;
      padding: 1rem 1.1rem;
      border: 1px solid rgba(82, 104, 45, 0.22);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.72);
    }

    .help-hub-search-empty[hidden] {
      display: none;
    }

    .help-hub-search-empty h2 {
      margin: 0 0 0.65rem;
      font-size: 1.15rem;
      color: var(--kbm-green);
    }

    .help-hub-search-empty ol {
      margin: 0;
      padding-left: 1.25rem;
      color: #243015;
      line-height: 1.55;
    }

    .help-hub-search-empty li + li {
      margin-top: 0.35rem;
    }

    .help-hub-search-empty a,
    .help-hub-text-button {
      color: var(--kbm-green, #52682d);
      font-weight: 700;
    }

    .help-hub-text-button {
      display: inline;
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      text-decoration: underline;
      cursor: pointer;
    }

    .help-hub-text-button:focus-visible,
    .help-hub-search-empty a:focus-visible {
      outline: 2px solid var(--kbm-green, #52682d);
      outline-offset: 3px;
    }

    .fix-category-section {
      margin-bottom: 1.25rem;
    }

    .fix-category-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      width: 100%;
      box-sizing: border-box;
      margin: 0 0 0.45rem;
      padding: 0.8rem 1rem;
      border: 1px solid rgba(82, 104, 45, 0.28);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.78);
      cursor: pointer;
      list-style: none;
    }

    .fix-category-summary::-webkit-details-marker {
      display: none;
    }

    .fix-category-summary:hover {
      border-color: rgba(82, 104, 45, 0.5);
      background: #f7faf4;
    }

    .fix-category-section[open] > .fix-category-summary {
      border-color: rgba(82, 104, 45, 0.45);
      background: #f3f7ec;
    }

    .fix-category-summary:focus-visible {
      outline: 2px solid var(--kbm-green, #52682d);
      outline-offset: 3px;
    }

    .fix-category-heading {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--kbm-green);
      margin: 0;
    }

    .fix-category-toggle__chevron {
      flex: 0 0 auto;
      width: 0.55rem;
      height: 0.55rem;
      margin-top: -0.15rem;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      color: var(--kbm-green);
      transform: rotate(45deg);
    }

    .fix-category-section[open] > .fix-category-summary .fix-category-toggle__chevron {
      transform: rotate(-135deg);
      margin-top: 0.2rem;
    }

    .fix-category-section[open] > .fix-bubble-grid {
      margin-top: 0.85rem;
    }

    .fix-bubble-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* row gap, column gap — more room between bubbles without changing layout */
      gap: 3rem 3.5rem;
      align-items: start;
    }

    .fix-bubble-item {
      min-width: 0;
      max-width: 100%;
    }

    .fix-bubble-item[open] {
      grid-column: 1 / -1;
    }

    .fix-bubble-grid .talk-bubble {
      display: block;
      width: 100%;
      max-width: 100%;
      margin: 0 !important;
      cursor: pointer;
      list-style: none;
      text-align: left;
      font: inherit;
      box-sizing: border-box;
    }

    .fix-bubble-grid .talk-bubble::-webkit-details-marker {
      display: none;
    }

    .fix-bubble-item[open] > .talk-bubble {
      max-width: calc((100% - 3.5rem) / 2);
    }

    .fix-bubble-grid .talk-bubble + .talk-bubble {
      margin-top: 0 !important;
    }

    @media (max-width: 768px) {
      .fix-bubble-grid {
        grid-template-columns: 1fr;
        gap: 1.75rem;
      }

      .fix-bubble-item[open] > .talk-bubble {
        max-width: 100%;
      }
    }

    .knit-fix-hub .fix-bubble-grid summary.talk-bubble {
      text-decoration: none;
      color: inherit;
    }

    .knit-fix-hub .fix-bubble-grid summary.talk-bubble:focus-visible,
    .fix-category-summary:focus-visible {
      outline: 2px solid var(--kbm-green, #52682d);
      outline-offset: 3px;
    }

    .knit-fix-hub.is-reading [data-help-hub-browse] {
      display: none;
    }

    .help-hub-article-panel {
      scroll-margin-top: calc(var(--header-height, 7rem) + 0.75rem);
      margin-top: 1.25rem;
      padding: 1.15rem 1.25rem 1.35rem;
      border: 1px solid rgba(82, 104, 45, 0.38);
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 10px 28px rgba(36, 48, 21, 0.08);
    }

    .help-hub-article-panel[hidden] {
      display: none !important;
    }

    .help-hub-article-panel__nav {
      margin: 0;
    }

    .help-hub-article-panel__nav--end {
      margin-top: 1.5rem;
    }

    .help-hub-article-back {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding: 0.55rem 1.05rem;
      border: 1px solid rgba(82, 104, 45, 0.55);
      border-radius: 999px;
      background: #f3f6ee;
      color: var(--kbm-green, #52682d);
      font: inherit;
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.2;
      cursor: pointer;
    }

    .help-hub-article-back:hover,
    .help-hub-article-back:focus-visible {
      background: #e7efe0;
      outline: 2px solid var(--kbm-green, #52682d);
      outline-offset: 2px;
    }

    .help-hub-article-panel__title {
      margin: 0.9rem 0 1rem;
      color: #243015;
      font-size: 1.7rem;
      line-height: 1.25;
    }

    .help-hub-article-panel__title:focus {
      outline: 2px solid var(--kbm-green, #52682d);
      outline-offset: 4px;
    }

    @media (max-width: 768px) {
      .help-hub-article-panel {
        padding: 0.9rem 0.85rem 1rem;
      }

      .help-hub-article-panel__title {
        font-size: 1.35rem;
      }

      .help-hub-article-back {
        width: 100%;
        justify-content: center;
      }
    }

    .help-hub-article-panel .fix-bubble-item > summary {
      display: none;
    }

    .help-hub-article-panel .help-hub-inline-answer {
      margin-top: 0;
    }

    .help-hub-inline-answer {
      min-width: 0;
      max-width: 100%;
      margin-top: 0.85rem;
    }

    .help-hub-inline-answer[hidden] {
      display: none;
    }

    .fix-category-section--new {
      margin-bottom: 3rem;
    }

    .fix-category-section--new > .fix-category-heading {
      margin-bottom: 1rem;
    }

    .help-hub-footer {
      margin-top: 3.5rem;
      padding-top: 0;
      border-top: none;
      max-width: none;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .help-hub-request-card {
      box-sizing: border-box;
      width: 100%;
      max-width: 36rem;
      margin-top: 0;
      padding: 1.75rem 1.5rem 2rem;
      border: 1px solid rgba(82, 104, 45, 0.22);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.72);
      box-shadow: 0 1px 4px rgba(36, 48, 21, 0.06);
    }

    .help-hub-request-card h2 {
      margin-top: 0;
      text-align: center;
    }

    .help-hub-request-card > p {
      text-align: center;
      margin-bottom: 1.25rem;
      color: #374151;
      line-height: 1.55;
    }

    .help-hub-form__honeypot {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .help-hub-form {
      margin-top: 0.25rem;
    }

    .help-hub-form__submit {
      margin-top: 0.5rem;
      display: block;
      margin-left: auto;
      margin-right: auto;
    }

    .help-hub-form__error {
      margin: 0.75rem 0 0;
      font-size: 0.9rem;
      color: #b91c1c;
      text-align: center;
    }

    .help-hub-form__error[hidden] {
