---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PatternsFeaturesSection from "../components/patterns/PatternsFeaturesSection.astro";
import PatternHeaderImage from "../components/patterns/PatternHeaderImage.astro";
import "../styles/global.css";
---   

<Layout bodyClass="page--tight-header page--home">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- CRITICAL: Inline typography to prevent Astro CSS bundler reordering issues -->
    <style data-kbm-typography>
      html {
        font-size: 112.5% !important; /* 18px - comfortable mobile reading */
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }
      @media (min-width: 1025px) {
        html {
          font-size: 100% !important; /* 16px for desktop */
        }
      }
    </style>
    
    <title>Knit it Now | Custom Machine Knitting Patterns</title>
    <meta
      name="description"
      content="Build, customize, and knit sweater patterns for your machine, your gauge, and your measurements with Knit It Now's guided pattern system."
    />
  </head>

    <main class="kbm-start-here">
      <!-- HERO SECTION -->
      <section class="kbm-hero kbm-hero--patterns">
        <div class="kbm-hero__content">
          <h1>The Next Generation of Knit It Now Patterns</h1>
          <p class="kbm-hero__framing">
            These next-generation patterns are just one part of the new Knit It Now experience we’re building for machine knitters.
          </p>
          <p class="kbm-hero__ecosystem" aria-label="Areas of the Knit It Now experience">
            Patterns • Interactive Tools • Planning • Tutorials • Community
          </p>
          <p class="kbm-hero__text">
            Choose your style and enter your measurements.<br />
            Generate a ready-to-knit custom pattern in just a few guided steps.
          </p>
          <ul class="kbm-hero__benefits">
            <li>Built around your gauge, machine, and fit</li>
            <li>Easier-to-follow shaping with visual guidance</li>
            <li>Customize styles without rewriting pattern instructions</li>
            <li>Track your progress as you knit</li>
            <li>Cleaner, more modern patterns designed for machine knitters</li>
            <li>Print-friendly layouts that work beside your machine</li>
          </ul>
          <div class="kbm-hero__cta-group">
            <p class="kbm-hero__cta-helper">
              Beta Preview: We’re testing our new builder with the Sleeveless Pattern first. Give it a try.
            </p>
            <div class="kbm-hero__actions">
              <a href="/patterns/sleeveless-express/" class="kbm-btn kbm-btn-accent" data-testid="home-cta-sleeveless">
                Try the Sleeveless Pattern
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="kbm-home-split kbm-home-split--build-steps kbm-home-split--stack-media-first kbm-home-split--text-45" aria-labelledby="home-build-steps-heading">
        <div class="kbm-home-split__grid">
          <div class="kbm-home-split__content">
            <h2 id="home-build-steps-heading">Create your custom pattern in guided steps.</h2>
            <ol class="kbm-home-split__steps">
              <li>Choose who you’re knitting for</li>
              <li>Select your garment style</li>
              <li>Pick your neckline and fit</li>
              <li>Enter your gauge and measurements</li>
              <li>Generate your custom pattern</li>
            </ol>
          </div>
          <div class="kbm-home-split__media">
            <PatternHeaderImage
              class="kbm-home-split__enlarge"
              src="/images/patterns/build-steps.jpg"
              alt="Guided sweater pattern builder showing style, neckline, fit, and gauge steps"
              hintText="Click to enlarge"
              hintStyle="overlay"
              modalFit="readable"
              loading="lazy"
            />
          </div>
        </div>
      </section>

      <section class="kbm-home-split kbm-home-split--media-first" aria-labelledby="home-custom-sizing-heading">
        <div class="kbm-home-split__grid">
          <div class="kbm-home-split__media">
            <PatternHeaderImage
              class="kbm-home-split__enlarge"
              src="/images/patterns/custom-sizing.jpg"
              alt="Custom sizing controls for adjusting sweater measurements before knitting"
              hintText="Click to enlarge"
              hintStyle="overlay"
              modalFit="readable"
              loading="lazy"
            />
          </div>
          <div class="kbm-home-split__content">
            <h2 id="home-custom-sizing-heading">Customize the fit before you cast on.</h2>
            <p class="kbm-home-split__intro">
              Our interactive summary page takes the guesswork out of sizing your project. Use the blueprint diagram to enter your exact target measurements before your pattern is generated:
            </p>
            <ul class="kbm-home-split__callouts">
              <li><strong>Visual measurement layout:</strong> Clearly see where each measurement applies on the garment.</li>
              <li><strong>Complete sizing control:</strong> Adjust key lengths, widths, and depths to match your body and style preferences.</li>
              <li><strong>Built for your project:</strong> Generate a custom pattern based on your measurements, gauge, and fit choices, not a generic sample size.</li>
            </ul>
          </div>
        </div>
      </section>

      <PatternsFeaturesSection
        sectionId="home-pattern-features"
        headingId="home-patterns-features-heading"
        subtitle="Designed to make machine knitting easier to follow, customize, and track."
      />

      <!-- SOFT LAUNCH: Hidden temporarily. Bring back after initial onboarding phase -->
      <!-- WHERE ARE YOU RIGHT NOW? SECTION -->
      <section id="where-are-you" class="kbm-where-section kbm-hidden-softlaunch" hidden aria-hidden="true">
        <div class="kbm-where-inner">
          <div class="kbm-section-header">
            <h2>Where are you right now?</h2>
            <p class="kbm-section-subtitle">Tell me where you are right now, and I’ll point you to the right next step.</p>
            <p class="kbm-section-subtitle kbm-section-subtitle--secondary">There's no wrong choice — each path starts where you are.</p>
          </div>

          <div class="kbm-hex-grid">
          <!-- Card 1: I'm just starting — same wrapper pattern as shop/downloads (article + download-card-link) -->
          <article class="download-card kbm-card kbm-card--download kbm-hex-card">
            <a href="/start-here" class="download-card-link kbm-hex-card--link" data-testid="card-start-phase">
              <span class="kbm-card-ribbon">LIVE</span>
              <div class="kbm-hex-icon">
                <img src="/images/KINlogo.svg" alt="" />
              </div>
              <h3>I'm just getting started</h3>
              <p>Learn the basics so you can knit your first confident rows.</p>
              <span class="btn primary kbm-cta-guide" data-testid="button-getting-started">Start with the basics</span>
            </a>
          </article>

          <!-- Card 2: I've knitted a little -->
          <article class="download-card kbm-card kbm-card--download kbm-hex-card">
            <a href="/start-here" class="download-card-link kbm-hex-card--link" data-testid="card-skills-phase">
              <span class="kbm-card-ribbon" aria-label="In Progress">
                <i class="fa-solid fa-screwdriver-wrench" style="color: rgb(255, 255, 255);" aria-hidden="true"></i>
              </span>
              <div class="kbm-hex-icon">
                <img src="/images/KINlogo.svg" alt="" />
              </div>
              <h3>I've knitted a little</h3>
              <p>Build your skills with small, low-pressure projects.</p>
              <span class="btn primary kbm-cta-guide" data-testid="button-skill-builders">Practice Key Skills</span>
            </a>
          </article>

          <!-- Card 3: I'm ready to make something -->
          <article class="download-card kbm-card kbm-card--download kbm-hex-card">
            <a href="/start-here" class="download-card-link kbm-hex-card--link" data-testid="card-projects-phase">
              <span class="kbm-card-ribbon" aria-label="In Progress">
                <i class="fa-solid fa-screwdriver-wrench" style="color: rgb(255, 255, 255);" aria-hidden="true"></i>
              </span>
              <div class="kbm-hex-icon">
                <img src="/images/KINlogo.svg" alt="" />
              </div>
              <h3>I'm ready to make something</h3>
              <p>Start with patterns that give you a solid place to begin.</p>
              <span class="btn primary kbm-cta-guide" data-testid="button-rsk">Start a project</span>
            </a>
          </article>

          <!-- Card 4: Help Hub (support destination) -->
          <article class="download-card kbm-card kbm-card--download kbm-hex-card kbm-hex-card--help">
            <a href="/start-here" class="download-card-link kbm-hex-card--link" data-testid="card-need-help">
              <span class="kbm-card-ribbon" aria-label="In Progress">
                <i class="fa-solid fa-screwdriver-wrench" style="color: rgb(255, 255, 255);" aria-hidden="true"></i>
              </span>
              <div class="kbm-hex-icon">
                <img src="/images/KINlogo.svg" alt="" />
              </div>
              <h3>Help Hub</h3>
              <p>Find troubleshooting tips, answers, and your next step.</p>
              <span class="btn primary kbm-cta-guide" data-testid="button-need-help">Get Help</span>
            </a>
          </article>
          </div>
        </div>
      </section>

      <section class="kbm-home-feedback">
        <h3>Help shape the future of Knit It Now patterns</h3>
        <p>
          This pattern system is still in progress. If something feels confusing or missing, we’d love to hear from you.
        </p>
        <div class="kbm-home-feedback__actions">
          <a href="/contact" class="kbm-btn kbm-btn-accent">Send Feedback</a>
          <a href="/patterns/sleeveless-express/" class="kbm-btn kbm-btn-outline" data-testid="home-cta-sleeveless-bottom">
            Try the Sleeveless Pattern
          </a>
        </div>
        <p><br />
          As we continue rebuilding Knit It Now, these interactive patterns are only the beginning.
        </p>
      </section>

    </main>

  
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }

  :root {
    --kbm-green: #52682d;
    --kbm-green-hover: #445626;
    --kbm-green-2: #738c52;
    --font: "Poppins", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  body {
    margin: 0;
    background: #f7f8f7;
    font-family: var(--font);
    color: #222;
  }

  /* ========== MAIN WRAPPER ========== */
  :global(body.page--home .site-content) {
    padding-top: calc(var(--header-offset, 150px) + 10px);
  }

  .kbm-start-here {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0.25rem 1.5rem 3rem;
  }

  /* ========== SHARED BUTTON STYLES ========== */
  .btn {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border-radius: 999px;
    font-size: 0.95rem;
    text-decoration: none;
    font-weight: 500;
    border: 1px solid transparent;
    transition: background-color 0.2s ease;
  }

  .btn.primary {
    background-color: var(--kbm-green);
    color: #fff;
  }

  .btn.primary:hover {
    background-color: var(--kbm-green-hover);
  }

  /* ========== SECTION HEADERS ========== */
  .kbm-section-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .kbm-section-header h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    color: #2c3a57;
    margin: 0 0 0.5rem;
  }

  .kbm-section-framing {
    margin: 0 auto;
    max-width: 40rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #4d5a48;
  }

  .kbm-section-subtitle {
    color: #4d5a48;
    font-size: 1rem;
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .kbm-section-subtitle--secondary {
    font-style: italic;
    margin-top: 0.35rem;
    font-size: 0.95rem;
    color: #6b7565;
  }

  /* :global so this still applies when homepage markup is passed through Layout’s <slot /> */
  :global(.kbm-hidden-softlaunch) {
    display: none !important;
  }

  /* ========== HERO SECTION ========== */
  .kbm-hero {
    margin-bottom: 2.25rem;
    padding-top: 0.25rem;
  }

  .kbm-hero--patterns {
    margin-bottom: 1.65rem;
    padding: 1.25rem 1.5rem 1.5rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, #f9f9f6 0%, #fff 55%);
    border: 1px solid #d6dbc9;
    box-shadow: 0 4px 16px rgba(82, 104, 45, 0.1);
  }

  .kbm-hero--patterns .kbm-hero__content {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto;
  }

  .kbm-hero--patterns .kbm-hero__cta-group,
  .kbm-hero--patterns .kbm-hero__actions {
    align-items: center;
    justify-content: center;
  }

  .kbm-hero__beta-note {
    margin: 0 auto 1.5rem;
    max-width: 36rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: #6b7565;
    font-style: italic;
  }

  @media (max-width: 640px) {
    .kbm-hero {
      padding-top: 0.15rem;
    }
  }

  .kbm-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  .kbm-hero__content {
    text-align: center;
  }

  .kbm-hero__eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--kbm-green-2);
    margin-bottom: 0.75rem;
    padding: 0.35rem 1rem;
    background: rgba(115, 140, 82, 0.12);
    border-radius: 999px;
  }

  .kbm-hero h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin: 0 0 0.65rem;
    color: #2c3a57;
    line-height: 1.3;
  }

  .kbm-hero__framing {
    margin: 0 auto 0.55rem;
    max-width: 36rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #5f6b58;
  }

  .kbm-hero__ecosystem {
    margin: 0 auto 0.75rem;
    max-width: 36rem;
    font-size: 0.8rem;
    line-height: 1.4;
    letter-spacing: 0.03em;
    color: #8a9484;
  }

  .kbm-hero .hero-tagline {
    margin: 0 0 1rem;
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    font-weight: 600;
    line-height: 1.45;
    color: var(--kbm-green-2);
  }

  .kbm-hero__text {
    max-width: 42rem;
    margin: 0 auto 0.85rem;
    font-size: 1rem;
    line-height: 1.55;
    color: #4d5a48;
  }

  .kbm-hero__benefits {
    list-style: disc;
    list-style-position: outside;
    margin: 0 auto 1.25rem;
    padding-left: 1.25rem;
    max-width: 36rem;
    text-align: left;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #4d5a48;
  }

  .kbm-hero__benefits li {
    margin-bottom: 0.35rem;
  }

  .kbm-hero__benefits li:last-child {
    margin-bottom: 0;
  }

  .kbm-hero__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  /* Hero CTAs: slightly larger tap targets; same global .kbm-btn system */
  .kbm-hero__actions .kbm-btn {
    padding: 0.55rem 1.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .kbm-hero__cta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  .kbm-hero__cta-helper {
    margin: 0;
    width: 100%;
    max-width: 100%;
    font-size: 0.85rem;
    line-height: 1.45;
    color: #6b7565;
    text-align: center;
  }

  .kbm-hero__support {
    margin: 0;
    padding-top: 0.1rem;
    text-align: center;
  }

  .kbm-hero__support-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: #6b7565;
    text-decoration: underline;
    text-decoration-color: rgba(107, 117, 101, 0.45);
    text-underline-offset: 0.2em;
  }

  .kbm-hero__support-link:hover {
    color: var(--kbm-green-2);
    text-decoration-color: rgba(115, 140, 82, 0.55);
  }

  .kbm-hero__support-link:focus-visible {
    outline: 2px solid var(--kbm-green-2);
    outline-offset: 0.15rem;
    border-radius: 2px;
  }

  .kbm-hero__helper {
    font-style: italic;
    font-size: 0.9rem;
    color: #4d5a48;
    margin: 0;
    text-align: center;
  }

  .kbm-hero__image {
    display: flex;
    justify-content: center;
  }

  .kbm-hero__image img {
    width: 100%;
    max-width: 420px;
    height: auto;
    border-radius: 1rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    background: #e0e5d8;
    min-height: 200px;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .kbm-hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .kbm-hero__content {
      text-align: left;
    }

    .kbm-hero__text {
      margin-left: 0;
      margin-right: 0;
    }

    .kbm-hero__actions {
      align-items: flex-start;
      justify-content: flex-start;
      flex-direction: row;
    }

    .kbm-hero__cta-group {
      align-items: flex-start;
      margin-left: 0;
      margin-right: auto;
    }

    .kbm-hero--patterns .kbm-hero__cta-group,
    .kbm-hero--patterns .kbm-hero__actions {
      align-items: center;
      justify-content: center;
      margin-left: auto;
      margin-right: auto;
    }

    .kbm-hero__support {
      text-align: left;
    }

    .kbm-hero__image img {
      max-width: 100%;
    }
  }

  /* ========== HOME PATTERN SPLIT ROWS ========== */
  .kbm-home-split {
    margin-bottom: 2.5rem;
    padding: 1.75rem;
    border-radius: 1rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    box-shadow: 0 2px 10px rgba(82, 104, 45, 0.08);
  }

  .kbm-home-split__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: center;
  }

  .kbm-home-split__content {
    align-self: center;
  }

  .kbm-home-split__media {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
  }

  .kbm-home-split__content h2 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.2rem, 2.4vw, 1.45rem);
    color: #2c3a57;
    line-height: 1.3;
  }

  .kbm-home-split__content p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #4d5a48;
  }

  .kbm-home-split__callouts {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .kbm-home-split__callouts li,
  .kbm-home-split__steps li {
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #4d5a48;
    border-radius: 0.75rem;
    background: rgba(82, 104, 45, 0.06);
    border: 1px solid rgba(82, 104, 45, 0.18);
    box-shadow: 0 1px 3px rgba(82, 104, 45, 0.06);
  }

  .kbm-home-split__callouts li {
    padding: 0.6rem 0.75rem;
  }

  .kbm-home-split__callouts li:last-child,
  .kbm-home-split__steps li:last-child {
    margin-bottom: 0;
  }

  .kbm-home-split__callouts strong {
    color: #2c3a57;
  }

  .kbm-home-split__callouts strong::after {
    content: "\00a0";
  }

  .kbm-home-split__steps {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: home-build-step;
  }

  .kbm-home-split__steps li {
    counter-increment: home-build-step;
    position: relative;
    padding: 0.6rem 0.75rem 0.6rem 2.5rem;
    line-height: 1.45;
  }

  .kbm-home-split__steps li::before {
    content: counter(home-build-step);
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--kbm-green);
    line-height: 1;
  }

  .kbm-home-split--build-steps .kbm-home-split__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .kbm-home-split--build-steps .kbm-home-split__grid {
      align-items: stretch;
    }
  }

  .kbm-home-split--build-steps .kbm-home-split__media :global(.pattern-header-image) {
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  .kbm-home-split--build-steps .kbm-home-split__media :global(.pattern-header-image__img) {
    max-height: min(62vh, 540px);
  }

  .kbm-home-split--stack-media-first .kbm-home-split__media {
    order: -1;
  }

  .kbm-home-split__media .kbm-home-split__enlarge {
    max-width: 100%;
  }

  .kbm-home-split__media .pattern-header-image__img {
    width: 100%;
    max-height: none;
    border-radius: 0.75rem;
    border: 1px solid rgba(82, 104, 45, 0.18);
    box-shadow:
      0 10px 28px rgba(0, 0, 0, 0.08),
      0 2px 8px rgba(82, 104, 45, 0.12);
  }

  @media (min-width: 768px) {
    .kbm-home-split__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .kbm-home-split--text-45 .kbm-home-split__grid {
      grid-template-columns: 9fr 11fr;
      gap: 2.5rem;
    }

    .kbm-home-split--build-steps.kbm-home-split--text-45 .kbm-home-split__grid {
      grid-template-columns: 7fr 13fr;
      gap: 2rem;
    }

    .kbm-home-split--stack-media-first .kbm-home-split__media,
    .kbm-home-split--stack-media-first .kbm-home-split__content {
      order: unset;
    }

    .kbm-home-split--media-first .kbm-home-split__media {
      order: 0;
    }

    .kbm-home-split--media-first .kbm-home-split__content {
      order: 1;
    }
  }

  /* ========== HOME FEEDBACK ========== */
  .kbm-home-feedback {
    margin-top: 2.5rem;
    padding: 2rem 1.5rem;
    text-align: center;
    border-radius: 1rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.06);
  }

  .kbm-home-feedback h3 {
    margin: 0 0 0.75rem;
