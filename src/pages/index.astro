---
import Layout from "../layouts/Layout.astro";
import HomeImagePlaceholder from "../components/home/HomeImagePlaceholder.astro";
import "../styles/global.css";

const pageTitle = "Knit it Now | Learn, Build Skills & Machine Knit with Confidence";
const pageDescription =
  "Knit It Now brings together lessons, videos, pattern builders, tools, and references to help machine knitters learn, practice, and knit with confidence.";

const suePhoto = "/images/home/home-sue.png";
const suePhotoAlt = "Sue Jalowiec at her knitting machine, founder of Knit it Now";

/** Section 2 — audience cards (pre-cropped sweater WebPs — no CSS crop) */
const helpTodayCards = [
  {
    title: "New to machine knitting",
    copy: "Learn step by step with guided lessons, beginner-friendly projects, and practical videos.",
    href: "/start-here",
    image: "/images/home/new-to-MK.webp",
    alt: "Knitted sweater for someone new to machine knitting",
  },
  {
    title: "Returning after a break",
    copy: "Refresh your skills, solve common problems, and rebuild your confidence.",
    href: "/courses",
    image: "/images/home/returning.webp",
    alt: "Knitted sweater for machine knitters returning after a break",
  },
  {
    title: "Creating patterns that fit",
    copy: "Use interactive Pattern Builders designed around your gauge, measurements, and machine.",
    href: "/patterns",
    image: "/images/home/patterns-that-fit.webp",
    alt: "Knitted sweater representing custom patterns that fit your measurements",
  },
  {
    title: "Stuck on a project",
    copy: "Find answers with troubleshooting guides, videos, references, and practical tools.",
    href: "/help-hub",
    image: "/images/home/stuck.webp",
    alt: "Knitted sweater for when you are stuck mid-project and need help",
  },
];

/** Section 3 — explore feature cards */
const exploreCards = [
  {
    title: "Interactive Pattern Builder",
    copy: "Build custom knitting instructions based on your own gauge, machine, and measurements.",
    image: "/images/home/home-pattern.webp",
    alt: "Pattern Builder screen showing custom knitting instructions based on your measurements",
    placeholder: "Pattern Builder screenshot",
    button: "Explore Pattern Builders",
    href: "/patterns",
  },
  {
    title: "Skill Builders",
    copy: "Practice one technique at a time with guided learning projects.",
    image: "/images/home/home-skill-builder.webp",
    alt: "Skill Builder lesson screen showing guided technique practice",
    placeholder: "Skill Builder screenshot",
    button: "Try a Skill Builder",
    // TODO: Link to Skill Builders catalog when /skill-builders exists
    href: "/tools/neckline-and-shoulder-shaping",
  },
  {
    title: "Learning Library",
    copy: "Browse videos, courses, and tutorials whenever you need them.",
    image: "/images/home/home-videos.webp",
    alt: "Video library screen showing browsable knitting tutorials and courses",
    placeholder: "Video library screenshot",
    button: "Browse videos",
    href: "/videos",
  },
  {
    title: "Tools & References",
    copy: "Use calculators, references, glossaries, machine information, and more while you knit.",
    image: "/images/home/home-tools.webp",
    alt: "Tools and references screen with calculators and lookup guides",
    placeholder: "Gauge Comparison tool screenshot",
    button: "See tools & references",
    href: "/tools",
  },
];

/** Section 4 — connected workflow (5 steps on desktop) */
const workflowSteps = [
  { label: "Learn", hint: "Courses & videos" },
  { label: "Practice", hint: "Skill Builders" },
  { label: "Build", hint: "Pattern Builders" },
  { label: "Knit", hint: "At your machine" },
  { label: "Get Help", hint: "Help Hub • Tools • Glossary" },
];

/** Section 5 — learn your way */
const learnYourWayCards = [
  {
    title: "Glossary",
    copy: "Look up techniques, machine terms, abbreviations, and more.",
    image: "/images/home/home-glossary.webp",
    alt: "Glossary screen showing knitting terms and techniques",
    placeholder: "Glossary screenshot",
    button: "Browse Glossary",
    href: "/glossary",
  },
  {
    title: "Courses",
    copy: "Follow structured lessons and exercises at your own pace.",
    image: "/images/home/home-courses.webp",
    alt: "Courses screen showing structured machine knitting lessons",
    placeholder: "Course page screenshot",
    button: "Browse courses",
    href: "/courses",
  },
  {
    title: "Help Hub",
    copy: "Find practical answers when something does not look right.",
    image: "/images/home/home-help-hub.webp",
    alt: "Help Hub screen showing practical knitting answers and troubleshooting",
    placeholder: "Help Hub screenshot",
    button: "Visit Help Hub",
    href: "/help-hub",
  },
  {
    title: "References",
    copy: "Look up terms, machines, sizing charts, and more.",
    image: "/images/home/home-reference.webp",
    alt: "References screen showing lookup guides, sizing charts, and machine information",
    placeholder: "Glossary or Machine Database screenshot",
    button: "Browse references",
    href: "/reference",
  },
];

const sueIntroParagraphs = [
  "I'm Sue, and I've been helping machine knitters for more than fifteen years.",
  "Knit It Now grew from the real questions knitters ask every day — at the machine, mid-project, when something doesn't look quite right.",
  "My goal is simple: give you clear guidance, practical tools, and a place you can come back to whenever you knit.",
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  bodyClass="page--tight-header page--home-v2"
>
  <div class="home-v2">
    <!-- ========== HERO: wide image with card overlaid on the left (desktop) ========== -->
    <section class="home-v2-hero" aria-labelledby="home-hero-heading">
      <div class="home-v2-hero__frame">
        <div class="home-v2-hero__card">
          <h1 id="home-hero-heading">Learn, build skills, and machine knit with confidence.</h1>
          <p class="home-v2-hero__copy">
            Whether you're a beginner or a seasoned pro, we provide the tools, patterns, and tutorials to help you spend less time guessing and more time knitting.
          </p>
          <div class="home-v2-hero__actions">
            <a href="#explore" class="kbm-btn kbm-btn-accent">Explore the Site</a>
            <a href="/membership" class="kbm-btn kbm-btn-outline">Become a Member</a>
          </div>
          <p class="home-v2-hero__login">
            Already a member?
            <a href="#" data-ms-modal="login" data-ms-redirect="current-url">Log in</a>
          </p>
        </div>
      </div>
    </section>

    <div class="home-v2__content">
      <!-- ========== SECTION 2: How can we help? ========== -->
      <section class="home-v2-section" aria-labelledby="home-help-heading">
        <header class="home-v2-section__header">
          <h2 id="home-help-heading">How can Knit It Now help you today?</h2>
        </header>
        <div class="home-v2-grid home-v2-grid--four">
          {helpTodayCards.map((card) => (
            <a href={card.href} class="home-v2-audience-card">
              <div class="home-v2-audience-card__media">
                <img
                  src={card.image}
                  alt={card.alt}
                  class="home-v2-audience-card__img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h3>{card.title}</h3>
              <p>{card.copy}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- ========== SECTION 3: Explore Knit It Now ========== -->
      <section class="home-v2-section home-v2-section--soft" id="explore" aria-labelledby="home-explore-heading">
        <header class="home-v2-section__header">
          <h2 id="home-explore-heading">Explore Knit It Now</h2>
          <p class="home-v2-section__lede">
            Pick an area and take a look — no commitment required.
          </p>
        </header>
        <div class="home-v2-grid home-v2-grid--four">
          {exploreCards.map((card) => (
            <article class="home-v2-feature-card">
              <div class="home-v2-feature-card__media">
                {card.image ? (
                  <img
                    src={card.image}
                    alt={card.alt ?? ""}
                    class="home-v2-feature-card__img"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <HomeImagePlaceholder label={card.placeholder} aspect="16 / 9" compact={true} />
                )}
              </div>
              <h3>{card.title}</h3>
              <p>{card.copy}</p>
              <a href={card.href} class="kbm-btn kbm-btn-outline home-v2-feature-card__btn">
                {card.button}
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- ========== SECTION 4: Everything works together ========== -->
      <section class="home-v2-section" aria-labelledby="home-workflow-heading">
        <header class="home-v2-section__header">
          <h2 id="home-workflow-heading">Everything works together</h2>
          <p class="home-v2-section__lede">
            Everything is designed to work together, from learning new skills to knitting with confidence.
          </p>
        </header>
        <ol class="home-v2-workflow" aria-label="How Knit It Now fits together">
          {workflowSteps.map((step, index) => (
            <li class="home-v2-workflow__item">
              <div class="home-v2-workflow__block">
                <span class="home-v2-workflow__label">{step.label}</span>
                <span class="home-v2-workflow__hint">{step.hint}</span>
              </div>
              {index < workflowSteps.length - 1 && (
                <>
                  <span class="home-v2-workflow__arrow home-v2-workflow__arrow--down" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M12 5v14M6 13l6 6 6-6"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                  <span class="home-v2-workflow__arrow home-v2-workflow__arrow--right" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M5 12h14M13 6l6 6-6 6"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </>
              )}
            </li>
          ))}
        </ol>
      </section>

      <!-- ========== SECTION 5: Learn your way ========== -->
      <section class="home-v2-section home-v2-section--soft" aria-labelledby="home-learn-heading">
        <header class="home-v2-section__header">
          <h2 id="home-learn-heading">Learn your way</h2>
          <p class="home-v2-section__lede">
            Watch, read, or look something up — come back whenever you need it.
          </p>
        </header>
        <div class="home-v2-grid home-v2-grid--four">
          {learnYourWayCards.map((card) => (
            <article class="home-v2-learn-card">
              <div class="home-v2-feature-card__media">
                {card.image ? (
                  <img
                    src={card.image}
                    alt={card.alt ?? ""}
                    class="home-v2-feature-card__img"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <HomeImagePlaceholder label={card.placeholder} aspect="16 / 9" compact={true} />
                )}
              </div>
              <h3>{card.title}</h3>
              <p>{card.copy}</p>
              <a href={card.href} class="kbm-btn kbm-btn-primary home-v2-learn-card__btn">
                {card.button}
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- ========== SECTION 6: Hi, I'm Sue ========== -->
      <section class="home-v2-section" aria-labelledby="home-sue-heading">
        <div class="home-v2-sue">
          <div class="home-v2-sue__text">
            <h2 id="home-sue-heading">Hi, I'm Sue.</h2>
            {sueIntroParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <p>
              <a href="/about" class="home-v2-sue__link">More about Knit It Now</a>
            </p>
          </div>
          <div class="home-v2-sue__photo-wrap">
            <img
              src={suePhoto}
              alt={suePhotoAlt}
              class="home-v2-sue__photo"
              width="480"
              height="480"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- ========== SECTION 7: Ready to explore? ========== -->
      <section class="home-v2-cta" aria-labelledby="home-cta-heading">
        <h2 id="home-cta-heading">Ready to explore?</h2>
        <p>
          Take your time looking around. When you're ready for full access to builders, courses, and
          member resources, we'd love to have you join.
        </p>
        <div class="home-v2-cta__actions">
          <a href="#explore" class="kbm-btn kbm-btn-accent">Explore the Site</a>
          <a href="/membership" class="kbm-btn kbm-btn-outline">Become a Member</a>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style is:global>
  body.page--home-v2 .site-content {
    padding-left: 0;
    padding-right: 0;
    max-width: none;
  }

  body.page--home-v2 .home-v2 {
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }
</style>

<style>
  .home-v2 {
    --home-max: 1200px;
    --home-gutter: clamp(1rem, 2.5vw, 1.75rem);
    background: #fafaf8;
  }

  .home-v2__content {
    max-width: var(--home-max);
    margin: 0 auto;
    padding: 0 var(--home-gutter) 4.5rem;
  }

  /* —— Hero —— */
  .home-v2-hero {
    margin-bottom: clamp(3.5rem, 6vw, 5rem);
    background-image: url("/images/home/knitting-machine.webp");
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center center;
  }

  .home-v2-hero__frame {
    position: relative;
    z-index: 1;
    max-width: var(--home-max);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3rem) var(--home-gutter);
    min-height: clamp(320px, 62vw, 420px);
    display: flex;
    align-items: flex-end;
  }

  .home-v2-hero__card {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 470px;
    padding: clamp(1.35rem, 3vw, 1.85rem) clamp(1.25rem, 3vw, 1.75rem);
    background: #fff;
    border-radius: 1.125rem;
    border: 1px solid rgba(82, 104, 45, 0.14);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.18);
  }

  @media (min-width: 900px) {
    .home-v2-hero {
      background-position: 60% center;
      /* If cover still feels too zoomed after height/position tweaks, test: background-size: 100% auto; */
    }

    .home-v2-hero__frame {
      min-height: clamp(520px, 42vw, 650px);
      padding: 4rem var(--home-gutter);
      align-items: center;
    }
  }

  .home-v2-hero__card h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.45rem, 3.2vw, 2rem);
    line-height: 1.28;
    color: #2c3a57;
  }

  .home-v2-hero__copy {
    margin: 0 0 1.35rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #4d5a48;
  }

  .home-v2-hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .home-v2-hero__actions .kbm-btn {
    text-align: center;
    text-decoration: none;
  }

  @media (min-width: 480px) {
    .home-v2-hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .home-v2-hero__login {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: #6b7565;
    text-align: center;
  }

  .home-v2-hero__login a {
    color: var(--kbm-green, #52682d);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (min-width: 768px) {
    .home-v2-hero__login {
      text-align: left;
    }
  }

  /* —— Sections —— */
  .home-v2-section {
    margin-bottom: clamp(3.5rem, 6vw, 5rem);
  }

  .home-v2-section--soft {
    padding: clamp(2.75rem, 4.5vw, 3.75rem);
    background: #fff;
    border-radius: 1rem;
    border: 1px solid rgba(82, 104, 45, 0.1);
    box-shadow: 0 2px 12px rgba(82, 104, 45, 0.04);
  }

  .home-v2-section__header {
    text-align: center;
    margin-bottom: clamp(2rem, 3.5vw, 2.75rem);
  }

  .home-v2-section__header h2 {
    margin: 0 0 0.65rem;
    font-size: clamp(1.4rem, 2.8vw, 1.85rem);
    color: #2c3a57;
    line-height: 1.25;
  }

  .home-v2-section__lede {
    margin: 0 auto;
    max-width: 38rem;
    font-size: 1.02rem;
    line-height: 1.55;
    color: #6b7565;
  }

  /* —— Grids —— */
  .home-v2-grid {
    display: grid;
    gap: clamp(1.25rem, 2vw, 1.75rem);
    align-items: stretch;
  }

  .home-v2-grid--four {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .home-v2-grid--four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .home-v2-grid--four {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* —— Audience cards (section 2) —— */
  .home-v2-audience-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    background: #fff;
    border: 1px solid rgba(82, 104, 45, 0.12);
    border-radius: 0.85rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .home-v2-audience-card:hover {
    transform: translateY(-3px);
    border-color: rgba(82, 104, 45, 0.35);
    box-shadow: 0 8px 20px rgba(82, 104, 45, 0.1);
  }

  .home-v2-audience-card__media {
    height: 195px;
    overflow: hidden;
    border-radius: 14px 14px 0 0;
    background: #fff;
  }

  .home-v2-audience-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .home-v2-audience-card h3 {
    margin: 0;
    padding: 1.1rem 1.1rem 0.4rem;
    font-size: 1.02rem;
    line-height: 1.35;
    color: #2c3a57;
  }

  .home-v2-audience-card p {
    margin: 0;
    padding: 0 1.1rem 1.35rem;
    flex: 1;
    min-height: 4.5rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: #4d5a48;
  }

  /* —— Feature cards (section 3) —— */
  .home-v2-feature-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 100%;
    padding: 0 0 1.25rem;
    background: #fafaf8;
    border: 1px solid rgba(82, 104, 45, 0.12);
    border-radius: 0.85rem;
    overflow: hidden;
  }

  .home-v2-section--soft .home-v2-feature-card {
    background: #fff;
    border-color: rgba(82, 104, 45, 0.1);
  }

  .home-v2-feature-card__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #eef1e8;
  }

  .home-v2-feature-card__media :global(.home-img-placeholder) {
    border-radius: 0;
    border-left: none;
    border-right: none;
    border-top: none;
    height: 100%;
    aspect-ratio: auto;
  }

  .home-v2-feature-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .home-v2-feature-card h3 {
    margin: 0;
    padding: 1rem 1.1rem 0.4rem;
    font-size: 1rem;
    line-height: 1.35;
    color: #2c3a57;
  }

  .home-v2-feature-card p {
    margin: 0 0 1.15rem;
    padding: 0 1.1rem;
    flex: 1;
    min-height: 3.5rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: #4d5a48;
  }

  .home-v2-feature-card__btn {
    align-self: center;
    margin-top: auto;
    font-size: 0.88rem !important;
    padding: 0.55rem 0.95rem !important;
    text-decoration: none;
  }

  /* —— Workflow (section 4) —— */
  .home-v2-workflow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .home-v2-workflow__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    max-width: 14rem;
  }

  .home-v2-workflow__block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 5.5rem;
    padding: 1.1rem 0.95rem;
    background: #fff;
    border: 1px solid rgba(82, 104, 45, 0.18);
    border-radius: 0.85rem;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.06);
    text-align: center;
  }

  .home-v2-workflow__label {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--kbm-green, #52682d);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .home-v2-workflow__hint {
    margin-top: 0.4rem;
    font-size: 0.74rem;
    font-weight: 400;
    line-height: 1.4;
    color: #8a9484;
  }

  .home-v2-workflow__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--kbm-green, #52682d);
  }

  .home-v2-workflow__arrow svg {
    display: block;
    width: 1.875rem;
    height: 1.875rem;
  }

  .home-v2-workflow__arrow--right {
    display: none;
  }

  @media (min-width: 900px) {
    .home-v2-workflow {
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: stretch;
      justify-content: center;
      gap: 0;
      max-width: 100%;
    }

    .home-v2-workflow__item {
      flex: 1 1 0;
      flex-direction: row;
      align-items: stretch;
      max-width: none;
      min-width: 0;
      gap: 0;
    }

    .home-v2-workflow__block {
      flex: 0 1 86%;
      width: 86%;
      min-height: 7rem;
      height: 100%;
      align-self: stretch;
      box-sizing: border-box;
    }

    .home-v2-workflow__arrow--down {
      display: none;
    }

    .home-v2-workflow__arrow--right {
      display: flex;
      flex: 1 1 auto;
      align-self: center;
      min-width: 1.75rem;
      padding: 0 0.15rem;
    }

    .home-v2-workflow__arrow--right svg {
      width: 2rem;
      height: 2rem;
    }
  }

  /* —— Learn cards (section 5) —— */
  .home-v2-learn-card {
