---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---   

<Layout>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- CRITICAL: Inline typography to prevent Astro CSS bundler reordering issues -->
    <style data-kbm-typography>
      html {
        font-size: 112.5% !important; /* 18px - comfortable mobile reading */
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }
      @media (min-width: 1025px) {
        html {
          font-size: 100% !important; /* 16px for desktop */
        }
      }
    </style>
    
    <title>Knit it Now | Machine Knitting Help & Patterns</title>
    <meta
      name="description"
      content="New to machine knitting? Start here. Find your next step, build skills, and get guidance one small win at a time."
    />
  </head>

    <main class="kbm-start-here">
      <!-- HERO SECTION -->
      <section class="kbm-hero">
        <div class="kbm-hero__grid">
          <div class="kbm-hero__content">
            <h1>We’ve been busy behind the scenes</h1>
            <p class="hero-tagline">More patterns, more tools, and updates based on your feedback.</p>
            <p class="kbm-hero__text">
              There’s more to explore this week, and I’d love for you to take a look around and see what’s new.
            </p>
            <div class="kbm-hero__cta-group">
              <div class="kbm-hero__actions">
                <a href="/patterns" class="kbm-btn kbm-btn-accent">Explore Patterns</a>
                <a href="/tools" class="kbm-btn kbm-btn-outline">Explore Tools</a>
              </div>
            </div>
          </div>
          <div class="kbm-hero__image">
            <picture>
              <source srcset="/images/seeit-loveit-knitit.webp" type="image/webp" />
              <img 
                src="/images/seeit-loveit-knitit.webp" 
                alt="Machine knitting in progress with transfer tools, machine set up and ready to knit."
                loading="eager"
                data-testid="img-hero"
              />
            </picture>
          </div>
        </div>
      </section>

      <div id="weekly-tip-content" class="kbm-welcome kbm-welcome--branded">
        <div class="kbm-welcome-founder">
          <div class="kbm-welcome-founder__content">
            <div class="kbm-welcome-founder__text">
              <h2>Take a look around</h2>

              <p>
                I’ve been making changes based on your feedback, especially to the patterns, and I’ve started bringing tools into the new site too.
              </p>

              <p>For now, the best place to start is here:</p>

              <ul>
                <li><a href="/patterns">Patterns</a> – updated and improved based on early feedback</li>
                <li><a href="/tools">Tools</a> – a growing collection of helpful calculators and planning tools</li>
                <li><a href="/whats-new">What’s New</a> – a quick look at recent updates</li>
              </ul>

              <p>
                This is still a beta, so if something feels confusing or incomplete, that helps me know what to improve next.
              </p>
            </div>

            <div class="kbm-welcome-founder__photo">
              <img src="/images/sue_icon9.png" alt="Sue" width="120" height="120" loading="lazy" decoding="async" />
              <div class="kbm-welcome-founder__caption">~Sue</div>
            </div>
          </div>
        </div>
      </div>

      <!-- SOFT LAUNCH: Hidden temporarily. Bring back after initial onboarding phase -->
      <!-- WHERE ARE YOU RIGHT NOW? SECTION -->
      <section id="where-are-you" class="kbm-where-section kbm-hidden-softlaunch" hidden aria-hidden="true">
        <div class="kbm-where-inner">
          <div class="kbm-section-header">
            <h2>Where are you right now?</h2>
            <p class="kbm-section-subtitle">Tell me where you are right now, and I’ll point you to the right next step.</p>
            <p class="kbm-section-subtitle kbm-section-subtitle--secondary">There's no wrong choice — each path starts where you are.</p>
          </div>

          <div class="kbm-hex-grid">
          <!-- Card 1: I'm just starting — same wrapper pattern as shop/downloads (article + download-card-link) -->
          <article class="download-card kbm-card kbm-card--download kbm-hex-card">
            <a href="/start-here" class="download-card-link kbm-hex-card--link" data-testid="card-start-phase">
              <span class="kbm-card-ribbon">LIVE</span>
              <div class="kbm-hex-icon">
                <img src="/images/KINlogo.svg" alt="" />
              </div>
              <h3>I'm just getting started</h3>
              <p>Learn the basics so you can knit your first confident rows.</p>
              <span class="btn primary kbm-cta-guide" data-testid="button-getting-started">Start with the basics</span>
            </a>
          </article>

          <!-- Card 2: I've knitted a little -->
          <article class="download-card kbm-card kbm-card--download kbm-hex-card">
            <a href="/start-here" class="download-card-link kbm-hex-card--link" data-testid="card-skills-phase">
              <span class="kbm-card-ribbon" aria-label="In Progress">
                <i class="fa-solid fa-screwdriver-wrench" style="color: rgb(255, 255, 255);" aria-hidden="true"></i>
              </span>
              <div class="kbm-hex-icon">
                <img src="/images/KINlogo.svg" alt="" />
              </div>
              <h3>I've knitted a little</h3>
              <p>Build your skills with small, low-pressure projects.</p>
              <span class="btn primary kbm-cta-guide" data-testid="button-skill-builders">Practice Key Skills</span>
            </a>
          </article>

          <!-- Card 3: I'm ready to make something -->
          <article class="download-card kbm-card kbm-card--download kbm-hex-card">
            <a href="/start-here" class="download-card-link kbm-hex-card--link" data-testid="card-projects-phase">
              <span class="kbm-card-ribbon" aria-label="In Progress">
                <i class="fa-solid fa-screwdriver-wrench" style="color: rgb(255, 255, 255);" aria-hidden="true"></i>
              </span>
              <div class="kbm-hex-icon">
                <img src="/images/KINlogo.svg" alt="" />
              </div>
              <h3>I'm ready to make something</h3>
              <p>Start with patterns that give you a solid place to begin.</p>
              <span class="btn primary kbm-cta-guide" data-testid="button-rsk">Start a project</span>
            </a>
          </article>

          <!-- Card 4: Help Hub (support destination) -->
          <article class="download-card kbm-card kbm-card--download kbm-hex-card kbm-hex-card--help">
            <a href="/start-here" class="download-card-link kbm-hex-card--link" data-testid="card-need-help">
              <span class="kbm-card-ribbon" aria-label="In Progress">
                <i class="fa-solid fa-screwdriver-wrench" style="color: rgb(255, 255, 255);" aria-hidden="true"></i>
              </span>
              <div class="kbm-hex-icon">
                <img src="/images/KINlogo.svg" alt="" />
              </div>
              <h3>Help Hub</h3>
              <p>Find troubleshooting tips, answers, and your next step.</p>
              <span class="btn primary kbm-cta-guide" data-testid="button-need-help">Get Help</span>
            </a>
          </article>
          </div>
        </div>
      </section>

      <section class="kbm-home-feedback" style="margin-top:60px; text-align:center;">
        <h3>Have feedback?</h3>

        <p>
          If something feels confusing or not quite right, I'd really like to hear about it.
        </p>

        <p style="margin-top:15px;">
          <a href="/contact" class="kbm-btn kbm-btn-outline">Send Feedback</a>
        </p>
      </section>

    </main>

  
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }

  :root {
    --kbm-green: #52682d;
    --kbm-green-hover: #445626;
    --kbm-green-2: #738c52;
    --font: "Poppins", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  body {
    margin: 0;
    background: #f7f8f7;
    font-family: var(--font);
    color: #222;
  }

  /* ========== MAIN WRAPPER ========== */
  .kbm-start-here {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1rem 1.5rem 3rem;
  }

  /* ========== SHARED BUTTON STYLES ========== */
  .btn {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border-radius: 999px;
    font-size: 0.95rem;
    text-decoration: none;
    font-weight: 500;
    border: 1px solid transparent;
    transition: background-color 0.2s ease;
  }

  .btn.primary {
    background-color: var(--kbm-green);
    color: #fff;
  }

  .btn.primary:hover {
    background-color: var(--kbm-green-hover);
  }

  /* ========== SECTION HEADERS ========== */
  .kbm-section-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .kbm-section-header h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    color: #2c3a57;
    margin: 0 0 0.5rem;
  }

  .kbm-section-framing {
    margin: 0 auto;
    max-width: 40rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #4d5a48;
  }

  .kbm-section-subtitle {
    color: #4d5a48;
    font-size: 1rem;
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .kbm-section-subtitle--secondary {
    font-style: italic;
    margin-top: 0.35rem;
    font-size: 0.95rem;
    color: #6b7565;
  }

  /* :global so this still applies when homepage markup is passed through Layout’s <slot /> */
  :global(.kbm-hidden-softlaunch) {
    display: none !important;
  }

  /* ========== HERO SECTION ========== */
  .kbm-hero {
    margin-bottom: 2.5rem;
    padding-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .kbm-hero {
      padding-top: 0.5rem;
    }
  }

  .kbm-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  .kbm-hero__content {
    text-align: center;
  }

  .kbm-hero__eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--kbm-green-2);
    margin-bottom: 0.75rem;
    padding: 0.35rem 1rem;
    background: rgba(115, 140, 82, 0.12);
    border-radius: 999px;
  }

  .kbm-hero h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin: 0 0 1rem;
    color: #2c3a57;
    line-height: 1.3;
  }

  .kbm-hero .hero-tagline {
    margin: 0 0 1rem;
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    font-weight: 600;
    line-height: 1.45;
    color: var(--kbm-green-2);
  }

  .kbm-hero__text {
    max-width: 42rem;
    margin: 0 auto 1.85rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #4d5a48;
  }

  .kbm-hero__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  /* Hero CTAs: slightly larger tap targets; same global .kbm-btn system */
  .kbm-hero__actions .kbm-btn {
    padding: 0.55rem 1.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .kbm-hero__cta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  .kbm-hero__support {
    margin: 0;
    padding-top: 0.1rem;
    text-align: center;
  }

  .kbm-hero__support-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: #6b7565;
    text-decoration: underline;
    text-decoration-color: rgba(107, 117, 101, 0.45);
    text-underline-offset: 0.2em;
  }

  .kbm-hero__support-link:hover {
    color: var(--kbm-green-2);
    text-decoration-color: rgba(115, 140, 82, 0.55);
  }

  .kbm-hero__support-link:focus-visible {
    outline: 2px solid var(--kbm-green-2);
    outline-offset: 0.15rem;
    border-radius: 2px;
  }

  .kbm-hero__helper {
    font-style: italic;
    font-size: 0.9rem;
    color: #4d5a48;
    margin: 0;
    text-align: center;
  }

  .kbm-hero__image {
    display: flex;
    justify-content: center;
  }

  .kbm-hero__image img {
    width: 100%;
    max-width: 420px;
    height: auto;
    border-radius: 1rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    background: #e0e5d8;
    min-height: 200px;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .kbm-hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .kbm-hero__content {
      text-align: left;
    }

    .kbm-hero__text {
      margin-left: 0;
      margin-right: 0;
    }

    .kbm-hero__actions {
      align-items: flex-start;
      justify-content: flex-start;
      flex-direction: row;
    }

    .kbm-hero__cta-group {
      align-items: flex-start;
      margin-left: 0;
      margin-right: auto;
    }

    .kbm-hero__support {
      text-align: left;
    }

    .kbm-hero__image img {
      max-width: 100%;
    }
  }

  /* Welcome / founder card: global.css (.kbm-welcome*, .kbm-welcome-founder*) */

  .kbm-welcome-title-logo {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    object-fit: contain;
    display: block;
  }

  /* ========== WHERE ARE YOU SECTION ========== */
  .kbm-where-section {
    background-color: #ffffff;
    padding-top: 2rem;
    padding-bottom: 4rem;
    margin-top: 3rem;
    margin-left: -1.5rem;
    margin-right: -1.5rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    scroll-margin-top: calc(var(--header-height, 160px) + 1rem);
  }

  .kbm-where-inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .kbm-where-section .kbm-section-header {
    margin-bottom: 2rem;
  }

  .kbm-where-section .kbm-section-header h2 {
    margin-bottom: 0.5rem;
  }

  .kbm-hex-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 600px) {
    .kbm-hex-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .kbm-hex-grid {
      position: relative;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    /* Subtle connector line behind first three cards (visible only in gaps between them) */
    .kbm-hex-grid::before {
      content: "";
      position: absolute;
      left: 0;
      width: 65%;
      top: 50%;
      transform: translateY(-50%);
      height: 4px;
      border-radius: 3px;
      background: rgba(115, 140, 82, 0.35);
      z-index: 0;
      pointer-events: none;
    }
  }

  @media (max-width: 1023px) {
    .kbm-hex-grid::before {
      display: none;
    }
  }

  .kbm-hex-card {
    position: relative;
    z-index: 2;
    background-color: #ffffff;
    border-radius: 1.25rem;
    padding: 1.5rem 1.25rem;
    border: 2px solid #c7d8a4;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
  }

  .kbm-hex-card:hover {
    background-color: #f6f8f2;
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(82, 104, 45, 0.12);
    border-color: var(--kbm-green);
  }

  /* Help Hub card: subtle support styling (same structure, soft green tint) */
  .kbm-hex-card--help {
    background-color: #f2f5ec;
    border-color: #a8c078;
  }

  .kbm-hex-card--help:hover {
    background-color: #eaf0e2;
    border-color: var(--kbm-green-2);
  }

  .kbm-hex-card--link {
    text-decoration: none;
    cursor: pointer;
    color: inherit;
  }

  /* Same card shell as shop/downloads: article.download-card.kbm-card.kbm-card--download + .download-card-link */
  .kbm-hex-grid > article.kbm-hex-card.download-card.kbm-card.kbm-card--download {
    padding: 1.5rem 1.25rem !important;
    font-size: 1rem !important;
    font-weight: 400 !important;
    color: #222;
    overflow: hidden;
    cursor: default;
    height: auto;
    justify-content: flex-start;
    transform: none;
    text-decoration: none;
  }

  .kbm-hex-grid > article.kbm-hex-card.download-card.kbm-card.kbm-card--download:hover {
    background-color: #f6f8f2;
    transform: translateY(-4px) !important;
    box-shadow: 0 8px 20px rgba(82, 104, 45, 0.12);
    border-color: var(--kbm-green);
  }

  .kbm-hex-grid .kbm-hex-card.download-card .download-card-link {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .kbm-hex-icon {
    width: 56px;
    height: 56px;
    margin-bottom: 1rem;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kbm-hex-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .kbm-hex-card h3 {
    font-size: 1rem;
    color: #2c3a57;
    margin: 0 0 0.75rem;
    line-height: 1.35;
  }

  .kbm-hex-card p {
    font-size: 0.9rem;
    color: #4f5a4b;
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }

  .kbm-highlight {
    font-weight: 600;
    color: var(--kbm-green);
    font-style: italic;
  }

  .kbm-hex-card .btn {
    margin-top: auto;
    text-align: center;
    font-size: 0.85rem;
    padding: 0.55rem 1rem;
  }

  .kbm-link-list {
    padding-left: 1.1rem;
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: #4f5a4b;
  }

  .kbm-link-list li {
    margin-bottom: 0.4rem;
    line-height: 1.45;
  }

  .kbm-link-list a {
    color: var(--kbm-green);
    font-weight: 600;
    text-decoration: none;
  }

  .kbm-link-list a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ========== REASSURANCE SECTION ========== */
  .kbm-reassurance-section {
    margin-bottom: 1.5rem;
    padding: 2rem 0;
  }

  .kbm-reassurance-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .kbm-reassurance-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .kbm-reassurance-item {
    text-align: center;
    padding: 1.25rem;
  }

  @media (min-width: 768px) {
    .kbm-reassurance-item {
      text-align: left;
    }
  }

  .kbm-reassurance-item h4 {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.05rem;
    color: #2c3a57;
    margin: 0 0 0.5rem;
    font-weight: 600;
  }

  .kbm-reassurance-icon {
    width: 1.25rem;
    height: auto;
    flex-shrink: 0;
  }

  .kbm-reassurance-item p {
    font-size: 0.9rem;
    color: #4d5a48;
    line-height: 1.55;
    margin: 0;
  }

  .kbm-power-user-shortcut {
    font-size: 0.9rem;
    color: #666;
    line-height: 1.5;
    margin-top: 0.5rem;
  }

  /* ========== ABOUT LINK (welcome + founder block) ========== */
  .kbm-about-link {
    color: var(--kbm-green);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .kbm-about-link::after {
    content: "→";
    font-size: 0.85em;
  }

  .kbm-about-link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ========== MOBILE ADJUSTMENTS ========== */
  @media (max-width: 480px) {
    .kbm-start-here {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .kbm-hex-card {
      padding: 1.25rem 1rem;
    }

    .kbm-reassurance-item {
      padding: 1rem 0.5rem;
    }

    .kbm-where-section {
      margin-left: -1rem;
      margin-right: -1rem;
      padding-left: 1rem;
      padding-right: 1rem;
      padding-top: 3rem;
      padding-bottom: 3rem;
    }
  }

  /* ========== FIRST CARD PULSE ANIMATION ========== */
  .pulse-once {
    animation: pulseOnce 1.2s ease-out 0.8s 1;
  }

  @keyframes pulseOnce {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.03); }
    100% { transform: scale(1); }
  }

  /* Ribbons: match shop/downloads/index.astro (.kbm-card--download .kbm-card-ribbon); !important beats global .kbm-card-ribbon */
  .kbm-hex-grid .kbm-card--download .kbm-card-ribbon {
    width: 96px !important;
    height: 96px !important;
    padding: 0 !important;
    font-size: 0.62rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: transparent;
    display: flex !important;
    align-items: flex-start;
    justify-content: flex-start;
    box-sizing: border-box;
  }

  .kbm-hex-grid .kbm-card--download .kbm-card-ribbon::before {
    background: #52682d !important;
    z-index: 0;
  }

  .kbm-hex-grid .kbm-card--download .kbm-card-ribbon::after {
    content: "Member Bonus" !important;
    position: absolute;
    top: 42px;
    left: -3px;
    width: 70px;
    font-size: 0.6rem;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: none;
    color: #ffffff !important;
    text-align: center;
    transform: rotate(-45deg);
