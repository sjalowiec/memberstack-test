---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Membership | Knit it Now"
  description="Membership at Knit it Now gives machine knitters practical tools, troubleshooting help, and confidence."
>
  <div class="page-wrap">
    <h1>Knit it Now Membership</h1>

    <p>
      If you're learning machine knitting or trying to troubleshoot problems,
      membership gives you a place to find clear answers and practical help.
    </p>

    <h2>What members get</h2>

    <ul>
      <li>Troubleshooting help and practical machine fixes</li>
      <li>Tools and resources to help you plan projects</li>
      <li>Guides and videos for common machine knitting techniques</li>
    </ul>

    <p>
      <a href="/membership" class="kbm-btn kbm-btn-accent">
        See Membership Options
      </a>
    </p>
  </div>

</Layout>