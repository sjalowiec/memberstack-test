---
import Layout from "../layouts/Layout.astro";
import PatternsFeaturesSection from "../components/patterns/PatternsFeaturesSection.astro";
import PatternHeaderImage from "../components/patterns/PatternHeaderImage.astro";
import { PATTERN_BUILDERS_HOME_HREF } from "../lib/patterns/customPatternProjectNavigation";
import MembershipPricing from "../components/membership/MembershipPricing.astro";
import MembershipStatusPanel from "../components/membership/MembershipStatusPanel.astro";
import MembershipThankYou from "../components/membership/MembershipThankYou.astro";
import MembershipWhatsIncludedBody from "../components/membership/MembershipWhatsIncludedBody.astro";
import MembershipWhatsIncludedModal from "../components/membership/MembershipWhatsIncludedModal.astro";
import { MEMBERSHIP_WHATS_INCLUDED_HEADING } from "../lib/membership/membershipWhatsIncluded";

const memberStories = [
  {
    name: "Jean",
    heading: "Gauge matters.",
    quote: "Yes, gauge is important... and no, it's not a waste of yarn!",
  },
  {
    name: "Joann",
    heading: "Keep it simple.",
    quote: "Repeat after me: One machine. One pattern. One yarn. Work it.",
  },
  {
    name: "Michelle",
    heading: "Give yourself grace.",
    quote: "Be kind to yourself. Everyone learns at different rates and in different ways.",
  },
];

const audienceCards = [
  {
    title: "New to machine knitting",
    copy: "Follow guided lessons, build skills step by step, and spend less time guessing what to try next.",
  },
  {
    title: "Returning after a break",
    copy: "Refresh techniques, troubleshoot setup issues, and get practical help when something does not look right.",
  },
  {
    title: "Customizing garments",
    copy: "Use interactive pattern systems, planning tools, and calculators built for your gauge and measurements.",
  },
  {
    title: "Stuck mid-project",
    copy: "Find troubleshooting help, technique videos, and help hubs focused on real machine knitting problems.",
  },
];

const memberOutcomes = [
  "Build custom patterns with the pattern systems included in your membership",
  "Plan yarn, sizing, and project details with interactive tools and calculators",
  "Troubleshoot machine problems with practical fixes and technique guidance",
  "Follow courses and video lessons at your own pace",
  "Track rows, shaping, and progress inside supported pattern workflows",
  "Print knit-ready layouts designed to work beside your machine",
];

---

<Layout
  title="Membership | Knit it Now"
  description="Knit it Now membership gives machine knitters lessons, practical tools, and pattern-building support for the full knitting process."
  bodyClass="page--tight-header"
>
  <div class="membership-sales-page membership-billing-scope page-wrap">
    <!-- 1. Hero -->
    <section class="membership-hero" aria-labelledby="membership-hero-heading">
      <h1 id="membership-hero-heading">Knit it Now Membership</h1>
      <p>
        Knit It Now gives machine knitters the lessons, practical tools, and pattern-building
        support needed to knit with greater confidence.
      </p>
      <p class="membership-hero__subline">
        One membership for lessons, tools, pattern builders, and courses.
      </p>
      <div class="membership-hero__actions">
        <a
          href="#pricing"
          class="kbm-btn kbm-btn-accent"
          data-membership-sales-cta
          data-membership-sales-cta-kind="choose-plan"
        >
          Become a Member
        </a>
        <a
          href="#whats-included"
          class="kbm-btn kbm-btn-outline"
          data-membership-whats-included-open
          data-membership-whats-included-mode="anchor"
        >
          See what's included
        </a>
      </div>
      <button
        type="button"
        class="membership-status-open"
        data-membership-status-open
        hidden
      >
        View membership details
      </button>
      <p class="kbm-member-note" data-ms-content="!members">
        Already a member?
        <a href="#" data-ms-modal="login" data-ms-redirect="current-url">Log in</a>.
      </p>
    </section>

    <hr class="section-divider" />

    <!-- Logged-in status: blocking/inline panel + active/canceling modal -->
    <MembershipStatusPanel />

    <!-- Active / canceling paid members: thank-you (sales content hidden via script) -->
    <MembershipThankYou />

    <!-- Active / canceling: hero “See what’s included” opens this; sales visitors use inline section -->
    <MembershipWhatsIncludedModal />

    <div data-membership-sales-content>
    <!-- 2. Pricing -->
    <section
      id="pricing"
      class="membership-section membership-section--anchor"
      aria-labelledby="membership-pricing-heading"
      data-membership-purchase-region
    >
      <header class="membership-section__header">
        <h2 id="membership-pricing-heading">Join Knit it Now</h2>
        <p class="membership-section__lead">
          One membership gives you access to every lesson, every tool, every pattern builder, and
          every course — choose monthly or annual billing.
        </p>
      </header>
      <MembershipPricing />
    </section>

    <hr class="section-divider" />

    <!-- 3. Who this is for -->
    <section class="membership-section" aria-labelledby="membership-audience-heading">
      <header class="membership-section__header">
        <h2 id="membership-audience-heading">Who this is for</h2>
        <p class="membership-section__lead">
          Membership supports the full knitting process — not just a single pattern download.
        </p>
      </header>
      <div class="membership-audience-grid">
        {
          audienceCards.map((card) => (
            <article class="kbm-card membership-audience-card">
              <h3 class="kbm-card__title">{card.title}</h3>
              <p class="kbm-card__desc">{card.copy}</p>
            </article>
          ))
        }
      </div>
    </section>

    <hr class="section-divider" />

    <!-- 5. See inside / tour -->
    <section
      id="see-inside"
      class="membership-section membership-section--anchor"
      aria-labelledby="membership-tour-heading"
    >
      <header class="membership-section__header">
        <h2 id="membership-tour-heading">See what's inside</h2>
        <p class="membership-section__lead">
          Explore pattern tools, member videos, and practical help — the same resources members use
          every day.
        </p>
      </header>

      <PatternsFeaturesSection
        sectionId="membership-pattern-features"
        headingId="membership-patterns-features-heading"
        subtitle="Interactive pattern tools designed to make machine knitting easier to follow, customize, and track."
      />

      <div class="membership-tour-split">
        <div class="membership-tour-split__media">
          <PatternHeaderImage
            src="/images/patterns/build-steps.jpg"
            alt="Guided sweater pattern builder showing style, neckline, fit, and gauge steps"
            hintText="Click to enlarge"
            hintStyle="overlay"
            modalFit="readable"
            loading="lazy"
          />
        </div>
        <div class="membership-tour-split__content">
          <h3>Build a custom pattern in guided steps</h3>
          <p>
            Choose your style, enter your gauge and measurements, and generate a knit-ready pattern
            without rewriting instructions by hand.
          </p>
        </div>
      </div>

      <div class="reference-quick-links">
        <p class="reference-quick-links__label">Explore member areas</p>
        <div class="reference-quick-links__list">
          <a href={PATTERN_BUILDERS_HOME_HREF} class="reference-quick-links__item">Patterns</a>
          <a href="/tools" class="reference-quick-links__item">Tools</a>
          <a href="/videos" class="reference-quick-links__item">Videos</a>
          <a href="/help-hub" class="reference-quick-links__item">Help Hub</a>
          <a href="/courses" class="reference-quick-links__item">Courses</a>
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- 6. What members can do -->
    <section class="membership-section" aria-labelledby="membership-outcomes-heading">
      <header class="membership-section__header">
        <h2 id="membership-outcomes-heading">What members can do</h2>
        <p class="membership-section__lead">
          Practical support for planning, knitting, troubleshooting, and finishing with confidence.
        </p>
      </header>
      <ul class="membership-outcomes">
        {memberOutcomes.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <hr class="section-divider" />

    <!-- 7. What's included (sales visitors / non-members; hidden with sales content for active members) -->
    <section
      id="whats-included"
      class="membership-section membership-section--anchor"
      aria-labelledby="membership-included-heading"
      data-membership-whats-included-section
    >
      <header class="membership-section__header">
        <h2 id="membership-included-heading">{MEMBERSHIP_WHATS_INCLUDED_HEADING}</h2>
      </header>
      <MembershipWhatsIncludedBody />
    </section>

    <hr class="section-divider" />

    <!-- 8. Member stories -->
    <section class="membership-section" aria-labelledby="membership-stories-heading">
      <header class="membership-section__header">
        <h2 id="membership-stories-heading">Wisdom from Fellow Knitters</h2>
        <p class="membership-section__lead">
          Every machine knitter has moments of frustration and breakthrough. Here are a few reminders
          from members who've been there.
        </p>
      </header>
      <div class="membership-stories">
        {
          memberStories.map((story) => (
            <article class="kbm-card membership-story-card">
              <p class="membership-story-card__name">{story.name}</p>
              <h3 class="kbm-card__title">{story.heading}</h3>
              <p class="kbm-card__desc">{story.quote}</p>
            </article>
          ))
        }
      </div>
      <p class="membership-stories-closing">
        Sometimes the best advice comes from someone who's already been there.
      </p>
    </section>

    <hr class="section-divider" />

    <!-- 9. Bottom pricing CTA -->
    <section
      class="membership-section membership-bottom-cta"
      aria-labelledby="membership-bottom-cta-heading"
    >
      <header class="membership-section__header">
        <h2 id="membership-bottom-cta-heading">Ready to join?</h2>
      </header>
      <MembershipPricing variant="compact" showStatus={false} billingRadioHost={false} />
    </section>

    <hr class="section-divider" />

    <!-- 10. FAQ -->
    <section class="membership-section" aria-labelledby="membership-faq-heading">
      <header class="membership-section__header">
        <h2 id="membership-faq-heading">Frequently asked questions</h2>
      </header>
      <div class="faq-accordion">
        <details class="faq-item">
          <summary>What does membership include?</summary>
          <p>
            Membership includes member lessons, tools, Help Hub resources, downloads, every Pattern
            Builder, and every Knit It Now course.
          </p>
        </details>
        <details class="faq-item">
          <summary>Do I keep access to the pattern builders?</summary>
          <p>
            Yes. Active members have access to all pattern builders. Details about purchasing
            individual pattern systems will be provided separately if that option becomes available.
          </p>
        </details>
        <details class="faq-item">
          <summary>Can I change billing or cancel?</summary>
          <p>
            Yes. After you join, you can manage billing, switch between monthly and annual, or cancel
            from your workspace or the billing portal link on this page.
          </p>
        </details>
       
        <details class="faq-item">
          <summary>What if I'm not logged in when I choose a plan?</summary>
          <p>
            You'll be prompted to create an account or log in first, then checkout continues with
            your selected billing option.
          </p>
        </details>
        <details class="faq-item">
          <summary>Is everything on the site included?</summary>
          <p>
            Membership covers the core Knit It Now library — lessons, tools, videos, help hubs,
            reference resources, all pattern builders, and all courses. Some individual shop items or
            specialty content may be sold separately.
          </p>
        </details>
      </div>
    </section>
    </div>
  </div>

  <script>
    import "../scripts/joinCheckout.ts";
    import "../scripts/membershipBillingToggle.ts";
    import "../scripts/membershipStatusPanel.ts";
  </script>

  <style>
    .membership-sales-page.page-wrap {
      padding-top: 8px;
      max-width: 56rem;
    }

    .membership-section--anchor {
      scroll-margin-top: calc(var(--header-height, 7rem) + 1rem);
    }

    .membership-hero {
      margin-bottom: 0;
      padding: 1.25rem 1.5rem 1.5rem;
      border-radius: 1rem;
      background: linear-gradient(135deg, #f9f9f6 0%, #fff 55%);
      border: 1px solid #d6dbc9;
      box-shadow: 0 4px 16px rgba(82, 104, 45, 0.1);
      text-align: center;
    }

    .membership-hero h1 {
      margin: 0 0 0.75rem;
      font-size: clamp(1.4rem, 3vw, 2rem);
      line-height: 1.25;
    }

    .membership-hero p {
      max-width: 38rem;
      margin-left: auto;
      margin-right: auto;
    }

    .membership-hero__subline {
      margin-top: 0.5rem;
      font-weight: 600;
      color: #4d5a48;
    }

    .membership-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
      margin: 1.25rem 0 0.75rem;
    }

    .membership-section {
      margin: 0;
    }

    .membership-section__header {
      text-align: center;
      margin-bottom: 1.25rem;
    }

    .membership-section__header h2 {
      margin: 0 0 0.5rem;
    }

    .membership-section__lead {
      margin: 0 auto;
      max-width: 38rem;
      color: #4d5a48;
      line-height: 1.55;
    }


    .membership-audience-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
      gap: 1rem;
    }

    .membership-audience-card {
      cursor: default;
      padding: 1.5rem;
    }

    .membership-audience-card:hover {
      transform: none;
    }

    .membership-tour-split {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      align-items: center;
      margin: 1.5rem 0;
      padding: 1.25rem;
      border-radius: 1rem;
      background: #fff;
      border: 1px solid #d6dbc9;
    }

    .membership-tour-split__content h3 {
      margin: 0 0 0.5rem;
      font-size: var(--text-lg, 1.125rem);
      color: #2c3a57;
    }

    .membership-tour-split__content p {
      margin: 0;
      color: #4d5a48;
      line-height: 1.55;
    }

    @media (min-width: 720px) {
      .membership-tour-split {
        grid-template-columns: 1.1fr 1fr;
      }
    }

    .membership-outcomes {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .membership-outcomes li {
      margin: 0 0 0.6rem;
      padding: 0.6rem 0.75rem;
      font-size: 0.95rem;
      line-height: 1.5;
      color: #4d5a48;
      border-radius: 0.75rem;
      background: rgba(82, 104, 45, 0.06);
      border: 1px solid rgba(82, 104, 45, 0.18);
    }

    .membership-outcomes li:last-child {
      margin-bottom: 0;
    }

    .membership-stories {
      display: grid;
      gap: 1rem;
    }

    @media (min-width: 640px) {
      .membership-stories {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .membership-story-card {
      cursor: default;
      padding: 1.5rem;
    }

    .membership-story-card:hover {
      transform: none;
    }

    .membership-story-card__name {
      margin: 0 0 0.35rem;
      font-size: 0.9rem;
      font-weight: 600;
      line-height: 1.35;
      color: #4d5a48;
    }

    .membership-story-card .kbm-card__title {
      margin-bottom: 0.4rem;
    }

    .membership-story-card .kbm-card__desc {
      font-weight: 400;
    }

    .membership-stories-closing {
      margin: 1.25rem 0 0;
      text-align: center;
      font-weight: 600;
      color: #4d5a48;
    }

    .membership-bottom-cta {
      padding: 0.25rem 0 0;
    }

    .faq-accordion p {
      margin: 0.5rem 0 0;
      line-height: 1.55;
      color: #4d5a48;
    }
  </style>
</Layout>
