---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Community">
  <div class="container" style="padding: 2rem 0 3rem;">
    <div style="text-align:center; margin-bottom: 1.5rem;">
      <img
        src="/images/community-logo.svg"
        alt="Knit It Now Community"
        style="max-width: 140px; width: 100%; height: auto; margin: 0 auto 1rem; display: block;"
      />
      <h2>Connect with fellow machine knitters</h2>
      <ul style="list-style: disc; padding-left: 1.5rem; display: inline-block; text-align: left; margin: 0 auto 1rem;">
        <li>Ask questions</li>
        <li>Share your progress</li>
        <li>Get inspired by other knitters</li>
      </ul>
      <div data-ms-content="members">
      <p style="margin-top: 1.5rem;">
        <a
          href="https://knititnow.talkyard.net"
          target="_blank"
          rel="noopener noreferrer"
          class="kbm-btn kbm-btn-accent"

        >
        Join the Discussion
        </a>
      </p>
      <p style="font-size: 0.9rem; color: #666;">
        Returning knitters: Please create a new login for this space.
      </p>
      </div>

      <div data-ms-content="!members" class="community-locked">

        <p class="community-locked-message">
          You’ll set up a quick community login — separate from your Knit It Now account.
        </p>

        <a href="#" data-ms-modal="login" class="kbm-btn kbm-btn-primary">
          Join the Community
        </a>

      </div>
    </div>
  </div>
</Layout>

<style>
  .community-locked {
    margin-top: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .community-locked-message {
    margin: 0;
    max-width: 36ch;
    font-size: 1rem;
    line-height: 1.55;
    color: #334155;
  }
</style>