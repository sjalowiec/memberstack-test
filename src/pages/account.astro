---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

const title = "My Account | Knit it Now";
const description =
  "Manage your Knit It Now account details, profile, email, and password in one place.";
---

<Layout {title} {description} bodyClass="page--tight-header">
  <div class="account-page container">
    <div class="account-page__guest" data-ms-content="!members">
      <div class="account-page__intro">
        <h1>My Account</h1>
        <p class="account-page__lead">
          Log in to view and edit your profile, email, and password.
        </p>
      </div>

      <section class="account-page__card" aria-labelledby="account-login-heading">
        <h2 id="account-login-heading" class="account-page__card-title">Log in</h2>
        <form data-ms-form="login" class="contact-form account-page__form">
          <div class="contact-form__field">
            <label for="account-login-email">Email</label>
            <input
              type="email"
              id="account-login-email"
              data-ms-member="email"
              name="email"
              autocomplete="email"
              required
            />
          </div>
          <div class="contact-form__field">
            <label for="account-login-password">Password</label>
            <input
              type="password"
              id="account-login-password"
              data-ms-member="password"
              name="password"
              autocomplete="current-password"
              required
            />
          </div>
          <p class="account-page__forgot-wrap">
            <a href="#" data-ms-modal="forgot-password" class="account-page__forgot-link">Forgot your password?</a>
          </p>
          <button type="submit" class="contact-form__submit">Log in</button>
        </form>
        <!-- In-page reset fields for MemberStack forgot-password modal (token + password contract). -->
        <form
          class="account-page__ms-reset-sync"
          aria-hidden="true"
          {...{ "data-ms-form": "reset-password", redirect: "/account" } as Record<string, string>}
        >
          <input
            type="text"
            data-ms-member="token"
            name="ms-reset-token"
            autocomplete="one-time-code"
            tabindex="-1"
          />
          <input
            type="password"
            data-ms-member="password"
            name="ms-reset-password"
            autocomplete="new-password"
            tabindex="-1"
          />
        </form>
      </section>
    </div>

    <div data-ms-content="members">
    <div class="account-page__intro">
      <h1>My Account</h1>
      <p class="account-page__lead">
        Manage your Knit It Now account details and profile information here.
      </p>

      <section class="account-page__card account-page__card--muted" aria-labelledby="resources-heading">
        <h2 id="resources-heading" class="account-page__card-title">Member Resources</h2>
        <p class="account-page__muted-copy">
          This area will grow as we add saved patterns, member links, downloads, and other Knit It Now
          resources.
        </p>
      </section>

      <p class="account-page__welcome">
        Welcome back, <span data-ms-member="first-name">Member</span>!
      </p>
    </div>

    <section class="account-page__card" aria-labelledby="account-summary-heading">
      <h2 id="account-summary-heading" class="account-page__card-title">Account summary</h2>
      <p class="account-page__email-line">
        <span class="account-page__label-inline">Email:</span>
        <span data-ms-member="email"></span>
      </p>
    </section>

    <section class="account-page__card" aria-labelledby="profile-heading">
      <h2 id="profile-heading" class="account-page__card-title">Profile</h2>
      <form data-ms-form="profile" class="contact-form account-page__form">
        <div class="contact-form__field">
          <label for="first-name">First Name</label>
          <input
            type="text"
            id="first-name"
            data-ms-member="first-name"
            name="first-name"
            autocomplete="given-name"
            required
          />
        </div>
        <div class="contact-form__field">
          <label for="last-name">Last Name</label>
          <input
            type="text"
            id="last-name"
            data-ms-member="last-name"
            name="last-name"
            autocomplete="family-name"
            required
          />
        </div>
        <div class="contact-form__field">
          <label for="birthday">Birthday</label>
          <input
            type="text"
            id="birthday"
            name="birthday"
            data-ms-member="birthday"
            placeholder="MM/DD"
          />
          <p class="account-page__field-hint">
            Optional — enter month/day only. Used for Knit It Now birthday wishes and surprises.
          </p>
        </div>
        <button type="submit" class="contact-form__submit">Save Changes</button>
      </form>
    </section>

    <section class="account-page__card" aria-labelledby="email-heading">
      <h2 id="email-heading" class="account-page__card-title">Email</h2>
      <form data-ms-form="email" class="contact-form account-page__form">
        <div class="contact-form__field">
          <label for="email">New Email Address</label>
          <input type="email" id="email" data-ms-member="email" name="email" autocomplete="email" required />
        </div>
        <button type="submit" class="contact-form__submit">Update Email</button>
      </form>
    </section>

    <section class="account-page__card" aria-labelledby="password-heading">
      <h2 id="password-heading" class="account-page__card-title">Password</h2>
      <form data-ms-form="password" class="contact-form account-page__form">
        <div class="contact-form__field">
          <label for="current-password">Current Password</label>
          <input
            type="password"
            id="current-password"
            data-ms-member="current-password"
            name="current-password"
            autocomplete="current-password"
            required
          />
        </div>
        <div class="contact-form__field">
          <label for="new-password">New Password</label>
          <input
            type="password"
            id="new-password"
            data-ms-member="new-password"
            name="new-password"
            autocomplete="new-password"
            required
          />
        </div>
        <button type="submit" class="contact-form__submit">Update Password</button>
      </form>
      <p class="account-page__password-reset-hint">
        Don't remember your current password?
        <a href="#" data-ms-modal="forgot-password" class="account-page__forgot-link">Reset it by email instead</a>.
      </p>
    </section>
    </div>
  </div>
</Layout>

<style>
  .account-page {
    max-width: 720px;
    margin: 0 auto 4rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .account-page__intro {
    margin-bottom: 2rem;
  }

  .account-page__intro h1 {
    margin: 0 0 0.75rem;
    color: #2c3a57;
    font-weight: 700;
  }

  .account-page__lead {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: #374151;
  }

  .account-page__welcome {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: #2c3a57;
  }

  .account-page__card {
    position: relative;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.35rem 1.5rem 1.5rem;
    margin-bottom: 1.25rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .account-page__card--muted {
    background: #f9fafb;
  }

  .account-page__card-title {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: #2c3a57;
  }

  .account-page__email-line {
    margin: 0 0 1.25rem;
    word-break: break-word;
    color: #374151;
  }

  .account-page__label-inline {
    font-weight: 600;
    color: #2c3a57;
    margin-right: 0.35rem;
  }

  /* contact-form__field global styles target span; here label + input are siblings */
  .account-page__form .contact-form__field label {
    display: block;
    font-weight: 600;
    color: #2c3a57;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .account-page__form .contact-form__field input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: #fafafa;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: var(--font);
  }

  .account-page__form .contact-form__field input:focus {
    outline: none;
    border-color: var(--kbm-green);
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.15);
    background: #fff;
  }

  .account-page__form .contact-form__field .account-page__field-hint {
    margin: 0.45rem 0 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: #4b5563;
  }

  .account-page__form .contact-form__submit {
    width: auto;
    min-width: 10rem;
    margin-top: 0.25rem;
  }

  /* Visually hidden; holds fields the MS reset modal may sync to. */
  .account-page__ms-reset-sync {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    pointer-events: none;
  }

  .account-page__forgot-wrap {
    margin: 0.35rem 0 0.85rem;
    text-align: right;
  }

  .account-page__forgot-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: #2c3a57;
    text-decoration: underline;
    text-decoration-color: rgba(44, 58, 87, 0.35);
    text-underline-offset: 0.15em;
  }

  .account-page__forgot-link:hover {
    color: var(--kbm-green, #52682d);
    text-decoration-color: rgba(82, 104, 45, 0.45);
  }

  .account-page__forgot-link:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .account-page__password-reset-hint {
    margin: 0.85rem 0 0;
    font-size: 0.95rem;
    line-height: 1.45;
    color: #4b5563;
  }

  .account-page__muted-copy {
    margin: 0;
    line-height: 1.55;
    color: #4b5563;
  }

  @media (max-width: 480px) {
    .account-page__form .contact-form__submit {
      width: 100%;
    }
  }
</style>
