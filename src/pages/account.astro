---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import DashboardShell from "../components/dashboard/DashboardShell.astro";
import MyPatternsPanel from "../components/dashboard/MyPatternsPanel.astro";
import TagsPlaceholder from "../components/dashboard/TagsPlaceholder.astro";
import WorkspaceToolsGrid from "../components/dashboard/WorkspaceToolsGrid.astro";
import AccountSettingsPanel from "../components/dashboard/AccountSettingsPanel.astro";

const title = "My Workspace | Knit it Now";
const description =
  "Your Knit It Now workspace — saved patterns, tools, and account in one place.";
---

<Layout {title} {description} bodyClass="page--tight-header page--dashboard">
  <div class="account-dashboard">
    <div class="account-page__guest" data-ms-content="!members">
      <section class="dashboard-card account-page__login-card" aria-labelledby="account-login-heading">
        <h1 id="account-login-heading" class="dashboard-card__title">Log in to your workspace</h1>
        <p class="account-page__lead account-page__lead--guest">
          Access saved patterns and your knitting workspace.
        </p>
        <form data-ms-form="login" class="contact-form account-page__form">
          <div class="contact-form__field">
            <label for="account-login-email">Email</label>
            <input
              type="email"
              id="account-login-email"
              data-ms-member="email"
              name="email"
              autocomplete="email"
              required
            />
          </div>
          <div class="contact-form__field">
            <label for="account-login-password">Password</label>
            <input
              type="password"
              id="account-login-password"
              data-ms-member="password"
              name="password"
              autocomplete="current-password"
              required
            />
          </div>
          <p class="account-page__forgot-wrap">
            <a href="#" data-ms-modal="forgot-password" class="account-page__forgot-link">Forgot your password?</a>
          </p>
          <button type="submit" class="contact-form__submit">Log in</button>
        </form>
        <form
          class="account-page__ms-reset-sync"
          aria-hidden="true"
          {...{ "data-ms-form": "reset-password", redirect: "/account" } as Record<string, string>}
        >
          <input
            type="text"
            data-ms-member="token"
            name="ms-reset-token"
            autocomplete="one-time-code"
            tabindex="-1"
          />
          <input
            type="password"
            data-ms-member="password"
            name="ms-reset-password"
            autocomplete="new-password"
            tabindex="-1"
          />
        </form>
      </section>
    </div>

    <div data-ms-content="members">
      <DashboardShell>
        <MyPatternsPanel />
        <TagsPlaceholder />
        <WorkspaceToolsGrid />
        <AccountSettingsPanel />
      </DashboardShell>
    </div>
  </div>
</Layout>

<script>
  import "/src/scripts/account-my-patterns.ts";
</script>

<style>
  :global(body.page--dashboard .site-content) {
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }

  .account-dashboard {
    width: 100%;
    background: linear-gradient(180deg, #f7f8f5 0%, #fff 12rem);
  }

  .account-page__guest {
    max-width: 28rem;
    margin: 0 auto;
    padding: 0.35rem 1.25rem 4rem;
  }

  .account-page__login-card {
    margin-top: 0.25rem;
  }

  .account-page__lead {
    margin: 0 0 1.1rem;
    font-size: 0.98rem;
    line-height: 1.5;
    color: #4b5563;
  }

  .account-page__lead--guest {
    margin-bottom: 1.25rem;
  }

  /* Shared dashboard card styles */
  :global(.dashboard-card) {
    position: relative;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.35rem 1.5rem 1.5rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  :global(.dashboard-card--primary) {
    padding: 1.65rem 1.65rem 1.5rem;
    border-color: #d8dfd0;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.06);
  }

  :global(.dashboard-card--patterns) {
    scroll-margin-top: calc(var(--header-offset, 170px) + 1rem);
  }

  :global(.dashboard-card__header-row--primary) {
    margin-bottom: 1rem;
  }

  :global(.dashboard-card__title) {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: #2c3a57;
  }

  :global(.dashboard-card__title--primary) {
    font-size: clamp(1.35rem, 2.2vw, 1.65rem);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  :global(.dashboard-card__subtitle) {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #6b7280;
  }

  :global(.dashboard-card__subtitle--primary) {
    font-size: 1rem;
    color: #4b5563;
  }

  :global(.dashboard-muted) {
    margin: 0;
    line-height: 1.55;
    color: #4b5563;
  }

  :global(.dashboard-mini-card),
  :global(#my-tags),
  :global(#account) {
    scroll-margin-top: calc(var(--header-offset, 170px) + 1rem);
  }

  :global(.account-details-grid) {
    display: grid;
    gap: 1.5rem;
    margin-top: 0.75rem;
  }

  :global(.account-details-block) {
    padding-top: 1.25rem;
    border-top: 1px solid #eef0f2;
  }

  :global(.account-details-block:first-child) {
    padding-top: 0;
    border-top: none;
  }

  :global(.account-details-block__title) {
    margin: 0 0 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #374151;
  }

  .account-page__form .contact-form__field label {
    display: block;
    font-weight: 600;
    color: #2c3a57;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .account-page__form .contact-form__field input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: #fafafa;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: var(--font);
  }

  .account-page__form .contact-form__field input:focus {
    outline: none;
    border-color: var(--kbm-green);
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.15);
    background: #fff;
  }

  .account-page__form .contact-form__field .account-page__field-hint {
    margin: 0.45rem 0 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: #4b5563;
  }

  .account-page__form .contact-form__submit {
    width: auto;
    min-width: 10rem;
    margin-top: 0.25rem;
  }

  .account-page__ms-reset-sync {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    pointer-events: none;
  }

  .account-page__forgot-wrap {
    margin: 0.35rem 0 0.85rem;
    text-align: right;
  }

  .account-page__forgot-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: #2c3a57;
    text-decoration: underline;
    text-decoration-color: rgba(44, 58, 87, 0.35);
    text-underline-offset: 0.15em;
  }

  .account-page__forgot-link:hover {
    color: var(--kbm-green, #52682d);
    text-decoration-color: rgba(82, 104, 45, 0.45);
  }

  .account-page__forgot-link:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
    border-radius: 2px;
  }

  :global(.account-page__password-reset-hint) {
    margin: 0.85rem 0 0;
    font-size: 0.95rem;
    line-height: 1.45;
    color: #4b5563;
  }

  :global(.account-my-patterns__status--error) {
    color: #b42318;
  }

  :global(.account-my-patterns__table-wrap) {
    margin-top: 0.25rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  :global(.account-my-patterns__table) {
    width: 100%;
    min-width: 28rem;
    border-collapse: collapse;
    border-spacing: 0;
    font-size: 0.95rem;
  }

  :global(.account-my-patterns__table thead th) {
    padding: 0;
    text-align: left;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #4b5563;
    background: #eef0ea;
    border-bottom: 2px solid #c8cfc0;
    white-space: nowrap;
  }

  :global(.account-my-patterns__sort) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: 100%;
    margin: 0;
    padding: 0.65rem 0.85rem;
    border: none;
    background: transparent;
    font: inherit;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    border-radius: 0;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  :global(.account-my-patterns__sort:hover) {
    background: #e4e8dc;
    color: #2c3a57;
  }

  :global(.account-my-patterns__sort:focus-visible) {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: -2px;
    z-index: 1;
    position: relative;
  }

  :global(.account-my-patterns__sort--active) {
    color: #2c3a57;
    background: #e8ebe3;
  }

  :global(.account-my-patterns__sort-indicator) {
    display: inline-block;
    min-width: 0.85em;
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
    color: var(--kbm-green, #52682d);
  }

  :global(.account-my-patterns__table tbody tr.account-my-patterns__row) {
    border-bottom: 1px solid #e5e7eb;
    cursor: pointer;
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }

  :global(.account-my-patterns__table tbody tr.account-my-patterns__row:last-child) {
    border-bottom: none;
  }

  :global(.account-my-patterns__table tbody tr.account-my-patterns__row:hover) {
    background: #f3f5ef;
    box-shadow: inset 3px 0 0 var(--kbm-green, #52682d);
  }

  :global(.account-my-patterns__table tbody tr.account-my-patterns__row:focus-visible) {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: -2px;
    background: #f3f5ef;
    box-shadow: inset 3px 0 0 var(--kbm-green, #52682d);
  }

  :global(.account-my-patterns__table tbody tr.account-my-patterns__row[aria-disabled="true"]) {
    opacity: 0.55;
    cursor: wait;
    pointer-events: none;
  }

  :global(.account-my-patterns__table td) {
    padding: 0.85rem;
    vertical-align: middle;
    color: #374151;
  }

  :global(.account-my-patterns__pattern-name) {
    display: block;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
    color: #2c3a57;
    word-break: break-word;
    transition: color 0.15s ease;
  }

  :global(.account-my-patterns__row:hover .account-my-patterns__pattern-name),
  :global(.account-my-patterns__row:focus-visible .account-my-patterns__pattern-name) {
    color: #1f2a40;
  }

  :global(.account-my-patterns__type) {
    color: #4b5563;
    white-space: nowrap;
  }

  :global(.account-my-patterns__updated) {
    color: #6b7280;
    white-space: nowrap;
  }

  :global(.account-my-patterns__actions-header) {
    width: 1%;
    padding: 0.65rem 0.85rem;
    text-align: right;
  }

  :global(.account-my-patterns__cell--actions) {
    width: 1%;
    text-align: right;
    white-space: nowrap;
  }

  :global(.account-my-patterns__delete) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #9ca3af;
    cursor: pointer;
    opacity: 0.85;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      opacity 0.15s ease;
  }

  :global(.account-my-patterns__delete:hover:not(:disabled)) {
    background: rgba(82, 104, 45, 0.1);
    color: #52682d;
    opacity: 1;
  }

  :global(.account-my-patterns__delete:focus-visible) {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }

  :global(.account-my-patterns__delete:disabled) {
    opacity: 0.55;
    cursor: wait;
  }

  :global(.account-my-patterns__copy) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-right: 0.25rem;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #9ca3af;
    cursor: pointer;
    opacity: 0.85;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      opacity 0.15s ease;
  }

  :global(.account-my-patterns__copy:hover:not(:disabled)) {
    background: rgba(82, 104, 45, 0.1);
    color: #52682d;
    opacity: 1;
  }

  :global(.account-my-patterns__copy:focus-visible) {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }

  :global(.account-my-patterns__copy:disabled) {
    opacity: 0.55;
    cursor: wait;
  }

  /* Free / non-owner state: visibly present but unavailable. */
  :global(.account-my-patterns__copy--locked),
  :global(.account-my-patterns__copy--locked:disabled) {
    opacity: 0.4;
    color: #9ca3af;
    cursor: not-allowed;
  }

  :global(.account-my-patterns__copy--locked:hover) {
    background: transparent;
    color: #9ca3af;
    opacity: 0.4;
  }

  :global(.account-my-patterns__table tbody tr.account-my-patterns__row[aria-disabled="true"] .account-my-patterns__delete),
  :global(.account-my-patterns__table tbody tr.account-my-patterns__row[aria-disabled="true"] .account-my-patterns__copy) {
    pointer-events: none;
  }

  @media (max-width: 640px) {
    :global(.account-my-patterns__table-wrap) {
      overflow-x: visible;
    }

    :global(.account-my-patterns__table) {
      min-width: 0;
    }

    :global(.account-my-patterns__table thead) {
      display: none;
    }

    :global(.account-my-patterns__table tbody tr.account-my-patterns__row) {
      display: block;
      margin-bottom: 0.85rem;
      padding: 0.85rem 1rem;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      background: #fafafa;
    }

    :global(.account-my-patterns__table tbody tr.account-my-patterns__row:hover),
    :global(.account-my-patterns__table tbody tr.account-my-patterns__row:focus-visible) {
      background: #eef1e8;
      box-shadow: inset 3px 0 0 var(--kbm-green, #52682d);
    }

    :global(.account-my-patterns__table td) {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.45rem 0;
      border: none;
    }

    :global(.account-my-patterns__table td::before) {
      content: attr(data-label);
      flex: 0 0 7rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: #6b7280;
    }

    :global(.account-my-patterns__table td.account-my-patterns__cell--name) {
      flex-direction: column;
      gap: 0.35rem;
      padding-top: 0;
      padding-bottom: 0.65rem;
      border-bottom: 1px solid #e5e7eb;
      margin-bottom: 0.25rem;
    }

    :global(.account-my-patterns__table td.account-my-patterns__cell--name::before) {
      display: none;
    }

    :global(.account-my-patterns__pattern-name) {
      font-size: 1.05rem;
    }

    :global(.account-my-patterns__cell--actions) {
      justify-content: flex-end;
      padding-top: 0.15rem;
    }

    :global(.account-my-patterns__cell--actions::before) {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .account-page__form .contact-form__submit {
      width: 100%;
    }
  }
</style>
