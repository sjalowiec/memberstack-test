---
import Layout from "../../../layouts/Layout.astro";
import PageHead from "../../../components/PageHead.astro";
import { printables } from "../../../data/printables";

const title = "Printables | Knit it Now";
const description = "Printable templates and other resources for machine knitters.";

const previewMember = Astro.url.searchParams.get("previewMember"); // 'member' | 'nonmember'
const previewMode = previewMember === "member" || previewMember === "nonmember";

// TEMP fallback (replace later with Memberstack)
const actualIsMember = false;

// Preview overrides real state
const isMember =
  previewMember === "member"
    ? true
    : previewMember === "nonmember"
      ? false
      : actualIsMember;

      const downloads = printables;
---
<Layout title={title} description="Printable templates and tools to help you measure, plan, and work more accurately.">
  <PageHead title={title} />
  <div class="downloads-page">
    <header class="page-header">
      <h1 data-testid="text-page-title"><i class="fa-solid fa-print" style="color: #52682d;"></i> Printable Tools</h1>
      <p class="page-intro">
        Printable templates and tools to help you measure, plan, and work more accurately.
      </p>
      <p class="printables-subnote">
        Instant downloads. Some tools are free for members — others can be purchased individually.
      </p>
      <p class="printables-cta-inline">
        Want these included with membership?
        <a href="/membership">Join Knit it Now</a>
      </p>
    </header>

    {previewMode && (
      <div class="alert alert-info" style="margin-bottom: 2rem;">
        Preview mode:
        <strong>{isMember ? " Member" : " Non-member"}</strong>
      </div>
    )}

    <div class="downloads-grid">
      {downloads.map((item) => {
        const detailsUrl = item.detailsPage || `/downloads/${item.slug}`;
        return (
        <article
          class="download-card kbm-card kbm-card--download"
          data-testid={`card-download-${item.slug}`}
          data-ribbon={item.memberFree === true ? "member" : "paid"}
        >
          <a
            href={detailsUrl}
            class="download-card-link"
            data-testid={`card-link-${item.slug}`}
          >
            {item.memberFree === true ? (
              <span class="kbm-card-ribbon">Member Bonus</span>
            ) : (
              <span class="kbm-card-ribbon kbm-card-ribbon--paid" aria-label="Paid item">
                <i class="fa-solid fa-cart-shopping" style="color: rgb(255, 255, 255);" aria-hidden="true"></i>
              </span>
            )}

            <div class="download-card-thumb">
              <span class="download-card-thumb-link">
                <img
                  src={item.image}
                  alt={item.title}
                  class="download-card-thumb-image"
                  loading="lazy"
                />
              </span>
            </div>

            <div class="download-card-content">
              <h2 class="kbm-card__title">
                <span class="download-card__title-link">{item.title}</span>
              </h2>
              <p class="kbm-card__desc">{item.shortDescription}</p>
            </div>

            <div class="download-card-actions">
              <span class="download-card-cta">Learn More</span>
            </div>
          </a>
        </article>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  .downloads-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .page-header h1 {
    font-size: 2rem;
    color: var(--kbm-green);
    margin: 0 0 0.5rem 0;
  }

  .page-intro {
    font-size: 1.125rem;
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .alert.alert-info {
    padding: 0.75rem 1.25rem;
    background: #e8f4fc;
    border: 1px solid #b8daff;
    border-radius: 8px;
    color: #0c5460;
    font-size: 0.95rem;
  }

  .downloads-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
  align-items: stretch;
  justify-items: center; /* ADD THIS */
}

.download-card {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.download-card-link {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  text-decoration: none;
  color: inherit;
  cursor: pointer;
}

.download-card-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.download-card-actions {
  margin-top: auto;
  display: flex;
  justify-content: center;
}

  @media (min-width: 640px) {
    .downloads-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .downloads-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Card wrapper: one link to details page for whole card */
  .download-card.kbm-card,
  .downloads-grid .kbm-card--download {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    height: auto;
    text-decoration: none;
  }

  .downloads-grid .kbm-card--download:hover {
    transform: none;
  }

  .download-card .kbm-card__title {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0.5rem 0 0.75rem 0;
  }

  .download-card__title-link {
    color: inherit;
    text-decoration: none;
  }

  .download-card__title-link:hover {
    color: var(--kbm-green);
  }

  .download-card-thumb-link {
    display: block;
    text-decoration: none;
  }

  .download-card .kbm-card__desc {
    font-weight: 400;
    margin-bottom: 0.75rem;
    flex: none;
  }

  .download-card .kbm-card__meta {
    margin-bottom: 1rem;
  }

  /* Download cards — ribbon (page-only); transparent span text so only ::after label shows */
  .kbm-card--download .kbm-card-ribbon {
    width: 96px;
    height: 96px;
    padding: 0;
    font-size: 0.62rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: transparent;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    box-sizing: border-box;
  }

  .kbm-card--download .kbm-card-ribbon::before {
    background: #52682d;
    z-index: 0;
  }

  /* Text sits along the fold: position then rotate -45° from top-left corner */
  .kbm-card--download .kbm-card-ribbon::after {
    content: "Member Bonus" !important;
    position: absolute;
    top: 42px;
    left: -3px;
    width: 70px;
    font-size: 0.6rem;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: none;
    color: #ffffff;
    text-align: center;
    transform: rotate(-45deg);
    transform-origin: top left;
    z-index: 1;
  }

  /* Paid ribbon: dark green to match Member Bonus */
  .kbm-card-ribbon--paid {
    background-color: transparent;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kbm-card--download .kbm-card-ribbon--paid::before {
    background: #52682d;
    border-right: 1px solid rgba(82, 104, 45, 0.18);
    border-bottom: 1px solid rgba(82, 104, 45, 0.18);
    z-index: 0;
  }

  .kbm-card--download .kbm-card-ribbon--paid::after {
    content: "" !important;
  }

  .kbm-card-ribbon--paid i.fa-cart-shopping {
    position: relative;
    z-index: 1;
    transform: rotate(-45deg);
    font-size: 0.9rem;
    line-height: 1;
    color: #ffffff;
  }

  .download-card-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: #eef3e6;
    border: 1px solid #d7e2c8;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
    color: var(--kbm-green);
    font-size: 1.35rem;
  }

  .downloads-grid .kbm-card--download .download-card-actions {
    margin-top: 1rem;
  }

  .download-card-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: center;
    align-items: center;
  }

  .download-card-cta {
    display: inline-block;
    padding: 0.6rem 1.25rem;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 8px;
    text-decoration: none;
    text-align: center;
    transition: background 0.2s ease;
  }

  .download-card-cta,
  .download-card-cta.kbm-btn-primary,
  a.download-card-cta,
  span.download-card-cta {
    background-color: #B36D61;
    border-color: #B36D61;
    color: #ffffff;
  }

  .download-card-cta:hover,
  .download-card-cta.kbm-btn-primary:hover,
  a.download-card-cta:hover,
  span.download-card-cta:hover {
    background-color: #9e5e54;
    border-color: #9e5e54;
    color: #ffffff;
  }

  .download-card-cta--outline {
    background: transparent;
    color: var(--kbm-green);
    border: 2px solid var(--kbm-green);
  }

  .download-card-cta--outline:hover {
    background: rgba(82, 104, 45, 0.08);
  }

  .member-note {
    font-size: 0.9rem;
    color: #738c52;
    margin: 0.5rem 0 0 0;
  }

  .download-card-learn {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--kbm-green);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .download-card-learn:hover {
    color: var(--kbm-green-hover, #445626);
  }

  .printables-subnote {
    font-size: 0.9rem;
    color: #738c52;
    margin: 0.5rem 0 0 0;
  }

  .printables-cta-inline {
    font-size: 0.9rem;
    color: #738c52;
    margin: 0.35rem 0 0 0;
  }

  .printables-cta-inline a {
    color: var(--kbm-green, #52682d);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .printables-cta-inline a:hover {
    color: var(--kbm-green-hover, #445626);
  }
</style>
