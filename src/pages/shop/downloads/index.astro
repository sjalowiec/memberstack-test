---
import Layout from "../../../layouts/Layout.astro";
import PageHead from "../../../components/PageHead.astro";

const title = "Downloads | Knit it Now";
const description = "Printable templates and other resources for machine knitters.";

const previewMember = Astro.url.searchParams.get("previewMember"); // 'member' | 'nonmember'
const previewMode = previewMember === "member" || previewMember === "nonmember";

// TEMP fallback (replace later with Memberstack)
const actualIsMember = false;

// Preview overrides real state
const isMember =
  previewMember === "member"
    ? true
    : previewMember === "nonmember"
      ? false
      : actualIsMember;

const downloads = [
  {
    slug: "cut-n-sew-neckline-templates",
    title: "Cut 'n Sew Neckline Templates",
    description: "Printable templates to create smooth, professional neckline curves using the cut-and-sew method.",
    stripeLink: "https://buy.stripe.com/YOUR_LINK_HERE",
    file: "/downloads/cut-n-sew-neckline-templates.pdf",
    price: 5,
    memberFree: true,
    image: "/images/shop/downloads/cut-n-sew-neckline-template.jpg"
  },
  {
    slug: "charting-rulers",
    title: "Charting Rulers",
    description: "Printable rulers to help you measure, plan, and chart your knitting accurately.",
    stripeLink: "https://buy.stripe.com/YOUR_LINK_HERE",
    file: "/downloads/charting-rulers.pdf",
    price: 5,
    memberFree: false,
    detailsPage: "/shop/downloads/charting-rulers",
    image:"/images/shop/downloads/machine-knitting-printable-gauge-rulers.jpg"
  },
  {
    slug: "cheat-sheets-for-hand-manipulated-stitch-patterns",
    title: "Cheat Sheets for Hand Manipulated Stitch Patterns",
    description: "Cheat sheets to help make hand selecting needles a snap! Use with 3.6mm, 4.5mm, 6mm, 6.5mm, 7mm, 8mm, 9mm knitting machines.",
    stripeLink: "#",
    file: "/downloads/cheat-sheets-for-hand-manipulated-stitch-patterns.pdf",
    price: 9.99,
    memberFree: true,
    detailsPage: "/shop/downloads/cheat-sheets-for-hand-manipulated-stitch-patterns",
    image:"/images/shop/downloads/cheat-sheets-for-hand-manipulated-stitches.jpg"
    
  }
];
---
<Layout title={title} description="Printable templates and tools to help you measure, plan, and work more accurately.">
  <PageHead title={title} />
  <div class="downloads-page">
    <header class="page-header">
      <h1 data-testid="text-page-title"><i class="fa-solid fa-print" style="color: #52682d;"></i> Printable Tools</h1>
      <p class="page-intro">
        Printable templates and tools to help you measure, plan, and work more accurately.
      </p>
    </header>

    {previewMode && (
      <div class="alert alert-info" style="margin-bottom: 2rem;">
        Preview mode:
        <strong>{isMember ? " Member" : " Non-member"}</strong>
      </div>
    )}

    <div class="downloads-grid">
      {downloads.map((item) => {
        const showFreeMemberButton = isMember && item.memberFree;
        return (
          <article class="download-card kbm-card kbm-card--download" data-testid={`card-download-${item.slug}`}>
            {item.memberFree && (
              <span class="kbm-card-ribbon">MEMBER BONUS</span>
            )}
 <div class="download-card-icon">
  <img src={item.image} alt={item.title} class="download-card-image" loading="lazy" />
</div>
            <h2 class="kbm-card__title">{item.title}</h2>
            <p class="kbm-card__desc">{item.description}</p>
            {item.memberFree && (
              <p class="kbm-card__meta">
                {isMember ? "Included with your membership" : "Free for members"}
              </p>
            )}
            <div class="download-card-actions">
              {showFreeMemberButton ? (
                <a
                  href={item.file}
                  class="download-card-cta"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-testid={`link-download-${item.slug}`}
                >
                  Download Free as a Member
                </a>
              ) : (
                <a
                  href={item.stripeLink}
                  class="download-card-cta download-card-cta--outline"
                  target={item.stripeLink.startsWith("http") ? "_blank" : undefined}
                  rel={item.stripeLink.startsWith("http") ? "noopener noreferrer" : undefined}
                  data-testid={`link-download-${item.slug}`}
                >
                  Buy Now
                </a>
              )}
              {item.detailsPage !== "#" && (
                <a href={item.detailsPage} class="download-card-learn">
                  Learn more
                </a>
              )}
            </div>
       
          </article>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  .downloads-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .page-header h1 {
    font-size: 2rem;
    color: var(--kbm-green);
    margin: 0 0 0.5rem 0;
  }

  .page-intro {
    font-size: 1.125rem;
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .alert.alert-info {
    padding: 0.75rem 1.25rem;
    background: #e8f4fc;
    border: 1px solid #b8daff;
    border-radius: 8px;
    color: #0c5460;
    font-size: 0.95rem;
  }

  .downloads-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .downloads-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .downloads-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Card is content container with multiple links, not one big link */
  .download-card.kbm-card {
    cursor: default;
    text-decoration: none;
  }

  .download-card .kbm-card__title {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0.5rem 0 0.75rem 0;
  }

  .download-card .kbm-card__desc {
    font-weight: 400;
  }

  /* Download cards — ribbon (page-only); transparent span text so only ::after label shows */
  .kbm-card--download .kbm-card-ribbon {
    width: 96px;
    height: 96px;
    padding: 0;
    font-size: 0.62rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: transparent;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    box-sizing: border-box;
  }

  .kbm-card--download .kbm-card-ribbon::before {
    background: #c7d8a4;
    z-index: 0;
  }

  /* Text sits along the fold: position then rotate -45° from top-left corner */
  .kbm-card--download .kbm-card-ribbon::after {
    content: "MEMBER BONUS" !important;
    position: absolute;
    top: 42px;
    left: -3px;
    width: 70px;
    font-size: 0.6rem;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #52682d;
    text-align: center;
    transform: rotate(-45deg);
    transform-origin: top left;
    z-index: 1;
  }

  .download-card-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: #eef3e6;
    border: 1px solid #d7e2c8;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
    color: var(--kbm-green);
    font-size: 1.35rem;
  }

  .download-card-actions {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .download-card-cta {
    display: inline-block;
    padding: 0.6rem 1.25rem;
    background: var(--kbm-green);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 8px;
    text-decoration: none;
    text-align: center;
    transition: background 0.2s ease;
    align-self: flex-start;
  }

  .download-card-cta:hover {
    background: var(--kbm-green-hover, #445626);
  }

  .download-card-cta--outline {
    background: transparent;
    color: var(--kbm-green);
    border: 2px solid var(--kbm-green);
  }

  .download-card-cta--outline:hover {
    background: rgba(82, 104, 45, 0.08);
  }

  .member-note {
    font-size: 0.9rem;
    color: #738c52;
    margin: 0.5rem 0 0 0;
  }

  .download-card-learn {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--kbm-green);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .download-card-learn:hover {
    color: var(--kbm-green-hover, #445626);
  }
</style>
