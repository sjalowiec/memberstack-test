---
import Layout from "../../layouts/Layout.astro";

import PageHead from "../../components/PageHead.astro";
import EasyCutYarnCutterListing from "../../components/shop/EasyCutYarnCutterListing.astro";
import HobbyKnitNeedlesListing from "../../components/shop/HobbyKnitNeedlesListing.astro";
import Lk150TensionMastKitListing from "../../components/shop/Lk150TensionMastKitListing.astro";
import { EBOOK_SALES_PAUSED } from "../../lib/legacy/legacyEbookSalesHold";

const title = "Shop | Knit it Now";
const description = "Find knitting machines, accessories, software, cables, and guided workshops. Choose what you're looking for.";

const shopNav = [
  { name: "DesignaKnit", href: "/shop/designaknit" },
  { name: "Cables", href: "/shop/cables" },
  { name: "Machines", href: "/shop/machines" },
  { name: "Accessories", href: "/shop/accessories" },
  { name: "Downloads", href: "/shop/downloads" },
];

const categories = [
  {
    name: "Knitting Machines",
    description: "Machine ordering is coming soon. Contact Sue about availability in the meantime.",
    href: "/shop/machines",
    cta: "View Machines"
  },
  {
    name: "Accessories",
    description: "Ribbers, carriages, and other add-ons for the machines you already own.",
    href: "/shop/accessories",
    cta: "View Accessories"
  },
  {
    name: "Software",
    description: "DesignaKnit versions and upgrades.",
    href: "/shop/designaknit",
    cta: "Shop software"
  },
  {
    name: "Cables",
    description: "Machine-specific cables for connecting DesignaKnit. Help choosing a cable is available.",
    href: "/shop/cables",
    cta: "Shop cables"
  },
  // Hidden while EBOOK_SALES_PAUSED — restore by setting the flag to false.
  ...(!EBOOK_SALES_PAUSED
    ? [
        {
          name: "eBooks",
          description: "Downloadble reference books for machine knitters.",
          href: "/shop/ebooks",
          cta: "Shop eBooks",
        },
      ]
    : []),
  {
    name: "Downloads",
    description: "Downloadable templates, and other resources for machine knitters.",
    href: "/shop/downloads",
    cta: "Shop downloads"
  },
];
---

<Layout {title} {description}>
  <div class="shop-page">
    <header class="page-header">
      <h1 data-testid="text-page-title">Shop</h1>
      <p class="page-intro">Tools, machines, and guidance — chosen specifically for machine knitters.</p>
    </header>

    <nav class="shop-category-nav" aria-label="Shop categories">
      <ul class="shop-category-nav-list">
        {shopNav.map((item) => (
          <li>
            <a href={item.href} class="shop-category-link">{item.name}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="shop-warranty-jump">
      <a href="#machine-warranty">Machine warranty</a>
    </p>

    <div class="categories-grid">
      {categories.map((category, index) => (
        <div class="category-card" data-testid={`card-category-${index}`}>
          <h2 class="category-name">{category.name}</h2>
          <p class="category-description">{category.description}</p>
          <a href={category.href} class="category-cta" data-testid={`link-category-${index}`}>
            {category.cta}
          </a>
        </div>
      ))}
    </div>

    <div class="shop-kit-listing">
      <Lk150TensionMastKitListing />
      <HobbyKnitNeedlesListing />
      <EasyCutYarnCutterListing />
    </div>

    <section id="machine-warranty" class="machine-warranty" aria-labelledby="machine-warranty-heading">
      <h2 id="machine-warranty-heading">Machine Warranty</h2>
      <p>
        New knitting machines purchased from Knit It Now come with a three-month limited warranty from the original purchase date. The warranty covers defects in materials and workmanship for the original purchaser when the machine is used for non-industrial purposes. If a defect is confirmed under the warranty, the defective part will be replaced. Please keep your original sales receipt. Shipping costs for warranty service are the purchaser’s responsibility. If you have a problem with your machine, <a href="/contact/">contact us</a> and we’ll help you with the next step.
      </p>
    </section>
  </div>
</Layout>

<style>
  .shop-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 1.15rem;
  }

  .page-header h1 {
    font-size: 2rem;
    color: var(--kbm-green);
    margin-bottom: 0.5rem;
  }

  .page-intro {
    font-size: 1.125rem;
    color: #5a6b47;
    margin: 0;
  }

  .shop-category-nav {
    display: flex;
    justify-content: center;
    margin: 0 0 0.65rem;
  }

  .shop-category-nav-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }

  .shop-category-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.2;
    border: 1px solid #d7e2c8;
    background: #f6f8f2;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .shop-page a.shop-category-link:link,
  .shop-page a.shop-category-link:visited {
    color: var(--kbm-green);
    text-decoration: none;
  }

  .shop-page a.shop-category-link:hover,
  .shop-page a.shop-category-link:focus-visible {
    background: #eef3e6;
    border-color: #c9d8b2;
    color: #3f5222;
    text-decoration: none;
  }

  .shop-page a.shop-category-link:focus-visible {
    outline: 2px solid var(--kbm-green);
    outline-offset: 2px;
  }

  .shop-warranty-jump {
    text-align: center;
    margin: 0 0 2.25rem;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .shop-kit-listing {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 22rem));
    justify-content: center;
    gap: 1.5rem;
    margin: 0 auto;
  }

  .machine-warranty {
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid #e8ebe4;
    scroll-margin-top: calc(var(--header-offset, 170px) + 1rem);
  }

  .machine-warranty h2 {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.75rem;
  }

  .machine-warranty p {
    margin: 0;
    color: #5a6b47;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .shop-category-nav-list {
      gap: 0.4rem;
    }

    .shop-category-link {
      font-size: 0.85rem;
      padding: 0.38rem 0.75rem;
    }
  }

  @media (min-width: 640px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .category-card {
    background: #fafbf9;
    border: 1px solid #e8ebe4;
    border-radius: 12px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease;
  }

  .category-card:hover {
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.1);
  }

  .category-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.75rem 0;
  }

  .category-description {
    font-size: 1rem;
    color: #5a6b47;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .category-cta {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 8px;
    text-decoration: none;
    text-align: center;
    transition: background 0.2s ease;
    align-self: flex-start;
  }

  .shop-page .category-cta,
  .shop-page .category-cta.kbm-btn-primary,
  .shop-page a.category-cta,
  .shop-page .kbm-btn-primary {
    background-color: #B36D61;
    border-color: #B36D61;
    color: #ffffff;
  }

  .shop-page .category-cta:hover,
  .shop-page .category-cta.kbm-btn-primary:hover,
  .shop-page a.category-cta:hover,
  .shop-page .kbm-btn-primary:hover {
    background-color: #9e5e54;
    border-color: #9e5e54;
    color: #ffffff;
  }
</style>
