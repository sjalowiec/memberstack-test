---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import MachinesShopSubnav from "../../components/shop/MachinesShopSubnav.astro";
import {
  getMachinesForSale,
  primaryImageUrl,
  machineTitle,
  formatPitch,
} from "../../lib/machines/referenceCatalog";
import { availabilityLabel } from "../../lib/machines/machineAdminFields";
import { MACHINE_SALES_HOLD } from "../../lib/machines/machineSalesHold";
import {
  displayPriceLabel,
  getStorefrontHoldListings,
  listingGaugeLabel,
  storefrontBrandPanels,
} from "../../lib/machines/machineSalesListings";

// TEMPORARY: launch hold while shipping/ordering is finalized.
// Flip MACHINE_SALES_HOLD to false in machineSalesHold.ts to restore the catalog below.
const salesHold = MACHINE_SALES_HOLD;

/**
 * Shopify hold listings, managed from /admin/shop-machines
 * (data/machines-for-sale.json). Does not read or modify data/machines.json.
 */
const holdListings = salesHold ? getStorefrontHoldListings() : [];
const brandPanels = storefrontBrandPanels(holdListings);
const brandChooserCopy: Record<string, { description: string; action: string; pronunciation?: string }> = {
  taitexma: {
    pronunciation: "(tie-tex-ma)",
    description: "Taitexma machines are ordered in batches, so availability varies by shipment.",
    action: "Browse Taitexma",
  },
  "silver-reed": {
    description:
      "Explore Silver Reed knitting machines, from the portable LK150 to punchcard and electronic models.",
    action: "Browse Silver Reed",
  },
};

const title = "Knitting Machines for Sale | Knit it Now";
const description = salesHold
  ? "Purchase select Taitexma knitting machines and ribbers online through our Shopify store."
  : "Knitting machines currently available for purchase. Compare gauge and specs, then buy securely online.";

const machines = salesHold ? [] : getMachinesForSale();

function formatPrice(value: number | null): string | null {
  if (value == null) return null;
  return Number.isInteger(value)
    ? `$${value.toLocaleString("en-US")}`
    : `$${value.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
}
---

<Layout {title} {description}>
  {!salesHold && <PageHead title="Knitting Machines for Sale" />}

  <div class="machines-page">
    {/* === TEMPORARY MACHINE SALES HOLD (start) ===
        Shopify product cards below. Set MACHINE_SALES_HOLD = false to restore the full catalog. */}
    {salesHold ? (
      <>
        <div class="brand-catalog" data-brand-catalog>
          <div class="shop-top">
            <div class="shop-top-intro">
              <a class="back-link" href="/shop">← Back to Shop</a>
              <h1 class="page-title">Knitting Machines for Sale</h1>
              <p class="page-intro">
                Machines are available for customers in the United States only. Questions?
                <a href="/contact/" class="contact-modal-trigger" data-contact-source="shop-machines">Contact Sue</a>.
              </p>
            </div>
            {holdListings.length > 0 && (
              <div class="brand-switch" role="group" aria-label="Choose a brand">
              {brandPanels.map((panel, index) => {
                const copy = brandChooserCopy[panel.id];
                return (
                  <button
                    type="button"
                    class="brand-card"
                    data-brand-tab={panel.id}
                    aria-controls={`${panel.id}-panel`}
                    aria-pressed={index === 0 ? "true" : "false"}
                  >
                    <span class="brand-card-title">
                      {panel.title}
                      {copy?.pronunciation && (
                        <span class="brand-card-pronunciation">{copy.pronunciation}</span>
                      )}
                    </span>
                    {copy && <span class="brand-card-copy">{copy.description}</span>}
                    {copy && <span class="brand-card-action">{copy.action}</span>}
                  </button>
                );
              })}
              </div>
            )}
          </div>
          {holdListings.length === 0 ? (
            <p class="machines-empty">
              No machines are listed for sale right now. Please check back soon.
            </p>
          ) : (
            brandPanels.map((panel, index) => (
              <div
                class="brand-panel"
                id={`${panel.id}-panel`}
                data-brand-panel={panel.id}
                hidden={index !== 0}
              >
                {panel.machines.length === 0 && panel.extras.length === 0 ? (
                  <p class="machines-empty">
                    No {panel.title} products are listed right now.
                  </p>
                ) : (
                  [
                    { key: "machines", title: `${panel.title} Machines`, items: panel.machines },
                    {
                      key: "ribbers-accessories",
                      title: "Ribbers and Accessories",
                      items: panel.extras,
                    },
                  ]
                    .filter((group) => group.items.length > 0)
                    .map((group) => (
                      <section
                        class="machines-section"
                        aria-labelledby={`${panel.id}-${group.key}-heading`}
                      >
                        <h2
                          id={`${panel.id}-${group.key}-heading`}
                          class="machines-section-title"
                        >
                          {group.title}
                        </h2>
                        <div class="machines-grid machines-grid--temp">
                          {group.items.map((product) => {
                            const priceLabel = displayPriceLabel(product);
                            const gaugeLabel = listingGaugeLabel(product.specs);
                            const gaugeIndex = gaugeLabel ? product.specs.indexOf(gaugeLabel) : -1;
                            const specChips =
                              gaugeIndex >= 0
                                ? product.specs.filter((_, specIndex) => specIndex !== gaugeIndex)
                                : product.specs;
                            return (
                              <article class="machine-card">
                                <div class="machine-card-image-wrap">
                                  {product.imageSrc ? (
                                    <img
                                      src={product.imageSrc}
                                      alt={product.name}
                                      class="machine-card-image"
                                      width="280"
                                      height="180"
                                      loading="lazy"
                                      decoding="async"
                                    />
                                  ) : (
                                    <div class="machine-card-image-placeholder" aria-hidden="true">
                                      Image coming soon
                                    </div>
                                  )}
                                  {product.status === "sold" && (
                                    <span class="machine-status machine-status--sold-out">Sold</span>
                                  )}
                                </div>
                                <div class="machine-card-body">
                                  <h2 class="machine-name">{product.name}</h2>
                                  {gaugeLabel && <p class="machine-gauge">Gauge: {gaugeLabel}</p>}
                                  {specChips.length > 0 && (
                                    <ul class="machine-specs" aria-label="Quick specs">
                                      {specChips.map((spec) => (
                                        <li>{spec}</li>
                                      ))}
                                    </ul>
                                  )}
                                  {product.shortHtml && (
                                    <div class="machine-short" set:html={product.shortHtml} />
                                  )}
                                  {priceLabel && <p class="machine-price">{priceLabel}</p>}
                                  <div class="machine-actions">
                                    {product.status === "available" ? (
                                      <a
                                        href={product.shopifyUrl}
                                        class="machine-buy"
                                        rel="noopener"
                                        target="_blank"
                                      >
                                        Buy Now
                                      </a>
                                    ) : (
                                      <span class="machine-status-note">Sold</span>
                                    )}
                                  </div>
                                </div>
                              </article>
                            );
                          })}
                        </div>
                      </section>
                    ))
                )}
              </div>
            ))
          )}
        </div>
          <script>
            const brandCatalog = document.querySelector("[data-brand-catalog]");
            if (brandCatalog) {
              const brandTabs = [
                ...brandCatalog.querySelectorAll<HTMLButtonElement>("[data-brand-tab]"),
              ];
              const showBrand = (id: string) => {
                for (const tab of brandTabs) {
                  const selected = tab.dataset.brandTab === id;
                  tab.setAttribute("aria-pressed", selected ? "true" : "false");
                  const panelId = tab.getAttribute("aria-controls");
                  const panel = panelId ? document.getElementById(panelId) : null;
                  if (panel) panel.hidden = !selected;
                }
              };
              for (const tab of brandTabs) {
                tab.addEventListener("click", () => {
                  const id = tab.dataset.brandTab;
                  if (id) showBrand(id);
                });
              }
            }
          </script>
      </>
    ) : (
      <>
        {/* === ORIGINAL MACHINE CATALOG (preserved for restore) === */}
        <header class="page-header">
          <a class="back-link" href="/shop">← Back to Shop</a>
          <h1 class="page-title">Knitting Machines for Sale</h1>
          <p class="page-intro">
            These machines are currently available for purchase. Each card shows the
            key details—select <strong>View Details</strong> to learn more about a
            machine and its specs before you buy.
          </p>
        </header>

        <MachinesShopSubnav current="machines" />

        {machines.length === 0 ? (
          <p class="machines-empty">
            No machines are listed for sale right now. Please check back soon.
          </p>
        ) : (
          <div class="machines-grid">
            {machines.map((machine) => {
              const sale = machine.sale!;
              const imageSrc = primaryImageUrl(machine);
              const name = machineTitle(machine);
              const pitch = formatPitch(machine);
              const priceLabel = formatPrice(sale.price);
              const availLabel = availabilityLabel(sale);
              // Short blurb for the card.
              const shortHtml = sale.shortDescriptionHtml || null;
              return (
                <article class="machine-card">
                  <div class="machine-card-image-wrap">
                    {imageSrc ? (
                      <img
                        src={imageSrc}
                        alt={name}
                        class="machine-card-image"
                        width="280"
                        height="180"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="machine-card-image-placeholder" aria-hidden="true">
                        Image coming soon
                      </div>
                    )}
                    <span class={`machine-status machine-status--${sale.availabilityStatus}`}>{availLabel}</span>
                  </div>

                  <div class="machine-card-body">
                    <h2 class="machine-name">{name}</h2>

                    <ul class="machine-specs" aria-label="Quick specs">
                      <li>{machine.gauge}</li>
                      {pitch && <li>{pitch}</li>}
                      {machine.machineStyle && <li>{machine.machineStyle}</li>}
                    </ul>

                    {shortHtml && <div class="machine-short" set:html={shortHtml} />}

                    {priceLabel && <p class="machine-price">{priceLabel}</p>}

                    <div class="machine-actions">
                      <a href={`/shop/machines/${machine.slug}`} class="machine-details-link">
                        View Details
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        )}
        {/* === END ORIGINAL MACHINE CATALOG === */}
      </>
    )}
    {/* === TEMPORARY MACHINE SALES HOLD (end) === */}
  </div>
</Layout>

<style>
  .machines-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1.15rem 1rem 4rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    font-weight: 600;
    color: var(--kbm-green);
    text-decoration: underline;
  }

  .back-link:hover {
    color: var(--kbm-green-hover, #445626);
  }

  .page-header {
    margin-bottom: 1.25rem;
  }

  .shop-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
    align-items: start;
    margin-bottom: 0.65rem;
  }

  .shop-top .back-link {
    margin-bottom: 0.3rem;
  }

  .shop-top .page-title {
    margin-bottom: 0.35rem;
  }

  @media (min-width: 760px) {
    .shop-top {
      grid-template-columns: minmax(0, 1.15fr) minmax(15.5rem, 0.85fr);
      column-gap: 1.25rem;
      row-gap: 0;
    }
  }

  .page-title {
    font-size: 1.75rem;
    color: var(--kbm-green);
    margin: 0 0 0.75rem;
  }

  .page-intro {
    font-size: 1.125rem;
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
  }

  .page-intro--follow {
    margin-top: 1rem;
  }

  .brand-switch {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
  }

  .brand-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    width: 100%;
    min-height: 0;
    margin: 0;
    padding: 0.55rem 0.7rem 0.6rem;
    border: 2px solid #d5ddc8;
    border-radius: 12px;
    background: #ffffff;
    color: #3d4a32;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .brand-card-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--kbm-green);
  }

  .brand-card-pronunciation {
    font-size: 1rem;
    font-weight: 500;
  }

  .brand-card-copy {
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.35;
    color: #4d5c3d;
  }

  .brand-card-action {
    margin-top: auto;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--kbm-green);
  }

  .brand-card[data-brand-tab="taitexma"] {
    border-color: var(--kbm-accent);
  }

  .brand-card[data-brand-tab="silver-reed"] {
    border-color: var(--kbm-green);
  }

  .brand-card[aria-pressed="true"] {
    border-width: 4px;
    background: #f4f7ef;
  }

  .brand-card[data-brand-tab="taitexma"][aria-pressed="true"] {
    background: color-mix(in srgb, var(--kbm-accent) 9%, #ffffff);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--kbm-accent) 28%, transparent);
  }

  .brand-card[data-brand-tab="silver-reed"][aria-pressed="true"] {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--kbm-green) 28%, transparent);
  }

  .brand-card[aria-pressed="true"] .brand-card-action {
    color: var(--kbm-green);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .brand-card[data-brand-tab="taitexma"]:hover {
    border-color: var(--kbm-accent-hover);
  }

  .brand-card[data-brand-tab="silver-reed"]:hover {
    border-color: var(--kbm-green-hover);
  }

  .brand-card:focus-visible {
    outline: 3px solid #1d4ed8;
    outline-offset: 3px;
  }

  .machines-section {
    margin-top: 1.15rem;
  }

  .machines-section:first-of-type {
    margin-top: 0;
  }

  .machines-section-title {
    font-size: 1.35rem;
    color: var(--kbm-green);
    margin: 0 0 0.65rem;
  }

  .machines-hold-actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .machines-hold-secondary {
    font-weight: 600;
    color: var(--kbm-green);
    text-decoration: underline;
  }

  .machines-hold-secondary:hover {
    color: var(--kbm-green-hover, #445626);
  }

  .machines-empty {
    font-size: 1.05rem;
    color: #6b7b55;
    background: #fafbf9;
    border: 1px solid #e8ebe4;
    border-radius: 12px;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .machines-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .machines-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .machines-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .machines-grid--temp {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .machine-card {
    background: #fafbf9;
    border: 1px solid #e8ebe4;
    border-radius: 12px;
    padding: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: box-shadow 0.2s ease;
  }

  .brand-panel[data-brand-panel="taitexma"] .machine-card {
    border: 3px solid var(--kbm-accent);
  }

  .brand-panel[data-brand-panel="silver-reed"] .machine-card {
    border: 3px solid var(--kbm-green);
  }

  .machine-card:hover {
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.1);
  }

  .machine-card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 280 / 180;
    overflow: hidden;
    border-radius: 0;
    background: #eef3e6;
  }

  .machine-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .machine-card-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    color: #8a9a6e;
    background: #eef3e6;
  }

  .machine-status {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    color: #fff;
    background: #52682d;
  }

  .machine-status--available {
    background: #3f6212;
  }

  .machine-status--backorder {
    background: #b45309;
  }

  .machine-status--unavailable {
    background: #475569;
  }

  /* Legacy sale.status variants (kept for any older markup). */
  .machine-status--sold-out {
    background: #9a3412;
  }

  .machine-status--coming-soon {
    background: #b45309;
  }

  .machine-status--inquiry-only {
    background: #475569;
  }

  .machine-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem;
  }

  .machine-name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0;
  }

  .machine-gauge {
    margin: 0.45rem 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--kbm-green);
  }

  .machine-specs {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .machine-specs li {
    font-size: 0.78rem;
    color: #52682d;
    background: #f0f4e7;
    border: 1px solid #dbe6c5;
    border-radius: 6px;
    padding: 0.15rem 0.5rem;
  }

  .machine-short {
    font-size: 0.95rem;
    color: #5a6b47;
    line-height: 1.55;
    margin: 1rem 0 0;
  }

  .machine-price {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--kbm-green);
    margin: 1rem 0 0;
  }

  .machine-actions {
    padding-top: 1.25rem;
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
  }

  .machine-details-link {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    background: var(--kbm-green);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .machine-details-link:hover {
    background: var(--kbm-green-hover, #445626);
    color: #ffffff;
  }

  .machine-buy {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    background: var(--kbm-green);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .machine-buy:hover {
    background: var(--kbm-green-hover, #445626);
  }

  .machine-status-note {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: #6b7b55;
  }

  .machine-contact {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    background: #ffffff;
    color: var(--kbm-green);
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid var(--kbm-green);
    border-radius: 8px;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .machine-contact:hover {
    background: var(--kbm-green);
    color: #ffffff;
  }
</style>
