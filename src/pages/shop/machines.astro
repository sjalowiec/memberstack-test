---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import MachinesShopSubnav from "../../components/shop/MachinesShopSubnav.astro";
import {
  getMachinesForSale,
  primaryImageUrl,
  machineTitle,
  formatPitch,
} from "../../lib/machines/referenceCatalog";
import { availabilityLabel } from "../../lib/machines/machineAdminFields";
import { MACHINE_SALES_HOLD } from "../../lib/machines/machineSalesHold";

// TEMPORARY: launch hold while shipping/ordering is finalized.
// Flip MACHINE_SALES_HOLD to false in machineSalesHold.ts to restore the catalog below.
const salesHold = MACHINE_SALES_HOLD;

/**
 * Temporary Shopify-only offers while the full catalog remains on hold.
 * Hardcoded here on purpose — does not read or modify the machine reference database.
 */
const TEMP_SHOPIFY_PRODUCTS = [
  {
    name: "Taitexma TH860 Punchcard Knitting Machine",
    href: "https://vjzu11-86.myshopify.com/products/taitexma-th860-punchcard-knitting-machine",
    imageSrc: "/images/machines/8601.jpg",
    priceLabel: "$1,449",
    specs: ["Standard Gauge", "Punchcard", "200 needles"],
    shortHtml:
      "At 4.5mm this Taitexma <em>(tie-tex-ma)</em> machine is the perfect gauge for finer yarns and lighter weight knits.",
  },
  {
    name: "Taitexma TR-850 Standard Ribber",
    href: "https://vjzu11-86.myshopify.com/products/tr-850-taitexma-standard-ribber",
    imageSrc: "/images/machines/tr-850-ribber.jpg",
    priceLabel: "$1,399",
    specs: ["4.5 Standard Gauge", "200 needles"],
    shortHtml:
      "Expand your knitting machine's capabilities by making it easy to knit professional ribbing, cuffs, waistbands, collars, and a wide variety of textured stitch patterns.",
  },
] as const;

const title = "Knitting Machines for Sale | Knit it Now";
const description = salesHold
  ? "Purchase select Taitexma knitting machines and ribbers online through our Shopify store."
  : "Knitting machines currently available for purchase. Compare gauge and specs, then buy securely online.";

const machines = salesHold ? [] : getMachinesForSale();

function formatPrice(value: number | null): string | null {
  if (value == null) return null;
  return Number.isInteger(value)
    ? `$${value.toLocaleString("en-US")}`
    : `$${value.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
}
---

<Layout {title} {description}>
  <PageHead title="Knitting Machines for Sale" />

  <div class="machines-page">
    {/* === TEMPORARY MACHINE SALES HOLD (start) ===
        Shopify product cards below. Set MACHINE_SALES_HOLD = false to restore the full catalog. */}
    {salesHold ? (
      <>
        <header class="page-header">
          <a class="back-link" href="/shop">← Back to Shop</a>
          <h1 class="page-title">Knitting Machines for Sale</h1>
          <p class="page-intro">
            These Taitexma products are available to purchase now. Select
            <strong> View and Purchase</strong> to complete your order on our Shopify store.
          </p>
          <p class="page-intro page-intro--follow">
            Taitexma machines are available for customers in the United States only. Questions?
            <a href="/contact"> Contact Sue</a>.
          </p>
        </header>

        <div class="machines-grid machines-grid--temp">
          {
            TEMP_SHOPIFY_PRODUCTS.map((product) => (
              <article class="machine-card">
                <div class="machine-card-image-wrap">
                  <img
                    src={product.imageSrc}
                    alt={product.name}
                    class="machine-card-image"
                    width="280"
                    height="180"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="machine-card-body">
                  <h2 class="machine-name">{product.name}</h2>
                  <ul class="machine-specs" aria-label="Quick specs">
                    {product.specs.map((spec) => (
                      <li>{spec}</li>
                    ))}
                  </ul>
                  <div class="machine-short" set:html={product.shortHtml} />
                  <p class="machine-price">{product.priceLabel}</p>
                  <div class="machine-actions">
                    <a
                      href={product.href}
                      class="machine-buy"
                      rel="noopener"
                      target="_blank"
                    >
                      Buy Now
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </>
    ) : (
      <>
        {/* === ORIGINAL MACHINE CATALOG (preserved for restore) === */}
        <header class="page-header">
          <a class="back-link" href="/shop">← Back to Shop</a>
          <h1 class="page-title">Knitting Machines for Sale</h1>
          <p class="page-intro">
            These machines are currently available for purchase. Each card shows the
            key details—select <strong>View Details</strong> to learn more about a
            machine and its specs before you buy.
          </p>
        </header>

        <MachinesShopSubnav current="machines" />

        {machines.length === 0 ? (
          <p class="machines-empty">
            No machines are listed for sale right now. Please check back soon.
          </p>
        ) : (
          <div class="machines-grid">
            {machines.map((machine) => {
              const sale = machine.sale!;
              const imageSrc = primaryImageUrl(machine);
              const name = machineTitle(machine);
              const pitch = formatPitch(machine);
              const priceLabel = formatPrice(sale.price);
              const availLabel = availabilityLabel(sale);
              // Short blurb for the card.
              const shortHtml = sale.shortDescriptionHtml || null;
              return (
                <article class="machine-card">
                  <div class="machine-card-image-wrap">
                    {imageSrc ? (
                      <img
                        src={imageSrc}
                        alt={name}
                        class="machine-card-image"
                        width="280"
                        height="180"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="machine-card-image-placeholder" aria-hidden="true">
                        Image coming soon
                      </div>
                    )}
                    <span class={`machine-status machine-status--${sale.availabilityStatus}`}>{availLabel}</span>
                  </div>

                  <div class="machine-card-body">
                    <h2 class="machine-name">{name}</h2>

                    <ul class="machine-specs" aria-label="Quick specs">
                      <li>{machine.gauge}</li>
                      {pitch && <li>{pitch}</li>}
                      {machine.machineStyle && <li>{machine.machineStyle}</li>}
                    </ul>

                    {shortHtml && <div class="machine-short" set:html={shortHtml} />}

                    {priceLabel && <p class="machine-price">{priceLabel}</p>}

                    <div class="machine-actions">
                      <a href={`/shop/machines/${machine.slug}`} class="machine-details-link">
                        View Details
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        )}
        {/* === END ORIGINAL MACHINE CATALOG === */}
      </>
    )}
    {/* === TEMPORARY MACHINE SALES HOLD (end) === */}
  </div>
</Layout>

<style>
  .machines-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    font-weight: 600;
    color: var(--kbm-green);
    text-decoration: underline;
  }

  .back-link:hover {
    color: var(--kbm-green-hover, #445626);
  }

  .page-header {
    margin-bottom: 1.25rem;
  }

  .page-title {
    font-size: 1.75rem;
    color: var(--kbm-green);
    margin: 0 0 0.75rem;
  }

  .page-intro {
    font-size: 1.125rem;
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
  }

  .page-intro--follow {
    margin-top: 1rem;
  }

  .machines-hold-actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .machines-hold-secondary {
    font-weight: 600;
    color: var(--kbm-green);
    text-decoration: underline;
  }

  .machines-hold-secondary:hover {
    color: var(--kbm-green-hover, #445626);
  }

  .machines-empty {
    font-size: 1.05rem;
    color: #6b7b55;
    background: #fafbf9;
    border: 1px solid #e8ebe4;
    border-radius: 12px;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .machines-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .machines-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .machines-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .machines-grid--temp {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .machine-card {
    background: #fafbf9;
    border: 1px solid #e8ebe4;
    border-radius: 12px;
    padding: 0;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease;
  }

  .machine-card:hover {
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.1);
  }

  .machine-card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 280 / 180;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
    background: #eef3e6;
  }

  .machine-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .machine-card-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    color: #8a9a6e;
    background: #eef3e6;
  }

  .machine-status {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    color: #fff;
    background: #52682d;
  }

  .machine-status--available {
    background: #3f6212;
  }

  .machine-status--backorder {
    background: #b45309;
  }

  .machine-status--unavailable {
    background: #475569;
  }

  /* Legacy sale.status variants (kept for any older markup). */
  .machine-status--sold-out {
    background: #9a3412;
  }

  .machine-status--coming-soon {
    background: #b45309;
  }

  .machine-status--inquiry-only {
    background: #475569;
  }

  .machine-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem;
  }

  .machine-name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0;
  }

  .machine-specs {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .machine-specs li {
    font-size: 0.78rem;
    color: #52682d;
    background: #f0f4e7;
    border: 1px solid #dbe6c5;
    border-radius: 6px;
    padding: 0.15rem 0.5rem;
  }

  .machine-short {
    font-size: 0.95rem;
    color: #5a6b47;
    line-height: 1.55;
    margin: 1rem 0 0;
  }

  .machine-price {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--kbm-green);
    margin: 1rem 0 0;
  }

  .machine-actions {
    padding-top: 1.25rem;
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
  }

  .machine-details-link {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    background: var(--kbm-green);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .machine-details-link:hover {
    background: var(--kbm-green-hover, #445626);
    color: #ffffff;
  }

  .machine-buy {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    background: var(--kbm-green);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .machine-buy:hover {
    background: var(--kbm-green-hover, #445626);
  }

  .machine-status-note {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: #6b7b55;
  }

  .machine-contact {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    background: #ffffff;
    color: var(--kbm-green);
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid var(--kbm-green);
    border-radius: 8px;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .machine-contact:hover {
    background: var(--kbm-green);
    color: #ffffff;
  }
</style>
