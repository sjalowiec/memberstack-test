---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import { loadLegacyEbookStorefrontProducts } from "../../lib/legacy/legacyEbooksActive";
import { plainTextFromLegacyEbookBrief } from "../../lib/legacy/legacyEbookPlainText";

const title = "eBooks | Knit it Now";
const description =
  "Downloadable machine knitting eBooks — techniques, patterns, and reference from experienced teachers.";

const products = loadLegacyEbookStorefrontProducts();

function formatPrice(amount: number): string {
  return amount.toLocaleString("en-US", { style: "currency", currency: "USD" });
}

/** Legacy store cover image path. */
function legacyStoreThumbnailPath(filename: string): string {
  if (
    filename.startsWith("/") ||
    filename.startsWith("http://") ||
    filename.startsWith("https://")
  ) {
    return filename;
  }
  return `/store/thumbnails/${filename}`;
}
---

<Layout {title} {description}>
  <div class="ebooks-page">
    <PageHead title="Machine Knitting eBooks" />

    <div class="ebooks-intro">
      <p>
        Browse our collection of downloadable machine knitting eBooks. Each title
        is a digital PDF you can save and use on your computer or tablet while you
        knit.
      </p>
      <p>
        You will find practical techniques, classic patterns, and reference material
        from teachers and designers who have shared their expertise with machine
        knitters for decades.
      </p>
    </div>

    <p class="ebooks-count" aria-live="polite">
      {products.length} titles available
    </p>

    <div class="ebooks-grid">
      {products.map((product) => (
        <article class="ebook-store-card">
          <div class="ebook-store-card__media">
            <img
              src={legacyStoreThumbnailPath(product.thumbnail)}
              alt={product.title}
              class="ebook-store-card__thumb"
              loading="lazy"
              width="160"
              height="210"
            />
            {product.subscriberFree && (
              <span class="ebook-store-badge">Subscriber free</span>
            )}
          </div>

          <div class="ebook-store-card__body">
            <h2 class="ebook-store-card__title">{product.title}</h2>
            <p class="ebook-store-card__price">{formatPrice(product.sellPrice)}</p>
            {product.shortDescription && (
              <p class="ebook-store-card__desc">
                {plainTextFromLegacyEbookBrief(product.shortDescription)}
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<style>
  .ebooks-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem 4rem;
  }

  .ebooks-intro {
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .ebooks-intro p {
    line-height: 1.6;
    margin: 0 0 0.75rem;
    color: #444;
  }

  .ebooks-count {
    font-size: 0.95rem;
    color: #5a6b47;
    margin: 0 0 1.5rem;
  }

  .ebooks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .ebook-store-card {
    display: flex;
    flex-direction: column;
    background: #fafbf9;
    border: 1px solid #e8ebe4;
    border-radius: 12px;
    overflow: hidden;
    height: 100%;
  }

  .ebook-store-card__media {
    position: relative;
    background: #fff;
    border-bottom: 1px solid #e8ebe4;
    display: flex;
    justify-content: center;
    padding: 1rem 1rem 0.75rem;
  }

  .ebook-store-card__thumb {
    width: 140px;
    height: auto;
    max-height: 200px;
    object-fit: contain;
    border-radius: 4px;
  }

  .ebook-store-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #52682d;
    background: #eef3e6;
    border: 1px solid #d7e2c8;
    padding: 4px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .ebook-store-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1rem 1.25rem 1.25rem;
  }

  .ebook-store-card__title {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--kbm-green, #52682d);
  }

  .ebook-store-card__price {
    margin: 0 0 0.65rem;
    font-weight: 700;
    font-size: 1.05rem;
    color: #333;
  }

  .ebook-store-card__desc {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: #555;
    flex: 1;
  }

  @media (min-width: 640px) {
    .ebooks-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .ebooks-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
