---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import { plainTextFromLegacyEbookBrief } from "../../lib/legacy/legacyEbookPlainText";
import { loadLegacyEbookStorefrontWithSlugs } from "../../lib/legacy/legacyEbookSlug";
import {
  formatLegacyEbookPrice,
  legacyStoreThumbnailPath,
  SHOW_LEGACY_EBOOK_MEMBER_FREE_BADGE,
} from "../../lib/legacy/legacyEbookStorefrontUi";

const title = "eBooks | Knit it Now";
const description =
  "Downloadable machine knitting eBooks — techniques, patterns, and reference from experienced teachers.";

const products = loadLegacyEbookStorefrontWithSlugs();
---

<Layout {title} {description}>
  <div class="ebooks-page">
    <a class="back-link back-to-shop-link" id="back-to-shop" href="/shop">← Back to Shop</a>
    <PageHead title="Machine Knitting eBooks" />

    <div class="ebooks-intro">
      <p>
        Browse our collection of downloadable machine knitting eBooks. Each title
        is a digital PDF you can save and use on your computer or tablet while you
        knit.
      </p>
      <p>
        You will find practical techniques, classic patterns, and reference material
        from teachers and designers who have shared their expertise with machine
        knitters for decades.
      </p>
    </div>

    <p class="ebooks-count" aria-live="polite">
      {products.length} titles available
    </p>

    <div class="ebooks-grid">
      {products.map((product) => {
        const detailHref = `/shop/ebooks/${product.slug}`;
        return (
        <article class="ebook-store-card">
          <div class="ebook-store-card__media">
            <a href={detailHref} class="ebook-store-card__thumb-link">
              <img
                src={legacyStoreThumbnailPath(product.thumbnail)}
                alt={product.title}
                class="ebook-store-card__thumb"
                loading="lazy"
                width="160"
                height="210"
              />
            </a>
            {/* Member Free badge hidden until Memberstack entitlement flow is implemented. */}
            {SHOW_LEGACY_EBOOK_MEMBER_FREE_BADGE && product.subscriberFree && (
              <span class="ebook-store-badge">Member Free</span>
            )}
          </div>

          <div class="ebook-store-card__body">
            <h2 class="ebook-store-card__title">{product.title}</h2>
            <p class="ebook-store-card__price">
              {formatLegacyEbookPrice(product.sellPrice)}
            </p>
            {product.shortDescription && (
              <p class="ebook-store-card__desc">
                {plainTextFromLegacyEbookBrief(product.shortDescription)}
              </p>
            )}
            <div class="ebook-store-card__actions">
              <a href={detailHref} class="ebook-store-card__cta">
                Learn More
              </a>
            </div>
          </div>
        </article>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  .back-link {
    display: inline-block;
    color: var(--kbm-green);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .back-link:hover {
    color: #3d4e21;
    text-decoration: underline;
  }

  .back-to-shop-link {
    margin-bottom: 1rem;
  }

  .ebooks-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem 4rem;
  }

  .ebooks-intro {
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .ebooks-intro p {
    line-height: 1.6;
    margin: 0 0 0.75rem;
    color: #444;
  }

  .ebooks-count {
    font-size: 0.95rem;
    color: #5a6b47;
    margin: 0 0 1.5rem;
  }

  .ebooks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .ebook-store-card {
    display: flex;
    flex-direction: column;
    background: #fafbf9;
    border: 1px solid #e8ebe4;
    border-radius: 12px;
    overflow: hidden;
    height: 100%;
  }

  .ebook-store-card__media {
    position: relative;
    background: #fff;
    border-bottom: 1px solid #e8ebe4;
    display: flex;
    justify-content: center;
    padding: 1rem 1rem 0.75rem;
  }

  .ebook-store-card__thumb-link {
    display: block;
    line-height: 0;
    border-radius: 4px;
  }

  .ebook-store-card__thumb {
    width: 140px;
    height: auto;
    max-height: 200px;
    object-fit: contain;
    border-radius: 4px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .ebook-store-card__thumb-link:hover .ebook-store-card__thumb,
  .ebook-store-card__thumb-link:focus-visible .ebook-store-card__thumb {
    transform: scale(1.04);
    opacity: 0.88;
  }

  .ebook-store-card__thumb-link:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 3px;
  }

  .ebook-store-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #52682d;
    background: #eef3e6;
    border: 1px solid #d7e2c8;
    padding: 4px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .ebook-store-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1rem 1.25rem 1.25rem;
  }

  .ebook-store-card__title {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--kbm-green, #52682d);
  }

  .ebook-store-card__price {
    margin: 0 0 0.65rem;
    font-weight: 700;
    font-size: 1.05rem;
    color: #333;
  }

  .ebook-store-card__desc {
    margin: 0 0 0.85rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: #555;
    flex: 1;
  }

  .ebook-store-card__actions {
    display: flex;
    justify-content: center;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .ebook-store-card__cta {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    background: var(--kbm-green, #52682d);
    border-radius: 8px;
    text-decoration: none;
    text-align: center;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .ebook-store-card__cta:hover {
    background: #445626;
    color: #fff;
    transform: translateY(-1px);
  }

  .ebook-store-card__cta:focus-visible {
    outline: 2px solid #445626;
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    .ebooks-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .ebooks-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
