---
/**
 * Dynamic machine detail page for the shop.
 * Data: canonical catalog at data/machines.json (via referenceCatalog).
 * Only machines listed for sale (sale.forSale === true) get a detail page.
 * URL: /shop/machines/[slug] (brand-model slug, e.g. /shop/machines/brother-kh864).
 */
export const prerender = true;

import Layout from "../../../layouts/Layout.astro";
import {
  getMachinesForSale,
  getMachineBySlug,
  primaryImageUrl,
  machineImageUrl,
  machineTitle,
  formatPitch,
  type Machine,
} from "../../../lib/machines/referenceCatalog";
import { availabilityLabel, canCheckout } from "../../../lib/machines/machineAdminFields";

const CONTACT_HREF = "/contact";

export function getStaticPaths() {
  return getMachinesForSale().map((machine) => ({
    params: { slug: machine.slug },
    props: { machine },
  }));
}

const { machine } = Astro.props as { machine: Machine };

// Defensive: only for-sale machines should reach here; send strays back.
const resolved = machine ?? getMachineBySlug(Astro.params.slug);
if (!resolved || resolved.sale?.forSale !== true) {
  return Astro.redirect("/shop/machines");
}

const sale = resolved.sale;
const name = machineTitle(resolved);
const title = `${name} | Knit it Now`;
// Meta description: derive plain text from the short HTML blurb, else a generic line.
const metaFromShort = sale.shortDescriptionHtml
  ? sale.shortDescriptionHtml.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim()
  : "";
const description =
  metaFromShort || `${name} – knitting machine details and purchase information.`;

const heroImage = primaryImageUrl(resolved);
const gallery = resolved.images
  .map((img) => machineImageUrl(img.url))
  .filter((url): url is string => !!url);
const extraImages = gallery.filter((url) => url !== heroImage);

const pitch = formatPitch(resolved);
const availLabel = availabilityLabel(sale);
const canBuy = canCheckout(sale);
// Detail copy: prefer long HTML, else fall back to the short HTML.
const longHtml = sale.longDescriptionHtml || sale.shortDescriptionHtml || null;

/** Minimal HTML-escape for text injected into the trusted description markup. */
function escapeHtml(value: string): string {
  return value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

/** Capitalize the first letter of each word, leaving model tokens intact. */
function titleCaseAccessory(value: string): string {
  return value
    .split(/\s+/)
    .map((word) => (word ? word.charAt(0).toUpperCase() + word.slice(1) : word))
    .join(" ");
}

/**
 * Build a fully-qualified accessory name for the coming-soon `item` query.
 * If the raw text already names a specific model (contains a digit, e.g.
 * "SRP60N ribber"), prefix the brand only. Otherwise it's a generic type
 * (e.g. "Lace Carriage"), so also include the machine model for context.
 *  - "Lace Carriage"  -> "Silver Reed SK280 Lace Carriage"
 *  - "SRP60N ribber"  -> "Silver Reed SRP60N Ribber"
 */
function accessoryItemName(raw: string, brand: string, model: string): string {
  const label = titleCaseAccessory(raw);
  const hasModelToken = /\d/.test(raw);
  const parts = hasModelToken ? [brand, label] : [brand, model, label];
  return parts.filter(Boolean).join(" ").trim();
}

const COMING_SOON_BASE = "/shop/accessories/coming-soon";

/**
 * Presentation-only normalization of the trusted description HTML into a
 * consistent accessory layout, without touching the stored sales copy:
 *
 *  1. Drop the "If you decide to expand later..." paragraph so accessory
 *     interest lives only in the Compatible Accessories list, not the body copy.
 *  2. After "Key Features", show a "Compatible Accessories" heading followed by
 *     a bulleted list of coming-soon links (no introductory paragraph).
 *  3. New-format data already authors that section as markup; legacy plain-text
 *     descriptions have it rebuilt from their "Expand ... with ..." prose.
 *  4. Never render an empty "Compatible Accessories" heading (no list).
 *  5. The Warranty link stays where the copy places it (after accessories, or
 *     after Key Features when there are none).
 *
 * Non-matching descriptions pass through unchanged.
 */
function enhanceDescriptionHtml(raw: string, brand: string, model: string): string {
  let html = raw;

  // 1. Remove the "If you decide to expand later..." paragraph (marked-up or plain).
  html = html.replace(/<p[^>]*>\s*If you decide to expand later[\s\S]*?<\/p>\s*/gi, "");
  html = html.replace(/(?:<br\s*\/?>\s*)*\s*If you decide to expand later[^<\n]*/gi, "");

  // Legacy plain-text descriptions: lift accessory mentions out of the prose so
  // they can be rebuilt as links. New-format data uses markup and matches none.
  const accessoryItems: string[] = [];
  const accessoryRe =
    /Expand(?:\s+the\s+possibilities)?(?:\s+MORE)?(?:\s+even\s+further)?\s+with\s+(?:an?|the)\s+([^\n<.]+)/gi;
  let match: RegExpExecArray | null;
  while ((match = accessoryRe.exec(html)) !== null) {
    const item = match[1]
      .trim()
      .replace(/\s+attachment$/i, "")
      .replace(/[.\s]+$/, "");
    if (item) accessoryItems.push(item);
  }
  if (accessoryItems.length) {
    html = html.replace(
      /(?:<br\s*\/?>\s*)*Expand(?:\s+the\s+possibilities)?(?:\s+MORE)?(?:\s+even\s+further)?\s+with\s+(?:an?|the)\s+[^\n<]+/gi,
      ""
    );
  }

  // Legacy "Key Features:" text label -> heading (new-format data uses <h3>).
  html = html.replace(
    /(?:<br\s*\/?>\s*)*\s*Key Features\s*:/i,
    '<h3 class="machine-subhead">Key Features</h3>'
  );

  // Rebuild the Compatible Accessories section (heading + list only, no intro)
  // for legacy descriptions, placed just after the Key Features list.
  if (accessoryItems.length) {
    const items = accessoryItems
      .map((a) => {
        const itemName = accessoryItemName(a, brand, model);
        const href = `${COMING_SOON_BASE}?item=${encodeURIComponent(itemName)}`;
        return `<li><a href="${href}">${escapeHtml(itemName)}</a></li>`;
      })
      .join("");
    const section =
      '<h3 class="machine-subhead">Compatible Accessories</h3>' + `<ul>${items}</ul>`;
    html = html.includes("</ul>") ? html.replace("</ul>", "</ul>" + section) : html + section;
  }

  // 4. Drop a "Compatible Accessories" heading that has no list following it.
  html = html.replace(
    /<h[1-6][^>]*>\s*Compatible Accessories\s*<\/h[1-6]>\s*(?!\s*<ul)/i,
    ""
  );

  return html;
}

const longHtmlDisplay = longHtml
  ? enhanceDescriptionHtml(longHtml, resolved.brand, resolved.model)
  : null;

function formatPrice(value: number | null): string | null {
  if (value == null) return null;
  return Number.isInteger(value)
    ? `$${value.toLocaleString("en-US")}`
    : `$${value.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
}
const priceLabel = formatPrice(sale.price);
---

<Layout {title} {description}>
  <div class="machine-detail-page">
    <h1 class="machine-name">{name}</h1>

    <nav class="machine-breadcrumb" aria-label="Breadcrumb">
      <a href="/shop/machines" class="back-link">← Back to Machines</a>
    </nav>

    <header class="machine-header">
      <p class="machine-meta">
        <span class={`machine-status machine-status--${sale.availabilityStatus}`}>{availLabel}</span>
      </p>

      <ul class="machine-specs" aria-label="Quick specs">
        <li>{resolved.gauge}</li>
        {pitch && <li>{pitch}</li>}
        {resolved.machineStyle && <li>{resolved.machineStyle}</li>}
        {resolved.bed && <li>{resolved.bed} bed</li>}
        {resolved.needleCount && <li>{resolved.needleCount} needles</li>}
      </ul>
    </header>

    <section class="machine-purchase" aria-label="Purchase">
      <div class="machine-purchase-main">
        {priceLabel && <p class="machine-price">{priceLabel}</p>}
        <div class="machine-buy-row">
          {canBuy ? (
            <a href={sale.stripePaymentLink!} class="machine-buy" rel="noopener">
              Buy Now
            </a>
          ) : (
            <a href={CONTACT_HREF} class="machine-contact">
              Contact Us About Availability
            </a>
          )}
        </div>
      </div>
      {sale.shippingNotes && <div class="machine-shipping" set:html={sale.shippingNotes} />}
    </section>

    {(longHtml || heroImage) && (
      <section class="machine-body">
        {heroImage && (
          <figure class="machine-figure">
            <img
              src={heroImage}
              alt={name}
              class="machine-hero-image"
              width="400"
              height="260"
            />
          </figure>
        )}
        {longHtmlDisplay && <div class="machine-long" set:html={longHtmlDisplay} />}
      </section>
    )}

    {resolved.notes && (
      <section class="machine-section">
        <h2 class="section-title">About This Machine</h2>
        <p class="machine-intro-text">{resolved.notes}</p>
      </section>
    )}

    {extraImages.length > 0 && (
      <section class="machine-section">
        <h2 class="section-title">More Photos</h2>
        <div class="machine-gallery">
          {extraImages.map((url) => (
            <img src={url} alt={`${name} photo`} class="machine-gallery-img" loading="lazy" />
          ))}
        </div>
      </section>
    )}

    <section class="machine-section machine-cta">
      <a href="/shop/machines" class="cta-secondary">← Back to Machines</a>
    </section>
  </div>
</Layout>

<style>
  .machine-detail-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 0.5rem 1rem 4rem;
  }

  .machine-breadcrumb {
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .back-link {
    font-weight: 600;
    color: var(--kbm-green);
    text-decoration: underline;
  }

  .back-link:hover {
    color: var(--kbm-green-hover, #445626);
  }

  .breadcrumb-sep {
    color: #8a9a6e;
  }

  .breadcrumb-current {
    color: #5a6b47;
  }

  .machine-header {
    margin-bottom: 0.75rem;
  }

  .machine-name {
    font-size: var(--text-xxl);
    line-height: 1.2;
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.5rem 0;
  }

  .machine-meta {
    margin: 0 0 0.75rem 0;
  }

  .machine-status {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    color: #fff;
    background: #52682d;
  }

  .machine-status--available {
    background: #3f6212;
  }

  .machine-status--backorder {
    background: #b45309;
  }

  .machine-status--unavailable {
    background: #475569;
  }

  /* Legacy sale.status variants (kept for any older markup). */
  .machine-status--sold-out {
    background: #9a3412;
  }

  .machine-status--coming-soon {
    background: #b45309;
  }

  .machine-status--inquiry-only {
    background: #475569;
  }

  .machine-short {
    font-size: 1.05rem;
    color: #5a6b47;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .machine-long {
    font-size: 1.05rem;
    color: #5a6b47;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .machine-long :first-child {
    margin-top: 0;
  }

  .machine-long :last-child {
    margin-bottom: 0;
  }

  .machine-long a {
    color: var(--kbm-green);
    text-decoration: underline;
  }

  .machine-long ul,
  .machine-long ol {
    padding-left: 1.25rem;
    margin: 0.5rem 0;
  }

  /* Subsection headings in the description (Key Features, Compatible
     Accessories, etc.) — authored as <h3> or injected as .machine-subhead. */
  .machine-long :global(h3),
  .machine-long :global(.machine-subhead) {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--kbm-green);
    line-height: 1.3;
    margin: 1.75rem 0 0.6rem;
  }

  .machine-long :global(h3:first-child),
  .machine-long :global(.machine-subhead:first-child) {
    margin-top: 0;
  }

  .machine-specs {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .machine-specs li {
    font-size: 0.82rem;
    color: #52682d;
    background: #f0f4e7;
    border: 1px solid #dbe6c5;
    border-radius: 6px;
    padding: 0.2rem 0.55rem;
  }

  /* Purchase panel: sized to its content (price + Buy), not a full-width banner. */
  .machine-purchase {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
    width: fit-content;
    max-width: 100%;
    padding: 0.85rem 1.15rem;
    margin-bottom: 1.25rem;
    background: #f7faf0;
    border: 1px solid #dbe6c5;
    border-radius: 12px;
  }

  .machine-purchase-main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  /* Shipping note drops onto its own line so the panel stays compact. */
  .machine-purchase .machine-shipping {
    flex-basis: 100%;
  }

  .machine-price {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--kbm-green);
    margin: 0;
  }

  .machine-buy-row {
    margin: 0;
  }

  .machine-buy {
    display: inline-block;
    padding: 0.7rem 1.75rem;
    background: var(--kbm-green);
    color: #ffffff;
    font-weight: 600;
    font-size: 1rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .machine-buy:hover {
    background: var(--kbm-green-hover, #445626);
  }

  .machine-status-note {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 600;
    color: #6b7b55;
  }

  .machine-contact {
    display: inline-block;
    padding: 0.7rem 1.75rem;
    background: #ffffff;
    color: var(--kbm-green);
    font-weight: 600;
    font-size: 1rem;
    border: 1px solid var(--kbm-green);
    border-radius: 8px;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .machine-contact:hover {
    background: var(--kbm-green);
    color: #ffffff;
  }

  .machine-shipping {
    font-size: 0.9rem;
    color: #6b7b55;
    line-height: 1.55;
    margin: 0;
  }

  /* Description body: image works with the copy (floats on desktop). */
  .machine-body {
    margin-bottom: 2rem;
  }

  .machine-body::after {
    content: "";
    display: block;
    clear: both;
  }

  .machine-figure {
    margin: 0 0 1.25rem;
    width: 100%;
    aspect-ratio: 400 / 260;
    overflow: hidden;
    border-radius: 12px;
    background: #eef3e6;
  }

  @media (min-width: 640px) {
    .machine-figure {
      float: right;
      width: 384px;
      max-width: 45%;
      /* Top aligned with the first line of the description copy. */
      margin: 0 0 1rem 1.75rem;
    }
  }

  .machine-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .machine-section {
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.75rem 0;
  }

  .machine-intro-text {
    font-size: 1rem;
    color: #5a6b47;
    line-height: 1.7;
    margin: 0;
  }

  .machine-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.75rem;
  }

  .machine-gallery-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    background: #eef3e6;
  }

  .machine-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e8ebe4;
  }

  .cta-secondary {
    font-weight: 600;
    color: var(--kbm-green);
    text-decoration: underline;
  }

  .cta-secondary:hover {
    color: var(--kbm-green-hover, #445626);
  }
</style>
