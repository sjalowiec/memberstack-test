---
import Layout from "../../../layouts/Layout.astro";
import PageHead from "../../../components/PageHead.astro";
import { requireAdminForRequest } from "../../../lib/admin/requireAdminRequest";
import { sanitizeLegacyEbookDescriptionHtml } from "../../../lib/legacy/legacyEbookDescriptionHtml";
import { cableImageUrl } from "../../../lib/shop/storeItemCatalog";
import { loadPublicCables, STORE_CATALOG_CACHE_CONTROL } from "../../../lib/shop/storeItemPublicCatalog";

export const prerender = false;

Astro.response.headers.set("Cache-Control", STORE_CATALOG_CACHE_CONTROL);

const cables = await loadPublicCables(Astro.url.hostname);
const idParam = Astro.params.id;
const cable = cables.find((item) => String(item.id) === String(idParam));

if (!cable) {
  return new Response("Not found", { status: 404 });
}

const visible = cable.active === true || String(cable.active).toUpperCase() === "TRUE";
if (!visible) {
  const auth = await requireAdminForRequest(Astro.request, Astro.cookies);
  if (!auth.ok) return new Response("Not found", { status: 404 });
}

const title = `${cable.name} | Knit by Machine`;
const description =
  cable.shortdescription || `Purchase ${cable.name} for your knitting machine.`;

function formatPrice(price: number): string {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    minimumFractionDigits: price % 1 === 0 ? 0 : 2,
  }).format(price);
}
---

<Layout {title} {description}>
  <PageHead title={cable.name} />

  <div class="cable-detail-page">
    <a class="back-link back-to-shop-link" id="back-to-shop" href="/shop">← Back to Shop</a>
    <p class="back-link"> <a href="/shop/cables">Back to Cables</a> </p>

    <div class="cable-detail-layout">
      <div class="cable-detail-image-wrap">
        <img
          src={cableImageUrl(cable.thumbnail) ?? ""}
          alt={cable.name}
          class="cable-detail-thumbnail"
          width="400"
          height="260"
        />
      </div>

      <div class="cable-detail-content">
        <h1 class="cable-detail-name">{cable.name}</h1>
        {!visible && (
          <p class="cable-hidden-preview" role="status">
            Hidden preview. Visitors do not see this item until Show on the shop is saved.
          </p>
        )}
        <p class="cable-detail-price">{formatPrice(cable.price)}</p>
        <!--<p class="cable-detail-short">{cable.shortdescription}</p>-->
        <div class="cable-detail-long" set:html={sanitizeLegacyEbookDescriptionHtml(cable.longDescription)} />
        {cable.stripeLink?.startsWith("https://") && (
          <a
            href={cable.stripeLink}
            class="cable-btn-buy kbm-cta-guide"
            target="_blank"
            rel="noopener noreferrer"
          >
            Buy Now
          </a>
        )}
      </div>
    </div>
  </div>
</Layout>

<style>
  .cable-detail-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--kbm-green);
    text-decoration: underline;
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--kbm-green-hover, #445626);
  }

  .back-to-shop-link {
    display: block;
    margin-bottom: 0.5rem;
  }

  .cable-detail-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 640px) {
    .cable-detail-layout {
      grid-template-columns: 320px 1fr;
    }
  }

  .cable-detail-image-wrap {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 400 / 260;
    overflow: hidden;
    border-radius: 12px;
    background: #eef3e6;
  }

  .cable-detail-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cable-detail-name {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.5rem 0;
  }

  .cable-hidden-preview {
    margin: 0 0 1rem;
    padding: 0.6rem 0.8rem;
    background: #fff6d8;
    border: 1px solid #e2c56a;
    border-radius: 6px;
  }

  .cable-detail-price {
    font-size: 1.25rem;
    font-weight: 700;
    color: #2d3a1f;
    margin: 0 0 1rem 0;
  }

  .cable-detail-short {
    font-size: 1.05rem;
    color: #5a6b47;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
  }

  .cable-detail-long {
    font-size: 1rem;
    color: #5a6b47;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    white-space: pre-line;
  }

  .cable-detail-long :global(p) {
    margin: 0 0 1rem;
    white-space: normal;
  }

  .cable-detail-long :global(.cable-compare) {
    overflow-x: auto;
    margin: 0 0 1rem;
    max-width: 100%;
    white-space: normal;
    -webkit-overflow-scrolling: touch;
  }

  .cable-detail-long :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1rem;
    white-space: normal;
  }

  .cable-detail-long :global(.cable-compare table) {
    margin: 0;
    min-width: 22rem;
  }

  .cable-detail-long :global(th),
  .cable-detail-long :global(td) {
    border: 1px solid #c5d0b8;
    padding: 0.55rem 0.7rem;
    text-align: left;
    vertical-align: top;
    white-space: normal;
  }

  .cable-detail-long :global(th) {
    background: #eef3e6;
    color: #2d3a1f;
    font-weight: 600;
  }

  .cable-btn-buy {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--kbm-green);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .cable-btn-buy:hover {
    background: var(--kbm-green-hover, #445626);
  }
</style>
