---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import VimeoModal from "../../components/VimeoModal.astro";
import { printables } from "../../data/printables";

export async function getStaticPaths() {
  return printables.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = printables.find((p) => p.slug === slug);

if (!product) {
  throw new Error("Printable not found");
}

const previewMember = Astro.url.searchParams.get("previewMember");
const previewMode =
  previewMember === "member"
    ? "memberAccess"
    : previewMember === "nonmember"
      ? "loggedOut"
      : null;

const pageTitle = `${product.title} | Knit it Now`;
const pageDescription = product.description;
const productImg = product.productImage?.value || product.image;
const downloadLabel = "Download Your Printable";
---

<Layout title={pageTitle} description={pageDescription}>
  <PageHead title={pageTitle} hideTitle />
  <section class="printable-details">
    <div class="printable-details__inner">
      <p class="printable-details__back">
        <a href="/shop/downloads">← Back to Printable Tools</a>
      </p>

      <div class="product-hero">
        <div class="product-copy">
          <h1 class="printable-details__title">{product.title}</h1>

          <p class="printable-details__intro">{product.description}</p>
          {product.salesFocus && (
            <p class="printable-details__focus">{product.salesFocus}</p>
          )}

          {product.media && product.media.type === "vimeo" && (
            <VimeoModal value={product.media.value} />
          )}

          <div class="printable-details__section">
            <h2>What's Included</h2>
            <ul>
              {product.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <div
            class="printable-details__actions"
            data-printable-product-actions
            data-member-free={product.memberFree ? "true" : "false"}
            data-preview-mode={previewMode ?? ""}
            data-download-href={product.file}
            data-download-label={downloadLabel}
            data-stripe-link={product.stripeLink}
          >
            {product.memberFree ? (
              <div
                class="printable-details__member-download"
                data-printable-download
                data-download-href={product.file}
                data-download-label={downloadLabel}
              >
                <div
                  class="printable-download-card__cta-mount"
                  data-printable-download-cta
                  aria-live="polite"
                ></div>
              </div>
            ) : null}

            <a
              href={product.stripeLink}
              class="kbm-btn kbm-btn-accent printable-details__buy"
              target="_blank"
              rel="noopener noreferrer"
              data-buy-now
            >
              Buy Now
            </a>
          </div>
        </div>

        {productImg && (
          <div class="product-media">
            <img
              src={productImg}
              alt={`${product.title} preview`}
              class="product-media__image"
              loading="lazy"
            />
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
  import type { ViewerAccessState } from "../../lib/memberAccess";
  import {
    renderPrintableDownloadCta,
    resolvePrintableDownloadViewerState,
  } from "../../scripts/printableDownloadGate";

  function previewOverride(): ViewerAccessState | null {
    const root = document.querySelector<HTMLElement>("[data-printable-product-actions]");
    const mode = root?.dataset.previewMode?.trim() ?? "";
    if (mode === "memberAccess" || mode === "loggedOut" || mode === "loggedInNoAccess") {
      return mode;
    }
    return null;
  }

  async function refreshProductActions(): Promise<void> {
    const root = document.querySelector<HTMLElement>("[data-printable-product-actions]");
    if (!root) return;

    const memberFree = root.dataset.memberFree === "true";
    const buy = root.querySelector<HTMLElement>("[data-buy-now]");
    const mount = root.querySelector<HTMLElement>("[data-printable-download-cta]");
    const downloadHref = root.dataset.downloadHref?.trim() ?? "";
    const downloadLabel = root.dataset.downloadLabel?.trim() || "Download Your Printable";

    const state =
      previewOverride() ??
      (await resolvePrintableDownloadViewerState("downloads/[slug].printableProduct"));

    if (memberFree && mount) {
      renderPrintableDownloadCta(mount, state, downloadHref, downloadLabel);
    }

    if (buy) {
      // Active Members with memberFree get the included download; keep Buy Now for everyone else.
      buy.hidden = memberFree && state === "memberAccess";
    }
  }

  function bindRefresh(): void {
    void refreshProductActions();
    window.addEventListener("auth:updated", () => {
      void refreshProductActions();
    });
    const ms = window.$memberstackDom;
    if (ms?.on) {
      ms.on("member.login", () => {
        void refreshProductActions();
      });
      ms.on("member.logout", () => {
        void refreshProductActions();
      });
    }
    void ms?.onReady?.then(() => {
      void refreshProductActions();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bindRefresh);
  } else {
    bindRefresh();
  }
</script>

<style>
  .printable-details {
    padding: 2rem 1rem 4rem;
  }

  .printable-details__inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .product-hero {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr;
    gap: 2rem;
    align-items: start;
    margin-top: 0.5rem;
  }

  .product-copy {
    min-width: 0;
  }

  .product-media {
    position: sticky;
    top: 1rem;
    text-align: center;
  }

  .product-media__image {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
    border-radius: 12px;
  }

  @media (max-width: 768px) {
    .product-hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .product-media {
      position: static;
      order: 2;
    }

    .product-copy {
      order: 1;
    }
  }

  .printable-details__back {
    margin-bottom: 1rem;
  }

  .printable-details__back a {
    text-decoration: none;
  }

  .printable-details__title {
    margin-bottom: 1.5rem;
  }

  .printable-details__intro,
  .printable-details__focus {
    margin-bottom: 1rem;
  }

  .printable-details__section {
    margin: 2rem 0;
  }

  .printable-details__actions {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    text-align: center;
  }

  .printable-details__member-download :global(.printable-download-card__cta-mount) {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.65rem;
  }

  .printable-details__member-download :global(.printable-download-card__cta),
  .printable-details__buy {
    display: inline-block;
    text-align: center;
    text-decoration: none;
  }

  .printable-details__member-download :global(.printable-download-card__locked-status),
  .printable-details__member-download :global(.printable-download-card__locked-support) {
    margin: 0 0 0.5rem;
    text-align: left;
    color: #4d5a48;
    line-height: 1.5;
  }

  .printable-details__member-download :global(.printable-download-card__locked-status) {
    font-weight: 600;
  }
</style>
