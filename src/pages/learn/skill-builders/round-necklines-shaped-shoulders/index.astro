---
import Layout from "../../../../layouts/Layout.astro";
import RoundNecklineSkillBuilderLanding from "../../../../components/skill-builders/RoundNecklineSkillBuilderLanding.astro";
import { ROUND_NECKLINE_SKILL_BUILDERS } from "../../../../lib/skillBuilders/roundNecklineSkillBuilders";

export const prerender = true;

const builder = ROUND_NECKLINE_SKILL_BUILDERS["round-necklines-shaped-shoulders"];
---

<Layout
  title={`${builder.title} | Skill Builders | Knit it Now`}
  description={builder.purpose}
  bodyClass="page--tight-header"
>
  <RoundNecklineSkillBuilderLanding builderId="round-necklines-shaped-shoulders" />
</Layout>
