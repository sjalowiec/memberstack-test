---
import Layout from "../../layouts/Layout.astro";
import SkillBuilderPageHeader from "../../components/skill-builders/SkillBuilderPageHeader.astro";

const pageTitle = "Skill Builders | Knit it Now";
const pageDescription =
  "Practice one machine-knitting skill at a time. Short, focused exercises help you build confidence before you use the skill in a project.";

type CatalogItem = {
  title: string;
  href: string;
  subtitle?: string;
};

const freeSkillBuilder: CatalogItem = {
  title: "Round Neckline Basics: Bind Off & Decrease",
  href: "/learn/skill-builders/round-neckline-basics",
  subtitle: "Practice shaping a round neckline with straight shoulders.",
};

const memberSkillBuilders: CatalogItem[] = [
  {
    title: "Round Necklines with Shaped Shoulders",
    href: "/learn/skill-builders/round-necklines-shaped-shoulders",
    subtitle: "Practice shaping a round neckline with shaped shoulders.",
  },
  {
    title: "Join Beautiful Shoulder Seams",
    href: "/learn/skill-builders/join-beautiful-shoulder-seams",
    subtitle: "Rehang live front and back shoulder stitches and bind them off together.",
  },
  {
    title: "E-Wrap Cast On Basics",
    href: "/learn/skill-builders/e-wrap-cast-on-basics",
    subtitle: "Practice a quick, stretchy cast on that works on any knitting machine.",
  },
];

const allAvailableSkillBuilders: CatalogItem[] = [freeSkillBuilder, ...memberSkillBuilders];

const comingSoonItems = [
  "Short Rows Practice",
  "Sleeve Cap Practice",
  "Ribber Practice",
  "Cut & Sew Practice",
];
---

<Layout title={pageTitle} description={pageDescription} bodyClass="page--tight-header">
  <div class="skill-builders-page">
    <header class="skill-builders-hero">
      <p class="skill-builders-hero__signature">
        Don’t practice until you get it right. Practice until you can’t get it wrong.
      </p>
      <SkillBuilderPageHeader title="Skill Builders" />
      <p class="skill-builders-hero__subtitle">
        Practice one machine-knitting skill at a time.
      </p>
      <p class="skill-builders-hero__copy">
        Short, focused exercises help you build confidence before you use the skill in a project.
      </p>
    </header>

    <div class="skill-builders-catalog" data-sb-catalog="guest">
      <section class="skill-builders-section" aria-labelledby="skill-builders-free">
        <h2 id="skill-builders-free" class="skill-builders-section__title">Free Skill Builder</h2>
        <p class="skill-builders-section__note">
          This gauge-based practice worksheet is public. No login or membership is required.
        </p>
        <ul class="skill-builders-card-list">
          <li class="skill-builders-card-list__item">
            <a href={freeSkillBuilder.href} class="skill-builders-card skill-builders-card--link">
              <span class="skill-builders-card__text">
                <span class="skill-builders-card__title">{freeSkillBuilder.title}</span>
                <span class="skill-builders-card__subtitle">{freeSkillBuilder.subtitle}</span>
              </span>
              <span class="skill-builders-card__badge skill-builders-card__badge--available">Free</span>
            </a>
          </li>
        </ul>
      </section>

      <hr class="skill-builders-divider" />

      <section class="skill-builders-section" aria-labelledby="skill-builders-members">
        <h2 id="skill-builders-members" class="skill-builders-section__title">Member Skill Builders</h2>
        <p class="skill-builders-section__note">Skill Builders are included with Knit it Now membership.</p>
        <ul class="skill-builders-card-list skill-builders-card-list--grid">
          {
            memberSkillBuilders.map((item) => (
              <li class="skill-builders-card-list__item">
                <a
                  href="#"
                  class="skill-builders-card skill-builders-card--link"
                  data-sb-state="loggedOut"
                  data-ms-modal="login"
                  data-ms-redirect="current-url"
                  hidden
                >
                  <span class="skill-builders-card__text">
                    <span class="skill-builders-card__title">{item.title}</span>
                    {item.subtitle && (
                      <span class="skill-builders-card__subtitle">{item.subtitle}</span>
                    )}
                  </span>
                  <span class="skill-builders-card__badge skill-builders-card__badge--sign-in">Sign in</span>
                </a>
                <button
                  type="button"
                  class="skill-builders-card skill-builders-card--link"
                  data-sb-state="loggedInNoAccess"
                  data-sb-membership-prompt
                  hidden
                >
                  <span class="skill-builders-card__text">
                    <span class="skill-builders-card__title">{item.title}</span>
                    {item.subtitle && (
                      <span class="skill-builders-card__subtitle">{item.subtitle}</span>
                    )}
                  </span>
                  <span class="skill-builders-card__badge skill-builders-card__badge--members-only">Members only</span>
                </button>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <div class="skill-builders-catalog" data-sb-catalog="member" hidden>
      <section class="skill-builders-section" aria-labelledby="skill-builders-all">
        <h2 id="skill-builders-all" class="skill-builders-section__title">Skill Builders</h2>
        <ul class="skill-builders-card-list skill-builders-card-list--grid">
          {
            allAvailableSkillBuilders.map((item) => (
              <li class="skill-builders-card-list__item">
                <a href={item.href} class="skill-builders-card skill-builders-card--link">
                  <span class="skill-builders-card__text">
                    <span class="skill-builders-card__title">{item.title}</span>
                    {item.subtitle && (
                      <span class="skill-builders-card__subtitle">{item.subtitle}</span>
                    )}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <hr class="skill-builders-divider" />

    <section class="skill-builders-section" aria-labelledby="skill-builders-coming-soon">
      <h2 id="skill-builders-coming-soon" class="skill-builders-section__title">Coming Soon</h2>
      <ul class="skill-builders-card-list">
        {
          comingSoonItems.map((item) => (
            <li class="skill-builders-card-list__item">
              <div class="skill-builders-card skill-builders-card--planned" aria-disabled="true">
                <span class="skill-builders-card__text">
                  <span class="skill-builders-card__title">{item}</span>
                </span>
                <span class="skill-builders-card__badge">Planned</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <dialog
    id="sb-membership-dialog"
    class="sb-membership-dialog"
    aria-labelledby="sb-membership-dialog-title"
  >
    <div class="sb-membership-dialog__inner">
      <h2 id="sb-membership-dialog-title" class="sb-membership-dialog__title">
        Skill Builders are a member benefit
      </h2>
      <p class="sb-membership-dialog__message">
        Skill Builders are included with Knit it Now membership. Join or upgrade to use this
        worksheet-style practice exercise.
      </p>
      <div class="sb-membership-dialog__actions">
        <a href="/membership" class="sb-membership-dialog__primary wizard-button">
          View Membership Options
        </a>
        <button type="button" class="sb-membership-dialog__dismiss" data-sb-membership-dismiss>
          Not Now
        </button>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .skill-builders-page {
    max-width: 56rem;
    margin: 0 auto;
    padding: 20px 20px 3.5rem;
  }

  .skill-builders-hero {
    margin-bottom: 1.5rem;
  }

  .skill-builders-hero :global(.sb-page-title) {
    margin-bottom: 0.45rem;
  }

  .skill-builders-hero__signature {
    margin: 0 0 0.55rem;
    font-family: "Handlee", "Shadows Into Light Two", cursive;
    font-weight: 400;
    font-size: clamp(1.15rem, 4.2vw, 1.35rem);
    line-height: 1.3;
    color: #A94F3D;
    text-transform: none;
    letter-spacing: 0;
    white-space: normal;
  }

  .skill-builders-hero__subtitle {
    margin: 0 0 0.7rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: #4d5a48;
    font-weight: 500;
  }

  .skill-builders-hero__copy {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #243015;
  }

  @media (min-width: 64rem) {
    .skill-builders-hero__signature {
      white-space: nowrap;
      font-size: 1.5rem;
      line-height: 1.2;
    }
  }

  .skill-builders-divider {
    border: 0;
    border-top: 1px solid #e6e6e6;
    margin: 1.5rem 0;
  }

  .skill-builders-section {
    margin-bottom: 0;
  }

  .skill-builders-section__title {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: #52682d;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid #c7d8a4;
  }

  .skill-builders-section__note {
    margin: -0.35rem 0 1rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: #4d5a48;
  }

  .skill-builders-card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .skill-builders-card-list--grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .skill-builders-card-list__item {
    margin: 0;
  }

  .skill-builders-card-list--grid .skill-builders-card-list__item {
    display: flex;
    min-width: 0;
  }

  /* A class-level display value beats the UA [hidden] rule, so enforce hiding
     for catalog groups and state-gated cards until the viewer state resolves. */
  .skill-builders-catalog[hidden],
  .skill-builders-card[hidden] {
    display: none !important;
  }

  .skill-builders-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    box-sizing: border-box;
    font-weight: 400;
  }

  .skill-builders-card--link {
    width: 100%;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    border-left: 5px solid var(--kbm-accent, #C2614E);
    background: color-mix(in srgb, var(--kbm-accent, #C2614E) 7%, #ffffff);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  button.skill-builders-card--link {
    display: flex;
    font: inherit;
    font-weight: 400;
    text-align: left;
    background: color-mix(in srgb, var(--kbm-accent, #C2614E) 7%, #ffffff);
    border: 1px solid #d6dbc9;
    border-left: 5px solid var(--kbm-accent, #C2614E);
  }

  .skill-builders-card--link:hover,
  .skill-builders-card--link:focus {
    border-color: #52682d;
    border-left-color: var(--kbm-accent, #C2614E);
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.1);
    outline: none;
  }

  .skill-builders-card-list--grid .skill-builders-card,
  .skill-builders-card-list--grid button.skill-builders-card--link {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.75rem;
    width: 100%;
    height: 100%;
    padding: 1rem 1.05rem;
  }

  .skill-builders-card-list--grid .skill-builders-card__text {
    flex: 1 1 auto;
    gap: 0.35rem;
  }

  .skill-builders-card-list--grid .skill-builders-card__badge {
    margin-top: auto;
  }

  .skill-builders-card--planned {
    opacity: 0.92;
  }

  .skill-builders-card__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .skill-builders-card__title {
    font-size: 0.98rem;
    font-weight: 600;
    color: #243015;
    line-height: 1.35;
  }

  .skill-builders-card--link .skill-builders-card__title {
    color: #52682d;
  }

  .skill-builders-card__subtitle {
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.45;
    color: #243015;
  }

  .skill-builders-card__badge {
    flex-shrink: 0;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #6b7280;
    background: #f3f4f0;
    border: 1px solid #e5e7e0;
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }

  .skill-builders-card__badge--available {
    color: #52682d;
    background: #f0f4eb;
    border-color: #c7d8a4;
  }

  .skill-builders-card__badge--sign-in {
    color: #374151;
    background: #f3f4f6;
    border-color: #d1d5db;
  }

  .skill-builders-card__badge--members-only {
    color: #6b7280;
    background: #f3f4f0;
    border-color: #e5e7e0;
  }

  .sb-membership-dialog {
    border: none;
    padding: 0;
    max-width: min(400px, 92vw);
    border-radius: 12px;
    background: transparent;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.06),
      0 12px 28px -8px rgba(0, 0, 0, 0.1);
  }

  .sb-membership-dialog::backdrop {
    background: rgba(0, 0, 0, 0.35);
  }

  .sb-membership-dialog__inner {
    padding: 1.4rem 1.5rem;
    border-radius: 12px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
  }

  .sb-membership-dialog__title {
    margin: 0 0 0.65rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: #243015;
    line-height: 1.35;
  }

  .sb-membership-dialog__message {
    margin: 0 0 1.15rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #4d5a48;
  }

  .sb-membership-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }

  .sb-membership-dialog__primary.wizard-button {
    display: inline-block;
    padding: 10px 18px;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 8px;
    background: #52682d;
    color: #fff;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }

  .sb-membership-dialog__primary.wizard-button:hover {
    background: #445925;
    color: #fff;
  }

  .sb-membership-dialog__dismiss {
    padding: 10px 14px;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    color: #4d5a48;
    background: transparent;
    border: 1px solid #d6dbc9;
    border-radius: 8px;
    cursor: pointer;
  }

  .sb-membership-dialog__dismiss:hover {
    background: #f7f8f5;
  }

  @media (max-width: 1024px) {
    .skill-builders-card-list--grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .skill-builders-page {
      padding-inline: 16px;
    }

    .skill-builders-card-list--grid {
      grid-template-columns: 1fr;
    }

    .skill-builders-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
</style>

<script>
  // Skill Builder cards use the SAME global member gate as every other section.
  import {
    getViewerAccessState,
    logMemberAccessDebug,
    type ViewerAccessState,
  } from "../../lib/memberAccess";

  async function resolveSkillBuilderViewerState(): Promise<ViewerAccessState> {
    const ms = window.$memberstackDom;
    if (!ms?.getCurrentMember) return "loggedOut";
    try {
      const res = await ms.getCurrentMember();
      logMemberAccessDebug("learn/skill-builders.catalog", res);
      return getViewerAccessState(res);
    } catch {
      return "loggedOut";
    }
  }

  async function syncSkillBuilderCatalog(): Promise<void> {
    const state = await resolveSkillBuilderViewerState();
    const isMember = state === "memberAccess";

    document.querySelectorAll<HTMLElement>("[data-sb-catalog]").forEach((el) => {
      const show =
        el.dataset.sbCatalog === "member" ? isMember : !isMember;
      el.toggleAttribute("hidden", !show);
    });

    document.querySelectorAll<HTMLElement>("[data-sb-state]").forEach((card) => {
      card.toggleAttribute("hidden", card.dataset.sbState !== state);
    });
  }

  function bindSkillBuilderCardRefresh(): void {
    void syncSkillBuilderCatalog();
    window.addEventListener("auth:updated", () => void syncSkillBuilderCatalog());
    const ms = window.$memberstackDom;
    if (ms?.on) {
      ms.on("member.login", () => void syncSkillBuilderCatalog());
      ms.on("member.logout", () => void syncSkillBuilderCatalog());
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    bindSkillBuilderCardRefresh();

    const dialog = document.getElementById("sb-membership-dialog") as HTMLDialogElement | null;
    if (!dialog) return;

    function openMembershipDialog(): void {
      if (dialog && typeof dialog.showModal === "function") {
        dialog.showModal();
      }
    }

    function closeMembershipDialog(): void {
      dialog?.close();
    }

    document.querySelectorAll("[data-sb-membership-prompt]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        openMembershipDialog();
      });
    });

    document.querySelectorAll("[data-sb-membership-dismiss]").forEach((btn) => {
      btn.addEventListener("click", closeMembershipDialog);
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeMembershipDialog();
    });

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeMembershipDialog();
    });
  });
</script>
