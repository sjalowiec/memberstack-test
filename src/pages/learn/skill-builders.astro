---
import Layout from "../../layouts/Layout.astro";
import SkillBuilderPageHeader from "../../components/skill-builders/SkillBuilderPageHeader.astro";

const pageTitle = "Skill Builders | Knit it Now";
const pageDescription =
  "Practice one machine-knitting skill at a time. Short, focused exercises help you build confidence before you use the skill in a project.";

type CatalogItem = {
  title: string;
  href: string;
  subtitle?: string;
  /** Optional catalog image path. */
  image?: string;
  /** Illustrations use contain so the full drawing stays visible. */
  imageFit?: "contain" | "cover";
};

const freeSkillBuilder: CatalogItem = {
  title: "Round Neckline with Straight Shoulders",
  href: "/learn/skill-builders/round-neckline-basics",
  subtitle: "Practice center bind-off, neckline decreases, and working each side separately.",
  image: "/images/skill-builders/round-neckline-shallow-straight-shoulders.png",
  imageFit: "contain",
};

const memberSkillBuilders: CatalogItem[] = [
  {
    title: "Round Neckline with Shaped Shoulders",
    href: "/learn/skill-builders/round-necklines-shaped-shoulders",
    subtitle: "Practice neckline shaping while working stepped shoulder shaping at the same time.",
    image: "/images/skill-builders/round-neckline-shallow-shaped-shoulders.png",
    imageFit: "contain",
  },
  {
    title: "Join Beautiful Shoulder Seams",
    href: "/learn/skill-builders/join-beautiful-shoulder-seams",
    subtitle: "Rehang live front and back shoulder stitches and bind them off together.",
    image: "/images/skill-builders/join-shoulder-seams.png",
    imageFit: "contain",
  },
  {
    title: "E-Wrap Cast On Basics",
    href: "/learn/skill-builders/e-wrap-cast-on-basics",
    subtitle: "Practice a quick, stretchy cast on that works on any knitting machine.",
    image: "/images/skill-builders/e-wrap-cast-on.png",
    imageFit: "contain",
  },
];

const allAvailableSkillBuilders: CatalogItem[] = [freeSkillBuilder, ...memberSkillBuilders];

const comingSoonItems = [
  "Short Rows Practice",
  "Sleeve Cap Practice",
  "Ribber Practice",
  "Cut & Sew Practice",
];
---

<Layout title={pageTitle} description={pageDescription} bodyClass="page--tight-header">
  <div class="skill-builders-page">
    <header class="skill-builders-hero">
      <SkillBuilderPageHeader title="Skill Builders" />
      <p class="skill-builders-hero__subtitle">
        Practice one machine-knitting skill at a time.
      </p>
      <p class="skill-builders-hero__copy">
        Short, focused exercises help you build confidence before you use the skill in a project.
      </p>
      <p class="skill-builders-hero__signature">
        Don’t practice until you get it right. Practice until you can’t get it wrong.
      </p>
    </header>

    <div class="skill-builders-catalog" data-sb-catalog="guest">
      <section class="sb-featured" aria-labelledby="skill-builders-free">
        <a href={freeSkillBuilder.href} class="sb-featured__panel">
          <div class="sb-featured__visual">
            <img
              src="/images/skill-builders/band.jpg"
              alt="Finished machine-knit round neckline"
            />
          </div>
          <div class="sb-featured__body">
            <div class="sb-featured__top">
              <h2 id="skill-builders-free" class="sb-featured__eyebrow">Try a Skill Builder Free</h2>
              <span class="skill-builders-card__badge skill-builders-card__badge--available">Free</span>
            </div>
            <h3 class="sb-featured__title">Learn to Shape a Round Neckline</h3>
            <p class="sb-featured__copy">
              Practice the essential steps for shaping a round neckline before you use them in a sweater.
            </p>
            <ul class="sb-featured__benefits">
              <li>
                <strong>Video Tutorial</strong>
                Watch the technique up close on the knitting machine.
              </li>
              <li>
                <strong>Printable Worksheet</strong>
                Step-by-step instructions to keep beside your machine.
              </li>
              <li>
                <strong>Use Your Own Gauge</strong>
                Practice using your machine, yarn, and gauge.
              </li>
            </ul>
            <span class="sb-featured__cta">START FREE SKILL BUILDER</span>
          </div>
        </a>
      </section>

      <section class="skill-builders-section skill-builders-section--more" aria-labelledby="skill-builders-members">
        <h2 id="skill-builders-members" class="skill-builders-section__title">More Skill Builders</h2>
        <p class="skill-builders-section__note">
          Continue building your skills with Knit it Now membership.
        </p>
        <ul class="skill-builders-card-list skill-builders-card-list--grid">
          {
            memberSkillBuilders.map((item) => (
              <li class="skill-builders-card-list__item">
                <a
                  href="#"
                  class="skill-builders-card skill-builders-card--link"
                  data-sb-state="loggedOut"
                  data-ms-modal="login"
                  data-ms-redirect="current-url"
                  hidden
                >
                  <span class="skill-builders-card__text">
                    <span class="skill-builders-card__title">{item.title}</span>
                    {item.subtitle && (
                      <span class="skill-builders-card__subtitle">{item.subtitle}</span>
                    )}
                  </span>
                  <span class="skill-builders-card__badge skill-builders-card__badge--members-only">Members only</span>
                </a>
                <button
                  type="button"
                  class="skill-builders-card skill-builders-card--link"
                  data-sb-state="loggedInNoAccess"
                  data-sb-membership-prompt
                  hidden
                >
                  <span class="skill-builders-card__text">
                    <span class="skill-builders-card__title">{item.title}</span>
                    {item.subtitle && (
                      <span class="skill-builders-card__subtitle">{item.subtitle}</span>
                    )}
                  </span>
                  <span class="skill-builders-card__badge skill-builders-card__badge--members-only">Members only</span>
                </button>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="skill-builders-upcoming" id="skill-builders-upcoming">
        <span class="skill-builders-upcoming__label">Coming Soon</span>
        {comingSoonItems.join(" · ")}
      </p>
    </div>

    <div class="skill-builders-catalog" data-sb-catalog="member" hidden>
      <section class="skill-builders-section" aria-labelledby="skill-builders-all">
        <h2 id="skill-builders-all" class="skill-builders-section__title">Skill Builders</h2>
        <ul class="skill-builders-card-list skill-builders-card-list--grid">
          {
            allAvailableSkillBuilders.map((item) => (
              <li class="skill-builders-card-list__item">
                <a
                  href={item.href}
                  class="skill-builders-card skill-builders-card--link skill-builders-card--visual"
                >
                  <span
                    class:list={[
                      "skill-builders-card__media",
                      item.imageFit === "contain" && "skill-builders-card__media--contain",
                    ]}
                  >
                    {item.image ? (
                      <img src={item.image} alt="" />
                    ) : (
                      <span class="skill-builders-card__placeholder">Image coming</span>
                    )}
                  </span>
                  <span class="skill-builders-card__text">
                    <span class="skill-builders-card__title">{item.title}</span>
                    {item.subtitle && (
                      <span class="skill-builders-card__subtitle">{item.subtitle}</span>
                    )}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <hr class="skill-builders-divider" />

      <section class="skill-builders-section" aria-labelledby="skill-builders-coming-soon">
        <h2 id="skill-builders-coming-soon" class="skill-builders-section__title">Coming Soon</h2>
        <ul class="skill-builders-card-list">
          {
            comingSoonItems.map((item) => (
              <li class="skill-builders-card-list__item">
                <div class="skill-builders-card skill-builders-card--planned" aria-disabled="true">
                  <span class="skill-builders-card__text">
                    <span class="skill-builders-card__title">{item}</span>
                  </span>
                  <span class="skill-builders-card__badge">Planned</span>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  <dialog
    id="sb-membership-dialog"
    class="sb-membership-dialog"
    aria-labelledby="sb-membership-dialog-title"
  >
    <div class="sb-membership-dialog__inner">
      <h2 id="sb-membership-dialog-title" class="sb-membership-dialog__title">
        Skill Builders are a member benefit
      </h2>
      <p class="sb-membership-dialog__message">
        Skill Builders are included with Knit it Now membership. Join or upgrade to use this
        worksheet-style practice exercise.
      </p>
      <div class="sb-membership-dialog__actions">
        <a href="/membership" class="sb-membership-dialog__primary wizard-button">
          View Membership Options
        </a>
        <button type="button" class="sb-membership-dialog__dismiss" data-sb-membership-dismiss>
          Not Now
        </button>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .skill-builders-page {
    max-width: 56rem;
    margin: 0 auto;
    padding: 20px 20px 3.5rem;
  }

  .skill-builders-hero {
    margin-bottom: 1.85rem;
  }

  .skill-builders-hero :global(.sb-page-title) {
    margin-bottom: 0.45rem;
  }

  .skill-builders-hero__subtitle {
    margin: 0 0 0.45rem;
    font-size: 1.08rem;
    line-height: 1.5;
    color: #243015;
    font-weight: 600;
  }

  .skill-builders-hero__copy {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #4d5a48;
  }

  .skill-builders-hero__signature {
    margin: 0.85rem 0 0;
    font-family: "Kalam", cursive;
    font-weight: 400;
    font-size: clamp(1.28rem, 3.4vw, 1.5rem);
    line-height: 1.4;
    color: #A94F3D;
    text-transform: none;
    letter-spacing: 0;
    white-space: normal;
  }

  @media (min-width: 64rem) {
    .skill-builders-hero__signature {
      white-space: nowrap;
      font-size: 1.5rem;
      line-height: 1.35;
    }
  }

  .sb-featured {
    margin-bottom: 2.15rem;
  }

  .sb-featured__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: stretch;
    width: 100%;
    text-decoration: none;
    color: inherit;
    box-sizing: border-box;
    padding: 1.45rem 1.5rem 1.5rem;
    background: color-mix(in srgb, var(--kbm-green, #52682d) 8%, #ffffff);
    border: 1px solid #c7d8a4;
    border-left: 6px solid var(--kbm-accent, #C2614E);
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(36, 48, 21, 0.07);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .sb-featured__panel:hover,
  .sb-featured__panel:focus {
    border-color: var(--kbm-green, #52682d);
    border-left-color: var(--kbm-accent, #C2614E);
    box-shadow: 0 4px 16px rgba(82, 104, 45, 0.12);
    outline: none;
  }

  .sb-featured__visual {
    position: relative;
    min-height: 12.5rem;
    border-radius: 8px;
    overflow: hidden;
  }

  .sb-featured__visual img {
    display: block;
    width: 100%;
    height: 12.5rem;
    object-fit: cover;
    object-position: center 22%;
  }

  @media (min-width: 40rem) {
    .sb-featured__panel:has(.sb-featured__visual) {
      grid-template-columns: minmax(16rem, 1.15fr) minmax(0, 0.95fr);
    }

    .sb-featured__visual {
      min-height: 18rem;
      align-self: stretch;
    }

    .sb-featured__visual img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
  }

  .sb-featured__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    min-width: 0;
  }

  .sb-featured__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
  }

  .sb-featured__eyebrow {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--kbm-green, #52682d);
  }

  .sb-featured__title {
    margin: 0;
    font-size: clamp(1.28rem, 2.6vw, 1.5rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--kbm-green, #52682d);
  }

  .sb-featured__copy {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: #243015;
  }

  .sb-featured__benefits {
    list-style: none;
    margin: 0.1rem 0 0.15rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .sb-featured__benefits li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.88rem;
    line-height: 1.4;
    color: #4d5a48;
  }

  .sb-featured__benefits li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--kbm-green, #52682d);
  }

  .sb-featured__benefits strong {
    display: block;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
    color: #243015;
  }

  .sb-featured__cta {
    display: inline-block;
    margin-top: 0.35rem;
    padding: 0.7rem 1.2rem;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
    background: var(--kbm-accent, #C2614E);
    border-radius: 8px;
  }

  .sb-featured__panel:hover .sb-featured__cta,
  .sb-featured__panel:focus .sb-featured__cta {
    background: var(--kbm-accent-hover, #a94e3d);
  }

  .skill-builders-section--more {
    margin-top: 0;
  }

  .skill-builders-upcoming {
    margin: 1.75rem 0 0;
    padding-top: 0.95rem;
    border-top: 1px solid #ececec;
    font-size: 0.86rem;
    line-height: 1.5;
    color: #6b7280;
  }

  .skill-builders-upcoming__label {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6b7280;
  }

  .skill-builders-divider {
    border: 0;
    border-top: 1px solid #e6e6e6;
    margin: 1.5rem 0;
  }

  .skill-builders-section {
    margin-bottom: 0;
  }

  .skill-builders-section__title {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: #52682d;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid #c7d8a4;
  }

  .skill-builders-section__note {
    margin: -0.35rem 0 1rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: #4d5a48;
  }

  .skill-builders-card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .skill-builders-card-list--grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .skill-builders-card-list__item {
    margin: 0;
  }

  .skill-builders-card-list--grid .skill-builders-card-list__item {
    display: flex;
    min-width: 0;
  }

  /* A class-level display value beats the UA [hidden] rule, so enforce hiding
     for catalog groups and state-gated cards until the viewer state resolves. */
  .skill-builders-catalog[hidden],
  .skill-builders-card[hidden] {
    display: none !important;
  }

  .skill-builders-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    box-sizing: border-box;
    font-weight: 400;
  }

  .skill-builders-card--link {
    width: 100%;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    border-left: 5px solid var(--kbm-accent, #C2614E);
    background: color-mix(in srgb, var(--kbm-accent, #C2614E) 7%, #ffffff);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  button.skill-builders-card--link {
    display: flex;
    font: inherit;
    font-weight: 400;
    text-align: left;
    background: color-mix(in srgb, var(--kbm-accent, #C2614E) 7%, #ffffff);
    border: 1px solid #d6dbc9;
    border-left: 5px solid var(--kbm-accent, #C2614E);
  }

  .skill-builders-card--link:hover,
  .skill-builders-card--link:focus {
    border-color: #52682d;
    border-left-color: var(--kbm-accent, #C2614E);
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.1);
    outline: none;
  }

  .skill-builders-card-list--grid .skill-builders-card,
  .skill-builders-card-list--grid button.skill-builders-card--link {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.75rem;
    width: 100%;
    height: 100%;
    padding: 1rem 1.05rem;
  }

  .skill-builders-card-list--grid .skill-builders-card__text {
    flex: 1 1 auto;
    gap: 0.35rem;
  }

  .skill-builders-card-list--grid .skill-builders-card__badge {
    margin-top: auto;
  }

  .skill-builders-card--planned {
    opacity: 0.92;
  }

  .skill-builders-card__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  [data-sb-catalog="guest"] .skill-builders-card-list--grid .skill-builders-card--link,
  [data-sb-catalog="guest"] .skill-builders-card-list--grid button.skill-builders-card--link {
    background: #fff;
    border-left-width: 3px;
    box-shadow: none;
  }

  [data-sb-catalog="guest"] .skill-builders-card-list--grid .skill-builders-card--link .skill-builders-card__title {
    color: #3f4d32;
  }

  [data-sb-catalog="member"] .skill-builders-card-list--grid .skill-builders-card--visual {
    padding: 0;
    gap: 0;
    height: auto;
    min-height: 100%;
    overflow: visible;
  }

  [data-sb-catalog="member"] .skill-builders-card__media {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: color-mix(in srgb, var(--kbm-green, #52682d) 7%, #f3f4f0);
    overflow: hidden;
    border-radius: 9px 9px 0 0;
  }

  [data-sb-catalog="member"] .skill-builders-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  [data-sb-catalog="member"] .skill-builders-card__media--contain {
    background: #fff;
  }

  [data-sb-catalog="member"] .skill-builders-card__media--contain img {
    object-fit: contain;
    object-position: center;
  }

  [data-sb-catalog="member"] .skill-builders-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #9aa194;
  }

  [data-sb-catalog="member"] .skill-builders-card--visual .skill-builders-card__text {
    flex: 1 0 auto;
    width: 100%;
    padding: 0.9rem 1rem 1.05rem;
    gap: 0.35rem;
    overflow: visible;
  }

  .skill-builders-card__title {
    font-size: 0.98rem;
    font-weight: 600;
    color: #243015;
    line-height: 1.35;
  }

  .skill-builders-card--link .skill-builders-card__title {
    color: #52682d;
  }

  .skill-builders-card__subtitle {
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.45;
    color: #243015;
  }

  .skill-builders-card__badge {
    flex-shrink: 0;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #6b7280;
    background: #f3f4f0;
    border: 1px solid #e5e7e0;
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }

  .skill-builders-card__badge--available {
    color: #52682d;
    background: #f0f4eb;
    border-color: #c7d8a4;
  }

  .skill-builders-card__badge--sign-in {
    color: #374151;
    background: #f3f4f6;
    border-color: #d1d5db;
  }

  .skill-builders-card__badge--members-only {
    color: #6b7280;
    background: #f3f4f0;
    border-color: #e5e7e0;
  }

  .sb-membership-dialog {
    border: none;
    padding: 0;
    max-width: min(400px, 92vw);
    border-radius: 12px;
    background: transparent;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.06),
      0 12px 28px -8px rgba(0, 0, 0, 0.1);
  }

  .sb-membership-dialog::backdrop {
    background: rgba(0, 0, 0, 0.35);
  }

  .sb-membership-dialog__inner {
    padding: 1.4rem 1.5rem;
    border-radius: 12px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
  }

  .sb-membership-dialog__title {
    margin: 0 0 0.65rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: #243015;
    line-height: 1.35;
  }

  .sb-membership-dialog__message {
    margin: 0 0 1.15rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #4d5a48;
  }

  .sb-membership-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }

  .sb-membership-dialog__primary.wizard-button {
    display: inline-block;
    padding: 10px 18px;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 8px;
    background: #52682d;
    color: #fff;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }

  .sb-membership-dialog__primary.wizard-button:hover {
    background: #445925;
    color: #fff;
  }

  .sb-membership-dialog__dismiss {
    padding: 10px 14px;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    color: #4d5a48;
    background: transparent;
    border: 1px solid #d6dbc9;
    border-radius: 8px;
    cursor: pointer;
  }

  .sb-membership-dialog__dismiss:hover {
    background: #f7f8f5;
  }

  @media (max-width: 1024px) {
    .skill-builders-card-list--grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .skill-builders-page {
      padding-inline: 16px;
    }

    .skill-builders-card-list--grid {
      grid-template-columns: 1fr;
    }

    .skill-builders-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
