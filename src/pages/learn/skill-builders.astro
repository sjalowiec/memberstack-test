</style>

<script>
  // Skill Builder cards use the SAME global member gate as every other section.
  import {
    getViewerAccessState,
    logMemberAccessDebug,
    type ViewerAccessState,
  } from "../../lib/memberAccess";

  async function resolveSkillBuilderViewerState(): Promise<ViewerAccessState> {
    const ms = window.$memberstackDom;
    if (!ms?.getCurrentMember) return "loggedOut";
    try {
      const res = await ms.getCurrentMember();
      logMemberAccessDebug("learn/skill-builders.catalog", res);
      return getViewerAccessState(res);
    } catch {
      return "loggedOut";
    }
  }

  async function syncSkillBuilderCatalog(): Promise<void> {
    const state = await resolveSkillBuilderViewerState();
    const isMember = state === "memberAccess";

    document.querySelectorAll<HTMLElement>("[data-sb-catalog]").forEach((el) => {
      const show =
        el.dataset.sbCatalog === "member" ? isMember : !isMember;
      el.toggleAttribute("hidden", !show);
    });

    document.querySelectorAll<HTMLElement>("[data-sb-state]").forEach((card) => {
      card.toggleAttribute("hidden", card.dataset.sbState !== state);
    });
  }

  function bindSkillBuilderCardRefresh(): void {
    void syncSkillBuilderCatalog();
    window.addEventListener("auth:updated", () => void syncSkillBuilderCatalog());
    const ms = window.$memberstackDom;
    if (ms?.on) {
      ms.on("member.login", () => void syncSkillBuilderCatalog());
      ms.on("member.logout", () => void syncSkillBuilderCatalog());
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    bindSkillBuilderCardRefresh();

    const dialog = document.getElementById("sb-membership-dialog") as HTMLDialogElement | null;
    if (!dialog) return;

    function openMembershipDialog(): void {
      if (dialog && typeof dialog.showModal === "function") {
        dialog.showModal();
      }
    }

    function closeMembershipDialog(): void {
      dialog?.close();
    }

    document.querySelectorAll("[data-sb-membership-prompt]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        openMembershipDialog();
      });
    });

    document.querySelectorAll("[data-sb-membership-dismiss]").forEach((btn) => {
      btn.addEventListener("click", closeMembershipDialog);
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeMembershipDialog();
    });

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeMembershipDialog();
    });
  });
</script>
