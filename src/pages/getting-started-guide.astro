---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import GatedVimeoEmbed from "../components/videos/GatedVimeoEmbed.astro";
import { getAllMachines } from "../lib/machines/referenceCatalog";
import { buildMachineIdentityCatalog } from "../lib/gettingStarted/machineIdentity";
import videosCatalog from "../data/videos-public.json";
import { findPublicCatalogVideoByContentId } from "../lib/videoPublic";
import { catalogVideoPlaybackAccess } from "../lib/videos/catalogVideoPlaybackAccess";

const title = "Getting Started Guide";
const description =
  "Get comfortable with your knitting machine: identify it, find a manual, check the sponge bar, choose yarn, and knit a small practice piece.";
const catalogJson = JSON.stringify(buildMachineIdentityCatalog(getAllMachines()));

const SWATCH_VIDEO_TITLE =
  "How to Knit a Proper Swatch: The Secret to Machine Knitting Success";

type GuideCatalogVideo = {
  content_id?: number;
  title?: string;
  access_level?: string;
  posterUrl?: string;
  vimeo_id?: number | string;
  vimeo_id_public?: number | string;
};

function guideVideo(contentId: number, expectedTitle?: string) {
  const video = findPublicCatalogVideoByContentId(
    videosCatalog as GuideCatalogVideo[],
    contentId,
  );
  if (!video?.title) return null;
  if (expectedTitle && video.title !== expectedTitle) return null;
  const rawVimeoId = video.vimeo_id_public ?? video.vimeo_id;
  const vimeoId = rawVimeoId != null ? String(rawVimeoId).trim() : "";
  if (!vimeoId) return null;
  return {
    contentId: String(video.content_id ?? contentId),
    title: video.title,
    vimeoId,
    accessLevel: catalogVideoPlaybackAccess(video),
    posterUrl: typeof video.posterUrl === "string" ? video.posterUrl : "",
  };
}

const lk150SpongeVideo = guideVideo(2141);
const metalSpongeVideo = guideVideo(242);
const yarnVideo = guideVideo(2049);
const swatchVideo = guideVideo(2189, SWATCH_VIDEO_TITLE);
---

<Layout
  title={`${title} | Knit it Now`}
  description={description}
  bodyClass="page--getting-started-guide"
  skipAnalytics
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <article class="page-wrap gsg">
    <header class="gsg-header">
      <h1>Your First Steps to Machine Knitting</h1>
      <div class="gsg-intro-row">
        <img
          class="gsg-intro__photo"
          src="/images/knit-by-machine-sue.png"
          alt="Sue from Knit It Now"
          width="1385"
          height="1371"
        />
        <div class="gsg-intro__copy">
          <p class="gsg-intro">
            New to machine knitting, or getting back to it after a break? Follow these six steps to prepare your machine, choose your yarn, and knit your first practice swatch.
          </p>
          <p class="gsg-intro">
            No need to know everything before you begin. We’ll help you take it one step at a time.
          </p>
        </div>
      </div>
    </header>

    <section class="gsg-section gsg-gate" data-gsg-gate aria-labelledby="gsg-gate-title">
      <h2 id="gsg-gate-title">Open the guide</h2>
      <p>
        Enter your first name and email to open the Getting Started Guide. You’ll also receive helpful follow-up emails from Knit It Now. You can unsubscribe at any time.
      </p>
      <form class="gsg-signup" data-gsg-signup novalidate>
        <p class="gsg-honeypot" aria-hidden="true">
          <label for="gsg-bot">Company</label>
          <input type="text" id="gsg-bot" name="bot-field" tabindex="-1" autocomplete="off" />
        </p>
        <div class="gsg-signup__field">
          <label class="gsg-label" for="gsg-first-name">
            First name
            <span class="gsg-required" aria-hidden="true">*</span>
            <span class="gsg-sr"> (required)</span>
          </label>
          <input
            class="gsg-signup__input"
            id="gsg-first-name"
            name="firstName"
            type="text"
            autocomplete="given-name"
            maxlength="80"
            required
            aria-required="true"
          />
        </div>
        <div class="gsg-signup__field">
          <label class="gsg-label" for="gsg-email">
            Email address
            <span class="gsg-required" aria-hidden="true">*</span>
            <span class="gsg-sr"> (required)</span>
          </label>
          <input
            class="gsg-signup__input"
            id="gsg-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            maxlength="254"
            required
            aria-required="true"
          />
        </div>
        <button class="kbm-btn kbm-btn-primary gsg-signup__submit" type="submit">
          Open the guide
        </button>
        <p class="gsg-consent">
          By signing up, you agree to receive emails from Knit It Now. You can unsubscribe at any time. See our
          <a href="/privacy">Privacy Policy</a>.
        </p>
        <p class="gsg-signup__error" data-gsg-signup-error role="alert" hidden></p>
      </form>
    </section>

    <div data-gsg-guide hidden></div>

    <template id="gsg-guide-template">
    <div class="gsg-sections">
      <section class="gsg-step" aria-labelledby="gsg-identify">
        <div class="gsg-step__rail" aria-hidden="true">
          <span class="gsg-step__badge">1</span>
        </div>
        <div class="gsg-section gsg-step__panel">
        <h2 id="gsg-identify"><span class="gsg-sr">1. </span>Identify your machine</h2>
        <p>
          Have more than one machine? Choose the one you’d like to use as you work through this guide.
        </p>

        <div class="gsg-fields" data-gsg-machine-identity>
          <p id="gsg-combo-help" class="gsg-sr">
            Type to search. Use the arrow keys to browse the list, then press Enter to choose.
            You can leave this blank.
          </p>

          <div class="gsg-field" data-gsg-combo="brand" data-selected-id="">
            <label class="gsg-label" id="gsg-brand-label" for="gsg-brand">Choose your brand</label>
            <div class="gsg-combo">
              <input
                id="gsg-brand"
                class="gsg-combo__input"
                type="text"
                role="combobox"
                data-gsg-input
                placeholder="Search brands"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="gsg-brand-list"
                aria-labelledby="gsg-brand-label"
                aria-describedby="gsg-combo-help"
              />
              <button
                type="button"
                class="gsg-combo__toggle"
                data-gsg-toggle
                tabindex="-1"
                aria-label="Show brands"
                aria-expanded="false"
                aria-controls="gsg-brand-list"
              >
                <span class="gsg-combo__chevron" aria-hidden="true"></span>
              </button>
              <ul
                id="gsg-brand-list"
                class="gsg-combo__list"
                role="listbox"
                data-gsg-list
                hidden
                aria-labelledby="gsg-brand-label"
              ></ul>
              <p class="gsg-combo__empty" data-gsg-empty hidden>No matches</p>
            </div>
          </div>

          <div class="gsg-field" data-gsg-combo="model" data-selected-id="">
            <label class="gsg-label" id="gsg-model-label" for="gsg-model">Choose your model</label>
            <div class="gsg-combo">
              <input
                id="gsg-model"
                class="gsg-combo__input"
                type="text"
                role="combobox"
                data-gsg-input
                placeholder="Choose a brand first"
                disabled
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="gsg-model-list"
                aria-labelledby="gsg-model-label"
                aria-describedby="gsg-combo-help"
                aria-disabled="true"
              />
              <button
                type="button"
                class="gsg-combo__toggle"
                data-gsg-toggle
                tabindex="-1"
                aria-label="Show models"
                aria-expanded="false"
                aria-controls="gsg-model-list"
                disabled
              >
                <span class="gsg-combo__chevron" aria-hidden="true"></span>
              </button>
              <ul
                id="gsg-model-list"
                class="gsg-combo__list"
                role="listbox"
                data-gsg-list
                hidden
                aria-labelledby="gsg-model-label"
              ></ul>
              <p class="gsg-combo__empty" data-gsg-empty hidden>No matches</p>
            </div>
          </div>

          <p class="gsg-sr" data-gsg-status aria-live="polite"></p>
        </div>

        <p class="gsg-note">You can continue without identifying a machine.</p>
        <p class="gsg-link-line">
          <a href="/reference/machine-brands" target="_blank" rel="noopener noreferrer">
            Explore Machines Around the World to see how the same knitting machine was sold under different brand names in different countries.
          </a>
        </p>
        </div>
      </section>

      <section class="gsg-step" aria-labelledby="gsg-manual">
        <div class="gsg-step__rail" aria-hidden="true">
          <span class="gsg-step__badge">2</span>
        </div>
        <div class="gsg-section gsg-step__panel">
        <h2 id="gsg-manual"><span class="gsg-sr">2. </span>Do you have your machine’s manual?</h2>
        <p>
          Your manual is an important companion as you get comfortable with your machine. Keep it handy to check threading, settings, and basic instructions.
        </p>
        <p>
          If you need a copy, visit <a href="https://mkmanuals.com" target="_blank" rel="noopener noreferrer">MKManuals.com</a>. Look for your exact model first. If it isn’t available, a manual for a similar model in the same machine family may help. Check that the carriage, controls, and features match your machine before following the instructions.
        </p>
        <p>
          Can’t find a suitable manual? Explore ways to <a href="/help-hub/work-with-sue">work with Sue</a> for help finding a useful starting point.
        </p>
        </div>
      </section>

      <section class="gsg-step" aria-labelledby="gsg-sponge">
        <div class="gsg-step__rail" aria-hidden="true">
          <span class="gsg-step__badge gsg-step__badge--critical">3</span>
        </div>
        <div class="gsg-section gsg-section--critical gsg-step__panel">
            <p class="gsg-kicker gsg-kicker--critical">Check this before you knit</p>
            <h2 id="gsg-sponge"><span class="gsg-sr">3. </span>Check your sponge bar</h2>
            <p>
              The sponge holds the needles so your stitches can form. Most metal-bed machines use a sponge bar along the needle bed. The LK150 uses a different arrangement, and a worn sponge is harder to see on that machine. The sponge can flatten or crumble over time, even if the machine has been stored.
            </p>
            <p>
              Check that the sponge is even and springy, not flat, compressed, or crumbling. On a metal-bed machine, also check that the needles lie firmly in their slots. Replace a worn sponge before you knit. It can cause knitting problems and may damage needles.
            </p>
            <p>
              Need a replacement? Check our <a href="/reference/repairs">Repairs and Service directory</a> for businesses that may supply sponge bars or replacement sponge. Confirm that the replacement is suitable for your machine model before ordering.
            </p>
            <figure class="gsg-sponge-example">
              <figcaption>This photo shows a worn sponge bar on a metal-bed machine.</figcaption>
              <img
                src="/images/reference/sponge-bar.png"
                alt="A worn sponge bar on a metal-bed knitting machine, marked past time to replace. The sponge is crumbling and compressed, so it no longer holds the needles evenly."
                width="1829"
                height="968"
              />
            </figure>
            <p>Watch the video for your machine.</p>
            <div class="gsg-sponge-player" data-gsg-sponge-tabs>
              <div
                class="gsg-sponge-tabs"
                role="tablist"
                aria-label="Sponge bar videos"
                aria-orientation="horizontal"
              >
                <button
                  class="gsg-sponge-tabs__tab"
                  type="button"
                  role="tab"
                  id="gsg-sponge-tab-metal"
                  aria-controls="gsg-sponge-panel-metal"
                  aria-selected="true"
                  tabindex="0"
                  data-gsg-sponge-tab="metal"
                >Metal-bed machines</button>
                <button
                  class="gsg-sponge-tabs__tab"
                  type="button"
                  role="tab"
                  id="gsg-sponge-tab-lk150"
                  aria-controls="gsg-sponge-panel-lk150"
                  aria-selected="false"
                  tabindex="-1"
                  data-gsg-sponge-tab="lk150"
                >LK150</button>
              </div>
              <div
                class="gsg-sponge-panel gsg-video-choice"
                role="tabpanel"
                id="gsg-sponge-panel-metal"
                aria-labelledby="gsg-sponge-tab-metal"
                data-gsg-sponge-panel="metal"
              >
                {metalSpongeVideo ? (
                  <GatedVimeoEmbed
                    videoId={metalSpongeVideo.vimeoId}
                    contentId={metalSpongeVideo.contentId}
                    title={metalSpongeVideo.title}
                    access_level={metalSpongeVideo.accessLevel}
                    thumbUrl={metalSpongeVideo.posterUrl}
                    enableVimeoPlayerApi={true}
                  />
                ) : (
                  <p class="gsg-note">The metal bed sponge bar video could not be matched in the video library.</p>
                )}
              </div>
              <div
                class="gsg-sponge-panel gsg-video-choice"
                role="tabpanel"
                id="gsg-sponge-panel-lk150"
                aria-labelledby="gsg-sponge-tab-lk150"
                data-gsg-sponge-panel="lk150"
                hidden
              >
                {lk150SpongeVideo ? (
                  <GatedVimeoEmbed
                    videoId={lk150SpongeVideo.vimeoId}
                    contentId={lk150SpongeVideo.contentId}
                    title={lk150SpongeVideo.title}
                    access_level={lk150SpongeVideo.accessLevel}
                    thumbUrl={lk150SpongeVideo.posterUrl}
                    enableVimeoPlayerApi={true}
                  />
                ) : (
                  <p class="gsg-note">The LK150 sponge bar video could not be matched in the video library.</p>
                )}
              </div>
            </div>
        </div>
      </section>

      <section class="gsg-step" aria-labelledby="gsg-yarn">
        <div class="gsg-step__rail" aria-hidden="true">
          <span class="gsg-step__badge">4</span>
        </div>
        <div class="gsg-section gsg-step__panel">
        <div class="gsg-split">
          <div class="gsg-split__copy">
            <h2 id="gsg-yarn"><span class="gsg-sr">4. </span>Choose a suitable yarn</h2>
            <p>
              Choose a yarn weight appropriate for your machine. For your first practice, use a smooth yarn in a light color so you can easily see the stitches. Check your manual for yarn recommendations.
            </p>
            <p>
              You don’t need yarn on cones. Your yarn simply needs to feed smoothly into the machine without tangles or resistance. A center-pull ball may work, or you can rewind the yarn with a ball winder.
            </p>
          </div>
          <div class="gsg-split__media">
            {yarnVideo ? (
              <div class="gsg-video-choice">
                <h3>{yarnVideo.title}</h3>
                <GatedVimeoEmbed
                  videoId={yarnVideo.vimeoId}
                  contentId={yarnVideo.contentId}
                  title={yarnVideo.title}
                  access_level={yarnVideo.accessLevel}
                  thumbUrl={yarnVideo.posterUrl}
                />
              </div>
            ) : (
              <p class="gsg-note">The yarn video could not be matched in the video library.</p>
            )}
          </div>
        </div>
        <p>
          Not sure about your yarn? Use the <a href="/tools/yarn-comparison-calculator">Yarn Comparison Calculator</a> to check your yarn label against suggested yarn weights for different machines.
        </p>
        </div>
      </section>

      <section class="gsg-step" aria-labelledby="gsg-practice">
        <div class="gsg-step__rail" aria-hidden="true">
          <span class="gsg-step__badge">5</span>
        </div>
        <div class="gsg-section gsg-step__panel">
        <div class="gsg-split">
          <div class="gsg-split__copy">
            <h2 id="gsg-practice"><span class="gsg-sr">5. </span>Knit Your First Practice Swatch</h2>
            <p>
              Find the instructions for plain knitting or stockinette in your machine manual. Check the carriage settings and needle positions before you begin. Keep that page handy as you follow the video.
            </p>
            <p>
              For your first practice, focus on getting comfortable with your machine. Cast on, knit a small piece of plain knitting, and bind off. You can skip the gauge markers and tension eyelets for now.
            </p>
            <p>
              Once knitting feels familiar again, follow the complete video to make a proper gauge swatch for your next project.
            </p>
          </div>
          <div class="gsg-split__media">
            {swatchVideo ? (
              <div class="gsg-video-choice">
                <h3>{swatchVideo.title}</h3>
                <GatedVimeoEmbed
                  videoId={swatchVideo.vimeoId}
                  contentId={swatchVideo.contentId}
                  title={swatchVideo.title}
                  access_level={swatchVideo.accessLevel}
                  thumbUrl={swatchVideo.posterUrl}
                />
              </div>
            ) : (
              <p class="gsg-note">
                The video “{SWATCH_VIDEO_TITLE}” could not be matched in the video library. This step is waiting on that recording.
              </p>
            )}
            <h3>Knitted your practice swatch? That’s progress!</h3>
            <p>
              It doesn’t need to be perfect. Every row you practice here helps build the confidence and control you’ll use in your next project.
            </p>
          </div>
        </div>
        </div>
      </section>

      <aside class="gsg-bridge" aria-labelledby="gsg-workshop">
        <div class="gsg-bridge__rail" aria-hidden="true"></div>
        <div class="gsg-invite">
          <img
            class="gsg-invite__thumb"
            src="/images/courses/beginner.webp"
            alt="Beginner Workshop"
            width="600"
            height="338"
          />
          <div class="gsg-invite__copy">
            <h2 id="gsg-workshop" class="gsg-invite__title">Get comfortable with the basics</h2>
            <p>
              Join Knit It Now for access to the Beginner Workshop, with demonstrations to help you thread your machine, get started knitting, and practice the basics at your own pace.
            </p>
            <p class="gsg-action gsg-invite__action">
              <a class="kbm-btn kbm-btn-primary" href="/courses/33">Explore the Beginner Workshop</a>
            </p>
            <p class="gsg-invite__access">Beginner Workshop included with membership</p>
          </div>
        </div>
      </aside>

      <section class="gsg-step" aria-labelledby="gsg-help">
        <div class="gsg-step__rail" aria-hidden="true">
          <span class="gsg-step__badge">6</span>
        </div>
        <div class="gsg-section gsg-step__panel gsg-help-banner">
        <h2 id="gsg-help"><span class="gsg-sr">6. </span>Get Personal Help</h2>
        <div class="gsg-help">
          <div class="gsg-help__copy">
            <p>
              You don’t have to figure everything out on your own. Sometimes a little help is all you need to take the next step.
            </p>
            <p class="gsg-action">
              <a class="kbm-btn kbm-btn-primary" href="/help-hub/work-with-sue">Explore Your Help Options</a>
            </p>
          </div>
        </div>
        </div>
      </section>
    </div>
    <script id="getting-started-machine-catalog" type="application/json" set:html={catalogJson}></script>
    </template>
  </article>
</Layout>

<script>
  import { initGettingStartedGuideAccess } from "../scripts/gettingStartedGuideAccess";

  initGettingStartedGuideAccess();
</script>

<style>
  /* Soft cream page field; white step panels stay white against it. */
  :global(body.page--getting-started-guide) {
    --gsg-page-bg: #fbf9f5;
    background: var(--gsg-page-bg);
  }

  /* Main already clears the fixed header, so don't add page-wrap's second offset. */
  .gsg.page-wrap {
    max-width: 68rem;
    padding-top: 0.5rem;
  }

  .gsg-header {
    margin-bottom: 1.25rem;
  }

  .gsg-header h1 {
    margin-bottom: 0.75rem;
  }

  .gsg-intro-row {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    width: 100%;
  }

  .gsg-intro__photo {
    order: 2;
    width: 200px;
    height: auto;
    flex: 0 0 auto;
    border-radius: 14px;
  }

  .gsg-intro__copy {
    order: 1;
    flex: 1 1 auto;
    min-width: 0;
  }

  .gsg-intro {
    margin: 0;
    color: #243015;
  }

  .gsg-intro + .gsg-intro {
    margin-top: 0.75rem;
  }

  .gsg-gate {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .gsg-signup {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 28rem;
  }

  .gsg-signup__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .gsg-required {
    color: #8a4b32;
  }

  .gsg-signup__input {
    width: 100%;
    box-sizing: border-box;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border: 2px solid #c7d8a4;
    border-radius: 12px;
    background: #fff;
    color: #243015;
    font: inherit;
    font-size: 1rem;
  }

  .gsg-signup__input:focus {
    outline: none;
    border-color: var(--kbm-green, #52682d);
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.18);
  }

  .gsg-signup__submit {
    align-self: flex-start;
    min-height: 48px;
  }

  .gsg-consent,
  .gsg-signup__error {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .gsg-signup__error {
    color: #8a2f2f;
  }

  .gsg-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .gsg-gate[hidden],
  [data-gsg-guide][hidden] {
    display: none;
  }

  .gsg-sections {
    --gsg-step-gap: 1.35rem;
    --gsg-badge-size: 2.5rem;
    --gsg-badge-offset: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: var(--gsg-step-gap);
    margin-bottom: 2.5rem;
  }

  .gsg-step {
    display: grid;
    grid-template-columns: var(--gsg-badge-size) minmax(0, 1fr);
    column-gap: 0.9rem;
    align-items: stretch;
    min-width: 0;
  }

  .gsg-step__rail {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .gsg-step:not(:last-child) .gsg-step__rail::before {
    content: "";
    position: absolute;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: rgba(82, 104, 45, 0.28);
    top: calc(var(--gsg-badge-offset) + var(--gsg-badge-size) / 2);
    bottom: calc((var(--gsg-step-gap) + var(--gsg-badge-offset) + var(--gsg-badge-size) / 2) * -1);
  }

  .gsg-step__badge {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--gsg-badge-size);
    height: var(--gsg-badge-size);
    margin-top: var(--gsg-badge-offset);
    border-radius: 50%;
    border: 2px solid var(--kbm-green, #52682d);
    background: #fff;
    box-shadow: 0 0 0 4px var(--gsg-page-bg, #fbf9f5);
    color: var(--kbm-green, #52682d);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1;
    flex: 0 0 auto;
  }

  .gsg-step__badge--critical {
    border-color: #8a4b32;
    background: #fff8f4;
