---
import KinCourseHomeView from "../../../components/kinCourse/KinCourseHomeView.astro";
import KinCourseAdminPreviewBootstrap from "../../../components/kinCourse/KinCourseAdminPreviewBootstrap.astro";
import CourseNamedLanding from "../../../components/courses/CourseNamedLanding.astro";
import { parseKinCourseId } from "../../../lib/kinCourse/hrefs";
import { loadKinCourseBundle } from "../../../lib/kinCourse/load";
import {
  kinCourseLoadOptions,
  kinCourseNeedsAdminPreviewBootstrap,
  kinCoursePreviewRequested,
} from "../../../lib/kinCourse/request";
import { getCourseLandingBySlug } from "../../../lib/legacy_kin/courseLanding";

export const prerender = false;

const courseId = parseKinCourseId(Astro.params.courseSlug);
const previewRequested = kinCoursePreviewRequested(Astro.url);
const loadOptions = await kinCourseLoadOptions(Astro.url, Astro.request, Astro.cookies);
Astro.response.headers.set("Cache-Control", "no-store");

const bundle = courseId ? await loadKinCourseBundle(courseId, loadOptions) : null;
const showAdminPreviewBootstrap =
  Boolean(courseId) && kinCourseNeedsAdminPreviewBootstrap(previewRequested, bundle);
if (courseId && !bundle && !showAdminPreviewBootstrap) {
  return new Response("Course not found", { status: 404 });
}

const landing = courseId ? null : getCourseLandingBySlug(Astro.params.courseSlug ?? "");
if (!courseId && !landing) {
  return new Response("Course not found", { status: 404 });
}

if (showAdminPreviewBootstrap) {
  Astro.response.status = 404;
}
---

{
  bundle ? (
    <KinCourseHomeView bundle={bundle} preview={loadOptions.preview} />
  ) : landing ? (
    <CourseNamedLanding landing={landing} />
  ) : showAdminPreviewBootstrap ? (
    <KinCourseAdminPreviewBootstrap />
  ) : null
}
