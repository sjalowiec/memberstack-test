---
import Layout from "../../../../layouts/Layout.astro";
import LegacyCourseShell from "../../../../components/courses/legacy/LegacyCourseShell.astro";
import {
  getLegacyCourseBySlug,
  getLegacyLessonBySlug,
  legacyCourseLoadOptionsFromPreviewRequest,
  legacyLessonItemHref,
} from "../../../../lib/legacy_kin/legacyCourseLoader";
import { getFirstLessonContentItemSlug } from "../../../../lib/legacy_kin/courseLessonContentItems";

const courseSlug = Astro.params.courseSlug ?? "";
const lessonSlug = Astro.params.lessonSlug ?? "";
const loaderOptions = legacyCourseLoadOptionsFromPreviewRequest(
  Astro.url.searchParams.get("preview"),
  Astro.url.hostname,
  { isViteDev: import.meta.env.DEV, publicSiteEnv: import.meta.env.PUBLIC_SITE_ENV },
);
const course = getLegacyCourseBySlug(courseSlug, loaderOptions);
const lesson = getLegacyLessonBySlug(courseSlug, lessonSlug, loaderOptions);

if (!course || !lesson) {
  return new Response("Lesson not found", { status: 404 });
}

const firstItemSlug = getFirstLessonContentItemSlug(lesson);
if (firstItemSlug) {
  const previewQuery = loaderOptions.includeDrafts ? "?preview=true" : "";
  const search = Astro.url.search || previewQuery;
  return Astro.redirect(
    `${legacyLessonItemHref(courseSlug, lesson.slug, firstItemSlug)}${search}`,
  );
}

const pageTitle = `${lesson.title} · ${course.course.title} | Knit it Now`;
---

<Layout
  title={pageTitle}
  description={`${course.course.title} — ${lesson.title}`}
  skipGlobalHyvor
>
  <LegacyCourseShell
    {courseSlug}
    currentLessonSlug={lesson.slug}
    includeDrafts={loaderOptions.includeDrafts}
    previewQuery={loaderOptions.includeDrafts ? "?preview=true" : ""}
  >
    <article class="course-preview__content legacy-course__lesson">
      <header class="course-preview__section-header">
        <p class="course-preview__content-lesson">
          Lesson {lesson.displayOrder}
        </p>
        <h1 class="course-preview__content-title">{lesson.title}</h1>
      </header>
      <p class="legacy-course__empty-lesson">This lesson has no content yet.</p>
    </article>
  </LegacyCourseShell>
</Layout>

<style>
  .legacy-course__empty-lesson {
    margin: 1rem 0 0;
    color: #5a6450;
  }
</style>
