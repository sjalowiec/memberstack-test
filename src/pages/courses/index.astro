---
import Layout from "../../layouts/Layout.astro";

const title = "Courses | Knit it Now";
const description =
  "Temporary courses placeholder page for the original Knit it Now course library.";
---

<Layout {title} {description}>
  <section class="courses-placeholder-wrap">
    <div class="courses-placeholder-card">
      <h1>Courses Are Coming Soon</h1>

      <p>
        We're reorganizing the original Knit It Now course library and preparing
        it for the new site.
      </p>

      <p>
        Course access will be available here soon. In the meantime, you can
        explore videos, patterns, and other machine knitting resources.
      </p>

      <div class="courses-actions">
        <a href="/videos/" class="kbm-btn kbm-btn-accent">Explore Videos</a>
        <a href="/patterns/" class="kbm-btn">Browse Patterns</a>
      </div>

      <p class="courses-note">More course information will be added soon.</p>
    </div>
  </section>

  <style>
    .courses-placeholder-wrap {
      min-height: 58vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
    }

    .courses-placeholder-card {
      width: 100%;
      max-width: 760px;
      background: #fff;
      border: 1px solid #e6e6e6;
      border-radius: 12px;
      padding: 28px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
      text-align: center;
    }

    .courses-placeholder-card h1 {
      margin-top: 0;
      margin-bottom: 14px;
    }

    .courses-placeholder-card p {
      margin: 0 0 14px;
      line-height: 1.6;
    }

    .courses-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin: 20px 0 16px;
    }

    .courses-note {
      margin-bottom: 0;
      font-size: 0.95rem;
      color: #5a5a5a;
    }

    @media (max-width: 640px) {
      .courses-placeholder-card {
        padding: 22px 16px;
      }

      .courses-actions {
        flex-direction: column;
      }

      .courses-actions a {
        width: 100%;
      }
    }
  </style>
</Layout>
