---
import Layout from "../../layouts/Layout.astro";
import PageBackLink from "../../components/common/PageBackLink.astro";
import {
  getPatternById,
  getImagesForPattern,
  getFilesForPattern,
  getTechniqueById,
  getCategoriesForPattern
} from "../../lib/stitch-data";

/** Legacy Knit It Now stitch library — update if the production site origin changes. */
const KNIT_IT_NOW_STITCH_LIBRARY_ORIGIN = "https://www.knititnow.com";

const { id } = Astro.params;
const patternId = Number(id);

const pattern = getPatternById(patternId);

if (!pattern) {
  throw new Error("Pattern not found");
}

const images = getImagesForPattern(patternId);
const files = getFilesForPattern(patternId);
const technique = getTechniqueById(pattern.techniqueId);
const categories = getCategoriesForPattern(patternId);

type PatternWithSwatch = typeof pattern & { swatchUrl?: string };
type StitchImage = {
  filename?: string;
  order?: number;
  active?: boolean;
  mainImage?: boolean;
};
type StitchFile = {
  filename?: string;
  label?: string;
  filetype?: string;
  order?: number;
  active?: boolean;
};

const activeImages = (images as StitchImage[])
  .filter((img) => img.filename && img.active !== false)
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

const swatchUrl = (pattern as PatternWithSwatch).swatchUrl?.trim();
const mainSwatchFilename =
  swatchUrl ||
  activeImages.find((img) => img.mainImage)?.filename?.trim() ||
  activeImages[0]?.filename?.trim();

const heroSrc = mainSwatchFilename
  ? `/stitch-patterns/swatches/${pattern.techniqueId}/${mainSwatchFilename}`
  : "";

/** All gallery images for thumbnail strip + hero swap (single column when only one). */
const galleryThumbs = activeImages.filter((img) => img.filename);

const techniqueLabel = technique?.title?.trim() || "";
const metaLine = techniqueLabel
  ? `${techniqueLabel} · #${patternId}`
  : `#${patternId}`;
const swatchAlt = techniqueLabel
  ? `${techniqueLabel} stitch, reference #${patternId}`
  : `Machine-knitting swatch, reference #${patternId}`;
const rawTitle = pattern.title?.trim() || "";
const titleIsIdOnly = rawTitle === String(patternId);
const displayTitle = rawTitle && !titleIsIdOnly ? rawTitle : metaLine;

// Beta: legacy stitch pattern URL for the download CTA; may later be replaced with native member/download handling.
const legacyStitchPageSlug =
  rawTitle
    .trim()
    .toLowerCase()
    .replace(/['']/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "") || String(patternId);
const legacyStitchPatternPageUrl = `${KNIT_IT_NOW_STITCH_LIBRARY_ORIGIN}/knit/swatch/${patternId}/${legacyStitchPageSlug}`;

const pageTitle = `${displayTitle} · Stitch Library`;
const pageDescription = techniqueLabel
  ? `${techniqueLabel} stitch #${patternId} — pattern reference and downloads.`
  : `Stitch #${patternId} — machine knitting pattern reference and downloads.`;
const hasNotes = Boolean(pattern.notes && String(pattern.notes).trim());

const machineBits = [
  pattern.punchcard ? "Punchcard-capable machines" : null,
  pattern.lk150 ? "LK150-friendly" : null
].filter(Boolean);
const machineSummary =
  machineBits.length > 0 ? machineBits.join(" · ") : "See notes for machine details";

const categoryLinks = categories.flatMap((c) => {
  if (c == null || c.id == null) return [];
  const title = String(c.title || "").trim();
  const id = Number(c.id);
  if (!title || !Number.isFinite(id)) return [];
  return [{ id, title }];
});

const swatchBase = `/stitch-patterns/swatches/${pattern.techniqueId}/`;
const seenSlideSrc = new Set<string>();
const lightboxSlides: { src: string; alt: string }[] = [];
const pushSlide = (filename: string | undefined) => {
  if (!filename) return;
  const src = `${swatchBase}${filename}`;
  if (seenSlideSrc.has(src)) return;
  seenSlideSrc.add(src);
  lightboxSlides.push({ src, alt: swatchAlt });
};
if (mainSwatchFilename) pushSlide(mainSwatchFilename);
for (const img of activeImages) pushSlide(img.filename);

const activeFiles = (files as StitchFile[])
  .filter((f) => f.filename && f.active !== false)
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

const STITCH_FILE_ICON_FALLBACK = "/stitch-patterns/swatches/pdf_icon.jpg";

function stripExtension(name: string): string {
  const n = name.trim();
  const dot = n.lastIndexOf(".");
  if (dot <= 0 || dot === n.length - 1) return n;
  return n.slice(0, dot);
}

/** Icon from actual file extension (href basename). */
function getStitchFileIconPath(filename: string): string {
  const fn = filename.trim().toLowerCase();
  if (fn.endsWith(".stp")) return "/stitch-patterns/swatches/dak_icon.jpg";
  if (fn.endsWith(".pdf")) return "/stitch-patterns/swatches/pdf_icon.jpg";
  if (fn.endsWith(".stc")) return "/stitch-patterns/swatches/stc_icon.jpg";
  return STITCH_FILE_ICON_FALLBACK;
}

function getStitchFileCleanName(file: StitchFile): string {
  const raw = (file.label || file.filename || "").trim();
  return stripExtension(raw);
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  bodyClass="page--tight-header"
>
  <div class="page-wrap stitch-fe">
    <PageBackLink href="/stitch" text="All stitches" />
    <div class="stitch-fe__magazine">
      <div class="stitch-fe__visual">
        {heroSrc ? (
          <>
            <button
              type="button"
              class="stitch-fe__hero-hit"
              data-stitch-lightbox-root
              aria-label={`View full size: ${swatchAlt}`}
            >
              <img
                id="stitch-hero-img"
                class="stitch-fe__hero-img"
                src={heroSrc}
                alt={swatchAlt}
                width={900}
                height={900}
                loading="eager"
                decoding="async"
              />
            </button>

            {galleryThumbs.length > 1 ? (
              <div class="stitch-fe__thumb-row" role="tablist" aria-label="Swatch variations">
                {galleryThumbs.map((img) =>
                  img.filename ? (
                    <button
                      type="button"
                      class:list={[
                        "stitch-fe__thumb",
                        img.filename === mainSwatchFilename && "is-active"
                      ]}
                      role="tab"
                      aria-selected={img.filename === mainSwatchFilename ? "true" : "false"}
                      data-stitch-thumb-swap
                      data-full-src={`/stitch-patterns/swatches/${pattern.techniqueId}/${img.filename}`}
                      data-alt={swatchAlt}
                      aria-label={`Show swatch: ${img.filename}`}
                    >
                      <img
                        class="stitch-fe__thumb-img"
                        src={`/stitch-patterns/swatches/${pattern.techniqueId}/${img.filename}`}
                        alt=""
                        width={96}
                        height={96}
                        loading="lazy"
                        decoding="async"
                      />
                    </button>
                  ) : null
                )}
              </div>
            ) : null}
          </>
        ) : null}
      </div>

      <div class="stitch-fe__rail">
        <p class="stitch-fe__meta">{metaLine}</p>

        {hasNotes ? <div class="stitch-fe__intro" set:html={pattern.notes} /> : null}

        <section class="stitch-fe__specs" aria-labelledby="stitch-specs-heading">
          <h2 id="stitch-specs-heading">At a glance</h2>
          <dl class="stitch-fe__specs-list">
            <div class="stitch-fe__specs-row">
              <dt>Repeat</dt>
              <dd>{pattern.stitchMultiple || "—"}</dd>
            </div>
            <div class="stitch-fe__specs-row">
              <dt>Machine fit</dt>
              <dd>{machineSummary}</dd>
            </div>
            {categoryLinks.length > 0 ? (
              <div class="stitch-fe__specs-row">
                <dt>Categories</dt>
                <dd>
                  {categoryLinks.map((c, i) => (
                    <>
                      {i > 0 ? <span class="stitch-fe__cat-sep"> · </span> : null}
                      <a class="stitch-fe__cat-link" href={`/stitch?category=${c.id}`}>
                        {c.title}
                      </a>
                    </>
                  ))}
                </dd>
              </div>
            ) : null}
          </dl>
        </section>

        <div class="stitch-fe__vault">
          <h2>Pattern files & templates</h2>
         

          {activeFiles.length === 0 ? (
            <p class="stitch-fe__vault-empty">No files are listed for this pattern yet.</p>
          ) : (
            <>
              <div class="stitch-fe__vault-locked" data-gated="locked">
               
                <ul class="stitch-fe__vault-files" aria-label="Files included with membership">
                  {activeFiles.map((file) => {
                    const fn = file.filename || "";
                    const iconPath = getStitchFileIconPath(fn);
                    const cleanName = getStitchFileCleanName(file);
                    return (
                      <li class="stitch-fe__vault-file">
                        <div class="file-row file-row--locked">
                          <img
                            class="file-icon"
                            src={iconPath}
                            alt=""
                            width={20}
                            height={20}
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="file-name">{cleanName}</span>
                          <span class="stitch-fe__vault-lock" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                              <path
                                d="M7 11V8a5 5 0 0110 0v3M6 11h12v10H6V11z"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </span>
                        </div>
                      </li>
                    );
                  })}
                </ul>
                <div class="stitch-fe__vault-cta">
                  <a
                    class="kbm-btn kbm-btn-primary stitch-fe__vault-cta-btn"
                    href={legacyStitchPatternPageUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Download from Knit it Now (Members)
                  </a>
                  <p class="stitch-fe__vault-login">Downloads are currently available in the Knit It Now library.</p>
                </div>
              </div>

              <div class="stitch-fe__vault-open" data-gated="content" hidden>
                <ul class="stitch-fe__vault-files">
                  {activeFiles.map((file) => {
                    if (!file.filename) return null;
                    const href = `/stitch-patterns/swatches/${pattern.techniqueId}/${file.filename}`;
                    const iconPath = getStitchFileIconPath(file.filename);
                    const cleanName = getStitchFileCleanName(file);
                    return (
                      <li class="stitch-fe__vault-file">
                        <a
                          class="file-row"
                          href={href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <img
                            class="file-icon"
                            src={iconPath}
                            alt=""
                            width={20}
                            height={20}
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="file-name">{cleanName}</span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </>
          )}
        </div>
<!-- My Library section -->
 <!--
        <section class="stitch-fe__my-library" aria-labelledby="stitch-my-library-heading">
          <h2 id="stitch-my-library-heading">My Library</h2>
          <div
            class="stitch-fe__my-library-inner"
            data-stitch-my-library
            data-pattern-id={String(patternId)}
            hidden
          >
            <p class="stitch-fe__my-library-muted" data-stitch-my-library-guest hidden>
              Members can save stitches to My Library.
            </p>
            <div class="stitch-fe__my-library-member" data-stitch-my-library-member hidden>
              <div class="stitch-fe__my-library-row">
                <button type="button" class="kbm-btn kbm-btn-outline" data-stitch-my-library-save hidden>
                  Save to My Library
                </button>
                <div class="stitch-fe__my-library-saved" data-stitch-my-library-saved hidden>
                  <span class="stitch-fe__my-library-saved-pill" aria-live="polite">Saved</span>
                  <button type="button" class="stitch-fe__text-link" data-stitch-my-library-remove>
                    Remove
                  </button>
                </div>
              </div>
              <p class="stitch-fe__my-library-hint">
                <a href="/my-library">Open My Library</a>
              </p>
            </div>
          </div>
        </section>

      </div>
    </div>
  </div>
      -->
  <dialog
    class="stitch-fe__lightbox"
    id="stitch-ref-lightbox"
    aria-modal="true"
    aria-label="Full-size swatch"
  >
    <div class="stitch-fe__lightbox-inner">
      <button type="button" class="stitch-fe__lightbox-close" aria-label="Close">
        <span aria-hidden="true">×</span>
      </button>
      {lightboxSlides.length > 1 ? (
        <button type="button" class="stitch-fe__lightbox-prev" aria-label="Previous image">
          <span aria-hidden="true">‹</span>
        </button>
      ) : null}
      {lightboxSlides.length > 1 ? (
        <button type="button" class="stitch-fe__lightbox-next" aria-label="Next image">
          <span aria-hidden="true">›</span>
        </button>
      ) : null}
      <img class="stitch-fe__lightbox-img" src="" alt="" decoding="async" />
    </div>
  </dialog>

  <script define:vars={{ lightboxSlides }}>
    (function () {
      var slides = lightboxSlides;
      if (!Array.isArray(slides)) slides = [];
      var dialog = document.getElementById("stitch-ref-lightbox");
      var inner = dialog ? dialog.querySelector(".stitch-fe__lightbox-inner") : null;
      var imgEl = dialog ? dialog.querySelector(".stitch-fe__lightbox-img") : null;
      var btnClose = dialog ? dialog.querySelector(".stitch-fe__lightbox-close") : null;
      var btnPrev = dialog ? dialog.querySelector(".stitch-fe__lightbox-prev") : null;
      var btnNext = dialog ? dialog.querySelector(".stitch-fe__lightbox-next") : null;
      var heroImg = document.getElementById("stitch-hero-img");
      var idx = 0;
      var multi = slides.length > 1;

      function findIndexForSrc(src) {
        for (var i = 0; i < slides.length; i++) {
          if (slides[i] && slides[i].src === src) return i;
        }
        return 0;
      }

      function showIndex(i) {
        if (!slides.length || !imgEl) return;
        idx = (i + slides.length) % slides.length;
        var s = slides[idx];
        var base = (s && s.alt) || "Swatch image";
        imgEl.src = s.src;
        imgEl.alt = multi ? base + " — " + (idx + 1) + " of " + slides.length : base;
      }

      function openLightboxFromHero() {
        if (!dialog || !slides.length || !heroImg) return;
        var src = heroImg.getAttribute("src");
        if (src) showIndex(findIndexForSrc(src));
        else showIndex(0);
        dialog.showModal();
        if (btnClose && typeof btnClose.focus === "function") btnClose.focus();
      }

      function closeLightbox() {
        if (dialog && typeof dialog.close === "function") dialog.close();
      }

      document.querySelectorAll("[data-stitch-lightbox-root]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          openLightboxFromHero();
        });
      });

      document.querySelectorAll("[data-stitch-thumb-swap]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var src = btn.getAttribute("data-full-src");
          var alt = btn.getAttribute("data-alt") || "";
          if (heroImg && src) {
            heroImg.src = src;
            heroImg.alt = alt;
            document.querySelectorAll("[data-stitch-thumb-swap]").forEach(function (b) {
              var on = b === btn;
              b.classList.toggle("is-active", on);
              b.setAttribute("aria-selected", on ? "true" : "false");
            });
          }
        });
      });

      if (btnClose && dialog) {
        btnClose.addEventListener("click", function (e) {
          e.stopPropagation();
          closeLightbox();
        });
      }

      if (inner && dialog && imgEl) {
        inner.addEventListener("click", function (e) {
          var t = e.target;
          if (t && t.closest && t.closest("button")) return;
          if (t === imgEl) return;
          closeLightbox();
        });
      }

      if (dialog) {
        dialog.addEventListener("click", function (e) {
          if (e.target === dialog) closeLightbox();
        });
      }

      if (btnPrev) {
        btnPrev.addEventListener("click", function (e) {
          e.stopPropagation();
          showIndex(idx - 1);
        });
      }
      if (btnNext) {
        btnNext.addEventListener("click", function (e) {
          e.stopPropagation();
          showIndex(idx + 1);
        });
      }

      if (dialog && multi) {
        dialog.addEventListener("keydown", function (e) {
          if (e.key === "ArrowLeft") {
            e.preventDefault();
            showIndex(idx - 1);
          } else if (e.key === "ArrowRight") {
            e.preventDefault();
            showIndex(idx + 1);
          }
        });
      }
    })();
  </script>

  <script>
    const MEMBER_PLAN_IDS = new Set([
      "pln_dev-kin-member-eim6011h",
      "pln_kin-membership-monthly-a59701wy",
      "pln_kin-membership-annual-qf9g01et"
    ]);

    async function waitForMemberstackReady({ attempts = 30, delayMs = 200 } = {}) {
      for (let i = 0; i < attempts; i++) {
        try {
          const api = window.$memberstackDom?.getAppAndMember;
          if (typeof api === "function") return await api();
        } catch (e) {
          /* continue */
        }
        await new Promise((r) => setTimeout(r, delayMs));
      }
      return null;
    }

    function getViewerStateFromRes(res: unknown) {
      const r = res as { data?: { member?: Record<string, unknown> } } | null | undefined;
      const member = r?.data?.member ?? null;
      const planConnections = (member?.planConnections as Record<string, unknown>[]) ?? [];
      const activePlanIds = new Set(
        planConnections
          .filter((p) => String(p?.status ?? "").toUpperCase() === "ACTIVE")
          .map((p) => p?.planId as string)
          .filter(Boolean)
      );
      const isLoggedIn = Boolean(member);
      const isMember = [...activePlanIds].some((id) => MEMBER_PLAN_IDS.has(id));
      return { isLoggedIn, isMember, member };
    }

    function setFileAccess(hasFullAccess: boolean) {
      document.querySelectorAll('.stitch-fe__vault-open[data-gated="content"]').forEach((el) => {
        if (hasFullAccess) el.removeAttribute("hidden");
        else el.setAttribute("hidden", "");
      });
      document.querySelectorAll('.stitch-fe__vault-locked[data-gated="locked"]').forEach((el) => {
        if (hasFullAccess) el.setAttribute("hidden", "");
        else el.removeAttribute("hidden");
      });
    }

    const libraryPatternId = Number(
      document.querySelector("[data-stitch-my-library]")?.getAttribute("data-pattern-id")
    );
    const libraryOk = Number.isFinite(libraryPatternId);

    async function myLibraryAuthHeaders(): Promise<Record<string, string>> {
      const ms = window.$memberstackDom;
      const gc = ms?.getMemberCookie;
      if (typeof gc === "function") {
        try {
          const t = await Promise.resolve(gc.call(ms));
          if (typeof t === "string" && t.trim()) return { Authorization: `Bearer ${t.trim()}` };
        } catch {
          /* ignore */
        }
      }
      return {};
    }

    async function myLibraryFetch(path: string, init: RequestInit = {}) {
      const headers = new Headers(init.headers);
      if (!headers.has("Accept")) headers.set("Accept", "application/json");
      const extra = await myLibraryAuthHeaders();
      if (extra.Authorization) headers.set("Authorization", extra.Authorization);
      return fetch(path, { credentials: "include", ...init, headers });
    }

    function setMyLibraryUI(viewer: { isMember: boolean }) {
      if (!libraryOk) return;
      const root = document.querySelector("[data-stitch-my-library]");
      if (!root || !(root instanceof HTMLElement)) return;
      const guest = root.querySelector("[data-stitch-my-library-guest]");
      const member = root.querySelector("[data-stitch-my-library-member]");
      const btnSave = root.querySelector("[data-stitch-my-library-save]");
      const rowSaved = root.querySelector("[data-stitch-my-library-saved]");
      root.removeAttribute("hidden");
      if (!viewer.isMember) {
        guest instanceof HTMLElement && guest.removeAttribute("hidden");
        member instanceof HTMLElement && member.setAttribute("hidden", "");
        return;
      }
      guest instanceof HTMLElement && guest.setAttribute("hidden", "");
      member instanceof HTMLElement && member.removeAttribute("hidden");
      btnSave instanceof HTMLElement && btnSave.removeAttribute("hidden");
      rowSaved instanceof HTMLElement && rowSaved.setAttribute("hidden", "");
    }

    async function refreshMyLibrarySavedState(viewer: { isMember: boolean }) {
      if (!libraryOk) return;
      const root = document.querySelector("[data-stitch-my-library]");
      if (!root || !viewer.isMember) return;
      const btnSave = root.querySelector("[data-stitch-my-library-save]");
      const rowSaved = root.querySelector("[data-stitch-my-library-saved]");
      try {
        const res = await myLibraryFetch(
          `/api/my-library/stitches?check=${encodeURIComponent(String(libraryPatternId))}`
        );
        const data = (await res.json()) as { ok?: boolean; saved?: boolean };
        const saved = Boolean(res.ok && data?.ok && data.saved);
        if (btnSave instanceof HTMLElement) btnSave.toggleAttribute("hidden", saved);
        if (rowSaved instanceof HTMLElement) rowSaved.toggleAttribute("hidden", !saved);
      } catch {
        /* leave defaults */
      }
    }

    (async () => {
      setFileAccess(false);
      if (window.__DEV_BYPASS_GATING || window.__KBM_DEV_MEMBER__) {
        setFileAccess(true);
        if (libraryOk) {
          setMyLibraryUI({ isMember: true });
          await refreshMyLibrarySavedState({ isMember: true });
          wireMyLibraryActions();
        }
        return;
      }
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get("mode") === "full") {
        setFileAccess(true);
        if (libraryOk) {
          setMyLibraryUI({ isMember: true });
          await refreshMyLibrarySavedState({ isMember: true });
          wireMyLibraryActions();
        }
        return;
      }
      async function refreshFileAccess() {
        if (window.__DEV_BYPASS_GATING || window.__KBM_DEV_MEMBER__) {
          setFileAccess(true);
          if (libraryOk) {
            setMyLibraryUI({ isMember: true });
            await refreshMyLibrarySavedState({ isMember: true });
          }
          return;
        }
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get("mode") === "full") {
          setFileAccess(true);
          if (libraryOk) {
            setMyLibraryUI({ isMember: true });
            await refreshMyLibrarySavedState({ isMember: true });
          }
          return;
        }
        try {
          const api = window.$memberstackDom?.getAppAndMember;
          const res = typeof api === "function" ? await api() : await waitForMemberstackReady();
          const viewer = getViewerStateFromRes(res);
          setFileAccess(Boolean(viewer.isMember));
          setMyLibraryUI(viewer);
          if (viewer.isMember) await refreshMyLibrarySavedState(viewer);
        } catch {
          setFileAccess(false);
          setMyLibraryUI({ isMember: false });
        }
      }

      function wireMyLibraryActions() {
        if (!libraryOk) return;
        const root = document.querySelector("[data-stitch-my-library]");
        if (!root) return;
        const btnSave = root.querySelector("[data-stitch-my-library-save]");
        const btnRemove = root.querySelector("[data-stitch-my-library-remove]");
        btnSave?.addEventListener("click", async () => {
          try {
            const res = await myLibraryFetch("/api/my-library/stitches", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ patternId: libraryPatternId }),
            });
            const data = (await res.json()) as { ok?: boolean };
            if (res.ok && data?.ok) await refreshMyLibrarySavedState({ isMember: true });
          } catch {
            /* ignore */
          }
        });
        btnRemove?.addEventListener("click", async () => {
          try {
            const res = await myLibraryFetch(
              `/api/my-library/stitches?patternId=${encodeURIComponent(String(libraryPatternId))}`,
              { method: "DELETE" }
            );
            const data = (await res.json()) as { ok?: boolean };
            if (res.ok && data?.ok) await refreshMyLibrarySavedState({ isMember: true });
          } catch {
            /* ignore */
          }
        });
      }

      await refreshFileAccess();
      if (libraryOk) wireMyLibraryActions();
      window.addEventListener("auth:updated", () => {
        void refreshFileAccess();
      });
    })();
  </script>

  <style>
