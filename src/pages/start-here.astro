---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Start Here | Knit it Now"
  description="New to the new Knit it Now? Start here."
>

  <section class="container py-5 start-here-page">
    <div class="start-here-inner">
      <header class="start-here-header">
        <h1>Start Here</h1>
        <p class="start-here-intro">
          Welcome to the new Knit it Now.<br />
          Here are two great places to begin exploring.
        </p>
      </header>

      <div class="start-here-choice-grid">
        <article class="kbm-card start-here-card">
          <h2 class="kbm-card__title">Explore Knit It Now</h2>
          <p class="kbm-card__desc">
            Browse pattern builders, skill builders, videos, courses, tools, and references to discover everything Knit It Now has to offer.
          </p>
          <a href="/#explore" class="kbm-btn kbm-btn-primary">Explore the Site</a>
        </article>

        <article class="kbm-card start-here-card">
          <h2 class="kbm-card__title">Explore the Help Hub</h2>
          <p class="kbm-card__desc">
            Find answers, learn new techniques, and build your machine knitting skills one lesson at a time.
          </p>
          <a href="/help-hub" class="kbm-btn kbm-btn-primary">Explore the Help Hub</a>
        </article>
      </div>

      <p class="start-here-footnote">
        Explore at your own pace and return whenever you need help with your machine knitting.
      </p>
    </div>
  </section>

  <style>
    .start-here-inner {
      max-width: 960px;
      margin: 0 auto;
    }

    .start-here-header {
      margin-bottom: 2.5rem;
      text-align: center;
    }

    .start-here-header h1 {
      font-size: var(--text-xxl);
      font-weight: 600;
      color: var(--kbm-green);
      margin: 0 0 1rem 0;
    }

    .start-here-intro {
      font-size: var(--text-lg);
      color: #243015;
      line-height: 1.65;
      margin: 0 auto;
      max-width: 36rem;
    }

    .start-here-choice-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 2.5rem;
    }

    @media (min-width: 768px) {
      .start-here-choice-grid {
        grid-template-columns: 1fr 1fr;
        gap: 1.75rem;
      }
    }

    .start-here-card.kbm-card {
      cursor: default;
      margin: 0;
    }

    .start-here-footnote {
      font-size: var(--text-base);
      color: #6b7280;
      line-height: 1.6;
      text-align: center;
      margin: 0 auto;
      max-width: 40rem;
    }
  </style>
</Layout>
