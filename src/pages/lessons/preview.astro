---
import LessonPage from "../../components/lessons/LessonPage.astro";
import { requireAdminForRequest, adminAuthErrorBody } from "../../lib/admin/requireAdminRequest";
import { resolveLessonPreviewRecord } from "../../lib/lessons/previewDocument";
import { loadPublicHelpHubTips } from "../../lib/helpHub/loadTips";
import { loadLessonBySlug, loadPublicLessons } from "../../lib/lessons/loadLessons";
import { prepareLessonPage } from "../../lib/lessons/prepareLessonPage";

export const prerender = false;

function jsonError(status: number, error: string) {
  return new Response(JSON.stringify({ ok: false, error }), {
    status,
    headers: {
      "Content-Type": "application/json",
      "Cache-Control": "no-store",
      Allow: "POST",
    },
  });
}

if (Astro.request.method !== "POST") {
  return jsonError(405, "Preview requires an authenticated POST.");
}

const auth = await requireAdminForRequest(Astro.request, Astro.cookies);
if (!auth.ok) {
  return new Response(JSON.stringify(adminAuthErrorBody(auth)), {
    status: auth.status,
    headers: { "Content-Type": "application/json", "Cache-Control": "no-store" },
  });
}

if (!Astro.request.headers.get("content-type")?.includes("application/json")) {
  return jsonError(400, "Content-Type must be application/json");
}

let body: unknown;
try {
  body = await Astro.request.json();
} catch {
  return jsonError(400, "Invalid JSON body");
}

const resolved = await resolveLessonPreviewRecord(body, async (slug) => {
  return loadLessonBySlug(slug);
});
if (!resolved.ok) {
  return jsonError(resolved.status, resolved.error);
}

const allLessons = await loadPublicLessons();
const helpHubTips = await loadPublicHelpHubTips();
const view = await prepareLessonPage(resolved.lesson, {
  requestUrl: new URL(Astro.request.url),
  allLessons,
  helpHubTips,
  preview: true,
});

Astro.response.headers.set("Cache-Control", "no-store");
---

<LessonPage {...view} preview={true} />
