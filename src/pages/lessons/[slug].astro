---
import Layout from "../../layouts/Layout.astro";
import lessonsFile from "../../data/lessons.json";
import helpHubFile from "../../data/help-hub.json";

type Lesson = {
  id: number;
  slug: string;
  title: string;
  summary?: string;
  type: string;
  /** Vimeo player URL, or numeric id as string or number (e.g. `1175910979`). */
  vimeoEmbedUrl?: string | number;
  access: string;
  encouragement?: string;
  exerciseTitle?: string;
  exerciseItems?: string[];
  templateLink?: string;
  templateLinkText?: string;
  supportImage?: string;
  supportImageAlt?: string;
  noteTitle?: string;
  noteText?: string;
  relatedTipSlug?: string;
  nextLessonSlug?: string;
};

type HelpHubTip = {
  slug?: string;
  relatedLessons?: string[];
};

const lessons = lessonsFile as Lesson[];
const helpHubTips = helpHubFile as HelpHubTip[];

const { slug } = Astro.params;

const lesson = lessons.find((lesson) => lesson.slug === slug);

if (!lesson) {
  throw new Error("Lesson not found");
}

/** Raw Vimeo field from JSON: trim string or coerce finite number to string. */
function lessonVimeoRawString(l: Pick<Lesson, "vimeoEmbedUrl">): string {
  const v = l.vimeoEmbedUrl;
  if (typeof v === "number" && Number.isFinite(v)) return String(Math.trunc(v));
  if (typeof v === "string") return v.trim();
  return "";
}

/** Vimeo numeric id from embed URL or raw digits (matching relatedLessons refs only). */
function vimeoNumericIdFromLesson(l: Pick<Lesson, "vimeoEmbedUrl">): string | null {
  const raw = lessonVimeoRawString(l);
  if (!raw) return null;
  if (/^\d+$/.test(raw)) return raw;
  const m = raw.match(/\/(?:video\/)?(\d+)(?:\?|#|$)/);
  return m ? m[1] : null;
}

function lessonMatchesRelatedRef(ref: string, current: Lesson): boolean {
  const trimmed = ref.trim();
  if (!trimmed) return false;
  if (current.slug.trim() === trimmed) return true;
  if (/^\d+$/.test(trimmed)) return vimeoNumericIdFromLesson(current) === trimmed;
  return false;
}

function findTipForLesson(lessonRow: Lesson): HelpHubTip | undefined {
  const explicit = typeof lessonRow.relatedTipSlug === "string" ? lessonRow.relatedTipSlug.trim() : "";
  if (explicit) {
    return helpHubTips.find((t) => typeof t.slug === "string" && t.slug.trim() === explicit);
  }
  return helpHubTips.find(
    (t) =>
      Array.isArray(t.relatedLessons) &&
      t.relatedLessons.some((r) => lessonMatchesRelatedRef(String(r), lessonRow)),
  );
}

const relatedTip = findTipForLesson(lesson);
const relatedTipSlug =
  relatedTip && typeof relatedTip.slug === "string" && relatedTip.slug.trim() !== ""
    ? relatedTip.slug.trim()
    : null;
const relatedTipHref = relatedTipSlug ? `/help-hub/${relatedTipSlug}` : null;

/** Vimeo iframe `src`: full URL if value starts with http(s); otherwise treat as Vimeo id → player embed URL. */
function vimeoIframeSrc(raw: string): string {
  const t = raw.trim();
  if (!t) return "";
  if (/^https?:\/\//i.test(t)) return t;
  return `https://player.vimeo.com/video/${t}`;
}

const vimeoRawStr = lessonVimeoRawString(lesson);
const vimeoPlayerSrc = vimeoRawStr ? vimeoIframeSrc(vimeoRawStr) : "";

const hasLessonVideo = lesson.type === "video" && vimeoPlayerSrc.length > 0;

const supportImageForPreview =
  typeof lesson.supportImage === "string" && lesson.supportImage.trim() !== ""
    ? lesson.supportImage.trim()
    : "";
const videoPreviewUsesSupportImage = supportImageForPreview.length > 0;
const videoOpenLabel = `Play video: ${lesson.title}`;

/** Same URL is already the video preview thumb; omit duplicate img in `.lesson-support`. */
const supportImageDuplicateOfVideoPreview = hasLessonVideo && videoPreviewUsesSupportImage;
const showSupportImageInCard =
  typeof lesson.supportImage === "string" &&
  lesson.supportImage.trim() !== "" &&
  !supportImageDuplicateOfVideoPreview;

const hasSupportCard =
  showSupportImageInCard ||
  (typeof lesson.noteTitle === "string" && lesson.noteTitle.trim() !== "") ||
  (typeof lesson.noteText === "string" && lesson.noteText.trim() !== "");
---

<Layout>
  <main class="site-content">
    <div class="container">
      {relatedTipHref && (
        <div class="lesson-nav-back">
          <a class="kbm-btn kbm-btn-outline" href={relatedTipHref}>Back to Tip</a>
        </div>
      )}
      <div class="lesson-header">
        <img
          src="/images/help-hub.svg"
                 alt="Knit it Now Lesson Icon"
          class="lesson-header-icon"
        />
        <h1>{lesson.title}</h1>
      </div>

      <div class="lesson-grid">
        <!-- LEFT COLUMN -->
        <div class="lesson-content">
          {lesson.summary && <div set:html={lesson.summary}></div>}

          {lesson.encouragement && (
            <div class="lesson-encouragement">
              <div set:html={lesson.encouragement} />
            </div>
          )}

          {typeof lesson.templateLink === "string" && lesson.templateLink.trim() !== "" && (
            <p class="lesson-template">
              <a
                href={lesson.templateLink}
                class="kbm-btn kbm-btn-outline"
                target="_blank"
                rel="noopener"
              >
                {typeof lesson.templateLinkText === "string" && lesson.templateLinkText.trim() !== ""
                  ? lesson.templateLinkText
                  : "Download"}
              </a>
            </p>
          )}

          {lesson.exerciseItems && lesson.exerciseItems.length > 0 && (
            <section class="lesson-exercise" id="lesson-exercise">
              <div class="lesson-exercise__brand" aria-hidden="true">
                <img
                  class="lesson-exercise__brand-logo"
                  src="/KINlogo.svg"
                  alt=""
                  width="28"
                  height="28"
                />
                <div class="lesson-exercise__brand-text">
                  <span class="lesson-exercise__brand-name">Knit it Now</span>
                  <span class="lesson-exercise__brand-label">Lesson Worksheet</span>
                </div>
              </div>
              <h1 class="lesson-exercise__print-title">{lesson.title}</h1>
              <div class="lesson-exercise__header">
                <h2 class="lesson-exercise__title">Follow These Steps</h2>
                <button
                  type="button"
                  class="lesson-exercise__print"
                  onclick="printLessonExercise()"
                >
                  Print Steps
                </button>
              </div>
              <ol class="lesson-exercise__list">
                {lesson.exerciseItems.map((item) => (
                  <li class="lesson-exercise__item" set:html={item}></li>
                ))}
              </ol>
              <footer class="lesson-exercise__print-footer">knititnow.com</footer>
            </section>
          )}
        </div>

        <!-- RIGHT COLUMN -->
        <div class="lesson-media">
          {hasLessonVideo && (
            <div class="lesson-video-card">
              <button
                type="button"
                class="lesson-video-thumb"
                id="lesson-video-open"
                aria-haspopup="dialog"
                aria-controls="lesson-video-modal"
                aria-label={videoOpenLabel}
              >
                {videoPreviewUsesSupportImage ? (
                  <img
                    src={supportImageForPreview}
                    alt=""
                    class="lesson-video-thumb__img"
                    width="640"
                    height="360"
                    loading="lazy"
                  />
                ) : (
                  <div class="lesson-video-thumb__placeholder" aria-hidden="true">
                    <span class="lesson-video-thumb__placeholder-text">Watch the lesson</span>
                  </div>
                )}
                <span class="lesson-video-thumb__play" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </button>
              <p class="lesson-video-thumb__hint">Watch the lesson</p>
            </div>
          )}

          {hasSupportCard && (
            <div class="lesson-support">
              {showSupportImageInCard && (
                <img
                  src={lesson.supportImage}
                  alt={
                    typeof lesson.supportImageAlt === "string" && lesson.supportImageAlt.trim() !== ""
                      ? lesson.supportImageAlt
                      : lesson.title
                  }
                  class="lesson-support-image"
                  loading="lazy"
                />
              )}
              {((typeof lesson.noteTitle === "string" && lesson.noteTitle.trim() !== "") ||
                (typeof lesson.noteText === "string" && lesson.noteText.trim() !== "")) && (
                <div class="lesson-support-note">
                  {typeof lesson.noteTitle === "string" && lesson.noteTitle.trim() !== "" && (
                    <h3>{lesson.noteTitle}</h3>
                  )}
                  {typeof lesson.noteText === "string" && lesson.noteText.trim() !== "" && (
                    <div class="lesson-support-note__html" set:html={lesson.noteText} />
                  )}
                </div>
              )}
            </div>
          )}
        </div>
      </div>

      {hasLessonVideo && (
        <dialog
          id="lesson-video-modal"
          class="lesson-video-modal"
          aria-labelledby="lesson-video-modal-title"
          data-player-src={vimeoPlayerSrc}
        >
          <div class="lesson-video-modal__inner">
            <button type="button" class="lesson-video-modal__close" aria-label="Close video">
              ×
            </button>
            <h2 id="lesson-video-modal-title" class="lesson-video-modal__sr-title">
              Lesson video
            </h2>
            <div class="lesson-video-modal__frame-wrap">
              <iframe
                id="lesson-video-modal-iframe"
                title={lesson.title}
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
              />
            </div>
          </div>
        </dialog>
      )}
    </div>
  </main>
</Layout>

{hasLessonVideo && (
  <script is:inline>
    (function () {
      var openBtn = document.getElementById("lesson-video-open");
      var dialog = document.getElementById("lesson-video-modal");
      var iframe = document.getElementById("lesson-video-modal-iframe");
      var closeBtn = dialog ? dialog.querySelector(".lesson-video-modal__close") : null;
      if (!openBtn || !dialog || !iframe) return;

      var baseSrc = dialog.getAttribute("data-player-src") || "";

      function withAutoplay(url) {
        if (!url) return "";
        return url + (url.indexOf("?") >= 0 ? "&" : "?") + "autoplay=1";
      }

      function openModal() {
        if (!baseSrc) return;
        iframe.setAttribute("src", withAutoplay(baseSrc));
        dialog.showModal();
        document.body.style.overflow = "hidden";
      }

      function closeModal() {
        iframe.removeAttribute("src");
        dialog.close();
        document.body.style.overflow = "";
      }

      openBtn.addEventListener("click", function () {
        openModal();
      });

      if (closeBtn) {
        closeBtn.addEventListener("click", function () {
          closeModal();
        });
      }

      dialog.addEventListener("click", function (e) {
        if (e.target === dialog) closeModal();
      });

      dialog.addEventListener("cancel", function (e) {
        e.preventDefault();
        closeModal();
      });
    })();
  </script>
)}

<style>
  .site-content {
    padding-top: 1rem;
  }

  .lesson-nav-back {
    margin-bottom: 1rem;
  }

  .lesson-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 300px);
    gap: 2rem;
    align-items: start;
  }

  .lesson-video-card {
    margin: 0;
  }

  .lesson-video-thumb {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 1px solid #d9ddd2;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    background: #0f172a;
    text-align: left;
    box-sizing: border-box;
  }

  .lesson-video-thumb:hover,
  .lesson-video-thumb:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }

  .lesson-video-thumb__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .lesson-video-thumb__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    background: #0f172a;
    color: rgba(255, 255, 255, 0.92);
  }

  .lesson-video-thumb__placeholder-text {
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    padding: 0 0.75rem;
    position: relative;
    z-index: 1;
  }

  .lesson-video-thumb__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    color: #fff;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
  }

  .lesson-video-thumb__play::before {
    content: "";
    position: absolute;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
  }

  .lesson-video-thumb__play svg {
    position: relative;
    z-index: 1;
    margin-left: 3px;
    color: #243015;
  }

  .lesson-video-thumb__hint {
    margin: 0.5rem 0 0 0;
    font-size: 0.9rem;
    color: #555;
    text-align: center;
  }

  /* Closed <dialog> must stay display:none; author `display:flex` was overriding UA and showed a huge black panel. */
  .lesson-video-modal {
    padding: 0;
    border: none;
    margin: 0;
    max-width: none;
    background: transparent;
    display: none;
  }

  .lesson-video-modal[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    box-sizing: border-box;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .lesson-video-modal::backdrop {
    background: rgba(0, 0, 0, 0.62);
  }

  .lesson-video-modal__inner {
    position: relative;
    width: min(920px, 100%);
    max-height: min(85dvh, 100%);
    padding: 0.65rem;
    background: #111;
    border-radius: 12px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    flex-shrink: 0;
  }

  .lesson-video-modal__close {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    z-index: 2;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    margin: 0;
    border: none;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.92);
    color: #243015;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lesson-video-modal__close:hover,
  .lesson-video-modal__close:focus-visible {
    background: #fff;
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 1px;
  }

  .lesson-video-modal__sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .lesson-video-modal__frame-wrap {
    flex: 1;
    min-height: 0;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: min(72dvh, calc((100vw - 3rem) * 9 / 16));
  }

  .lesson-video-modal__frame-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 8px;
    display: block;
  }

  .lesson-support {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
  }

  .lesson-support-image {
    width: 100%;
    border-radius: 10px;
  }

  .lesson-support-note {
    background: #f5f5f5;
    padding: 1rem;
    border-radius: 10px;
  }

  .lesson-support-note__html {
    font-size: 0.95rem;
    line-height: 1.55;
    color: inherit;
  }

  .lesson-support-note__html :first-child {
    margin-top: 0;
  }

  .lesson-support-note__html :last-child {
    margin-bottom: 0;
  }

  .lesson-content {
    display: grid;
    gap: 1rem;
  }

  .lesson-encouragement {
    background: #f5f5f5;
    padding: 1rem;
    border-radius: 10px;
  }

  .lesson-template .kbm-btn {
    margin-top: 0.5rem;
  }

  .lesson-exercise {
  margin-top: 1.5rem;
  background: #f5f5f5;
  border: 1px solid #d9ddd2;
  border-radius: 12px;
  padding: 1.25rem;
  display: grid;
  gap: 1rem;
}

  .lesson-exercise__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .lesson-exercise__title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .lesson-exercise__print {
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  border: 1px solid #52682D;
  background: #ffffff;
  color: #52682D;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  line-height: 1.2;
}

.lesson-exercise__print:hover {
  background: #f5f5f5;
}

  .lesson-exercise__list {
    list-style-position: outside;
    padding-left: 1.35rem;
    margin: 0;
  }
  .lesson-header {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.lesson-header-icon {
  width: 48px;
  height: 48px;
  object-fit: contain;
  margin-top: 4px;
}
  .lesson-exercise__item {
    margin-bottom: 0.7rem;
    padding-left: 0.25rem;
    line-height: 1.55;
  }

  .lesson-exercise__item:last-child {
    margin-bottom: 0;
  }

  .lesson-exercise__print-title {
    display: none;
    margin: 0;
  }

  .lesson-exercise__brand,
  .lesson-exercise__print-footer {
    display: none;
  }

  @media print {
    :global(body.print-exercise-only),
    :global(body.print-exercise-only *) {
      visibility: hidden !important;
      box-shadow: none !important;
      background: transparent !important;
    }

    :global(body.print-exercise-only #lesson-exercise),
    :global(body.print-exercise-only #lesson-exercise *) {
      visibility: visible !important;
    }

    :global(body.print-exercise-only #lesson-exercise) {
      position: absolute !important;
      top: 0;
      left: 0;
      width: 100%;
      border: 0;
      border-radius: 0;
      margin: 0;
      padding: 0.25in;
      color: #000;
      background: #fff !important;
    }

    .lesson-exercise__print {
      display: none !important;
    }

    .lesson-exercise__header {
      margin-bottom: 0.75rem;
    }

    .lesson-exercise__brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding-bottom: 0.65rem;
      margin-bottom: 0.75rem;
      border-bottom: 1px solid #ccc;
    }

    .lesson-exercise__brand-logo {
      width: 28px;
      height: 28px;
      object-fit: contain;
      flex-shrink: 0;
    }

    .lesson-exercise__brand-text {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      line-height: 1.2;
    }

    .lesson-exercise__brand-name {
      font-weight: 700;
      font-size: 0.95rem;
    }

    .lesson-exercise__brand-label {
      font-size: 0.72rem;
      font-weight: 400;
      color: #555;
    }

    .lesson-exercise__print-title {
      display: block;
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .lesson-exercise__print-footer {
      display: block;
      margin-top: 1rem;
      padding-top: 0.5rem;
      border-top: 1px solid #ddd;
      font-size: 0.8rem;
      color: #444;
      text-align: center;
    }

    .lesson-exercise__list {
      list-style: decimal outside;
      padding-left: 1.2rem;
      margin: 0;
    }

    @page {
      size: auto;
      margin: 0.5in;
    }
  }

  @media (max-width: 768px) {
    .lesson-grid {
      grid-template-columns: 1fr;
    }

    .lesson-media {
      order: -1;
      max-width: 320px;
      margin-left: auto;
      margin-right: auto;
      width: 100%;
    }
  }

  :global(footer) {
    margin-top: 60px;
  }
</style>
<script is:inline>
  function printLessonExercise() {
    document.body.classList.add("print-exercise-only");
    window.print();
  }

  window.addEventListener("afterprint", () => {
    document.body.classList.remove("print-exercise-only");
  });
</script>