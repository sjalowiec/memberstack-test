---
import Layout from "../../layouts/Layout.astro";
import lessonsFile from "../../data/lessons.json";
import helpHub from "../../data/help-hub.json";
import videosPublic from "../../data/videos-public.json";
import {
  findPublicVideoByKey,
  vimeoNumericIdFromPublicVideo,
  type PublicVideoRow,
} from "../../lib/lessonVideo";
import GatedVimeoEmbed from "../../components/videos/GatedVimeoEmbed.astro";
import GlossaryHtml from "../../components/GlossaryHtml.astro";
import {
  filterPublicHelpHubTips,
  findPublicHelpHubTipBySlug,
  type HelpHubTipRecord,
} from "../../lib/helpHubPublic";
import { filterPublicCatalogVideos } from "../../lib/videoPublic";

type LessonBodyBlock =
  | { type: "text"; content?: string }
  | { type: "vimeo"; title?: string; vimeoId?: string | number };

type Lesson = {
  id: number;
  slug: string;
  title: string;
  summary?: string;
  type: string;
  /** Stable key into `videos-public.json`. */
  videoSlug?: string;
  /** @deprecated Prefer `videoSlug`; retained for legacy rows. */
  vimeoEmbedUrl?: string | number;
  access: string;
  encouragement?: string;
  exerciseTitle?: string;
  exerciseItems?: string[];
  templateLink?: string;
  templateLinkText?: string;
  supportImage?: string;
  supportImageAlt?: string;
  noteTitle?: string;
  noteText?: string;
  relatedTipSlug?: string;
  /** Help Hub tip slugs or numeric ids from `help-hub.json`. */
  relatedHelpHubs?: (string | number)[];
  nextLessonSlug?: string;
  /** Video library slugs (`videos-public.json` stable key). */
  videos?: string[];
  /** Inline player: use with `mediaUrl` (Vimeo numeric id or URL fragment). */
  mediaType?: string;
  mediaUrl?: string;
  /** Ordered text / Vimeo segments for the lesson body (preferred when non-empty). */
  blocks?: LessonBodyBlock[];
  /** When set to `draft`, the lesson is not served at `/lessons/[slug]`. Omitted = legacy published. */
  status?: string;
};

type HelpHubTip = HelpHubTipRecord;

const lessons = lessonsFile as Lesson[];
const helpHubTips = filterPublicHelpHubTips(
  Array.isArray(helpHub) ? (helpHub as HelpHubTip[]) : [],
);
const catalogVideos = filterPublicCatalogVideos(
  Array.isArray(videosPublic) ? (videosPublic as PublicVideoRow[]) : [],
);

const { slug } = Astro.params;
console.log("Looking for slug:", slug);
console.log("Available slugs:", lessons.map(l => l.slug));
const lesson = lessons.find((lesson) => lesson.slug === slug);

/** Public `/lessons/[slug]`: `published`, or no `status` (legacy rows). Draft or any other value → not found. */
function lessonIsPubliclyPublished(l: Lesson): boolean {
  const raw = l.status;
  if (raw === undefined || raw === null) return true;
  const s = typeof raw === "string" ? raw.trim().toLowerCase() : "";
  if (s === "") return true;
  return s === "published";
}

if (!lesson || !lessonIsPubliclyPublished(lesson)) {
  return new Response(
    JSON.stringify(
      {
        slug,
        availableSlugs: lessons.map((l) => l.slug),
      },
      null,
      2
    ),
    {
      status: 404,
      headers: { "Content-Type": "application/json" },
    }
  );
}

const url = new URL(Astro.request.url);
const from = url.searchParams.get("from");
const hubSlugParam = url.searchParams.get("hub");
const hubTipForBackLink =
  typeof hubSlugParam === "string" && hubSlugParam.trim() !== ""
    ? findPublicHelpHubTipBySlug(
        Array.isArray(helpHub) ? (helpHub as HelpHubTip[]) : [],
        hubSlugParam,
      )
    : undefined;
const hubSlug =
  hubTipForBackLink && typeof hubTipForBackLink.slug === "string"
    ? hubTipForBackLink.slug.trim()
    : "";
const showHelpHubBackLink = from === "help-hub" && hubSlug.length > 0;

/** Vimeo numeric id for matching (catalog `videoSlug` or legacy `vimeoEmbedUrl`). */
function lessonVimeoNumericId(l: Lesson): string | null {
  const key = typeof l.videoSlug === "string" ? l.videoSlug.trim() : "";
  if (key) {
    const v = findPublicVideoByKey(catalogVideos, key);
    if (v) {
      const id = vimeoNumericIdFromPublicVideo(v);
      if (id) return id;
    }
  }
  const rawV = l.vimeoEmbedUrl;
  const raw =
    typeof rawV === "number" && Number.isFinite(rawV)
      ? String(Math.trunc(rawV))
      : typeof rawV === "string"
        ? rawV.trim()
        : "";
  if (!raw) return null;
  if (/^\d+$/.test(raw)) return raw;
  const m = raw.match(/\/(?:video\/)?(\d+)(?:\?|#|$)/);
  return m ? m[1] : null;
}

function lessonMatchesRelatedRef(ref: string, current: Lesson): boolean {
  const trimmed = ref.trim();
  if (!trimmed) return false;
  if (current.slug.trim() === trimmed) return true;
  if (/^\d+$/.test(trimmed)) return lessonVimeoNumericId(current) === trimmed;
  return false;
}

function lessonMatchesRelatedLessonRef(ref: unknown, current: Lesson): boolean {
  if (typeof ref === "number" && Number.isFinite(ref)) {
    return current.id === ref;
  }
  if (typeof ref === "string") {
    return lessonMatchesRelatedRef(ref, current);
  }
  return false;
}

function findTipForLesson(lessonRow: Lesson): HelpHubTip | undefined {
  const explicit = typeof lessonRow.relatedTipSlug === "string" ? lessonRow.relatedTipSlug.trim() : "";
  if (explicit) {
    return helpHubTips.find((t) => typeof t.slug === "string" && t.slug.trim() === explicit);
  }
  return helpHubTips.find(
    (t) =>
      Array.isArray(t.relatedLessons) &&
      t.relatedLessons.some((r) => lessonMatchesRelatedLessonRef(r, lessonRow)),
  );
}

const relatedHelpHubsResolved: HelpHubTip[] = [];
if (Array.isArray(lesson.relatedHelpHubs)) {
  for (const ref of lesson.relatedHelpHubs) {
    if (typeof ref === "number") {
      const found = helpHubTips.find((h) => h.id === ref);
      if (found) relatedHelpHubsResolved.push(found);
    } else if (typeof ref === "string") {
      const found = helpHubTips.find(
        (h) => typeof h.slug === "string" && h.slug.trim() === ref.trim(),
      );
      if (found) relatedHelpHubsResolved.push(found);
    }
  }
}

const relatedTip = relatedHelpHubsResolved[0] ?? findTipForLesson(lesson);
const relatedTipSlug =
  relatedTip && typeof relatedTip.slug === "string" && relatedTip.slug.trim() !== ""
    ? relatedTip.slug.trim()
    : null;
const relatedTipHref = relatedTipSlug ? `/help-hub/${relatedTipSlug}` : null;

const backToTipHref =
  showHelpHubBackLink && hubSlug ? `/help-hub/${hubSlug.trim()}` : "";
const backToTipLabelLine =
  relatedTip && typeof relatedTip.question === "string" && relatedTip.question.trim() !== ""
    ? relatedTip.question.trim()
    : relatedTip && typeof relatedTip.title === "string" && relatedTip.title.trim() !== ""
      ? relatedTip.title.trim()
      : "";
const backToTipLabel = backToTipLabelLine ? `Back to: ${backToTipLabelLine}` : "Back to Tip";

/** Vimeo iframe `src` from catalog `videoSlug` or legacy embed field. */
function lessonVimeoPlayerSrc(l: Lesson): string {
  const id = lessonVimeoNumericId(l);
  if (id) return `https://player.vimeo.com/video/${id}`;
  const rawV = l.vimeoEmbedUrl;
  const raw = typeof rawV === "string" ? rawV.trim() : "";
  if (raw && /^https?:\/\//i.test(raw)) return raw;
  return "";
}

const vimeoPlayerSrc = lessonVimeoPlayerSrc(lesson);

const hasLessonVideo = lesson.type === "video" && vimeoPlayerSrc.length > 0;

/** Vimeo player URL from a numeric id or Vimeo URL string. */
function vimeoPlayerUrlFromRawId(rawUnknown: unknown): string | null {
  const raw =
    typeof rawUnknown === "number" && Number.isFinite(rawUnknown)
      ? String(Math.trunc(rawUnknown))
      : typeof rawUnknown === "string"
        ? rawUnknown
        : "";
  if (!raw) return null;
  return `https://player.vimeo.com/video/${raw}`;
}

/** Vimeo player URL from `mediaType` / `mediaUrl` (not catalog). */
function inlineLessonVimeoSrc(l: Lesson): string | null {
  const mt = typeof l.mediaType === "string" ? l.mediaType.trim().toLowerCase() : "";
  if (mt !== "vimeo") return null;
  const raw = typeof l.mediaUrl === "string" ? l.mediaUrl.trim() : "";
  if (!raw) return null;
  return vimeoPlayerUrlFromRawId(raw);
}

const inlineVimeoSrc = inlineLessonVimeoSrc(lesson);

const lessonBlocks = Array.isArray(lesson.blocks) ? lesson.blocks : [];
const hasLessonBlocks = lessonBlocks.length > 0;

function lessonBlockIsRenderable(block: unknown): block is LessonBodyBlock {
  if (!block || typeof block !== "object") return false;
  const b = block as LessonBodyBlock;
  if (b.type === "text") {
    return typeof b.content === "string" && b.content.trim() !== "";
  }
  if (b.type === "vimeo") {
    return vimeoPlayerUrlFromRawId(b.vimeoId) !== null;
  }
  return false;
}

const renderableLessonBlocks = lessonBlocks.filter(lessonBlockIsRenderable);
const hasRenderableLessonBlocks = renderableLessonBlocks.length > 0;
const hasRenderableBlockVideos = renderableLessonBlocks.some((block) => block.type === "vimeo");

const summaryHtml =
  typeof lesson.summary === "string" && lesson.summary.trim() !== ""
    ? lesson.summary.trim()
    : "";

const showLessonBodyEmptyState =
  hasLessonBlocks && !hasRenderableLessonBlocks
    ? true
    : !hasLessonBlocks && !summaryHtml && !inlineVimeoSrc;
const hasLessonModalVideo = hasLessonVideo || hasRenderableBlockVideos || Boolean(inlineVimeoSrc);

const supportImageForPreview =
  typeof lesson.supportImage === "string" && lesson.supportImage.trim() !== ""
    ? lesson.supportImage.trim()
    : "";
const videoPreviewUsesSupportImage = supportImageForPreview.length > 0;
const videoOpenLabel = `Play video: ${lesson.title}`;

/** Same URL is already the video preview thumb; omit duplicate img in `.lesson-support`. */
const supportImageDuplicateOfVideoPreview = hasLessonVideo && videoPreviewUsesSupportImage;
const showSupportImageInCard =
  typeof lesson.supportImage === "string" &&
  lesson.supportImage.trim() !== "" &&
  !supportImageDuplicateOfVideoPreview;

const hasSupportCard =
  showSupportImageInCard ||
  (typeof lesson.noteTitle === "string" && lesson.noteTitle.trim() !== "") ||
  (typeof lesson.noteText === "string" && lesson.noteText.trim() !== "");

type LessonLibraryVideoEmbed = {
  key: string;
  title: string;
  videoId: string;
  access_level: "open" | "member";
};

function accessLevelForPublicVideoRow(row: PublicVideoRow): "open" | "member" {
  if (row.isTipOfWeek === true) return "open";
  const raw = typeof row.access_level === "string" ? row.access_level.trim().toLowerCase() : "";
  return raw === "open" ? "open" : "member";
}

function resolveLessonLibraryVideo(
  videos: PublicVideoRow[],
  slugKey: string,
): LessonLibraryVideoEmbed | null {
  const k = slugKey.trim();
  if (!k) return null;
  const row = findPublicVideoByKey(videos, k);
  if (!row) return null;
  const videoId = vimeoNumericIdFromPublicVideo(row);
  if (!videoId) return null;
  const title =
    typeof row.title === "string" && row.title.trim() !== "" ? row.title.trim() : "Video";
  return { key: k, title, videoId, access_level: accessLevelForPublicVideoRow(row) };
}

const lessonVideoSlugList = Array.isArray(lesson.videos)
  ? lesson.videos
      .filter((s): s is string => typeof s === "string" && s.trim() !== "")
      .map((s) => s.trim())
  : [];

const lessonLibraryVideos: LessonLibraryVideoEmbed[] = lessonVideoSlugList
  .map((key) => resolveLessonLibraryVideo(catalogVideos, key))
  .filter((v): v is LessonLibraryVideoEmbed => v !== null);

---

<Layout>
  <main class="site-content">
    <div class="lesson-page">
      <div class="lesson-page__inner">
        <header class="lesson-header">
          {showHelpHubBackLink && (
            <p class="lesson-back-link">
              <a href={backToTipHref}>← {backToTipLabel}</a>
            </p>
          )}
          <p class="lesson-badge">Member Lesson</p>
          <h1 class="lesson-header__title">{lesson.title}</h1>
          {summaryHtml && (
            <div class="lesson-header__intro" set:html={summaryHtml} />
          )}
        </header>

        <div class="lesson-grid">
        <!-- LEFT COLUMN -->
        <div class="lesson-content">
          {hasLessonBlocks ? (
            <div class="lesson-body-blocks">
              {showLessonBodyEmptyState ? (
                <p class="lesson-empty">
                  This lesson does not have any content blocks yet. Check back soon, or explore the{" "}
                  {relatedTipHref ? (
                    <a href={relatedTipHref}>related Help Hub article</a>
                  ) : (
                    <a href="/help-hub/">Help Hub</a>
                  )}
                  .
                </p>
              ) : (
                renderableLessonBlocks.map((block) => {
                  if (block.type === "text") {
                    const blockContent =
                      typeof block.content === "string" ? block.content : "";
                    return (
                      <div class="lesson-block lesson-text-block">
                        <GlossaryHtml html={blockContent} />
                      </div>
                    );
                  }
                  if (block.type === "vimeo") {
                    if (block.vimeoId === undefined || block.vimeoId === null || block.vimeoId === "") return null;
                    const iframeTitle =
                      typeof block.title === "string" && block.title.trim() !== ""
                        ? block.title.trim()
                        : lesson.title;
                    const videoLabel =
                      typeof block.title === "string" && block.title.trim() !== ""
                        ? block.title.trim()
                        : null;
                    return (
                      <div class="lesson-block lesson-video-block">
                        {videoLabel && (
                          <p class="lesson-video-block__label">{videoLabel}</p>
                        )}
                        <div class="lesson-video-frame lesson-video-frame--modal-trigger">
                          <iframe
                            src={`https://player.vimeo.com/video/${block.vimeoId}`}
                            title={iframeTitle}
                            allow="autoplay; fullscreen; picture-in-picture"
                            allowfullscreen
                            loading="lazy"
                          />
                          <button
                            type="button"
                            class="lesson-video-frame__open"
                            aria-label={`Open larger video: ${iframeTitle}`}
                            data-player-src={`https://player.vimeo.com/video/${block.vimeoId}`}
                          />
                        </div>
                      </div>
                    );
                  }
                  return null;
                })
              )}
            </div>
          ) : (
            <>
              {showLessonBodyEmptyState ? (
                <p class="lesson-empty">
                  This lesson does not have any content yet. Check back soon, or browse the{" "}
                  <a href="/help-hub/">Help Hub</a>.
                </p>
              ) : (
                <>
                  {inlineVimeoSrc && (
                    <div class="lesson-block lesson-video-block">
                      <div class="lesson-video-frame lesson-video-frame--modal-trigger">
                        <iframe
                          src={inlineVimeoSrc}
                          title={lesson.title}
                          allow="autoplay; fullscreen; picture-in-picture"
                          allowfullscreen
                          loading="lazy"
                        />
                        <button
                          type="button"
                          class="lesson-video-frame__open"
                          aria-label={`Open larger video: ${lesson.title}`}
                          data-player-src={inlineVimeoSrc}
                        />
                      </div>
                    </div>
                  )}
                </>
              )}
            </>
          )}

          {lessonLibraryVideos.length > 0 && (
            <div class="lesson-library-videos">
              {lessonLibraryVideos.map((libVideo) => (
                <GatedVimeoEmbed
                  videoId={libVideo.videoId}
                  title={libVideo.title}
                  access_level={libVideo.access_level}
                />
              ))}
            </div>
          )}

          {lesson.encouragement && (
            <div class="lesson-encouragement">
              <div set:html={lesson.encouragement} />
            </div>
          )}

          {typeof lesson.templateLink === "string" && lesson.templateLink.trim() !== "" && (
            <p class="lesson-template">
              <a
                href={lesson.templateLink}
                class="kbm-btn kbm-btn-outline"
                target="_blank"
                rel="noopener"
              >
                {typeof lesson.templateLinkText === "string" && lesson.templateLinkText.trim() !== ""
                  ? lesson.templateLinkText
                  : "Download"}
              </a>
            </p>
          )}

          {lesson.exerciseItems && lesson.exerciseItems.length > 0 && (
            <section class="lesson-exercise" id="lesson-exercise">
              <div class="lesson-exercise__brand" aria-hidden="true">
                <img
                  class="lesson-exercise__brand-logo"
                  src="/KINlogo.svg"
                  alt=""
                  width="28"
                  height="28"
                />
                <div class="lesson-exercise__brand-text">
                  <span class="lesson-exercise__brand-name">Knit it Now</span>
                  <span class="lesson-exercise__brand-label">Lesson Worksheet</span>
                </div>
              </div>
              <h1 class="lesson-exercise__print-title">{lesson.title}</h1>
              <div class="lesson-exercise__header">
                <h2 class="lesson-exercise__title">Follow These Steps</h2>
                <button
                  type="button"
                  class="lesson-exercise__print"
                  onclick="printLessonExercise()"
                >
                  Print Steps
                </button>
              </div>
              <ol class="lesson-exercise__list">
                {lesson.exerciseItems.map((item) => (
                  <li class="lesson-exercise__item" set:html={item}></li>
                ))}
              </ol>
              <footer class="lesson-exercise__print-footer">knititnow.com</footer>
            </section>
          )}
        </div>

        <!-- RIGHT COLUMN -->
        <div class="lesson-media">
          {hasLessonVideo && (
            <div class="lesson-video-card">
              <button
                type="button"
                class="lesson-video-thumb"
                id="lesson-video-open"
                aria-haspopup="dialog"
                aria-controls="lesson-video-modal"
                aria-label={videoOpenLabel}
              >
                {videoPreviewUsesSupportImage ? (
                  <img
                    src={supportImageForPreview}
                    alt=""
                    class="lesson-video-thumb__img"
                    width="640"
                    height="360"
                    loading="lazy"
                  />
                ) : (
                  <div class="lesson-video-thumb__placeholder" aria-hidden="true">
                    <span class="lesson-video-thumb__placeholder-text">Watch the lesson</span>
                  </div>
                )}
                <span class="lesson-video-thumb__play" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </button>
              <p class="lesson-video-thumb__hint">Watch the lesson</p>
            </div>
          )}

          {hasSupportCard && (
            <div class="lesson-support">
              {showSupportImageInCard && (
                <img
                  src={lesson.supportImage}
                  alt={
                    typeof lesson.supportImageAlt === "string" && lesson.supportImageAlt.trim() !== ""
                      ? lesson.supportImageAlt
                      : lesson.title
                  }
                  class="lesson-support-image"
                  loading="lazy"
                />
              )}
              {((typeof lesson.noteTitle === "string" && lesson.noteTitle.trim() !== "") ||
                (typeof lesson.noteText === "string" && lesson.noteText.trim() !== "")) && (
                <div class="lesson-support-note">
                  {typeof lesson.noteTitle === "string" && lesson.noteTitle.trim() !== "" && (
                    <h3>{lesson.noteTitle}</h3>
                  )}
                  {typeof lesson.noteText === "string" && lesson.noteText.trim() !== "" && (
                    <div class="lesson-support-note__html" set:html={lesson.noteText} />
                  )}
                </div>
              )}
            </div>
          )}
        </div>
      </div>

      {hasLessonModalVideo && (
        <dialog
          id="lesson-video-modal"
          class="lesson-video-modal"
          aria-labelledby="lesson-video-modal-title"
          data-player-src={vimeoPlayerSrc}
        >
          <div class="lesson-video-modal__inner">
            <button type="button" class="lesson-video-modal__close" aria-label="Close video">
              ×            </button>
            <h2 id="lesson-video-modal-title" class="lesson-video-modal__sr-title">
              Lesson video
            </h2>
            <div class="lesson-video-modal__frame-wrap">
              <iframe
                id="lesson-video-modal-iframe"
                title={lesson.title}
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
              />
            </div>
          </div>
        </dialog>
      )}
      </div>
    </div>
  </main>
</Layout>

{hasLessonModalVideo && (
  <script is:inline>
    (function () {
      var openBtn = document.getElementById("lesson-video-open");
      var inlineOpenBtns = Array.prototype.slice.call(
        document.querySelectorAll(".lesson-video-frame__open"),
      );
      var dialog = document.getElementById("lesson-video-modal");
      var iframe = document.getElementById("lesson-video-modal-iframe");
      var closeBtn = dialog ? dialog.querySelector(".lesson-video-modal__close") : null;
      if ((!openBtn && inlineOpenBtns.length === 0) || !dialog || !iframe) return;

      var baseSrc = dialog.getAttribute("data-player-src") || "";
      var lastFocused = null;

      function withAutoplay(url) {
        if (!url) return "";
        return url + (url.indexOf("?") >= 0 ? "&" : "?") + "autoplay=1";
      }

      function openModal(src, trigger) {
        var resolvedSrc = src || baseSrc;
        if (!resolvedSrc) return;
        lastFocused = trigger || document.activeElement;
        iframe.setAttribute("src", withAutoplay(resolvedSrc));
        dialog.showModal();
        document.body.style.overflow = "hidden";
        if (closeBtn && typeof closeBtn.focus === "function") closeBtn.focus();
      }

      function closeModal() {
        iframe.removeAttribute("src");
        dialog.close();
        document.body.style.overflow = "";
        if (lastFocused && typeof lastFocused.focus === "function") {
          lastFocused.focus();
        }
      }

      if (openBtn) {
        openBtn.addEventListener("click", function () {
          openModal(baseSrc, openBtn);
        });
      }

      inlineOpenBtns.forEach(function (btn) {
        btn.addEventListener("click", function () {
          openModal(btn.getAttribute("data-player-src") || "", btn);
        });
      });

      if (closeBtn) {
        closeBtn.addEventListener("click", function () {
          closeModal();
        });
      }

      dialog.addEventListener("click", function (e) {
        if (e.target === dialog) closeModal();
      });

      dialog.addEventListener("cancel", function (e) {
        e.preventDefault();
        closeModal();
      });
    })();
  </script>
)}

<style>
  .site-content {
    padding-top: 1rem;
  }

  .lesson-page {
    padding: 0 1rem 2.5rem;
  }

  @media (min-width: 640px) {
    .lesson-page {
      padding: 0 1.5rem 3rem;
    }
  }

  .lesson-page__inner {
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    box-sizing: border-box;
  }

  .lesson-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(82, 104, 45, 0.12);
  }

  .lesson-back-link {
    margin-bottom: 1rem;
  }

  .lesson-back-link a {
    font-weight: 600;
    text-decoration: none;
  }

  .lesson-back-link a:hover {
    text-decoration: underline;
  }

  .lesson-badge {
    display: inline-block;
    margin: 0 0 0.65rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #3d4a28;
    background: rgba(82, 104, 45, 0.1);
    border: 1px solid rgba(82, 104, 45, 0.18);
    border-radius: 4px;
  }

  .lesson-header__title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.45rem, 2.5vw, 1.85rem);
    font-weight: 700;
    line-height: 1.2;
    color: #243015;
  }

  .lesson-header__intro {
    font-size: 1.02rem;
    line-height: 1.65;
    color: #3a3f35;
  }

  .lesson-header__intro :first-child {
    margin-top: 0;
  }

  .lesson-header__intro :last-child {
    margin-bottom: 0;
