---
import Layout from "../../layouts/Layout.astro";
import lessonsFile from "../../data/lessons.json";
console.log("LESSONS FILE:", lessonsFile);

type Lesson = {
  id: number;
  slug: string;
  title: string;
  summary?: string;
  type: string;
  vimeoEmbedUrl?: string;
  access: string;
  associatedTip?: string;
  url?: string;
  encouragement?: string;
  exerciseTitle?: string;
  exerciseItems?: string[];
  templateLink?: string;
  templateLinkText?: string;
  supportImage?: string;
  supportImageAlt?: string;
  noteTitle?: string;
  noteText?: string;
};

const lessons = lessonsFile as Lesson[];

export async function getStaticPaths() {
  return lessons.map((lesson) => ({
    params: { slug: lesson.slug },
  }));
}

const { slug } = Astro.params;

const lesson = lessons.find((item) => item.slug === slug);

if (!lesson) {
  throw new Error(`Lesson not found for slug: ${slug}`);
}
---

<Layout>
  <main class="site-content">
    <div class="container">
      <div class="lesson-header">
        <img
          src="/images/help-hub.svg"
                 alt="Knit it Now Lesson Icon"
          class="lesson-header-icon"
        />
        <h1>{lesson.title}</h1>
      </div>

      <div class="lesson-grid">
        <!-- LEFT COLUMN -->
        <div class="lesson-content">
          {lesson.summary && <p>{lesson.summary}</p>}

          {lesson.encouragement && (
            <div class="lesson-encouragement">
              <p>{lesson.encouragement}</p>
            </div>
          )}

          {lesson.templateLink && (
            <p class="lesson-template">
              <a href={lesson.templateLink} target="_blank" rel="noopener">
                {lesson.templateLinkText}
              </a>
            </p>
          )}

          {lesson.exerciseItems && lesson.exerciseItems.length > 0 && (
            <section class="lesson-exercise" id="lesson-exercise">
              <div class="lesson-exercise__brand" aria-hidden="true">
                <img
                  class="lesson-exercise__brand-logo"
                  src="/KINlogo.svg"
                  alt=""
                  width="28"
                  height="28"
                />
                <div class="lesson-exercise__brand-text">
                  <span class="lesson-exercise__brand-name">Knit it Now</span>
                  <span class="lesson-exercise__brand-label">Lesson Worksheet</span>
                </div>
              </div>
              <h1 class="lesson-exercise__print-title">{lesson.title}</h1>
              <div class="lesson-exercise__header">
                <h2 class="lesson-exercise__title">Follow These Steps</h2>
                <button
                  type="button"
                  class="lesson-exercise__print"
                  onclick="printLessonExercise()"
                >
                  Print Steps
                </button>
              </div>
              <ol class="lesson-exercise__list">
                {lesson.exerciseItems.map((item) => (
                  <li class="lesson-exercise__item">{item}</li>
                ))}
              </ol>
              <footer class="lesson-exercise__print-footer">knititnow.com</footer>
            </section>
          )}
        </div>

        <!-- RIGHT COLUMN -->
        <div class="lesson-media">
          {lesson.type === "video" && lesson.vimeoEmbedUrl && (
            <iframe
              src={lesson.vimeoEmbedUrl}
              title={lesson.title}
              width="100%"
              height="400"
              frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          )}

          {lesson.supportImage && (
            <div class="lesson-support">
              <img
                src={lesson.supportImage}
                alt={lesson.supportImageAlt || lesson.title}
                class="lesson-support-image"
              />

              {(lesson.noteTitle || lesson.noteText) && (
                <div class="lesson-support-note">
                  {lesson.noteTitle && <h3>{lesson.noteTitle}</h3>}
                  {lesson.noteText && <p>{lesson.noteText}</p>}
                </div>
              )}
            </div>
          )}
        </div>
      </div>

      
    </div>
  </main>
</Layout>
<style>
  .site-content {
    padding-top: 1rem;
  }

  .lesson-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .lesson-media iframe {
    width: 100%;
    min-height: 320px;
    border: 0;
    border-radius: 12px;
  }

  .lesson-support {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
  }

  .lesson-support-image {
    width: 100%;
    border-radius: 10px;
  }

  .lesson-support-note {
    background: #f5f5f5;
    padding: 1rem;
    border-radius: 10px;
  }

  .lesson-content {
    display: grid;
    gap: 1rem;
  }

  .lesson-encouragement {
    background: #f5f5f5;
    padding: 1rem;
    border-radius: 10px;
  }

  .lesson-template a {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: 600;
  }

  .lesson-exercise {
  margin-top: 1.5rem;
  background: #f5f5f5;
  border: 1px solid #d9ddd2;
  border-radius: 12px;
  padding: 1.25rem;
  display: grid;
  gap: 1rem;
}

  .lesson-exercise__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .lesson-exercise__title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .lesson-exercise__print {
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  border: 1px solid #52682D;
  background: #ffffff;
  color: #52682D;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  line-height: 1.2;
}

.lesson-exercise__print:hover {
  background: #f5f5f5;
}

  .lesson-exercise__list {
    list-style-position: outside;
    padding-left: 1.35rem;
    margin: 0;
  }
  .lesson-header {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.lesson-header-icon {
  width: 48px;
  height: 48px;
  object-fit: contain;
  margin-top: 4px;
}
  .lesson-exercise__item {
    margin-bottom: 0.7rem;
    padding-left: 0.25rem;
    line-height: 1.55;
  }

  .lesson-exercise__item:last-child {
    margin-bottom: 0;
  }

  .lesson-exercise__print-title {
    display: none;
    margin: 0;
  }

  .lesson-exercise__brand,
  .lesson-exercise__print-footer {
    display: none;
  }

  @media print {
    :global(body.print-exercise-only),
    :global(body.print-exercise-only *) {
      visibility: hidden !important;
      box-shadow: none !important;
      background: transparent !important;
    }

    :global(body.print-exercise-only #lesson-exercise),
    :global(body.print-exercise-only #lesson-exercise *) {
      visibility: visible !important;
    }

    :global(body.print-exercise-only #lesson-exercise) {
      position: absolute !important;
      top: 0;
      left: 0;
      width: 100%;
      border: 0;
      border-radius: 0;
      margin: 0;
      padding: 0.25in;
      color: #000;
      background: #fff !important;
    }

    .lesson-exercise__print {
      display: none !important;
    }

    .lesson-exercise__header {
      margin-bottom: 0.75rem;
    }

    .lesson-exercise__brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding-bottom: 0.65rem;
      margin-bottom: 0.75rem;
      border-bottom: 1px solid #ccc;
    }

    .lesson-exercise__brand-logo {
      width: 28px;
      height: 28px;
      object-fit: contain;
      flex-shrink: 0;
    }

    .lesson-exercise__brand-text {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      line-height: 1.2;
    }

    .lesson-exercise__brand-name {
      font-weight: 700;
      font-size: 0.95rem;
    }

    .lesson-exercise__brand-label {
      font-size: 0.72rem;
      font-weight: 400;
      color: #555;
    }

    .lesson-exercise__print-title {
      display: block;
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .lesson-exercise__print-footer {
      display: block;
      margin-top: 1rem;
      padding-top: 0.5rem;
      border-top: 1px solid #ddd;
      font-size: 0.8rem;
      color: #444;
      text-align: center;
    }

    .lesson-exercise__list {
      list-style: decimal outside;
      padding-left: 1.2rem;
      margin: 0;
    }

    @page {
      size: auto;
      margin: 0.5in;
    }
  }

  @media (max-width: 768px) {
    .lesson-grid {
      grid-template-columns: 1fr;
    }

    .lesson-media {
      order: -1;
    }
  }
</style>
<script is:inline>
  function printLessonExercise() {
    document.body.classList.add("print-exercise-only");
    window.print();
  }

  window.addEventListener("afterprint", () => {
    document.body.classList.remove("print-exercise-only");
  });
</script>