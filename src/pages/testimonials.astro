---
export const prerender = false;
import "../styles/testimonials-public.css";
import Layout from "../layouts/Layout.astro";
import { listPublicTestimonials } from "../lib/testimonials/testimonialStore";
import type { PublicTestimonial } from "../lib/testimonials/testimonialRules";

let testimonials: PublicTestimonial[] = [];
try {
  testimonials = await listPublicTestimonials();
} catch {
  testimonials = [];
}

function yearLabel(reviewDate: string | null): string | null {
  return reviewDate?.slice(0, 4) || null;
}
---

<Layout
  title="What Knitters Say | Knit it Now"
  description="Every knitter has a story. Here’s what learning, trying, and succeeding with Knit It Now has meant to them."
  bodyClass="page--tight-header"
>
  <main class="testimonials-page page-wrap">
    <header class="testimonials-page__header">
      <h1>What Knitters Say</h1>
      <p class="testimonials-page__intro">
        Every knitter has a story. Here’s what learning, trying, and succeeding with Knit It Now has meant to them.
      </p>
    </header>

    <div class="testimonials-page__stream">
      <div class="testimonials-page__sharebar">
        <a class="kbm-btn kbm-btn-outline" href="/testimonials/share">Share your experience</a>
      </div>

      {
        testimonials.length === 0 ? (
          <p class="testimonials-page__intro">No testimonials are published yet.</p>
        ) : (
          <div class="testimonials-page__list">
            {testimonials.map((item) => (
              <article class="kbm-card testimonials-page__card">
                <blockquote>
                  <p class="testimonials-page__quote">
                    {item.before}
                    {item.highlight ? <span class="testimonials-page__highlight">{item.highlight}</span> : null}
                    {item.after}
                  </p>
                </blockquote>
                <p class="testimonials-page__name">
                  {item.attribution}
                  {yearLabel(item.reviewDate) ? <span> · {yearLabel(item.reviewDate)}</span> : null}
                </p>
              </article>
            ))}
          </div>
        )
      }
    </div>

    <p class="testimonials-page__share testimonials-page__share--bottom">
      <a class="kbm-btn kbm-btn-outline" href="/testimonials/share">Share your experience</a>
    </p>
  </main>
</Layout>
