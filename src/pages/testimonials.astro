---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { listPublicTestimonials } from "../lib/testimonials/testimonialStore";
import type { PublicTestimonial } from "../lib/testimonials/testimonialRules";

let testimonials: PublicTestimonial[] = [];
try {
  testimonials = await listPublicTestimonials();
} catch {
  testimonials = [];
}

function yearLabel(reviewDate: string | null): string | null {
  return reviewDate?.slice(0, 4) || null;
}
---

<Layout
  title="What Knitters Say | Knit it Now"
  description="Notes from Knit It Now members, in their own words."
  bodyClass="page--tight-header"
>
  <main class="testimonials-page page-wrap">
    <header class="testimonials-page__header">
      <h1>What Knitters Say</h1>
      <p>Notes from machine knitters, published after review.</p>
    </header>

    <p data-ms-content="members">
      <a class="kbm-btn kbm-btn-outline" href="/testimonials/share">Share your experience</a>
    </p>

    {
      testimonials.length === 0 ? (
        <p>No testimonials are published yet.</p>
      ) : (
        <div class="testimonials-page__list">
          {testimonials.map((item) => (
            <article class="kbm-card testimonials-page__card">
              <blockquote>
                {item.quote.split("\n").filter((line) => line.length > 0).map((line) => <p>{line}</p>)}
              </blockquote>
              <p class="testimonials-page__name">
                {item.attribution}
                {yearLabel(item.reviewDate) ? <span> · {yearLabel(item.reviewDate)}</span> : null}
              </p>
            </article>
          ))}
        </div>
      )
    }
  </main>
</Layout>

<style>
  .testimonials-page.page-wrap {
    padding-top: 8px;
    max-width: 46rem;
  }
  .testimonials-page__header {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .testimonials-page__header h1 {
    margin-bottom: 0.5rem;
  }
  .testimonials-page__list {
    display: grid;
    gap: 1rem;
  }
  .testimonials-page__card {
    cursor: default;
    padding: 1.5rem;
  }
  .testimonials-page__card:hover {
    transform: none;
  }
  .testimonials-page__card blockquote {
    margin: 0;
  }
  .testimonials-page__card p {
    margin: 0 0 0.65rem;
    font-weight: 400;
    color: #4d5a48;
    line-height: 1.55;
  }
  .testimonials-page__name {
    margin: 0.9rem 0 0;
    font-weight: 600;
    color: #4d5a48;
  }
</style>
