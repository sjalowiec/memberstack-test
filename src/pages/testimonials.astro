---
export const prerender = false;
import "../styles/testimonials-public.css";
import Layout from "../layouts/Layout.astro";
import {
  ensurePublicTestimonialOrderSeed,
  listPublicTestimonials,
} from "../lib/testimonials/testimonialStore";
import type { PublicTestimonialBatch } from "../lib/testimonials/testimonialStore";

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Vary", "Cookie");

const seed = ensurePublicTestimonialOrderSeed(Astro.cookies, Astro.url.protocol === "https:");
let batch: PublicTestimonialBatch = {
  testimonials: [],
  total: 0,
  offset: 0,
  limit: 8,
  nextOffset: 0,
  hasMore: false,
};
let loadError = false;
try {
  batch = await listPublicTestimonials({ seed, offset: 0 });
} catch {
  loadError = true;
}

const showEmpty = !loadError && batch.testimonials.length === 0;
const previousDisabled = batch.offset <= 0;
const nextDisabled = !loadError && !batch.hasMore;

function yearLabel(reviewDate: string | null): string | null {
  return reviewDate?.slice(0, 4) || null;
}
---

<Layout
  title="What Knitters Say | Knit it Now"
  description="Every knitter has a story. Here’s what learning, trying, and succeeding with Knit It Now has meant to them."
  bodyClass="page--tight-header"
>
  <main class="testimonials-page page-wrap">
    <div
      class="testimonials-page__sharebar"
      id="testimonial-browse"
      data-offset={batch.offset}
      data-next-offset={loadError ? 0 : batch.nextOffset}
      data-has-more={batch.hasMore ? "true" : "false"}
      data-limit={batch.limit}
      data-phase={loadError ? "error" : "ready"}
      data-failed-direction={loadError ? "next" : ""}
      data-requested-offset={loadError ? "0" : ""}
    >
      <a class="kbm-btn kbm-btn-primary" href="/testimonials/share">Share your experience</a>
      <button class="kbm-btn kbm-btn-outline" type="button" id="previous-stories" disabled={previousDisabled}>
        Previous stories
      </button>
      <button class="kbm-btn kbm-btn-outline" type="button" id="next-stories" disabled={nextDisabled}>
        {loadError ? "Retry" : "Next stories"}
      </button>
      <span id="show-more-status" class="testimonials-page__more-status" role="status">{loadError ? "Stories could not be loaded." : ""}</span>
    </div>

    <header class="testimonials-page__header">
      <h1>What Knitters Say</h1>
      <p class="testimonials-page__intro">
        Every knitter has a story. Here’s what learning, trying, and succeeding with Knit It Now has meant to them.
      </p>
    </header>

    <div class="testimonials-page__stream">
      <div class="testimonials-page__list" id="testimonial-list">
        {
          batch.testimonials.map((item) => (
            <article class="kbm-card testimonials-page__card">
              <blockquote>
                <p class="testimonials-page__quote">
                  {item.before}
                  {item.highlight ? <span class="testimonials-page__highlight">{item.highlight}</span> : null}
                  {item.after}
                </p>
              </blockquote>
              <p class="testimonials-page__name">
                {item.attribution}
                {yearLabel(item.reviewDate) ? <span> · {yearLabel(item.reviewDate)}</span> : null}
              </p>
            </article>
          ))
        }
      </div>
      <p class="testimonials-page__intro" id="testimonial-empty" hidden={!showEmpty}>No testimonials are published yet.</p>
    </div>
  </main>
</Layout>

<script>
  import {
    acceptPublicBrowseBatch,
    failPublicBrowseLoad,
    publicBrowseControlDisabled,
    publicBrowseControlLabel,
    publicBrowseRequestOffset,
    publicBrowseScrollTop,
    publicBrowseStatus,
    startPublicBrowseLoad,
    type PublicBrowseDirection,
    type PublicBrowseState,
  } from "../lib/testimonials/publicTestimonialBrowse";

  const list = document.getElementById("testimonial-list");
  const browse = document.getElementById("testimonial-browse");
  const previous = document.getElementById("previous-stories");
  const next = document.getElementById("next-stories");
  const status = document.getElementById("show-more-status");
  const empty = document.getElementById("testimonial-empty");
  if (
    list &&
    browse &&
    previous instanceof HTMLButtonElement &&
    next instanceof HTMLButtonElement
  ) {
    const requested = browse.dataset.requestedOffset ?? "";
    let state: PublicBrowseState = {
      offset: Number(browse.dataset.offset ?? "0") || 0,
      nextOffset: Number(browse.dataset.nextOffset ?? "0") || 0,
      hasMore: browse.dataset.hasMore === "true",
      cardCount: list.querySelectorAll(".testimonials-page__card").length,
      limit: Number(browse.dataset.limit ?? "8") || 8,
      phase: browse.dataset.phase === "error" ? "error" : "ready",
      pendingDirection: null,
      failedDirection: browse.dataset.failedDirection === "previous" || browse.dataset.failedDirection === "next"
        ? browse.dataset.failedDirection
        : null,
      requestedOffset: requested === "" ? null : Number(requested) || 0,
    };

    function yearLabel(reviewDate: string | null): string | null {
      return reviewDate?.slice(0, 4) || null;
    }

    function createCard(item: {
      before: string;
      highlight: string | null;
      after: string;
      attribution: string;
      reviewDate: string | null;
    }) {
      const article = document.createElement("article");
      article.className = "kbm-card testimonials-page__card";
      const quote = document.createElement("p");
      quote.className = "testimonials-page__quote";
      quote.append(item.before || "");
      if (item.highlight) {
        const emphasis = document.createElement("span");
        emphasis.className = "testimonials-page__highlight";
        emphasis.textContent = item.highlight;
        quote.append(emphasis);
      }
      quote.append(item.after || "");
      const block = document.createElement("blockquote");
      block.append(quote);
      const name = document.createElement("p");
      name.className = "testimonials-page__name";
      name.append(item.attribution || "");
      const year = yearLabel(item.reviewDate);
      if (year) {
        const suffix = document.createElement("span");
        suffix.textContent = ` · ${year}`;
        name.append(suffix);
      }
      article.append(block, name);
      return article;
    }

    function replaceCards(items: Parameters<typeof createCard>[0][]) {
      list.replaceChildren(...items.map(createCard));
    }

    function renderControl(button: HTMLButtonElement, direction: PublicBrowseDirection) {
      button.disabled = publicBrowseControlDisabled(state, direction);
      button.textContent = publicBrowseControlLabel(state, direction);
      button.setAttribute("aria-busy", state.phase === "loading" && state.pendingDirection === direction ? "true" : "false");
    }

    function renderControls() {
      renderControl(previous, "previous");
      renderControl(next, "next");
      if (status) status.textContent = publicBrowseStatus(state);
      if (empty) empty.hidden = !(state.phase === "ready" && state.cardCount === 0);
    }

    function scrollToCardStart() {
      const header = document.querySelector(".kbm-header-wrap");
      const bar = document.querySelector(".testimonials-page__sharebar");
      const scroller = document.scrollingElement;
      if (!scroller) return;
      const top = publicBrowseScrollTop({
        listTop: list.getBoundingClientRect().top,
        scrollY: scroller.scrollTop,
        headerBottom: header?.getBoundingClientRect().bottom ?? 0,
        barHeight: bar?.getBoundingClientRect().height ?? 0,
      });
      scroller.scrollTop = top;
    }

    async function loadDirection(direction: PublicBrowseDirection) {
      if (state.phase === "loading") return;
      const requestedOffset = publicBrowseRequestOffset(state, direction);
      if (requestedOffset == null) return;
      state = startPublicBrowseLoad(state, direction, requestedOffset);
      renderControls();
      try {
        const response = await fetch(`/api/testimonials?offset=${requestedOffset}`, {
          headers: { Accept: "application/json" },
        });
        const data = await response.json().catch(() => null);
        if (!response.ok || !data?.ok || !Array.isArray(data.testimonials)) {
          throw new Error("load failed");
        }
        replaceCards(data.testimonials);
        state = acceptPublicBrowseBatch(state, {
          testimonials: data.testimonials,
          offset: Number(data.offset),
          nextOffset: Number(data.nextOffset),
          hasMore: data.hasMore === true,
        });
        renderControls();
        scrollToCardStart();
      } catch {
        state = failPublicBrowseLoad(state);
        renderControls();
      }
    }

    previous.addEventListener("click", () => {
      void loadDirection("previous");
    });
    next.addEventListener("click", () => {
      void loadDirection("next");
    });
  }
</script>
