---
import Layout from "../layouts/Layout.astro";

const pageTitle = "New to Machine Knitting? Start Here";
const pageDescription =
  "New to machine knitting? Choose the option that sounds most like where you are today and take one simple first step.";

// Temporary links -- easy to adjust as content is built out.
const startCards = [
  {
    title: "I don't have a knitting machine yet",
    subtitle: "Help me choose the right machine.",
    body: "Not sure which machine is right for you? Answer a few simple questions, and we'll recommend machines based on your experience, interests, and the types of projects you want to make.",
    button: "Help Me Choose",
    href: "/reference/machines/choose",
  },
  {
    title: "I have a machine, but I don't know where to start",
    subtitle: "I just unpacked it... now what?",
    body: "Identify your machine, check the basics, and get ready to knit your first rows.",
    button: "Set Up My Machine",
    href: "/machine-checkup",
  },
  {
    title: "I'm ready to knit my first rows",
    subtitle: "Let's start knitting.",
    body: "Learn the essential beginner techniques, from casting on to knitting a few rows and binding off.",
    button: "Start Learning",
    href: "/knit-your-first-rows",
  },
  {
    title: "I want to make something",
    subtitle: "I learn best by making something.",
    body: "Tell us roughly where you are, and we'll point you to projects, tools, and lessons that fit.",
    button: "See What to Make",
    href: "/make-something",
  },
];
---

<Layout title={`${pageTitle} | Knit it Now`} description={pageDescription}>
  <section class="container py-5 start-here-page">
    <div class="start-here-inner">
      <header class="start-here-header">
        <h1>New to Machine Knitting? Start Here</h1>
        <p class="start-here-intro">
          Machine knitting can feel overwhelming at first, but you do not have to learn everything at once.
        </p>
        <p class="start-here-intro">
          Choose the option that sounds most like where you are today.
        </p>
      </header>

      <div class="start-here-choice-grid">
        {startCards.map((card) => (
          <article class="kbm-card start-here-card">
            <h2 class="kbm-card__title">{card.title}</h2>
            <p class="start-here-card__subtitle">{card.subtitle}</p>
            <p class="kbm-card__desc">{card.body}</p>
            <a href={card.href} class="kbm-btn kbm-btn-primary start-here-card__btn">
              {card.button}
            </a>
          </article>
        ))}
      </div>

      <p class="start-here-footnote">
        Not sure where to begin? Start with the option that feels closest. You can always come back and choose a different path.
      </p>
    </div>
  </section>

  <style>
    .start-here-inner {
      max-width: 1000px;
      margin: 0 auto;
    }

    .start-here-header {
      margin-bottom: 2.5rem;
      text-align: center;
    }

    .start-here-header h1 {
      font-size: var(--text-xxl);
      font-weight: 600;
      color: var(--kbm-green);
      margin: 0 0 1rem 0;
    }

    .start-here-intro {
      font-size: var(--text-lg);
      color: #243015;
      line-height: 1.65;
      margin: 0 auto 0.75rem;
      max-width: 40rem;
    }

    .start-here-intro:last-child {
      margin-bottom: 0;
    }

    .start-here-choice-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 2.5rem;
    }

    @media (min-width: 768px) {
      .start-here-choice-grid {
        grid-template-columns: 1fr 1fr;
        gap: 1.75rem;
      }
    }

    /* Cards are containers with a button, not clickable links */
    .start-here-card.kbm-card {
      cursor: default;
      margin: 0;
    }

    .start-here-card .kbm-card__title {
      font-size: 1.35rem;
      line-height: 1.3;
      margin-bottom: 0.5rem;
    }

    .start-here-card__subtitle {
      font-size: var(--text-base);
      font-style: italic;
      color: var(--kbm-green-2, #738c52);
      line-height: 1.5;
      margin: 0 0 1rem 0;
    }

    .start-here-card .kbm-card__desc {
      font-size: var(--text-base);
      line-height: 1.6;
      color: #3a4a24;
      margin-bottom: 1.5rem;
    }

    .start-here-card__btn {
      align-self: center;
      margin-top: auto;
    }

    .start-here-footnote {
      font-size: var(--text-base);
      color: #6b7280;
      line-height: 1.6;
      text-align: center;
      margin: 0 auto;
      max-width: 42rem;
    }
  </style>
</Layout>
