---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import videos from "../../data/videos-public.json";
import { getPreviewMember } from "../../lib/getPreviewMember";

// --- Featured tip (Tuesday Tip / Weekly Quick Win) ---
// Set the Vimeo video ID for the featured tip card. Leave empty to hide the card.
// Link, thumbnail, and title are resolved from videos-public.json by matching vimeo_id.
const featuredTipVideo = Array.isArray(videos)
  ? videos.find((v: { isTipOfWeek?: boolean }) => v.isTipOfWeek === true)
  : null;
const indexQuery = Astro.url.search || "";
const featuredTip = featuredTipVideo
  ? {
      href: "/tips",
      title: (featuredTipVideo as { title?: string }).title ?? "This Week's Quick Win",
      posterUrl: (featuredTipVideo as { posterUrl?: string }).posterUrl ?? (featuredTipVideo as { poster_url?: string }).poster_url ?? "",
    }
  : null;

/** Temporary: treat every catalog card as member-only until free video exceptions are restored. */
const FORCE_ALL_VIDEOS_LOCKED = false;

/** Preview state for dev/testing; in production always "default" */
const previewMember = getPreviewMember(Astro.url);
const forceMemberView =
  previewMember === "member"
    ? true
    : previewMember === "nonmember"
      ? false
      : null;
---

<Layout title="Videos" description="Browse and search videos." bodyClass="page--tight-header">
  <div class="page-wrap">

    <PageHead
      title="Tutorials"
      hideTitle
    />

    <section class="video-catalog-hero">
      <div class="video-catalog-hero__grid">
        <div class="video-catalog-hero__intro">
          <p class="video-catalog-hero__eyebrow">Video Tutorials</p>
          <h1>Learn with clear, practical machine knitting videos</h1>
          <p>
            Browse tutorials, technique lessons, and quick help videos designed
            to help you build skills and solve problems as you knit.
          </p>
          <p>
            Whether you want to learn something new or find a quick solution,
            this library gives you a place to start.
          </p>
        </div>
        {/* Tuesday Tip / Weekly Quick Win: KBM card with ribbon, SVG, title, thumbnail + play overlay */}
        {featuredTip && (
          <aside class="tuesday-tip-feature" aria-label="Tuesday Tip">
            <a href={featuredTip.href} class="kbm-card tip-of-week-card">
              <span class="kbm-card-ribbon">Latest</span>
              <img
                src="/images/tuesday-tip.svg"
                class="tip-header"
                alt="Tuesday Tip"
              />
              {featuredTip.title && (
                <h3 class="tip-title">{featuredTip.title}</h3>
              )}
              <div class="tip-thumb-wrap">
                {featuredTip.posterUrl ? (
                  <>
                    <img
                      src={featuredTip.posterUrl}
                      alt={featuredTip.title}
                      class="tip-image"
                      loading="lazy"
                    />
                    <span class="tip-play" aria-hidden="true">
                      <svg viewBox="0 0 68 68" class="tip-play__icon" focusable="false">
                        <circle cx="34" cy="34" r="34"></circle>
                        <polygon points="28,22 28,46 48,34"></polygon>
                      </svg>
                    </span>
                  </>
                ) : (
                  <div class="tip-image-placeholder" aria-hidden="true" />
                )}
              </div>
            </a>
          </aside>
        )}
      </div>
    </section>

    <div class="video-toolbar">
      <div class="video-category">
        <div class="category-bar" id="categoryBar">
          <label for="category-select" class="sr-only">Category</label>
          <select id="category-select" class="sr-only" aria-label="Video category"></select>
          <button
            id="categoryTrigger"
            class="category-trigger"
            type="button"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls="categoryMenu"
          >
            <span class="category-prefix">Category:</span>
            <span id="categoryLabel" class="category-label">All Videos</span>
            <span class="category-chevron" aria-hidden="true">▾</span>
          </button>
          <div id="categoryMenu" class="category-menu" role="listbox" aria-label="Video categories" hidden></div>
        </div>
      </div>
      <div class="video-search">
        <input
          id="videoSearch"
          type="search"
          placeholder="Search by technique or keyword"
          autocomplete="off"
        />
      </div>
    </div>


    <div id="video-grid" class="video-grid"></div>
    
  </div>

  <script id="videos-data" type="application/json" set:html={JSON.stringify(videos)} />
  <script is:inline define:vars={{ forceMemberView, FORCE_ALL_VIDEOS_LOCKED }}>
    window.__PREVIEW_FORCE_MEMBER__ = forceMemberView;
    window.__FORCE_ALL_VIDEOS_LOCKED__ = FORCE_ALL_VIDEOS_LOCKED;
  </script>

  <script is:inline>
    (function () {
      const raw = document.getElementById("videos-data")?.textContent || "{}";
      let parsed;
      try {
        parsed = JSON.parse(raw);
      } catch (parseErr) {
        console.error(parseErr);
        return;
      }
      const videos = Array.isArray(parsed) ? parsed : (parsed?.videos ?? parsed?.items ?? parsed?.data ?? []);
      if (videos.length === 0) {
        console.warn("videos-data: no video items found (empty or missing array).");
        return;
      }

      const grid = document.getElementById("video-grid");
      const selectEl = document.getElementById("category-select");
      const searchInput = document.getElementById("videoSearch");

      const categories = Array.from(new Set(videos.map(v => v.category).filter(Boolean))).sort();

    const urlParams = new URLSearchParams(location.search);
    const requested = urlParams.get("cat");
    const matchedCategory = requested && categories.find((c) => c.toLowerCase() === requested.toLowerCase());
    const defaultCategory = matchedCategory ? matchedCategory : "";
    const initialQ = urlParams.get("q") || "";
    const initialSort = urlParams.get("sort") || "";

    let currentSearch = initialQ;
    let currentCategory = defaultCategory;
    let currentSort = initialSort;
    let searchTimer;

    /* Paid-tier plan IDs: used only for VIEWER.isMember. Catalog lock badges use VIEWER.hasVideoAccess (kin_access). */
    const MEMBER_PLAN_IDS = new Set([
      "pln_kin-membership-annual-qf9g01et",
      "pln_kin-membership-monthly-a59701wy",
    ]);

    async function getViewerState() {
      try {
        const res = await window.$memberstackDom?.getAppAndMember?.();
        const member = res?.data?.member || null;
        if (!member) return { isLoggedIn: false, isMember: false, hasVideoAccess: false, member: null };

        const conns = Array.isArray(member.planConnections) ? member.planConnections : [];
        const activePlanIds = new Set(
          conns
            .filter(function (c) { return c && c.status === "ACTIVE" && c.active; })
            .map(function (c) { return c.planId; })
            .filter(Boolean)
        );

        const isMember = [...activePlanIds].some(function (id) { return MEMBER_PLAN_IDS.has(id); });

        const kinAccess = member.customFields?.kin_access;
        const hasVideoAccess =
          Boolean(member) &&
          kinAccess !== false &&
          kinAccess !== "false";

        return { isLoggedIn: true, isMember: isMember, hasVideoAccess: hasVideoAccess, member: member };
      } catch (e) {
        return { isLoggedIn: false, isMember: false, hasVideoAccess: false, member: null };
      }
    }

    let VIEWER = { isLoggedIn: false, isMember: false, hasVideoAccess: false, member: null };

    async function waitForMemberstackReady(opts) {
      const attempts = (opts && opts.attempts) !== undefined ? opts.attempts : 30;
      const delayMs = (opts && opts.delayMs) !== undefined ? opts.delayMs : 200;
      for (let i = 0; i < attempts; i++) {
        try {
          if (window.$memberstackDom && window.$memberstackDom.getAppAndMember) {
            const res = await window.$memberstackDom.getAppAndMember();
            return res;
          }
        } catch (e) {
          // keep trying
        }
        await new Promise(function (r) { return setTimeout(r, delayMs); });
      }
      return null;
    }

    function updateUrl() {
      const params = new URLSearchParams();
      if (currentCategory) params.set("cat", currentCategory);
      if (currentSearch) params.set("q", currentSearch);
      if (currentSort) params.set("sort", currentSort);
      const qs = params.toString();
      history.replaceState(null, "", location.pathname + (qs ? "?" + qs : ""));
    }

    function setCat(cat) {
      currentCategory = cat || "";
      currentSearch = "";

      if (searchInput) {
        searchInput.value = "";
      }

      updateUrl();
    }

    function render(cat) {

      currentCategory = cat || "";

      let filtered = currentCategory
        ? videos.filter(v => v.category === currentCategory)
        : videos;

      if (currentSearch) {
        const q = currentSearch.toLowerCase();

        filtered = filtered.filter(v =>
          (v.title || "").toLowerCase().includes(q) ||
          (v.description || "").toLowerCase().includes(q) ||
          (v.summary || "").toLowerCase().includes(q) ||
          (v.category || "").toLowerCase().includes(q)
        );
      }

      filtered.sort((a, b) => (a.title || "").localeCompare(b.title || ""));

      if (!grid) return;

      if (filtered.length === 0) {
        grid.innerHTML =
          "<div class=\"video-grid-empty-state\">" +
          "<div class=\"video-grid-empty-state__card\">" +
          "<p class=\"video-grid-empty-state__title\">We couldn't find that.</p>" +
          "<p class=\"video-grid-empty-state__text\">" +
          "<a href=\"#\" class=\"video-grid-empty-state__link empty-state-try-again\">Try again</a>" +
          " or take a look at this week's " +
          "<a href=\"tips\" class=\"video-grid-empty-state__link\">Tuesday Tip.</a>" +
          "</p>" +
          "</div>" +
          "</div>";
        return;
      }

      /* Video access: preview override (dev), dev bypass, or Memberstack hasVideoAccess (kin_access). */
      const previewForce = window.__PREVIEW_FORCE_MEMBER__;
      const hasAccess =
        previewForce === true
          ? true
          : previewForce === false
            ? false
            : window.__DEV_BYPASS_GATING || window.__KBM_DEV_MEMBER__ || VIEWER.hasVideoAccess;
      const listParams = new URLSearchParams();
      if (currentCategory) listParams.set("cat", currentCategory);
      if (currentSearch) listParams.set("q", currentSearch);
      if (currentSort) listParams.set("sort", currentSort);
      const listQuery = listParams.toString();
      const listQueryString = listQuery ? "?" + listQuery : "";

      grid.innerHTML = filtered.map(v => {
        const isFreeByData = v.access_level === "open";
        const isFree =
          window.__FORCE_ALL_VIDEOS_LOCKED__ === true ? false : isFreeByData;
        const baseHref = v.content_id ? "/videos/" + v.content_id : "/videos/" + (v.slug || "");
        const href = baseHref + listQueryString;
        const title = (v.title || "").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        const poster = v.posterUrl
          ? "<div class=\"video-thumb\"><img class=\"video-card__img\" src=\"" + v.posterUrl.replace(/"/g, "&quot;") + "\" alt=\"\" loading=\"lazy\" />" +
            (!hasAccess
              ? (isFree ? "<div class=\"badge-free\">FREE</div>" : "<div class=\"badge-lock\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg></div>")
              : "") +
            "</div>"
          : "";
        const desc = (v.description || v.summary || "").replace(/</g, "&lt;").replace(/>/g, "&gt;");

        return (
          "<a class=\"kbm-card\" href=\"" + href + "\">" +
            poster +
            "<h3 class=\"kbm-card__title\">" + title + "</h3>" +
            (desc ? "<p class=\"kbm-card__desc\">" + desc + "</p>" : "") +
          "</a>"
        );
      }).join("");
    }

    /* ---------- Custom dropdown UI (build and sync before first render so URL category wins) ---------- */
    const trigger = document.getElementById("categoryTrigger");
    const label = document.getElementById("categoryLabel");
    const menu = document.getElementById("categoryMenu");

    function setLabelFromValue(val) {
      if (!label) return;
      label.textContent = val ? val : "All Videos";
    }

    function openMenu() {
      if (!trigger || !menu) return;
      menu.hidden = false;
      menu.removeAttribute("hidden");
      trigger.setAttribute("aria-expanded", "true");
    }

    function closeMenu() {
      if (!trigger || !menu) return;
      menu.hidden = true;
      menu.setAttribute("hidden", "");
      trigger.setAttribute("aria-expanded", "false");
    }

    function toggleMenu() {
      if (!menu) return;
      if (menu.hidden) openMenu();
      else closeMenu();
    }

    function buildMenuOptions(cats) {
      if (!menu) return;
      menu.innerHTML = "";

      // Add "All Videos"
      const allBtn = document.createElement("button");
      allBtn.type = "button";
      allBtn.className = "category-option";
      allBtn.setAttribute("role", "option");
      allBtn.setAttribute("data-value", "");
      allBtn.textContent = "All Videos";
      menu.appendChild(allBtn);

      cats.forEach((c) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "category-option";
        btn.setAttribute("role", "option");
        btn.setAttribute("data-value", c);
        btn.textContent = c;
        menu.appendChild(btn);
      });
    }

    function syncSelectedUI(val) {
      setLabelFromValue(val);

      if (menu) {
        Array.from(menu.querySelectorAll(".category-option")).forEach((btn) => {
          const v = btn.getAttribute("data-value") || "";
          btn.setAttribute("aria-selected", v === (val || "") ? "true" : "false");
        });
      }

      // Keep the hidden select in sync (fallback)
      if (selectEl) {
        selectEl.value = val || "";
      }
    }

    // Build hidden select options + custom menu options
    if (selectEl) {
      selectEl.innerHTML = "";
      const optAll = document.createElement("option");
      optAll.value = "";
      optAll.textContent = "All Videos";
      selectEl.appendChild(optAll);

      categories.forEach((c) => {
        const o = document.createElement("option");
        o.value = c;
        o.textContent = c;
        selectEl.appendChild(o);
      });
    }

    buildMenuOptions(categories);

    // Initial UI sync from URL (must run before first render so category is not reset to All)
    syncSelectedUI(currentCategory);

    if (searchInput) {
      searchInput.value = currentSearch;
    }

    (async function () {
      render(currentCategory);

      await waitForMemberstackReady();
      VIEWER = await getViewerState();

      render(currentCategory);
    })();

    // Toggle open/close
    if (trigger) {
      trigger.addEventListener("click", () => toggleMenu());
    }

    // Click option to select
    if (menu) {
      menu.addEventListener("click", (e) => {
        const btn = e.target && e.target.closest ? e.target.closest(".category-option") : null;
        if (!btn) return;
        const val = btn.getAttribute("data-value") || "";
        setCat(val);
        render(val);
        syncSelectedUI(val);
        closeMenu();

        const bar = document.getElementById("categoryBar");
        if (bar) bar.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }

    // Close on outside click
    document.addEventListener("click", (e) => {
      if (!menu || !trigger) return;
      const t = e.target;
      const inside = (t === trigger) || trigger.contains(t) || menu.contains(t);
      if (!inside) closeMenu();
    });

    // Close on ESC
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMenu();
    });

    // Add a "stuck" class for polish once the toolbar pins to the top
    const band = document.querySelector(".video-toolbar");
    if (band) {
      const onScroll = () => {
        const r = band.getBoundingClientRect();
        const root = document.documentElement;
        const offset = parseFloat(getComputedStyle(root).getPropertyValue("--header-offset")) || 170;
        const buffer = parseFloat(getComputedStyle(root).getPropertyValue("--header-buffer")) || 24;
        const top = offset + buffer;
        band.classList.toggle("is-stuck", r.top <= top + 1);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll(); // run once so it sets correctly on load
    }
    /* ---------- end custom dropdown ---------- */

    if (searchInput) {

      searchInput.addEventListener("input", function () {

        clearTimeout(searchTimer);

        const value = this.value || "";

        searchTimer = setTimeout(function () {

          currentSearch = value.trim();

          updateUrl();

          render(currentCategory);

        }, 150);

      });

    }

    // Empty state "Try again" — clear search and re-render
    if (grid) {
      grid.addEventListener("click", function (e) {
        const tryAgain = e.target && e.target.closest ? e.target.closest(".empty-state-try-again") : null;
        if (!tryAgain) return;
        e.preventDefault();
        currentSearch = "";
        if (searchInput) searchInput.value = "";
        updateUrl();
        render(currentCategory);
      });
    }
    })();
  </script>

  <style>
    .page-wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 8px 20px 80px;
    }

    /* --- Video catalog hero --- */
    .video-catalog-hero {
      margin-bottom: 2rem;
    }
    .video-catalog-hero__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      align-items: start;
    }
    @media (min-width: 720px) {
      .video-catalog-hero__grid {
        grid-template-columns: 1fr minmax(280px, 380px);
      }
    }
    .video-catalog-hero__eyebrow {
      margin: 0 0 0.5rem;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--kbm-green, #52682d);
    }
    .video-catalog-hero__intro h1 {
      margin: 0 0 1rem;
      font-size: var(--text-xxl, 1.75rem);
      line-height: 1.25;
    }
    .video-catalog-hero__intro p {
      margin: 0 0 0.75rem;
      max-width: 52ch;
    }

    /* --- Tuesday Tip / Weekly Quick Win: KBM card with ribbon --- */
    .tuesday-tip-feature {
      padding: 18px;
      border-radius: 18px;
      background: #f7f9f4;
      border: 1px solid #e4eadb;
      box-shadow: 0 4px 14px rgba(0,0,0,0.05);
    }
    .tip-of-week-card {
      text-decoration: none;
      color: inherit;
    }
    .tip-of-week-card:focus-visible {
      outline: 2px solid var(--kbm-green, #52682d);
      outline-offset: 2px;
    }
    /* Ribbon text for this card: "This week" — shifted left and down to fit in fold */
    .tip-of-week-card .kbm-card-ribbon::after {
      content: "This week" !important;
      top: 30px;
      left: 2px;
      transform-origin: center center;
    }
    .tip-header {
      display: block;
      max-width: 160px;
      height: auto;
      margin: 0 auto 10px;
    }
    .tip-title {
      text-align: center;
      font-size: 1rem;
      font-weight: 600;
      margin: 0.5rem 0 0.75rem;
      color: #333;
    }
    .tip-thumb-wrap {
      position: relative;
      width: 100%;
    }
    .tip-of-week-card img,
    .tip-image {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 12px;
      transition: transform 0.2s ease;
    }
    .tip-of-week-card:hover img {
      transform: scale(1.01);
    }
    .tip-play {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }
    .tip-play__icon {
      width: 68px;
      height: 68px;
      filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.22));
      transition: transform 0.18s ease;
    }
    .tip-play__icon circle {
      fill: rgba(0, 0, 0, 0.45);
    }
    .tip-play__icon polygon {
      fill: #ffffff;
    }
    .tip-of-week-card:hover .tip-play__icon,
    .tip-of-week-card:focus-visible .tip-play__icon {
      transform: scale(1.04);
    }
    .tip-image-placeholder {
      width: 100%;
      aspect-ratio: 16 / 9;
      background: linear-gradient(135deg, #e5e7eb 0%, #d1d5db 100%);
      border-radius: 12px;
    }

    /* --- Video toolbar (category + search) --- */
    .video-toolbar {
      position: sticky;
      top: calc(var(--header-offset, 170px) + var(--header-buffer, 24px));
      z-index: 40;

      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;

      padding: 14px 18px;
      background: #f3f4f2;
      border-radius: 12px;
      margin-bottom: 1.5rem;

      transition: box-shadow 200ms ease;
    }

    .video-toolbar.is-stuck {
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
    }

    .video-category {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .video-search {
      max-width: 360px;
      width: 100%;
      border: none;
      background: transparent;
      padding: 0;
    }

    .video-search input {
      width: 100%;
      padding: 10px 14px;
      border-radius: 8px;
      border: 1px solid #cfd4c6;
      font-size: 15px;
    }

    .video-search input:focus {
      outline: none;
      border-color: #738c52;
      box-shadow: 0 0 0 2px rgba(115, 140, 82, 0.15);
    }

    @media (max-width: 700px) {
      .video-toolbar {
        flex-direction: column;
        align-items: stretch;
      }

      .video-search {
        max-width: none;
      }
    }

    /* =====================================
       Custom Category Dropdown (Styled)
       ===================================== */

    .category-bar {
      position: sticky;
      top: calc(var(--header-offset, 170px) + var(--header-buffer, 24px));
      z-index: 30;

      background: var(--kbm-green, #52682d);
      border-radius: 14px;
      padding: 0.65rem 0.9rem;
      margin: 0.75rem 0 1.5rem 0;

      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    }

    /* Button that looks like a label, not an input */
    .category-trigger {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;

      background: transparent;
      border: 0;
      padding: 0.25rem 0.35rem;
      cursor: pointer;

      color: #fff;
      font-size: 1.15rem;
      font-weight: 500;
      text-align: left;
    }

    .category-label {
      display: block;
      white-space: nowrap;
    }

    .category-chevron {
      flex: 0 0 auto;
      opacity: 0.9;
    }

    /* Dropdown panel — calm and clean */
    #categoryBar .category-menu {
      margin-top: 0.6rem;
      background: #ffffff;
      border-radius: 12px;
      padding: 0.5rem;
      border: 1px solid rgba(0,0,0,0.10);
      box-shadow: 0 18px 44px rgba(0,0,0,0.14);

      max-height: min(52vh, 420px);
      overflow: auto;

      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    /* Option rows — remove "input box" vibe */
    #categoryBar .category-option {
      all: unset;
      box-sizing: border-box;

      display: block;
      width: 100%;

      padding: 0.55rem 0.75rem;
      border-radius: 10px;

      cursor: pointer;
      user-select: none;

      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;

      font-size: 0.98rem;
      line-height: 1.2;
      color: #1f2937;

      /* IMPORTANT: no border/outline box look */
      border: none;
      background: transparent;
    }

    /* Hover/focus — subtle tint */
    #categoryBar .category-option:hover,
    #categoryBar .category-option:focus {
      background: rgba(82,104,45,0.10);
    }

    /* Selected — slightly stronger tint */
    #categoryBar .category-option[aria-selected="true"] {
      background: rgba(82,104,45,0.16);
      font-weight: 600;
    }

    .video-page-title {
      margin: 0;
      font-size: var(--text-xxl);
      line-height: 1.2;
    }

    .subcat-segment {
      display: inline-flex;
      align-items: stretch;
      gap: 0;
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 12px;
      overflow: hidden;
      background: #fff;
      margin-bottom: 1rem;
    }

    .subcat-tab {
      appearance: none;
      border: 0;
      background: transparent;
      padding: 8px 12px;
      font: inherit;
      font-size: 0.9rem;
      cursor: pointer;
      line-height: 1;
      text-decoration: none;
      color: inherit;
      border-right: 1px solid rgba(0, 0, 0, 0.1);
    }

    .subcat-tab:last-child {
      border-right: 0;
    }

    .subcat-tab:hover {
      background: rgba(0, 0, 0, 0.03);
    }

    .subcat-tab.is-active {
      background: rgba(0, 0, 0, 0.06);
      font-weight: 600;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .video-search {
      width: 100%;
      max-width: 420px;
      border: none;
      background: transparent;
      padding: 0;
    }

    /* Video grid: cards use global .kbm-card, .kbm-card__title, .kbm-card__desc */
    #video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 16px;
      align-items: start;
    }

  </style>

  <style is:global>
    /* Empty state when no videos match search/filter (injected via JS so needs global) */
    #video-grid .video-grid-empty-state {
      grid-column: 1 / -1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 1.5rem;
    }
    #video-grid .video-grid-empty-state__card {
      padding: 1.5rem 1.75rem;
      text-align: center;
      background: rgb(249, 248, 243);
      border: 1px solid rgba(52, 91, 56, 0.2);
      border-radius: 14px;
      color: rgb(52, 91, 56);
      max-width: 420px;
    }
    #video-grid .video-grid-empty-state__title {
      margin: 0 0 0.5rem;
      font-size: 1.2rem;
      font-weight: 700;
    }
    #video-grid .video-grid-empty-state__text {
      margin: 0;
      font-size: 1rem;
      font-weight: 400;
    }
    #video-grid .video-grid-empty-state__link {
      color: inherit;
      text-decoration: underline;
    }
    #video-grid .video-grid-empty-state__link:hover {
      text-decoration-thickness: 2px;
    }
    #video-grid .video-grid-empty-state__link:focus-visible {
      outline: 2px solid rgb(52, 91, 56);
      outline-offset: 2px;
    }
  </style>

  <style is:global>
    /* Override: remove gray frame/outline on video card thumbnails (overrides global .video-thumb / .kbm-card styles) */
    .kbm-card .video-thumb,
    .kbm-card .video-thumb picture,
    .kbm-card .video-thumb img {
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      box-shadow: none !important;
    }

    .kbm-card .video-thumb {
      position: relative;
      overflow: hidden;
      border-radius: 14px;
      height: 140px;
    }

    .kbm-card .video-thumb picture {
      display: block;
      width: 100%;
      height: 100%;
    }

    .kbm-card .video-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Video card badges (JS-injected) */
    .badge-lock,
    .badge-free {
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 6px 8px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .badge-lock {
      background: var(--kbm-green);
      color: white;
    }

    .badge-lock svg {
      width: 18px;
      height: 18px;
      stroke-width: 2.5;
    }

    .badge-free {
      background: #16a34a;
      color: white;
      letter-spacing: 0.5px;
    }

    .category-prefix {
      font-size: 0.75rem;
      font-weight: 400;
      opacity: 0.6;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-right: 0.5rem;
    }

    /* Make the inner dropdown pill use its own sticky behavior = off (band handles stickiness) */
    #categoryBar.category-bar {
      position: relative; /* NOT sticky now */
      top: auto;
      z-index: 1;

      background: var(--kbm-green, #52682d);
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    }

    /* --- Category dropdown: force [hidden] to work --- */
    #categoryBar #categoryMenu[hidden] {
      display: none !important;
    }

    /* --- Sticky bar sizing/shape --- */
    #categoryBar.category-bar {
      z-index: 50;

      display: inline-flex;
      width: auto;
      min-width: 260px;
      max-width: min(100%, 600px);

      padding: 0.4rem 0.8rem;   /* tighter vertical */
      border-radius: 14px;
    }

    /* Button */
    #categoryBar .category-trigger {
      width: 100%;
      padding: 0.2rem 0.4rem;

      font-size: 1.05rem;
      font-weight: 500;
    }

    .category-chevron {
      font-size: 0.9rem;
    }

    /* Dropdown panel floats, doesn't push content */
    #categoryBar #categoryMenu.category-menu {
      position: absolute;
      left: 0;
      top: calc(100% + 0.5rem);
      width: min(420px, 92vw);

      margin-top: 0 !important;
    }

    /* Options: phone-friendly tap targets */
    #categoryBar .category-option {
      font-size: 1.05rem;
      padding: 0.85rem 0.9rem;
      min-height: 44px; /* touch target */
    }

    /* Mobile: bar and menu full width */
    @media (max-width: 768px) {
      #categoryBar.category-bar {
        width: 100%;
        display: flex;
      }
      #categoryBar #categoryMenu.category-menu {
        width: 100%;
      }
      
    }
  </style>
</Layout>
