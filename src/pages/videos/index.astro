---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import videosRaw from "../../data/videos-public.json";
import { getPreviewMember } from "../../lib/getPreviewMember";
import { filterPublicCatalogVideos } from "../../lib/videoPublic";
import "../../styles/favorites.css";

const publicVideos = filterPublicCatalogVideos(Array.isArray(videosRaw) ? videosRaw : []);

// --- Featured tip (Tuesday Tip / Weekly Quick Win) ---
// Link and text are resolved from videos-public.json via tipOfWeek/isTipOfWeek.
const featuredTipVideo = publicVideos.find(
  (v: { tipOfWeek?: boolean; isTipOfWeek?: boolean }) =>
    v.tipOfWeek === true || v.isTipOfWeek === true,
);
const indexQuery = Astro.url.search || "";
const featuredTipHref = featuredTipVideo
  ? (
      (featuredTipVideo as { content_id?: string | number; slug?: string }).content_id
        ? "/videos/" + (featuredTipVideo as { content_id?: string | number }).content_id
        : "/videos/" + ((featuredTipVideo as { slug?: string }).slug ?? "")
    )
  : "";
const featuredTip = featuredTipVideo
  ? {
      href: featuredTipHref,
      isTipOfWeek:
        (featuredTipVideo as { isTipOfWeek?: boolean; tipOfWeek?: boolean }).isTipOfWeek === true ||
        (featuredTipVideo as { isTipOfWeek?: boolean; tipOfWeek?: boolean }).tipOfWeek === true,
      tipHeadline: (featuredTipVideo as { tipHeadline?: string }).tipHeadline ?? "",
      tipNote: (featuredTipVideo as { tipNote?: string }).tipNote ?? "",
      title: (featuredTipVideo as { title?: string }).title ?? "",
      description:
        (featuredTipVideo as { description?: string; summary?: string }).description ??
        (featuredTipVideo as { description?: string; summary?: string }).summary ??
        "",
    }
  : null;

/**
 * Feature flag: show/hide the Tuesday Tip promo card in the hero.
 * Set to `true` to re-enable the card (and its two-column hero layout).
 * All supporting code/markup is preserved below; only the render is gated.
 */
const SHOW_TUESDAY_TIP_CARD = false;

/** Temporary: treat every catalog card as member-only until free video exceptions are restored. */
const FORCE_ALL_VIDEOS_LOCKED = false;

/** Preview state for dev/testing; in production always "default" */
const previewMember = getPreviewMember(Astro.url);
const forceMemberView =
  previewMember === "member"
    ? true
    : previewMember === "nonmember"
      ? false
      : null;
---

<Layout title="Videos" description="Browse and search videos." bodyClass="page--tight-header">
  <div class="page-wrap">

    <PageHead
      title="Tutorials"
      hideTitle
    />

    <section class="video-catalog-hero">
      <div class={`video-catalog-hero__grid${SHOW_TUESDAY_TIP_CARD && featuredTip ? "" : " video-catalog-hero__grid--full"}`}>
        <div class="video-catalog-hero__intro">
          <p class="video-catalog-hero__eyebrow">Video Tutorials</p>
          <h1>Learn with clear, practical machine knitting videos</h1>
          <p>
            Browse tutorials, technique lessons, and quick help videos to build skills and solve problems as you knit.
          </p>
        </div>
        {/* Tuesday Tip / Weekly Quick Win: compact promo card */}
        {SHOW_TUESDAY_TIP_CARD && featuredTip && (
          <aside class="tuesday-tip-feature" aria-label="Tuesday Tip">
            <div class="kbm-card tip-of-week-card">
              <img
                src="/images/tuesday-tip.svg"
                class="tip-header"
                alt="Tuesday Tip"
              />
              <div class="tip-card-top">
                <span class="tip-play-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="tip-play-badge__icon" focusable="false">
                    <circle cx="12" cy="12" r="11"></circle>
                    <polygon points="10,8 10,16 17,12"></polygon>
                  </svg>
                </span>
                <div class="tip-card-content">
                  {featuredTip.tipHeadline && (
                    <h3 class="kbm-tip-headline">{featuredTip.tipHeadline}</h3>
                  )}
                  <p class="kbm-tip-title">{featuredTip.title}</p>
                  {featuredTip.tipNote && (
                    <p class="kbm-tip-note">{featuredTip.tipNote}</p>
                  )}
                </div>
              </div>
              <a href={featuredTip.href} class="kbm-btn kbm-btn-primary tip-watch-btn">
                Watch Tuesday Tip
              </a>
            </div>
          </aside>
        )}
      </div>
    </section>

    <div class="video-toolbar" aria-label="Video controls">
      <div class="video-primary-filters" role="group" aria-label="Video filters">
        <button type="button" class="video-filter-btn" data-filter="" aria-pressed="false">
          All Videos
        </button>
        <button type="button" class="video-filter-btn" data-filter="__free__" aria-pressed="false">
          Free Videos
        </button>
        <button type="button" class="video-filter-btn" data-filter="__favorites__" aria-pressed="false">
          My Favorites
        </button>
      </div>

      <div class="video-toolbar__inputs">
        <section class="video-filter-search" aria-label="Find a Video">
          <label for="videoSearch" id="video-filter-search-title" class="sr-only">Find a Video</label>
          <div class="search-input-wrapper">
            <svg class="icon-search" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" fill="none"></circle>
              <line x1="16.65" y1="16.65" x2="21" y2="21" stroke="currentColor" stroke-width="2"></line>
            </svg>
            <input
              id="videoSearch"
              class="video-filter-search__input"
              type="search"
              placeholder="Search by title or description"
              autocomplete="off"
              aria-label="Find a Video"
            />
          </div>
        </section>

        <div class="video-category">
          <span class="video-category__title sr-only" id="categoryBrowseTitle">Category</span>
          <div class="category-bar" id="categoryBar">
            <label for="category-select" class="sr-only">Category</label>
            <select id="category-select" class="sr-only" aria-label="Category"></select>
            <button
              id="categoryTrigger"
              class="category-trigger"
              type="button"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="categoryMenu"
              aria-labelledby="categoryBrowseTitle categoryLabel"
            >
              <span id="categoryLabel" class="category-label">All Categories</span>
              <span class="category-chevron" aria-hidden="true">▾</span>
            </button>
            <div id="categoryMenu" class="category-menu" role="listbox" aria-label="Video categories" hidden></div>
          </div>
        </div>
      </div>
    </div>

    <p id="video-results-summary" class="video-results-summary" aria-live="polite" role="status"></p>
    <p id="video-favorites-status" class="sr-only" aria-live="polite" role="status"></p>

    <div id="video-grid" class="video-grid"></div>
    
  </div>

  <script id="videos-data" type="application/json" set:html={JSON.stringify(publicVideos)} />
  <script is:inline define:vars={{ forceMemberView, FORCE_ALL_VIDEOS_LOCKED }}>
    window.__PREVIEW_FORCE_MEMBER__ = forceMemberView;
    window.__FORCE_ALL_VIDEOS_LOCKED__ = FORCE_ALL_VIDEOS_LOCKED;
  </script>

  <script>
    // Video catalog cards use the SAME global member gate as every other section.
    import {
      getViewerAccessState,
      hasMemberAccess,
      logMemberAccessDebug,
    } from "../../lib/memberAccess";
    import { sortWithFreeContentFirst } from "../../lib/catalogFreeContentFirst";
    import { openMemberstackLoginModal } from "../../lib/memberstackLogin";
    import { getMemberstackReturnPath } from "../../lib/memberstackReturnUrl";
    import { favoriteStarButtonHtml, filterVideosByFavoriteIds } from "../../lib/favorites/favoriteStarUi";
    import { initFavoriteStarController } from "../../lib/favorites/favoriteStarController";
    import { listFavorites } from "../../lib/favorites/favoritesClient";

    (function () {
      const FREE_FILTER_VALUE = "__free__";
      const FAVORITES_FILTER_VALUE = "__favorites__";
      const raw = document.getElementById("videos-data")?.textContent || "{}";
      let parsed;
      try {
        parsed = JSON.parse(raw);
      } catch (parseErr) {
        console.error(parseErr);
        return;
      }
      const videos = Array.isArray(parsed) ? parsed : (parsed?.videos ?? parsed?.items ?? parsed?.data ?? []);
      if (videos.length === 0) {
        console.warn("videos-data: no video items found (empty or missing array).");
        return;
      }

      const grid = document.getElementById("video-grid");
      const selectEl = document.getElementById("category-select");
      const searchInput = document.getElementById("videoSearch");
      const favoritesStatusEl = document.getElementById("video-favorites-status");

      const categories = Array.from(new Set(videos.map(v => v.category).filter(Boolean))).sort();

    const urlParams = new URLSearchParams(location.search);
    const requested = urlParams.get("cat");
    const matchedCategory = requested && categories.find((c) => c.toLowerCase() === requested.toLowerCase());
    const requestedIsFree =
      requested && (requested.toLowerCase() === "free" || requested === FREE_FILTER_VALUE);
    const requestedIsFavorites =
      requested && (requested.toLowerCase() === "favorites" || requested === FAVORITES_FILTER_VALUE);
    // Favorites filter requires login; apply only after auth resolves when requested via URL.
    // URL ?cat= wins; otherwise active members keep All Videos (""), no-access default to Free after auth.
    const defaultCategory = requestedIsFree
      ? FREE_FILTER_VALUE
      : matchedCategory
        ? matchedCategory
        : "";
    const pendingFavoritesFilter = Boolean(requestedIsFavorites);
    const hasExplicitCategoryRequest = Boolean(
      requestedIsFree || matchedCategory || pendingFavoritesFilter,
    );
    const initialQ = urlParams.get("q") || "";
    const initialSort = urlParams.get("sort") || "";

    let currentSearch = initialQ;
    let currentCategory = defaultCategory;
    let currentSort = initialSort;
    let searchTimer;
    /** True once the visitor changes the category after load (do not re-apply auth default). */
    let categoryTouchedByUser = false;
    /** @type {Set<string>} */
    let favoriteIds = new Set();

    async function getViewerState() {
      try {
        const res = await waitForMemberstackReady();
        const member = res?.data?.member ?? null;
        const hasVideoAccess = hasMemberAccess(res);
        logMemberAccessDebug("videos/index.catalog", res, {
          viewerAccessState: getViewerAccessState(res),
        });
        if (!member) return { isLoggedIn: false, hasVideoAccess: false, member: null };
        return { isLoggedIn: true, hasVideoAccess: hasVideoAccess, member: member };
      } catch (e) {
        return { isLoggedIn: false, hasVideoAccess: false, member: null };
      }
    }

    let VIEWER = { isLoggedIn: false, hasVideoAccess: false, member: null };
    let ACCESS_STATE = "checking";

    async function waitForMemberstackReady(opts) {
      const attempts = (opts && opts.attempts) !== undefined ? opts.attempts : 30;
      const delayMs = (opts && opts.delayMs) !== undefined ? opts.delayMs : 200;
      for (let i = 0; i < attempts; i++) {
        try {
          const api = window.$memberstackDom?.getAppAndMember;
          if (typeof api === "function") return await api();
        } catch (e) {
          // keep trying
        }
        await new Promise(function (r) { return setTimeout(r, delayMs); });
      }
      return null;
    }
    function applyAccessUiState() {
      if (ACCESS_STATE === "has_access") {
        removeLockedUiArtifacts();
        hideAllVisibleLockIconsForAccess();
      }
    }
    function removeLockedUiArtifacts() {
      // Explicitly remove any lock UI that may have been rendered before auth resolved.
      document.querySelectorAll(".kbm-lock-overlay").forEach(function (el) { el.remove(); });
      document.querySelectorAll(".video-card .fa-lock, .video-card [class*='lock']").forEach(function (el) {
        if (el.classList && el.classList.contains("kbm-lock-overlay")) return;
        const lockContainer = el.closest ? el.closest(".kbm-lock-overlay") : null;
        if (lockContainer) lockContainer.remove();
        else el.setAttribute("hidden", "");
      });
      document.querySelectorAll(".kbm-video-card[hidden], .video-card[hidden]").forEach(function (el) {
        el.removeAttribute("hidden");
      });
      document.querySelectorAll(".kbm-video-card.is-locked, .video-card.is-locked").forEach(function (el) {
        el.classList.remove("is-locked");
      });
    }
    /** Same playback access as GatedVimeoEmbed / videos/[id] (public + open = free). */
    function catalogVideoPlaybackAccess(v) {
      if (v.tipOfWeek === true || v.isTipOfWeek === true) return "open";
      const level = String(v.access_level ?? "member").trim().toLowerCase();
      if (level === "open" || level === "public") return "open";
      return "member";
    }
    function isMemberOnlyVideo(v) {
      return catalogVideoPlaybackAccess(v) === "member";
    }
    function hideAllVisibleLockIconsForAccess() {
      const pageRoot = document.querySelector(".page-wrap");
      if (!pageRoot) return;
      pageRoot.querySelectorAll(
        ".kbm-lock-overlay, .fa-lock, .fa-lock-open, .svg-inline--fa.fa-lock, [aria-label='Member-only video']"
      ).forEach(function (el) {
        if (el.classList && el.classList.contains("videos-access-debug")) return;
        if (el.classList && el.classList.contains("videos-access-debug__content")) return;
        if (el.classList && el.classList.contains("videos-access-debug__title")) return;
        el.remove();
      });
    }

    function updateUrl() {
      const params = new URLSearchParams();
      if (currentCategory) {
        const catParam =
          currentCategory === FREE_FILTER_VALUE
            ? "free"
            : currentCategory === FAVORITES_FILTER_VALUE
              ? "favorites"
              : currentCategory;
        params.set("cat", catParam);
      }
      if (currentSearch) params.set("q", currentSearch);
      if (currentSort) params.set("sort", currentSort);
      const qs = params.toString();
      history.replaceState(null, "", location.pathname + (qs ? "?" + qs : ""));
    }

    function categoryLabel(cat) {
      if (cat === FREE_FILTER_VALUE) return "Free Videos";
      if (cat === FAVORITES_FILTER_VALUE) return "My Favorites";
      return cat || "All Videos";
    }

    function isVideoFree(video) {
      const isFreeByData = catalogVideoPlaybackAccess(video) === "open";
      return window.__FORCE_ALL_VIDEOS_LOCKED__ === true ? false : isFreeByData;
    }

    function setCat(cat) {
      categoryTouchedByUser = true;
      currentCategory = cat || "";
      currentSearch = "";
      if (searchInput instanceof HTMLInputElement) {
        searchInput.value = "";
      }

      updateUrl();
    }

    function updateResultsSummary(count) {
      const el = document.getElementById("video-results-summary");
      if (!el) return;
      const n = Number(count) || 0;
      let msg = n === 1 ? "Showing 1 video" : "Showing " + n + " videos";
      if (currentSearch) {
        msg += " for '" + currentSearch + "'";
      }
      if (currentCategory) {
        msg += " in " + categoryLabel(currentCategory);
      }
      el.textContent = msg;
    }

    function render(cat) {

      currentCategory = cat || "";

      let filtered = currentCategory
        ? currentCategory === FREE_FILTER_VALUE
          ? videos.filter(v => isVideoFree(v))
          : currentCategory === FAVORITES_FILTER_VALUE
            ? filterVideosByFavoriteIds(videos, favoriteIds)
            : videos.filter(v => v.category === currentCategory)
        : videos;

      if (currentSearch) {
        const q = currentSearch.toLowerCase();
        filtered = filtered.filter(v =>
          (v.title || "").toLowerCase().includes(q) ||
          (v.description || "").toLowerCase().includes(q) ||
          (v.summary || "").toLowerCase().includes(q)
        );
      }

      // Non-members: free/open videos first; members keep alphabetical order only.
      const preferFreeFirst =
        ACCESS_STATE === "logged_out" || ACCESS_STATE === "no_access";
      filtered = sortWithFreeContentFirst(filtered, {
        isFree: isVideoFree,
        preferFreeFirst,
        compare: (a, b) => (a.title || "").localeCompare(b.title || ""),
      });

      updateResultsSummary(filtered.length);

      if (!grid) return;

      if (filtered.length === 0) {
        const favoritesEmpty =
          currentCategory === FAVORITES_FILTER_VALUE && !currentSearch
            ? "<p class=\"video-grid-empty-state__title\">You haven't added any favorite videos yet.</p>" +
              "<p class=\"video-grid-empty-state__text\">" +
              "Tap the star beside a video title to save it here. " +
              "<a href=\"#\" class=\"video-grid-empty-state__link empty-state-try-again\">Browse all videos</a>" +
              "</p>"
            : currentCategory === FAVORITES_FILTER_VALUE && currentSearch
              ? "<p class=\"video-grid-empty-state__title\">No favorite videos match your search.</p>" +
                "<p class=\"video-grid-empty-state__text\">" +
                "<a href=\"#\" class=\"video-grid-empty-state__link empty-state-try-again\">Clear search</a>" +
                " or browse all videos.</p>"
              : "<p class=\"video-grid-empty-state__title\">We couldn't find that.</p>" +
                "<p class=\"video-grid-empty-state__text\">" +
                "<a href=\"#\" class=\"video-grid-empty-state__link empty-state-try-again\">Try again</a>" +
                " or take a look at this week's " +
                "<a href=\"tips\" class=\"video-grid-empty-state__link\">Tuesday Tip.</a>" +
                "</p>";
        grid.innerHTML =
          "<div class=\"video-grid-empty-state\">" +
          "<div class=\"video-grid-empty-state__card\">" +
          favoritesEmpty +
          "<button type=\"button\" class=\"kbm-clear-filters\">Clear all filters</button>" +
          "</div>" +
          "</div>";
        return;
      }

      const listParams = new URLSearchParams();
      if (currentCategory) {
        const catParam =
          currentCategory === FREE_FILTER_VALUE
            ? "free"
            : currentCategory === FAVORITES_FILTER_VALUE
              ? "favorites"
              : currentCategory;
        listParams.set("cat", catParam);
      }
      if (currentSearch) listParams.set("q", currentSearch);
      if (currentSort) listParams.set("sort", currentSort);
      const listQuery = listParams.toString();
      const listQueryString = listQuery ? "?" + listQuery : "";

      const hasVideoAccess = ACCESS_STATE === "has_access" || Boolean(VIEWER.hasVideoAccess);
      grid.innerHTML = filtered.map(v => {
        const contentId = v.content_id != null && String(v.content_id).trim() ? String(v.content_id) : "";
        const baseHref = contentId ? "/videos/" + contentId : "/videos/" + (v.slug || "");
        const href = baseHref + listQueryString;
        const titleText = v.title || "Video";
        const title = titleText.replace(/</g, "&lt;").replace(/>/g, "&gt;");
        const catalogPlayOverlay =
          "<span class=\"tip-play video-thumb__play\" aria-hidden=\"true\">" +
          "<svg viewBox=\"0 0 68 68\" class=\"tip-play__icon\" focusable=\"false\">" +
          "<circle cx=\"34\" cy=\"34\" r=\"34\"></circle>" +
          "<polygon points=\"28,22 28,46 48,34\"></polygon>" +
          "</svg></span>";
        const isMemberOnly = isMemberOnlyVideo(v);
        const showLocked = isMemberOnly && !hasVideoAccess;
        const lockOverlay =
          showLocked
            ? "<span class=\"kbm-lock-overlay\" aria-label=\"Member-only video\"><i class=\"fa-solid fa-lock\" aria-hidden=\"true\"></i></span>"
            : "";
        const poster = v.posterUrl
          ? "<div class=\"video-thumb kbm-card-thumb\"><img class=\"video-card__img\" src=\"" +
            v.posterUrl.replace(/"/g, "&quot;") +
            "\" alt=\"\" loading=\"lazy\" />" +
            catalogPlayOverlay +
            lockOverlay +
            "</div>"
          : "";
        const desc = (v.description || v.summary || "").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        const starHtml = contentId
          ? favoriteStarButtonHtml({
              contentType: "video",
              contentId,
              title: titleText,
              isFavorite: favoriteIds.has(contentId),
            })
          : "";

        return (
          "<a class=\"kbm-card video-card kbm-video-card" + (showLocked ? " is-locked" : "") + "\" href=\"" + href + "\">" +
            poster +
            "<div class=\"kbm-card-body\">" +
            "<div class=\"favorite-title-row\">" +
            "<h3 class=\"kbm-card__title kbm-card-title\">" +
            title +
            "</h3>" +
            starHtml +
            "</div>" +
            (desc ? "<p class=\"kbm-card__desc kbm-card-description\">" + desc + "</p>" : "") +
            "</div>" +
            "</a>"
        );
      }).join("");
      if (ACCESS_STATE === "has_access") {
        removeLockedUiArtifacts();
        hideAllVisibleLockIconsForAccess();
      }
    }

    /* ---------- Filter buttons + category dropdown (sync before first render so URL category wins) ---------- */
    const trigger = document.getElementById("categoryTrigger");
    const label = document.getElementById("categoryLabel");
    const menu = document.getElementById("categoryMenu");
    const categoryBar = document.getElementById("categoryBar");
    const primaryFilterBtns = Array.from(
      document.querySelectorAll(".video-primary-filters .video-filter-btn"),
    );

    function isCatalogCategory(val) {
      return Boolean(val) && val !== FREE_FILTER_VALUE && val !== FAVORITES_FILTER_VALUE;
    }

    function setLabelFromValue(val) {
      if (!label) return;
      label.textContent = isCatalogCategory(val) ? val : "All Categories";
    }

    function openMenu() {
      if (!trigger || !menu) return;
      menu.hidden = false;
      menu.removeAttribute("hidden");
      trigger.setAttribute("aria-expanded", "true");
    }

    function closeMenu() {
      if (!trigger || !menu) return;
      menu.hidden = true;
      menu.setAttribute("hidden", "");
      trigger.setAttribute("aria-expanded", "false");
    }

    function toggleMenu() {
      if (!menu) return;
      if (menu.hidden) openMenu();
      else closeMenu();
    }

    function buildMenuOptions(cats) {
      if (!menu) return;
      menu.innerHTML = "";

      cats.forEach((c) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "category-option kbm-dropdown-item";
        btn.setAttribute("role", "option");
        btn.setAttribute("data-value", c);
        btn.textContent = c;
        menu.appendChild(btn);
      });
    }

    function syncSelectedUI(val) {
      const selected = val || "";
      const categoryActive = isCatalogCategory(selected);

      setLabelFromValue(selected);

      primaryFilterBtns.forEach((btn) => {
        const filterVal = btn.getAttribute("data-filter") || "";
        const active = !categoryActive && filterVal === selected;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-pressed", active ? "true" : "false");
      });

      if (categoryBar) {
        categoryBar.classList.toggle("is-category-active", categoryActive);
      }

      if (menu) {
        Array.from(menu.querySelectorAll(".category-option")).forEach((btn) => {
          const v = btn.getAttribute("data-value") || "";
          btn.setAttribute("aria-selected", categoryActive && v === selected ? "true" : "false");
        });
      }

      if (selectEl) {
        selectEl.value = categoryActive ? selected : "";
      }
    }

    function applyFilterSelection(val) {
      if (val === FAVORITES_FILTER_VALUE && !VIEWER.isLoggedIn) {
        openMemberstackLoginModal(getMemberstackReturnPath());
        return;
      }
      setCat(val);
      render(val);
      syncSelectedUI(val);
      closeMenu();
    }

    // Build hidden select options + category-only menu
    if (selectEl) {
      selectEl.innerHTML = "";
      const optBrowse = document.createElement("option");
      optBrowse.value = "";
      optBrowse.textContent = "All Categories";
      selectEl.appendChild(optBrowse);

      categories.forEach((c) => {
        const o = document.createElement("option");
        o.value = c;
        o.textContent = c;
        selectEl.appendChild(o);
      });
    }

    buildMenuOptions(categories);

    // Initial UI sync from URL (must run before first render so category is not reset to All)
    syncSelectedUI(currentCategory);
    if (searchInput instanceof HTMLInputElement) {
      searchInput.value = currentSearch;
    }

    initFavoriteStarController({
      root: grid || document,
      statusEl: favoritesStatusEl,
      onChanged: (detail) => {
        if (detail.contentType !== "video") return;
        if (detail.isFavorite) favoriteIds.add(detail.contentId);
        else favoriteIds.delete(detail.contentId);
        if (currentCategory === FAVORITES_FILTER_VALUE) {
          render(currentCategory);
        }
      },
    });

    async function hydrateFavorites() {
      if (!VIEWER.isLoggedIn) {
        favoriteIds = new Set();
        return;
      }
      try {
        const rows = await listFavorites("video");
        favoriteIds = new Set(rows.map((row) => String(row.content_id)));
      } catch {
        favoriteIds = new Set();
        if (favoritesStatusEl) {
          favoritesStatusEl.textContent = "Could not load favorites.";
        }
      }
    }

    (async function () {
      render(currentCategory);

      await waitForMemberstackReady();
      VIEWER = await getViewerState();
      ACCESS_STATE = !VIEWER.isLoggedIn
        ? "logged_out"
        : VIEWER.hasVideoAccess
          ? "has_access"
          : "no_access";

      await hydrateFavorites();

      if (pendingFavoritesFilter) {
        if (VIEWER.isLoggedIn) {
          currentCategory = FAVORITES_FILTER_VALUE;
          syncSelectedUI(currentCategory);
          updateUrl();
        } else {
          openMemberstackLoginModal(getMemberstackReturnPath());
          currentCategory = "";
          syncSelectedUI("");
          updateUrl();
        }
      } else if (
        !hasExplicitCategoryRequest &&
        !categoryTouchedByUser &&
        !VIEWER.hasVideoAccess
      ) {
        // No member access (anonymous or logged-in non-member): Free Videos.
        // Active members (hasMemberAccess) keep All Videos / URL selection.
        currentCategory = FREE_FILTER_VALUE;
        syncSelectedUI(currentCategory);
        updateUrl();
      }

      render(currentCategory);
      applyAccessUiState();
    })();

    primaryFilterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        applyFilterSelection(btn.getAttribute("data-filter") || "");
      });
    });

    // Toggle open/close
    if (trigger) {
      trigger.addEventListener("click", () => toggleMenu());
    }

    // Category option select
    if (menu) {
      menu.addEventListener("click", (e) => {
        const btn = e.target && e.target.closest ? e.target.closest(".category-option") : null;
        if (!btn) return;
        applyFilterSelection(btn.getAttribute("data-value") || "");
        if (categoryBar) categoryBar.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }

    // Close on outside click
    document.addEventListener("click", (e) => {
      if (!menu || !trigger) return;
      const t = e.target;
      const inside = (t === trigger) || trigger.contains(t) || menu.contains(t);
      if (!inside) closeMenu();
    });

    // Close on ESC
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMenu();
    });

    /* ---------- end custom dropdown ---------- */

    if (searchInput instanceof HTMLInputElement) {
      searchInput.addEventListener("input", function () {
        clearTimeout(searchTimer);
        const value = this.value || "";
        searchTimer = setTimeout(function () {
          currentSearch = value.trim();
          updateUrl();
          render(currentCategory);
        }, 150);
      });
    }

    // Empty state "Try again" — re-render current category
    if (grid) {
      grid.addEventListener("click", function (e) {
        const clearFilters = e.target && e.target.closest ? e.target.closest(".kbm-clear-filters") : null;
        if (clearFilters) {
          e.preventDefault();
          clearTimeout(searchTimer);
          categoryTouchedByUser = true;
          currentSearch = "";
          currentCategory = "";
          currentSort = "";
          if (searchInput instanceof HTMLInputElement) searchInput.value = "";
          syncSelectedUI("");
          history.replaceState(null, "", location.pathname);
          render("");
          return;
        }
        const tryAgain = e.target && e.target.closest ? e.target.closest(".empty-state-try-again") : null;
        if (!tryAgain) return;
        e.preventDefault();
        currentSearch = "";
        if (searchInput instanceof HTMLInputElement) searchInput.value = "";
        if (currentCategory === FAVORITES_FILTER_VALUE) {
          categoryTouchedByUser = true;
          currentCategory = "";
          syncSelectedUI("");
        }
        updateUrl();
        render(currentCategory);
      });
    }
    })();
  </script>

