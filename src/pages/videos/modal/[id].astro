---
/**
 * Chrome-less catalog player for the pattern video modal.
 * Pattern buttons stay compact links. This page is loaded in one iframe
 * only after a button is clicked, so opening a video does not add players
 * beside the other instructions.
 *
 * Playback uses the same membership gate as /videos/[id]: member-only
 * catalog rows do not include a Vimeo URL until access is confirmed.
 */
import GatedVimeoEmbed from "../../../components/videos/GatedVimeoEmbed.astro";
import { findPublicCatalogVideoByContentId } from "../../../lib/videoPublic";
import { catalogVideoPlaybackAccess } from "../../../lib/videos/catalogVideoPlaybackAccess";
import { loadMergedVideoCatalog } from "../../../lib/videos/videoCatalogStore";
import { applyVideoPosterOverrides } from "../../../lib/videos/videoPosterOverrides";
import { loadPublicVideoPosterOverrides } from "../../../lib/videos/videoPosterStore";

export const prerender = false;

const id = String(Astro.params.id ?? "").trim();
const videosRaw = await loadMergedVideoCatalog();
const posterOverrides = await loadPublicVideoPosterOverrides();
const catalog = applyVideoPosterOverrides(videosRaw, posterOverrides);
const video = id ? findPublicCatalogVideoByContentId(catalog, id) : undefined;
Astro.response.headers.set("Cache-Control", "private, no-store");

const rawVimeoId = video ? (video as { vimeo_id_public?: unknown; vimeo_id?: unknown }).vimeo_id_public ?? (video as { vimeo_id?: unknown }).vimeo_id : "";
const vimeoId = rawVimeoId != null ? String(rawVimeoId).trim() : "";
const privacyHash =
  video && typeof (video as { vimeo_hash?: unknown }).vimeo_hash === "string"
    ? String((video as { vimeo_hash?: string }).vimeo_hash).trim()
    : "";
const title = video ? String((video as { title?: unknown }).title ?? "").trim() || "Video" : "Video not found";
const rawAccessLevel = String(video ? (video as { access_level?: unknown }).access_level ?? "member" : "member")
  .trim()
  .toLowerCase();
const effectiveAccessLevel = catalogVideoPlaybackAccess({
  access_level: rawAccessLevel,
  isTipOfWeek: video ? (video as { isTipOfWeek?: unknown }).isTipOfWeek === true : false,
  tipOfWeek: video ? (video as { tipOfWeek?: unknown }).tipOfWeek === true : false,
});
const rawPosterUrl = video
  ? String((video as { posterUrl?: unknown; poster_url?: unknown }).posterUrl ?? (video as { poster_url?: unknown }).poster_url ?? "")
  : "";
const posterSrc =
  rawPosterUrl && (rawPosterUrl.startsWith("http") || rawPosterUrl.startsWith("/"))
    ? rawPosterUrl
    : rawPosterUrl
      ? `/images/${rawPosterUrl}`
      : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <script is:inline>
      var memberstackConfig = {
        useCookies: true,
        setCookieOnRootDomain: true,
      };
    </script>
    <script
      data-memberstack-app="app_cmfh3d1n802vb0wy706205810"
      data-memberstack-use-cookies
      src="https://static.memberstack.com/scripts/v2/memberstack.js"
      type="text/javascript"
    ></script>
    <style>
      :where(html, body) {
        margin: 0;
        background: #fff;
      }
      body {
        box-sizing: border-box;
        padding: 12px 16px 16px;
        font-family: system-ui, sans-serif;
        color: #1a1a1a;
      }
      .modal-video-title {
        margin: 0 0 10px;
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.3;
      }
      .modal-video-missing {
        margin: 0;
        font-size: 0.95rem;
        color: #444;
      }
    </style>
  </head>
  <body>
    {video && vimeoId ? (
      <div class="modal-video-player">
        <h1 class="modal-video-title">{title}</h1>
        <GatedVimeoEmbed
          videoId={vimeoId}
          contentId={id}
          title={title}
          access_level={effectiveAccessLevel}
          thumbUrl={posterSrc}
          privacyHash={privacyHash}
        />
      </div>
    ) : (
      <p class="modal-video-missing">This video could not be found.</p>
    )}
  </body>
</html>
