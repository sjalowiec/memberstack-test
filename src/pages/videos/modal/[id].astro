---
/**
 * Modal-only embed: no site Layout. Match video by content_id from videos-public.json.
 */
import videos from "../../../data/videos-public.json";

/** SSR so any content_id (e.g. invalid /videos/modal/4321) returns fallback HTML, not a router 404. */
export const prerender = false;

const id = String(Astro.params.id ?? "");
const video = videos.find((v) => String(v.content_id) === id);

const rawTitle = video ? String((video as { title?: string }).title ?? "").trim() : "";
const docTitle = video ? rawTitle || "Video" : "Video not found";

const vimeoRaw = video ? (video as { vimeo_id?: string | number }).vimeo_id : undefined;
const hasPlayer =
  video != null &&
  vimeoRaw != null &&
  String(vimeoRaw).trim() !== "";

/** Vimeo player URL; vimeo_id may include a privacy hash, e.g. 1046394794?h=abc123 */
const iframeSrc = hasPlayer
  ? `https://player.vimeo.com/video/${String(vimeoRaw).trim()}`
  : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
    <style>
      :where(html, body) {
        margin: 0;
        background: #fff;
      }
      body {
        box-sizing: border-box;
        padding: 12px 16px;
        font-family: system-ui, sans-serif;
        color: #1a1a1a;
      }
      .modal-video-title {
        margin: 0 0 10px;
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.3;
      }
      .embed {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        background: #000;
      }
      .embed iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }
      .fallback {
        margin: 0;
        font-size: 0.9rem;
        color: #444;
      }
    </style>
  </head>
  <body>
    {
      video && hasPlayer ? (
        <div class="modal-video-player">
          {rawTitle ? <h1 class="modal-video-title">{rawTitle}</h1> : null}
          <div class="embed">
            <iframe
              src={iframeSrc}
              title={rawTitle || "Video"}
              loading="lazy"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            />
          </div>
        </div>
      ) : (
        <p class="fallback">This video could not be found.</p>
      )
    }
  </body>
</html>
