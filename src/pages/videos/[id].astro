---
import videosRaw from "../../data/videos-public.json";
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import LoginNudge from "../../components/auth/LoginNudge.astro";
import GatedVimeoEmbed from "../../components/videos/GatedVimeoEmbed.astro";
import { catalogChaptersFromVideoRow, type CatalogChapterRow } from "../../lib/catalogVideoChapters";
import { filterPublicCatalogVideos, findPublicCatalogVideoByContentId } from "../../lib/videoPublic";
export const prerender = true;

export function getStaticPaths() {
  return filterPublicCatalogVideos(videosRaw).map((v) => ({
    params: { id: String(v.content_id) },
  }));
}

const id = String(Astro.params.id);
const video = findPublicCatalogVideoByContentId(videosRaw, id);

const contentIdForJumplinks = Number((video as any)?.content_id ?? Astro.params?.id ?? NaN);
const contentIdAttr = !Number.isNaN(contentIdForJumplinks) ? String(contentIdForJumplinks) : "";

// Normalize Vimeo ID: prefer the public ID, fall back to the internal one.
// JSON may store these as numbers, so coerce to a trimmed string before use.
const rawVimeoId = (video as any)?.vimeo_id_public ?? (video as any)?.vimeo_id;
const vimeoId = rawVimeoId ? String(rawVimeoId).trim() : "";
const title = (video as any)?.title ?? "Video";
const description = (video as any)?.description ?? "";
const downloadUrlRaw =
  typeof (video as any)?.downloadUrl === "string" ? String((video as any).downloadUrl).trim() : "";
/** Only allow site-relative paths (avoid accidental open redirects from JSON). */
const downloadUrl =
  downloadUrlRaw.startsWith("/") && !downloadUrlRaw.startsWith("//") ? downloadUrlRaw : "";
const downloadLabelRaw =
  typeof (video as any)?.downloadLabel === "string"
    ? String((video as any).downloadLabel).trim()
    : "";
const downloadLabel = downloadLabelRaw || "Download";

// Normalize access_level so downstream gating only sees "open" | "member".
// JSON uses several public synonyms ("public", "free", "open"); treat all as open.
const rawAccessLevel = String((video as any)?.access_level ?? "member")
  .trim()
  .toLowerCase();
const normalizedAccessLevel =
  rawAccessLevel === "open" || rawAccessLevel === "public" || rawAccessLevel === "free"
    ? "open"
    : "member";

// Public exception: when this video is the featured Tuesday Tip (isTipOfWeek), show player to everyone.
// Otherwise use the normalized access_level from JSON (default "member").
const isFeaturedTip = (video as any)?.isTipOfWeek === true;
const effectiveAccessLevelFromVideo = isFeaturedTip ? "open" : normalizedAccessLevel;
/** Temporary until free video exceptions are restored — set false to use JSON/tip logic again. */
const TEMPORARY_FORCE_MEMBER_WATCH = false;
const effectiveAccessLevel = TEMPORARY_FORCE_MEMBER_WATCH
  ? "member"
  : effectiveAccessLevelFromVideo;

// thumbnail / poster: support full URL, /path, or filename → /images/filename
const rawPosterUrl = (video as any)?.posterUrl ?? (video as any)?.poster_url ?? "";
const posterSrc =
  rawPosterUrl && (rawPosterUrl.startsWith("http") || rawPosterUrl.startsWith("/"))
    ? rawPosterUrl
    : rawPosterUrl
      ? `/images/${rawPosterUrl}`
      : "";

/** Catalog `chapters` or `jumpLinks` from the video record for Vimeo Player.js seek on the detail page. */
const catalogChapters: CatalogChapterRow[] = video ? catalogChaptersFromVideoRow(video) : [];
const hasCatalogChapters = catalogChapters.length > 0;
const enableVideoChapterControls = hasCatalogChapters;
---

<Layout title={video ? title : "Video not found"} description={video ? description : "Video not found."}>
  <style>
    /* Override global .page-wrap top padding; Layout already supplies header clearance */
    .video-detail-wrap.page-wrap { padding-top: 8px; }
    .back-link { display: inline-block; margin-bottom: 0.75rem; }
  </style>
  <div class="page-wrap video-detail-wrap">
    <a class="back-link back-to-videos-link" id="back-to-videos" href="/videos">← Back to Videos</a>
    {!video ? (
      <>
        <PageHead title="Video not found" description="Video not found." />
        <article class="video-detail">
          <p>Video not found. <a class="back-to-videos-link" href="/videos">Back to Videos</a>.</p>
        </article>
      </>
    ) : (
      <>
        <PageHead title={title} />

        <article class="video-detail">
          {/* PLAYER AREA */}
          <section>
            {/* Temporarily disabled: page-level locked teaser so GatedVimeoEmbed controls the player
            <div class="gated-locked" data-gated="locked">
              <div class="teaser-player">
                {posterSrc ? (
                  <img class="video-poster" src={posterSrc} alt={title} loading="lazy" />
                ) : (
                  <div class="video-poster-fallback" aria-hidden="true"></div>
                )}

                <div class="locked-overlay">
                  <h2 class="locked-title">Full video available to members</h2>
                  <p class="locked-text">
                    Watch the complete tutorial and scan key sections with jump links.
                  </p>

                  <div class="locked-actions">
                    <a class="btn btn-primary kbm-cta-guide" href="/join">Become a member</a>
                    <!-- swap /videos for your real pricing / join / Stripe page when ready -->
                  </div>
                  <LoginNudge className="locked-nudge" />
                </div>
              </div>
            </div>
            */}

            <GatedVimeoEmbed
              videoId={vimeoId}
              title={title}
              access_level={effectiveAccessLevel}
              enableVimeoPlayerApi={enableVideoChapterControls}
            />
          </section>

          {/* JUMP LINKS — from `chapters` or `jumpLinks` on the record (open: always visible; member: gated until access). */}
          <nav class="video-jumplinks" aria-label="Jump links" data-content-id={contentIdAttr}>
            <div class="jumplinks-head"><h2>Jump to</h2></div>

            {hasCatalogChapters && effectiveAccessLevel === "open" ? (
              <div class="jumplinks" id="jumplinks">
                {catalogChapters.map((chapter) => (
                  <button
                    type="button"
                    class="jumplink btn btn-secondary btn-small"
                    data-video-jump={String(chapter.time)}
                    data-video-start={String(chapter.time)}
                  >
                    <i class="fa fa-fast-forward" aria-hidden="true"></i>
                    {chapter.label}
                  </button>
                ))}
              </div>
            ) : hasCatalogChapters && effectiveAccessLevel === "member" ? (
              <>
                <div class="gated-locked" data-gated="locked">
                  <div class="jumplinks-disabled" aria-disabled="true">
                    <p class="locked-inline">Jump links are available with access.</p>
                  </div>
                </div>

                <div class="gated-content" data-gated="content" hidden>
                  <div class="jumplinks" id="jumplinks">
                    {catalogChapters.map((chapter) => (
                      <button
                        type="button"
                        class="jumplink btn btn-secondary btn-small"
                        data-video-jump={String(chapter.time)}
                        data-video-start={String(chapter.time)}
                      >
                        <i class="fa fa-fast-forward" aria-hidden="true"></i>
                        {chapter.label}
                      </button>
                    ))}
                  </div>
                </div>
              </>
            ) : (
              <>
                <div class="gated-locked" data-gated="locked">
                  <div class="jumplinks-disabled" aria-disabled="true">
                    <p class="locked-inline">Jump links are available with access.</p>
                  </div>
                </div>

                <div class="gated-content" data-gated="content" hidden>
                  <div class="jumplinks" id="jumplinks"></div>
                </div>
              </>
            )}
          </nav>

          {/* DESCRIPTION (always visible); plain text only — optional worksheet link via downloadUrl */}
          <section class="video-description">
            <h2>Description</h2>
            {description ? <div class="video-desc-text">{description}</div> : null}
            {downloadUrl ? (
              <p class="video-desc-download">
                <a class="video-desc-download__link kbm-btn kbm-btn-primary" href={downloadUrl}>
                  {downloadLabel}
                </a>
              </p>
            ) : null}
          </section>
        </article>

        <script>
          import { MEMBER_PLAN_IDS } from "../../config/memberships";
          import { hasKinVideoAccess, logKinVideoAccessDebug } from "../../lib/kinVideoAccess";
          import { videoDevBypass } from "../../lib/devBypass";

          // --- Memberstack: client-side unlock for jump links (basic/premium plan required) ---
          const memberPlanIds = new Set<string>(MEMBER_PLAN_IDS);

          async function waitForMemberstackReady({ attempts = 30, delayMs = 200 } = {}) {
            for (let i = 0; i < attempts; i++) {
              try {
                const api = window.$memberstackDom?.getAppAndMember;
                if (typeof api === "function") return await api();
              } catch (e) {}
              await new Promise((r) => setTimeout(r, delayMs));
            }
            return null;
          }

          function getViewerStateFromRes(res) {
            const member = res?.data?.member ?? null;
            const planConnections = member?.planConnections ?? [];
            const activePlanIds = new Set(
              planConnections
                .filter((p) => (p?.status ?? "").toUpperCase() === "ACTIVE")
                .map((p) => p?.planId)
                .filter(Boolean)
            );

            const isLoggedIn = Boolean(member);
            const isMember = [...activePlanIds].some((id) => memberPlanIds.has(id));

            const rawKinAccess = member?.customFields?.["kin-access"];
            const hasVideoAccess = hasKinVideoAccess(res);

            logKinVideoAccessDebug("videos/[id].jumpLinks", {
              member: res,
              rawKinAccess,
              finalHasVideoAccess: hasVideoAccess,
            });

            return { isLoggedIn, isMember, hasVideoAccess, member };
          }

          function setAccess(hasFullAccess) {
            document.querySelectorAll('[data-gated="content"]').forEach((el: Element) => {
              if (hasFullAccess) el.removeAttribute("hidden");
              else el.setAttribute("hidden", "");
            });
            document.querySelectorAll('[data-gated="locked"]').forEach((el) => {
              if (hasFullAccess) el.setAttribute("hidden", "");
              else el.removeAttribute("hidden");
            });
          }

          async function refreshJumpLinkAccess() {
            setAccess(false);

            if (videoDevBypass) {
              console.log("[KBM video access debug]", "videos/[id].setAccess.unlock", {
                videoDevBypass,
              });
              setAccess(true);
              return;
            }

            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get("mode") === "full") {
              console.log("[KBM video access debug]", "videos/[id].setAccess.unlock", { mode: "full" });
              setAccess(true);
              return;
            }

            const res = await waitForMemberstackReady();
            const viewer = getViewerStateFromRes(res);
            setAccess(Boolean(viewer.hasVideoAccess));
          }

          let jumpLinkAuthBound = false;
          function bindJumpLinkAuthRefresh() {
            if (jumpLinkAuthBound) return;
            const ms = window.$memberstackDom;
            if (!ms?.on) return;
            jumpLinkAuthBound = true;
            ms.on("member.login", () => {
              void refreshJumpLinkAccess();
            });
            ms.on("member.logout", () => {
              void refreshJumpLinkAccess();
            });
          }

          void (async () => {
            await refreshJumpLinkAccess();
            bindJumpLinkAuthRefresh();
            void window.$memberstackDom?.onReady?.then(() => {
              bindJumpLinkAuthRefresh();
            });
            window.addEventListener("auth:updated", () => {
              void refreshJumpLinkAccess();
            });
          })();
        </script>

        {enableVideoChapterControls ? (
          <script
            is:inline
            define:vars={{
              kbmChapterSeekIframeId: `kbm-gated-vimeo-${vimeoId}`,
              kbmChapterSeekSlotId: `kbm-vimeo-slot-${vimeoId}`,
            }}
          >
            (function () {
              var iframeId = kbmChapterSeekIframeId;
              var slotId = kbmChapterSeekSlotId;
              var VIMEO_API_SRC = "https://player.vimeo.com/api/player.js";
              var vimeoApiPromise = null;
              var player = null;
              var bindInFlight = false;

              function ensureVimeoApi() {
                if (typeof window !== "undefined" && window.Vimeo && window.Vimeo.Player) {
                  return Promise.resolve();
                }
                if (vimeoApiPromise) return vimeoApiPromise;
                var existing = document.querySelector('script[src="' + VIMEO_API_SRC + '"]');
                if (existing) {
                  vimeoApiPromise = new Promise(function (resolve, reject) {
                    if (window.Vimeo && window.Vimeo.Player) {
                      resolve();
                      return;
                    }
                    function onLoad() {
                      existing.removeEventListener("load", onLoad);
                      if (window.Vimeo && window.Vimeo.Player) resolve();
                      else reject(new Error("Vimeo API unavailable"));
                    }
                    function onErr() {
                      existing.removeEventListener("error", onErr);
                      vimeoApiPromise = null;
                      reject(new Error("Vimeo Player API script failed"));
                    }
                    existing.addEventListener("load", onLoad);
                    existing.addEventListener("error", onErr);
                    Promise.resolve().then(function () {
                      if (window.Vimeo && window.Vimeo.Player) {
                        existing.removeEventListener("load", onLoad);
                        existing.removeEventListener("error", onErr);
                        resolve();
                      }
                    });
                  });
                  return vimeoApiPromise;
                }
                vimeoApiPromise = new Promise(function (resolve, reject) {
                  var s = document.createElement("script");
                  s.src = VIMEO_API_SRC;
                  s.async = true;
                  s.onload = function () {
                    resolve();
                  };
                  s.onerror = function () {
                    vimeoApiPromise = null;
                    reject(new Error("Vimeo Player API script failed"));
                  };
                  document.head.appendChild(s);
                });
                return vimeoApiPromise;
              }

              function parseTime(attr) {
                if (attr == null || !String(attr).trim()) return null;
                var n = parseFloat(String(attr).trim());
                return Number.isFinite(n) && n >= 0 ? n : null;
              }

              function tryBindPlayer() {
                var iframe = document.getElementById(iframeId);
                if (!(iframe instanceof HTMLIFrameElement)) return;
                var src = iframe.getAttribute("src") || "";
                if (!src.trim()) return;
                if (player || bindInFlight) return;
                bindInFlight = true;
                ensureVimeoApi()
                  .then(function () {
                    try {
                      player = new window.Vimeo.Player(iframe);
                    } catch (e) {}
                    return player ? player.ready() : Promise.resolve();
                  })
                  .catch(function () {})
                  .then(function () {
                    bindInFlight = false;
                  });
              }

              function watchSlot() {
                var slot = document.getElementById(slotId);
                if (!slot) return;
                var obs = new MutationObserver(function () {
                  tryBindPlayer();
                });
                obs.observe(slot, { childList: true, subtree: true });
                tryBindPlayer();
              }

              if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", watchSlot);
              } else {
                watchSlot();
              }

              document.addEventListener(
                "click",
                function (e) {
                  var t = e.target;
                  if (!(t instanceof Element)) return;
                  var btn = t.closest(".video-jumplinks button.jumplink[data-video-jump]");
                  if (!(btn instanceof HTMLButtonElement)) return;
                  var sec = parseTime(btn.getAttribute("data-video-jump"));
                  if (sec === null) return;
                  var iframe = document.getElementById(iframeId);
                  if (!(iframe instanceof HTMLIFrameElement)) return;
                  e.preventDefault();
                  ensureVimeoApi()
                    .then(function () {
                      if (!player) {
                        try {
                          player = new window.Vimeo.Player(iframe);
                        } catch (err) {}
                      }
                      return player ? player.ready() : Promise.reject();
                    })
                    .then(function () {
                      return player.setCurrentTime(sec);
                    })
                    .then(function () {
                      return player.play();
                    })
                    .catch(function () {});
                },
                true
              );
            })();
          </script>
        ) : null}

        <style>
          /* minimal safety styles; keep or delete if you already have equivalents */
          .teaser-player { position: relative; border-radius: 16px; overflow: hidden; background: #111; }
          .video-poster { width: 100%; display: block; }
          .video-poster-fallback { width: 100%; aspect-ratio: 16/9; background: #222; }
          /* Ensure overlay text is white and overrides global heading color */
          .locked-overlay { position: absolute; inset: 0; display: grid; place-content: center; gap: 6px; /* tighter vertical spacing */ padding: 18px; text-align: center; background: rgba(0,0,0,.55); color: #fff; }
          .locked-overlay .locked-title { color: #fff; margin-bottom: 6px; }
          .locked-overlay .locked-text { margin-top: 0; }
          .locked-overlay .locked-nudge { margin-top: 10px; }
          .locked-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
          .btn { padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(255,255,255,.35); color: white; text-decoration: none; }
          .btn-primary { background: rgba(255,255,255,.15); }
          .video-desc-download { margin: 1rem 0 0; }
          .video-desc-download__link { text-decoration: none; }

          /* Chapter jump buttons — scoped; overrides generic .btn above (white text) */
          .video-jumplinks .jumplinks {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            align-items: center;
            margin-top: 0.35rem;
          }

          .video-jumplinks .jumplink.btn,
          .video-jumplinks button.jumplink {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.45rem 0.78rem;
            margin: 0;
            font-size: 0.875rem;
            font-weight: 600;
            line-height: 1.3;
            color: #111827;
            background: #ffffff;
            border: 1px solid #94a3b8;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.07);
            transition:
              background-color 0.15s ease,
              border-color 0.15s ease,
              box-shadow 0.15s ease,
              color 0.15s ease;
          }

          .video-jumplinks .jumplink.btn:hover,
          .video-jumplinks button.jumplink:hover {
            color: #0f172a;
            background: #f1f5f9;
            border-color: #64748b;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
          }

          .video-jumplinks .jumplink.btn:focus-visible,
          .video-jumplinks button.jumplink:focus-visible {
            outline: 2px solid #52682d;
            outline-offset: 2px;
            border-color: #52682d;
          }

          .video-jumplinks .jumplink.btn:active,
          .video-jumplinks button.jumplink:active {
            color: #0f172a;
            background: #e2e8f0;
            border-color: #475569;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.1);
          }

          .video-jumplinks .jumplink .fa {
            color: #3f4b35;
            opacity: 0.95;
          }
        </style>
      </>
    )}
  </div>

  <script is:inline>
    (function () {
      var qs = window.location.search || "";
      var href = qs ? "/videos" + qs : "/videos";
      var params = new URLSearchParams(qs);
      var cat = params.get("cat");
      var q = params.get("q");
      var suffix = cat ? cat + " Videos" : (q ? "Search Results" : "Videos");
      document.querySelectorAll(".back-to-videos-link").forEach(function (el) {
        el.href = href;
        var prefix = el.id === "back-to-videos" ? "← " : "";
        el.textContent = prefix + "Back to " + suffix;
      });
    })();
  </script>
</Layout>