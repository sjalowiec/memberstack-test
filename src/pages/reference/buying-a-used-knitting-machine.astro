---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import ReferencePageShell from "../../components/ReferencePageShell.astro";
import GlossaryTooltip from "../../components/common/GlossaryTooltip.astro";

const PAGE_H1 = "Buying a Used Knitting Machine";
const SEO_TITLE = "Buying a Used Knitting Machine | Knit it Now";
const INTRO =
  "A used knitting machine can be a wonderful find. Check what works, what’s included, and what it will cost to get it home and knitting.";
const META_DESCRIPTION = INTRO;
const CANONICAL_URL = "https://knititnow.com/reference/buying-a-used-knitting-machine";
const CHOOSE_MACHINE_HREF = "/reference/machines/choose";
/** glossary.json entry titled "Sponge Bar | Presser Bar". */
const SPONGE_BAR_GLOSSARY_ID = 524;
const SPONGE_BAR_BULLET = "If the model uses a sponge bar or needle-retaining sponge, ask when it was last replaced.";

const cards = [
  {
    id: "see-it-working",
    heading: "See it working",
    icon: "fa-camera",
    bullets: [
      "Ask to see the machine you’re buying knit, in person or in a recent video of casting on and several rows.",
      "If the seller can’t show that, treat its working condition as unknown.",
      "Ask to see punchcard or electronic patterning if that’s part of the price.",
      "Ask for a demonstration of a ribber or any other included accessory.",
      "Automatic needle selection doesn’t automate every technique. Learn what you’ll still do by hand.",
    ],
  },
  {
    id: "whats-included",
    heading: "Know what’s included",
    icon: "fa-box",
    bullets: [
      "Get the exact brand and model, with clear photos of the machine and all included parts.",
      "Check those parts against the manual’s parts list when you can.",
      "Look for the right carriage, clamps, yarn tension mast, weights, cast-on equipment, tools, and manuals.",
      "A ribber needs its own compatible parts and the equipment that connects it.",
      "Missing pieces can be difficult or expensive to replace. Don’t assume a stock photo shows what’s included.",
    ],
  },
  {
    id: "condition",
    heading: "Check condition and storage",
    icon: "fa-magnifying-glass",
    bullets: [
      "Ask when the machine was last used and where it has been stored.",
      "Look for rust, damaged or missing needles, cracked plastic, and any known problems.",
      "If the model uses a sponge bar or needle-retaining sponge, ask when it was last replaced.",
      "An older machine may still need maintenance, even when it looks clean.",
    ],
  },
  {
    id: "parts-support",
    heading: "Find parts and support",
    icon: "fa-wrench",
    bullets: [
      "Look for a manual, replacement needles, and parts made for that model.",
      "Find someone who can service that model before you buy.",
      "For an electronic machine, check what’s required for built-in patterning or external equipment.",
      "Don’t assume current software or cables will work with an older model.",
    ],
  },
  {
    id: "pickup-shipping",
    heading: "Plan pickup or shipping",
    icon: "fa-truck",
    bullets: [
      "Local pickup lets you inspect the machine and can avoid shipping cost and damage.",
      "If it has to be shipped, get the full cost before you agree.",
      "Ask how the machine and accessories will be packed. Secure heavy carriages and loose parts so they can’t damage the needlebed.",
      "Original packaging helps only when it’s still in sound condition.",
      "Ask about shipping insurance, damage claims, and the return policy.",
    ],
  },
  {
    id: "real-cost",
    heading: "Calculate the real cost",
    icon: "fa-calculator",
    bullets: [
      "Include shipping, missing accessories, replacement parts, and servicing you expect to need.",
      "Compare that total with other machines, not just the asking price.",
      "A more complete machine you’ve seen knitting can be better value than a cheaper one with unknown problems.",
    ],
  },
];

const checklist = [
  "I know the exact brand and model.",
  "I understand its yarn range and patterning capabilities.",
  "I have seen it knit, or I understand that its condition is unverified.",
  "I know which parts and accessories are included.",
  "I have checked the availability of manuals, parts, and service.",
  "I know the total cost, including transport and likely maintenance.",
  "I understand the seller’s return terms.",
];
---

<Layout title={SEO_TITLE} description={META_DESCRIPTION} bodyClass="page--tight-header">
  <Fragment slot="head">
    <link rel="canonical" href={CANONICAL_URL} />
  </Fragment>

  <ReferencePageShell
    title={PAGE_H1}
    backHref="/reference"
    backLabel="Back to References"
  >
    <article class="used-machine-guide">
      <p class="used-machine-guide__intro">{INTRO}</p>

      <div class="kbm-intro-callout used-machine-guide__start">
        <p>
          <strong>Start here</strong>
          Ask to see the actual machine knit. A carriage moving across an empty needlebed doesn’t demonstrate that it works.
        </p>
      </div>

      <div class="used-machine-guide__cards">
        {cards.map((card) => (
          <section class="used-machine-guide__card" aria-labelledby={card.id}>
            <h2 id={card.id}>
              <i class:list={["fa-solid", "fa-fw", card.icon]} aria-hidden="true"></i>
              <span>{card.heading}</span>
            </h2>
            <ul>
              {card.bullets.map((bullet) => (
                <li>
                  {bullet === SPONGE_BAR_BULLET ? (
                    <>
                      If the model uses a <GlossaryTooltip id={SPONGE_BAR_GLOSSARY_ID}>sponge bar</GlossaryTooltip> or needle-retaining sponge, ask when it was last replaced.
                    </>
                  ) : (
                    bullet
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <p class="used-machine-guide__reminder" role="note">
        ‘Worked when stored’ doesn’t confirm that it works today.
      </p>

      <section class="used-machine-guide__check" aria-labelledby="before-you-say-yes">
        <h2 id="before-you-say-yes">Before you say yes</h2>
        <ul class="used-machine-guide__checklist">
          {checklist.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <p class="used-machine-guide__closing">
        You don’t have to rule out a machine just because it’s older. The goal is to know what you’re buying and what it will take to start knitting.
      </p>

      <section class="used-machine-guide__next" aria-label="Get help choosing a machine">
        <p>Answer a few questions to share what you’re looking for with Sue.</p>
        <a class="kbm-btn kbm-btn-primary" href={CHOOSE_MACHINE_HREF}>Get Help Choosing a Machine</a>
      </section>
    </article>
  </ReferencePageShell>
</Layout>

<style>
  .used-machine-guide {
    margin-top: 0.15rem;
    color: #243015;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .used-machine-guide,
  .used-machine-guide * {
    box-sizing: border-box;
  }

  .used-machine-guide__intro {
    margin: 0 0 1rem;
    max-width: 40rem;
    font-size: 1.12rem;
    line-height: 1.55;
  }

  .used-machine-guide__start {
    margin: 0 0 1.25rem;
  }

  .used-machine-guide__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    align-items: start;
  }

  .used-machine-guide__card {
    min-width: 0;
    padding: 0.95rem 1rem 0.85rem;
    background: #fff;
    border: 1px solid #e3e7dc;
    border-radius: 10px;
  }

  .used-machine-guide__card h2 {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    margin: 0 0 0.55rem;
    font-size: 1.12rem;
    line-height: 1.3;
    font-weight: 650;
    color: #3f4b35;
  }

  .used-machine-guide__card h2 i {
    flex: 0 0 auto;
    margin-top: 0.16rem;
    font-size: 0.92rem;
    line-height: 1;
    color: #6b7280;
  }

  .used-machine-guide__card ul {
    margin: 0;
    padding-left: 1.15rem;
  }

  .used-machine-guide__card li + li {
    margin-top: 0.4rem;
  }

  .used-machine-guide__reminder {
    margin: 1.15rem 0 0;
    padding: 0.7rem 0.95rem;
    background: #f7f4ee;
    border: 1px solid #e4dccf;
    border-radius: 8px;
    color: #3f3a32;
    font-size: 1.02rem;
    line-height: 1.45;
  }

  .used-machine-guide__check {
    margin-top: 1.85rem;
  }

  .used-machine-guide__check h2 {
    margin: 0 0 0.85rem;
    font-size: 1.35rem;
    line-height: 1.25;
    font-weight: 650;
    color: #3f4b35;
  }

  .used-machine-guide__checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .used-machine-guide__checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .used-machine-guide__checklist li::before {
    content: "";
    flex: 0 0 auto;
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.22rem;
    border: 2px solid #4b5563;
    border-radius: 3px;
    background: #fff;
  }

  .used-machine-guide__closing {
    margin: 1.6rem 0 0;
  }

  .used-machine-guide__next {
    margin-top: 0.35rem;
    padding-top: 1.35rem;
    border-top: 1px solid #e5e7df;
  }

  .used-machine-guide__next p {
    margin: 0 0 0.85rem;
    font-size: 1.08rem;
    font-weight: 650;
    color: #374151;
  }

  @media (min-width: 720px) {
    .used-machine-guide__cards {
      grid-template-columns: 1fr 1fr;
      gap: 0.9rem 1rem;
    }
  }

  @media (max-width: 640px) {
    .used-machine-guide__intro {
      font-size: 1.05rem;
    }

    .used-machine-guide__next :global(.kbm-btn) {
      display: flex;
      width: 100%;
      justify-content: center;
    }
  }
</style>
