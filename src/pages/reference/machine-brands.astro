---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import FavoriteStar from "../../components/favorites/FavoriteStar.astro";
import FavoritesRuntime from "../../components/favorites/FavoritesRuntime.astro";
import "../../styles/pages/machine-brands.css";
import "../../styles/favorites.css";
import PageBackLink from "../../components/common/PageBackLink.astro";

const brandsTitle = "Knitting Machine Brands";
---

<Layout title={brandsTitle}>
  <PageBackLink href="/reference" text="Back to Reference" />
  <div class="page-wrap machine-brands-page">
    <PageHead
      title={brandsTitle}
      subhead="Use this guide to identify your knitting machine brand — and uncover the different names it may go by around the world."
    >
      <FavoriteStar
        slot="after-title"
        contentType="reference"
        contentId="/reference/machine-brands"
        title={brandsTitle}
      />
    </PageHead>
    <FavoritesRuntime contentType="reference" />
  
    <div class="easter-egg-callout">
      <span class="easter-egg-icon"></span>
      <div>
        
        Many knitting machines were sold under different brand names depending on where they were sold - which is why the same machine might go by completely different names around the world.<br /><br />
        <em>This matters when you're searching for parts, patterns, or help - <strong>the name you’re using might not be the only one.</strong></em>
      </div>
    </div>

    <div class="machine-brands-layout">
      <div class="machine-brands-col machine-brands-col--left">
        <section
          class="machine-brands-region"
          aria-labelledby="machine-brands-japanese"
        >
          <h2 id="machine-brands-japanese" class="machine-brands-region__title">
            Japanese
          </h2>
          <div class="machine-brands-region__body">
            <div class="machine-brands-row">
              <article class="machine-brands-card">
                <div class="machine-brands-card__block">
                  <h3 class="machine-brands-brand">Brother</h3>
                  <ul class="machine-brands-list">
                    <li>KnitKing <span class="machine-brands-note">(US)</span></li>
                    <li>Defendi Brother <span class="machine-brands-note">(IT)</span></li>
                    <li>Jones <span class="machine-brands-note">(UK)</span></li>
                    <li>Erka <span class="machine-brands-note">(F)</span></li>
                  </ul>
                </div>
                <div class="machine-brands-card__block">
                  <h3 class="machine-brands-brand">
                    Chinese clones <span class="machine-brands-tag">(new)</span>
                  </h3>
                  <ul class="machine-brands-list">
                    <li>Artisan <span class="machine-brands-note">(US)</span></li>
                    <li>Creative</li>
                    <li>Taitexma</li>
                  </ul>
                </div>
              </article>

              <article class="machine-brands-card">
                <div class="machine-brands-card__block">
                  <h3 class="machine-brands-brand">Toyota</h3>
                  <ul class="machine-brands-list">
                    <li>Elna <span class="machine-brands-note">(SW)</span></li>
                  </ul>
                </div>
                <div class="machine-brands-card__block">
                  <h3 class="machine-brands-brand">Juki</h3>
                  <ul class="machine-brands-list">
                    <li>Erka <span class="machine-brands-note">(F)</span></li>
                    <li>Gritzner <span class="machine-brands-note">(DE)</span></li>
                    <li>Singer /Lemair <span class="machine-brands-note">(AU)</span></li>
                  </ul>
                </div>
                <div class="machine-brands-card__block">
                  <h3 class="machine-brands-brand">
                    Corona <span class="machine-brands-note">(even 11 mm)</span>
                  </h3>
                  <ul class="machine-brands-list">
                    <li>Studio 121 <span class="machine-brands-note">(11mm)</span></li>
                  </ul>
                </div>
              </article>
            </div>

            <article
              class="machine-brands-card machine-brands-card--wide"
            >
              <div class="machine-brands-card__block">
                <h3 class="machine-brands-brand">Silver Reed</h3>
                <ul class="machine-brands-list">
                  <li>
                    Silver Reed <span class="machine-brands-note">(UK)</span>
                    <span class="machine-brands-note">(until 2011)</span>
                  </li>
                  <li>Dimac <span class="machine-brands-note">(Bulky8 /SK120)</span></li>
                  <li>Elna <span class="machine-brands-note">(SW)</span></li>
                  <li>Necchi/Vigorelli <span class="machine-brands-note">(IT)</span></li>
                  <li>Norsy <span class="machine-brands-note">(NO)</span></li>
                  <li>Riccar <span class="machine-brands-note">(RU)</span></li>
                  <li>Knitmaster / Singer <span class="machine-brands-note">(AU)</span></li>
                  <li>Empisal Knitmaster <span class="machine-brands-note">(UK)</span></li>
                  <li>Singer <span class="machine-brands-note">(US)</span></li>
                  <li>Studio <span class="machine-brands-note">(CA)</span></li>
                </ul>
              </div>
            </article>
          </div>
        </section>
      </div>

      <div class="machine-brands-col machine-brands-col--right">
        <section
          class="machine-brands-region"
          aria-labelledby="machine-brands-european"
        >
          <h2 id="machine-brands-european" class="machine-brands-region__title">
            European
          </h2>
          <div class="machine-brands-region__body">
            <div class="machine-brands-row">
              <article class="machine-brands-card">
                <div class="machine-brands-card__block">
                  <h3 class="machine-brands-brand">Passap</h3>
                  <ul class="machine-brands-list">
                    <li>
                      Pfaff <span class="machine-brands-note">(DE-UK)</span>
                      <span class="machine-brands-passap-note">(even 3.123mm)</span>
                    </li>
                  </ul>
                </div>
                <div class="machine-brands-card__block">
                  <h3 class="machine-brands-brand">
                    Bond <span class="machine-brands-note">(UK)</span>
                  </h3>
                  <ul class="machine-brands-list">
                    <li>Incredible Sweater Machine (ISM)</li>
                  </ul>
                </div>
              </article>

              <article class="machine-brands-card">
                <div class="machine-brands-card__block">
                  <h3 class="machine-brands-brand">
                    Superba
                    <span class="machine-brands-note">(F-EU-CA-US-AU-AS)</span>
                  </h3>
                  <ul class="machine-brands-list">
                    <li>White <span class="machine-brands-note">(US)</span></li>
                    <li>Singer <span class="machine-brands-note">(EU-UK)</span></li>
                    <li>Phildar <span class="machine-brands-note">(F)</span></li>
                  </ul>
                </div>
              </article>
            </div>

            <article
              class="machine-brands-card machine-brands-card--wide"
            >
              <div class="machine-brands-card__block">
                <h3 class="machine-brands-brand">
                  Other brands <span class="machine-brands-note">(vintage)</span>
                </h3>
                <ul class="machine-brands-list">
                  <li>Girotex <span class="machine-brands-note">(F)</span></li>
                  <li>Dopleta <span class="machine-brands-note">(CZ)</span></li>
                  <li>Veritas <span class="machine-brands-note">(DE/DDR)</span></li>
                  <li>Knittax <span class="machine-brands-note">(DE)</span></li>
                </ul>
              </div>
            </article>
          </div>
        </section>

        <section
          class="machine-brands-region"
          aria-labelledby="machine-brands-vintage"
        >
          <h2 id="machine-brands-vintage" class="machine-brands-region__title">
            Vintage
          </h2>
          <div class="machine-brands-region__body">
            <div class="machine-brands-row machine-brands-row--vintage">
              <article
                class="machine-brands-card machine-brands-card--compact"
              >
                <h3 class="machine-brands-brand">Prior Purl</h3>
                <ul class="machine-brands-list">
                  <li>
                    <span class="machine-brands-note">(AU)</span> Garter Stitch
                  </li>
                </ul>
              </article>

              <article
                class="machine-brands-card machine-brands-card--compact"
              >
                <h3 class="machine-brands-brand">Neva Severianka</h3>
                <ul class="machine-brands-list">
                  <li><span class="machine-brands-note">(RU)</span> 5mm</li>
                </ul>
              </article>

              <article
                class="machine-brands-card machine-brands-card--compact"
              >
                <h3 class="machine-brands-brand">Simac</h3>
                <ul class="machine-brands-list">
                  <li>Sona</li>
                  <li>Inaisa</li>
                  <li><span class="machine-brands-note">(IN)</span> 4.5</li>
                </ul>
              </article>
            </div>
          </div>
        </section>
      </div>
    </div>

    <aside class="machine-brands-crosslink">
      <div class="machine-brands-crosslink__body">
        <h2 class="machine-brands-crosslink__title">Looking for a specific machine?</h2>
        <p class="machine-brands-crosslink__text">
          The Machine Database includes machine specifications, photos, gauge information, and
          supported techniques for more than 150 knitting machines.
        </p>
      </div>
      <a class="kbm-btn kbm-btn-primary machine-brands-crosslink__btn" href="/reference/machines">
        Browse the Machine Database →
      </a>
    </aside>
  </div>
</Layout>
