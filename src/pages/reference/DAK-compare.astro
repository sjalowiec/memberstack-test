---
import Layout from "../../layouts/Layout.astro";
import ReferencePageShell from "../../components/ReferencePageShell.astro";

const pageTitle = "Compare DesignaKnit Versions";
const pageDescription =
  "Compare DesignaKnit versions to see which option fits your knitting needs.";

const products = [
  { name: "Hand Knit", price: "$199", badge: "", featured: false },
  { name: "Machine Standard", price: "$330", badge: "", featured: false },
  {
    name: "Machine Pro",
    price: "$450",
    badge: "Recommended",
    featured: true,
  },
  {
    name: "Complete",
    price: "$500",
    badge: "Recommended",
    featured: false,
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <ReferencePageShell wide backHref="/reference" backLabel="Back to Reference">
    <section class="reference-page">
      <nav class="dak-local-nav" aria-label="DesignaKnit navigation">
        <a href="/designaknit">DesignaKnit</a>
        <span class="dak-sep">|</span>
        <span class="dak-current">Compare Versions</span>
        <span class="dak-sep">|</span>
        <a href="/reference/dak-buyers-guide">Buyer's Guide</a>
      </nav>
      <header class="page-header">
        <h1>{pageTitle}</h1>
      </header>

      <p class="kbm-intro-callout">
        Not sure which DesignaKnit version is right for you? See the options below.
        Still deciding? Get clear answers in our
        <a href="/reference/dak-buyers-guide">DesignaKnit Buyers Guide</a>.
      </p>

      <section class="dak-options-section">
        <div class="container">
          <div class="dak-includes-box">
            <p><strong>All versions include:</strong></p>
            <p>
              Standard Garment Styling, Stitch Designer, Interactive Knitting, and
              Graphics Studio.
            </p>
          </div>

          <div class="row">
            {products.map((product) => (
              <div class="col-12 col-md-6 col-lg-3 mb-4">
                <div
                  class:list={[
                    "dak-option-card",
                    product.featured && "is-featured",
                  ]}
                >
                  {product.badge && (
                    <div class="dak-option-badge">{product.badge}</div>
                  )}

                  <h3 class="dak-option-title">{product.name}</h3>
                  <div class="dak-option-price">{product.price}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    </section>
  </ReferencePageShell>
</Layout>

<style>
  .reference-page .page-header {
    margin-bottom: 1.25rem;
  }

  .reference-page .page-header h1 {
    margin: 0;
  }

  .kbm-intro-callout {
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  /* Bootstrap-compatible grid (self-contained; site does not load Bootstrap CSS) */
  .dak-options-section .container {
    width: min(var(--max-content-width, 1100px), 96%);
    margin-left: auto;
    margin-right: auto;
    padding-left: calc(var(--bs-gutter-x, 1.5rem) * 0.5);
    padding-right: calc(var(--bs-gutter-x, 1.5rem) * 0.5);
  }

  .dak-options-section .row {
    --bs-gutter-x: 1.5rem;
    --bs-gutter-y: 0;
    display: flex;
    flex-wrap: wrap;
    margin-top: calc(var(--bs-gutter-y) * -1);
    margin-right: calc(var(--bs-gutter-x) * -0.5);
    margin-left: calc(var(--bs-gutter-x) * -0.5);
  }

  .dak-options-section .row > * {
    flex-shrink: 0;
    width: 100%;
    max-width: 100%;
    padding-right: calc(var(--bs-gutter-x) * 0.5);
    padding-left: calc(var(--bs-gutter-x) * 0.5);
    margin-top: var(--bs-gutter-y);
  }

  .dak-options-section .col-12 {
    flex: 0 0 auto;
    width: 100%;
  }

  @media (min-width: 768px) {
    .dak-options-section .col-md-6 {
      flex: 0 0 auto;
      width: 50%;
    }
  }

  @media (min-width: 992px) {
    .dak-options-section .col-lg-3 {
      flex: 0 0 auto;
      width: 25%;
    }
  }

  .dak-options-section .mb-4 {
    margin-bottom: 1.5rem !important;
  }

  .dak-options-section {
    padding: 2rem 0;
  }

  .dak-includes-box {
    margin-bottom: 2rem;
    padding: 1rem 1.25rem;
    background: #f5f5f5;
    border-radius: 12px;
  }

  .dak-option-card {
    position: relative;
    height: 100%;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid #d9d9d9;
    border-radius: 16px;
    text-align: center;
  }

  .dak-option-card.is-featured {
    border: 2px solid #0166b4;
  }

  .dak-option-badge {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.3rem 0.7rem;
    background: #efe08a;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 8px;
  }

  .dak-option-title {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    color: #2f4122;
  }

  .dak-option-price {
    margin-top: 0.4rem;
    font-size: 1.1rem;
    font-style: italic;
    font-weight: 700;
    color: #2f4122;
  }
</style>
