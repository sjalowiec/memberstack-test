---
import Layout from "../../../layouts/Layout.astro";
import WizardBackLink from "../../../components/wizards/WizardBackLink.astro";
import ProgressNav from "../../../components/ProgressNav.astro";
import MachineChooser from "../../../components/machines/MachineChooser.astro";
import { gettingStartedItems } from "../../../lib/gettingStartedNav";

// "Need a Machine?" now opens /choose-a-machine, so this page is not that step.
const progressCurrent = "";
---

<Layout
  title="Choose a Knitting Machine | Knit it Now"
  description="Answer a few questions to discover which knitting machine control types and features fit your goals."
  toolPrintTitle="Choose a Knitting Machine"
>
  <div class="wizard-page">
    <ProgressNav current={progressCurrent} items={gettingStartedItems} />
    <WizardBackLink fallback="/reference" label="? Back to Reference" />
    <MachineChooser />
  </div>
</Layout>

<style>
  .wizard-page {
    padding-top: 1rem;
    padding-bottom: 3rem;
    background: var(--page-bg);
    max-width: 1400px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
</style>
