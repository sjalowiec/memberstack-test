---
/**
 * Finished Hat Pattern page (free / ungated).
 * Reads kbm_hat_draft → existing hat engine → reading layout.
 * Edit Pattern opens an on-page drawer (diagram + draft inputs). No new route / review step.
 * Does not replace /patterns/hat. No catalog exposure.
 */
import Layout from "../../../layouts/Layout.astro";
import PatternPrintFooter from "../../../components/common/PatternPrintFooter.astro";
import PatternPrintPersonalization from "../../../components/common/PatternPrintPersonalization.astro";
import PatternTipsToggle from "../../../components/patterns/PatternTipsToggle.astro";
import SleevelessPatternPrintNotice from "../../../components/patterns/SleevelessPatternPrintNotice.astro";
import WarningBox from "../../../components/ui/WarningBox.astro";
import glossaryJson from "../../../data/glossary.json";
import {
  HAT_PATTERN_MEMBERSHIP_CTA_CLASS,
  HAT_PATTERN_MEMBERSHIP_CTA_HREF,
  HAT_PATTERN_MEMBERSHIP_CTA_LABEL,
  HAT_PATTERN_PERSIST_MEMBERSHIP_PITCH,
  HAT_PATTERN_PERSIST_NOTICE_TITLE,
  HAT_PATTERN_PERSIST_WARNING_EMPHASIS,
  HAT_PATTERN_PERSIST_WARNING_LEAD,
} from "../../../lib/patterns/hat/hatPatternPersistNotice";

import "../../../styles/wizard.css";
import "../../../styles/glossary-tooltip.css";
import "../../../styles/pattern-tips.css";
import "../../../styles/pattern-quick-tip.css";
import "../../../styles/pattern-help-card.css";
import "../../../styles/patterns/sleeveless-pattern-shared.css";
import "../../../styles/patterns/pattern-app-shell.css";

type HatGlossaryRow = { glossaryId?: number; english?: string; example?: string };
const hatGlossaryRows: HatGlossaryRow[] = Array.isArray(glossaryJson)
  ? (glossaryJson as HatGlossaryRow[])
  : [];
const hatGlossary311 = hatGlossaryRows.find((e) => e.glossaryId === 311);

function hatPlainGlossaryExample(raw: string | undefined): string {
  const s = (raw ?? "").trim();
  if (!s) return "";
  if (!/[<>]/.test(s)) return s;
  return s.replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim();
}

const scrapOffPatternTooltip =
  hatPlainGlossaryExample(hatGlossary311?.example) ||
  (hatGlossary311?.english ?? "Scrap Off").trim();

const hatZeroBodyRowsWarningMessage =
  "Your current settings don't leave any room for the body of the hat. Try increasing the finished hat length, reducing the brim height, or choosing a shallower crown style.";
---

<Layout
  title="Hat Pattern | Knit it Now"
  description="Your custom machine-knit hat pattern instructions and diagram from the Hat Pattern Builder."
  bodyClass="pattern-print-global-footer"
  patternWorkspace={true}
>
  <PatternPrintFooter footerBottomLeftExtra=" · KnitItNow.com/patterns/hat" />
  <main
    class="wizard-page sleeveless-pattern-page sleeveless-workspace-subpage pattern-app-shell hat-pattern-page"
    data-pattern-print-skip-modal
    data-hat-pattern-page
    data-scrap-off-tooltip={scrapOffPatternTooltip}
  >
    <div id="hat-pattern-top" class="wizard-container scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <div class="pattern-action-bar no-print" data-pattern-action-bar>
          <div class="pattern-action-bar__group pattern-action-bar__group--start">
            <a
              href="/patterns/hat/builder"
              class="sleeveless-pattern-edit-action no-print"
              data-testid="hat-pattern-back-to-builder"
            >
              <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to Builder
            </a>
          </div>
          <div
            class="pattern-action-bar__group pattern-action-bar__group--end"
            data-hat-pattern-actions
            data-sleeveless-pattern-actions
          >
            <button
              type="button"
              class="sleeveless-pattern-edit-action no-print"
              data-hat-edit-open
              data-testid="button-edit-pattern"
              aria-haspopup="dialog"
              aria-controls="hat-edit-drawer-panel"
              aria-expanded="false"
              hidden
            >
              <i class="fas fa-pen" aria-hidden="true"></i> Edit Pattern
            </button>
            <!-- Print button (#print-btn) is injected when a valid pattern renders. -->
          </div>
        </div>

        <div class="hat-pattern-empty" data-hat-pattern-empty role="status" hidden>
          <h1 class="hat-pattern-empty__title">Hat Pattern</h1>
          <p class="hat-pattern-empty__message" data-hat-pattern-empty-message>
            Create a hat pattern first, then come back to view your instructions.
          </p>
          <a
            href="/patterns/hat/builder"
            class="kbm-btn kbm-btn-accent"
            data-testid="hat-pattern-empty-cta"
          >
            Go to Hat Builder
          </a>
        </div>

        <div id="sg-hat-results" class="sg-sleeveless-results" data-hat-pattern-results>
          <div id="hat-pattern-tips-scope" class="pattern-tips-scope" data-show-tips="true">
            <aside
              class="hat-pattern-persist-notice"
              data-hat-pattern-persist-notice
              data-testid="hat-pattern-persist-notice"
              role="region"
              aria-label={HAT_PATTERN_PERSIST_NOTICE_TITLE}
            >
              <p class="hat-pattern-persist-notice__title">
                {HAT_PATTERN_PERSIST_NOTICE_TITLE}
              </p>
              <p class="hat-pattern-persist-notice__warning">
                {HAT_PATTERN_PERSIST_WARNING_LEAD}{" "}
                <button
                  type="button"
                  class="hat-pattern-print-inline-link print-visible"
                  data-hat-pattern-print-link
                  data-testid="hat-pattern-print-inline-link"
                >
                  {HAT_PATTERN_PERSIST_WARNING_EMPHASIS}
                </button>
              </p>
              <div
                class="hat-pattern-persist-notice__membership no-print"
                data-hat-pattern-persist-membership
              >
                <p class="hat-pattern-persist-notice__pitch">
                  {HAT_PATTERN_PERSIST_MEMBERSHIP_PITCH}
                </p>
                <a
                  href={HAT_PATTERN_MEMBERSHIP_CTA_HREF}
                  class:list={[
                    HAT_PATTERN_MEMBERSHIP_CTA_CLASS.split(" "),
                    "hat-pattern-persist-notice__cta",
                  ]}
                  data-hat-pattern-membership-cta
                  data-testid="hat-pattern-membership-cta"
                >
                  {HAT_PATTERN_MEMBERSHIP_CTA_LABEL}
                </a>
              </div>
            </aside>
            <div class="no-print" data-hat-zero-body-warning hidden>
              <WarningBox title="Notice" message={hatZeroBodyRowsWarningMessage} />
            </div>
            <SleevelessPatternPrintNotice />
            <section class="sleeveless-pattern-intro">
              <div class="sleeveless-pattern-intro__image">
                <div class="beta-pattern-video">
                  <div class="beta-pattern-video__wrap">
                    <img
                      src="/images/patterns/basic-hat.webp"
                      alt="Woman wearing a knitted hat"
                      width="360"
                      height="360"
                      loading="lazy"
                      decoding="async"
                      class="sg-pattern-hero-image"
                    />
                  </div>
                </div>
                <div class="pattern-print-origin" aria-hidden="true">
                  <div class="pattern-print-origin__label">
                    Created with the Knit It Now Hat Pattern Builder
                  </div>
                  <div class="pattern-print-origin__url">KnitItNow.com/patterns/hat</div>
                </div>
              </div>
              <div class="sleeveless-pattern-intro__content">
                <div class="sleeveless-pattern-online-project-header no-print">
                  <div class="sleeveless-pattern-online-heading-row">
                    <p
                      class="sleeveless-pattern-online-heading"
                      data-hat-pattern-online-heading
                    >
                      Hat Pattern · Pattern instructions
                    </p>
                  </div>
                </div>
                <PatternPrintPersonalization>
                  <div
                    slot="print-summary"
                    class="sg-pattern-print-at-a-glance"
                    data-sg-pattern-print-at-a-glance
                  >
                    <h2 class="print-heading-major print-heading-major--hero">At a glance</h2>
                    <div data-sg-pattern-print-basics-body></div>
                  </div>
                </PatternPrintPersonalization>
                <div
                  class="sg-pattern-intro-metadata pattern-generated-description"
                  data-sg-pattern-intro
                  data-pattern-generated-description
                  aria-label="Pattern summary"
                ></div>
                <PatternTipsToggle
                  storageKey="hat-show-tips"
                  scopeSelector="#hat-pattern-tips-scope"
                />
              </div>
            </section>

            <div id="pattern-content" data-pattern-content>
              <div
                class="pattern-layout pattern-layout--garment-columns hat-pattern-reading-layout"
                data-hat-pattern-reading-layout
              >
                <div
                  class="pattern-layout__content hat-pattern-reading-layout__instructions"
                  data-hat-pattern-mount
                >
                  <p class="sleeveless-pattern-boot-msg">Loading pattern…</p>
                </div>
                <aside
                  class="pattern-layout__sidebar hat-pattern-reading-layout__diagram"
                  aria-label="Hat dimensions diagram"
                >
                  <div class="hat-pattern-diagram-panel pattern-print-keep-together">
                    <h3 class="hat-pattern-diagram-panel__title">Hat Dimensions</h3>
                    <div
                      class="hat-pattern-diagram-panel__svg"
                      id="diagram-content"
                      data-hat-diagram-host
                    ></div>
                  </div>
                </aside>
              </div>
            </div>
          </div>
        </div>

        <noscript>
          <div class="pattern-section">
            <h2 class="pattern-noscript-heading">Pattern</h2>
            <p>Turn on JavaScript to view this pattern.</p>
          </div>
        </noscript>
      </div>
    </div>

    <!--
      Edit Pattern drawer — same finished-page surface; diagram + draft inputs.
      Update Pattern writes kbm_hat_draft and recalculates via existing hat math.
      Cancel / close discards edits. No new route or review step.
    -->
    <div
      class="hat-edit-drawer no-print"
      data-hat-edit-drawer
      aria-hidden="true"
      data-testid="hat-edit-drawer"
    >
      <div class="hat-edit-drawer__backdrop" data-hat-edit-close aria-hidden="true"></div>
      <section
        id="hat-edit-drawer-panel"
        class="hat-edit-drawer__panel"
        data-hat-edit-panel
        role="dialog"
        aria-modal="true"
        aria-label="Edit pattern"
        tabindex="-1"
      >
        <header class="hat-edit-drawer__head">
          <h2 class="hat-edit-drawer__title">Edit Pattern</h2>
          <button
            type="button"
            class="hat-edit-drawer__close"
            data-hat-edit-close
            data-testid="button-edit-close"
            aria-label="Close edit pattern"
          >
            <i class="fas fa-times" aria-hidden="true"></i>
          </button>
        </header>

        <div class="hat-edit-drawer__layout">
          <div class="hat-edit-drawer__choices">
            <section class="hat-edit-section" aria-labelledby="hat-edit-units-heading">
              <h3 class="hat-edit-section__title" id="hat-edit-units-heading">Units</h3>
              <div class="hat-edit-units" role="group" aria-labelledby="hat-edit-units-heading">
                <button
                  type="button"
                  class="hat-edit-unit-btn is-active"
                  data-hat-edit-unit="inches"
                  aria-pressed="true"
                >
                  Inches
                </button>
                <button
                  type="button"
                  class="hat-edit-unit-btn"
                  data-hat-edit-unit="cm"
                  aria-pressed="false"
                >
                  Centimeters
                </button>
              </div>
            </section>

            <section class="hat-edit-section" aria-labelledby="hat-edit-choices-heading">
              <h3 class="hat-edit-section__title" id="hat-edit-choices-heading">Pattern choices</h3>

              <div class="hat-edit-field">
                <label class="hat-edit-label" for="hat-edit-size">Finished hat size</label>
                <select
                  id="hat-edit-size"
                  class="hat-edit-input"
                  data-hat-edit-size
                  data-testid="hat-edit-size"
                >
                  <option value="">Loading sizes…</option>
                </select>
              </div>

              <div class="hat-edit-field">
                <label class="hat-edit-label" for="hat-edit-fit">Finished hat length</label>
                <select
                  id="hat-edit-fit"
                  class="hat-edit-input"
                  data-hat-edit-fit
                  data-testid="hat-edit-fit"
                >
                  <option value="">Loading lengths…</option>
                </select>
              </div>

              <div class="hat-edit-field">
                <label class="hat-edit-label" for="hat-edit-brim-type">Brim type</label>
                <select
                  id="hat-edit-brim-type"
                  class="hat-edit-input"
                  data-hat-edit-brim-type
                  data-testid="hat-edit-brim-type"
                >
                  <option value="">Choose brim type</option>
                  <option value="single">Single Layer</option>
                  <option value="folded">Folded Hem</option>
                </select>
                <p class="hat-edit-field-error" data-hat-edit-error="brimType" hidden role="alert"></p>
              </div>

              <div class="hat-edit-field">
                <label class="hat-edit-label" for="hat-edit-crown">Crown style</label>
                <select
                  id="hat-edit-crown"
                  class="hat-edit-input"
                  data-hat-edit-crown
                  data-testid="hat-edit-crown"
                >
                  <option value="">Choose crown style</option>
                  <option value="gathered">Gathered</option>
                  <option value="wedge-4-decrease">Four-Gore</option>
                  <option value="spiral">Swirl Top</option>
                </select>
                <p class="hat-edit-field-error" data-hat-edit-error="crownShaping" hidden role="alert"></p>
              </div>
            </section>

            <section class="hat-edit-section" aria-labelledby="hat-edit-gauge-heading">
              <h3 class="hat-edit-section__title" id="hat-edit-gauge-heading">Gauge</h3>
              <p class="hat-edit-help" data-hat-edit-gauge-help>stitches / rows over 4 inches</p>
              <div class="hat-edit-gauge-grid">
                <div class="hat-edit-field">
                  <label class="hat-edit-label" for="hat-edit-stitch-gauge">Stitch gauge</label>
                  <input
                    id="hat-edit-stitch-gauge"
                    class="hat-edit-input"
                    type="number"
                    inputmode="decimal"
                    step="0.1"
                    min="0"
                    data-hat-edit-stitch-gauge
                    data-testid="hat-edit-stitch-gauge"
                  />
                  <p class="hat-edit-field-error" data-hat-edit-error="stitchGauge" hidden role="alert"></p>
                </div>
                <div class="hat-edit-field">
                  <label class="hat-edit-label" for="hat-edit-row-gauge">Row gauge</label>
                  <input
                    id="hat-edit-row-gauge"
                    class="hat-edit-input"
                    type="number"
                    inputmode="decimal"
                    step="0.1"
                    min="0"
                    data-hat-edit-row-gauge
                    data-testid="hat-edit-row-gauge"
                  />
                  <p class="hat-edit-field-error" data-hat-edit-error="rowGauge" hidden role="alert"></p>
                </div>
              </div>
            </section>
          </div>

          <div class="hat-edit-drawer__measure">
            <h3 class="hat-edit-section__title">Measurements</h3>
            <p class="hat-edit-help">
              Edit the measurements that created this hat. On narrow screens, fields stack below the
              diagram.
            </p>
            <div class="hat-edit-mbp" data-testid="hat-edit-diagram-area">
              <div class="hat-edit-mbp-stage">
                <div class="hat-edit-mbp-stage__inner" data-hat-edit-stage>
                  <div class="hat-edit-mbp-art" data-hat-edit-diagram></div>
                  <div class="hat-edit-mbp-overlay" data-hat-edit-overlay>
                    <div
                      class="hat-edit-mbp-box"
                      data-measurement-target="target_hat_circumference"
                      data-testid="hat-edit-chip-circumference"
                    >
                      <label class="hat-edit-mbp-box__field" for="hat-edit-circ">
                        <span class="hat-edit-mbp-box__lab">Finished hat size</span>
                        <span class="hat-edit-mbp-box__value">
                          <input
                            id="hat-edit-circ"
                            class="hat-edit-mbp-input"
                            type="number"
                            inputmode="decimal"
                            step="0.25"
                            min="0"
                            data-hat-edit-circ
                            data-testid="hat-edit-circ"
                          />
                          <span class="hat-edit-mbp-unit" data-hat-edit-unit-suffix>"</span>
                        </span>
                      </label>
                      <p
                        class="hat-edit-field-error"
                        data-hat-edit-error="finishedCircumference"
                        hidden
                        role="alert"
                      ></p>
                    </div>

                    <div
                      class="hat-edit-mbp-box"
                      data-measurement-target="target_hat_length"
                      data-testid="hat-edit-chip-length"
                    >
                      <label class="hat-edit-mbp-box__field" for="hat-edit-length">
                        <span class="hat-edit-mbp-box__lab">Finished hat length</span>
                        <span class="hat-edit-mbp-box__value">
                          <input
                            id="hat-edit-length"
                            class="hat-edit-mbp-input"
                            type="number"
                            inputmode="decimal"
                            step="0.25"
                            min="0"
                            data-hat-edit-length
                            data-testid="hat-edit-length"
                          />
                          <span class="hat-edit-mbp-unit" data-hat-edit-unit-suffix>"</span>
                        </span>
                      </label>
                      <p
                        class="hat-edit-field-error"
                        data-hat-edit-error="finishedHatLength"
                        hidden
                        role="alert"
                      ></p>
                    </div>

                    <div
                      class="hat-edit-mbp-box"
                      data-measurement-target="target_hat_brim"
                      data-testid="hat-edit-chip-brim"
                    >
                      <label class="hat-edit-mbp-box__field" for="hat-edit-brim">
                        <span class="hat-edit-mbp-box__lab">Visible Brim Height</span>
                        <span class="hat-edit-mbp-box__value">
                          <input
                            id="hat-edit-brim"
                            class="hat-edit-mbp-input"
                            type="number"
                            inputmode="decimal"
                            step="0.25"
                            min="0"
                            data-hat-edit-brim
                            data-testid="hat-edit-brim"
                          />
                          <span class="hat-edit-mbp-unit" data-hat-edit-unit-suffix>"</span>
                        </span>
                      </label>
                      <p
                        class="hat-edit-field-error"
                        data-hat-edit-error="brimLength"
                        hidden
                        role="alert"
                      ></p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <footer class="hat-edit-drawer__footer">
          <p class="hat-edit-form-error" data-hat-edit-form-error hidden role="alert"></p>
          <div class="hat-edit-drawer__actions">
            <button
              type="button"
              class="hat-edit-btn hat-edit-btn--ghost"
              data-hat-edit-close
              data-testid="button-edit-cancel"
            >
              Cancel
            </button>
            <button
              type="button"
              class="hat-edit-btn hat-edit-btn--primary"
              data-hat-edit-update
              data-testid="button-edit-update"
            >
              Update Pattern
            </button>
          </div>
        </footer>
      </section>
    </div>
  </main>
</Layout>

<style>
  .pattern-action-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(82, 104, 45, 0.12);
  }

  .pattern-action-bar__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .pattern-action-bar__group--end {
    justify-content: flex-end;
  }

  .sleeveless-pattern-online-project-header {
    margin: 0 0 0.75rem;
  }

  .sleeveless-pattern-online-heading-row {
    margin: 0 0 0.4rem;
  }

  .sleeveless-pattern-online-heading {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    color: #374151;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .sleeveless-pattern-intro__image {
    width: 100%;
    min-width: 280px;
    justify-self: end;
  }

  .beta-pattern-video {
    display: block;
    width: 360px;
    max-width: 100%;
  }

  .beta-pattern-video__wrap {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    background: transparent;
  }

  .sg-pattern-hero-image {
    display: block;
    width: 100%;
    max-height: 320px;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
  }

  /*
   * Soft informational persist notice (Hat-only).
   * Not WarningBox — cream panel + left accent, no triangle / alarm styling.
   */
  .hat-pattern-persist-notice {
    margin: 0 0 1.25rem;
    padding: 0.9rem 1.1rem;
    border-radius: 8px;
    border: 0;
    border-left: 4px solid var(--kbm-accent, #c2614e);
    background: #f7f6f4;
    color: #1f2937;
  }

  .hat-pattern-persist-notice__title {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.35;
    color: #374151;
  }

  .hat-pattern-persist-notice__warning {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #1f2937;
  }

  .hat-pattern-persist-notice__membership {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    margin-top: 0.7rem;
    min-width: 0;
  }

  .hat-pattern-persist-notice__pitch {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: #4b5563;
  }

  .hat-pattern-persist-notice__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    white-space: normal;
    text-align: center;
    text-decoration: none;
  }

  .hat-pattern-persist-notice__cta:focus-visible {
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }

  .hat-pattern-print-inline-link {
    display: inline;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    line-height: inherit;
    color: #52682d;
    text-decoration: underline;
    text-underline-offset: 0.12em;
    cursor: pointer;
  }

  .hat-pattern-print-inline-link:hover {
    color: #3f5223;
  }

  .hat-pattern-print-inline-link:focus-visible {
    outline: 2px solid #52682d;
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 560px) {
    .hat-pattern-persist-notice {
      padding: 0.85rem 0.95rem;
    }

    .hat-pattern-persist-notice__cta {
      width: 100%;
      box-sizing: border-box;
    }
  }

  @media print {
    .hat-pattern-persist-notice {
      break-inside: avoid;
      page-break-inside: avoid;
      background: #fff !important;
      border-left-color: #444 !important;
      color: #111 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .hat-pattern-persist-notice__title,
    .hat-pattern-persist-notice__warning {
      color: #111 !important;
    }

    .hat-pattern-print-inline-link {
      color: #111 !important;
      text-decoration: none;
      font-weight: 700;
    }
  }

  :global(#pattern-content .hat-swirl-crown-video-tip__title) {
    margin: 0 0 0.35rem;
  }

  :global(#pattern-content .hat-swirl-crown-video-tip__message) {
    margin: 0 0 0.55rem;
  }

