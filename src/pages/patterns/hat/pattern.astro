---
/**
 * Finished Hat Pattern page (free / ungated).
 * Reads kbm_hat_draft → existing hat engine → reading layout.
 * Edit Pattern navigates to the dedicated Summary/Edit page (`/patterns/hat/summary/`).
 * Does not replace /patterns/hat. No catalog exposure.
 */
import Layout from "../../../layouts/Layout.astro";
import PatternPrintFooter from "../../../components/common/PatternPrintFooter.astro";
import PatternPrintPersonalization from "../../../components/common/PatternPrintPersonalization.astro";
import PatternTipsToggle from "../../../components/patterns/PatternTipsToggle.astro";
import SleevelessPatternPrintNotice from "../../../components/patterns/SleevelessPatternPrintNotice.astro";
import WarningBox from "../../../components/ui/WarningBox.astro";
import YarnRequirement from "../../../components/tools/YarnRequirement.astro";
import glossaryJson from "../../../data/glossary.json";
import {
  HAT_PATTERN_MEMBERSHIP_CTA_CLASS,
  HAT_PATTERN_MEMBERSHIP_CTA_HREF,
  HAT_PATTERN_MEMBERSHIP_CTA_LABEL,
  HAT_PATTERN_PERSIST_MEMBERSHIP_PITCH,
  HAT_PATTERN_PERSIST_NOTICE_TITLE,
  HAT_PATTERN_PERSIST_WARNING_EMPHASIS,
  HAT_PATTERN_PERSIST_WARNING_LEAD,
} from "../../../lib/patterns/hat/hatPatternPersistNotice";
import { HAT_SUMMARY_EDIT_FROM_PATTERN_HREF } from "../../../lib/patterns/hat/hatPatternNavigation";

import "../../../styles/wizard.css";
import "../../../styles/glossary-tooltip.css";
import "../../../styles/pattern-tips.css";
import "../../../styles/pattern-quick-tip.css";
import "../../../styles/pattern-help-card.css";
import "../../../styles/patterns/sleeveless-pattern-shared.css";
import "../../../styles/patterns/pattern-app-shell.css";
import "../../../styles/tools/yarn-requirement-drawer-shell.css";

type HatGlossaryRow = { glossaryId?: number; english?: string; example?: string };
const hatGlossaryRows: HatGlossaryRow[] = Array.isArray(glossaryJson)
  ? (glossaryJson as HatGlossaryRow[])
  : [];
const hatGlossary311 = hatGlossaryRows.find((e) => e.glossaryId === 311);

function hatPlainGlossaryExample(raw: string | undefined): string {
  const s = (raw ?? "").trim();
  if (!s) return "";
  if (!/[<>]/.test(s)) return s;
  return s.replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim();
}

const scrapOffPatternTooltip =
  hatPlainGlossaryExample(hatGlossary311?.example) ||
  (hatGlossary311?.english ?? "Scrap Off").trim();

const hatZeroBodyRowsWarningMessage =
  "Your current settings don't leave any room for the body of the hat. Try increasing the finished hat length, reducing the brim height, or choosing a shallower crown style.";
---

<Layout
  title="Hat Pattern | Knit it Now"
  description="Your custom machine-knit hat pattern instructions and diagram from the Hat Pattern Builder."
  bodyClass="pattern-print-global-footer"
  patternWorkspace={true}
>
  <PatternPrintFooter footerBottomLeftExtra=" · KnitItNow.com/patterns/hat" />
  <main
    class="wizard-page sleeveless-pattern-page sleeveless-workspace-subpage pattern-app-shell hat-pattern-page"
    data-pattern-print-skip-modal
    data-hat-pattern-page
    data-scrap-off-tooltip={scrapOffPatternTooltip}
  >
    <div id="hat-pattern-top" class="wizard-container scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <div class="pattern-action-bar no-print" data-pattern-action-bar>
          <div class="pattern-action-bar__group pattern-action-bar__group--start">
            <button
              type="button"
              class="sleeveless-pattern-edit-action no-print is-disabled"
              data-hat-pattern-my-patterns
              data-testid="pattern-workspace-library-trigger"
              aria-haspopup="dialog"
              aria-controls="pattern-workspace-library-drawer-panel"
              aria-expanded="false"
              aria-disabled="true"
              title="Saving patterns is available with membership."
            >
              <i class="fa-solid fa-folder-open" aria-hidden="true"></i> My Patterns
            </button>
            <button
              type="button"
              class="sleeveless-pattern-edit-action no-print"
              data-hat-pattern-new-pattern-trigger
              data-testid="pattern-workspace-new-pattern-trigger"
            >
              <i class="fa-solid fa-plus" aria-hidden="true"></i> New Pattern
            </button>
          </div>
          <div
            class="pattern-action-bar__group pattern-action-bar__group--end"
            data-hat-pattern-actions
            data-sleeveless-pattern-actions
          >
            <button
              type="button"
              id="express-yarn-drawer-open"
              class="sleeveless-pattern-edit-action no-print"
              data-hat-yarn-open
              data-testid="hat-pattern-how-much-yarn"
              hidden
              aria-haspopup="dialog"
              aria-controls="express-yarn-drawer-panel"
              aria-expanded="false"
            >
              How Much Yarn?
            </button>
            <a
              href={HAT_SUMMARY_EDIT_FROM_PATTERN_HREF}
              class="sleeveless-pattern-edit-action no-print"
              data-hat-edit-open
              data-testid="button-edit-pattern"
              hidden
            >
              <i class="fas fa-pen" aria-hidden="true"></i> Edit Pattern
            </a>
            <!-- Print button (#print-btn) is injected when a valid pattern renders. -->
          </div>
        </div>

        <div class="hat-pattern-empty" data-hat-pattern-empty role="status" hidden>
          <h1 class="hat-pattern-empty__title">Hat Pattern</h1>
          <p class="hat-pattern-empty__message" data-hat-pattern-empty-message>
            Create a hat pattern first, then come back to view your instructions.
          </p>
          <a
            href="/patterns/hat/builder"
            class="kbm-btn kbm-btn-accent"
            data-testid="hat-pattern-empty-cta"
          >
            Go to Hat Builder
          </a>
        </div>

        <div id="sg-hat-results" class="sg-sleeveless-results" data-hat-pattern-results>
          <div id="hat-pattern-tips-scope" class="pattern-tips-scope" data-show-tips="true">
            <aside
              class="hat-pattern-persist-notice"
              data-hat-pattern-persist-notice
              data-testid="hat-pattern-persist-notice"
              role="region"
              aria-label={HAT_PATTERN_PERSIST_NOTICE_TITLE}
            >
              <p class="hat-pattern-persist-notice__title">
                {HAT_PATTERN_PERSIST_NOTICE_TITLE}
              </p>
              <p class="hat-pattern-persist-notice__warning">
                {HAT_PATTERN_PERSIST_WARNING_LEAD}{" "}
                <button
                  type="button"
                  class="hat-pattern-print-inline-link print-visible"
                  data-hat-pattern-print-link
                  data-testid="hat-pattern-print-inline-link"
                >
                  {HAT_PATTERN_PERSIST_WARNING_EMPHASIS}
                </button>
              </p>
              <div
                class="hat-pattern-persist-notice__membership no-print"
                data-hat-pattern-persist-membership
              >
                <p class="hat-pattern-persist-notice__pitch">
                  {HAT_PATTERN_PERSIST_MEMBERSHIP_PITCH}
                </p>
                <a
                  href={HAT_PATTERN_MEMBERSHIP_CTA_HREF}
                  class:list={[
                    HAT_PATTERN_MEMBERSHIP_CTA_CLASS.split(" "),
                    "hat-pattern-persist-notice__cta",
                  ]}
                  data-hat-pattern-membership-cta
                  data-testid="hat-pattern-membership-cta"
                >
                  {HAT_PATTERN_MEMBERSHIP_CTA_LABEL}
                </a>
              </div>
            </aside>
            <div class="no-print" data-hat-zero-body-warning hidden>
              <WarningBox title="Notice" message={hatZeroBodyRowsWarningMessage} />
            </div>
            <SleevelessPatternPrintNotice />
            <section class="sleeveless-pattern-intro">
              <div class="sleeveless-pattern-intro__image">
                <div class="beta-pattern-video">
                  <div class="beta-pattern-video__wrap">
                    <img
                      src="/images/patterns/basic-hat.webp"
                      alt="Woman wearing a knitted hat"
                      width="360"
                      height="360"
                      loading="lazy"
                      decoding="async"
                      class="sg-pattern-hero-image"
                    />
                  </div>
                </div>
                <div class="pattern-print-origin" aria-hidden="true">
                  <div class="pattern-print-origin__label">
                    Created with the Knit It Now Hat Pattern Builder
                  </div>
                  <div class="pattern-print-origin__url">KnitItNow.com/patterns/hat</div>
                </div>
              </div>
              <div class="sleeveless-pattern-intro__content">
                <div class="sleeveless-pattern-online-project-header no-print">
                  <div class="sleeveless-pattern-online-heading-row">
                    <p
                      class="sleeveless-pattern-online-heading"
                      data-hat-pattern-online-heading
                    >
                      Hat Pattern · Pattern instructions
                    </p>
                  </div>
                </div>
                <PatternPrintPersonalization>
                  <div
                    slot="print-summary"
                    class="sg-pattern-print-at-a-glance"
                    data-sg-pattern-print-at-a-glance
                  >
                    <h2 class="print-heading-major print-heading-major--hero">At a glance</h2>
                    <div data-sg-pattern-print-basics-body></div>
                  </div>
                </PatternPrintPersonalization>
                <div
                  class="sg-pattern-intro-metadata pattern-generated-description"
                  data-sg-pattern-intro
                  data-pattern-generated-description
                  aria-label="Pattern summary"
                ></div>
                <PatternTipsToggle
                  storageKey="hat-show-tips"
                  scopeSelector="#hat-pattern-tips-scope"
                />
              </div>
            </section>

            <div id="pattern-content" data-pattern-content>
              <div
                class="pattern-layout pattern-layout--garment-columns hat-pattern-reading-layout"
                data-hat-pattern-reading-layout
              >
                <div
                  class="pattern-layout__content hat-pattern-reading-layout__instructions"
                  data-hat-pattern-mount
                >
                  <p class="sleeveless-pattern-boot-msg">Loading pattern…</p>
                </div>
                <aside
                  class="pattern-layout__sidebar hat-pattern-reading-layout__diagram"
                  aria-label="Hat dimensions diagram"
                >
                  <div class="hat-pattern-diagram-panel pattern-print-keep-together">
                    <h3 class="hat-pattern-diagram-panel__title no-print">Hat Dimensions</h3>
                    <div
                      class="hat-pattern-diagram-panel__tabs-mount"
                      id="diagram-content"
                      data-hat-diagram-tabs-mount
                    ></div>
                  </div>
                </aside>
              </div>
            </div>
          </div>
        </div>

        <noscript>
          <div class="pattern-section">
            <h2 class="pattern-noscript-heading">Pattern</h2>
            <p>Turn on JavaScript to view this pattern.</p>
          </div>
        </noscript>
      </div>
    </div>

  </main>

  <!-- How Much Yarn? — same YarnRequirement drawer as sweater patterns; dimensions from in-memory draft. -->
  <div
    id="express-yarn-drawer"
    class="hat-yarn-drawer no-print"
    data-hat-yarn-drawer
    aria-hidden="true"
  >
    <div
      id="express-yarn-drawer-panel"
      class="hat-yarn-drawer-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="express-yarn-drawer-title"
      aria-describedby="express-yarn-drawer-desc express-yarn-drawer-note"
    >
      <header class="hat-yarn-drawer-header">
        <div class="hat-yarn-drawer-header-text">
          <h2 id="express-yarn-drawer-title" class="hat-yarn-drawer-title">Check your yarn</h2>
          <p id="express-yarn-drawer-desc" class="hat-yarn-drawer-lede">
            Quick estimate from a weighed swatch using this hat’s finished size and construction.
          </p>
          <p id="express-yarn-drawer-note" class="hat-yarn-drawer-note">
            This is an estimate. Actual yarn use may vary with stitch pattern, ribbing, and finishing.
          </p>
        </div>
        <button type="button" class="hat-yarn-drawer-close" id="express-yarn-drawer-close" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M18 6L6 18M6 6l12 12"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </header>
      <div class="hat-yarn-drawer-body">
        <YarnRequirement
          variant="hat"
          layout="panel"
          presentation="drawer"
          projectWidth={0}
          projectLength={0}
          lengthUnit="in"
          source="custom"
        />
      </div>
    </div>
    <div
      id="express-yarn-drawer-backdrop"
      class="hat-yarn-drawer-backdrop"
      aria-hidden="true"
    ></div>
  </div>
</Layout>

<style>
  .pattern-action-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(82, 104, 45, 0.12);
  }

  .pattern-action-bar__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .pattern-action-bar__group--end {
    justify-content: flex-end;
  }

  .sleeveless-pattern-online-project-header {
    margin: 0 0 0.75rem;
  }

  .sleeveless-pattern-online-heading-row {
    margin: 0 0 0.4rem;
  }

  .sleeveless-pattern-online-heading {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    color: #374151;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .sleeveless-pattern-intro__image {
    width: 100%;
    min-width: 280px;
    justify-self: end;
  }

  .beta-pattern-video {
    display: block;
    width: 360px;
    max-width: 100%;
  }

  .beta-pattern-video__wrap {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    background: transparent;
  }

  .sg-pattern-hero-image {
    display: block;
    width: 100%;
    max-height: 320px;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
  }

  /*
   * Soft informational persist notice (Hat-only).
   * Not WarningBox — cream panel + left accent, no triangle / alarm styling.
   */
  .hat-pattern-persist-notice {
    margin: 0 0 1.25rem;
    padding: 0.9rem 1.1rem;
    border-radius: 8px;
    border: 0;
    border-left: 4px solid var(--kbm-accent, #c2614e);
    background: #f7f6f4;
    color: #1f2937;
  }

  .hat-pattern-persist-notice__title {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.35;
    color: #374151;
  }

  .hat-pattern-persist-notice__warning {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #1f2937;
  }

  .hat-pattern-persist-notice__membership {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    margin-top: 0.7rem;
    min-width: 0;
  }

  .hat-pattern-persist-notice__pitch {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: #4b5563;
  }

  .hat-pattern-persist-notice__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    white-space: normal;
    text-align: center;
    text-decoration: none;
  }

  .hat-pattern-persist-notice__cta:focus-visible {
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }

  .hat-pattern-print-inline-link {
    display: inline;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    line-height: inherit;
    color: #52682d;
    text-decoration: underline;
    text-underline-offset: 0.12em;
    cursor: pointer;
  }

  .hat-pattern-print-inline-link:hover {
    color: #3f5223;
  }

  .hat-pattern-print-inline-link:focus-visible {
    outline: 2px solid #52682d;
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 560px) {
    .hat-pattern-persist-notice {
      padding: 0.85rem 0.95rem;
    }

    .hat-pattern-persist-notice__cta {
      width: 100%;
      box-sizing: border-box;
    }
  }

  @media print {
    .hat-pattern-persist-notice {
      break-inside: avoid;
      page-break-inside: avoid;
      background: #fff !important;
      border-left-color: #444 !important;
      color: #111 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .hat-pattern-persist-notice__title,
    .hat-pattern-persist-notice__warning {
      color: #111 !important;
    }

    .hat-pattern-print-inline-link {
      color: #111 !important;
      text-decoration: none;
      font-weight: 700;
    }
  }

  :global(#pattern-content .hat-swirl-crown-video-tip__title) {
    margin: 0 0 0.35rem;
  }

  :global(#pattern-content .hat-swirl-crown-video-tip__message) {
    margin: 0 0 0.55rem;
  }

  :global(#pattern-content .hat-swirl-crown-video-tip__actions) {
    margin: 0;
  }

  :global(#pattern-content .hat-swirl-crown-video-tip__watch.kbm-kin-catalog-video),
  :global(#pattern-content .hat-four-gore-crown-video-tip__watch.kbm-kin-catalog-video) {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(82, 104, 45, 0.35);
    border-radius: 6px;
    background: #fff;
    color: #52682d;
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.3;
    cursor: pointer;
    text-decoration: none;
  }

  :global(#pattern-content .hat-swirl-crown-video-tip__watch.kbm-kin-catalog-video:hover),
  :global(#pattern-content .hat-four-gore-crown-video-tip__watch.kbm-kin-catalog-video:hover) {
    background: rgba(82, 104, 45, 0.08);
    color: #3f5223;
  }

  :global(#pattern-content .hat-swirl-crown-video-tip__watch.kbm-kin-catalog-video:focus-visible),
  :global(#pattern-content .hat-four-gore-crown-video-tip__watch.kbm-kin-catalog-video:focus-visible) {
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }

  /*
   * TRANSFER STEP — required Swirl Top instruction (NOT a pattern tip).
   * Terracotta accent mirrors Row Counter Reset; tips toggle must not hide these.
   */
  :global(#pattern-content .hat-transfer-step-callout) {
    display: block;
    margin: 0.75rem 0 1rem;
    padding: 0.7rem 0.85rem;
    border: 2px solid var(--sg-accent, #c2614e);
    border-radius: 6px;
    background: #f7f6f4;
    color: #1f2937;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  :global(#pattern-content .hat-transfer-step-callout__header) {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.5rem;
  }

  :global(#pattern-content .hat-transfer-step-callout__heading) {
    margin: 0;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sg-accent, #c2614e);
    line-height: 1.2;
  }

  :global(#pattern-content .hat-transfer-step-callout__body),
  :global(#pattern-content .hat-transfer-step-callout__icon-explain) {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #1f2937;
  }

  :global(#pattern-content .hat-transfer-step-icon) {
    display: inline-block;
    flex-shrink: 0;
    border: 0;
    background: transparent;
    vertical-align: middle;
    pointer-events: none;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  :global(#pattern-content .hat-transfer-step-icon--callout) {
    width: 40px;
    height: 40px;
  }

  :global(#pattern-content .hat-transfer-step-icon--row) {
    width: 1.35em;
    height: 1.35em;
  }

  :global(#pattern-content .pattern-row-instruction--transfer-followup) {
    margin: 0.55rem 0 0.45rem;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  :global(#pattern-content .pattern-row-instruction__line) {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #374151;
  }

  :global(#pattern-content .hat-transfer-step-action) {
    display: inline;
    white-space: nowrap;
  }

  :global(#pattern-content .hat-transfer-step-marker) {
    display: inline;
    margin: 0 0.2em 0 0;
    padding: 0;
    border: 0;
    background: transparent;
    white-space: nowrap;
    vertical-align: middle;
    pointer-events: none;
  }

  :global(#pattern-content .hat-transfer-step-marker .hat-transfer-step-icon--row) {
    display: inline-block;
    vertical-align: -0.25em;
  }

  @media (max-width: 640px) {
    :global(#pattern-content .hat-transfer-step-callout) {
      padding: 0.65rem 0.7rem;
    }

    :global(#pattern-content .hat-transfer-step-icon--callout) {
      width: 36px;
      height: 36px;
    }
  }

  @media print {
    :global(#pattern-content .hat-transfer-step-callout) {
      border-color: #444 !important;
      background: #fff !important;
      color: #111 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    :global(#pattern-content .hat-transfer-step-callout__heading) {
      color: #111 !important;
    }

    :global(#pattern-content .hat-transfer-step-callout__body),
    :global(#pattern-content .hat-transfer-step-callout__icon-explain) {
      color: #111 !important;
    }

    :global(#pattern-content .hat-transfer-step-icon) {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
  }

  .hat-pattern-empty {
    padding: 1.5rem 0.5rem 2rem;
    text-align: center;
  }

  .hat-pattern-empty__title {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--kbm-green, #52682d);
  }

  .hat-pattern-empty__message {
    margin: 0 auto 1.25rem;
    max-width: 28rem;
    font-size: 1rem;
    line-height: 1.5;
    color: #4b5563;
  }

  /* Mobile/tablet: instructions first, diagram after (override garment-columns diagram-first order). */
  #pattern-content .pattern-layout.hat-pattern-reading-layout {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: stretch;
    min-width: 0;
  }

  #pattern-content .hat-pattern-reading-layout__instructions,
  #pattern-content .hat-pattern-reading-layout__diagram {
    min-width: 0;
    max-width: 100%;
  }

  #pattern-content .pattern-layout.hat-pattern-reading-layout > .hat-pattern-reading-layout__diagram {
    order: 0;
  }

  .hat-pattern-diagram-panel {
    margin: 0;
    max-width: 100%;
  }

  .hat-pattern-diagram-panel__title {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
