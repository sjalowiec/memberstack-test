---
import Layout from "../../../../layouts/Layout.astro";
import PatternPrintFooter from "../../../../components/common/PatternPrintFooter.astro";
import PatternPrintPersonalization from "../../../../components/common/PatternPrintPersonalization.astro";
import PatternTipsToggle from "../../../../components/patterns/PatternTipsToggle.astro";
import PatternPhoneWorkspaceNotice from "../../../../components/patterns/PatternPhoneWorkspaceNotice.astro";
import WarningBox from "../../../../components/ui/WarningBox.astro";
import hatSizingRows from "../../../../data/sizing_hats.json";
import glossaryJson from "../../../../data/glossary.json";
import { roundFinishedHatSizeFromHead } from "../../../../lib/patterns/hat/hatMath";

import "../../../../styles/wizard.css";
import "../../../../styles/glossary-tooltip.css";
import "../../../../styles/pattern-tips.css";
import "../../../../styles/pattern-quick-tip.css";
import "../../../../styles/pattern-help-card.css";
import "../../../../styles/patterns/sleeveless-pattern-shared.css";
import "../../../../styles/patterns/pattern-app-shell.css";
import "../../../../styles/patterns/hat-builder.css";
import "../../../../styles/patterns/hat-pattern-workspace.css";

type HatGlossaryRow = { glossaryId?: number; english?: string; example?: string };
const hatGlossaryRows: HatGlossaryRow[] = Array.isArray(glossaryJson)
  ? (glossaryJson as HatGlossaryRow[])
  : [];
const hatGlossary311 = hatGlossaryRows.find((e) => e.glossaryId === 311);
function hatPlainGlossaryExample(raw: string | undefined): string {
  const s = (raw ?? "").trim();
  if (!s) return "";
  if (!/[<>]/.test(s)) return s;
  return s.replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim();
}
const scrapOffPatternTooltip =
  hatPlainGlossaryExample(hatGlossary311?.example) ||
  (hatGlossary311?.english ?? "Scrap Off").trim();

const hatSizeOptions = hatSizingRows.map((row) => {
  const finishedSizeInches = roundFinishedHatSizeFromHead(Number(row.circumference));
  return {
    size: row.size,
    label: row.label || row.size,
    finishedSizeInches,
  };
});

const hatZeroBodyRowsWarningMessage =
  "Your current settings don't leave any room for the body of the hat. Try increasing the finished hat length, reducing the brim height, or choosing a shallower crown style.";
---

<Layout
  title="Hat Pattern | Knit it Now"
  description="Your custom machine knit hat pattern with instructions, diagram, and print-ready layout."
  bodyClass="pattern-print-global-footer"
  patternWorkspace={true}
>
  <PatternPrintFooter footerBottomLeftExtra=" · KnitItNow.com/hat" />
  <main
    class="wizard-page sleeveless-pattern-page sleeveless-workspace-subpage pattern-app-shell hat-pattern-page"
    data-pattern-print-skip-modal
    data-hat-scrap-off-tooltip={scrapOffPatternTooltip}
  >
    <div id="hat-pattern-top" class="wizard-container scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <div class="pattern-action-bar no-print" data-pattern-action-bar>
          <div class="pattern-action-bar__group pattern-action-bar__group--start">
            <button
              type="button"
              class="sleeveless-pattern-edit-action no-print"
              data-hat-new-pattern
              data-testid="hat-new-pattern-trigger"
            >
              <i class="fa-solid fa-plus" aria-hidden="true"></i> New Pattern
            </button>
            <button
              type="button"
              class="sleeveless-pattern-edit-action no-print"
              data-hat-back-builder
              data-testid="hat-back-builder"
            >
              <i class="fa-solid fa-sliders" aria-hidden="true"></i> Edit choices
            </button>
          </div>
          <div
            class="pattern-action-bar__group pattern-action-bar__group--end"
            data-hat-pattern-actions
          >
            <button
              type="button"
              class="sleeveless-pattern-edit-action no-print"
              data-hat-edit-open
              data-testid="button-edit-pattern"
              aria-haspopup="dialog"
              aria-controls="hat-edit-drawer-panel"
            >
              <i class="fas fa-pen" aria-hidden="true"></i> Edit Pattern
            </button>
            <!-- Print (#print-btn) injected by hat-pattern-page.ts -->
          </div>
        </div>

        <div id="hat-pattern-results" class="sg-sleeveless-results" style="display:none;">
          <div id="hat-pattern-tips-scope" class="pattern-tips-scope" data-show-tips="false">
            <section class="sleeveless-pattern-intro">
              <div class="sleeveless-pattern-intro__image">
                <div class="beta-pattern-video">
                  <div class="beta-pattern-video__wrap">
                    <img
                      src="/images/hats/length-classic.png"
                      alt="Machine knit hat pattern preview"
                      width="400"
                      height="400"
                      loading="lazy"
                      decoding="async"
                      class="sg-pattern-hero-image"
                    />
                  </div>
                </div>
                <div class="pattern-print-origin" aria-hidden="true">
                  <div class="pattern-print-origin__label">
                    Created with the Knit It Now Hat Pattern Builder
                  </div>
                  <div class="pattern-print-origin__url">KnitItNow.com/hat</div>
                </div>
              </div>
              <div class="sleeveless-pattern-intro__content">
                <div class="sleeveless-pattern-online-project-header no-print">
                  <div class="sleeveless-pattern-online-heading-row">
                    <p class="sleeveless-pattern-online-heading">
                      Machine knit hat · Pattern instructions
                    </p>
                  </div>
                </div>
                <PatternPrintPersonalization>
                  <div slot="print-summary" class="sg-pattern-print-at-a-glance" data-sg-pattern-print-at-a-glance>
                    <h2 class="print-heading-major print-heading-major--hero">At a glance</h2>
                    <div data-hat-print-basics-body></div>
                  </div>
                </PatternPrintPersonalization>
                <div
                  class="sg-pattern-intro-metadata pattern-generated-description"
                  data-hat-pattern-intro
                  aria-label="Pattern summary"
                ></div>
                <PatternTipsToggle
                  storageKey="hat-show-tips"
                  scopeSelector="#hat-pattern-tips-scope"
                />
              </div>
            </section>

            <div id="hat-zero-body-warning" class="no-print" hidden>
              <WarningBox title="Notice" message={hatZeroBodyRowsWarningMessage} />
            </div>

            <div class="hat-pattern-diagram-block no-print" data-hat-diagram-mount></div>

            <div id="pattern-content" data-pattern-content data-show-tips="false">
              <div class="sleeveless-pattern-mount" data-hat-pattern-mount>
                <p class="sleeveless-pattern-boot-msg">Loading pattern…</p>
              </div>
            </div>
          </div>
        </div>

        <noscript>
          <div class="pattern-section">
            <h2 class="pattern-noscript-heading">Pattern</h2>
            <p>Turn on JavaScript to view this pattern.</p>
          </div>
        </noscript>
      </div>
    </div>

    <!-- Edit Pattern workspace (hat-specific fields; no sweater measurement SVG). -->
    <div class="sl-edit-drawer sl-edit-drawer--workspace hat-edit-drawer no-print" data-hat-edit-drawer aria-hidden="true">
      <div class="sl-edit-drawer__backdrop" data-hat-edit-close aria-hidden="true"></div>
      <section
        id="hat-edit-drawer-panel"
        class="sl-edit-drawer__panel"
        role="dialog"
        aria-modal="true"
        aria-label="Edit hat pattern"
        tabindex="-1"
      >
        <PatternPhoneWorkspaceNotice />
        <div class="hat-edit-workspace">
          <header class="hat-edit-workspace__header">
            <h2>Edit Pattern</h2>
            <button type="button" class="hat-edit-workspace__close" data-hat-edit-close aria-label="Close">
              ×
            </button>
          </header>
          <div class="hat-edit-workspace__body">
            <label class="hat-edit-field">
              <span>Units</span>
              <select id="hat-edit-unit">
                <option value="inches">Inches</option>
                <option value="cm">Centimeters</option>
              </select>
            </label>
            <label class="hat-edit-field">
              <span>Hat size</span>
              <select id="hat-edit-size">
                <option value="">Choose…</option>
                {hatSizeOptions.map((row) => (
                  <option value={row.size}>{row.label}</option>
                ))}
                <option value="custom">Custom finished hat size</option>
              </select>
            </label>
            <div id="hat-edit-custom-size-wrap" class="hat-edit-field" hidden>
              <label>
                <span>Custom finished circumference</span>
                <input id="hat-edit-custom-circ" type="number" step="0.25" />
              </label>
            </div>
            <label class="hat-edit-field">
              <span>Finished hat length</span>
              <select id="hat-edit-fit">
                <option value="">Choose…</option>
                <option value="beanie">Beanie</option>
                <option value="watchcap">Classic</option>
                <option value="slouchy">Slouchy</option>
                <option value="relaxed">Relaxed</option>
                <option value="custom">Custom length</option>
              </select>
            </label>
            <div id="hat-edit-custom-length-wrap" class="hat-edit-field" hidden>
              <label>
                <span>Custom finished length</span>
                <input id="hat-edit-custom-length" type="number" step="0.25" />
              </label>
            </div>
            <label class="hat-edit-field">
              <span>Brim type</span>
              <select id="hat-edit-brim-type">
                <option value="">Choose…</option>
                <option value="single">Single Layer</option>
                <option value="folded">Folded Hem</option>
              </select>
            </label>
            <label class="hat-edit-field">
              <span>Visible brim height</span>
              <input id="hat-edit-brim-length" type="number" step="0.25" />
            </label>
            <label class="hat-edit-field">
              <span>Crown shaping</span>
              <select id="hat-edit-crown">
                <option value="">Choose…</option>
                <option value="gathered">Gathered</option>
                <option value="wedge-4-decrease">4-Wedge Decrease</option>
                <option value="spiral">Spiral</option>
              </select>
            </label>
            <label class="hat-edit-field">
              <span>Stitch gauge</span>
              <input id="hat-edit-stitch-gauge" type="number" step="0.1" />
            </label>
            <label class="hat-edit-field">
              <span>Row gauge</span>
              <input id="hat-edit-row-gauge" type="number" step="0.1" />
            </label>
          </div>
          <footer class="hat-edit-workspace__footer">
            <button type="button" class="btn btn-outline-secondary" data-hat-edit-builder>
              Open full builder
            </button>
            <div class="hat-edit-workspace__footer-actions">
              <button type="button" class="btn btn-outline-secondary" data-hat-edit-close>Cancel</button>
              <button type="button" class="btn btn-primary" data-hat-edit-apply>Update Pattern</button>
            </div>
          </footer>
        </div>
      </section>
    </div>
  </main>

  <script is:inline src="/js/wizard-utils.js"></script>
  <script>
    import "/src/scripts/hat-pattern-page.ts";
  </script>
</Layout>
