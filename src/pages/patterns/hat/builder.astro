---
/**
 * Hat Pattern Builder (Express-shell stage 1).
 * Free / ungated. Draft: kbm_hat_draft. Does not replace /patterns/hat.
 */
import Layout from "../../../layouts/Layout.astro";
import PatternPhoneWorkspaceNotice from "../../../components/patterns/PatternPhoneWorkspaceNotice.astro";
import GaugeInput from "../../../components/wizards/GaugeInput.astro";
import UnitToggle from "../../../components/wizards/UnitToggle.astro";
import FloatingInput from "../../../components/lego/FloatingInput.astro";
import hatSizingRows from "../../../data/sizing_hats.json";
import { buildHatSizingBuilderRows } from "../../../lib/patterns/hat/hatBuilderSizingLabels";
import {
  AVAILABLE_NEEDLES_HELPER_TEXT,
  AVAILABLE_NEEDLES_LABEL,
  AVAILABLE_NEEDLES_REQUIRED_MESSAGE,
} from "../../../lib/patterns/hat/hatAvailableNeedles";
import {
  HAT_PATTERN_HERO_IMAGE_ALT,
  HAT_PATTERN_HERO_IMAGE_HEIGHT,
  HAT_PATTERN_HERO_IMAGE_WIDTH,
} from "../../../lib/patterns/hat/hatPatternHeroImage";

import "../../../styles/sleeveless-express-builder-cards.css";
import "../../../styles/sleeveless-express-wizard-layout.css";
import "../../../styles/wizard.css";

const hatSizingBuilderRows = buildHatSizingBuilderRows(
  Array.isArray(hatSizingRows) ? hatSizingRows : [],
);

const expressNavSteps = [
  { step: 1, label: "Size" },
  { step: 2, label: "Length" },
  { step: 3, label: "Brim" },
  { step: 4, label: "Crown" },
  { step: 5, label: "Gauge" },
] as const;
---

<Layout
  title="Hat Pattern Builder | Knit it Now"
  description="Create a custom machine-knit hat pattern with your gauge, size, brim, and crown shaping."
  patternWorkspace={true}
>
  <main
    class="express-page wizard-page sleeveless-express-page hat-express-builder-page"
    data-express-page="hat-builder"
    data-hat-builder
  >
    <div id="hat-builder-form-top" class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternPhoneWorkspaceNotice />
        <div class="sg-tab-build">
          <div class="sg-builder-nav-row express-builder-nav-row no-print">
            <nav class="express-step-nav sg-builder-nav" aria-label="Hat pattern steps">
              <ol class="express-step-nav__list sg-builder-nav__list" role="list">
                {
                  expressNavSteps.map((s, i) => (
                    <li
                      class:list={[
                        "express-step-nav__item",
                        "sg-builder-nav__item",
                        { active: s.step === 1 },
                      ]}
                    >
                      <button
                        type="button"
                        class:list={[
                          "express-step-nav__btn",
                          "sg-builder-nav__link",
                          {
                            "is-current": s.step === 1,
                            "is-upcoming": s.step > 1,
                          },
                        ]}
                        data-pill-step={s.step}
                        data-pill-label={s.label}
                        aria-current={s.step === 1 ? "page" : undefined}
                        aria-disabled={s.step > 1 ? "true" : undefined}
                        title={s.step > 1 ? "Finish the previous step to continue." : undefined}
                      >
                        <span class="express-step-nav__track">
                          <span
                            class:list={[
                              "express-step-nav__seg",
                              "express-step-nav__seg--before",
                              { "express-step-nav__seg--empty": i === 0 },
                            ]}
                            aria-hidden="true"
                          />
                          <span class="express-step-nav__circle">
                            <span class="express-step-nav__num">{s.step}</span>
                            <span class="express-pill__check" aria-hidden="true">
                              ✓
                            </span>
                          </span>
                          <span
                            class:list={[
                              "express-step-nav__seg",
                              "express-step-nav__seg--after",
                              {
                                "express-step-nav__seg--empty":
                                  i === expressNavSteps.length - 1,
                              },
                            ]}
                            aria-hidden="true"
                          />
                        </span>
                        <span class="express-step-nav__label">{s.label}</span>
                      </button>
                    </li>
                  ))
                }
              </ol>
            </nav>
          </div>

          <header class="pattern-header page-header">
            <div class="hat-builder-hero-image">
              <img
                src="/images/patterns/hat.webp"
                alt={HAT_PATTERN_HERO_IMAGE_ALT}
                width={HAT_PATTERN_HERO_IMAGE_WIDTH}
                height={HAT_PATTERN_HERO_IMAGE_HEIGHT}
                loading="lazy"
                decoding="async"
                class="sg-pattern-hero-image hat-pattern-hero-image"
              />
            </div>
            <div class="pattern-header__title-row">
              <h1 class="pattern-title">Hat Pattern</h1>
            </div>
            <p class="pattern-subtext">
              Choose your size, length, brim, and crown, then enter your gauge to create a
              custom machine-knit hat pattern.
            </p>
          </header>

          <div class="express-panel">
            <div class="express-builder-root" data-express-builder data-hat-builder-root>
              <div class="express-builder-toolbar no-print">
                <button
                  type="button"
                  id="hat-builder-start-over"
                  class="btn btn-outline-secondary btn-sm"
                  data-testid="hat-builder-start-over"
                >
                  Start over
                </button>
              </div>
              <div class="express-builder-units no-print">
                <UnitToggle id="hat" />
              </div>

              <div class="express-accordions" id="express-accordions">
                <!-- Step 1 — Size -->
                <section
                  class="express-acc express-acc--open"
                  data-express-step="1"
                  data-express-field="size"
                >
                  <div
                    class="express-acc__header"
                    data-express-header
                    role="button"
                    tabindex="0"
                    aria-expanded="true"
                    aria-controls="express-acc-panel-1"
                    id="express-acc-label-1"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-express-chevron
                      aria-label="Toggle size choices"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" data-express-check aria-hidden="true"
                        >✓</span
                      >
                      <h2 class="express-acc__title" id="express-step-1-title">Hat size</h2>
                      <span class="express-acc__value" data-express-summary="size"></span>
                    </div>
                  </div>
                  <div
                    class="express-acc__body"
                    id="express-acc-panel-1"
                    role="region"
                    aria-labelledby="express-step-1-title"
                  >
                    <div class="input-group">
                      <div class="hat-select-wrap">
                        <span class="hat-select-wrap__check" aria-hidden="true"></span>
                        <select
                          id="hat-size"
                          data-testid="select-hat-size"
                          aria-label="Choose a finished hat size (inches)"
                          data-sizes-source="ssr"
                          autocomplete="off"
                        >
                          <option value="" disabled selected hidden
                            >Choose a finished hat size (inches)...</option
                          >
                          {
                            hatSizingBuilderRows.map((row) => (
                              <option
                                value={row.size}
                                data-finished-size-inches={row.finishedSizeInches}
                              >
                                {row.optionLabel}
                              </option>
                            ))
                          }
                          <option value="custom">✏️ Enter your own finished hat size</option>
                        </select>
                      </div>
                    </div>
                    <div
                      id="custom-size"
                      class="hat-builder-custom-subfield"
                      hidden
                      data-hat-custom-size
                    >
                      <div class="input-group">
                        <FloatingInput
                          id="custom-circumference"
                          type="number"
                          step={0.25}
                          label="Custom Finished Hat Size (inches)"
                          placeholder=" "
                          testId="input-custom-circumference"
                          autocomplete="off"
                        />
                      </div>
                    </div>
                  </div>
                </section>

                <!-- Step 2 — Length -->
                <section
                  class="express-acc express-acc--locked"
                  data-express-step="2"
                  data-express-field="length"
                >
                  <div
                    class="express-acc__header"
                    data-express-header
                    role="button"
                    tabindex="-1"
                    aria-expanded="false"
                    aria-controls="express-acc-panel-2"
                    id="express-acc-label-2"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-express-chevron
                      aria-hidden="true"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" data-express-check aria-hidden="true"
                        >✓</span
                      >
                      <h2 class="express-acc__title" id="express-step-2-title"
                        >Finished hat length</h2
                      >
                      <span class="express-acc__value" data-express-summary="length"></span>
                    </div>
                  </div>
                  <p
                    class="express-acc__locked-feedback"
                    data-express-locked-feedback
                    hidden
                    role="status"
                  >
                    <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
                    <span class="express-acc__locked-msg"
                      >Finish the previous step to continue.</span
                    >
                  </p>
                  <div
                    class="express-acc__body"
                    id="express-acc-panel-2"
                    role="region"
                    aria-labelledby="express-step-2-title"
                    hidden
                  >
                    <p class="hat-builder-step-intro">
                      Finished length from the bottom of the brim to the top of the crown.
                    </p>
                    <select id="fit" class="sr-only" data-testid="select-fit" autocomplete="off">
                      <option value="" disabled selected hidden>Enter Finished Hat Length...</option>
                      <option value="beanie">Beanie</option>
                      <option value="watchcap">Standard</option>
                      <option value="slouchy">Slouchy</option>
                      <option value="custom">Custom</option>
                    </select>
                    <div
                      class="hat-length-picker__grid"
                      role="group"
                      aria-label="Finished hat length style"
                    >
                      <button
                        type="button"
                        class="hat-length-picker__option"
                        data-choice
                        data-field="fit"
                        data-value="beanie"
                        aria-pressed="false"
                      >
                        <img
                          src="/images/hats/length-beanie.png"
                          alt=""
                          class="hat-length-picker__img sg-picker-img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="hat-length-picker__option-label">Beanie</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option"
                        data-choice
                        data-field="fit"
                        data-value="watchcap"
                        aria-pressed="false"
                      >
                        <img
                          src="/images/hats/length-classic.png"
                          alt=""
                          class="hat-length-picker__img sg-picker-img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="hat-length-picker__option-label">Standard</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option"
                        data-choice
                        data-field="fit"
                        data-value="slouchy"
                        aria-pressed="false"
                      >
                        <img
                          src="/images/hats/length-slouchy.png"
                          alt=""
                          class="hat-length-picker__img sg-picker-img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="hat-length-picker__option-label">Slouchy</span>
                      </button>
                    </div>
                    <button
                      type="button"
                      class="hat-length-picker__custom"
                      id="hat-length-custom-btn"
                      data-testid="hat-length-custom-btn"
                    >
                      ✏️ Enter your own finished hat length
                    </button>
                    <div
                      id="custom-length-div"
                      class="hat-builder-custom-subfield"
                      hidden
                      data-hat-custom-length
                    >
                      <div class="input-group">
                        <FloatingInput
                          id="custom-hat-length"
                          type="number"
                          step={0.25}
                          label="Finished Hat Length (bottom of brim to top of crown) (inches)"
                          placeholder=" "
                          testId="input-custom-hat-length"
                          autocomplete="off"
                        />
                        <small class="helper-text"
                          >Enter the finished hat length as it will be worn. We'll calculate the
                          crown shaping and any brim adjustments for you.</small
                        >
                      </div>
                    </div>
                  </div>
                </section>

                <!-- Step 3 — Brim -->
                <section
                  class="express-acc express-acc--locked"
                  data-express-step="3"
                  data-express-field="brim"
                >
                  <div
                    class="express-acc__header"
                    data-express-header
                    role="button"
                    tabindex="-1"
                    aria-expanded="false"
                    aria-controls="express-acc-panel-3"
                    id="express-acc-label-3"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-express-chevron
                      aria-hidden="true"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" data-express-check aria-hidden="true"
                        >✓</span
                      >
                      <h2 class="express-acc__title" id="express-step-3-title">Brim</h2>
                      <span class="express-acc__value" data-express-summary="brim"></span>
                    </div>
                  </div>
                  <p
                    class="express-acc__locked-feedback"
                    data-express-locked-feedback
                    hidden
                    role="status"
                  >
                    <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
                    <span class="express-acc__locked-msg"
                      >Finish the previous step to continue.</span
                    >
                  </p>
                  <div
                    class="express-acc__body"
                    id="express-acc-panel-3"
                    role="region"
                    aria-labelledby="express-step-3-title"
                    hidden
                  >
                    <select
                      id="brimType"
                      class="sr-only"
                      data-testid="select-brim-type"
                      aria-label="Brim Type"
                      autocomplete="off"
                    >
                      <option value="" disabled selected hidden>Choose brim type</option>
                      <option value="rolled">Rolled Brim</option>
                      <option value="single">Single Layer</option>
                      <option value="folded">Folded Hem</option>
                    </select>
                    <div
                      class="hat-length-picker__grid hat-brim-picker__grid"
                      role="group"
                      aria-label="Brim type"
                    >
                      <button
                        type="button"
                        class="hat-length-picker__option"
                        data-choice
                        data-field="brimType"
                        data-value="rolled"
                        aria-pressed="false"
                      >
                        <img
                          src="/images/hats/rolled-brim.png"
                          alt=""
                          class="hat-length-picker__img sg-picker-img hat-brim-picker__img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="hat-length-picker__option-label">Rolled Brim</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option"
                        data-choice
                        data-field="brimType"
                        data-value="single"
                        aria-pressed="false"
                      >
                        <img
                          src="/images/hats/single-layer.png"
                          alt=""
                          class="hat-length-picker__img sg-picker-img hat-brim-picker__img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="hat-length-picker__option-label">Single Layer</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option"
                        data-choice
                        data-field="brimType"
                        data-value="folded"
                        aria-pressed="false"
                      >
                        <img
                          src="/images/hats/folded-hem.png"
                          alt=""
                          class="hat-length-picker__img sg-picker-img hat-brim-picker__img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="hat-length-picker__option-label">Folded Hem</span>
                      </button>
                    </div>
                    <div class="input-group hat-builder-brim-length">
                      <FloatingInput
                        id="brimLength"
                        name="brimLength"
                        type="number"
                        step={0.25}
                        label="Visible Brim Height (when worn) (inches)"
                        placeholder=" "
                        testId="input-brim-length"
                        autocomplete="off"
                      />
                      <small class="helper-text" data-brim-helper
                        >Enter the brim height as worn.</small
                      >
                    </div>
                  </div>
                </section>

                <!-- Step 4 — Crown -->
                <section
                  class="express-acc express-acc--locked"
                  data-express-step="4"
                  data-express-field="crown"
                >
                  <div
                    class="express-acc__header"
                    data-express-header
                    role="button"
                    tabindex="-1"
                    aria-expanded="false"
                    aria-controls="express-acc-panel-4"
                    id="express-acc-label-4"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-express-chevron
                      aria-hidden="true"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" data-express-check aria-hidden="true"
                        >✓</span
                      >
                      <h2 class="express-acc__title" id="express-step-4-title">Crown</h2>
                      <span class="express-acc__value" data-express-summary="crown"></span>
                    </div>
                  </div>
                  <p
                    class="express-acc__locked-feedback"
                    data-express-locked-feedback
                    hidden
                    role="status"
                  >
                    <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
                    <span class="express-acc__locked-msg"
                      >Finish the previous step to continue.</span
                    >
                  </p>
                  <div
                    class="express-acc__body"
                    id="express-acc-panel-4"
                    role="region"
                    aria-labelledby="express-step-4-title"
                    hidden
                  >
                    <select
                      id="crown"
                      class="sr-only"
                      data-testid="select-crown"
                      autocomplete="off"
                    >
                      <option value="" disabled selected hidden>Choose crown shaping</option>
                      <option value="gathered">Gathered</option>
                      <option value="wedge-4-decrease">Four-Gore</option>
                      <option value="spiral">Swirl Top</option>
                    </select>
                    <div
                      class="hat-length-picker__grid"
                      role="group"
                      aria-label="Crown shaping"
                    >
                      <button
                        type="button"
                        class="hat-length-picker__option"
                        data-choice
                        data-field="crown"
                        data-value="gathered"
                        aria-pressed="false"
                      >
                        <img
                          src="/images/hats/gathered.svg"
                          alt=""
                          class="hat-length-picker__img sg-picker-img hat-crown-picker__img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="hat-length-picker__option-label">Gathered</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option"
                        data-choice
                        data-field="crown"
                        data-value="wedge-4-decrease"
                        aria-pressed="false"
                      >
                        <img
                          src="/images/hats/wedge.svg"
                          alt=""
                          class="hat-length-picker__img sg-picker-img hat-crown-picker__img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="hat-length-picker__option-label">Four-Gore</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option"
                        data-choice
                        data-field="crown"
                        data-value="spiral"
                        aria-pressed="false"
                      >
                        <img
                          src="/images/hats/spiral.svg"
                          alt=""
                          class="hat-length-picker__img sg-picker-img hat-crown-picker__img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="hat-length-picker__option-label">Swirl Top</span>
                      </button>
                    </div>
                  </div>
                </section>

                <!-- Step 5 — Gauge -->
                <section
                  class="express-acc express-acc--locked scroll-mt-[96px]"
                  id="express-gauge-section"
                  data-express-step="5"
                  data-express-field="gauge"
                >
                  <div
                    class="express-acc__header"
                    data-express-header
                    role="button"
                    tabindex="-1"
                    aria-expanded="false"
                    aria-controls="express-acc-panel-5"
                    id="express-acc-label-5"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-express-chevron
                      aria-hidden="true"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" data-express-check aria-hidden="true"
                        >✓</span
                      >
                      <h2 class="express-acc__title" id="express-step-5-title"
                        >Enter your gauge</h2
                      >
                      <span class="express-acc__value" data-express-summary="gauge"></span>
                    </div>
                  </div>
                  <p
                    class="express-acc__locked-feedback"
                    data-express-locked-feedback
                    hidden
                    role="status"
                  >
                    <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
                    <span class="express-acc__locked-msg"
                      >Finish the previous step to continue.</span
                    >
                  </p>
                  <div
                    class="express-acc__body"
                    id="express-acc-panel-5"
                    role="region"
                    aria-labelledby="express-step-5-title"
                    hidden
                  >
                    <p class="express-gauge-intro">
                      Enter the gauge from your swatch over 4 inches / 10 cm.
                    </p>
                    <div class="express-gauge-block">
                      <GaugeInput
                        id="hat"
                        showTitle={false}
                        showGaugeSubLabel={false}
                        showToggle={false}
                        toggleId="hat"
                        formFields={true}
                      />
                    </div>
                    <div class="express-needle-block" hidden>
                      <FloatingInput
                        id="express-available-needles"
                        name="availableNeedles"
                        label={AVAILABLE_NEEDLES_LABEL}
                        type="number"
                        inputMode="numeric"
                        min="1"
                        step="1"
                        required
                        errorId="express-available-needles-error"
                        errorText={AVAILABLE_NEEDLES_REQUIRED_MESSAGE}
                      />
                      <p class="express-needle-help" id="express-available-needles-help">
                        {AVAILABLE_NEEDLES_HELPER_TEXT}
                      </p>
                      <p
                        class="express-needle-capacity-error"
                        id="hat-needle-capacity-error"
                        data-testid="hat-needle-capacity-error"
                        role="alert"
                        hidden
                      ></p>
                    </div>
                  </div>
                  <div
                    class="express-generate-wrap express-generate-wrap--footer"
                    id="build-pattern-cta"
                  >
                    <button
                      type="button"
                      class="express-generate button-disabled"
                      id="create-pattern-btn"
                      data-testid="create-pattern-btn"
                      aria-disabled="true"
                    >
                      Review My Pattern
                    </button>
                    <p
                      id="create-pattern-feedback"
                      class="create-pattern-feedback"
                      role="status"
                      aria-live="polite"
                      hidden
                    >
                    </p>
                  </div>
                </section>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script
    type="application/json"
    id="hat-sizing-builder-rows"
    set:html={JSON.stringify(hatSizingBuilderRows)}
  />
</Layout>

<script>
  import "/src/scripts/hat-builder-page.ts";
</script>

<style>
  /* Narrow hat-only helpers — picker cards use shared Express .hat-length-picker__* rules. */
  .hat-express-builder-page .hat-builder-hero-image {
    width: 360px;
    max-width: 100%;
    margin: 0 auto 1rem;
  }

  .hat-express-builder-page .hat-pattern-hero-image {
    display: block;
    width: 100%;
    max-height: 320px;
    height: auto;
    object-fit: contain;
    object-position: center;
    border-radius: 8px;
  }

  .hat-express-builder-page .hat-builder-step-intro {
