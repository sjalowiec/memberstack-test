---
import Layout from "../../../layouts/Layout.astro";
import PatternPhoneWorkspaceNotice from "../../../components/patterns/PatternPhoneWorkspaceNotice.astro";
import GaugeInput from "../../../components/wizards/GaugeInput.astro";
import UnitToggle from "../../../components/wizards/UnitToggle.astro";
import FloatingInput from "../../../components/lego/FloatingInput.astro";
import WarningBox from "../../../components/ui/WarningBox.astro";
import hatSizingRows from "../../../data/sizing_hats.json";
import { roundFinishedHatSizeFromHead } from "../../../lib/patterns/hat/hatMath";

import "../../../styles/sleeveless-express-builder-cards.css";
import "../../../styles/sleeveless-express-wizard-layout.css";
import "../../../styles/express-size-selection.css";
import "../../../styles/patterns/hat-builder.css";

function formatFinishedInchesForLabel(n: number): string {
  if (!Number.isFinite(n)) return "";
  const rounded = Math.round(n * 2) / 2;
  return rounded % 1 === 0 ? String(rounded) : rounded.toFixed(1);
}

const INCH_TO_CM_DISPLAY = 2.54;

function formatHeadInchTokenForDisplay(
  cleanInchPart: string,
  displayUnit: "inches" | "cm",
): string {
  if (displayUnit === "inches") return cleanInchPart;
  const parts = cleanInchPart.split(/[\u2013\-]/).map((s) => s.trim()).filter(Boolean);
  if (parts.length === 0) return cleanInchPart;
  const nums = parts.map((p) => {
    const n = parseFloat(p);
    if (!Number.isFinite(n)) return p;
    return String(Math.round(n * INCH_TO_CM_DISPLAY));
  });
  return nums.length === 1 ? nums[0] : nums.join("–");
}

function hatSizeDisplayName(row: (typeof hatSizingRows)[number]): string {
  const ext = row.extended_label || row.label || row.size;
  const withoutHead = ext.replace(/\s*\([^)]*\bhead\b[^)]*\)\s*$/i, "").trim();
  return withoutHead || row.label || row.size;
}

function hatFitsClause(
  row: (typeof hatSizingRows)[number],
  displayUnit: "inches" | "cm" = "inches",
): string | null {
  const ext = row.extended_label || row.label || "";
  const paren = ext.match(/\(([^)]+)\)\s*$/);
  if (paren) {
    const inner = paren[1].trim();
    if (/\bhead\b/i.test(inner)) {
      let headPart = inner.replace(/\s*head\s*$/i, "").trim();
      headPart = headPart.replace(/^approx\.\s*/i, "").trim();
      const clean = headPart.replace(/["″]/g, "").trim();
      if (displayUnit === "inches") {
        return `fits ~${clean}" head`;
      }
      const display = formatHeadInchTokenForDisplay(clean, displayUnit);
      return `fits ~${display} cm head`;
    }
    if (/\blbs\b|\bmonth\b|\bmonths\b|\byear\b|\byears\b/i.test(inner)) {
      return null;
    }
    return null;
  }
  const head = Number(row.circumference);
  if (Number.isFinite(head) && head > 0) {
    if (displayUnit === "inches") {
      const clean = String(head).replace(/["″]/g, "").trim();
      return `fits ~${clean}" head`;
    }
    const cm = Math.round(head * INCH_TO_CM_DISPLAY);
    return `fits ~${cm} cm head`;
  }
  return null;
}

function buildHatSizeOptionLabel(
  row: (typeof hatSizingRows)[number],
  finishedInches: number,
  displayUnit: "inches" | "cm" = "inches",
): string {
  const name = hatSizeDisplayName(row);
  const finStr =
    displayUnit === "inches"
      ? `${formatFinishedInchesForLabel(finishedInches)}"`
      : `${Math.round(finishedInches * INCH_TO_CM_DISPLAY)} cm`;
  const fits = hatFitsClause(row, displayUnit);
  return fits
    ? `${name} — ${finStr} finished (${fits})`
    : `${name} — ${finStr} finished`;
}

const hatSizingBuilderRows = hatSizingRows.map((row) => {
  const finishedSizeInches = roundFinishedHatSizeFromHead(Number(row.circumference));
  return {
    ...row,
    finishedSizeInches,
    optionLabel: buildHatSizeOptionLabel(row, finishedSizeInches),
  };
});

const hatZeroBodyRowsWarningMessage =
  "Your current settings don't leave any room for the body of the hat. Try increasing the finished hat length, reducing the brim height, or choosing a shallower crown style.";

const expressNavSteps = [
  { step: 1, label: "Size" },
  { step: 2, label: "Length" },
  { step: 3, label: "Style" },
  { step: 4, label: "Gauge" },
] as const;
---

<Layout
  title="Hat Pattern Builder"
  description="Create a custom machine knit hat pattern with your gauge, size, brim, and crown shaping."
  patternWorkspace={true}
>
  <main
    class="express-page wizard-page sleeveless-express-page hat-builder-page"
    data-express-page="hat-builder"
    data-express-review-href="/patterns/hat/pattern/?generated=1"
  >
    <div id="express-pattern-top" class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternPhoneWorkspaceNotice />
        <div class="sg-tab-build">
          <div class="sg-builder-nav-row express-builder-nav-row no-print">
            <nav class="express-step-nav sg-builder-nav" aria-label="Hat pattern steps">
              <ol class="express-step-nav__list sg-builder-nav__list" role="list">
                {
                  expressNavSteps.map((s, i) => (
                    <li class:list={["express-step-nav__item", "sg-builder-nav__item", { active: s.step === 1 }]}>
                      <button
                        type="button"
                        class:list={[
                          "express-step-nav__btn",
                          "sg-builder-nav__link",
                          {
                            "is-current": s.step === 1,
                            "is-upcoming": s.step > 1,
                          },
                        ]}
                        data-pill-step={s.step}
                        data-pill-label={s.label}
                        aria-current={s.step === 1 ? "page" : undefined}
                        aria-disabled={s.step > 1 ? "true" : undefined}
                        title={s.step > 1 ? "Finish the previous step to continue." : undefined}
                      >
                        <span class="express-step-nav__track">
                          <span
                            class:list={[
                              "express-step-nav__seg",
                              "express-step-nav__seg--before",
                              { "express-step-nav__seg--empty": i === 0 },
                            ]}
                            aria-hidden="true"
                          />
                          <span class="express-step-nav__circle">
                            <span class="express-step-nav__num">{s.step}</span>
                            <span class="express-pill__check" aria-hidden="true">
                              ✓
                            </span>
                          </span>
                          <span
                            class:list={[
                              "express-step-nav__seg",
                              "express-step-nav__seg--after",
                              { "express-step-nav__seg--empty": i === expressNavSteps.length - 1 },
                            ]}
                            aria-hidden="true"
                          />
                        </span>
                        <span class="express-step-nav__label">{s.label}</span>
                      </button>
                    </li>
                  ))
                }
              </ol>
            </nav>
          </div>

          <header class="pattern-header page-header">
            <div class="pattern-header__title-row">
              <h1 class="pattern-title">Machine Knit Hat</h1>
            </div>
            <p class="pattern-subtext">
              Choose your finished size, hat length, brim, and crown shaping. Enter your gauge and we'll generate
              ready-to-knit instructions.
            </p>
          </header>

          <div id="hat-draft-missing-banner" class="hat-draft-missing-banner no-print" hidden>
            <WarningBox
              title="Start from the builder"
              message="We couldn't find a complete hat draft to show. Choose your size, length, brim, crown, and gauge below, then review your pattern."
            />
          </div>

          <div class="express-panel">
            <div class="express-builder-root" data-express-builder>
              <div class="express-builder-toolbar no-print">
                <button type="button" id="express-start-over-btn" class="btn btn-outline-secondary btn-sm">
                  Start over
                </button>
              </div>
              <div class="express-builder-units no-print">
                <UnitToggle id="hat" />
              </div>

              <form id="hat-builder-form" autocomplete="off" novalidate>
                <div class="express-accordions" id="express-accordions">
                  <!-- Step 1 — Size -->
                  <section
                    class="express-acc express-acc--open"
                    data-express-step="1"
                    data-express-field="size"
                  >
                    <div
                      class="express-acc__header"
                      data-express-header
                      role="button"
                      tabindex="0"
                      aria-expanded="true"
                      aria-controls="express-acc-panel-1"
                      id="express-acc-label-1"
                    >
                      <button
                        type="button"
                        class="express-acc__chevron"
                        data-express-chevron
                        aria-label="Toggle hat size choices"
                        tabindex="-1"
                      >
                        ▾
                      </button>
                      <div class="express-acc__header-main">
                        <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                        <h2 class="express-acc__title" id="express-step-1-title">Choose hat size</h2>
                        <span class="express-acc__value" data-express-summary="size"></span>
                      </div>
                    </div>
                    <div
                      class="express-acc__body"
                      id="express-acc-panel-1"
                      role="region"
                      aria-labelledby="express-step-1-title"
                    >
                      <div id="standard-size">
                        <div class="input-group">
                          <div class="hat-select-wrap">
                            <span class="hat-select-wrap__check" aria-hidden="true"></span>
                            <select
                              id="hat-size"
                              data-testid="select-hat-size"
                              aria-label="Choose a finished hat size"
                              data-sizes-source="ssr"
                              autocomplete="off"
                            >
                              <option value="" disabled selected hidden>
                                Choose a finished hat size...
                              </option>
                              {
                                hatSizingBuilderRows.map((row) => (
                                  <option value={row.size} data-finished-size-inches={row.finishedSizeInches}>
                                    {row.optionLabel}
                                  </option>
                                ))
                              }
                              <option value="custom">✏️ Enter your own finished hat size</option>
                            </select>
                          </div>
                        </div>
                      </div>

                      <div id="custom-size" class="hat-builder-custom-subfield" style="display: none;">
                        <div class="input-group">
                          <FloatingInput
                            id="custom-circumference"
                            type="number"
                            step={0.25}
                            label="Custom Finished Hat Size (inches)"
                            placeholder=" "
                            testId="input-custom-circumference"
                          />
                        </div>
                      </div>
                    </div>
                  </section>

                  <!-- Step 2 — Length -->
                  <section class="express-acc" data-express-step="2" data-express-field="fit">
                    <div
                      class="express-acc__header"
                      data-express-header
                      role="button"
                      tabindex="-1"
                      aria-expanded="false"
                      aria-controls="express-acc-panel-2"
                      id="express-acc-label-2"
                    >
                      <button
                        type="button"
                        class="express-acc__chevron"
                        data-express-chevron
                        aria-label="Toggle hat length choices"
                        tabindex="-1"
                      >
                        ▾
                      </button>
                      <div class="express-acc__header-main">
                        <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                        <h2 class="express-acc__title" id="express-step-2-title">Finished hat length</h2>
                        <span class="express-acc__value" data-express-summary="fit"></span>
                      </div>
                    </div>
                    <div
                      class="express-acc__body"
                      id="express-acc-panel-2"
                      role="region"
                      aria-labelledby="express-step-2-title"
                      hidden
                    >
                      <p class="express-style-sublabel" id="hat-length-sublabel">
                        Bottom of brim to top of crown
                      </p>
                      <div class="input-group">
                        <div class="hat-select-wrap hat-length-picker-wrap">
                          <select
                            id="fit"
                            class="hat-length-picker__native"
                            data-testid="select-fit"
                            aria-label="Finished hat length"
                            autocomplete="off"
                            tabindex="-1"
                          >
                            <option value="" disabled selected hidden>Enter Finished Hat Length...</option>
                            <option value="beanie">Beanie (7" finished hat length)</option>
                            <option value="watchcap">Classic (8.5" finished hat length)</option>
                            <option value="slouchy">Slouchy (10" finished hat length)</option>
                            <option value="relaxed">Relaxed (9" finished hat length)</option>
                            <option value="custom">✏️ Enter your own finished hat length</option>
                          </select>
                          <div class="hat-length-picker__flex-row">
                            <span class="hat-select-wrap__check" aria-hidden="true"></span>
                            <div class="hat-length-picker">
                              <button
                                type="button"
                                class="hat-length-picker__summary"
                                id="hat-length-summary"
                                aria-expanded="false"
                                aria-controls="hat-length-panel"
                                aria-haspopup="true"
                              >
                                <span id="hat-length-summary-text" class="hat-length-picker__summary-text"></span>
                              </button>
                              <div id="hat-length-panel" class="hat-length-picker__panel" hidden>
                                <div
                                  class="hat-length-picker__grid hat-length-picker__grid--four"
                                  role="group"
                                  aria-labelledby="hat-length-sublabel"
                                >
                                  <button
                                    type="button"
                                    class="hat-length-picker__option"
                                    data-fit-value="beanie"
                                    aria-pressed="false"
                                  >
                                    <img
                                      src="/images/hats/length-beanie.png"
                                      alt=""
                                      class="hat-length-picker__img"
                                      width="120"
                                      height="120"
                                      loading="lazy"
                                      decoding="async"
                                    />
                                    <span class="hat-length-picker__option-label">Beanie</span>
                                  </button>
                                  <button
                                    type="button"
                                    class="hat-length-picker__option"
                                    data-fit-value="watchcap"
                                    aria-pressed="false"
                                  >
                                    <img
                                      src="/images/hats/length-classic.png"
                                      alt=""
                                      class="hat-length-picker__img"
                                      width="120"
                                      height="120"
                                      loading="lazy"
                                      decoding="async"
                                    />
                                    <span class="hat-length-picker__option-label">Classic</span>
                                  </button>
                                  <button
                                    type="button"
                                    class="hat-length-picker__option"
                                    data-fit-value="slouchy"
                                    aria-pressed="false"
                                  >
                                    <img
                                      src="/images/hats/length-slouchy.png"
                                      alt=""
                                      class="hat-length-picker__img"
                                      width="120"
                                      height="120"
                                      loading="lazy"
                                      decoding="async"
                                    />
                                    <span class="hat-length-picker__option-label">Slouchy</span>
                                  </button>
                                  <button
                                    type="button"
                                    class="hat-length-picker__option"
                                    data-fit-value="relaxed"
                                    aria-pressed="false"
                                  >
                                    <img
                                      src="/images/hats/length-relaxed.png"
                                      alt=""
                                      class="hat-length-picker__img"
                                      width="120"
                                      height="120"
                                      loading="lazy"
                                      decoding="async"
                                    />
                                    <span class="hat-length-picker__option-label">Relaxed</span>
                                  </button>
                                </div>
                                <button type="button" class="hat-length-picker__custom" id="hat-length-custom-btn">
                                  ✏️ Enter your own finished hat length
                                </button>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div id="custom-length-div" class="hat-builder-custom-subfield" style="display: none;">
                        <div class="input-group">
                          <FloatingInput
                            id="custom-hat-length"
                            type="number"
                            step={0.25}
                            label="Finished Hat Length (bottom of brim to top of crown) (inches)"
                            placeholder=" "
                            testId="input-custom-hat-length"
                          />
                          <small class="helper-text">
                            Enter the finished hat length as it will be worn. We'll calculate the crown shaping and any
                            brim adjustments for you.
                          </small>
                        </div>
                      </div>

                      <div id="hat-zero-body-warning" class="no-print" hidden>
                        <WarningBox title="Notice" message={hatZeroBodyRowsWarningMessage} />
                      </div>
                    </div>
                  </section>

                  <!-- Step 3 — Style (brim + crown) -->
                  <section class="express-acc" data-express-step="3" data-express-field="style">
                    <div
                      class="express-acc__header"
                      data-express-header
                      role="button"
                      tabindex="-1"
                      aria-expanded="false"
                      aria-controls="express-acc-panel-3"
                      id="express-acc-label-3"
                    >
                      <button
                        type="button"
                        class="express-acc__chevron"
                        data-express-chevron
                        aria-label="Toggle hat style choices"
                        tabindex="-1"
                      >
                        ▾
                      </button>
                      <div class="express-acc__header-main">
                        <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                        <h2 class="express-acc__title" id="express-step-3-title">Brim &amp; crown</h2>
                        <span class="express-acc__value" data-express-summary="style"></span>
                      </div>
                    </div>
                    <div
                      class="express-acc__body"
                      id="express-acc-panel-3"
                      role="region"
                      aria-labelledby="express-step-3-title"
                      hidden
                    >
                      <div class="express-style-group">
                        <p class="express-style-sublabel" id="hat-brim-sublabel">Brim type</p>
                        <div class="input-group">
                          <div class="hat-select-wrap">
                            <span class="hat-select-wrap__check" aria-hidden="true"></span>
                            <select
                              id="brimType"
                              class="hat-length-picker__native"
                              data-testid="select-brim-type"
                              aria-label="Brim Type"
                              autocomplete="off"
                            >
                              <option value="" disabled selected hidden>Choose brim type</option>
                              <option value="single">Single Layer</option>
                              <option value="folded">Folded Hem</option>
                            </select>
                            <div class="hat-length-picker__flex-row">
                              <div class="hat-length-picker">
                                <button
                                  type="button"
                                  class="hat-length-picker__summary"
                                  id="brim-type-summary"
                                  aria-expanded="false"
                                  aria-controls="brim-type-panel"
                                  aria-haspopup="true"
                                >
                                  <span id="brim-type-summary-text" class="hat-length-picker__summary-text"></span>
                                </button>
                                <div id="brim-type-panel" class="hat-length-picker__panel" hidden>
                                  <div
                                    class="hat-length-picker__grid hat-brim-picker__grid"
                                    role="group"
                                    aria-labelledby="hat-brim-sublabel"
                                  >
                                    <button
                                      type="button"
                                      class="hat-length-picker__option"
                                      data-brim-type-value="single"
                                      aria-pressed="false"
                                    >
                                      <img
                                        src="/images/hats/single-layer.png"
                                        alt=""
                                        class="hat-length-picker__img hat-brim-picker__img"
                                        width="120"
                                        height="120"
                                        loading="lazy"
                                        decoding="async"
                                      />
                                      <span class="hat-length-picker__option-label">Single Layer</span>
                                    </button>
                                    <button
                                      type="button"
                                      class="hat-length-picker__option"
                                      data-brim-type-value="folded"
                                      aria-pressed="false"
                                    >
                                      <img
                                        src="/images/hats/folded-hem.png"
                                        alt=""
                                        class="hat-length-picker__img hat-brim-picker__img"
                                        width="120"
                                        height="120"
                                        loading="lazy"
                                        decoding="async"
                                      />
                                      <span class="hat-length-picker__option-label">Folded Hem</span>
                                    </button>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="express-style-group">
                        <div class="input-group">
                          <FloatingInput
                            id="brimLength"
                            name="brimLength"
                            type="number"
                            step={0.25}
                            label="Visible Brim Height (when worn)"
                            placeholder=" "
                            testId="input-brim-length"
                          />
                          <small class="helper-text">We'll automatically adjust the rows for the fold.</small>
                        </div>
                      </div>

                      <div class="express-style-group">
                        <div class="hat-field hat-field--crown">
                          <div class="hat-field__label-row">
                            <label class="hat-field__label" for="crown">Crown Shaping</label>
                            <span class="hat-field__help-slot">
                              <button
                                type="button"
                                class="crown-help-trigger"
                                id="crown-help-open"
                                aria-label="View crown shaping examples"
                              >
                                ?
                              </button>
                            </span>
                          </div>
                          <div class="hat-select-wrap">
                            <span class="hat-select-wrap__check" aria-hidden="true"></span>
                            <select
                              id="crown"
                              class="hat-length-picker__native"
                              data-testid="select-crown"
                              autocomplete="off"
                            >
                              <option value="" disabled selected hidden>Choose crown shaping</option>
                              <option value="gathered">Gathered (cinched top)</option>
                              <option value="wedge-4-decrease">4-Wedge Decrease</option>
                              <option value="spiral">Spiral Crown (Smooth, Continuous)</option>
                            </select>
                            <div class="hat-length-picker__flex-row">
                              <div class="hat-length-picker">
                                <button
                                  type="button"
                                  class="hat-length-picker__summary"
                                  id="crown-summary"
                                  aria-expanded="false"
                                  aria-controls="crown-panel"
                                  aria-haspopup="true"
                                >
                                  <span id="crown-summary-text" class="hat-length-picker__summary-text"></span>
                                </button>
                                <div id="crown-panel" class="hat-length-picker__panel" hidden>
                                  <div class="hat-length-picker__grid" role="group" aria-label="Crown shaping">
                                    <button
                                      type="button"
                                      class="hat-length-picker__option"
                                      data-crown-value="gathered"
                                      aria-pressed="false"
                                    >
                                      <img
                                        src="/images/hats/gathered.svg"
                                        alt=""
                                        class="hat-length-picker__img hat-crown-picker__img"
                                        width="120"
                                        height="120"
                                        loading="lazy"
                                        decoding="async"
                                      />
                                      <span class="hat-length-picker__option-label">Gathered</span>
                                    </button>
                                    <button
                                      type="button"
                                      class="hat-length-picker__option"
                                      data-crown-value="wedge-4-decrease"
                                      aria-pressed="false"
                                    >
                                      <img
                                        src="/images/hats/wedge.svg"
                                        alt=""
                                        class="hat-length-picker__img hat-crown-picker__img"
                                        width="120"
                                        height="120"
                                        loading="lazy"
                                        decoding="async"
                                      />
                                      <span class="hat-length-picker__option-label">Wedge</span>
                                    </button>
                                    <button
                                      type="button"
                                      class="hat-length-picker__option"
                                      data-crown-value="spiral"
                                      aria-pressed="false"
                                    >
                                      <img
                                        src="/images/hats/spiral.svg"
                                        alt=""
                                        class="hat-length-picker__img hat-crown-picker__img"
                                        width="120"
                                        height="120"
                                        loading="lazy"
                                        decoding="async"
                                      />
                                      <span class="hat-length-picker__option-label">Spiral</span>
                                    </button>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </section>

                  <!-- Step 4 — Gauge -->
                  <section
                    class="express-acc scroll-mt-[96px]"
                    id="express-gauge-section"
                    data-express-step="4"
                    data-express-field="gauge"
                  >
                    <div
                      class="express-acc__header"
                      data-express-header
                      role="button"
                      tabindex="-1"
                      aria-expanded="false"
                      aria-controls="express-acc-panel-4"
                      id="express-acc-label-4"
                    >
                      <button
                        type="button"
                        class="express-acc__chevron"
                        data-express-chevron
                        aria-label="Toggle gauge entry"
                        tabindex="-1"
                      >
                        ▾
                      </button>
                      <div class="express-acc__header-main">
                        <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                        <h2 class="express-acc__title" id="express-step-4-title">Enter your gauge</h2>
                        <span class="express-acc__value" data-express-summary="gauge"></span>
                      </div>
                    </div>
                    <div
                      class="express-acc__body"
                      id="express-acc-panel-4"
                      role="region"
                      aria-labelledby="express-step-4-title"
                      hidden
                    >
                      <GaugeInput id="hat" showTitle={false} showToggle={false} toggleId="hat" showGaugeSubLabel={false} />
                    </div>
                    <div id="express-generate-wrap" class="express-generate-wrap no-print" hidden>
                      <button type="button" id="express-generate" class="btn btn-primary">
                        Review My Pattern
                      </button>
                    </div>
                  </section>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <div id="crown-help-overlay" class="crown-help-overlay" hidden aria-hidden="true">
    <div class="crown-help-modal" role="dialog" aria-modal="true" aria-labelledby="crown-help-title">
      <button type="button" class="crown-help-close" id="crown-help-close" aria-label="Close crown shaping help">
        ×
      </button>
      <h2 id="crown-help-title">Crown Shaping</h2>
      <p>Choose how the top of the hat is closed and shaped.</p>
      <img
        src="/images/glossary/hat-crown-styles.webp"
        alt="Hat crown shaping examples: wedge, spiral, and gathered"
        class="crown-help-image"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</Layout>

