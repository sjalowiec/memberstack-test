---
import Layout from "../../../../layouts/Layout.astro";
import SleevelessPatternMemberGate from "../../../../components/patterns/SleevelessPatternMemberGate.astro";
import PatternBuilderMyPatternsLink from "../../../../components/patterns/PatternBuilderMyPatternsLink.astro";
import PatternPhoneWorkspaceNotice from "../../../../components/patterns/PatternPhoneWorkspaceNotice.astro";
import { SIDEWAYS_CARDIGAN_SUMMARY_EDIT_FROM_PATTERN_HREF } from "../../../../lib/patterns/sidewaysCardiganPatternNavigation";

import "../../../../styles/sleeveless-express-wizard-layout.css";
import "../../../../styles/ns-shaping-chart.css";
import "../../../../styles/glossary-tooltip.css";
import "../../../../styles/patterns/sleeveless-pattern-shared.css";
import "../../../../styles/patterns/pattern-app-shell.css";
---

<Layout
  title="Sideways V-Neck Sweater Pattern | Knit it Now"
  description="Sideways-knit V-neck sweater pattern workspace (body calculations)."
  patternWorkspace={true}
>
  <SleevelessPatternMemberGate>
  <main
    class="wizard-page sleeveless-pattern-page pattern-app-shell sideways-cardigan-pattern-page"
    data-express-construction="sideways-cardigan"
  >
    <div class="wizard-container scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternPhoneWorkspaceNotice />
        <div class="pattern-action-bar no-print">
          <div class="pattern-action-bar__group pattern-action-bar__group--start">
            <PatternBuilderMyPatternsLink />
          </div>
          <div class="pattern-action-bar__group pattern-action-bar__group--end">
            <a
              href={SIDEWAYS_CARDIGAN_SUMMARY_EDIT_FROM_PATTERN_HREF}
              class="sleeveless-pattern-edit-action no-print"
              data-sideways-edit-open
              data-testid="button-edit-pattern"
            >
              <i class="fas fa-pen" aria-hidden="true"></i> Edit Pattern
            </a>
          </div>
        </div>
        <header class="pattern-header page-header">
          <div class="pattern-header__title-row">
            <h1 class="pattern-title">Sideways V-Neck Sweater</h1>
          </div>
          <p class="pattern-subtext">
            A V-neck sweater knitted sideways in one piece, with drop-shoulder armholes and a
            straight back neck.
          </p>
        </header>

        <p class="sg-fit-size-copy" data-sideways-calc-missing hidden>
          Complete the Sideways V-Neck Sweater builder to see the pattern numbers.
        </p>
        <p class="sg-fit-size-copy" data-sideways-calc-error hidden role="alert"></p>
        <section class="sideways-calc-host" data-sideways-calc-host hidden>
          <div id="pattern-content" data-sideways-body-sequence></div>
          <section data-sideways-sleeve-host hidden>
            <h2 class="sg-pattern-section-title">Sleeve sequence</h2>
            <p class="sg-fit-size-copy" data-sideways-sleeve-error hidden role="alert"></p>
            <div data-sideways-sleeve-sequence></div>
          </section>
        </section>
        <p>
          <a href="/patterns/sideways-cardigan/builder">Back to builder</a>
        </p>
      </div>
    </div>
  </main>
  </SleevelessPatternMemberGate>
</Layout>

<style>
  .sideways-calc-host {
    margin: 1rem 0 1.5rem;
  }
  .sideways-sleeve-sequence {
    margin: 0.75rem 0 1.25rem;
    padding-left: 1.4rem;
  }
  .sideways-sleeve-sequence li {
    margin: 0.35rem 0;
  }
  .pattern-action-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(82, 104, 45, 0.12);
  }
  .pattern-action-bar__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .pattern-action-bar__group--end {
    justify-content: flex-end;
  }
</style>

<script>
  import "/src/scripts/sideways-cardigan-pattern-page.ts";
</script>
