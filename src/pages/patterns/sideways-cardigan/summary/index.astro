---
/**
 * Sideways V-Neck Summary/Edit — shared PatternSummaryEditWorkspace.
 * After the builder (`?generated=1`): review measurements, then Update Pattern.
 * From Edit Pattern (`?edit=1`): same workspace; Cancel returns to knitting instructions.
 */
import Layout from "../../../../layouts/Layout.astro";
import SleevelessPatternMemberGate from "../../../../components/patterns/SleevelessPatternMemberGate.astro";
import PatternPhoneWorkspaceNotice from "../../../../components/patterns/PatternPhoneWorkspaceNotice.astro";
import PatternSummaryEditWorkspace from "../../../../components/patterns/PatternSummaryEditWorkspace.astro";
import PatternSummaryDiagramStage from "../../../../components/patterns/PatternSummaryDiagramStage.astro";
import PatternSummaryMeasurementChip from "../../../../components/patterns/PatternSummaryMeasurementChip.astro";
import { SIDEWAYS_CARDIGAN_SUMMARY_MEASUREMENT_FIELDS } from "../../../../lib/patterns/sidewaysCardiganSummaryEdit";
import {
  SIDEWAYS_CARDIGAN_PATTERN_BUILDER_HREF,
  SIDEWAYS_CARDIGAN_SUMMARY_CANCEL_FROM_EDIT_LABEL,
  SIDEWAYS_CARDIGAN_SUMMARY_HINT_FROM_EDIT,
  SIDEWAYS_CARDIGAN_SUMMARY_PRIMARY_LABEL,
} from "../../../../lib/patterns/sidewaysCardiganPatternNavigation";

import "../../../../styles/wizard.css";
import "../../../../styles/patterns/sleeveless-pattern-shared.css";
import "../../../../styles/patterns/pattern-app-shell.css";
import "../../../../styles/patterns/pattern-editable-pencil.css";
import "../../../../styles/patterns/sweater-edit-measurement-diagram.css";
---

<Layout
  title="Edit Sideways V-Neck Sweater | Knit it Now"
  description="Review and edit Sideways V-Neck Sweater measurements before knitting."
  bodyClass="pattern-print-global-footer"
  patternWorkspace={true}
>
  <SleevelessPatternMemberGate>
  <main
    class="wizard-page sleeveless-pattern-page sleeveless-workspace-subpage pattern-app-shell sideways-summary-page"
    data-sideways-summary-page
    data-express-construction="sideways-cardigan"
    data-testid="sideways-summary-edit-page"
  >
    <div class="wizard-container">
      <div class="calculator-card hat-builder-inputs">
        <PatternPhoneWorkspaceNotice />
        <div class="hat-pattern-empty" data-sideways-summary-empty role="status" hidden>
          <h1 class="hat-pattern-empty__title">Sideways V-Neck Sweater</h1>
          <p class="hat-pattern-empty__message" data-sideways-summary-empty-message>
            Complete the Sideways V-Neck Sweater builder to review your measurements.
          </p>
          <a
            href={SIDEWAYS_CARDIGAN_PATTERN_BUILDER_HREF}
            class="kbm-btn kbm-btn-accent"
            data-testid="sideways-summary-empty-cta"
          >
            Go to builder
          </a>
        </div>

        <div
          class="sideways-summary-workspace"
          data-sideways-summary-workspace
          data-testid="sideways-summary-workspace"
          data-sideways-summary-entry="from-finished-pattern"
          hidden
        >
          <PatternSummaryEditWorkspace
            measurePaneAttr="data-sideways-measure-pane"
            actionsAttr="data-sideways-edit-actions"
          >
            <Fragment slot="quick">
              <section class="sl-edit-section sl-edit-units-section" aria-labelledby="sideways-edit-units-heading">
                <h3 class="sl-edit-section__title" id="sideways-edit-units-heading">Units</h3>
                <div
                  class="sl-edit-units-toggle"
                  role="group"
                  aria-labelledby="sideways-edit-units-heading"
                  data-sideways-edit-units
                >
                  <button
                    type="button"
                    class="sl-edit-unit-btn is-active"
                    data-sideways-edit-unit="in"
                    aria-pressed="true"
                  >
                    Inches
                  </button>
                  <button
                    type="button"
                    class="sl-edit-unit-btn"
                    data-sideways-edit-unit="cm"
                    aria-pressed="false"
                  >
                    Centimeters
                  </button>
                </div>
                <p class="sl-edit-ease">
                  Switch how measurements are shown. Your pattern's measurements don't change.
                </p>
              </section>

              <section class="sl-edit-section" aria-labelledby="sideways-edit-setup-heading">
                <h3 class="sl-edit-section__title" id="sideways-edit-setup-heading">Pattern choices</h3>
                <p class="sl-edit-ease">
                  Cardigan/Pullover, fit, size, sleeve length, gauge, and machine stay as you set them
                  in the builder.
                </p>
                <dl class="print-summary-dl print-summary-dl--inline" data-sideways-edit-choices></dl>
              </section>
            </Fragment>

            <Fragment slot="heading">Measurements</Fragment>
            <Fragment slot="notes">
              <p class="sl-edit-error-note" data-sl-edit-errors hidden role="alert"></p>
            </Fragment>
            <Fragment slot="actions">
              <button
                type="button"
                class="sl-edit-btn sl-edit-btn--ghost"
                data-sideways-edit-cancel
                data-testid="button-edit-cancel"
              >
                {SIDEWAYS_CARDIGAN_SUMMARY_CANCEL_FROM_EDIT_LABEL}
              </button>
              <button
                type="button"
                class="sl-edit-btn sl-edit-btn--primary"
                data-sideways-edit-update
                data-testid="button-edit-update"
              >
                {SIDEWAYS_CARDIGAN_SUMMARY_PRIMARY_LABEL}
              </button>
            </Fragment>
            <span slot="hint" data-sideways-summary-hint>
              {SIDEWAYS_CARDIGAN_SUMMARY_HINT_FROM_EDIT}
            </span>
            <Fragment slot="diagram">
              <PatternSummaryDiagramStage
                stageTestId="sideways-edit-diagram-area"
                diagramAttr="data-sideways-edit-diagram"
                overlayAttr="data-sideways-edit-overlay"
                stageInnerAttr="data-sideways-edit-stage"
              >
                {SIDEWAYS_CARDIGAN_SUMMARY_MEASUREMENT_FIELDS.map((field) => (
                  <PatternSummaryMeasurementChip field={field} />
                ))}
              </PatternSummaryDiagramStage>
            </Fragment>
          </PatternSummaryEditWorkspace>
        </div>
      </div>
    </div>
  </main>
  </SleevelessPatternMemberGate>
</Layout>

<style>
  .hat-pattern-empty {
    max-width: 36rem;
    margin: 1.5rem auto;
    padding: 1.5rem 1rem;
    text-align: center;
  }
  .hat-pattern-empty__title {
    margin: 0 0 0.65rem;
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--kbm-green, #52682d);
  }
  .hat-pattern-empty__message {
    margin: 0 0 1.1rem;
    font-size: 0.98rem;
    line-height: 1.5;
    color: #4b5563;
  }
  .sideways-summary-workspace[hidden] {
    display: none;
  }
  .sideways-summary-page .print-summary-dl--inline {
    display: grid;
    gap: 0.35rem 1.25rem;
    margin: 0.75rem 0 0;
  }
  .sideways-summary-page .print-summary-dl__pair {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: 0.25rem 1rem;
  }
  .sideways-summary-page .print-summary-dl__pair dt {
    font-weight: 600;
  }
  .sideways-summary-page .print-summary-dl__pair dd {
    margin: 0;
  }
</style>

<script>
  import "/src/scripts/sideways-cardigan-summary-page.ts";
</script>
