---
/**
 * DEV-review landing page. Do not prerender: production hosts must keep hitting
 * middleware so `/patterns/sideways-cardigan` stays blocked with the builder.
 */
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import PatternBuilderLandingPage from "../../../components/patterns/PatternBuilderLandingPage.astro";
import { SIDEWAYS_KNIT_SWEATER_PATTERN_BUILDER_LANDING } from "../../../lib/patterns/sidewaysKnitSweaterPatternLanding";

const landing = SIDEWAYS_KNIT_SWEATER_PATTERN_BUILDER_LANDING;
---

<Layout
  title={landing.seo.title}
  description={landing.seo.description}
  bodyClass="page--tight-header"
>
  <Fragment slot="head">
    <link rel="canonical" href={landing.seo.canonicalUrl} />
  </Fragment>

  <PatternBuilderLandingPage content={landing} />
</Layout>
