---
import Layout from "../../layouts/Layout.astro";
import ActionBar from "../../components/wizards/ActionBar.astro";
import PatternPrintFooter from "../../components/common/PatternPrintFooter.astro";
import PatternPrintPersonalization from "../../components/common/PatternPrintPersonalization.astro";
import WizardBackLink from "../../components/wizards/WizardBackLink.astro";
import GaugeInput from "../../components/wizards/GaugeInput.astro";
import UnitToggle from "../../components/wizards/UnitToggle.astro";
import PatternComments from "../../components/patterns/PatternComments.astro";
import NeedleCheckDrawer from "../../components/patterns/NeedleCheckDrawer.astro";
import PatternHeaderImage from "../../components/patterns/PatternHeaderImage.astro";
import WarningBox from "../../components/ui/WarningBox.astro";
import GlossaryTooltip from "../../components/common/GlossaryTooltip.astro";
import "../../styles/wizard.css";
import "../../styles/tools/yarn-drawer-presentation.css";

const patternPersistWarning =
  "Your pattern will not be saved on this site. Please be sure to download and save your PDF — once you leave this page, your pattern will be gone.";
---

<Layout 
  title="Custom Blanket Builder | Knit it Now" 
  description="Design any blanket for your machine. Check your width, adjust your gauge, and plan panels — all before you knit."
  bodyClass="pattern-print-global-footer">

<PatternPrintFooter />

<style>
.wizard-page {
  padding-top: 0;
  padding-bottom: 3rem;
  min-height: 100vh;
  background: var(--page-bg);
}

.page-header {
  max-width: 800px;
  margin: 0 auto 2rem;
  padding: 0 1rem;
}

.page-header-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 0.75rem;
  flex-wrap: wrap;
}

@media (max-width: 640px) {
  .page-header-title {
    flex-direction: column;
    gap: 0.75rem;
  }
}

.page-header h1 {
  color: var(--kbm-green);
  font-size: 2rem;
  font-weight: 700;
  margin: 0;
}

.page-header p {
  color: #6b7280;
  font-size: 1.05rem;
  line-height: 1.6;
  text-align: center;
}

.video-button {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 1rem;
  background: #e5e7eb;
  color: #374151;
  text-decoration: none;
  font-weight: 600;
  border-radius: 6px;
  transition: all 0.2s;
  border: 1px solid #d1d5db;
  cursor: pointer;
  font-size: 0.9rem;
  white-space: nowrap;
}

.video-button:hover {
  background: #d1d5db;
  transform: translateY(-1px);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.wizard-container {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 1rem 120px 1rem;
}

.calculator-card {
  background: white;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.needle-check__content {
  padding: 14px 16px 16px;
  background: #fafafa;
}

.needle-check .needle-count {
  margin: 0 0 0.15rem;
  font-size: 28px;
  font-weight: 600;
  color: #c2644e;
  line-height: 1.2;
}

.needle-check .needle-count #needle-count-value {
  font-size: 36px;
  font-weight: 700;
}

.needle-check__size-context {
  margin: 0 0 0.65rem;
  font-size: 0.8125rem;
  font-weight: 400;
  color: #9ca3af;
  line-height: 1.35;
  min-height: 0;
}

.needle-check__size-context:empty {
  margin-bottom: 0;
}

.needle-check__content > p:not(.needle-count):not(.needle-check__size-context) {
  margin: 0 0 1rem;
  color: #6b7280;
  font-size: 0.95rem;
  line-height: 1.55;
}

.needle-check__content .kbm-btn {
  margin-bottom: 0.75rem;
}

.needle-tip {
  margin: 0;
  padding: 0.65rem 0.75rem;
  font-size: 0.9rem;
  line-height: 1.5;
  color: #4b5563;
  background: #f3f4f6;
  border-radius: 6px;
  border: 1px solid #e5e7eb;
}

/* Width-helper drawer body (same shell as yarn: .hat-yarn-drawer-panel) */
.diy-blanket-width-drawer-helpers {
  margin: 0 0 1rem;
}

.diy-blanket-width-drawer-helpers p {
  margin: 0 0 0.65rem;
  color: #6b7280;
  font-size: 0.95rem;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.diy-blanket-width-drawer-helpers p:last-child {
  margin-bottom: 0;
}

.diy-blanket-width-drawer-sheet .diy-blanket-panel-diagram {
  display: block;
  margin-top: 11px;
  margin-bottom: 13px;
}
.diy-blanket-width-drawer-sheet .diy-blanket-panel-diagram img {
  display: block;
  max-width: min(130px, 100%);
  width: auto;
  height: auto;
}

.hat-yarn-drawer-body .diy-blanket-width-drawer-needle {
  margin: 0 0 1rem;
  padding-top: 0.25rem;
}

.hat-yarn-drawer-body .needle-count {
  margin: 0 0 0.15rem;
  font-size: 28px;
  font-weight: 600;
  color: #c2644e;
  line-height: 1.2;
}

.hat-yarn-drawer-body .needle-count #needle-count-value {
  font-size: 36px;
  font-weight: 700;
}

.hat-yarn-drawer-body .needle-check__size-context {
  margin: 0 0 0.65rem;
  font-size: 0.8125rem;
  font-weight: 400;
  color: #9ca3af;
  line-height: 1.35;
  min-height: 0;
}

.hat-yarn-drawer-body .needle-check__size-context:empty {
  margin-bottom: 0;
}

.hat-yarn-drawer-body .diy-blanket-width-drawer-actions .kbm-btn {
  width: 100%;
  max-width: 100%;
  min-height: 48px;
  box-sizing: border-box;
}

#custom-size-section.highlight {
  outline: 2px solid var(--kbm-green);
  outline-offset: 3px;
  box-shadow: 0 0 0 4px rgba(82, 104, 45, 0.12);
  border-radius: 8px;
  transition: outline-color 0.25s ease, box-shadow 0.25s ease;
}

@media (prefers-reduced-motion: reduce) {
  #custom-size-section.highlight {
    transition: none;
  }
}

/* Custom dimensions panel sits directly under the size grid (grid stays visible). */
.diy-blanket-custom-size-fields {
  margin-top: 0.5rem;
}

.diy-blanket-custom-size-fields:not([hidden]) {
  animation: diy-blanket-custom-fields-in 0.18s ease-out;
}

@keyframes diy-blanket-custom-fields-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .diy-blanket-custom-size-fields:not([hidden]) {
    animation: none;
  }
}

.diy-blanket-custom-size-card {
  margin-top: 0;
  margin-bottom: 1.25rem;
  padding: 1rem 1.15rem 1.15rem;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fafafa;
  transition: outline-color 0.25s ease, box-shadow 0.25s ease;
}

.diy-blanket-custom-size-card--jump-highlight {
  outline: 2px solid var(--kbm-green);
  outline-offset: 3px;
  box-shadow: 0 0 0 4px rgba(82, 104, 45, 0.12);
}

@media (prefers-reduced-motion: reduce) {
  .diy-blanket-custom-size-card {
    transition: none;
  }
}

.diy-blanket-custom-size-card__title {
  margin: 0 0 0.85rem;
  font-size: 1rem;
  font-weight: 700;
  color: var(--kbm-green);
}

.section-title {
  color: var(--kbm-green);
  font-size: 1.3rem;
  font-weight: 700;
  margin: 1.5rem 0 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid #eef0ea;
}

.input-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.input-group {
  display: flex;
  flex-direction: column;
}

.input-group label {
  font-weight: 600;
  color: #374151;
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
}

.input-group input, .input-group select {
  padding: 0.75rem;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  font-size: 1rem;
  transition: all 0.2s;
}

.input-group input:focus, .input-group select:focus {
  outline: none;
  border-color: var(--kbm-green);
  box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.1);
}

.input-group input.error {
  border-color: #dc3545;
}

.input-group input.warning {
  border-color: #ffc107;
}

.validation-message {
  margin-top: 0.25rem;
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.validation-message.error {
  color: #dc3545;
}

.validation-message.warning {
  color: #ff8c00;
}


.info-box {
  background: rgba(82, 104, 45, 0.1);
  border-left: 4px solid var(--kbm-green);
  padding: 1rem;
  border-radius: 4px;
  margin-bottom: 1.5rem;
}

:global(.size-options) {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

:global(.size-option) {
  padding: 0.75rem;
  min-height: 64px;
  width: 160px;
  border: 2px solid #e5e7eb;
  border-radius: 8px;
  cursor: pointer;
  text-align: center;
  transition: all 0.25s ease;
  background: white;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 0.375rem;
}

:global(.size-option:hover) {
  border-color: var(--kbm-green);
  background: rgba(82, 104, 45, 0.05);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(82, 104, 45, 0.15);
}

:global(.size-option.selected) {
  border-color: var(--kbm-green);
  background: rgba(82, 104, 45, 0.12);
  box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.2), 0 4px 12px rgba(82, 104, 45, 0.2);
  transform: translateY(-2px);
}

:global(.size-option-name) {
  font-size: 1rem;
  color: #1f2937;
  font-weight: 700;
  line-height: 1.3;
}

:global(.size-option.selected .size-option-name) {
  color: var(--kbm-green);
}

:global(.size-option-dims) {
  font-size: 0.875rem;
  color: #6b7280;
  font-weight: 500;
}

:global(.size-option.disabled) {
  opacity: 0.5;
  cursor: not-allowed;
}

@media (max-width: 1024px) {
  :global(.size-option) {
    width: 100%;
    min-height: 56px;
  }
}

.checkbox-group {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 1rem 0;
}

.checkbox-group input[type="checkbox"] {
  width: 18px;
  height: 18px;
  cursor: pointer;
  accent-color: #52682D;
}

.checkbox-group label {
  cursor: pointer;
  font-weight: 600;
  color: #374151;
}

.results-section {
  margin-top: 2rem;
  padding-top: 2rem;
  border-top: 2px solid #eef0ea;
}

.pattern-card {
  background: #f9fafb;
  padding: 1.5rem;
  border-radius: 8px;
  margin-bottom: 1.5rem;
}

.pattern-card h3 {
  color: var(--kbm-green);
  font-size: 1.2rem;
  margin-bottom: 1rem;
}

/* Pattern tips — match hat pattern (dynamic #pattern-content HTML) */
:global(#pattern-content .pattern-tip) {
  font-size: 0.85rem;
  color: #374151;
  background: rgba(194, 97, 78, 0.07);
  border-left: 4px solid #c2614e;
  border-radius: 6px;
  padding: 0.75rem 1rem;
  margin: 0.5rem 0 0.75rem 0;
  line-height: 1.4;
}

:global(#pattern-content .pattern-tip strong) {
  font-weight: 700;
  color: #c2614e;
}

:global(#pattern-content .text-muted) {
  color: #6b7280;
  font-size: 0.875rem;
}

:global(#pattern-content h4) {
  margin: 1.15rem 0 0.5rem;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--kbm-green);
}

:global(#pattern-content .diy-blanket-pattern-steps > p) {
  margin: 0.65rem 0 0.35rem;
  line-height: 1.55;
}

:global(#pattern-content .diy-blanket-pattern-steps > p:first-child) {
  margin-top: 0;
}

:global(#pattern-content .diy-blanket-pattern-steps ul) {
  margin: 0.35rem 0 0;
  padding-left: 1.35rem;
  line-height: 1.75;
}

.highlight-box {
  background: rgba(82, 104, 45, 0.2);
  border-left: 4px solid var(--kbm-green);
  padding: 1rem;
  border-radius: 4px;
  margin-bottom: 1rem;
}

.pattern-yarn-estimate {
  background: rgba(82, 104, 45, 0.1);
  border-left: 4px solid var(--kbm-green);
  padding: 1rem 1.1rem;
  border-radius: 4px;
  margin-bottom: 1.25rem;
}

.pattern-yarn-estimate__title {
  color: var(--kbm-green);
  font-size: 1.1rem;
  font-weight: 700;
  margin: 0 0 0.65rem;
}

.pattern-yarn-estimate p {
  margin: 0 0 0.5rem;
  line-height: 1.55;
  color: #374151;
}

.pattern-yarn-estimate p:last-child {
  margin-bottom: 0;
}

.pattern-yarn-estimate__note {
  font-size: 0.875rem;
  color: #6b7280;
  margin-top: 0.5rem !important;
}

.materials-list, .instructions-list {
  margin-left: 1.5rem;
  line-height: 1.8;
}

.diagram-container {
  text-align: center;
  margin: 2rem 0;
}

.diagram-container svg {
  max-width: 500px;
  width: 100%;
  height: auto;
}

@media print {
  * {
    background: white !important;
    background-color: white !important;
  }
  
  body {
    background: white !important;
  }

  :global(.back-link) {
    display: none !important;
  }
  
  .no-print {
    display: none !important;
  }
  
  .wizard-page {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    background: white !important;
  }
  
  .page-header, .video-button {
    display: none;
  }
  
  /* Hide all input sections when printing */
  .units-toggle,
  .section-title,
  .input-grid,
  .input-group,
  .checkbox-group,
  #standard-sizes,
  #custom-size-picker-card,
  #custom-size-section,
  .needle-check,
  #yarn-calculator-section,
  .validation-message,
  .info-box {
    display: none !important;
  }
  
  /* Show only the results section */
  .results-section {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
    background: white !important;
  }

  /*
   * Shared pattern print shell (same class names as hat.astro).
   * Global print.css sets page-break-inside: avoid on .results-section / .pattern-card — override
   * inside .pattern-print-results so instructions can flow across pages; diagram uses .pattern-print-new-page.
   */
  .diy-blanket-builder-inputs #results .results-section,
  .diy-blanket-builder-inputs #results .pattern-print-results,
  .diy-blanket-builder-inputs #results .pattern-print-results .pattern-print-section--instructions,
  .diy-blanket-builder-inputs #results .pattern-print-results .pattern-card {
    break-inside: auto !important;
    page-break-inside: auto !important;
  }

  .pattern-print-new-page {
    break-before: page !important;
    page-break-before: always !important;
  }

  .pattern-print-keep-together {
    break-inside: avoid !important;
    page-break-inside: avoid !important;
  }

  .diy-blanket-builder-inputs #results .kbm-warning-box {
    display: none !important;
  }

  /* Optimize pattern display for printing */
  .calculator-card,
  .pattern-card,
  .wizard-container {
    box-shadow: none !important;
    padding: 1rem;
    background: white !important;
    border: none !important;
  }
  
  /* Keep borders but remove colored backgrounds */
  .highlight-box {
    background: white !important;
    border-left: 2px solid #333 !important;
    padding: 0.5rem !important;
  }

  .pattern-yarn-estimate {
    background: white !important;
    border-left: 2px solid #333 !important;
    padding: 0.5rem !important;
  }

  .pattern-yarn-estimate__title {
    color: #000 !important;
  }

  #pattern-content .pattern-tip {
    background: white !important;
    border-left: 3px solid #c2614e !important;
    padding: 0.5rem 0.65rem !important;
  }

  #pattern-content .pattern-tip strong {
    color: #000 !important;
  }
  
  /* Ensure diagram is visible (.pattern-print-keep-together controls page breaks for the diagram block) */
  .diagram-container,
  .diagram-container svg {
    display: block !important;
    background: white !important;
  }
}

.back-link {
  display: inline-block;
  color: #52682D;
  text-decoration: none;
  font-weight: 500;
  margin-bottom: 1.5rem;
  padding: 0.5rem 0;
  transition: color 0.2s;
}

.back-link:hover {
  color: #3d4e21;
  text-decoration: underline;
}

/* Match hat builder: Pattern tab disabled until required inputs are complete */
.diy-blanket-builder-inputs .pattern-tab-nav .tab-btn.is-disabled {
  color: #9ca3af;
  opacity: 0.55;
  cursor: not-allowed;
}

.diy-blanket-builder-inputs .pattern-tab-nav .tab-btn.is-disabled:hover,
.diy-blanket-builder-inputs .pattern-tab-nav .tab-btn.is-disabled:focus-visible {
  color: #9ca3af;
  border-bottom-color: transparent;
  opacity: 0.55;
}

.diy-blanket-builder-inputs .pattern-tab-nav .tab-btn.is-disabled.active {
  color: #9ca3af;
  border-bottom-color: transparent;
}

#create-pattern-btn.button-disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.create-pattern-feedback {
  margin: 0.75rem 0 0;
  min-height: 1.25em;
  font-size: 0.9375rem;
  color: #6b7280;
}

/* Main page header: example photo + title (matches hat pattern page) */
.hat-builder-page-header {
  display: flex;
  gap: 24px;
  align-items: flex-start;
  text-align: left;
}

.hat-builder-page-header__media {
  flex-shrink: 0;
  max-width: min(420px, 100%);
  width: 100%;
}

.hat-builder-page-header__main {
  flex: 1;
  min-width: 0;
}

.hat-builder-page-header .page-header-title {
  justify-content: flex-start;
  margin-bottom: 0.5rem;
}

.hat-builder-page-header__main h1,
.hat-builder-page-header__main .pattern-hero-title {
  text-align: left;
  margin: 0 0 0.5rem 0;
}

.hat-builder-page-header__subtitle,
.pattern-hero__description {
  text-align: left;
  margin: 0;
  color: #6b7280;
  font-size: 1.05rem;
  line-height: 1.6;
}

.pattern-hero__bullets {
  margin-top: 12px;
  padding-left: 18px;
}

.pattern-hero__bullets li {
  margin-bottom: 4px;
}

@media (max-width: 640px) {
  .hat-builder-page-header {
    flex-direction: column;
    align-items: stretch;
  }

  .hat-builder-page-header__media {
    max-width: 100%;
  }

  .hat-builder-page-header .page-header-title {
    justify-content: center;
  }

  .hat-builder-page-header__main h1,
  .hat-builder-page-header__subtitle,
  .pattern-hero-title,
  .pattern-hero__description,
  .pattern-hero__bullets {
    text-align: center;
  }

  .pattern-hero__bullets {
    padding-left: 0;
    list-style-position: inside;
  }
}

.results-container {
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid #e9ecef;
}

.tab-panel#tab-pattern .results-container {
  margin-top: 0;
  padding-top: 0.5rem;
  border-top: none;
}

@media print {
  .pattern-tab-nav {
    display: none !important;
  }

  .pattern-tabs .tab-panel#tab-share,
  .pattern-tabs .tab-panel#tab-inspiration {
    display: none !important;
  }

  .pattern-tabs .tab-panel#tab-build {
    display: none !important;
  }

  .pattern-tabs .tab-panel#tab-pattern {
    display: block !important;
  }

  :global(.no-print) {
    display: none !important;
  }
}

.inspiration-section {
  margin-top: 20px;
}

.inspiration-heading {
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 12px;
}

.pinterest-embed {
  display: flex;
  justify-content: center;
  width: 100%;
  overflow: hidden;
}

@media (max-width: 768px) {
  .pinterest-embed a {
    transform: scale(0.9);
    transform-origin: top center;
  }
}

:global(body.hat-yarn-drawer-open),
:global(body.diy-blanket-width-drawer-open) {
  overflow: hidden;
}

.diy-blanket-builder-inputs #hat-yarn-drawer-trigger-wrap,
.diy-blanket-builder-inputs #needle-check-trigger-wrap {
  margin-top: 24px;
}

.hat-yarn-drawer {
  position: fixed;
  inset: 0;
  z-index: 10040;
  pointer-events: none;
  visibility: hidden;
}

.hat-yarn-drawer.is-open {
  pointer-events: auto;
  visibility: visible;
}

.hat-yarn-drawer-backdrop {
  position: absolute;
  inset: 0;
  z-index: 0;
  margin: 0;
  padding: 0;
  border: none;
  display: block;
  width: 100%;
  height: 100%;
  cursor: default;
  background: rgba(30, 41, 59, 0.38);
  opacity: 0;
  transition: opacity 0.22s ease;
}

.hat-yarn-drawer.is-open .hat-yarn-drawer-backdrop {
  opacity: 1;
}

.hat-yarn-drawer-panel {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  width: min(30rem, 100vw);
  max-width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  background: linear-gradient(180deg, #faf9f6 0%, #f4f3ee 100%);
  border-radius: 20px 0 0 20px;
  box-shadow:
