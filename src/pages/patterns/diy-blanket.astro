<script is:inline src="/js/wizard-utils.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('Custom Blanket Builder initializing...');

  if (!window.WizardUtils) {
    console.error('WizardUtils not found. Ensure /js/wizard-utils.js is loaded before this script.');
  }
  const { updateHTML, showResults, hideResults } = window.WizardUtils;

  const resultsVisibilityConfig = {
    resultsSelector: '#results',
    actionBarSelector: '#action-bar',
    printButtonSelector: '#print-btn',
  };

  const tabButtons = document.querySelectorAll('.pattern-tabs .tab-btn');
  const tabPanels = document.querySelectorAll('.pattern-tabs .tab-panel');

  function loadPatternComments() {
    const el = document.querySelector('[data-pattern-comments]');
    if (!el || !(el instanceof HTMLElement)) return;

    const commentsEl = el;
    const alreadyLoaded = commentsEl.dataset.hyvorLoaded === 'true';
    const websiteId = commentsEl.dataset.hyvorWebsiteId;
    const cleanPath = window.location.pathname.replace(/\/$/, '') || '/';

    const w = window;
    w.HYVOR_TALK_WEBSITE = Number(websiteId);
    w.HYVOR_TALK_CONFIG = {
      url: window.location.origin + cleanPath,
      id: cleanPath,
    };

    if (alreadyLoaded) {
      if (w.HyvorTalk && typeof w.HyvorTalk.reload === 'function') {
        w.HyvorTalk.reload();
      }
      return;
    }

    const existingScript = document.querySelector('script[data-hyvor-embed]');
    if (existingScript) {
      commentsEl.dataset.hyvorLoaded = 'true';
      if (w.HyvorTalk && typeof w.HyvorTalk.reload === 'function') {
        w.HyvorTalk.reload();
      }
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://talk.hyvor.com/web-api/embed.js';
    script.async = true;
    script.type = 'text/javascript';
    script.setAttribute('data-hyvor-embed', 'true');

    script.onload = () => {
      commentsEl.dataset.hyvorLoaded = 'true';
      if (w.HyvorTalk && typeof w.HyvorTalk.reload === 'function') {
        w.HyvorTalk.reload();
      }
    };

    document.body.appendChild(script);
  }

  function activateWizardTab(target) {
    const panel = document.getElementById(`tab-${target}`);
    if (!panel) return;
    tabButtons.forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.tab === target);
    });
    tabPanels.forEach((p) => {
      p.classList.toggle('active', p.id === `tab-${target}`);
    });
    if (target === 'share') {
      loadPatternComments();
    }
    if (target === 'inspiration') {
      if (window.PinUtils && typeof window.PinUtils.build === 'function') {
        window.PinUtils.build();
      }
      window.kbmSchedulePinterestEmbedsRefresh?.();
    }
  }

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (button.classList.contains('is-disabled')) return;
      const target = button.dataset.tab;
      if (!target) return;
      activateWizardTab(target);
    });
  });

  if (
    document.querySelector('.pattern-tabs .tab-btn[data-tab="share"]')?.classList.contains('active') ||
    document.querySelector('#tab-share')?.classList.contains('active')
  ) {
    loadPatternComments();
  }

  window.kbmSchedulePinterestEmbedsRefresh?.();

  const editBtn = document.getElementById('edit-btn');
  if (editBtn) {
    editBtn.addEventListener('click', () => {
      activateWizardTab('build');
      const topEl = document.getElementById('diy-blanket-form-top');
      if (topEl) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        topEl.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      }
    });
  }

  const mobileEditChoicesBtn = document.getElementById('action-bar-mobile-scroll-btn');
  if (mobileEditChoicesBtn) {
    mobileEditChoicesBtn.addEventListener(
      'click',
      () => {
        activateWizardTab('build');
      },
      true
    );
  }

  /** Matches UnitToggle scoped `kbm-units-diy` (fallback: legacy `kbm-units`). */
  const unitStore = {
    get() {
      const scoped = localStorage.getItem('kbm-units-diy');
      const raw = scoped === 'in' || scoped === 'cm' ? scoped : localStorage.getItem('kbm-units');
      if (raw === 'cm') return 'cm';
      return 'inches';
    }
  };
  
  // Blanket size data
  const blanketSizes = {
    "adult-throw": { name: "Adult Throw", length: 78, width: 48, category: "Throw" },
    "bassinet": { name: "Bassinet", length: 36, width: 16, category: "Baby" },
    "child": { name: "Child", length: 48, width: 42, category: "Child" },
    "cradle": { name: "Cradle", length: 36, width: 20, category: "Baby" },
    "crib": { name: "Crib", length: 54, width: 30, category: "Baby" },
    "large-preemie": { name: "Large Preemie", length: 36, width: 36, category: "Baby" },
    "small-preemie": { name: "Small Preemie", length: 24, width: 24, category: "Baby" },
    "standard-throw": { name: "Standard Throw", length: 60, width: 48, category: "Throw" },
    "toddler": { name: "Toddler or Lapghan", length: 48, width: 36, category: "Child" }
  };

  // State (aligned with UnitToggle + `kbm-units-diy` on load; kept in sync via `kbm:units-change`)
  let units = unitStore.get() === 'cm' ? 'cm' : 'inches';
  let stitchesGauge = '';
  let rowsGauge = '';
  let hasGaugeError = false;
  let selectedSize = '';
  let useCustomSize = false;
  let customLength = '';
  let customWidth = '';
  let swatchWidth = '';
  let swatchLength = '';
  let swatchWeight = '';

  // DOM elements
  const btnInches = document.getElementById('diy-btn-inches');
  const btnCm = document.getElementById('diy-btn-cm');
  const inputStitches = document.getElementById('diy-stitch-gauge');
  const inputRows = document.getElementById('diy-row-gauge');
  const standardSizesDiv = document.getElementById('standard-sizes');
  const customSizeDiv = document.getElementById('custom-size-section');
  const inputCustomLength = document.getElementById('custom-length');
  const inputCustomWidth = document.getElementById('custom-width');
  const inputSwatchWidth = document.getElementById('swatch-width');
  const inputSwatchLength = document.getElementById('swatch-length');
  const inputSwatchWeight = document.getElementById('swatch-weight');
  const startOverBtn = document.getElementById('start-over-btn');
  const printBtn = document.getElementById('print-btn');

  const hatYarnDrawerRoot = document.getElementById('hat-yarn-drawer');
  const hatYarnDrawerToggle = document.getElementById('hat-yarn-drawer-toggle');
  const hatYarnDrawerTriggerWrap = document.getElementById('hat-yarn-drawer-trigger-wrap');
  const hatYarnDrawerCloseBtn = document.getElementById('hat-yarn-drawer-close');
  const hatYarnDrawerBackdrop = document.getElementById('hat-yarn-drawer-backdrop');
  const widthDrawerRoot = document.getElementById('diy-blanket-width-drawer');
  const widthDrawerToggle = document.getElementById('needle-check-toggle');
  const widthDrawerTriggerWrap = document.getElementById('needle-check-trigger-wrap');
  const widthDrawerCloseBtn = document.getElementById('diy-blanket-width-drawer-close');
  const widthDrawerBackdrop = document.getElementById('diy-blanket-width-drawer-backdrop');
  /** @type {HTMLElement | null} */
  let hatYarnDrawerLastFocus = null;
  /** @type {HTMLElement | null} */
  let widthDrawerLastFocus = null;

  function openWidthDrawer() {
    if (!widthDrawerRoot) return;
    if (
      widthDrawerToggle instanceof HTMLButtonElement &&
      widthDrawerToggle.disabled
    ) {
      return;
    }
    if (!isMachineFitInputsReady()) return;
    closeHatYarnDrawer();
    widthDrawerLastFocus =
      document.activeElement instanceof HTMLElement ? document.activeElement : null;
    widthDrawerRoot.classList.add('is-open');
    widthDrawerRoot.setAttribute('aria-hidden', 'false');
    document.body.classList.add('diy-blanket-width-drawer-open');
    widthDrawerToggle?.classList.add('is-open');
    widthDrawerToggle?.setAttribute('aria-expanded', 'true');
    widthDrawerCloseBtn?.focus();
  }

  function closeWidthDrawer() {
    if (!widthDrawerRoot?.classList.contains('is-open')) return;
    widthDrawerRoot.classList.remove('is-open');
    widthDrawerRoot.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('diy-blanket-width-drawer-open');
    widthDrawerToggle?.classList.remove('is-open');
    widthDrawerToggle?.setAttribute('aria-expanded', 'false');
    const restore = widthDrawerLastFocus;
    if (restore instanceof HTMLElement) {
      restore.focus();
    } else if (
      widthDrawerToggle instanceof HTMLButtonElement &&
      widthDrawerTriggerWrap &&
      !widthDrawerToggle.disabled
    ) {
      widthDrawerToggle.focus();
    } else {
      inputStitches?.focus();
    }
    widthDrawerLastFocus = null;
  }

  function openHatYarnDrawer() {
    if (!hatYarnDrawerRoot) return;
    if (
      hatYarnDrawerToggle instanceof HTMLButtonElement &&
      hatYarnDrawerToggle.disabled
    ) {
      return;
    }
    if (!isYarnEstimatorInputsReady()) return;
    closeWidthDrawer();
    hatYarnDrawerLastFocus =
      document.activeElement instanceof HTMLElement ? document.activeElement : null;
    hatYarnDrawerRoot.classList.add('is-open');
    hatYarnDrawerRoot.setAttribute('aria-hidden', 'false');
    document.body.classList.add('hat-yarn-drawer-open');
    hatYarnDrawerToggle?.classList.add('is-open');
    hatYarnDrawerToggle?.setAttribute('aria-expanded', 'true');
    hatYarnDrawerCloseBtn?.focus();
  }

  function closeHatYarnDrawer() {
    if (!hatYarnDrawerRoot?.classList.contains('is-open')) return;
    hatYarnDrawerRoot.classList.remove('is-open');
    hatYarnDrawerRoot.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('hat-yarn-drawer-open');
    hatYarnDrawerToggle?.classList.remove('is-open');
    hatYarnDrawerToggle?.setAttribute('aria-expanded', 'false');
    const restore = hatYarnDrawerLastFocus;
    if (restore instanceof HTMLElement) {
      restore.focus();
    } else if (
      hatYarnDrawerToggle instanceof HTMLButtonElement &&
      hatYarnDrawerTriggerWrap &&
      !hatYarnDrawerToggle.disabled
    ) {
      hatYarnDrawerToggle.focus();
    } else {
      inputStitches?.focus();
    }
    hatYarnDrawerLastFocus = null;
  }

  hatYarnDrawerBackdrop?.addEventListener('click', () => closeHatYarnDrawer());
  hatYarnDrawerCloseBtn?.addEventListener('click', () => closeHatYarnDrawer());
  widthDrawerBackdrop?.addEventListener('click', () => closeWidthDrawer());
  widthDrawerCloseBtn?.addEventListener('click', () => closeWidthDrawer());

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (hatYarnDrawerRoot?.classList.contains('is-open')) {
      closeHatYarnDrawer();
      e.preventDefault();
      return;
    }
    if (widthDrawerRoot?.classList.contains('is-open')) {
      closeWidthDrawer();
      e.preventDefault();
    }
  });
  
  console.log('DOM elements loaded, standardSizesDiv:', standardSizesDiv);
  
  // Update placeholders based on units
  function updatePlaceholders() {
    if (!inputSwatchWidth || !inputSwatchLength) return;
    const unitLabel = units === 'inches' ? 'in' : 'cm';
    inputSwatchWidth.placeholder = unitLabel === 'in' ? 'e.g. 4' : 'e.g. 10';
    inputSwatchLength.placeholder = unitLabel === 'in' ? 'e.g. 4' : 'e.g. 10';
    if (inputSwatchWeight) inputSwatchWeight.placeholder = 'e.g. 12';
    document.querySelectorAll('#yarn-calculator-section .yarn-length-unit-label').forEach((el) => {
      el.textContent = unitLabel;
    });
  }

  // Populate size cards
  function populateSizes() {
    console.log('populateSizes() called');
    standardSizesDiv.innerHTML = '';
    
    const optionsDiv = document.createElement('div');
    optionsDiv.className = 'size-options';
    
    // Sort by area (length × width) ascending
    const sortedSizes = Object.entries(blanketSizes).sort((a, b) => {
      const areaA = a[1].length * a[1].width;
      const areaB = b[1].length * b[1].width;
      return areaA - areaB;
    });
    
    sortedSizes.forEach(([key, data]) => {
      const option = document.createElement('div');
      option.className = 'size-option';
      option.dataset.sizeKey = key;
      
      // Convert dimensions based on current unit system
      let displayWidth, displayLength, unitLabel;
      if (units === 'cm') {
        displayWidth = Math.round(data.width * 2.54 * 10) / 10;
        displayLength = Math.round(data.length * 2.54 * 10) / 10;
        unitLabel = 'cm';
      } else {
        displayWidth = data.width;
        displayLength = data.length;
        unitLabel = '"';
      }
      
      option.innerHTML = `
        <div class="size-option-name">${data.name}</div>
        <div class="size-option-dims">${displayWidth}${unitLabel} × ${displayLength}${unitLabel}</div>
      `;
      option.onclick = () => selectSize(key);
      optionsDiv.appendChild(option);
    });

    const customCard = document.createElement('div');
    customCard.id = 'custom-size-picker-card';
    customCard.className = 'size-option size-option--custom';
    customCard.setAttribute('role', 'button');
    customCard.setAttribute('tabindex', '0');
    customCard.setAttribute('aria-pressed', 'false');
    customCard.setAttribute('aria-expanded', 'false');
    customCard.setAttribute('data-testid', 'custom-size-card');
    customCard.setAttribute('aria-controls', 'custom-size-section');
    customCard.innerHTML = `
      <div class="size-option-name">Custom size</div>
      <div class="size-option-dims">Your own length and width</div>
    `;
    customCard.addEventListener('click', () => selectCustomSize());
    customCard.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectCustomSize();
      }
    });
    optionsDiv.appendChild(customCard);

    standardSizesDiv.appendChild(optionsDiv);
    console.log('Size cards created. Total cards:', Object.keys(blanketSizes).length);

    // Restore selected state if a size was previously selected
    if (selectedSize) {
      document.querySelectorAll('.size-option[data-size-key]').forEach(opt => {
        opt.classList.toggle('selected', opt.dataset.sizeKey === selectedSize);
      });
    }

    syncCustomSizeCardVisibility();
  }

  function applySizeMode(isCustom) {
    useCustomSize = isCustom;
    customSizeDiv.hidden = !isCustom;
    const card = document.getElementById('custom-size-picker-card');
    if (card) {
      card.classList.toggle('selected', isCustom);
      card.setAttribute('aria-pressed', isCustom ? 'true' : 'false');
      card.setAttribute('aria-expanded', isCustom ? 'true' : 'false');
    }
    if (isCustom) {
      selectedSize = '';
      document.querySelectorAll('.size-option[data-size-key]').forEach(opt => opt.classList.remove('selected'));
    }
  }

  function syncCustomSizeCardVisibility() {
    const card = document.getElementById('custom-size-picker-card');
    if (!card) return;
    customSizeDiv.hidden = !useCustomSize;
    if (useCustomSize) {
      card.classList.add('selected');
      card.setAttribute('aria-pressed', 'true');
      card.setAttribute('aria-expanded', 'true');
    } else {
      card.classList.remove('selected');
      card.setAttribute('aria-pressed', 'false');
      card.setAttribute('aria-expanded', 'false');
    }
  }

  function selectCustomSize() {
    applySizeMode(true);
    updateYarnCalculatorVisibility();
    updateNeedleCount();
    calculate();
  }

  function selectSize(key) {
    applySizeMode(false);
    selectedSize = key;
    document.querySelectorAll('.size-option[data-size-key]').forEach(opt => {
      opt.classList.toggle('selected', opt.dataset.sizeKey === key);
    });
    updateYarnCalculatorVisibility();
    updateYarnEstimate();
    updateNeedleCount();
    calculate();
  }

  /** Jump to Custom size, reveal inputs, scroll, focus width, brief highlight. */
  function goToCustomSizeWidthEdit() {
    selectCustomSize();
    const section = document.getElementById('diy-blanket-size-section');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (section) {
      section.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    }
    const settleMs = reduce ? 80 : 480;
    window.setTimeout(() => {
      const card = document.querySelector('#custom-size-section .diy-blanket-custom-size-card');
      if (card) {
        card.classList.add('diy-blanket-custom-size-card--jump-highlight');
        window.setTimeout(() => {
          card.classList.remove('diy-blanket-custom-size-card--jump-highlight');
        }, 2600);
      }
      if (inputCustomWidth && typeof inputCustomWidth.focus === 'function') {
        inputCustomWidth.focus({ preventScroll: true });
      }
    }, settleMs);
  }

  widthDrawerToggle?.addEventListener('click', () => {
    if (widthDrawerToggle instanceof HTMLButtonElement && widthDrawerToggle.disabled) {
      return;
    }
    if (widthDrawerRoot?.classList.contains('is-open')) {
      closeWidthDrawer();
      return;
    }
    openWidthDrawer();
  });
  document.getElementById('diy-blanket-adjust-width-btn')?.addEventListener('click', () => {
    closeWidthDrawer();
    window.requestAnimationFrame(() => {
      goToCustomSizeWidthEdit();
    });
  });

  // Check if gauge is entered
  function hasValidGauge() {
    return stitchesGauge && rowsGauge && !hasGaugeError;
  }

  /** Swatch area → blanket area scaling; grams only (same units as blanket width/length). */
  function computeSwatchYarnEstimate(sizeSelection) {
    if (!sizeSelection) return null;
    if (!swatchWidth || !swatchLength || !swatchWeight) return null;

    const sw = parseFloat(swatchWidth);
    const sl = parseFloat(swatchLength);
    const swt = parseFloat(swatchWeight);
    if (
      !(sw > 0 && sl > 0 && swt > 0) ||
      isNaN(sw) ||
      isNaN(sl) ||
      isNaN(swt)
    ) {
      return null;
    }

    const swatchArea = sw * sl;
    const blanketArea =
      sizeSelection.dimensions.width * sizeSelection.dimensions.length;
    if (!(swatchArea > 0) || !(blanketArea > 0)) return null;

    const gramsTotal = Math.round((blanketArea / swatchArea) * swt);

    return { gramsTotal };
  }

  function updateYarnEstimate() {
    updateYarnDrawerSelectedSizeLine();
    const gramsEl = document.getElementById('diy-blanket-yarn-result-grams');
    const ouncesEl = document.getElementById('diy-blanket-yarn-result-ounces');
    if (!gramsEl || !ouncesEl) return;

    const sizeSelection = getCurrentSize();
    const est = computeSwatchYarnEstimate(sizeSelection);
    if (!est) {
      gramsEl.textContent = '---';
      ouncesEl.textContent = '---';
      return;
    }

    gramsEl.textContent = `${est.gramsTotal} g`;
    ouncesEl.textContent = `${(est.gramsTotal / 28.349523125).toFixed(1)} oz`;
  }

  // Validation
  function validateGauge(value, type) {
    if (!value) return { valid: true, message: '', class: '' };
    
    const num = parseFloat(value);
    if (isNaN(num)) {
      return { valid: false, message: 'Please enter a valid number', class: 'error' };
    }
    if (num < 2) {
      return { valid: false, message: 'Value must be at least 2', class: 'error' };
    }
    if (num > 80) {
      return { valid: false, message: 'Value must be 80 or less', class: 'error' };
    }
    
    if (type === 'stitches' && (num < 10 || num > 50)) {
      return { valid: true, message: 'That seems unusual — double-check your entry', class: 'warning' };
    }
    if (type === 'rows' && (num < 10 || num > 60)) {
      return { valid: true, message: 'That seems unusual — double-check your entry', class: 'warning' };
    }
    
    return { valid: true, message: '', class: '' };
  }

  function updateValidation(input, msgEl, type) {
    const validation = validateGauge(input.value, type);
    input.className = validation.class;
    if (validation.message) {
      const symbol = validation.class === 'error' ? '⚠' : '⚠';
      msgEl.className = `validation-message ${validation.class}`;
      msgEl.innerHTML = `${symbol} ${validation.message}`;
    } else {
      msgEl.className = 'validation-message';
      msgEl.innerHTML = '';
    }
    return validation.valid;
  }
  
  // Check if BOTH gauge inputs are valid
  function checkGaugeErrors() {
    const stitchesValidation = validateGauge(stitchesGauge, 'stitches');
    const rowsValidation = validateGauge(rowsGauge, 'rows');
    return !stitchesValidation.valid || !rowsValidation.valid;
  }

  // Unit conversion
  function convertDimensions(dimensions) {
    if (units === 'cm') {
      return {
        length: Math.round(dimensions.length * 2.54 * 10) / 10,
        width: Math.round(dimensions.width * 2.54 * 10) / 10
      };
    }
    return dimensions;
  }

  // Get current size selection
  function getCurrentSize() {
    if (useCustomSize && customLength && customWidth) {
      return {
        size: "Custom",
        dimensions: {
          length: parseFloat(customLength),
          width: parseFloat(customWidth)
        },
        category: "Custom"
      };
    }
    
    if (selectedSize && blanketSizes[selectedSize]) {
      const sizeData = blanketSizes[selectedSize];
      return {
        size: sizeData.name,
        dimensions: convertDimensions({ length: sizeData.length, width: sizeData.width }),
        category: sizeData.category
      };
    }
    
    return null;
  }

  /** Same unit suffix as pattern summary / size cards (`"` for inches, `cm` for cm). */
  function blanketSizeUnitSuffix() {
    return units === 'inches' ? '"' : 'cm';
  }

  /** Reuses `getCurrentSize()` — no duplicate size rules. */
  function updateYarnDrawerSelectedSizeLine() {
    const el = document.getElementById('yarn-drawer-selected-size');
    if (!el) return;
    const sel = getCurrentSize();
    if (!sel) {
      el.textContent = 'Selected size: Not chosen yet';
      el.classList.add('is-placeholder');
      return;
    }
    el.classList.remove('is-placeholder');
    const u = blanketSizeUnitSuffix();
    const { width, length } = sel.dimensions;
    el.textContent = `Selected size: ${sel.size} — ${width}${u} × ${length}${u}`;
  }

  /** Preset or custom size with valid dimensions + valid stitch gauge only (no row gauge; not swatch/yarn). */
  function isMachineFitInputsReady() {
    const sizeSelection = getCurrentSize();
    if (!sizeSelection) return false;
    const { width, length } = sizeSelection.dimensions;
    if (!Number.isFinite(width) || !Number.isFinite(length) || width <= 0 || length <= 0) {
      return false;
    }
    const gaugeSts = String(stitchesGauge ?? '').trim();
    if (!gaugeSts) return false;
    const stitchesValidation = validateGauge(stitchesGauge, 'stitches');
    if (!stitchesValidation.valid) return false;
    const st = Number(gaugeSts);
    if (!Number.isFinite(st) || st <= 0) return false;
    const divisor = units === 'inches' ? 4 : 10;
    const stitchesPerUnit = st / divisor;
    if (!Number.isFinite(stitchesPerUnit) || stitchesPerUnit <= 0) return false;
    return true;
  }

  /** Size + valid gauge — same gating idea as hat optional yarn link (not full pattern CTA). */
  function isYarnEstimatorInputsReady() {
    const sizeSelection = getCurrentSize();
    if (!sizeSelection) return false;
    const gaugeSts = inputStitches?.value?.trim();
    const gaugeRows = inputRows?.value?.trim();
    if (!gaugeSts || !gaugeRows) return false;
    const st = Number(gaugeSts);
    const rg = Number(gaugeRows);
    if (!Number.isFinite(st) || st <= 0 || !Number.isFinite(rg) || rg <= 0) return false;
    if (checkGaugeErrors()) return false;
    const { width, length } = sizeSelection.dimensions;
    if (!Number.isFinite(width) || !Number.isFinite(length) || width <= 0 || length <= 0) return false;
    return true;
  }

  function updateYarnCalculatorVisibility() {
    if (!hatYarnDrawerTriggerWrap || !(hatYarnDrawerToggle instanceof HTMLButtonElement)) {
      return;
    }
    const ready = isYarnEstimatorInputsReady();
    if (!ready) {
      closeHatYarnDrawer();
    }
    hatYarnDrawerToggle.disabled = !ready;
    hatYarnDrawerToggle.title = ready
      ? ''
      : 'Choose a blanket size and enter your gauge to estimate yarn.';
  }

  function updateWidthDrawerTriggerState() {
    if (!(widthDrawerToggle instanceof HTMLButtonElement)) return;
    const ready = isMachineFitInputsReady();
    if (!ready) {
      closeWidthDrawer();
    }
    widthDrawerToggle.disabled = !ready;
    widthDrawerToggle.title = ready
      ? ''
      : 'Select a blanket size and enter your gauge first.';
  }

  function syncWidthDrawerNeedleBlock() {
    const block = document.getElementById('needle-estimate-block');
    const ready = isMachineFitInputsReady();
    if (block) {
      block.hidden = !ready;
    }
    const previewWrap = document.getElementById('diy-blanket-needle-result-preview');
    const valueMain = document.getElementById('needle-count-value');
    const ctxMain = document.getElementById('needle-size-context');
    const valuePreview = document.getElementById('needle-count-value-preview');
    const ctxPreview = document.getElementById('needle-size-context-preview');
    if (previewWrap) {
      previewWrap.hidden = !ready;
    }
    if (!ready) {
      if (valuePreview) valuePreview.textContent = '';
      if (ctxPreview) ctxPreview.textContent = '';
    } else if (valueMain && ctxMain && valuePreview && ctxPreview) {
      valuePreview.textContent = valueMain.textContent;
      ctxPreview.textContent = ctxMain.textContent;
    }
    updateWidthDrawerTriggerState();
  }

  /** Display dimensions for needle-count line; matches pattern tab unit suffix (inches → ", cm → cm). */
  function formatBlanketMeasure(n) {
    if (!Number.isFinite(n)) return '—';
    const rounded = Math.round(n * 10) / 10;
    if (Number.isInteger(rounded) || Math.abs(rounded - Math.round(rounded)) < 1e-9) {
      return String(Math.round(rounded));
    }
    return String(rounded);
  }

  function updateNeedleSizeContext() {
    const ctxEl = document.getElementById('needle-size-context');
    if (!ctxEl) return;
    const sizeSelection = getCurrentSize();
    if (!sizeSelection) {
      ctxEl.textContent = '';
      return;
    }
    const { width, length } = sizeSelection.dimensions;
    if (!Number.isFinite(width) || !Number.isFinite(length) || width <= 0 || length <= 0) {
      ctxEl.textContent = '';
      return;
    }
    const unitSuffix = units === 'inches' ? '"' : 'cm';
    const w = formatBlanketMeasure(width);
    const l = formatBlanketMeasure(length);
    ctxEl.textContent = `for ${w}${unitSuffix} × ${l}${unitSuffix} (${sizeSelection.size})`;
  }

  function updateNeedleCount() {
    try {
      updateNeedleSizeContext();
      const valueEl = document.getElementById('needle-count-value');
      if (!valueEl) return;

      const sizeSelection = getCurrentSize();
      if (!sizeSelection) {
        valueEl.textContent = '—';
        return;
      }

      if (!String(stitchesGauge ?? '').trim()) {
        valueEl.textContent = '—';
        return;
      }

      const stitchesValidation = validateGauge(stitchesGauge, 'stitches');
      if (!stitchesValidation.valid) {
        valueEl.textContent = '—';
        return;
      }

      const divisor = units === 'inches' ? 4 : 10;
      const stitchesPerUnit = parseFloat(stitchesGauge) / divisor;
      if (!Number.isFinite(stitchesPerUnit) || stitchesPerUnit <= 0) {
        valueEl.textContent = '—';
        return;
      }

      const needles = Math.round(sizeSelection.dimensions.width * stitchesPerUnit);
      valueEl.textContent = String(needles);
    } finally {
      syncWidthDrawerNeedleBlock();
    }
  }

  function requiredBlanketInputsComplete() {
    if (!hasValidGauge()) return false;
    if (checkGaugeErrors()) return false;
    const sizeSelection = getCurrentSize();
    if (!sizeSelection) return false;
    const divisor = units === 'inches' ? 4 : 10;
    const stitchesPerUnit = parseFloat(stitchesGauge) / divisor;
    const rowsPerUnit = parseFloat(rowsGauge) / divisor;
    if (!stitchesPerUnit || !rowsPerUnit) return false;
    const widthSts = Math.round(sizeSelection.dimensions.width * stitchesPerUnit);
    const lengthRows = Math.round(sizeSelection.dimensions.length * rowsPerUnit);
    if (widthSts <= 0 || lengthRows <= 0) return false;
    return true;
  }

  let createPatternFeedbackTimer = 0;
  function showFinishRequiredSectionsMessage() {
    const el = document.getElementById('create-pattern-feedback');
    if (!el) return;
    window.clearTimeout(createPatternFeedbackTimer);
    el.textContent = 'Finish blanket size and gauge to generate your pattern.';
    el.hidden = false;
    createPatternFeedbackTimer = window.setTimeout(() => {
      el.textContent = '';
      el.hidden = true;
    }, 4000);
  }

  function updatePatternReadinessUi() {
    const patternTabBtn =
      document.getElementById('diy-tab-pattern') ||
      document.querySelector('.pattern-tabs .tab-btn[data-tab="pattern"]');
    const createPatternBtn = document.getElementById('create-pattern-btn');
    const ready = requiredBlanketInputsComplete();

    updateYarnCalculatorVisibility();
    syncWidthDrawerNeedleBlock();

    if (createPatternBtn) {
      createPatternBtn.classList.toggle('button-disabled', !ready);
      if (ready) {
        createPatternBtn.removeAttribute('aria-disabled');
      } else {
        createPatternBtn.setAttribute('aria-disabled', 'true');
      }
    }
    if (patternTabBtn) {
      patternTabBtn.classList.toggle('is-disabled', !ready);
      if (ready) {
        patternTabBtn.removeAttribute('aria-disabled');
      } else {
        patternTabBtn.setAttribute('aria-disabled', 'true');
      }
    }

    if (!ready) {
      const patternNavBtn =
        document.getElementById('diy-tab-pattern') ||
        document.querySelector('.pattern-tabs .tab-btn[data-tab="pattern"]');
      if (patternNavBtn?.classList.contains('active')) {
        activateWizardTab('build');
      }
    }
  }

  function calculateYarnNeeded(sizeSelection, widthSts, lengthRows) {
    const est = computeSwatchYarnEstimate(sizeSelection);
    if (!est) {
      return { method: 'none' };
    }
    return {
      method: 'swatch',
      gramsTotal: est.gramsTotal,
    };
  }

  function generatePattern(calc) {
    const { sizeSelection, yarnData, widthStitches, lengthRows } = calc;
    const unitLabel = units === 'inches' ? '"' : 'cm';
    const unitSize = units === 'inches' ? '4"' : '10cm';

    const setText = (id, text) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    setText('pattern-size-name', `${sizeSelection.size} Blanket`);
    setText('pattern-finished-width', `${sizeSelection.dimensions.width}${unitLabel}`);
    setText('pattern-finished-length', `${sizeSelection.dimensions.length}${unitLabel}`);
    setText('pattern-gauge-stitches', String(stitchesGauge));
    setText('pattern-gauge-rows', String(rowsGauge));
    setText('pattern-unit-size', unitSize);
    setText('pattern-materials-gauge-line', `${stitchesGauge} stitches and ${rowsGauge} rows = ${unitSize}`);
    setText('pattern-width-sts', String(widthStitches));
    setText('pattern-length-rows', String(lengthRows));
    setText('pattern-summary-width-sts', String(widthStitches));
    setText('pattern-summary-length-rows', String(lengthRows));
    setText('pattern-summary-finished-width', `${sizeSelection.dimensions.width}${unitLabel}`);
    setText('pattern-summary-finished-length', `${sizeSelection.dimensions.length}${unitLabel}`);

    const yarnBlock = document.getElementById('pattern-yarn-block');
    const yarnGramsEl = document.getElementById('pattern-yarn-grams');
    const summaryYarn = document.getElementById('pattern-summary-yarn');
    const summaryYarnGrams = document.getElementById('pattern-summary-yarn-grams');

    if (yarnData.method === 'swatch' && yarnGramsEl) {
      yarnGramsEl.textContent = String(yarnData.gramsTotal);
      if (yarnBlock) yarnBlock.hidden = false;
      if (summaryYarnGrams) summaryYarnGrams.textContent = String(yarnData.gramsTotal);
      if (summaryYarn) summaryYarn.hidden = false;
    } else {
      if (yarnGramsEl) yarnGramsEl.textContent = '';
      if (yarnBlock) yarnBlock.hidden = true;
      if (summaryYarnGrams) summaryYarnGrams.textContent = '';
      if (summaryYarn) summaryYarn.hidden = true;
    }

    const diagramTitle = document.getElementById('diagram-title');
    if (diagramTitle) diagramTitle.textContent = `${sizeSelection.size} Blanket`;
    void generateDiagram(calc);
  }

  async function generateDiagram(calc) {
    const currentUnit = unitStore.get();
    const {
      widthStitches,
      widthMeasurement,
      lengthRows,
      lengthMeasurement
    } = calc;

    const displayWidthMeasurement =
      currentUnit === 'inches'
        ? `${widthMeasurement} in`
        : `${widthMeasurement} cm`;

    const displayLengthMeasurement =
      currentUnit === 'inches'
        ? `${lengthMeasurement} in`
        : `${lengthMeasurement} cm`;

    try {
      const response = await fetch('/diagrams/diy-blanket.svg');
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      let svgContent = await response.text();

      svgContent = svgContent
        .replace(/{{svg-width-stitches}}/g, `${widthStitches} sts`)
        .replace(/{{svg-width-measurement}}/g, displayWidthMeasurement)
        .replace(/{{svg-length-rows}}/g, `${lengthRows} rows`)
        .replace(/{{svg-length-measurement}}/g, displayLengthMeasurement);

      updateHTML('#diagram-content', svgContent);
    } catch (error) {
      console.error('Failed to load blanket diagram:', error);
      updateHTML('#diagram-content', '<p style="text-align: center; color: #6b7280;">Diagram unavailable</p>');
    }
  }

  // Main calculate function (updates Pattern tab content when build is complete; same math as before)
  function calculate() {
    updateYarnCalculatorVisibility();
    updateYarnEstimate();
    updateNeedleCount();
    if (!requiredBlanketInputsComplete()) {
      hideResults(resultsVisibilityConfig);
      updatePatternReadinessUi();
      return;
    }

    const divisor = units === 'inches' ? 4 : 10;
    const stitchesPerUnit = parseFloat(stitchesGauge) / divisor;
    const rowsPerUnit = parseFloat(rowsGauge) / divisor;
    const sizeSelection = getCurrentSize();

    const widthSts = Math.round(sizeSelection.dimensions.width * stitchesPerUnit);
    const lengthRows = Math.round(sizeSelection.dimensions.length * rowsPerUnit);
    const yarnData = calculateYarnNeeded(sizeSelection, widthSts, lengthRows);

    generatePattern({
      sizeSelection,
      yarnData,
      widthStitches: widthSts,
      widthMeasurement: sizeSelection.dimensions.width,
      lengthRows,
      lengthMeasurement: sizeSelection.dimensions.length,
    });

    showResults(resultsVisibilityConfig);
    updatePatternReadinessUi();
  }

  /** UnitToggle owns button UI; keep `units` + size grid + needle line in sync on toggle. */
  window.addEventListener('kbm:units-change', (e) => {
    if (!(e instanceof CustomEvent)) return;
    const d = e.detail as { unit?: string; toggleId?: string } | undefined;
    if (d?.toggleId != null && d.toggleId !== 'diy') return;
    const u = d?.unit;
    if (u !== 'in' && u !== 'cm') return;
    units = u === 'cm' ? 'cm' : 'inches';
    updatePlaceholders();
    populateSizes();
    calculate();
  });

  // Event handlers
  inputStitches.addEventListener('input', (e) => {
    stitchesGauge = e.target.value;
    calculate();
  });

  inputRows.addEventListener('input', (e) => {
    rowsGauge = e.target.value;
    calculate();
  });

  inputCustomLength.addEventListener('input', (e) => {
    customLength = e.target.value;
    updateYarnCalculatorVisibility();
    updateYarnEstimate();
    calculate();
  });

  inputCustomWidth.addEventListener('input', (e) => {
    customWidth = e.target.value;
    updateYarnCalculatorVisibility();
    updateYarnEstimate();
    calculate();
  });

  hatYarnDrawerToggle?.addEventListener('click', () => {
    if (hatYarnDrawerRoot?.classList.contains('is-open')) {
      closeHatYarnDrawer();
      return;
    }
    if (!isYarnEstimatorInputsReady()) return;
    openHatYarnDrawer();
  });

  inputSwatchWidth.addEventListener('input', (e) => {
    swatchWidth = e.target.value;
    updateYarnEstimate();
    calculate();
  });

  inputSwatchLength.addEventListener('input', (e) => {
    swatchLength = e.target.value;
    updateYarnEstimate();
    calculate();
  });

  inputSwatchWeight.addEventListener('input', (e) => {
    swatchWeight = e.target.value;
    updateYarnEstimate();
    calculate();
  });

  // Action bar event listeners (buttons are inside results section, so check if they exist)
  if (startOverBtn) {
    startOverBtn.addEventListener('click', () => {
      units = 'inches';
      stitchesGauge = rowsGauge = '';
      selectedSize = '';
      useCustomSize = false;
      customLength = customWidth = '';
      swatchWidth = swatchLength = swatchWeight = '';
      
      inputStitches.value = '';
      inputRows.value = '';
      inputCustomLength.value = '';
      inputCustomWidth.value = '';
      inputSwatchWidth.value = '';
      inputSwatchLength.value = '';
      inputSwatchWeight.value = '';
      
      btnInches.classList.add('active');
      btnCm.classList.remove('active');
      applySizeMode(false);
      closeHatYarnDrawer();
      closeWidthDrawer();
      updateYarnEstimate();
      updateYarnCalculatorVisibility();
      
      document.querySelectorAll('.size-option').forEach(opt => opt.classList.remove('selected'));

      hideResults(resultsVisibilityConfig);
      activateWizardTab('build');
      updateNeedleCount();
      updatePatternReadinessUi();
    });
  }

  const createPatternBtnForClick = document.getElementById('create-pattern-btn');
  if (createPatternBtnForClick) {
    createPatternBtnForClick.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      e.preventDefault();
    });
    createPatternBtnForClick.addEventListener('click', () => {
      if (!requiredBlanketInputsComplete()) {
        showFinishRequiredSectionsMessage();
        return;
      }
      calculate();
      const patternNav = document.getElementById('diy-tab-pattern');
      patternNav?.classList.remove('is-disabled');
      patternNav?.removeAttribute('aria-disabled');
      activateWizardTab('pattern');
    });
  }

  if (printBtn) {
    printBtn.addEventListener('click', () => {
      const sizeSelection = getCurrentSize();
      const originalTitle = document.title;

      const runPrint = () => {
        if (sizeSelection) {
          document.title = `${sizeSelection.size} · Custom Blanket Builder`;
        }
        window.print();
        setTimeout(() => {
          document.title = originalTitle;
        }, 100);
      };

      if (typeof window.kbmTriggerPatternPrint === 'function') {
        window.kbmTriggerPatternPrint(printBtn, {
          onBeforePrint: () => {
            if (sizeSelection) {
              document.title = `${sizeSelection.size} · Custom Blanket Builder`;
            }
          },
          onAfterPrint: () => {
            setTimeout(() => {
              document.title = originalTitle;
            }, 100);
          },
        });
      } else {
        runPrint();
      }
    });
  }

  // Live needle count (also runs at start of calculate(); these listeners run after handlers that sync state)
  inputStitches?.addEventListener('input', updateNeedleCount);
  inputCustomWidth?.addEventListener('input', updateNeedleCount);
  inputCustomLength?.addEventListener('input', updateNeedleCount);

  // Initialize (`units` already matches `kbm-units`; `kbm:units-change` may have fired before listener existed)
  console.log('Initializing wizard, calling populateSizes()...');
  updatePlaceholders();
  populateSizes();
  calculate();
  console.log('Wizard initialized!');
});
</script>

</Layout>
