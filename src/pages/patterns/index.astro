---
import Layout from '../../layouts/Layout.astro';
import PatternBuilderMyPatternsLink from '../../components/patterns/PatternBuilderMyPatternsLink.astro';
import { isDropShoulderProductionBlocked } from '../../lib/patterns/dropShoulderProductionAccess';
import { PATTERN_BUILDERS_HOME_HREF } from '../../lib/patterns/customPatternProjectNavigation';
import { HAT_PATTERN_HERO_IMAGE_SRC } from '../../lib/patterns/hat/hatPatternHeroImage';
import {
  PATTERN_CATALOG_MEMBERSHIP_BODY,
  PATTERN_CATALOG_MORE_HEADING,
  PATTERNS_LANDING_BECOME_MEMBER_HREF,
  PATTERNS_LANDING_BECOME_MEMBER_LABEL,
  PATTERNS_LANDING_LOGIN_LABEL,
} from '../../lib/patterns/patternsLandingCta';
import {
  DROP_SHOULDER_CATALOG_PILL_REST,
  DROP_SHOULDER_PATTERN_POSSIBILITIES,
  HAT_CATALOG_PILL_REST,
  HAT_PATTERN_POSSIBILITIES,
  SLEEVELESS_CATALOG_PILL_REST,
  SLEEVELESS_PATTERN_POSSIBILITIES,
} from '../../lib/patterns/patternCatalogPossibilities';

// Marketing hero and feature grid live on {@link PATTERN_BUILDERS_HOME_HREF}.
// This page is the public pattern catalog — pick a builder to start.
// Membership CTA is informational only; sweater builders enforce their own gates.

const hideDropShoulderInCatalog = isDropShoulderProductionBlocked(Astro.url.hostname, {
  isViteDev: import.meta.env.DEV,
  publicSiteEnv: import.meta.env.PUBLIC_SITE_ENV,
});

const dropShoulderPattern = {
  title: 'Drop Shoulder Sweater',
  // `?new=1` clears any active draft on boot so this card always starts fresh
  // (mirrors the sleeveless builder). Drop shoulder reuses the same review/pattern flow.
  href: '/patterns/drop-shoulder/builder?new=1',
  image: '/images/patterns/drop_shoulder.webp',
  copy: 'A relaxed sweater with drop-shoulder sleeves (cuff-up or top-down), pullover or cardigan fronts, round or V-neck, and printable row-by-row instructions.',
  button: 'Create drop shoulder sweater',
  pillCount: DROP_SHOULDER_PATTERN_POSSIBILITIES,
  pillRest: DROP_SHOULDER_CATALOG_PILL_REST,
};

const hatPattern = {
  title: 'Hat',
  href: '/patterns/hat/builder',
  image: HAT_PATTERN_HERO_IMAGE_SRC,
  copy: 'Knit a hat that actually fits with brim choices, custom sizing, and machine-friendly instructions.',
  button: 'Create your hat',
  pillCount: HAT_PATTERN_POSSIBILITIES,
  pillRest: HAT_CATALOG_PILL_REST,
};

const sleevelessPattern = {
  title: 'Sleeveless Sweater',
  // Force a brand-new draft from the catalog. `?new=1` makes the Express builder clear any
  // persisted/active session on boot (see applySleevelessExpressNewSessionFromUrl) so this card
  // never resumes a previous or another user's pattern. Use "My Patterns" to resume/open.
  href: '/patterns/sleeveless/builder?new=1',
  image: '/images/patterns/sleeveless.webp',
  copy: 'Custom-fit sleeveless sweaters with pullover or cardigan fronts, round or V-neck styling, and printable row-by-row instructions.',
  button: 'Create sleeveless sweater',
  pillCount: SLEEVELESS_PATTERN_POSSIBILITIES,
  pillRest: SLEEVELESS_CATALOG_PILL_REST,
};

const sweaterPatterns = [
  sleevelessPattern,
  ...(hideDropShoulderInCatalog ? [] : [dropShoulderPattern]),
];

const availablePatterns = [
  sleevelessPattern,
  hatPattern,
  ...(hideDropShoulderInCatalog ? [] : [dropShoulderPattern]),
  // Blanket Pattern Builder — POSTPONED for the August launch. Hidden from the public catalog but the
  // route /patterns/diy-blanket is intact and reachable by direct URL for future development/testing.
  // Uncomment this entry to bring the Blanket builder back to the catalog.
  // {
  //   title: 'Blanket Pattern Builder',
  //   // Existing working route preserved (no /patterns/blanket page exists).
  //   href: '/patterns/diy-blanket',
  //   image: '/images/hybrid-blanket1.webp',
  //   copy: 'Build a custom blanket pattern for your yarn, your gauge, and your machine.',
  //   button: 'Create your blanket',
  // },
];

const comingSoonPatterns = [
  {
    title: 'Raglan Sweater',
    image: '/images/patterns/raglan.webp',
    copy: 'A flexible raglan sweater system with custom fit and clear shaping guidance.',
  },
  {
    title: 'Set-In Sleeve Sweater',
    image: '/images/patterns/set-in.webp',
    copy: 'A classic sweater system designed for custom fit, sleeve shaping, and polished finishing.',
  },
];
---

<Layout title="Choose a Pattern">

  <div class="patterns-page" data-patterns-page>

    <header class="patterns-hero">
      <div class="patterns-hero__text">
        <h1 class="patterns-intro__title">Choose a Pattern</h1>
        <p class="patterns-intro__subtitle">
          Choose a pattern to get started
        </p>
      </div>
      <div class="patterns-hero__actions">
        <div data-ms-content="!members">
          <a
            href={PATTERN_BUILDERS_HOME_HREF}
            class="patterns-hero__btn kbm-btn kbm-btn-outline"
            data-testid="patterns-catalog-about"
          >
            About Knit It Now Patterns
          </a>
        </div>
        <div data-ms-content="members">
          <PatternBuilderMyPatternsLink class="patterns-hero__btn kbm-btn kbm-btn-outline" />
        </div>
      </div>
    </header>

    <div class="patterns-catalog-group" data-patterns-catalog="guest">
      <section class="patterns-featured" aria-labelledby="patterns-featured-hat-heading">
        <a
          href={hatPattern.href}
          class="patterns-featured__panel"
          data-testid="patterns-featured-hat"
        >
          <div class="patterns-featured__visual">
            <img src={hatPattern.image} alt={hatPattern.title} />
          </div>
          <div class="patterns-featured__body">
            <div class="patterns-featured__top">
              <h2 class="patterns-featured__eyebrow">Try a Pattern Builder Free</h2>
              <span class="patterns-featured__badge">Free</span>
            </div>
            <h3 id="patterns-featured-hat-heading" class="patterns-featured__title">
              Create Your Custom Hat Pattern
            </h3>
            <p class="patterns-featured__copy">
              Enter your gauge, choose your size and style, and create custom knitting instructions for your machine and yarn.
            </p>
            <span class="patterns-featured__cta">CREATE MY FREE HAT PATTERN</span>
            <p class="patterns-featured__reassurance">Free. No account or password needed.</p>
          </div>
        </a>
      </section>

      <section
        id="sweater-patterns"
        class="patterns-catalog patterns-catalog--more"
        aria-labelledby="patterns-more-heading"
      >
        <h2 id="patterns-more-heading" class="patterns-section-title">{PATTERN_CATALOG_MORE_HEADING}</h2>
        <p class="patterns-section-note">{PATTERN_CATALOG_MEMBERSHIP_BODY}</p>
        <div class="patterns-grid">
          {sweaterPatterns.map((pattern) => (
            <a href={pattern.href} class="catalog-card">
              <div class="catalog-card__media">
                <img src={pattern.image} alt={pattern.title} loading="lazy" decoding="async" />
              </div>
              <div class="catalog-card__body">
                <span class="catalog-card__status catalog-card__status--available">
                  <span class="catalog-card__status-count">{pattern.pillCount}</span>
                  <span class="catalog-card__status-rest">{pattern.pillRest}</span>
                </span>
                <h3 class="catalog-card__title">{pattern.title}</h3>
                <p class="catalog-card__copy">{pattern.copy}</p>
                <span class="catalog-card__cta kbm-btn kbm-btn-accent">{pattern.button}</span>
              </div>
            </a>
          ))}
        </div>
        <nav
          class="patterns-action-bar"
          aria-label="Pattern builder actions"
          data-patterns-landing-cta
          data-cta-mode="prospect"
        >
          <div class="patterns-action-bar__prospect" data-patterns-landing-cta-prospect>
            <div class="patterns-action-bar__prospect-actions">
              <a
                href={PATTERNS_LANDING_BECOME_MEMBER_HREF}
                class="patterns-action-bar__primary kbm-btn kbm-btn-accent"
              >
                {PATTERNS_LANDING_BECOME_MEMBER_LABEL}
              </a>
              <a
                href="#"
                class="patterns-action-bar__login kbm-btn kbm-btn-outline"
                data-ms-modal="login"
                data-ms-redirect="current-url"
              >
                {PATTERNS_LANDING_LOGIN_LABEL}
              </a>
            </div>
          </div>
        </nav>
      </section>
    </div>

    <div class="patterns-catalog-group" data-patterns-catalog="member" hidden>
      <section class="patterns-catalog" aria-labelledby="patterns-available-heading">
        <h2 id="patterns-available-heading" class="patterns-section-title">Available now</h2>
        <div class="patterns-grid">
          {availablePatterns.map((pattern) => (
            <a href={pattern.href} class="catalog-card">
              <div class="catalog-card__media">
                <img src={pattern.image} alt={pattern.title} loading="lazy" decoding="async" />
              </div>
              <div class="catalog-card__body">
                <span class="catalog-card__status catalog-card__status--available">
                  <span class="catalog-card__status-count">{pattern.pillCount}</span>
                  <span class="catalog-card__status-rest">{pattern.pillRest}</span>
                </span>
                <h3 class="catalog-card__title">{pattern.title}</h3>
                <p class="catalog-card__copy">{pattern.copy}</p>
                <span class="catalog-card__cta kbm-btn kbm-btn-accent">{pattern.button}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>

    <section class="patterns-catalog" aria-labelledby="patterns-coming-heading">
      <h2 id="patterns-coming-heading" class="patterns-section-title">Coming soon</h2>
      <div class="patterns-grid">
        {comingSoonPatterns.map((pattern) => (
          <div class="catalog-card catalog-card--soon" aria-disabled="true">
            <div class="catalog-card__media">
              {pattern.image
                ? <img src={pattern.image} alt={pattern.title} loading="lazy" decoding="async" />
                : <div class="catalog-card__placeholder" aria-hidden="true"></div>}
            </div>
            <div class="catalog-card__body">
              <span class="catalog-card__status catalog-card__status--soon">Coming soon</span>
              <h3 class="catalog-card__title">{pattern.title}</h3>
              <p class="catalog-card__copy">{pattern.copy}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>

</Layout>

<script>
  import { initPatternsLandingCta } from "../../lib/patterns/patternsLandingCta";

  function boot(): void {
    const root = document.querySelector("[data-patterns-landing-cta]");
    if (!(root instanceof HTMLElement)) return;
    void initPatternsLandingCta(root);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
</script>

<style>
.patterns-page {
  max-width: 1000px;
  margin: 0 auto;
  padding: 20px;
}

/* A class-level display value would beat the UA [hidden] rule. */
.patterns-catalog-group[hidden] {
  display: none !important;
}

/* Membership CTAs sit under More Pattern Builders for guests only. */
.patterns-action-bar {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  margin: 20px 0 0;
}

.patterns-action-bar[data-cta-mode="member"] {
  display: none;
}

.patterns-action-bar__prospect {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
  width: 100%;
}

.patterns-action-bar__prospect-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
  gap: 12px;
  width: 100%;
}

.patterns-action-bar__primary,
.patterns-action-bar__login {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 14rem;
  min-height: 3.25rem;
  padding: 0.85rem 1.25rem;
  margin: 0;
  font-size: 1.05rem;
  font-weight: 600;
  text-align: center;
  text-decoration: none;
}

/* Hero / header */
.patterns-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin: 0 0 28px;
}

.patterns-hero__text {
  flex: 1 1 auto;
  min-width: 0;
}

.patterns-intro__title {
  margin: 0 0 8px;
  font-size: clamp(1.6rem, 3vw, 2rem);
  font-weight: 600;
  color: #52682d;
  line-height: 1.2;
}

.patterns-intro__subtitle {
  margin: 0;
  max-width: 42rem;
  font-size: 1.02rem;
  line-height: 1.55;
  color: #4d5a48;
}

.patterns-hero__actions {
  flex: 0 0 auto;
}

.patterns-hero__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  min-height: 3.25rem;
  padding: 0.85rem 1.5rem;
  margin: 0;
  font-size: 1.05rem;
  font-weight: 600;
  text-align: center;
  text-decoration: none;
  white-space: nowrap;
}

/* Catalog sections */
.patterns-catalog {
  margin: 0 0 32px;
}

.patterns-section-title {
  margin: 0 0 16px;
  font-size: 1.2rem;
  font-weight: 600;
  color: #52682d;
}

.patterns-catalog--more .patterns-section-title {
  padding-bottom: 0.4rem;
  border-bottom: 2px solid #c7d8a4;
}

.patterns-section-note {
  margin: -0.35rem 0 1rem;
  font-size: 0.95rem;
  line-height: 1.5;
  color: #4d5a48;
}

.patterns-featured {
  margin: 0 0 2.15rem;
}

.patterns-featured__panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 1.25rem;
  align-items: stretch;
  width: 100%;
  text-decoration: none;
  color: inherit;
  box-sizing: border-box;
  padding: 1.45rem 1.5rem 1.5rem;
  background: color-mix(in srgb, var(--kbm-green, #52682d) 8%, #ffffff);
  border: 1px solid #c7d8a4;
  border-left: 6px solid var(--kbm-accent, #C2614E);
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(36, 48, 21, 0.07);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.patterns-featured__panel:hover,
.patterns-featured__panel:focus-visible {
  border-color: var(--kbm-green, #52682d);
  border-left-color: var(--kbm-accent, #C2614E);
  box-shadow: 0 4px 16px rgba(82, 104, 45, 0.12);
  outline: none;
}

.patterns-featured__visual {
  position: relative;
  min-height: 12.5rem;
  border-radius: 8px;
  overflow: hidden;
  background: #f9f9f6;
}

.patterns-featured__visual img {
  display: block;
  width: 100%;
  height: 12.5rem;
  object-fit: contain;
  object-position: center;
}

@media (min-width: 40rem) {
  .patterns-featured__panel {
    grid-template-columns: minmax(16rem, 1.15fr) minmax(0, 0.95fr);
  }

  .patterns-featured__visual {
    min-height: 18rem;
    align-self: stretch;
  }

  .patterns-featured__visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
}

.patterns-featured__body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.7rem;
  min-width: 0;
}

.patterns-featured__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  width: 100%;
}

.patterns-featured__eyebrow {
  margin: 0;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--kbm-green, #52682d);
}

.patterns-featured__badge {
  flex-shrink: 0;
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: #52682d;
  background: #f0f4eb;
  border: 1px solid #c7d8a4;
  border-radius: 999px;
  padding: 0.2rem 0.55rem;
}

.patterns-featured__title {
  margin: 0;
  font-size: clamp(1.28rem, 2.6vw, 1.5rem);
  font-weight: 600;
  line-height: 1.25;
  color: var(--kbm-green, #52682d);
}

.patterns-featured__copy {
  margin: 0;
  font-size: 1rem;
  line-height: 1.55;
  color: #243015;
}

.patterns-featured__cta {
  display: inline-block;
  margin-top: 0.35rem;
  padding: 0.7rem 1.2rem;
  font-size: 0.88rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: #fff;
  background: var(--kbm-accent, #C2614E);
  border-radius: 8px;
}

.patterns-featured__panel:hover .patterns-featured__cta,
.patterns-featured__panel:focus-visible .patterns-featured__cta {
  background: var(--kbm-accent-hover, #a94e3d);
}

.patterns-featured__reassurance {
  margin: 0;
  font-size: 0.88rem;
  line-height: 1.45;
  color: #4d5a48;
}

.patterns-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

/* Catalog card */
.catalog-card {
  display: flex;
  flex-direction: column;
  border-radius: 12px;
  background: #fff;
  border: 1px solid #d6dbc9;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  text-decoration: none;
  color: inherit;
  overflow: hidden;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

a.catalog-card:hover,
a.catalog-card:focus-visible {
  border-color: #52682d;
  box-shadow: 0 6px 16px rgba(82, 104, 45, 0.14);
  transform: translateY(-2px);
}

a.catalog-card:focus-visible {
  outline: 2px solid #52682d;
  outline-offset: 2px;
}

.catalog-card__media {
  width: 100%;
  aspect-ratio: 1 / 1;
  background-color: transparent;
  background-image: url("/images/patterns/background.webp");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  border-bottom: 1px solid #eef0e6;
}

.catalog-card__media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.catalog-card__placeholder {
  width: 100%;
  height: 100%;
  background:
    repeating-linear-gradient(
      135deg,
      #f3f4ec,
      #f3f4ec 14px,
      #eceee2 14px,
      #eceee2 28px
    );
}

.catalog-card__body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 18px 18px 20px;
}

.catalog-card__status {
  display: inline-block;
  align-self: flex-start;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 3px 9px;
  border-radius: 999px;
  margin-bottom: 10px;
}

.catalog-card__status--available {
  display: inline-flex;
  align-items: baseline;
  gap: 0.3em;
  padding: 0.28em 0.7em 0.3em;
  color: #52682d;
  background: #eef2e3;
}

.catalog-card__status-count {
  font-size: 1.6em;
  font-weight: 800;
  letter-spacing: 0.01em;
  line-height: 1;
}

.catalog-card__status-rest {
  font-size: 1em;
  font-weight: 700;
  line-height: 1.2;
}

.catalog-card__status--soon {
  color: #6b7280;
  background: #f0f1ee;
}

.catalog-card__title {
  margin: 0 0 8px;
  font-size: 1.1rem;
  font-weight: 600;
  color: #333;
}

.catalog-card__copy {
  margin: 0 0 16px;
  font-size: 0.95rem;
  line-height: 1.5;
  color: #555;
  flex: 1;
}

.catalog-card__cta {
  margin-top: auto;
  text-align: center;
}

/* Coming soon variant */
.catalog-card--soon {
  cursor: default;
}

.catalog-card--soon .catalog-card__media {
  opacity: 0.75;
}

/* Responsive: tablet 2-up, mobile 1-up */
@media (max-width: 900px) {
  .patterns-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .patterns-hero {
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
  }

  .patterns-hero__actions {
    width: 100%;
  }

  .patterns-hero__btn {
    width: 100%;
  }

  .patterns-grid {
    grid-template-columns: 1fr;
  }
}
</style>
