---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Patterns Catalog">

    <div class="patterns-page">

        <!-- Featured Patterns -->
        <section>
          <h1>Custom Machine Knitting Patterns</h1>
          
          <p class="machine-note">
            Check out our new Express Builder—the fastest way to a custom knitting pattern.
          </p>

          <a href="/patterns/sleeveless-express" class="patterns-express-featured">
            <div class="patterns-express-featured__content">
              <div class="patterns-express-featured__heading-group">
                <img
                  class="patterns-express-featured__accent-icon"
                  src="/images/express-icon.svg"
                  alt=""
                  width="32"
                  height="32"
                  loading="eager"
                  decoding="async"
                  aria-hidden="true"
                />
                <h2 class="patterns-express-featured__title">Build your sweater with the new Express Pattern System</h2>
              </div>
              <p class="patterns-express-featured__body">
                Choose your size, neckline, fit, and gauge to generate a ready-to-knit sweater pattern with interactive instructions and printable output.
              </p>
              <span class="kbm-btn kbm-btn-accent patterns-express-featured__cta">
                <img
                  class="patterns-express-featured__cta-icon"
                  src="/images/express-icon.svg"
                  alt=""
                  width="16"
                  height="16"
                  decoding="async"
                  aria-hidden="true"
                />
                Try Express Build
              </span>
            </div>
            <div class="patterns-express-featured__preview">
              <img
                class="patterns-express-featured__preview-img"
                src="/images/patterns/express-intro.png"
                alt="Express Pattern Builder — style choices and garment preview"
                width="720"
                height="540"
                loading="eager"
                decoding="async"
              />
            </div>
          </a>
      
          <div class="patterns-featured-clean">
            <a href="/patterns/hat" class="pattern-card patterns-featured-card">
              <img class="patterns-featured-card-img" src="/images/patterns/basic-hat.webp" alt="Basic hat pattern" />
              <h2>Hat Pattern Builder</h2>
              <p class="promise">
                Knit a hat that actually fits - your head, your gauge, your machine.
              </p>
              <div class="supporting">
                <ul>
                  <li><strong>Choose</strong> your brim style</li>
                  <li><strong>Adjust</strong> sizing for the perfect fit</li>
                  <li><strong>Generate</strong> instructions instantly</li>
                </ul>
              </div>
              <span class="price-note">Free</span>
              <span class="kbm-btn kbm-btn-accent">Create your hat</span>
            </a>
      
            <a href="/patterns/diy-blanket" class="pattern-card patterns-featured-card">
              <img class="patterns-featured-card-img" src="/images/hybrid-blanket1.webp" alt="Custom blanket builder" />
              <h2>Blanket Pattern Builder</h2>
              <p class="promise">
                Create a custom blanket pattern for your yarn, your gauge, and your machine.
              </p>
              <div class="supporting">
                <ul>
                  <li><strong>Choose</strong> a standard size — or create your own</li>
                  <li><strong>Plan</strong> panels for blankets wider than your machine</li>
                  <li><strong>Estimate</strong> yarn from a swatch</li>
                </ul>
              </div>
              <span class="price-note">Free</span>
              <span class="kbm-btn kbm-btn-accent">Create your blanket</span>
            </a>
          </div>
        </section>

    <section class="patterns-coming-soon">
      <h2 class="patterns-coming-title">More Patterns Coming</h2>
      <p class="patterns-coming-subtitle">
        Hat and blanket builders are live — more pattern types are on the way.
      </p>

      <div class="patterns-coming-grid">
        <div class="patterns-coming-card pattern-card coming-card">
          <img src="/images/sweater.svg" alt="Sweater patterns" />
          <h3>Sweaters</h3>
          <p>Custom-fit garments with shaping guidance.</p>
          <span class="coming-soon"><em>On the drawing board</em></span>
        </div>

        <div class="patterns-coming-card pattern-card coming-card">
          <img src="/images/sock.svg" alt="Sock patterns" />
          <h3>Socks</h3>
          <p>Small projects with more precise fit and shaping.</p>
          <span class="coming-soon"><em>On the drawing board</em></span>
        </div>

        <div class="patterns-coming-card pattern-card coming-card">
          <img src="/images/mitten.svg" alt="Mitten patterns" />
          <h3>Mittens</h3>
          <p>Quick accessory patterns with practical shaping options.</p>
          <span class="coming-soon"><em>On the drawing board</em></span>
        </div>
      </div>

      <p class="drawing-board-feedback">
        <a href="mailto:support@knititnow.com?subject=Pattern%20Request&body=Hi%20Sue,%0A%0AI%27d%20love%20a%20pattern%20for:%20%0A%0AType%20(e.g.%20hat,%20sweater,%20blanket):%20%0AStyle%20or%20details:%20%0A%0AThanks!">
          Want something else? Tell us what to build next.
        </a>
      </p>
    </section>

  </div>

</Layout>

<style>
.patterns-page {
  max-width: 1000px;
  margin: 0 auto;
  padding: 20px;
}

/* Express featured — primary entry point */
.patterns-express-featured {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
  gap: 28px 36px;
  align-items: center;
  margin: 24px 0 32px;
  padding: 28px 32px;
  border-radius: 12px;
  background: linear-gradient(135deg, #f9f9f6 0%, #fff 55%);
  border: 1px solid #d6dbc9;
  box-shadow: 0 4px 16px rgba(82, 104, 45, 0.1);
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.patterns-express-featured:hover {
  border-color: #52682d;
  box-shadow: 0 6px 20px rgba(82, 104, 45, 0.14);
}

.patterns-express-featured:focus-visible {
  outline: 2px solid #52682d;
  outline-offset: 3px;
}

.patterns-express-featured__content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  min-width: 0;
  padding-right: 4px;
}

.patterns-express-featured__preview {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.patterns-express-featured__preview-img {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  object-fit: contain;
  border-radius: 10px;
  border: 1px solid rgba(82, 104, 45, 0.18);
  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.08),
    0 2px 8px rgba(82, 104, 45, 0.12);
}

.patterns-express-featured__heading-group {
  width: 100%;
  margin-bottom: 4px;
}

.patterns-express-featured__accent-icon {
  display: block;
  width: 32px;
  height: 32px;
  margin: 0 auto 8px;
  object-fit: contain;
}

.patterns-express-featured__title {
  margin: 0 0 8px;
  font-size: 1.35rem;
  font-weight: 600;
  color: #52682d;
  line-height: 1.25;
}

.patterns-express-featured__body {
  margin: 0 0 16px;
  font-size: 1rem;
  font-weight: 500;
  line-height: 1.5;
  color: #333;
  max-width: 36rem;
}

.patterns-express-featured__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  gap: 6px;
  margin-top: 0;
  padding: 10px 18px;
  font-size: 1rem;
  line-height: 1.2;
}

.patterns-express-featured__cta-icon {
  width: 16px;
  height: 16px;
  object-fit: contain;
  flex-shrink: 0;
  filter: brightness(0) invert(1);
}

@media (max-width: 720px) {
  .patterns-express-featured {
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 24px 20px;
    text-align: center;
  }

  .patterns-express-featured__content {
    align-items: center;
    text-align: center;
    padding-right: 0;
  }

  .patterns-express-featured__preview {
    width: 100%;
    max-width: min(100%, 440px);
    margin: 0 auto;
  }

  .patterns-express-featured__preview-img {
    max-width: 100%;
  }

  .patterns-express-featured__title {
    font-size: 1.2rem;
  }
}

/* Featured */
.patterns-featured-clean {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  margin-top: 20px;
  margin-bottom: 28px;
}

.pattern-card {
  display: flex;
  flex-direction: column;
  text-align: center;
  padding: 20px;
  border-radius: 12px;
  background: #fff;
  text-decoration: none;
  color: inherit;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.patterns-featured-card-img {
  width: 100%;
  height: auto;
  max-height: 180px;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: 12px;
}

.pattern-card h2 {
  margin: 8px 0;
}

.pattern-card .promise {
  font-weight: 500;
  margin-bottom: 6px;
}

.pattern-card .supporting {
  font-size: 0.95rem;
  margin-bottom: 0;
}

.patterns-featured-card p {
  font-weight: 600;
}

.patterns-featured-card p.promise {
  font-weight: 600;
}

.supporting ul {
  list-style: none;
  padding-left: 0;
  margin: 0;
  text-align: left;
}

.supporting li {
  position: relative;
  padding-left: 22px;
  margin-bottom: 6px;
  line-height: 1.4;
  font-weight: 400;
}

.supporting li::before {
  content: "✓";
  position: absolute;
  left: 0;
  color: #52682d; /* kin-green */
  font-weight: bold;
}

/* CTA: global .kbm-btn .kbm-btn-accent */
.price-note {
  display: block;
  font-size: 0.85rem;
  color: #52682d; /* kin-green */
  font-weight: 600;
  text-align: center;
  margin: 14px 0 6px;
}

.pattern-card .kbm-btn {
  margin-top: 0;
}

.patterns-coming-soon {
  text-align: center;
  margin-top: 30px;
  border-top: 1px solid #eee;
  padding-top: 20px;
}

.patterns-coming-title {
  font-size: 1.4rem;
  font-weight: 600;
  color: #666;
  margin: 10px 0 10px;
}

.patterns-coming-subtitle {
  color: #666;
  max-width: 600px;
  margin: 0 auto 30px;
}

.patterns-coming-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}

.drawing-board-feedback {
  text-align: center;
  margin-top: 12px;
  font-size: 0.9rem;
}

.drawing-board-feedback a {
  color: #666;
  text-decoration: underline;
}

.drawing-board-feedback a:hover {
  color: #333;
}

.patterns-coming-card {
  background: #f9f9f6;
  border: 1px solid #d6dbc9;
  border-radius: 12px;
  padding: 24px;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.patterns-coming-card img {
  width: 48px;
  height: 48px;
  margin: 0 auto 10px;
  display: block;
  object-fit: contain;
  opacity: 0.7;
}

.patterns-coming-card h3 {
  margin: 10px 0 6px;
  color: #52682d;
}

.patterns-coming-card p {
  font-size: 0.9rem;
  color: #555;
  margin: 0 0 12px;
}

.coming-card {
  opacity: 0.65;
}

.coming-card:hover {
  opacity: 0.65;
  transform: none;
  cursor: default;
}

.coming-soon {
  display: inline-block;
  font-size: 0.8rem;
  color: #666;
  margin-top: 10px;
}
</style>