---
import Layout from '../../layouts/Layout.astro';
import { buildSleevelessExpressNewPatternHref } from '../../lib/patterns/patternStorage';

// NOTE: The previous sales-style hero and "Why These Patterns Are Different"
// feature grid were moved off this catalog page (not deleted):
//   - <PatternsMarketingHero />     (src/components/patterns/PatternsMarketingHero.astro)
//   - <PatternsFeaturesSection />   (src/components/patterns/PatternsFeaturesSection.astro)
// TODO(about-page): surface these on a future "About the Pattern Builders" page.

const startNewPatternHref = buildSleevelessExpressNewPatternHref();

const availablePatterns = [
  {
    title: 'Sleeveless Sweater',
    href: '/patterns/sleeveless',
    image: '/images/patterns/sleeveless/people/sleeveless-woman-pullover-round-neck.webp',
    copy: 'Custom-fit sleeveless sweaters with pullover or cardigan fronts, round or V-neck styling, and printable row-by-row instructions.',
    button: 'Create sleeveless sweater',
  },
  {
    title: 'Hat Pattern Builder',
    href: '/patterns/hat',
    image: '/images/patterns/basic-hat.webp',
    copy: 'Knit a hat that actually fits with brim choices, custom sizing, and machine-friendly instructions.',
    button: 'Create your hat',
  },
  {
    title: 'Blanket Pattern Builder',
    // Existing working route preserved (no /patterns/blanket page exists).
    href: '/patterns/diy-blanket',
    image: '/images/hybrid-blanket1.webp',
    copy: 'Build a custom blanket pattern for your yarn, your gauge, and your machine.',
    button: 'Create your blanket',
  },
];

const comingSoonPatterns = [
  {
    title: 'Drop Shoulder Sweater',
    image: '/images/patterns/drop-shoulder/drop-shoulder-men-pullover-round-neck.webp',
    copy: 'A relaxed sweater system with simple shaping and machine-friendly construction.',
  },
  {
    title: 'Raglan Sweater',
    image: '/images/patterns/raglan/raglan-woman-cardigan-v-neck.webp',
    copy: 'A flexible raglan sweater system with custom fit and clear shaping guidance.',
  },
  {
    title: 'Set-In Sleeve Sweater',
    image: '/images/patterns/set-in-sleeve/set-in-kids-pullover-round-neck.webp',
    copy: 'A classic sweater system designed for custom fit, sleeve shaping, and polished finishing.',
  },
];
---

<Layout title="Pattern Builders">

  <div class="patterns-page">

    <header class="patterns-intro">
      <h1 class="patterns-intro__title">Pattern Builders</h1>
      <p class="patterns-intro__subtitle">
        Choose a pattern system and create instructions for your machine, your yarn, and your gauge.
      </p>
    </header>

    <nav class="patterns-action-bar" aria-label="Pattern workspace actions">
      <a href={startNewPatternHref} class="patterns-action-bar__btn kbm-btn kbm-btn-accent">
        Start a New Pattern
      </a>
      <a href="/account#my-patterns" class="patterns-action-bar__btn kbm-btn kbm-btn-outline">
        My Patterns
      </a>
    </nav>

    <section class="patterns-catalog" aria-labelledby="patterns-available-heading">
      <h2 id="patterns-available-heading" class="patterns-section-title">Available now</h2>
      <div class="patterns-grid">
        {availablePatterns.map((pattern) => (
          <a href={pattern.href} class="catalog-card">
            <div class="catalog-card__media">
              <img src={pattern.image} alt={pattern.title} loading="lazy" decoding="async" />
            </div>
            <div class="catalog-card__body">
              <span class="catalog-card__status catalog-card__status--available">Available now</span>
              <h3 class="catalog-card__title">{pattern.title}</h3>
              <p class="catalog-card__copy">{pattern.copy}</p>
              <span class="catalog-card__cta kbm-btn kbm-btn-accent">{pattern.button}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="patterns-catalog" aria-labelledby="patterns-coming-heading">
      <h2 id="patterns-coming-heading" class="patterns-section-title">Coming soon</h2>
      <div class="patterns-grid">
        {comingSoonPatterns.map((pattern) => (
          <div class="catalog-card catalog-card--soon" aria-disabled="true">
            <div class="catalog-card__media">
              {pattern.image
                ? <img src={pattern.image} alt={pattern.title} loading="lazy" decoding="async" />
                : <div class="catalog-card__placeholder" aria-hidden="true"></div>}
            </div>
            <div class="catalog-card__body">
              <span class="catalog-card__status catalog-card__status--soon">Coming soon</span>
              <h3 class="catalog-card__title">{pattern.title}</h3>
              <p class="catalog-card__copy">{pattern.copy}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>

</Layout>

<style>
.patterns-page {
  max-width: 1000px;
  margin: 0 auto;
  padding: 20px;
}

/* Intro */
.patterns-intro {
  margin: 0 0 20px;
}

.patterns-intro__title {
  margin: 0 0 8px;
  font-size: clamp(1.6rem, 3vw, 2rem);
  font-weight: 600;
  color: #52682d;
  line-height: 1.2;
}

.patterns-intro__subtitle {
  margin: 0;
  max-width: 42rem;
  font-size: 1.02rem;
  line-height: 1.55;
  color: #4d5a48;
}

/* Action bar */
.patterns-action-bar {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin: 0 0 28px;
}

.patterns-action-bar__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 3.25rem;
  padding: 0.85rem 1.25rem;
  margin: 0;
  font-size: 1.05rem;
  font-weight: 600;
  text-align: center;
  text-decoration: none;
}

/* Catalog sections */
.patterns-catalog {
  margin: 0 0 32px;
}

.patterns-section-title {
  margin: 0 0 16px;
  font-size: 1.2rem;
  font-weight: 600;
  color: #52682d;
}

.patterns-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

/* Catalog card */
.catalog-card {
  display: flex;
  flex-direction: column;
  border-radius: 12px;
  background: #fff;
  border: 1px solid #d6dbc9;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  text-decoration: none;
  color: inherit;
  overflow: hidden;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

a.catalog-card:hover,
a.catalog-card:focus-visible {
  border-color: #52682d;
  box-shadow: 0 6px 16px rgba(82, 104, 45, 0.14);
  transform: translateY(-2px);
}

a.catalog-card:focus-visible {
  outline: 2px solid #52682d;
  outline-offset: 2px;
}

.catalog-card__media {
  width: 100%;
  aspect-ratio: 1 / 1;
  background: #f9f9f6;
  border-bottom: 1px solid #eef0e6;
}

.catalog-card__media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.catalog-card__placeholder {
  width: 100%;
  height: 100%;
  background:
    repeating-linear-gradient(
      135deg,
      #f3f4ec,
      #f3f4ec 14px,
      #eceee2 14px,
      #eceee2 28px
    );
}

.catalog-card__body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 18px 18px 20px;
}

.catalog-card__status {
  display: inline-block;
  align-self: flex-start;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 3px 9px;
  border-radius: 999px;
  margin-bottom: 10px;
}

.catalog-card__status--available {
  color: #52682d;
  background: #eef2e3;
}

.catalog-card__status--soon {
  color: #6b7280;
  background: #f0f1ee;
}

.catalog-card__title {
  margin: 0 0 8px;
  font-size: 1.1rem;
  font-weight: 600;
  color: #333;
}

.catalog-card__copy {
  margin: 0 0 16px;
  font-size: 0.95rem;
  line-height: 1.5;
  color: #555;
  flex: 1;
}

.catalog-card__cta {
  margin-top: auto;
  text-align: center;
}

/* Coming soon variant */
.catalog-card--soon {
  cursor: default;
}

.catalog-card--soon .catalog-card__media {
  opacity: 0.75;
}

/* Responsive: tablet 2-up, mobile 1-up */
@media (max-width: 900px) {
  .patterns-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .patterns-action-bar {
    grid-template-columns: 1fr;
  }

  .patterns-grid {
    grid-template-columns: 1fr;
  }
}
</style>
