---
import Layout from '../../layouts/Layout.astro';
import PatternBuilderMyPatternsLink from '../../components/patterns/PatternBuilderMyPatternsLink.astro';
import PatternGaugeDemo from '../../components/patterns/PatternGaugeDemo.astro';
import { isDropShoulderProductionBlocked } from '../../lib/patterns/dropShoulderProductionAccess';
import { isSidewaysCardiganProductionBlocked } from '../../lib/patterns/sidewaysCardiganProductionAccess';
import { PATTERN_BUILDERS_HOME_HREF } from '../../lib/patterns/customPatternProjectNavigation';
import {
  PATTERN_CATALOG_MEMBER_HEADLINE,
  PATTERN_CATALOG_MEMBER_LEAD,
  PATTERN_CATALOG_MEMBERSHIP_BODY,
  PATTERN_CATALOG_MORE_HEADING,
  PATTERN_CATALOG_SIGNED_IN_MEMBERSHIP_BODY,
  PATTERNS_LANDING_BECOME_MEMBER_HREF,
  PATTERNS_LANDING_BECOME_MEMBER_LABEL,
  PATTERNS_LANDING_JOIN_OR_RENEW_LABEL,
  PATTERNS_LANDING_LOGIN_LABEL,
} from '../../lib/patterns/patternsLandingCta';
import { SOCKS_CATALOG_COPY } from '../../lib/patterns/patternCatalogPossibilities';

// Public Pattern Builders showcase. One library array feeds every audience.
// Logged-out and signed-in visitors without member access see the free Hat.
// Active members, including legacy paid-through, see the same builders without that offer.
// Sweater, sock, and sideways builders enforce their own membership gates.

type CatalogCard = {
  title: string;
  href: string;
  image: string;
  copy: string;
  button: string;
  free?: boolean;
};

const hideDropShoulderInCatalog = isDropShoulderProductionBlocked(Astro.url.hostname, {
  isViteDev: import.meta.env.DEV,
  publicSiteEnv: import.meta.env.PUBLIC_SITE_ENV,
});

const showSidewaysAsComingSoon = isSidewaysCardiganProductionBlocked(Astro.url.hostname, {
  isViteDev: import.meta.env.DEV,
  publicSiteEnv: import.meta.env.PUBLIC_SITE_ENV,
});

const dropShoulderPattern: CatalogCard = {
  title: 'Drop Shoulder Sweater',
  // Public landing page. The landing CTA starts a fresh builder session with `?new=1`.
  href: '/patterns/drop-shoulder',
  image: '/images/patterns/drop_shoulder.webp',
  copy: 'A relaxed drop-shoulder sweater, cuff-up or top-down, in your size and style.',
  button: 'Create drop shoulder sweater',
};

const hatPattern: CatalogCard = {
  title: 'Hat',
  // `?new=1` clears any leftover kbm_hat_draft / saved-project identity on boot so
  // catalog “Create your hat” always starts a new Hat (mirrors sleeveless / drop-shoulder).
  href: '/patterns/hat/builder?new=1',
  image: '/images/patterns/hat.webp',
  copy: 'A hat in your gauge, with brim and crown choices and machine-knitting instructions.',
  button: 'Create your hat',
};

const sleevelessPattern: CatalogCard = {
  title: 'Sleeveless Sweater',
  // Public landing page. The landing CTA starts a fresh builder session with `?new=1`.
  href: '/patterns/sleeveless',
  image: '/images/patterns/sleeveless.webp',
  copy: 'A sleeveless pullover or cardigan in your gauge, with the neckline and front you choose.',
  button: 'Create sleeveless sweater',
};

const socksPattern: CatalogCard = {
  title: 'Socks',
  // Public landing page. Active members stay here and start a new pattern.
  // Former members who still own saved Socks are sent to `/account#my-patterns`.
  href: '/patterns/socks',
  image: '/images/patterns/socks-v2.png',
  copy: SOCKS_CATALOG_COPY,
  button: 'Create your socks',
};

const sidewaysPattern: CatalogCard = {
  title: 'Sideways Knit Sweater',
  // Public landing page on DEV. Production still hides this live card.
  href: '/patterns/sideways-cardigan',
  image: '/images/patterns/sideways.png',
  copy: 'A cardigan or pullover knitted sideways, sized for your gauge and needle bed.',
  button: 'Create sideways knit sweater',
};

const availablePatterns: CatalogCard[] = [
  hatPattern,
  sleevelessPattern,
  socksPattern,
  ...(hideDropShoulderInCatalog ? [] : [dropShoulderPattern]),
  ...(showSidewaysAsComingSoon ? [] : [sidewaysPattern]),
  // Blanket Pattern Builder — POSTPONED for the August launch. Hidden from the public catalog but the
  // route /patterns/diy-blanket is intact and reachable by direct URL for future development/testing.
  // Uncomment this entry to bring the Blanket builder back to the catalog.
  // {
  //   title: 'Blanket Pattern Builder',
  //   // Existing working route preserved (no /patterns/blanket page exists).
  //   href: '/patterns/diy-blanket',
  //   image: '/images/hybrid-blanket1.webp',
  //   copy: 'Build a custom blanket pattern for your yarn, your gauge, and your machine.',
  //   button: 'Create your blanket',
  // },
];

const guestPatterns: CatalogCard[] = availablePatterns.map((pattern) =>
  pattern.title === 'Hat' ? { ...pattern, free: true } : pattern,
);

const comingSoonPatterns = [
  ...(showSidewaysAsComingSoon
    ? [{
        title: sidewaysPattern.title,
        image: sidewaysPattern.image,
        copy: sidewaysPattern.copy,
      }]
    : []),
  {
    title: 'Raglan Sweater',
    image: '/images/patterns/raglan.png',
    copy: 'A raglan sweater shaped from your gauge, with the fit you choose.',
  },
  {
    title: 'Set-In Sleeve Sweater',
    image: '/images/patterns/set-in.png',
    copy: 'A set-in sleeve sweater with custom sizing and sleeve shaping.',
  },
];

const benefits = [
  { label: 'Your gauge', text: 'Knit using your gauge, not someone else\'s.' },
  { label: 'Your size', text: 'Choose the size and fit you want.' },
  { label: 'Your style', text: 'Customize the options that builder offers.' },
  { label: 'Your machine', text: 'Generate instructions for your knitting machine.' },
  { label: 'Your patterns', text: 'Save a completed pattern and return to it.' },
];
---

<Layout
  title="Pattern Builders"
  description="Build machine-knitting instructions from your gauge, size, and style. Pattern Builders are included with Knit It Now membership. The Hat builder is free to try."
>

  <div class="patterns-page" data-patterns-page>
    <script is:inline>
      document.currentScript.parentElement.setAttribute("data-patterns-access", "pending");
    </script>

    <header class="patterns-hero">
      <div class="patterns-hero__text">
        <p class="patterns-hero__eyebrow">Pattern Builders</p>
        <div data-patterns-sales>
          <h1 class="patterns-intro__title">Your Gauge. Your Size. Your Style. Your Pattern.</h1>
          <p class="patterns-intro__lead">
            Stop searching for a pattern that might work. Build one that works for you.
          </p>
        </div>
        <div data-patterns-member-intro hidden>
          <h1 class="patterns-intro__title">{PATTERN_CATALOG_MEMBER_HEADLINE}</h1>
          <p class="patterns-intro__lead">{PATTERN_CATALOG_MEMBER_LEAD}</p>
        </div>
      </div>
      <div class="patterns-hero__actions">
        <div data-ms-content="!members">
          <a
            href={PATTERN_BUILDERS_HOME_HREF}
            class="patterns-hero__btn kbm-btn kbm-btn-outline"
            data-testid="patterns-catalog-about"
          >
            About Knit It Now Patterns
          </a>
        </div>
        <div data-ms-content="members">
          <PatternBuilderMyPatternsLink class="patterns-hero__btn kbm-btn kbm-btn-outline" />
        </div>
      </div>
    </header>

    <div data-patterns-sales>
      <PatternGaugeDemo />

      <p class="patterns-intro__subtitle">
        Pattern Builders create personalized machine-knitting instructions from your gauge, your measurements, your machine's capacity, and the design choices you make.
      </p>

      <ul class="patterns-benefits">
        {benefits.map((benefit) => (
          <li>
            <strong>{benefit.label}</strong>
            <span>{benefit.text}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="patterns-catalog-group" data-patterns-catalog="guest">
      <section class="patterns-catalog" aria-labelledby="patterns-library-heading">
        <h2 id="patterns-library-heading" class="patterns-section-title">{PATTERN_CATALOG_MORE_HEADING}</h2>
        <p class="patterns-section-note">The Hat builder is free. Open a project and build it in your gauge.</p>
        <div class="patterns-grid">
          {guestPatterns.map((pattern) => (
            <a
              href={pattern.href}
              class:list={["catalog-card", pattern.free && "catalog-card--free"]}
              data-testid={pattern.free ? "patterns-featured-hat" : undefined}
              {...(pattern.title === "Socks" ? { "data-socks-catalog-card": "" } : {})}
            >
              <div class="catalog-card__media">
                <img src={pattern.image} alt={pattern.title} loading="lazy" decoding="async" />
              </div>
              <div class="catalog-card__body">
                {pattern.free && <span class="catalog-card__badge">Free. No account or password needed.</span>}
                <h3 class="catalog-card__title">{pattern.title}</h3>
                <p class="catalog-card__copy">{pattern.copy}</p>
                <span class="catalog-card__cta kbm-btn kbm-btn-accent">{pattern.button}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>

    <div class="patterns-catalog-group" data-patterns-catalog="member" hidden>
      <section class="patterns-catalog" aria-labelledby="patterns-available-heading">
        <h2 id="patterns-available-heading" class="patterns-section-title">{PATTERN_CATALOG_MORE_HEADING}</h2>
        <p class="patterns-section-note">Open a builder and start with your gauge.</p>
        <div class="patterns-grid">
          {availablePatterns.map((pattern) => (
            <a
              href={pattern.href}
              class="catalog-card"
              {...(pattern.title === "Socks" ? { "data-socks-catalog-card": "" } : {})}
            >
              <div class="catalog-card__media">
                <img src={pattern.image} alt={pattern.title} loading="lazy" decoding="async" />
              </div>
              <div class="catalog-card__body">
                <h3 class="catalog-card__title">{pattern.title}</h3>
                <p class="catalog-card__copy">{pattern.copy}</p>
                <span class="catalog-card__cta kbm-btn kbm-btn-accent">{pattern.button}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>

    <section class="patterns-catalog patterns-catalog--soon" aria-labelledby="patterns-coming-heading">
      <h2 id="patterns-coming-heading" class="patterns-section-title">Coming soon</h2>
      <div class="patterns-grid">
        {comingSoonPatterns.map((pattern) => (
          <div class="catalog-card catalog-card--soon" aria-disabled="true">
            <div class="catalog-card__media">
              {pattern.image
                ? <img src={pattern.image} alt={pattern.title} loading="lazy" decoding="async" />
                : <div class="catalog-card__placeholder" aria-hidden="true"></div>}
            </div>
            <div class="catalog-card__body">
              <span class="catalog-card__status catalog-card__status--soon">Coming soon</span>
              <h3 class="catalog-card__title">{pattern.title}</h3>
              <p class="catalog-card__copy">{pattern.copy}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <div data-patterns-sales>
    <section class="patterns-steps-section" aria-labelledby="patterns-steps-heading">
      <h2 id="patterns-steps-heading" class="patterns-section-title">How it works</h2>
      <ol class="patterns-steps">
        <li>
          <span class="patterns-step__num" aria-hidden="true">1</span>
          <h3>Choose Your Project</h3>
          <p>Select the garment or accessory you want to knit.</p>
        </li>
        <li>
          <span class="patterns-step__num" aria-hidden="true">2</span>
          <h3>Make It Yours</h3>
          <p>Enter your gauge, choose your size, and customize the options that builder offers.</p>
        </li>
        <li>
          <span class="patterns-step__num" aria-hidden="true">3</span>
          <h3>Create Your Pattern</h3>
          <p>Generate knitting instructions tailored to your choices.</p>
        </li>
      </ol>
    </section>

    <section
      class="patterns-membership patterns-catalog-group"
      data-patterns-catalog="guest"
      aria-labelledby="patterns-membership-heading"
    >
      <div class="patterns-membership__panel">
        <h2 id="patterns-membership-heading" class="patterns-section-title">Included with membership</h2>
        <p class="patterns-membership__body" data-patterns-audience="loggedOut">{PATTERN_CATALOG_MEMBERSHIP_BODY}</p>
        <p class="patterns-membership__body" data-patterns-audience="loggedInNoAccess" hidden>{PATTERN_CATALOG_SIGNED_IN_MEMBERSHIP_BODY}</p>
        <nav
          class="patterns-action-bar"
          aria-label="Pattern builder actions"
          data-patterns-landing-cta
          data-cta-mode="prospect"
        >
          <div class="patterns-action-bar__prospect" data-patterns-landing-cta-prospect>
            <div class="patterns-action-bar__prospect-actions" data-patterns-audience="loggedOut">
              <a
                href={PATTERNS_LANDING_BECOME_MEMBER_HREF}
                class="patterns-action-bar__primary kbm-btn kbm-btn-accent"
              >
                {PATTERNS_LANDING_BECOME_MEMBER_LABEL}
              </a>
              <a
                href="#"
                class="patterns-action-bar__login kbm-btn kbm-btn-outline"
                data-ms-modal="login"
                data-ms-redirect="current-url"
              >
                {PATTERNS_LANDING_LOGIN_LABEL}
              </a>
            </div>
            <div class="patterns-action-bar__prospect-actions" data-patterns-audience="loggedInNoAccess" hidden>
              <a
                href={PATTERNS_LANDING_BECOME_MEMBER_HREF}
                class="patterns-action-bar__primary kbm-btn kbm-btn-accent"
              >
                {PATTERNS_LANDING_JOIN_OR_RENEW_LABEL}
              </a>
            </div>
          </div>
        </nav>
      </div>
    </section>

    <section class="patterns-trust" aria-labelledby="patterns-trust-heading">
      <h2 id="patterns-trust-heading" class="patterns-section-title">Made for machine knitters</h2>
      <p>
        Pattern Builders are written for machine knitting. You get practical instructions you can follow at the machine — shaping, row counts, and the choices you selected — rather than a generic hand-knitting pattern.
      </p>
      <p>
        Each builder includes the options it was designed for, and the instructions follow the gauge and measurements you enter.
      </p>
    </section>
    </div>

  </div>

</Layout>

<script>
  import { initPatternsLandingCta } from "../../lib/patterns/patternsLandingCta";
  import { initSocksCatalogCardRouting } from "../../lib/patterns/socksCatalogCardAccess";

  function boot(): void {
    const root = document.querySelector("[data-patterns-landing-cta]");
    if (root instanceof HTMLElement) {
      void initPatternsLandingCta(root);
    }
    void initSocksCatalogCardRouting(document);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
</script>

<style>
.patterns-page {
  max-width: 1120px;
  margin: 0 auto;
  padding: 12px 20px 36px;
}

.patterns-catalog-group[hidden],
.patterns-page [data-patterns-audience][hidden],
.patterns-page[data-patterns-access="pending"] [data-patterns-sales],
.patterns-page[data-patterns-access="member"] [data-patterns-sales] {
  display: none !important;
}

.patterns-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin: 0 0 22px;
}

.patterns-hero__text {
  flex: 1 1 auto;
  min-width: 0;
}

.patterns-hero__eyebrow {
  margin: 0 0 8px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--kbm-accent, #c2614e);
}

.patterns-intro__title {
  margin: 0 0 10px;
  font-size: clamp(1.7rem, 3.2vw, 2.35rem);
  font-weight: 600;
  color: #52682d;
  line-height: 1.15;
}

.patterns-intro__lead {
  margin: 0 0 10px;
  max-width: 40rem;
  font-size: 1.12rem;
  font-weight: 600;
  line-height: 1.45;
  color: #243015;
}

.patterns-intro__subtitle {
  margin: 0 0 18px;
  max-width: 42rem;
  font-size: 1.02rem;
  line-height: 1.55;
  color: #4d5a48;
}

.patterns-hero__actions {
  flex: 0 0 auto;
  padding-top: 1.6rem;
}

.patterns-hero__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  min-height: 3rem;
  padding: 0.75rem 1.25rem;
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
  text-align: center;
  text-decoration: none;
  white-space: nowrap;
}

.patterns-benefits {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(11.5rem, 1fr));
  gap: 10px;
  margin: 0 0 28px;
  padding: 0;
  list-style: none;
}

.patterns-benefits li {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin: 0;
  padding: 12px 14px;
  background: #f7f8f3;
  border: 1px solid #e3e8d6;
  border-radius: 10px;
}

.patterns-benefits strong {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #52682d;
}

.patterns-benefits span {
  font-size: 0.92rem;
  line-height: 1.4;
  color: #243015;
}

.patterns-catalog {
  margin: 0 0 28px;
}

.patterns-section-title {
  margin: 0 0 8px;
  font-size: 1.25rem;
  font-weight: 600;
  color: #52682d;
}

.patterns-section-note {
  margin: 0 0 14px;
  max-width: 44rem;
  font-size: 0.98rem;
  line-height: 1.5;
  color: #4d5a48;
}

.patterns-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
  gap: 14px;
}

.catalog-card {
  display: grid;
  grid-template-columns: 7.75rem minmax(0, 1fr);
  align-items: stretch;
  min-height: 8.75rem;
  border-radius: 12px;
  background: #fff;
  border: 1px solid #d6dbc9;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  text-decoration: none;
  color: inherit;
  overflow: hidden;
}

a.catalog-card:hover,
a.catalog-card:focus-visible {
  border-color: #52682d;
  box-shadow: 0 6px 16px rgba(82, 104, 45, 0.14);
}

a.catalog-card:focus-visible {
  outline: 2px solid #52682d;
  outline-offset: 2px;
}

.catalog-card--free {
  border-left: 4px solid var(--kbm-accent, #c2614e);
}

.catalog-card__media {
  position: relative;
  align-self: stretch;
  overflow: hidden;
  min-height: 8.75rem;
  background-color: transparent;
  background-image: url("/images/patterns/background.webp");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  border-right: 1px solid #eef0e6;
}

.catalog-card__media img {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.catalog-card__placeholder {
  width: 100%;
  height: 100%;
  min-height: 8.75rem;
  background:
    repeating-linear-gradient(
      135deg,
      #f3f4ec,
      #f3f4ec 14px,
      #eceee2 14px,
      #eceee2 28px
    );
}

.catalog-card__body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  min-width: 0;
  padding: 12px 14px 14px;
}

.catalog-card__badge,
.catalog-card__status {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 3px 9px;
  border-radius: 999px;
}

.catalog-card__badge {
  color: #52682d;
  background: #eef2e3;
  border: 1px solid #c7d8a4;
}

.catalog-card__status--soon {
  color: #6b7280;
  background: #f0f1ee;
}

.catalog-card__title {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 600;
  line-height: 1.25;
  color: #243015;
}

.catalog-card__copy,
.catalog-card__note {
  margin: 0;
  font-size: 0.92rem;
  line-height: 1.45;
  color: #3d4a38;
}

.catalog-card__note {
  color: #52682d;
  font-weight: 600;
}

.catalog-card__cta {
  margin-top: auto;
  padding: 8px 12px;
  font-size: 0.92rem;
  text-align: center;
}

.catalog-card--soon {
  cursor: default;
}

.catalog-card--soon .catalog-card__media {
  opacity: 0.75;
}

.patterns-steps-section {
  margin: 8px 0 28px;
}

.patterns-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin: 12px 0 0;
  padding: 0;
  list-style: none;
}

.patterns-steps li {
  margin: 0;
  padding: 16px 16px 18px;
  background: #fff;
  border: 1px solid #d6dbc9;
  border-radius: 12px;
}

.patterns-step__num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.75rem;
  height: 1.75rem;
  margin-bottom: 8px;
  border-radius: 999px;
  background: #eef2e3;
  color: #52682d;
  font-size: 0.9rem;
  font-weight: 700;
}

.patterns-steps h3 {
  margin: 0 0 6px;
  font-size: 1.05rem;
  font-weight: 600;
  color: #52682d;
}

.patterns-steps p {
  margin: 0;
  font-size: 0.95rem;
  line-height: 1.5;
  color: #243015;
}

.patterns-membership {
  margin: 0 0 28px;
}

.patterns-membership__panel {
  padding: 20px 22px;
  background: color-mix(in srgb, var(--kbm-green, #52682d) 8%, #ffffff);
  border: 1px solid #c7d8a4;
  border-radius: 12px;
}

.patterns-membership__body {
  margin: 0 0 14px;
  max-width: 40rem;
  font-size: 1.02rem;
  line-height: 1.55;
  color: #243015;
}

.patterns-action-bar {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  margin: 0;
}

.patterns-action-bar[data-cta-mode="member"] {
  display: none;
}

.patterns-action-bar__prospect,
.patterns-action-bar__prospect-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  width: 100%;
}

.patterns-action-bar__primary,
.patterns-action-bar__login {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 14rem;
  min-height: 3rem;
  padding: 0.75rem 1.25rem;
  margin: 0;
  font-size: 1.02rem;
  font-weight: 600;
  text-align: center;
  text-decoration: none;
}

.patterns-trust {
  margin: 0;
  padding: 4px 0 8px;
}

.patterns-trust p {
  margin: 0 0 10px;
  max-width: 44rem;
  font-size: 1rem;
  line-height: 1.55;
  color: #243015;
}

.patterns-trust p:last-child {
  margin-bottom: 0;
}

