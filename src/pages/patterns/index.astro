---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Patterns Catalog">

    <div class="patterns-page">

        <!-- Sleeveless pattern hero -->
        <section class="patterns-hero" aria-labelledby="patterns-hero-heading">
          <div class="patterns-hero__grid">
            <div class="patterns-hero__content">
              <h1 id="patterns-hero-heading">Custom Sweater Patterns Designed for Machine Knitters</h1>
              <p class="patterns-hero__intro">
                The ultimate pattern generator for modern machine knitters. Easily map out your favorite silhouettes, unlock automated shaping math, and create knit-ready sweater patterns in just a few guided steps.
              </p>
              <div class="patterns-hero__actions">
                <a href="/patterns/sleeveless-express" class="kbm-btn kbm-btn-accent">Start a Sleeveless Pattern</a>
                <a href="#pattern-features" class="kbm-btn kbm-btn-outline patterns-features-jump">
                  <img
                    class="patterns-pinwheel"
                    src="/images/KINlogo.svg"
                    alt=""
                    width="22"
                    height="22"
                    decoding="async"
                    aria-hidden="true"
                  />
                  <span>Explore the Pattern Features</span>
                </a>
              </div>
            </div>
            <div class="patterns-hero__media">
              <img
                class="patterns-hero__img"
                src="/images/patterns/patterns-intro.webp"
                alt="Sleeveless sweater pattern workspace showing size, fit, neckline, and gauge choices"
                width="720"
                height="540"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </section>

        <section id="pattern-features" class="patterns-features" aria-labelledby="patterns-features-heading">
          <div class="patterns-features__header">
            <img
              class="patterns-pinwheel"
              src="/images/KINlogo.svg"
              alt=""
              width="22"
              height="22"
              decoding="async"
              aria-hidden="true"
            />
            <h2 id="patterns-features-heading" class="patterns-features__title">Why These Patterns Are Different</h2>
          </div>
          <ul class="patterns-features__grid">
            <li>
              <button
                type="button"
                class="patterns-feature-card"
                data-feature-title="Interactive row tracking"
                data-feature-media="/images/patterns/features/Chart-Action.gif"
                aria-haspopup="dialog"
              >Interactive Row Tracking</button>
            </li>
            <li>
              <button
                type="button"
                class="patterns-feature-card"
                data-feature-title="Japanese Shaping Notation"
                data-feature-media="/images/patterns/features/shaping-notation.gif"
                aria-haspopup="dialog"
              >Japanese Shaping Notation</button>
            </li>
            <li>
              <button
                type="button"
                class="patterns-feature-card"
                data-feature-title="Custom Fit & Ease Options"
                data-feature-media="/images/patterns/features/fit-ease.png"
                aria-haspopup="dialog"
              >Custom Fit &amp; Ease Options</button>
            </li>
            <li>
              <button
                type="button"
                class="patterns-feature-card"
                data-feature-title="Built-in Knitting Help"
                data-feature-media="/images/patterns/features/tips.gif"
                aria-haspopup="dialog"
              >Built-In Knitting Help</button>
            </li>
            <li>
              <button
                type="button"
                class="patterns-feature-card"
                data-feature-title="Printable Pattern Output"
                data-feature-media="/images/patterns/features/print.gif"
                aria-haspopup="dialog"
              >Printable Pattern Output</button>
            </li>
            <li>
              <button
                type="button"
                class="patterns-feature-card"
                data-feature-title="Designed for your machine and gauge"
                data-feature-media="/images/patterns/features/gauge.gif"
                aria-haspopup="dialog"
              >Designed for Your Machine &amp; Gauge</button>
            </li>
          </ul>
        </section>

        <section aria-label="Additional pattern builders">
          <div class="patterns-featured-clean">
            <a href="/patterns/hat" class="pattern-card patterns-featured-card">
              <img class="patterns-featured-card-img" src="/images/patterns/basic-hat.webp" alt="Basic hat pattern" />
              <h2>Hat Pattern Builder</h2>
              <p class="promise">
                Knit a hat that actually fits - your head, your gauge, your machine.
              </p>
              <div class="supporting">
                <ul>
                  <li><strong>Choose</strong> your brim style</li>
                  <li><strong>Adjust</strong> sizing for the perfect fit</li>
                  <li><strong>Generate</strong> instructions instantly</li>
                </ul>
              </div>
              <span class="price-note">Free</span>
              <span class="kbm-btn kbm-btn-accent">Create your hat</span>
            </a>
      
            <a href="/patterns/diy-blanket" class="pattern-card patterns-featured-card">
              <img class="patterns-featured-card-img" src="/images/hybrid-blanket1.webp" alt="Custom blanket builder" />
              <h2>Blanket Pattern Builder</h2>
              <p class="promise">
                Create a custom blanket pattern for your yarn, your gauge, and your machine.
              </p>
              <div class="supporting">
                <ul>
                  <li><strong>Choose</strong> a standard size — or create your own</li>
                  <li><strong>Plan</strong> panels for blankets wider than your machine</li>
                  <li><strong>Estimate</strong> yarn from a swatch</li>
                </ul>
              </div>
              <span class="price-note">Free</span>
              <span class="kbm-btn kbm-btn-accent">Create your blanket</span>
            </a>
          </div>
        </section>

        <section class="patterns-coming-soon">
      <h2 class="patterns-coming-title">More Patterns Coming</h2>
      <p class="patterns-coming-subtitle">
        Hat and blanket builders are live — more pattern types are on the way.
      </p>

      <div class="patterns-coming-grid">
        <div class="patterns-coming-card pattern-card coming-card">
          <img src="/images/sweater.svg" alt="Sweater patterns" />
          <h3>Sweaters</h3>
          <p>Custom-fit garments with shaping guidance.</p>
          <span class="coming-soon"><em>On the drawing board</em></span>
        </div>

        <div class="patterns-coming-card pattern-card coming-card">
          <img src="/images/sock.svg" alt="Sock patterns" />
          <h3>Socks</h3>
          <p>Small projects with more precise fit and shaping.</p>
          <span class="coming-soon"><em>On the drawing board</em></span>
        </div>

        <div class="patterns-coming-card pattern-card coming-card">
          <img src="/images/mitten.svg" alt="Mitten patterns" />
          <h3>Mittens</h3>
          <p>Quick accessory patterns with practical shaping options.</p>
          <span class="coming-soon"><em>On the drawing board</em></span>
        </div>
      </div>

      <p class="drawing-board-feedback">
        <a href="mailto:support@knititnow.com?subject=Pattern%20Request&body=Hi%20Sue,%0A%0AI%27d%20love%20a%20pattern%20for:%20%0A%0AType%20(e.g.%20hat,%20sweater,%20blanket):%20%0AStyle%20or%20details:%20%0A%0AThanks!">
          Want something else? Tell us what to build next.
        </a>
      </p>
    </section>

    <div
      class="patterns-feature-preview-modal"
      data-patterns-feature-preview-modal
      hidden
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-labelledby="patterns-feature-preview-title"
    >
      <div
        class="patterns-feature-preview-modal__dialog"
        data-patterns-feature-preview-dialog
      >
        <div class="patterns-feature-preview-modal__actions">
          <button
            type="button"
            class="patterns-feature-preview-modal__close"
            data-patterns-feature-preview-close
            aria-label="Close feature preview"
          >X</button>
        </div>
        <h2 id="patterns-feature-preview-title" class="patterns-feature-preview-modal__title" data-patterns-feature-preview-title></h2>
        <div class="patterns-feature-preview-modal__media-wrap">
          <img
            class="patterns-feature-preview-modal__media"
            data-patterns-feature-preview-media
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>

  </div>

</Layout>

<script>
  import { initPatternsFeaturePreviewModal } from "../../scripts/patternsFeaturePreviewModal.ts";
  initPatternsFeaturePreviewModal();
</script>

<style>
.patterns-page {
  max-width: 1000px;
  margin: 0 auto;
  padding: 20px;
}

/* Hero — sleeveless pattern experience */
.patterns-hero {
  margin: 8px 0 12px;
  padding: 32px 36px;
  border-radius: 12px;
  background: linear-gradient(135deg, #f9f9f6 0%, #fff 55%);
  border: 1px solid #d6dbc9;
  box-shadow: 0 4px 16px rgba(82, 104, 45, 0.1);
}

.patterns-hero__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
  gap: 28px 40px;
  align-items: center;
}

.patterns-hero__content {
  min-width: 0;
}

.patterns-hero h1 {
  margin: 0 0 14px;
  font-size: clamp(1.45rem, 2.8vw, 1.85rem);
  font-weight: 600;
  color: #52682d;
  line-height: 1.25;
}

.patterns-hero__intro {
  margin: 0 0 22px;
  font-size: 1.02rem;
  font-weight: 500;
  line-height: 1.55;
  color: #333;
  max-width: 34rem;
}

.patterns-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
}

.patterns-hero__actions .kbm-btn {
  margin: 0;
}

.patterns-hero__media {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.patterns-hero__img {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  object-fit: contain;
  border-radius: 10px;
  border: 1px solid rgba(82, 104, 45, 0.18);
  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.08),
    0 2px 8px rgba(82, 104, 45, 0.12);
}

/* Pinwheel accent — ties Explore CTA to features heading */
.patterns-pinwheel {
  width: 22px;
  height: 22px;
  object-fit: contain;
  opacity: 0.58;
  flex-shrink: 0;
}

.patterns-features-jump {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.patterns-features-jump .patterns-pinwheel {
  margin-top: -1px;
}

/* Feature row beneath hero */
.patterns-features {
  margin-bottom: 36px;
  padding-top: 4px;
  scroll-margin-top: calc(var(--site-header-offset, 72px) + 16px);
}

.patterns-features__header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
}

.patterns-features__title {
  margin: 0;
  font-size: 1.2rem;
  font-weight: 600;
  color: #52682d;
  text-align: center;
}

.patterns-features__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.patterns-features__grid > li {
  display: flex;
}

.patterns-feature-card {
  width: 100%;
  padding: 16px 38px 16px 18px;
  border-radius: 10px;
  background: #fff;
  border: 1px solid #d6dbc9;
  box-shadow: 0 2px 8px rgba(82, 104, 45, 0.06);
  font-size: 0.95rem;
  font-weight: 500;
  line-height: 1.4;
  color: #333;
  text-align: center;
  font-family: inherit;
  cursor: pointer;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

.patterns-feature-card::after {
  content: "";
  position: absolute;
  right: 16px;
  top: 50%;
  width: 7px;
  height: 7px;
  border-right: 2px solid #b5bea8;
  border-bottom: 2px solid #b5bea8;
  transform: translateY(-50%) rotate(-45deg);
  transition: transform 0.2s ease, border-color 0.2s ease;
  pointer-events: none;
}

.patterns-feature-card:hover,
.patterns-feature-card:focus-visible {
  border-color: #52682d;
  box-shadow: 0 4px 12px rgba(82, 104, 45, 0.12);
  transform: translateY(-2px);
}

.patterns-feature-card:hover::after,
.patterns-feature-card:focus-visible::after {
  border-color: #52682d;
  transform: translateY(-50%) rotate(-45deg) translateX(3px);
}

.patterns-feature-card:focus-visible {
  outline: 2px solid #52682d;
  outline-offset: 2px;
}

/* Feature preview modal — fixed overlay (not in page flow) */
.patterns-feature-preview-modal {
  position: fixed;
  inset: 0;
  z-index: 1500;
  display: none;
  place-items: center;
  padding: 1rem;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.72);
}

.patterns-feature-preview-modal.is-open {
  display: grid;
}

.patterns-feature-preview-modal[hidden] {
  display: none !important;
}

.patterns-feature-preview-modal__dialog {
  position: relative;
  width: min(92vw, 720px);
  max-height: 92vh;
  padding: 2.5rem 1rem 1rem;
  box-sizing: border-box;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.32);
  overflow: auto;
}

.patterns-feature-preview-modal__actions {
  position: absolute;
  top: 0.35rem;
  right: 0.35rem;
  z-index: 1;
}

.patterns-feature-preview-modal__close {
  width: 2rem;
  height: 2rem;
  border: 0;
  border-radius: 999px;
  background: rgba(17, 24, 39, 0.9);
  color: #fff;
  font-size: 1.1rem;
  line-height: 1;
  cursor: pointer;
}

.patterns-feature-preview-modal__close:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 2px;
}

.patterns-feature-preview-modal__title {
  margin: 0 0 0.75rem;
  padding: 0 2rem 0 0.5rem;
  font-size: 1.05rem;
  font-weight: 600;
  color: #52682d;
  text-align: center;
  line-height: 1.3;
}

.patterns-feature-preview-modal__media-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  max-height: calc(92vh - 5rem);
  overflow: auto;
}

.patterns-feature-preview-modal__media {
  display: block;
  max-width: 100%;
  width: auto;
  height: auto;
  max-height: min(70vh, 520px);
  border-radius: 8px;
  object-fit: contain;
}

body.patterns-feature-preview-open {
  overflow: hidden;
}

@media (max-width: 720px) {
  .patterns-feature-preview-modal__dialog {
    width: min(96vw, 100%);
    padding-top: 2.25rem;
  }

  .patterns-feature-preview-modal__title {
    font-size: 0.98rem;
    padding-right: 1.75rem;
  }

  .patterns-feature-preview-modal__media {
    max-height: min(60vh, 400px);
  }
}

@media (max-width: 900px) {
  .patterns-features__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .patterns-hero {
    padding: 24px 20px;
  }

  .patterns-hero__grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .patterns-hero__content {
    text-align: center;
  }

  .patterns-hero__intro {
    max-width: none;
  }

  .patterns-hero__actions {
    justify-content: center;
  }

  .patterns-hero__media {
    max-width: min(100%, 440px);
    margin: 0 auto;
  }

  .patterns-features__grid {
    grid-template-columns: 1fr;
  }
}

/* Featured */
.patterns-featured-clean {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  margin-top: 20px;
  margin-bottom: 28px;
}

.pattern-card {
  display: flex;
  flex-direction: column;
  text-align: center;
  padding: 20px;
  border-radius: 12px;
  background: #fff;
  text-decoration: none;
  color: inherit;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.patterns-featured-card-img {
  width: 100%;
  height: auto;
  max-height: 180px;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: 12px;
}

.pattern-card h2 {
  margin: 8px 0;
}

.pattern-card .promise {
  font-weight: 500;
  margin-bottom: 6px;
}

.pattern-card .supporting {
  font-size: 0.95rem;
  margin-bottom: 0;
}

.patterns-featured-card p {
  font-weight: 600;
}

.patterns-featured-card p.promise {
  font-weight: 600;
}

.supporting ul {
  list-style: none;
  padding-left: 0;
  margin: 0;
  text-align: left;
}

.supporting li {
  position: relative;
  padding-left: 22px;
  margin-bottom: 6px;
  line-height: 1.4;
  font-weight: 400;
}

.supporting li::before {
  content: "✓";
  position: absolute;
  left: 0;
  color: #52682d; /* kin-green */
  font-weight: bold;
}

/* CTA: global .kbm-btn .kbm-btn-accent */
.price-note {
  display: block;
  font-size: 0.85rem;
  color: #52682d; /* kin-green */
  font-weight: 600;
  text-align: center;
  margin: 14px 0 6px;
}

.pattern-card .kbm-btn {
  margin-top: 0;
}

.patterns-coming-soon {
  text-align: center;
  margin-top: 30px;
  border-top: 1px solid #eee;
  padding-top: 20px;
}

.patterns-coming-title {
  font-size: 1.4rem;
  font-weight: 600;
  color: #666;
  margin: 10px 0 10px;
}

.patterns-coming-subtitle {
  color: #666;
  max-width: 600px;
  margin: 0 auto 30px;
}

.patterns-coming-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}

.drawing-board-feedback {
  text-align: center;
  margin-top: 12px;
  font-size: 0.9rem;
}

.drawing-board-feedback a {
  color: #666;
  text-decoration: underline;
}

.drawing-board-feedback a:hover {
  color: #333;
}

.patterns-coming-card {
  background: #f9f9f6;
  border: 1px solid #d6dbc9;
  border-radius: 12px;
  padding: 24px;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.patterns-coming-card img {
  width: 48px;
  height: 48px;
  margin: 0 auto 10px;
  display: block;
  object-fit: contain;
  opacity: 0.7;
}

.patterns-coming-card h3 {
  margin: 10px 0 6px;
  color: #52682d;
}

.patterns-coming-card p {
  font-size: 0.9rem;
  color: #555;
  margin: 0 0 12px;
}

.coming-card {
  opacity: 0.65;
}

.coming-card:hover {
  opacity: 0.65;
  transform: none;
  cursor: default;
}

.coming-soon {
  display: inline-block;
  font-size: 0.8rem;
  color: #666;
  margin-top: 10px;
}
</style>