---
import Layout from "../../../layouts/Layout.astro";
import WizardBackLink from "../../../components/wizards/WizardBackLink.astro";
import PatternTipsToggle from "../../../components/patterns/PatternTipsToggle.astro";
import PatternTabs from "../../../components/patterns/PatternTabs.astro";
import PatternComments from "../../../components/patterns/PatternComments.astro";
import ActionBar from "../../../components/wizards/ActionBar.astro";
import PrintFooter from "../../../components/common/PrintFooter.astro";
import SleevelessBuildWorkspace from "../../../components/patterns/sleeveless/SleevelessBuildWorkspace.astro";
import "../../../styles/ns-shaping-chart.css";
import "../../../styles/wizard.css";
import "../../../styles/glossary-tooltip.css";
import "../../../styles/patterns/sleeveless-pattern-shared.css";

const pageUrl = Astro.url.href;

/** Top PatternTabs: open Pattern panel when arriving with `?tab=pattern` (e.g. legacy “View My Pattern” link). */
const initialPatternSubTab = Astro.url.searchParams.get("tab") === "pattern" ? "pattern" : "build";
---

<Layout
  title="Your Custom Sleeveless Pattern | Knit it Now"
  description="Machine-knitting pattern from your sleeveless pattern builder choices."
>
  <main class="wizard-page sleeveless-pattern-page">
    <div style="max-width: 800px; margin: 0 auto; padding: 0 1rem;">
      <WizardBackLink className="back-link no-print" fallback="/patterns/sleeveless/pattern?buildStep=yarn" />
    </div>

    <div id="sleeveless-pattern-top" class="wizard-container scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternTabs
          rootClass="pattern-tabs-scope"
          defaultTab={initialPatternSubTab}
          managePatternReadiness={true}
          patternInitiallyReady={false}
        >
          <div slot="build" class="sg-tab-build sg-tab-build--embedded">
            <SleevelessBuildWorkspace />
          </div>

          <div slot="pattern" class="sg-tab-pattern">
            <div id="sg-sleeveless-results" class="sg-sleeveless-results" style="display: none">
              <ActionBar formScrollTarget="sleeveless-pattern-top" showEditButton={false} />

              <div id="sleeveless-pattern-tips-scope" class="pattern-tips-scope" data-show-tips="true">
                <section class="sleeveless-pattern-intro">
                  <div class="sleeveless-pattern-intro__image">
                    <img
                      src="/images/patterns/sleeveless/sleeveless-sweater-pattern-builder.png"
                      alt="Sleeveless sweater pattern builder preview"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="sleeveless-pattern-intro__content">
                    <p class="sg-pattern-intro-line" data-sg-pattern-intro></p>
                    <PatternTipsToggle
                      storageKey="sleeveless-show-tips"
                      scopeSelector="#sleeveless-pattern-tips-scope"
                    />

                    <p
                      class="sg-pattern-soft-warning no-print"
                      data-sg-generator-note
                      hidden
                      role="status"
                    >
                      Double-check critical measurements against your sizing chart if anything looks off.
                    </p>
                  </div>
                </section>

                <div id="pattern-content" data-pattern-content>
                  <div class="sleeveless-pattern-mount" data-sleeveless-mount>
                    <p class="sleeveless-pattern-boot-msg">Loading pattern…</p>
                  </div>
                </div>
              </div>
            </div>

            <noscript>
              <div class="pattern-section">
                <h2 class="pattern-noscript-heading">Pattern</h2>
                <p>Turn on JavaScript to load your saved builder values and generated instructions.</p>
              </div>
            </noscript>
          </div>

          <div slot="share" class="sg-tab-share">
            <p class="sg-tab-share__intro">Ask questions or share your results.</p>
            <PatternComments />
          </div>

          <div slot="inspiration" class="sg-tab-inspiration">
            <div class="inspiration-section">
              <h3 class="inspiration-heading">Get inspired</h3>
              <div class="pinterest-embed">
                <a
                  data-pin-do="embedBoard"
                  data-pin-board-width="100%"
                  data-pin-scale-height="900"
                  data-pin-scale-width="80"
                ></a>
              </div>
              <p class="hat-pinterest-fallback-link">
                <a
                  href="https://www.pinterest.https://www.pinterest.com/knititnow/sleeeless-sweater/com/knititnow/machine-knit-blankets/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Open machine knitting inspiration on Pinterest
                </a>
              </p>
            </div>
          </div>
        </PatternTabs>
      </div>
    </div>

    <div id="print-footer" style="display: none">
      <PrintFooter url={pageUrl} />
    </div>
  </main>
</Layout>

<style>
  .sleeveless-pattern-page {
    --sg-accent: #c2614e;
    padding-bottom: 2rem;
  }

  .sg-tab-panel-title {
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--kbm-green, #52682d);
  }

  .sg-tab-build__intro,
  .sg-tab-share__intro {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #374151;
  }

  .sg-build-steps-list {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #374151;
  }

  .sg-tab-build__cta {
    margin: 0;
  }

  .sg-pattern-intro-line {
    max-width: 52rem;
    margin: 0 auto 0.5rem;
    padding: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #374151;
    font-weight: 500;
  }

  .sg-pattern-soft-warning {
    max-width: 52rem;
    margin: 0 auto 0.75rem;
    padding: 0.65rem 0.85rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: #6b4f2a;
    background: rgba(251, 243, 219, 0.65);
    border-radius: 8px;
    border: 1px solid rgba(234, 179, 8, 0.35);
  }

  .sleeveless-pattern-boot-msg {
    margin: 0;
    font-size: 0.95rem;
    color: #6b7280;
  }

  /* Two-column back instructions (no border on stitch column) */
  :global(.sleeveless-pattern-instructions) {
    max-width: 52rem;
    margin: 0 auto;
  }

  :global(.sleeveless-pattern-piece) {
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #1f2937;
  }

  :global(.sleeveless-pattern-section) {
    margin: 1.15rem 0 0.5rem;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--kbm-green, #52682d);
  }

  :global(.sleeveless-pattern-section:first-of-type) {
    margin-top: 0.35rem;
  }

  :global(.sleeveless-pattern-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.2rem 1.25rem;
    margin-bottom: 0.85rem;
  }

  :global(.sleeveless-pattern-row--full) {
    display: block;
  }

  :global(.sleeveless-pattern-left) {
    flex: 1 1 14rem;
    min-width: 0;
  }

  :global(.sleeveless-pattern-rc) {
    margin: 0 0 0.2rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    font-size: 0.9rem;
    color: #1f2937;
  }

  :global(.sleeveless-pattern-line) {
    margin: 0.2rem 0 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #374151;
  }

  /* Pattern term tooltips in dynamically rendered back instructions (same as hat pattern) */
  :global(.sleeveless-pattern-left .pattern-term) {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: #52682d;
    text-underline-offset: 2px;
    cursor: help;
    position: relative;
  }

  :global(.sleeveless-pattern-left .pattern-term)::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: #333;
    color: #fff;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-style: normal;
    font-weight: normal;
    white-space: normal;
    width: max-content;
    max-width: 280px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s, visibility 0.2s;
    z-index: 100;
    pointer-events: none;
    margin-bottom: 4px;
    line-height: 1.4;
  }

  :global(.sleeveless-pattern-left .pattern-term):hover::after,
  :global(.sleeveless-pattern-left .pattern-term):focus::after {
    opacity: 1;
    visibility: visible;
  }

  :global(.sleeveless-pattern-sts) {
    flex: 0 0 auto;
    min-width: 3.25rem;
    margin: 0;
    padding-top: 0.05rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: #4b5563;
    text-align: right;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    :global(.sleeveless-pattern-row) {
      flex-direction: column;
      gap: 0.35rem;
    }

    :global(.sleeveless-pattern-sts) {
      text-align: left;
      align-self: flex-start;
      padding-top: 0;
    }
  }

  .sg-sleeveless-results {
    padding-top: 0.25rem;
  }

  :global(#pattern-content .sg-pattern-output.sg-neck-chart-print-block) {
    max-width: 52rem;
    margin: 1rem auto 0;
    padding: 0;
  }

  :global(.pattern-noscript-heading) {
    font-size: 1.1rem;
    color: var(--kbm-green, #52682d);
    margin: 0 0 0.5rem;
  }

  /* Expandable garment sections */
  :global(#pattern-content .pattern-section) {
    margin-bottom: 1rem;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    /* overflow visible so sticky piece diagrams work inside section content */
    overflow: visible;
    background: #fff;
  }

  :global(#pattern-content .pattern-section__header) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.85rem;
    background: rgba(82, 104, 45, 0.07);
    border-radius: 7px 7px 0 0;
  }

  :global(#pattern-content .pattern-section__heading h2) {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--kbm-green, #52682d);
    letter-spacing: 0.02em;
  }

  :global(#pattern-content .pattern-section--garment-piece .pattern-section__heading h2) {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #1f2937;
  }

  :global(#pattern-content .pattern-section__collapse-label) {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    cursor: pointer;
  }

  :global(#pattern-content .pattern-section__collapse-label input[type="checkbox"]) {
    accent-color: var(--kbm-green);
  }

  :global(#pattern-content .pattern-section__content) {
    padding: 0.75rem 0.85rem 1.1rem;
    background: color-mix(in srgb, var(--kbm-green, #52682d) 3%, var(--page-bg, #fff));
    border-radius: 0 0 7px 7px;
  }

  :global(#pattern-content .pattern-section--garment-piece > .pattern-section__content) {
    overflow: visible;
  }

  :global(#pattern-content .pattern-subsection) {
    margin: 0.75rem 0 0;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 7px;
    background: #fff;
  }

  :global(#pattern-content .pattern-subsection:first-child) {
    margin-top: 0;
  }

  :global(#pattern-content .pattern-subsection .pattern-section__header) {
    padding: 0.5rem 0.65rem;
    background: rgba(82, 104, 45, 0.04);
  }

  :global(#pattern-content .pattern-subsection .pattern-section__heading h2) {
    font-size: 0.92rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(#pattern-content .pattern-subsection .pattern-section__content) {
    padding: 0.65rem 0.75rem 0.85rem;
    background: color-mix(in srgb, var(--kbm-green, #52682d) 2.5%, var(--page-bg, #fff));
  }

  @supports not (background: color-mix(in srgb, white, black)) {
    :global(#pattern-content .pattern-section__content) {
      background: rgba(82, 104, 45, 0.035);
    }
  }

  /* BACK / FRONT: pattern-layout + sleeveless-piece-split (desktop: grid, sticky right sidebar) */
  :global(#pattern-content .pattern-layout.pattern-layout--garment-columns),
  :global(#pattern-content .sleeveless-piece-split) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: stretch;
  }

  :global(#pattern-content .pattern-layout__content),
  :global(#pattern-content .sleeveless-piece-split__text) {
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(#pattern-content .pattern-layout__sidebar),
  :global(#pattern-content .sleeveless-piece-split__diagram) {
    order: -1;
    flex: 0 0 auto;
    min-width: 0;
  }

  :global(#pattern-content .sleeveless-piece-split__diagram-inner) {
    margin: 0;
  }

  :global(#pattern-content .sleeveless-piece-split__diagram-trigger) {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
    text-align: inherit;
  }

  :global(#pattern-content .sleeveless-piece-split__diagram-trigger:focus-visible) {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
    border-radius: 6px;
  }

  :global(#pattern-content .sleeveless-piece-split__diagram-hint) {
    margin: 0.4rem 0 0;
    font-size: 0.82rem;
    line-height: 1.3;
    color: #4b5563;
    text-align: center;
  }

  :global(#pattern-content .sleeveless-piece-split__diagram-img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  :global(#pattern-content .sleeveless-piece-split__diagram-svg) {
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  :global(#pattern-content .sleeveless-piece-split__diagram-inline) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  :global(#pattern-content .sleeveless-piece-split__diagram-svg > svg) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }

  :global(.sleeveless-diagram-modal[hidden]) {
    display: none !important;
  }

  :global(.sleeveless-diagram-modal) {
    position: fixed;
    inset: 0;
    z-index: 1500;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgba(17, 24, 39, 0.72);
  }

  :global(.sleeveless-diagram-modal__dialog) {
    position: relative;
    width: auto;
    height: auto;
    max-width: 95vw;
    max-height: 95vh;
    padding: 0.75rem;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.32);
  }

  :global(.sleeveless-diagram-modal__close) {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.9);
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  :global(.sleeveless-diagram-modal__close:focus-visible) {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  :global(.sleeveless-diagram-modal__content) {
    display: grid;
    place-items: center;
    width: auto;
    height: auto;
    max-width: 95vw;
    max-height: 95vh;
    overflow: auto;
  }

  :global(
    .sleeveless-diagram-modal__content .sleeveless-piece-split__diagram-inline,
    .sleeveless-diagram-modal__content svg,
    .sleeveless-diagram-modal__content iframe,
    .sleeveless-diagram-modal__content img,
    .sleeveless-diagram-modal__content object,
    .sleeveless-diagram-modal__content figure,
    .sleeveless-diagram-modal__content figure > svg,
    .sleeveless-diagram-modal__content figure > iframe,
    .sleeveless-diagram-modal__content figure > img,
    .sleeveless-diagram-modal__content figure > object
  ) {
    width: min(90vw, 900px);
    max-width: 90vw;
    max-height: 90vh;
    height: auto;
  }

  :global(#pattern-content .pattern-layout__content .sleeveless-pattern-instructions),
  :global(#pattern-content .sleeveless-piece-split__text .sleeveless-pattern-instructions) {
    max-width: none;
    margin: 0;
  }

  :global(#pattern-content .pattern-layout__content .sg-pattern-output.sg-neck-chart-print-block),
  :global(#pattern-content .sleeveless-piece-split__text .sg-pattern-output.sg-neck-chart-print-block) {
    max-width: none;
    margin-left: 0;
    margin-right: 0;
  }

  :global(#pattern-content .sleeveless-piece-chart-fullwidth) {
    width: 100%;
    max-width: 100%;
    clear: both;
  }

  :global(#pattern-content .sleeveless-piece-chart-fullwidth .ns-shaping-chart__table) {
    width: 100%;
  }

  :global(#pattern-content .sleeveless-neck-shoulder-diagram) {
    display: block;
    width: 100%;
    min-width: 0;
    margin-top: 1rem;
  }

  :global(#pattern-content .sg-neck-chart-diagram-block) {
    margin: 0;
  }

  :global(#pattern-content .ns-shaping-chart--diagram-block) {
    margin: 0;
  }

  :global(#pattern-content .ns-shaping-chart__diagram) {
    margin: 0;
    padding: 0.45rem 0.75rem 0.75rem;
    border: 1px solid rgba(55, 65, 81, 0.16);
    border-radius: 8px;
    background: #fff;
  }

  :global(#pattern-content .ns-shaping-chart__diagram-svg-wrap) {
    overflow-x: auto;
    max-width: 100%;
  }

  :global(#pattern-content .ns-shaping-chart__diagram-svg-wrap svg) {
    display: block;
    width: 100%;
    min-width: 320px;
    height: auto;
  }

  :global(#pattern-content .ns-shaping-chart__diagram-svg-wrap .ns-notation-overlay) {
    min-width: 320px;
  }

  :global(#pattern-content .ns-shaping-chart__second-shoulder-toggle) {
    margin: 0.45rem 0 0.75rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgba(55, 65, 81, 0.16);
    border-radius: 8px;
    background: rgba(82, 104, 45, 0.04);
  }

  :global(#pattern-content .ns-shaping-chart__second-shoulder-toggle-copy) {
    margin: 0 0 0.35rem;
    font-size: 0.88rem;
    line-height: 1.4;
    color: #374151;
  }

  :global(#pattern-content .ns-shaping-chart__second-shoulder-label) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1f2937;
    cursor: pointer;
  }

  :global(#pattern-content .ns-shaping-chart__second-shoulder-input) {
    margin: 0;
    inline-size: 1rem;
    block-size: 1rem;
    accent-color: var(--kbm-green, #52682d);
  }

  :global(#pattern-content .ns-shaping-chart__active-side-note--expanded[hidden]) {
    display: none !important;
  }

  :global(#pattern-content #neckline-shoulder-chart-print-area),
  :global(#pattern-content #front-neckline-shoulder-chart-print-area) {
    width: 100%;
  }

  :global(#pattern-content .neckline-chart-print-controls) {
    display: none;
  }

  :global(#pattern-content .chart-print-btn),
  :global(#pattern-content .neckline-chart-print-button) {
    appearance: none;
    border: 0;
    background: transparent;
    color: #4b5563;
    border-radius: 4px;
    padding: 0.05rem;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  :global(#pattern-content .chart-print-btn:hover),
  :global(#pattern-content .neckline-chart-print-button:hover) {
    color: #1f2937;
  }

  :global(#pattern-content .chart-print-btn:focus-visible),
  :global(#pattern-content .neckline-chart-print-button:focus-visible) {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }

  :global(#pattern-content .neckline-chart-header-row),
  :global(#pattern-content .neckline-chart-header) {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
  }

  :global(#pattern-content .neckline-chart-print-only-header),
  :global(#pattern-content .neckline-chart-print-only-footer) {
    display: none;
  }

  :global(#pattern-content .neckline-chart-print-only-header-title) {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #111827;
  }

  :global(#pattern-content .neckline-chart-print-only-header-intro) {
    margin: 0 0 0.8rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: #1f2937;
  }

  :global(#pattern-content .neckline-chart-print-only-footer) {
    margin-top: 0.7rem;
    padding-top: 0.45rem;
    border-top: 1px solid #d1d5db;
    font-size: 0.82rem;
    color: #4b5563;
  }

  :global(#pattern-content .sleeveless-neck-shoulder-help) {
    display: grid;
    grid-template-columns: 124px minmax(0, 1fr);
    align-items: start;
    gap: 0.45rem 0.7rem;
    margin: 0.15rem 0 0.5rem;
  }

  :global(#pattern-content .sleeveless-neck-shoulder-help__icon) {
    width: min(100%, 118px);
    height: auto;
    display: block;
    align-self: start;
    justify-self: start;
  }

  :global(#pattern-content .sleeveless-neck-shoulder-help__text) {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.4;
    color: #374151;
  }

  :global(#pattern-content .pattern-shaping-intro) {
    margin: 0 0 0.65rem;
  }

  :global(#pattern-content .pattern-shaping-intro p) {
    margin: 0 0 0.45rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: #374151;
  }

  :global(#pattern-content .pattern-shaping-intro p:last-child) {
    margin-bottom: 0;
  }

  :global(#pattern-content .pattern-shaping-intro .small.text-muted) {
    font-size: 0.82rem;
    color: #6b7280;
  }

  :global(#pattern-content .sleeveless-shaping-help-toggle) {
    margin: 0 0 0.65rem;
    padding: 0.6rem 0.8rem;
  }

  :global(#pattern-content .sleeveless-shaping-help-toggle summary) {
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 700;
    color: #1f2937;
