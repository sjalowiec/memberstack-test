---
import Layout from "../../../layouts/Layout.astro";
import WizardBackLink from "../../../components/wizards/WizardBackLink.astro";
import "../../../styles/ns-shaping-chart.css";

const pageUrl = Astro.url.href;
---

<Layout
  title="Print Sleeveless Pattern | Knit it Now"
  description="Printable sleeveless sweater pattern from your saved builder choices."
  bodyClass="sleeveless-print-route"
>
  <div class="sleeveless-print-shell">
    <div class="sleeveless-print-actions no-print">
      <WizardBackLink className="back-link" fallback="/patterns/sleeveless/pattern?tab=pattern" />
      <button type="button" class="sleeveless-print-btn" data-sleeveless-print-action>
        Print / Save as PDF
      </button>
    </div>

    <div class="sleeveless-print-root" data-sleeveless-print-root>
      <p class="sleeveless-print-loading">Loading pattern…</p>
    </div>

    <p class="print-url-meta no-print" aria-hidden="true">{pageUrl}</p>
  </div>
</Layout>

<script>
  import "../../../scripts/sleeveless-print-page.ts";
</script>

<style is:global>
  /* Screen: simple document column; avoid app-card feel */
  body.sleeveless-print-route .site-content {
    padding-top: calc(var(--header-offset, 150px) + var(--header-buffer, 12px));
    max-width: min(56rem, 100vw - 2rem);
    margin-left: auto;
    margin-right: auto;
  }

  .sleeveless-print-shell {
    padding: 0 1rem 2.5rem;
  }

  .sleeveless-print-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .sleeveless-print-btn {
    appearance: none;
    border: 1px solid #52682d;
    background: #52682d;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .sleeveless-print-btn:hover {
    filter: brightness(1.05);
  }

  .sleeveless-print-btn:focus-visible {
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }

  .print-url-meta {
    margin-top: 2rem;
    font-size: 0.75rem;
    color: #9ca3af;
    word-break: break-all;
  }

  .sleeveless-print-loading {
    margin: 0;
    font-size: 1rem;
    color: #4b5563;
  }

  /* Typography inside injected print document */
  .sleeveless-print-root .print-doc-inner {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 11pt;
    line-height: 1.45;
    color: #111827;
  }

  .sleeveless-print-root .print-doc-title {
    font-family: inherit;
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .sleeveless-print-root .print-doc-subtitle {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.5;
    color: #374151;
  }

  .sleeveless-print-root .print-doc-header {
    margin-bottom: 0.75rem;
  }

  /* Logo | divider | title — letterhead row, rule below (global print.css hides bare `header`; see @media print overrides) */
  .sleeveless-print-root .print-doc-header-brand {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 0 1.15rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0;
    border-bottom: 1px solid #d1d5db;
  }

  .sleeveless-print-root .print-doc-header-mark {
    flex: 0 0 auto;
    align-self: flex-start;
    padding-top: 0.06rem;
    line-height: 0;
  }

  .sleeveless-print-root .print-doc-header-divider {
    flex: 0 0 1px;
    width: 1px;
    align-self: stretch;
    min-height: 3rem;
    background: #d1d5db;
  }

  .sleeveless-print-root .print-doc-header-main {
    flex: 1 1 auto;
    min-width: 0;
  }

  .sleeveless-print-root .print-doc-header-logo {
    display: block;
    width: auto;
    max-width: 12.5rem;
    max-height: 2.75rem;
    height: auto;
    object-fit: contain;
    object-position: left center;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  @media (max-width: 42rem) {
    .sleeveless-print-root .print-doc-header-brand {
      flex-direction: column;
      gap: 0.65rem 0;
    }

    .sleeveless-print-root .print-doc-header-divider {
      width: 100%;
      height: 1px;
      min-height: 0;
      flex: 0 0 auto;
    }

    .sleeveless-print-root .print-doc-header-logo {
      max-width: 10.5rem;
      max-height: 2.45rem;
    }
  }

  .sleeveless-print-root .print-page-first {
    margin-bottom: 0.5rem;
  }

  .sleeveless-print-root .print-hero-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8.5rem, 11.5rem);
    gap: 0.75rem 1.25rem;
    align-items: start;
    margin: 0 0 0.9rem;
    padding: 0 0 0.75rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .sleeveless-print-root .print-hero-summary {
    min-width: 0;
  }

  .sleeveless-print-root .print-hero-figure {
    margin: 0;
    padding: 0;
    min-width: 0;
    text-align: right;
  }

  .sleeveless-print-root .print-hero-img {
    display: inline-block;
    width: 100%;
    max-width: 11.5rem;
    height: auto;
    object-fit: contain;
    vertical-align: top;
  }

  .sleeveless-print-root .print-opening-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(9.5rem, 12.5rem);
    gap: 0.75rem 1.15rem;
    align-items: start;
  }

  .sleeveless-print-root .print-opening-prose {
    min-width: 0;
  }

  .sleeveless-print-root .print-opening-prose .print-piece-body > .print-piece-title:first-child {
    margin-top: 0;
  }

  .sleeveless-print-root .print-opening-diagram {
    margin: 0;
    min-width: 0;
    padding: 0.15rem 0 0;
  }

  .sleeveless-print-root .print-opening-diagram-inner {
    border: 1px solid #e5e7eb;
    padding: 0.35rem;
    background: #fff;
  }

  .sleeveless-print-root .print-back-diagram-svg {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .sleeveless-print-root .print-diagram-caption {
    margin: 0.35rem 0 0;
    font-size: 0.72rem;
    line-height: 1.3;
    color: #6b7280;
    font-family: inherit;
  }

  .sleeveless-print-root .print-opening-diagram .print-diagram-caption {
    text-align: center;
  }

  .sleeveless-print-root .print-diagram-fallback {
    margin: 0;
    font-size: 0.85rem;
  }

  @media (max-width: 42rem) {
    .sleeveless-print-root .print-hero-band {
      grid-template-columns: 1fr;
    }

    .sleeveless-print-root .print-hero-figure {
      text-align: center;
      max-width: 14rem;
      margin-left: auto;
      margin-right: auto;
    }

    .sleeveless-print-root .print-opening-band {
      grid-template-columns: 1fr;
    }

    .sleeveless-print-root .print-opening-diagram {
      order: 2;
    }

    .sleeveless-print-root .print-opening-prose {
      order: 1;
    }
  }

  .sleeveless-print-root .print-heading-major {
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.45rem;
    color: #1f2937;
    break-after: avoid;
  }

  .sleeveless-print-root .print-heading-major--hero {
    font-size: 1rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #52682d;
  }

  .sleeveless-print-root .print-summary-dl {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(6.25rem, 9rem) 1fr;
    gap: 0.28rem 0.85rem;
    font-size: 0.88rem;
  }

  .sleeveless-print-root .print-summary-dl dt {
    margin: 0;
    font-weight: 600;
    color: #4b5563;
  }

  .sleeveless-print-root .print-summary-dl dd {
    margin: 0;
    color: #1f2937;
  }

  .sleeveless-print-root .print-muted {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: #6b7280;
  }

  .sleeveless-print-root .print-warnings {
    margin: 0 0 1rem;
    padding: 0.5rem 0.65rem;
    font-size: 0.88rem;
    line-height: 1.4;
    color: #7c2d12;
    background: #fff7ed;
    border: 1px solid #fdba74;
    border-radius: 6px;
  }

  .sleeveless-print-root .print-summary-yarn-note {
    margin-top: 0.5rem;
    margin-bottom: 0;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  /* Major sections: flow naturally unless the print engine must break. */
  .sleeveless-print-root .print-major,
  .sleeveless-print-root .print-piece-body {
    break-inside: auto;
    page-break-inside: auto;
  }

  .sleeveless-print-root .print-front {
    break-before: auto;
    page-break-before: auto;
  }

  .sleeveless-print-root .print-finishing {
    break-before: auto;
    page-break-before: auto;
  }

  .sleeveless-print-root .print-piece-title {
    font-family: inherit;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    margin: 1.25rem 0 0.75rem;
    color: #111827;
    break-after: avoid;
  }

  .sleeveless-print-root .print-piece-body > .print-piece-title:first-child {
    margin-top: 0;
  }

  .sleeveless-print-root .print-section-title {
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 1rem 0 0.45rem;
    color: #52682d;
    break-after: avoid;
  }

  /* Hand-checkboxes beside BACK / section headings only (not At a glance or charts) */
  .sleeveless-print-root .print-heading-with-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.42rem;
  }

  .sleeveless-print-root .print-heading-checkbox {
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 0.62rem;
    height: 0.62rem;
    margin-top: 0.42em;
    border: 1.25pt solid #111827;
    border-radius: 1px;
    background: transparent;
  }

  .sleeveless-print-root .print-section-title .print-heading-checkbox {
    margin-top: 0.28em;
  }

  .sleeveless-print-root .print-heading-major.print-heading-with-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.42rem;
  }

  .sleeveless-print-root .print-heading-major.print-heading-with-checkbox .print-heading-checkbox {
    margin-top: 0.35em;
  }

  .sleeveless-print-root .print-heading-label {
    flex: 1 1 auto;
    min-width: 0;
  }

  .sleeveless-print-root .print-inst-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1rem;
    margin-bottom: 0.75rem;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .sleeveless-print-root .print-inst-row--full .print-inst-left {
    flex: 1 1 100%;
  }

  .sleeveless-print-root .print-inst-left {
    flex: 1 1 16rem;
    min-width: 0;
  }

  .sleeveless-print-root .print-rc {
    margin: 0 0 0.15rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .sleeveless-print-root .print-line {
    margin: 0.15rem 0 0;
    font-size: inherit;
    line-height: 1.55;
  }

  .sleeveless-print-root .print-inst-row--sts-only {
    justify-content: flex-end;
  }

  .sleeveless-print-root .print-inst-sts {
    flex: 0 0 auto;
    min-width: 3.5rem;
    margin: 0;
    padding-top: 0.1rem;
    font-weight: 700;
    font-size: 0.9rem;
    color: #4b5563;
    text-align: right;
    white-space: nowrap;
  }

  .sleeveless-print-root .print-chart-wrap {
    margin: 0.14rem 0 0.2rem;
  }

  .sleeveless-print-root .print-chart-intro {
    margin: 0 0 0.1rem;
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .sleeveless-print-root .print-chart-intro p {
    margin: 0.02rem 0;
  }

  .sleeveless-print-root .ns-shaping-mini {
    margin: 0.06rem 0 0;
    font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
    font-size: 7.3pt;
    line-height: 1.15;
  }

  .sleeveless-print-root .ns-shaping-mini__title {
    margin: 0 0 0.05rem;
    font-size: 0.79rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #1f2937;
  }

  .sleeveless-print-root .ns-shaping-mini__wrap {
    margin: 0;
    padding: 0;
  }

  .sleeveless-print-root .ns-shaping-mini__table {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    border: 0;
    table-layout: fixed;
  }

  .sleeveless-print-root .ns-shaping-mini__table th,
  .sleeveless-print-root .ns-shaping-mini__table td {
    border: 0;
    padding: 0.03rem 0.14rem;
    background: #fff;
    vertical-align: top;
  }

  .sleeveless-print-root .ns-shaping-mini__table thead th {
    padding-top: 0;
    padding-bottom: 0.04rem;
    text-align: left;
    font-weight: 700;
    color: #374151;
    border-bottom: 1px solid #d1d5db;
  }

  .sleeveless-print-root .ns-shaping-mini__table td:nth-child(1),
  .sleeveless-print-root .ns-shaping-mini__table th:nth-child(1) {
    width: 2rem;
    white-space: nowrap;
  }

  .sleeveless-print-root .ns-shaping-mini__table td:nth-child(4),
  .sleeveless-print-root .ns-shaping-mini__table th:nth-child(4) {
    width: 3.3rem;
    white-space: nowrap;
  }

  .sleeveless-print-root .ns-shaping-mini__rc,
  .sleeveless-print-root .ns-shaping-mini__sts {
    font-weight: 700;
    color: #111827;
  }

  .sleeveless-print-root .ns-shaping-mini__row--mix td {
    background: #f3f4f6;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .sleeveless-print-root .print-finishing-list {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
  }

  .sleeveless-print-root .print-finishing-list li {
    margin-bottom: 0.35rem;
  }

  .sleeveless-print-root .print-error {
    padding: 1rem;
    border: 1px solid #fca5a5;
    border-radius: 8px;
    background: #fef2f2;
    color: #7f1d1d;
  }

  .sleeveless-print-root .print-error ul {
    margin: 0.5rem 0;
    padding-left: 1.2rem;
  }

  .sleeveless-print-root .print-error a {
    color: #52682d;
    font-weight: 600;
  }

  /*
    Sleeveless print route: hide Astro dev ribbons, preview banners, and Memberstack
    prebuilt UI / modal overlays so they never appear on-screen or in PDF output.
  */
  body.sleeveless-print-route .dev-banner,
  body.sleeveless-print-route .preview-banner,
  body.sleeveless-print-route #msTopError,
  body.sleeveless-print-route .ms-top-error,
  body.sleeveless-print-route memberstack-prebuilt-ui,
  body.sleeveless-print-route .ms-modal__overlay,
  body.sleeveless-print-route .ms-overlay,
  body.sleeveless-print-route [data-ms-overlay],
  body.sleeveless-print-route div[data-ms-modal-overlay],
  body.sleeveless-print-route iframe[src*="static.memberstack.com"],
  body.sleeveless-print-route iframe[src*="memberstack.com"] {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  @media print {
    /*
      Page numbers in margin boxes: supported by some print engines; Chromium “Save as PDF” often ignores @page margin boxes.
    */
    @page {
      size: letter;
      margin: 0.65in 0.7in 0.85in 0.7in;

      @bottom-right {
        content: "Page " counter(page);
        font-size: 9pt;
        font-family: system-ui, sans-serif;
        color: #6b7280;
      }
    }

    body.sleeveless-print-route .kbm-header-wrap,
    body.sleeveless-print-route footer,
    body.sleeveless-print-route .no-print {
      display: none !important;
    }

    /*
      Global src/styles/print.css hides every `header` in print — restore the pattern
      sheet header inside main (logo + divider + title); keep site chrome hidden above.
    */
    body.sleeveless-print-route .print-doc-inner header.print-doc-header {
      display: block !important;
      visibility: visible !important;
      height: auto !important;
      max-height: none !important;
      overflow: visible !important;
      position: static !important;
      top: auto !important;
      left: auto !important;
      margin: 0 0 0.75rem !important;
      padding: 0 !important;
    }

    body.sleeveless-print-route .print-doc-header-brand {
      display: flex !important;
    }

    body.sleeveless-print-route .print-doc-header-mark,
    body.sleeveless-print-route .print-doc-header-main {
      display: block !important;
      visibility: visible !important;
    }

    body.sleeveless-print-route .print-doc-header-divider {
      display: block !important;
      visibility: visible !important;
    }

    body.sleeveless-print-route .print-doc-header-logo {
      display: block !important;
      visibility: visible !important;
      height: auto !important;
      max-height: 2.75rem !important;
      max-width: 12.5rem !important;
    }

    body.sleeveless-print-route .site-content {
      padding-top: 0 !important;
      max-width: none !important;
      margin: 0 !important;
    }

    .sleeveless-print-shell {
      padding: 0 !important;
    }

    .sleeveless-print-root .print-warnings {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    .sleeveless-print-root .print-hero-band {
      border-bottom-color: #ccc;
      gap: 0.6rem 1rem;
    }

    .sleeveless-print-root .print-hero-img {
      max-height: 2.35in;
      max-width: 2.05in;
    }

    .sleeveless-print-root .print-opening-band {
      gap: 0.5rem 0.85rem;
    }

    .sleeveless-print-root .print-opening-diagram-inner {
      background: #fff;
      border-color: #d1d5db;
      padding: 0.25rem;
    }

    .sleeveless-print-root .print-back-diagram-svg {
      max-height: 2.65in;
    }

    .sleeveless-print-root .print-diagram-caption {
      font-size: 7pt;
      color: #6b7280;
    }

    .sleeveless-print-root .print-heading-checkbox {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    .sleeveless-print-root .ns-shaping-mini__row--mix td {
      background: #f3f4f6 !important;
    }
  }
</style>
