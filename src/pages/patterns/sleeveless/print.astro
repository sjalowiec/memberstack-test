---
import Layout from "../../../layouts/Layout.astro";
import SleevelessPatternMemberGate from "../../../components/patterns/SleevelessPatternMemberGate.astro";
import WizardBackLink from "../../../components/wizards/WizardBackLink.astro";
import PatternPrintFooter from "../../../components/common/PatternPrintFooter.astro";
import PatternPrintPersonalization from "../../../components/common/PatternPrintPersonalization.astro";

import "../../../styles/ns-shaping-chart.css";
import "../../../styles/pattern-tips.css";
import "../../../styles/glossary-tooltip.css";
import "../../../styles/patterns/sleeveless-print-route.css";

const pageUrl = Astro.url.href;
---

<Layout
  title="Print Sleeveless Pattern | Knit it Now"
  description="Printable sleeveless sweater pattern from your saved pattern choices."
  bodyClass="sleeveless-print-route pattern-print-global-footer"
>
  <PatternPrintFooter footerBottomLeftExtra=" · KnitItNow.com/sleeveless" />
  <PatternPrintPersonalization includePrintSection={false} />
  <SleevelessPatternMemberGate>
  <div class="sleeveless-print-shell" data-pattern-print-skip-modal>
    <div class="sleeveless-print-actions no-print">
      <WizardBackLink className="back-link" fallback="/patterns/sleeveless/pattern" />
      <button type="button" class="sleeveless-print-btn" data-sleeveless-print-action>
        Print / Save as PDF
      </button>
    </div>

    <div class="sleeveless-print-root" data-sleeveless-print-root>
      <p class="sleeveless-print-loading">Loading pattern…</p>
    </div>

    <p class="print-url-meta no-print" aria-hidden="true">{pageUrl}</p>
  </div>
  </SleevelessPatternMemberGate>
</Layout>

<script>
  import "/src/scripts/sleeveless-print-page.ts";
</script>
