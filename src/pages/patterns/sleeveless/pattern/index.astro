---
import Layout from "../../../../layouts/Layout.astro";
import SleevelessPatternMemberGate from "../../../../components/patterns/SleevelessPatternMemberGate.astro";
import PatternPrintFooter from "../../../../components/common/PatternPrintFooter.astro";
import PatternPrintPersonalization from "../../../../components/common/PatternPrintPersonalization.astro";
import PatternTipsToggle from "../../../../components/patterns/PatternTipsToggle.astro";
import PatternWorkspaceTabs from "../../../../components/patterns/PatternWorkspaceTabs.astro";
import SleevelessPatternPrintNotice from "../../../../components/patterns/SleevelessPatternPrintNotice.astro";

import "../../../../styles/ns-shaping-chart.css";
import "../../../../styles/wizard.css";
import "../../../../styles/glossary-tooltip.css";
import "../../../../styles/pattern-tips.css";
import "../../../../styles/pattern-quick-tip.css";
import "../../../../styles/pattern-help-card.css";

import "../../../../styles/patterns/sleeveless-pattern-shared.css";

// Reused measurement editor styling (same diagram/overlay as Custom Build → Measurements).
import "../../../../styles/sleeveless-express-measurements-confirm.css";
import "../../../../styles/sleeveless-custom-build-measurements.css";

const customBuildHref = "/patterns/sleeveless/custom-build/";
const expressHref = "/patterns/sleeveless-express/";
const patternHref = "/patterns/sleeveless/pattern/";
const askShareHref = "/patterns/sleeveless/ask-share/";
const inspirationHref = "/patterns/sleeveless/inspiration/";
---

<Layout
  title="Sleeveless Sweater Pattern | Knit it Now"
  description="Generated sleeveless sweater pattern instructions, diagrams, glossary help, and videos from your saved builder choices."
  bodyClass="pattern-print-global-footer"
>
  <PatternPrintFooter footerBottomLeftExtra=" · KnitItNow.com/sleeveless" />
  <SleevelessPatternMemberGate>
  <main class="wizard-page sleeveless-pattern-page sleeveless-workspace-subpage" data-pattern-print-skip-modal>
    <div id="sleeveless-pattern-top" class="wizard-container scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternWorkspaceTabs
          rootClass="pattern-tabs-scope"
          activeTab="pattern"
          expressHref={expressHref}
          customBuildHref={customBuildHref}
          patternHref={patternHref}
          askShareHref={askShareHref}
          inspirationHref={inspirationHref}
        />

        <div id="sg-sleeveless-results" class="sg-sleeveless-results">
          <div id="sleeveless-pattern-tips-scope" class="pattern-tips-scope" data-show-tips="true">
            <SleevelessPatternPrintNotice />
            <section class="sleeveless-pattern-intro">
              <div class="sleeveless-pattern-intro__image">
                <div class="beta-pattern-video">
                  <div class="beta-pattern-video__wrap">
                    <img
                      src="/images/patterns/sleeveless/sleeveless_woman.png"
                      alt="Sleeveless sweater pattern preview"
                      width="593"
                      height="664"
                      loading="lazy"
                      decoding="async"
                      class="sg-pattern-hero-image"
                      data-sleeveless-audience-hero
                    />
                  </div>
                </div>
                <div class="pattern-print-origin" aria-hidden="true">
                  <div class="pattern-print-origin__label">Created with the Knit It Now Sleeveless Pattern Builder</div>
                  <div class="pattern-print-origin__url">KnitItNow.com/sleeveless</div>
                </div>
              </div>
              <div class="sleeveless-pattern-intro__content">
                <div
                  class="sleeveless-pattern-actions no-print"
                  data-sleeveless-pattern-actions
                >
                  <button
                    type="button"
                    class="sleeveless-pattern-edit-action no-print"
                    data-sl-edit-open
                    data-testid="button-edit-pattern"
                    aria-haspopup="dialog"
                    aria-controls="sl-edit-drawer-panel"
                  >
                    <i class="fas fa-pen" aria-hidden="true"></i> Edit Pattern
                  </button>
                </div>
                <div class="sleeveless-pattern-online-project-header no-print">
                  <div class="sleeveless-pattern-online-heading-row">
                    <p class="sleeveless-pattern-online-heading" data-sleeveless-pattern-online-heading>
                      Sleeveless sweater · Pattern instructions
                    </p>
                  </div>
                  <div
                    class="sleeveless-pattern-project-notes-wrap"
                    data-sleeveless-pattern-online-notes-wrap
                    hidden
                  >
                    <div class="sleeveless-pattern-project-notes__head">
                      <p class="sleeveless-pattern-project-notes__label">Project notes</p>
                    </div>
                    <div
                      class="sleeveless-pattern-project-notes"
                      data-sleeveless-pattern-online-notes
                      hidden
                    >
                      <div
                        class="sleeveless-pattern-project-notes__text"
                        data-sleeveless-pattern-online-notes-text
                      ></div>
                    </div>
                  </div>
                </div>
                <PatternPrintPersonalization>
                  <div slot="print-summary" class="sg-pattern-print-at-a-glance" data-sg-pattern-print-at-a-glance>
                    <h2 class="print-heading-major print-heading-major--hero">At a glance</h2>
                    <div data-sg-pattern-print-basics-body></div>
                  </div>
                </PatternPrintPersonalization>
                <div
                  class="sg-pattern-intro-metadata pattern-generated-description"
                  data-sg-pattern-intro
                  data-pattern-generated-description
                  aria-label="Pattern summary"
                ></div>
                <PatternTipsToggle
                  storageKey="sleeveless-show-tips"
                  scopeSelector="#sleeveless-pattern-tips-scope"
                />
              </div>
            </section>

            <div id="pattern-content" data-pattern-content>
              <nav
                class="sleeveless-pattern-inpage-nav no-print"
                data-sleeveless-pattern-inpage-nav
                aria-label="Jump to pattern section"
                hidden
              ></nav>
              <div class="sleeveless-pattern-mount" data-sleeveless-mount>
                <p class="sleeveless-pattern-boot-msg">Loading pattern…</p>
              </div>
            </div>
          </div>
        </div>

        <noscript>
          <div class="pattern-section">
            <h2 class="pattern-noscript-heading">Pattern</h2>
            <p>Turn on JavaScript to view this pattern.</p>
          </div>
        </noscript>
      </div>
    </div>

    <!--
      PROTOTYPE ONLY — pattern editing drawer (UX experiment).
      Not wired to regeneration, save/update, DB, or Netlify Blob.
    -->
    <div class="sl-edit-drawer no-print" data-sl-edit-drawer aria-hidden="true">
      <div class="sl-edit-drawer__backdrop" data-sl-edit-close aria-hidden="true"></div>
      <aside
        id="sl-edit-drawer-panel"
        class="sl-edit-drawer__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="sl-edit-drawer-title"
        tabindex="-1"
      >
        <header class="sl-edit-drawer__header">
          <div class="sl-edit-drawer__heading">
            <h2 id="sl-edit-drawer-title" class="sl-edit-drawer__title">Edit Pattern</h2>
            <p class="sl-edit-drawer__subtitle">Adjust your pattern details, then update.</p>
          </div>
          <button
            type="button"
            class="sl-edit-drawer__close"
            data-sl-edit-close
            data-testid="button-edit-close"
            aria-label="Close editing panel"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M18 6L6 18M6 6l12 12"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </header>

        <div class="sl-edit-drawer__body">
          <div class="sl-edit-field">
            <label class="sl-edit-label" for="sl-edit-title">Pattern title</label>
            <input
              type="text"
              id="sl-edit-title"
              class="sl-edit-input"
              placeholder="Sleeveless sweater"
              autocomplete="off"
            />
          </div>

          <fieldset class="sl-edit-field sl-edit-fieldset">
            <legend class="sl-edit-label">Neckline</legend>
            <div class="sl-edit-segment" role="radiogroup" aria-label="Neckline">
              <label class="sl-edit-segment__option">
                <input type="radio" name="sl-edit-neckline" value="round" checked />
                <span class="sl-edit-segment__pill">Round Neck</span>
              </label>
              <label class="sl-edit-segment__option">
                <input type="radio" name="sl-edit-neckline" value="v" />
                <span class="sl-edit-segment__pill">V-Neck</span>
              </label>
            </div>
          </fieldset>

          <fieldset class="sl-edit-field sl-edit-fieldset">
            <legend class="sl-edit-label">Gauge</legend>
            <div class="sl-edit-grid">
              <div class="sl-edit-subfield">
                <label class="sl-edit-sublabel" for="sl-edit-spi">Stitches per inch</label>
                <input
                  type="number"
                  id="sl-edit-spi"
                  class="sl-edit-input"
                  inputmode="decimal"
                  min="0"
                  step="0.1"
                  placeholder="e.g. 5"
                />
              </div>
              <div class="sl-edit-subfield">
                <label class="sl-edit-sublabel" for="sl-edit-rpi">Rows per inch</label>
                <input
                  type="number"
                  id="sl-edit-rpi"
                  class="sl-edit-input"
                  inputmode="decimal"
                  min="0"
                  step="0.1"
                  placeholder="e.g. 7"
                />
              </div>
              <div class="sl-edit-subfield">
                <label class="sl-edit-sublabel" for="sl-edit-needles">Needles available</label>
                <input
                  type="number"
                  id="sl-edit-needles"
                  class="sl-edit-input"
                  inputmode="numeric"
                  min="0"
                  step="1"
                  placeholder="e.g. 200"
                />
              </div>
            </div>
          </fieldset>

          <section class="sl-edit-field sl-edit-measure-cta" aria-label="Measurements">
            <h3 class="sl-edit-label">Measurements</h3>
            <p class="sl-edit-measure-cta__text">
              Edit the sweater measurements on a larger diagram.
            </p>
            <button
              type="button"
              class="sl-edit-btn sl-edit-btn--secondary sl-edit-measure-cta__btn"
              data-sl-measure-open
              data-testid="button-edit-measurements"
              aria-haspopup="dialog"
              aria-controls="sl-measure-workspace-inner"
            >
              <i class="fas fa-ruler-combined" aria-hidden="true"></i> Edit Measurements
            </button>
          </section>
        </div>

        <footer class="sl-edit-drawer__footer">
          <p class="sl-edit-prototype-note" data-sl-edit-note hidden>
            Prototype only — this does not save or regenerate yet.
          </p>
          <div class="sl-edit-drawer__actions">
            <button
              type="button"
              class="sl-edit-btn sl-edit-btn--ghost"
              data-sl-edit-close
              data-testid="button-edit-cancel"
            >
              Cancel
            </button>
            <button
              type="button"
              class="sl-edit-btn sl-edit-btn--primary"
              data-sl-edit-update
              data-testid="button-edit-update"
            >
              Update Pattern
            </button>
          </div>
        </footer>
      </aside>
    </div>

    <!--
      PROTOTYPE ONLY — full-screen measurement editor workspace (UX experiment).
      Not wired to regeneration, save/update, DB, or Netlify Blob.
    -->
    <div class="sl-measure-workspace no-print" data-sl-measure-workspace aria-hidden="true">
      <div
        id="sl-measure-workspace-inner"
        class="sl-measure-workspace__inner"
        role="dialog"
        aria-modal="true"
        aria-labelledby="sl-measure-title"
        tabindex="-1"
      >
        <header class="sl-measure-workspace__header">
          <h2 id="sl-measure-title" class="sl-measure-workspace__title">Edit Measurements</h2>
          <button
            type="button"
            class="sl-edit-btn sl-edit-btn--ghost sl-measure-workspace__back"
            data-sl-measure-back
            data-testid="button-measure-back"
          >
            <i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Pattern
          </button>
        </header>

        <!--
          Reuses the live Custom Build measurement editor (`initCustomBuildMeasurementsPage`):
          same pattern_summary.svg, labels, field names, and overlay positions as the builder.
          `data-sleeveless-review-managed` suppresses the editor's auto-init so the prototype
          can initialise it lazily when the workspace opens.
        -->
        <div class="sl-measure-workspace__body cb-measure-page express-measurements-confirm-page">
          <div
            class="sl-measure-workspace__editor"
            data-cb-measure-root
            data-sleeveless-review-managed
          >
            <div class="sleeveless-measure-review-body">
              <div
                class="sleeveless-measure-project-summary"
                data-cb-build-summary
                aria-label="Current build summary"
              ></div>
              <p class="cb-measure-missing" data-cb-measure-missing hidden>
                Complete Foundation and Style &amp; Shaping to load measurements.
              </p>
              <div
                class="sleeveless-measure-diagram-host cb-measure-diagram-host"
                data-cb-measure-diagram
              ></div>
            </div>
          </div>
        </div>

        <footer class="sl-measure-workspace__footer">
          <p class="sl-edit-prototype-note" data-sl-measure-note hidden>
            Prototype only — measurements are not applied or regenerated yet.
          </p>
          <div class="sl-measure-workspace__actions">
            <button
              type="button"
              class="sl-edit-btn sl-edit-btn--ghost"
              data-sl-measure-cancel
              data-testid="button-measure-cancel"
            >
              Cancel
            </button>
            <button
              type="button"
              class="sl-edit-btn sl-edit-btn--primary"
              data-sl-measure-apply
              data-testid="button-measure-apply"
            >
              Apply Measurements
            </button>
          </div>
        </footer>
      </div>
    </div>

  </main>
  </SleevelessPatternMemberGate>
</Layout>

<style>
  .sleeveless-pattern-online-project-header {
    margin: 0 0 0.75rem;
  }

  .sleeveless-pattern-online-heading-row {
    margin: 0 0 0.4rem;
  }

  .sleeveless-pattern-online-heading {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    color: #374151;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .sleeveless-pattern-project-notes-wrap {
    margin: 0;
  }

  .sleeveless-pattern-project-notes__head {
    margin-bottom: 0.25rem;
  }

  .sleeveless-pattern-project-notes {
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--kbm-green, #52682d) 14%, #e5e7eb);
    background: color-mix(in srgb, var(--kbm-green, #52682d) 4%, #fff);
  }

  .sleeveless-pattern-project-notes__label {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--kbm-green, #52682d) 55%, #6b7280);
  }

  .sleeveless-pattern-project-notes__text {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: #4b5563;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .sleeveless-pattern-intro__image {
    width: 100%;
    min-width: 280px;
    justify-self: end;
  }

  .beta-pattern-video {
    display: block;
    width: 360px;
    max-width: 100%;
  }

  .beta-pattern-video__wrap {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    border-radius: 8px;
    background: transparent;
  }

  .sg-pattern-hero-image {
    display: block;
    width: 100%;
    max-height: 320px;
    height: auto;
    object-fit: contain;
    border-radius: inherit;
  }

  @media (max-width: 560px) {
    .sleeveless-pattern-intro__image {
      min-width: 0;
      justify-self: stretch;
    }

    .beta-pattern-video {
      width: 100%;
    }
  }

  @media print {
    :global(#pattern-content .pattern-section),
    :global(#pattern-content .pattern-section--garment-piece),
    :global(#pattern-content .pattern-layout.pattern-layout--garment-columns),
    :global(#pattern-content .sleeveless-piece-split) {
      break-inside: auto !important;
      page-break-inside: auto !important;
    }

    :global(#pattern-content .pattern-section) {
      break-before: auto !important;
      page-break-before: auto !important;
    }

    :global(#pattern-content .pattern-section__heading),
    :global(#pattern-content .pattern-subsection__heading),
    :global(#pattern-content .sleeveless-piece-split__diagram) {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }

    :global(#pattern-content .pattern-layout.pattern-layout--garment-columns),
    :global(#pattern-content .sleeveless-piece-split) {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(180px, 2.6in) !important;
      column-gap: 0.35in !important;
      row-gap: 0 !important;
      align-items: start !important;
    }

    :global(#pattern-content .pattern-layout__content),
    :global(#pattern-content .sleeveless-piece-split__text) {
      min-width: 0 !important;
      order: 0 !important;
    }

    :global(#pattern-content .pattern-layout__sidebar),
    :global(#pattern-content .sleeveless-piece-split__diagram) {
      display: block !important;
      visibility: visible !important;
      position: static !important;
      top: auto !important;
      inset: auto !important;
      order: 0 !important;
      align-self: start !important;
      justify-self: end !important;
      width: auto !important;
      max-width: 2.6in !important;
      overflow: visible !important;
    }

    :global(#pattern-content .sleeveless-piece-split__diagram-inner),
    :global(#pattern-content .sleeveless-piece-split__diagram-trigger) {
      display: block !important;
      visibility: visible !important;
      position: static !important;
      cursor: default !important;
      width: 100% !important;
      max-width: 2.6in !important;
      height: auto !important;
      overflow: visible !important;
    }

    :global(#pattern-content .sleeveless-piece-split__diagram-svg),
    :global(#pattern-content .sleeveless-piece-split__diagram-inline),
    :global(#pattern-content .sleeveless-piece-split__diagram-svg > svg),
    :global(#pattern-content .sleeveless-piece-split__diagram img),
    :global(#pattern-content .sleeveless-piece-split__diagram svg) {
      display: block !important;
      visibility: visible !important;
      width: 100% !important;
      max-width: 2.6in !important;
      height: auto !important;
      opacity: 1 !important;
      overflow: visible !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
  }

  /*
   * PROTOTYPE ONLY — Edit Pattern drawer (UX experiment).
   * Desktop: right-side drawer. Mobile: full-screen panel.
   * Calm, roomy spacing so the measurement editor has space to grow later.
   */
  .sl-edit-drawer {
    position: fixed;
    inset: 0;
    z-index: 1450;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0s linear 0.2s;
  }

  .sl-edit-drawer.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.2s ease;
  }

  .sl-edit-drawer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(17, 24, 39, 0.45);
  }

  .sl-edit-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    width: clamp(360px, 34vw, 480px);
    max-width: 100%;
    background: #fff;
    box-shadow: -10px 0 32px rgba(17, 24, 39, 0.18);
    transform: translateX(100%);
    transition: transform 0.24s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sl-edit-drawer.is-open .sl-edit-drawer__panel {
    transform: translateX(0);
  }

  .sl-edit-drawer__panel:focus {
    outline: none;
  }

  .sl-edit-drawer__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.35rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--kbm-green, #52682d) 12%, #e5e7eb);
  }

  .sl-edit-drawer__title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--kbm-green, #52682d);
  }

  .sl-edit-drawer__subtitle {
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
    line-height: 1.4;
    color: #6b7280;
  }

  .sl-edit-drawer__close {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: -0.25rem -0.4rem 0 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #6b7280;
    cursor: pointer;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .sl-edit-drawer__close:hover {
    background: rgba(17, 24, 39, 0.06);
    color: #1f2937;
  }

  .sl-edit-drawer__close:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }

  .sl-edit-drawer__body {
    flex: 1 1 auto;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sl-edit-field {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .sl-edit-fieldset {
    min-width: 0;
  }

  .sl-edit-label {
    display: block;
    margin: 0 0 0.5rem;
    padding: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--kbm-green, #52682d) 55%, #6b7280);
  }

  .sl-edit-sublabel {
    display: block;
    margin: 0 0 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #4b5563;
  }

  .sl-edit-input {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 0.6rem 0.75rem;
    font-family: inherit;
    font-size: 0.95rem;
    line-height: 1.4;
    color: #1f2937;
    background: #fff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
  }

  .sl-edit-input:focus {
    outline: none;
    border-color: var(--kbm-green, #52682d);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--kbm-green, #52682d) 18%, transparent);
  }

  .sl-edit-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
  }

  @media (min-width: 420px) {
    .sl-edit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .sl-edit-subfield {
    min-width: 0;
  }

  .sl-edit-segment {
    display: flex;
    gap: 0.5rem;
  }

  .sl-edit-segment__option {
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    cursor: pointer;
  }

  .sl-edit-segment__option input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
