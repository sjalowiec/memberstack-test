---
import Layout from "../../../layouts/Layout.astro";
import PrintFooter from "../../../components/common/PrintFooter.astro";
import PatternTipsToggle from "../../../components/patterns/PatternTipsToggle.astro";
import ActionBar from "../../../components/wizards/ActionBar.astro";

import "../../../styles/ns-shaping-chart.css";
import "../../../styles/wizard.css";
import "../../../styles/glossary-tooltip.css";
import "../../../styles/pattern-tips.css";

import "../../../styles/patterns/sleeveless-pattern-shared.css";

const pageUrl = Astro.url.href;
---

<Layout
  title="Sleeveless Sweater (Beta) — Published Pattern | Knit it Now"
  description="Read-only sleeveless sweater beta pattern: instructions, diagrams, glossary help, and videos."
>
  <main class="wizard-page sleeveless-pattern-page sleeveless-beta-readonly-pattern">
    <div class="sleeveless-beta-pattern__top no-print">
      <div class="sleeveless-beta-pattern__top-inner">
        <p class="sleeveless-beta-pattern__label">Sleeveless sweater · Beta · Published pattern</p>
      </div>
    </div>

    <div id="sleeveless-beta-pattern-top" class="wizard-container scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <div id="sg-sleeveless-results" class="sg-sleeveless-results">
          <ActionBar formScrollTarget="sleeveless-beta-pattern-top" showEditButton={false} />
          <div id="sleeveless-pattern-tips-scope" class="pattern-tips-scope" data-show-tips="true">
            <section class="sleeveless-pattern-intro">
              <div class="sleeveless-pattern-intro__image">
                <div class="beta-pattern-video">
                  <div class="beta-pattern-video__wrap">
                    <button
                      type="button"
                      class="beta-pattern-video-trigger no-print"
                      aria-label="Play video: Beta Pattern Introduction"
                      data-sleeveless-video-id="1190804765"
                      data-video-title="Beta Pattern Introduction"
                    >
                      <img
                        src="/images/patterns/sleeveless/beta-pattern-intro-video-thumbnail.jpg"
                        alt="Watch the beta pattern introduction"
                        width="360"
                        height="203"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="beta-pattern-video-trigger__play">
                        <i class="fa-solid fa-play" aria-hidden="true"></i>
                      </span>
                    </button>
                  </div>
                </div>
              </div>
              <div class="sleeveless-pattern-intro__content">
                <p class="sg-pattern-intro-line" data-sg-pattern-intro></p>
                <PatternTipsToggle
                  storageKey="sleeveless-show-tips"
                  scopeSelector="#sleeveless-pattern-tips-scope"
                />

                <p
                  class="sg-pattern-soft-warning no-print"
                  data-sg-generator-note
                  hidden
                  role="status"
                >
                  Double-check critical measurements against your sizing chart if anything looks off.
                </p>
              </div>
            </section>

            <div id="pattern-content" data-pattern-content>
              <div class="sleeveless-pattern-mount" data-sleeveless-mount>
                <p class="sleeveless-pattern-boot-msg">Loading pattern…</p>
              </div>
            </div>
          </div>
        </div>

        <noscript>
          <div class="pattern-section">
            <h2 class="pattern-noscript-heading">Pattern</h2>
            <p>Turn on JavaScript to view this published pattern.</p>
          </div>
        </noscript>
      </div>
    </div>

    <div id="print-footer" style="display: none">
      <PrintFooter url={pageUrl} />
    </div>
  </main>
</Layout>


<style>
  .sleeveless-beta-pattern__top {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0.75rem 1rem 0;
  }

  .sleeveless-beta-pattern__top-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .sleeveless-beta-pattern__label {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: #374151;
  }

  /* Prevent grid shrink-collapse on the intro media column (override shared justify-self sizing). */
  .sleeveless-pattern-intro__image {
    width: 100%;
    min-width: 280px;
    justify-self: end;
  }

  .beta-pattern-video {
    display: block;
    width: 360px;
    max-width: 100%;
  }

  .beta-pattern-video__wrap {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    background: #111;
  }

  .beta-pattern-video-trigger {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    background: transparent;
  }

  .beta-pattern-video-trigger:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }

  .beta-pattern-video-trigger :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .beta-pattern-video-trigger__play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: rgba(17, 24, 39, 0.72);
    color: #fff;
    font-size: 1.1rem;
    pointer-events: none;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 560px) {
    .sleeveless-pattern-intro__image {
      min-width: 0;
      justify-self: stretch;
    }

    .beta-pattern-video {
      width: 100%;
    }
  }

  @media print {
    :global(#pattern-content .pattern-section),
    :global(#pattern-content .pattern-section--garment-piece),
    :global(#pattern-content .pattern-layout.pattern-layout--garment-columns),
    :global(#pattern-content .sleeveless-piece-split) {
      break-inside: auto !important;
      page-break-inside: auto !important;
    }

    :global(#pattern-content .pattern-section) {
      break-before: auto !important;
      page-break-before: auto !important;
    }

    :global(#pattern-content .pattern-section__heading),
    :global(#pattern-content .pattern-subsection__heading),
    :global(#pattern-content .sleeveless-piece-split__diagram) {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }

    :global(#pattern-content .pattern-layout.pattern-layout--garment-columns),
    :global(#pattern-content .sleeveless-piece-split) {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(180px, 2.6in) !important;
      column-gap: 0.35in !important;
      row-gap: 0 !important;
      align-items: start !important;
    }

    :global(#pattern-content .pattern-layout__content),
    :global(#pattern-content .sleeveless-piece-split__text) {
      min-width: 0 !important;
      order: 0 !important;
    }

    :global(#pattern-content .pattern-layout__sidebar),
    :global(#pattern-content .sleeveless-piece-split__diagram) {
      display: block !important;
      visibility: visible !important;
      position: static !important;
      top: auto !important;
      inset: auto !important;
      order: 0 !important;
      align-self: start !important;
      justify-self: end !important;
      width: auto !important;
      max-width: 2.6in !important;
      overflow: visible !important;
    }

    :global(#pattern-content .sleeveless-piece-split__diagram-inner),
    :global(#pattern-content .sleeveless-piece-split__diagram-trigger) {
      display: block !important;
      visibility: visible !important;
      position: static !important;
      cursor: default !important;
      width: 100% !important;
      max-width: 2.6in !important;
      height: auto !important;
      overflow: visible !important;
    }

    :global(#pattern-content .sleeveless-piece-split__diagram-svg),
    :global(#pattern-content .sleeveless-piece-split__diagram-inline),
    :global(#pattern-content .sleeveless-piece-split__diagram-svg > svg),
    :global(#pattern-content .sleeveless-piece-split__diagram img),
    :global(#pattern-content .sleeveless-piece-split__diagram svg) {
      display: block !important;
      visibility: visible !important;
      width: 100% !important;
      max-width: 2.6in !important;
      height: auto !important;
      opacity: 1 !important;
      overflow: visible !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
  }

</style>

<script>
  import "/src/scripts/sleevelessBetaPatternPage.ts";
</script>
