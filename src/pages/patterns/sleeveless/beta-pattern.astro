---
import Layout from "../../../layouts/Layout.astro";
import PatternPrintFooter from "../../../components/common/PatternPrintFooter.astro";
import PatternPrintPersonalization from "../../../components/common/PatternPrintPersonalization.astro";
import SavedPatternHeader from "../../../components/patterns/SavedPatternHeader.astro";
import SavedPatternStickyNav from "../../../components/patterns/SavedPatternStickyNav.astro";
import ActionBar from "../../../components/wizards/ActionBar.astro";
import SleevelessPatternPrintNotice from "../../../components/patterns/SleevelessPatternPrintNotice.astro";

import "../../../styles/ns-shaping-chart.css";
import "../../../styles/wizard.css";
import "../../../styles/glossary-tooltip.css";
import "../../../styles/pattern-tips.css";
import "../../../styles/pattern-quick-tip.css";
import "../../../styles/pattern-help-card.css";

import "../../../styles/patterns/sleeveless-pattern-shared.css";
import "../../../styles/patterns/pattern-diagram-tabs.css";
import "../../../styles/patterns/pattern-app-shell.css";

---

<Layout
  title="Sleeveless Sweater (Beta) — Published Pattern | Knit it Now"
  description="Read-only sleeveless sweater beta pattern: instructions, diagrams, glossary help, and videos."
  bodyClass="pattern-print-global-footer"
>
  <PatternPrintFooter footerBottomLeftExtra=" · KnitItNow.com/sleeveless" />
  <main class="wizard-page sleeveless-pattern-page sleeveless-beta-readonly-pattern pattern-app-shell" data-pattern-print-skip-modal>
    <p class="beta-pattern-express-notice no-print" role="status">
      You’ve already previewed the pattern results. Now take a look at the
      <a href="/patterns/sleeveless-express">Express Builder</a>
      and create your own sweater pattern.
    </p>

    <div class="sleeveless-beta-pattern__top no-print">
      <div class="sleeveless-beta-pattern__top-inner">
        <p class="sleeveless-beta-pattern__label">Sleeveless sweater · Beta · Published pattern</p>
      </div>
    </div>

    <div id="sleeveless-beta-pattern-top" class="wizard-container scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <div id="sg-sleeveless-results" class="sg-sleeveless-results">
          <ActionBar formScrollTarget="sleeveless-beta-pattern-top" />
          <div id="sleeveless-pattern-tips-scope" class="pattern-tips-scope" data-show-tips="true">
            <SleevelessPatternPrintNotice />
            <SavedPatternHeader
              part="intro"
              showTitle={false}
              showNotes={false}
              thumbnailSrc="/images/patterns/sleeveless.webp"
              thumbnailAlt="Sleeveless sweater pattern preview"
              thumbnailWidth={1536}
              thumbnailHeight={1024}
              tipsStorageKey="sleeveless-show-tips"
              tipsScopeSelector="#sleeveless-pattern-tips-scope"
              printOriginLabel="Created with the Knit It Now Sleeveless Pattern Builder"
              printOriginUrl="KnitItNow.com/sleeveless"
            >
              <PatternPrintPersonalization slot="print-personalization">
                <div slot="print-summary" class="sg-pattern-print-at-a-glance" data-sg-pattern-print-at-a-glance>
                  <h2 class="print-heading-major print-heading-major--hero">At a glance</h2>
                  <div data-sg-pattern-print-basics-body></div>
                </div>
              </PatternPrintPersonalization>
            </SavedPatternHeader>

            <div id="pattern-content" data-pattern-content>
              <SavedPatternStickyNav />
              <div class="sleeveless-pattern-mount" data-sleeveless-mount>
                <p class="sleeveless-pattern-boot-msg">Loading pattern…</p>
              </div>
            </div>
          </div>
        </div>

        <noscript>
          <div class="pattern-section">
            <h2 class="pattern-noscript-heading">Pattern</h2>
            <p>Turn on JavaScript to view this published pattern.</p>
          </div>
        </noscript>
      </div>
    </div>

  </main>
</Layout>


<style>
  .beta-pattern-express-notice {
    max-width: 52rem;
    margin: 0.75rem auto 0.5rem;
    padding: 0.45rem 1rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.45;
    color: #374151;
    background: #f3f6ef;
    border: 1px solid #d8e3c8;
    border-radius: 6px;
  }

  .beta-pattern-express-notice a {
    color: var(--kbm-green, #52682d);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .beta-pattern-express-notice a:hover {
    text-decoration-thickness: 2px;
  }

  .sleeveless-beta-pattern__top {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0.75rem 1rem 0;
  }

  .sleeveless-beta-pattern__top-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .sleeveless-beta-pattern__label {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: #374151;
  }

  @media print {
    :global(#pattern-content .pattern-section),
    :global(#pattern-content .pattern-section--garment-piece),
    :global(#pattern-content .pattern-layout.pattern-layout--garment-columns),
    :global(#pattern-content .sleeveless-piece-split) {
      break-inside: auto !important;
      page-break-inside: auto !important;
    }

    :global(#pattern-content .pattern-section) {
      break-before: auto !important;
      page-break-before: auto !important;
    }

    :global(#pattern-content .pattern-section__heading),
    :global(#pattern-content .pattern-subsection__heading),
    :global(#pattern-content .sleeveless-piece-split__diagram) {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }

    :global(#pattern-content .pattern-layout.pattern-layout--garment-columns),
    :global(#pattern-content .sleeveless-piece-split) {
      --garment-print-diagram-track: 2.6in;
      --garment-print-column-gap: 0.35in;
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(180px, var(--garment-print-diagram-track)) !important;
      column-gap: var(--garment-print-column-gap) !important;
      row-gap: 0 !important;
      align-items: start !important;
    }

    :global(#pattern-content .pattern-layout__content),
    :global(#pattern-content .sleeveless-piece-split__text) {
      min-width: 0 !important;
      order: 0 !important;
    }

    :global(#pattern-content .pattern-layout__sidebar),
    :global(#pattern-content .sleeveless-piece-split__diagram) {
      display: block !important;
      visibility: visible !important;
      position: static !important;
      top: auto !important;
      inset: auto !important;
      order: 0 !important;
      align-self: start !important;
      justify-self: end !important;
      width: auto !important;
      max-width: 2.6in !important;
      overflow: visible !important;
    }

    :global(#pattern-content .sleeveless-piece-split__diagram-inner),
    :global(#pattern-content .sleeveless-piece-split__diagram-trigger) {
      display: block !important;
      visibility: visible !important;
      position: static !important;
      cursor: default !important;
      width: 100% !important;
      max-width: 2.6in !important;
      height: auto !important;
      overflow: visible !important;
    }

    :global(#pattern-content .sleeveless-piece-split__diagram-svg),
    :global(#pattern-content .sleeveless-piece-split__diagram-inline),
    :global(#pattern-content .sleeveless-piece-split__diagram-svg > svg),
    :global(#pattern-content .sleeveless-piece-split__diagram img),
    :global(#pattern-content .sleeveless-piece-split__diagram svg) {
      display: block !important;
      visibility: visible !important;
      width: 100% !important;
      max-width: 2.6in !important;
      height: auto !important;
      opacity: 1 !important;
      overflow: visible !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
  }

</style>

<script>
  import "/src/scripts/sleevelessBetaPatternPage.ts";
</script>
