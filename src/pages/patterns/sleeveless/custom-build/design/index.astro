---
import Layout from "../../../../../layouts/Layout.astro";
import SleevelessPatternMemberGate from "../../../../../components/patterns/SleevelessPatternMemberGate.astro";
import PatternPhoneWorkspaceNotice from "../../../../../components/patterns/PatternPhoneWorkspaceNotice.astro";
import WizardBackLink from "../../../../../components/wizards/WizardBackLink.astro";
import UnitToggle from "../../../../../components/wizards/UnitToggle.astro";
import ExpressBuilderWhoPicker from "../../../../../components/patterns/ExpressBuilderWhoPicker.astro";
import "../../../../../styles/sleeveless-express-builder-cards.css";
import "../../../../../styles/sleeveless-express-wizard-layout.css";
import "../../../../../styles/express-size-selection.css";
import "../../../../../styles/custom-pattern-editing-banner.css";

const styleHref = "/patterns/sleeveless/custom-style";

const customWizardSteps = [
  { step: 1, label: "Foundation" },
  { step: 2, label: "Style & Shaping" },
  { step: 3, label: "Measurements" },
  { step: 4, label: "Yarn & Gauge" },
  { step: 5, label: "Pattern" },
] as const;
---

<Layout
  title="Custom Pattern — Foundation | Sleeveless Sweater"
  description="Choose who you are knitting for and a starting size for your custom sleeveless sweater pattern."
  patternWorkspace={true}
>
  <SleevelessPatternMemberGate>
  <main
    class="express-page wizard-page sleeveless-express-page"
    data-express-page="sleeveless-custom-build-design"
  >
    <div id="cb-design-top" class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternPhoneWorkspaceNotice />
        <WizardBackLink className="back-link no-print" fallback="/patterns" />
        <div data-cb-editing-banner-host hidden></div>

        <div class="sg-tab-build">
          <div
            class="express-builder-nav-row express-builder-nav-row--custom-flow no-print"
            data-cb-custom-build-stepper
          >
            <nav class="express-step-nav sg-builder-nav" aria-label="Custom build steps">
              <ol class="express-step-nav__list sg-builder-nav__list" role="list">
                {
                  customWizardSteps.map((s, i) => (
                    <li class:list={["express-step-nav__item", "sg-builder-nav__item", { active: s.step === 1 }]}>
                      <button
                        type="button"
                        class:list={[
                          "express-step-nav__btn",
                          "sg-builder-nav__link",
                          {
                            "is-current": s.step === 1,
                            "is-upcoming": s.step > 1,
                          },
                        ]}
                        data-cb-flow-pill={s.step}
                        data-cb-flow-label={s.label}
                        aria-current={s.step === 1 ? "page" : undefined}
                        aria-disabled={s.step > 1 ? "true" : undefined}
                        title={s.step > 1 ? "Use Continue to move through the Custom Pattern steps." : undefined}
                      >
                        <span class="express-step-nav__track">
                          <span
                            class:list={[
                              "express-step-nav__seg",
                              "express-step-nav__seg--before",
                              { "express-step-nav__seg--empty": i === 0 },
                            ]}
                            aria-hidden="true"
                          />
                          <span class="express-step-nav__circle">
                            <span class="express-step-nav__num">{s.step}</span>
                            <span class="express-pill__check" aria-hidden="true">
                              ✓
                            </span>
                          </span>
                          <span
                            class:list={[
                              "express-step-nav__seg",
                              "express-step-nav__seg--after",
                              { "express-step-nav__seg--empty": i === customWizardSteps.length - 1 },
                            ]}
                            aria-hidden="true"
                          />
                        </span>
                        <span class="express-step-nav__label">{s.label}</span>
                      </button>
                    </li>
                  ))
                }
              </ol>
            </nav>
          </div>

          <header class="pattern-header page-header" data-cb-foundation-header>
            <p class="pattern-mode-label">Custom Pattern</p>
            <h1 class="pattern-title" data-cb-foundation-step-title>Foundation</h1>
            <p class="pattern-subtext" data-cb-onboarding-only>
              Start with who you are knitting for and the size you want to use. These choices create the base sizing
              framework for your custom pattern.
            </p>
            <p class="pattern-subtext" data-cb-onboarding-only>
              Foundation covers who you are knitting for and starting size only. Neckline, fit, and silhouette choices
              come next in Style &amp; Shaping.
            </p>
            <p class="pattern-subtext" data-cb-onboarding-only>
              <a href="/patterns/sleeveless-express/" class="express-custom-build-callout__link"
                >Prefer fewer steps?</a
              >
              &nbsp;Use Express and your choices can carry over here.
            </p>
            <p class="pattern-subtext" data-cb-editing-project-name hidden></p>
            <p class="pattern-subtext" data-cb-editing-helper hidden>
              Make changes below, then save your project when you're ready.
            </p>
          </header>

          <div class="express-panel calculator-card">
            <div class="express-builder-root" data-cb-design-root>
              <div class="express-builder-toolbar no-print">
                <button type="button" id="cb-design-start-over-btn" class="btn btn-outline-secondary btn-sm">
                  Start over
                </button>
              </div>

              <section
                class="cb-saved-projects no-print"
                data-cb-saved-projects
                aria-labelledby="cb-saved-projects-heading"
              >
                <header class="cb-saved-projects__header">
                  <h2 id="cb-saved-projects-heading" class="cb-saved-projects__title">
                    Saved Pattern Projects
                  </h2>
                  <p class="cb-saved-projects__intro">
                    Your current pattern stays open while you work. Saved projects are stored separately
                    so you can return to them later.
                  </p>
                  <p class="cb-saved-projects__auth" data-cb-project-auth-hint hidden></p>
                  <p
                    class="cb-saved-projects__editing-status"
                    data-cb-project-editing-status
                    hidden
                  ></p>
                </header>

                <div class="cb-saved-projects__block cb-saved-projects__block--save">
                  <label class="cb-saved-projects__field">
                    <span class="cb-saved-projects__label">Project name</span>
                    <input
                      type="text"
                      class="cb-saved-projects__input"
                      data-cb-project-name
                      maxlength="120"
                      placeholder="e.g. Mom’s relaxed cardigan"
                      autocomplete="off"
                    />
                  </label>
                  <div class="cb-saved-projects__actions">
                    <button type="button" class="btn btn-sm btn-primary" data-cb-project-save>
                      Save New Project
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-cb-project-update>
                      Update saved pattern
                    </button>
                    {/* Copy stays visible for everyone; disabled for free / non-owner knitters. */}
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-cb-project-save-copy>
                      Save a Copy
                    </button>
                  </div>
                  <p
                    class="cb-saved-projects__copy-helper"
                    data-cb-project-copy-helper
                    hidden
                  ></p>
                </div>

                <div class="cb-saved-projects__block cb-saved-projects__block--open">
                  <p class="cb-saved-projects__helper">
                    Choose a saved project below to load it into your current workspace.
                  </p>
                  <label class="cb-saved-projects__field">
                    <span class="cb-saved-projects__label">Open a Saved Project</span>
                    <select class="cb-saved-projects__select" data-cb-project-select></select>
                  </label>
                  <div class="cb-saved-projects__load-actions">
                    <button type="button" class="btn btn-sm btn-primary" data-cb-project-load>
                      Open in Workspace
                    </button>
                  </div>
                </div>

                <p class="cb-project-status" data-cb-project-status role="status" aria-live="polite"></p>
              </section>

              <div class="express-builder-units no-print">
                <UnitToggle id="sleeveless-fit" />
              </div>

              <div class="express-accordions" id="cb-design-accordions">
                <section
                  class="express-acc express-acc--open"
                  data-express-step="1"
                  data-express-field="who"
                >
                  <div
                    class="express-acc__header"
                    data-express-header
                    role="button"
                    tabindex="0"
                    aria-expanded="true"
                    aria-controls="cb-design-acc-panel-1"
                    id="cb-design-acc-label-1"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-express-chevron
                      aria-label="Toggle who you are knitting for"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                      <h2 class="express-acc__title" id="cb-design-step-1-title">Who are you knitting for?</h2>
                      <span class="express-acc__value" data-express-summary="who"></span>
                    </div>
                  </div>
                  <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
                    <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
                    <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
                  </p>
                  <div
                    class="express-acc__body"
                    id="cb-design-acc-panel-1"
                    role="region"
                    aria-labelledby="cb-design-step-1-title"
                  >
                    <ExpressBuilderWhoPicker labelledBy="cb-design-step-1-title" />
                  </div>
                </section>

                <section
                  class="express-acc express-acc--locked"
                  data-express-step="2"
                  data-express-field="selectedSize"
                  id="cb-design-size-section"
                >
                  <div
                    class="express-acc__header"
                    data-express-header
                    role="button"
                    tabindex="-1"
                    aria-expanded="false"
                    aria-controls="cb-design-acc-panel-2"
                    id="cb-design-acc-label-2"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-express-chevron
                      aria-label="Toggle starting size selection"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                      <h2 class="express-acc__title" id="cb-design-step-2-title">Choose your size</h2>
                      <span class="express-acc__value" data-express-summary="selectedSize"></span>
                    </div>
                  </div>
                  <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
                    <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
                    <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
                  </p>
                  <div
                    class="express-acc__body"
                    id="cb-design-acc-panel-2"
                    role="region"
                    aria-labelledby="cb-design-step-2-title"
                    hidden
                  >
                    <div class="express-who-size-nested" data-express-nested-size hidden>
                      <p class="express-size-instruction" id="cb-design-size-helper-text">
                        Choose your size: Select the bust/chest measurement closest to yours.
                      </p>
                      <p class="express-size-load-msg sg-fit-size-copy" data-express-size-status>
                        Loading size charts…
                      </p>
                      <div class="express-size-select-wrap" data-express-size-select-wrap hidden>
                        <div class="express-size-table-wrap">
                          <table class="express-size-table">
                            <thead>
                              <tr>
                                <th scope="col">Size</th>
                                <th scope="col">Bust/Chest</th>
                              </tr>
                            </thead>
                            <tbody
                              role="radiogroup"
                              aria-labelledby="cb-design-size-helper-text"
                              data-express-size-table-body
                            >
                            </tbody>
                          </table>
                        </div>
                        <select
                          id="cb-design-body-size-select"
                          class="express-size-select express-size-select--visually-hidden"
                          data-express-size-select
                          tabindex="-1"
                          aria-hidden="true"
                          autocomplete="off"
                        >
                        </select>
                      </div>
                    </div>
                  </div>
                </section>
              </div>

              <div class="wizard-next-cta wizard-next-cta--split cb-design-wizard-nav no-print">
                <span class="kbm-btn kbm-btn-outline kbm-btn--placeholder" aria-hidden="true"></span>
                <a
                  href={styleHref}
                  class="kbm-btn kbm-btn-accent"
                  data-cb-continue-link
                  aria-disabled="true"
                  aria-label="Complete all design sections to continue"
                >
                  Continue
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  </SleevelessPatternMemberGate>
</Layout>

<style>
  .express-builder-nav-row--custom-flow {
    max-width: 920px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 1.35rem;
  }

  .express-builder-nav-row--custom-flow .express-step-nav__label {
    font-size: clamp(0.68rem, 2.1vw, 0.8125rem);
    line-height: 1.15;
    hyphens: auto;
  }

  .kbm-btn--placeholder {
    visibility: hidden;
    pointer-events: none;
    min-height: 2.75rem;
  }

  @media (max-width: 520px) {
    .kbm-btn--placeholder {
      display: none;
    }
  }

  [data-cb-continue-link][aria-disabled="true"] {
    opacity: 0.55;
    pointer-events: none;
    cursor: not-allowed;
  }

  .cb-saved-projects {
    margin: 1.25rem 0 1.5rem;
    padding: 1.15rem 1.25rem 1.25rem;
    border: 1px solid var(--kbm-border-subtle, #d8e0d9);
    border-radius: 12px;
    background: var(--kbm-surface-muted, #f6f8f6);
    box-shadow: 0 1px 3px rgba(26, 46, 31, 0.06);
  }

  .cb-saved-projects__header {
    margin-bottom: 1rem;
  }

  .cb-saved-projects__title {
    margin: 0 0 0.45rem;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--kbm-green, #52682d);
  }

  .cb-saved-projects__intro,
  .cb-saved-projects__helper {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--kbm-text-muted, #3d5244);
    max-width: 36rem;
  }

  .cb-saved-projects__auth {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--text-muted, #6b7280);
  }

  .cb-saved-projects__auth[hidden] {
    display: none;
  }

  .cb-saved-projects__block {
    padding: 0.95rem 1rem;
    border: 1px solid var(--ring, #e5e8e0);
    border-radius: 10px;
    background: #fff;
  }

  .cb-saved-projects__block + .cb-saved-projects__block {
    margin-top: 0.85rem;
  }

  .cb-saved-projects__helper {
    margin-bottom: 0.75rem;
  }

  .cb-saved-projects__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
    max-width: 28rem;
  }

  .cb-saved-projects__block--open .cb-saved-projects__field {
    margin-bottom: 0.65rem;
  }

  .cb-saved-projects__label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--kbm-text, #1a2e1f);
  }

  .cb-saved-projects__input,
  .cb-saved-projects__select {
    width: 100%;
    max-width: 28rem;
    padding: 0.5rem 0.65rem;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--kbm-text, #1a2e1f);
    background: #fff;
    border: 1px solid var(--kbm-border-subtle, #d8e0d9);
    border-radius: 8px;
    box-sizing: border-box;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .cb-saved-projects__input:focus,
  .cb-saved-projects__select:focus {
    outline: none;
    border-color: var(--kbm-green-2, #738c52);
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.15);
  }

  .cb-saved-projects__actions,
  .cb-saved-projects__load-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .cb-saved-projects .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.125rem;
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.25;
    border-radius: 8px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .cb-saved-projects .btn-primary {
    color: #fff;
    background: var(--kbm-green, #52682d);
    border-color: var(--kbm-green, #52682d);
  }

  .cb-saved-projects .btn-primary:hover {
    background: var(--kbm-green-hover, #445626);
    border-color: var(--kbm-green-hover, #445626);
  }

  .cb-saved-projects .btn-outline-secondary {
    color: var(--kbm-green, #52682d);
    background: #fff;
    border-color: var(--kbm-border-subtle, #d8e0d9);
  }

  .cb-saved-projects .btn-outline-secondary:hover {
    background: var(--kbm-surface-muted, #f6f8f6);
    border-color: var(--kbm-green-2, #738c52);
  }

  .cb-saved-projects .btn.is-disabled,
  .cb-saved-projects .btn:disabled {
    color: var(--text-muted, #9aa3a0);
    background: var(--kbm-surface-muted, #f3f4f3);
    border-color: var(--kbm-border-subtle, #e2e6e0);
    cursor: not-allowed;
    opacity: 0.65;
  }

  .cb-saved-projects .btn.is-disabled:hover,
  .cb-saved-projects .btn:disabled:hover {
    background: var(--kbm-surface-muted, #f3f4f3);
    border-color: var(--kbm-border-subtle, #e2e6e0);
  }

  .cb-saved-projects__copy-helper {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--text-muted, #6b7280);
    max-width: 36rem;
  }

  .cb-saved-projects__copy-helper[hidden] {
    display: none;
  }

  .cb-saved-projects__editing-status {
    margin: 0.55rem 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--kbm-green, #52682d);
  }

  .cb-saved-projects__editing-status[hidden] {
    display: none;
  }

  .cb-project-status {
    margin: 0.85rem 0 0;
    padding-top: 0.15rem;
    font-size: 0.9rem;
    line-height: 1.45;
    min-height: 1.25em;
    color: var(--kbm-text-muted, #3d5244);
  }

  .cb-project-status--error {
    color: #b91c1c;
  }
</style>

<script>
  import "/src/scripts/sleeveless-custom-build-design-page.ts";
  import "/src/scripts/sleeveless-custom-build-saved-projects.ts";
  import "/src/scripts/customPatternEditingBanner.ts";
</script>
