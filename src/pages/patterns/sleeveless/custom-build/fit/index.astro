---
import Layout from "../../../../../layouts/Layout.astro";
import WizardBackLink from "../../../../../components/wizards/WizardBackLink.astro";
import PatternWorkspaceTabs from "../../../../../components/patterns/PatternWorkspaceTabs.astro";
import "../../../../../styles/sleeveless-express-wizard-layout.css";

const customBuildHref = "/patterns/sleeveless/custom-build/";
const foundationHref = "/patterns/sleeveless/custom-build/design";
const styleHref = "/patterns/sleeveless/custom-style";
const yarnGaugeHref = "/patterns/sleeveless/custom-build/yarn-gauge";
const patternHref = "/patterns/sleeveless/pattern/";

type WizardStep = {
  step: number;
  label: string;
  href?: string;
  state: "link-back" | "current" | "upcoming";
};

const customWizardSteps: WizardStep[] = [
  { step: 1, label: "Foundation", href: foundationHref, state: "link-back" },
  { step: 2, label: "Style & Shaping", href: styleHref, state: "link-back" },
  { step: 3, label: "Measurements", state: "current" },
  { step: 4, label: "Yarn & Gauge", state: "upcoming" },
  { step: 5, label: "Pattern", state: "upcoming" },
];
---

<Layout
  title="Custom Build — Measurements | Sleeveless Sweater"
  description="Custom Build body measurements follow your Foundation size and Style choices. Continue to yarn and gauge for the next step."
>
  <main class="express-page wizard-page sleeveless-express-page">
    <div class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternWorkspaceTabs
          activeTab="custom-build"
          showQuickCustomBuildTabs={true}
          quickBuildHref="/patterns/sleeveless-express"
          customBuildHref={customBuildHref}
          patternHref={patternHref}
          askShareHref="/patterns/sleeveless/ask-share/"
          inspirationHref="/patterns/sleeveless/inspiration/"
        />

        <WizardBackLink className="back-link no-print" fallback="/patterns" />

        <div class="sg-tab-build">
          <div class="express-builder-nav-row express-builder-nav-row--custom-flow no-print">
            <nav class="express-step-nav sg-builder-nav" aria-label="Custom build steps">
              <ol class="express-step-nav__list sg-builder-nav__list" role="list">
                {
                  customWizardSteps.map((s, i) => (
                    <li
                      class:list={[
                        "express-step-nav__item",
                        "sg-builder-nav__item",
                        { active: s.step === 3 },
                      ]}
                    >
                      {s.state === "current" ? (
                        <span
                          class:list={["express-step-nav__btn", "sg-builder-nav__link", "is-current"]}
                          aria-current="page"
                          aria-label={`${s.label}, current step`}
                        >
                          <span class="express-step-nav__track">
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--before",
                                { "express-step-nav__seg--empty": i === 0 },
                              ]}
                              aria-hidden="true"
                            />
                            <span class="express-step-nav__circle">
                              <span class="express-step-nav__num">{s.step}</span>
                              <span class="express-pill__check" aria-hidden="true">
                                ✓
                              </span>
                            </span>
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--after",
                                { "express-step-nav__seg--empty": i === customWizardSteps.length - 1 },
                              ]}
                              aria-hidden="true"
                            />
                          </span>
                          <span class="express-step-nav__label">{s.label}</span>
                        </span>
                      ) : s.state === "link-back" && s.href ? (
                        <a
                          href={s.href}
                          class:list={[
                            "express-step-nav__btn",
                            "sg-builder-nav__link",
                            "is-complete",
                            "express-step-nav__btn--link",
                          ]}
                          aria-label={`${s.label}, completed. Go back.`}
                        >
                          <span class="express-step-nav__track">
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--before",
                                { "express-step-nav__seg--empty": i === 0 },
                              ]}
                              aria-hidden="true"
                            />
                            <span class="express-step-nav__circle">
                              <span class="express-step-nav__num">{s.step}</span>
                              <span class="express-pill__check" aria-hidden="true">
                                ✓
                              </span>
                            </span>
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--after",
                                { "express-step-nav__seg--empty": i === customWizardSteps.length - 1 },
                              ]}
                              aria-hidden="true"
                            />
                          </span>
                          <span class="express-step-nav__label">{s.label}</span>
                        </a>
                      ) : (
                        <span
                          class:list={["express-step-nav__btn", "sg-builder-nav__link", "is-upcoming"]}
                          aria-disabled="true"
                          title="Use Continue to move through the Custom Build steps."
                        >
                          <span class="express-step-nav__track">
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--before",
                                { "express-step-nav__seg--empty": i === 0 },
                              ]}
                              aria-hidden="true"
                            />
                            <span class="express-step-nav__circle">
                              <span class="express-step-nav__num">{s.step}</span>
                              <span class="express-pill__check" aria-hidden="true">
                                ✓
                              </span>
                            </span>
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--after",
                                { "express-step-nav__seg--empty": i === customWizardSteps.length - 1 },
                              ]}
                              aria-hidden="true"
                            />
                          </span>
                          <span class="express-step-nav__label">{s.label}</span>
                        </span>
                      )}
                    </li>
                  ))
                }
              </ol>
            </nav>
          </div>

          <header class="pattern-header page-header">
            <p class="pattern-mode-label">Custom Build</p>
            <h1 class="pattern-title">Measurements</h1>
            <p class="pattern-subtext">
              In Custom Build, your sizing chart row comes from <a href={foundationHref} class="express-custom-build-callout__link">Foundation</a> (who and size) and your fit choice on <a href={styleHref} class="express-custom-build-callout__link">Style &amp; Shaping</a>. Those values feed the pattern after you enter yarn and gauge.
            </p>
            <p class="pattern-subtext">
              For a visual measurement confirmation before the pattern, use <a href="/patterns/sleeveless-express" class="express-custom-build-callout__link">Quick Build</a> and generate from there.
            </p>
          </header>

          <div class="wizard-next-cta wizard-next-cta--split cb-design-wizard-nav no-print">
            <a href={styleHref} class="kbm-btn kbm-btn-outline">← Back: Style &amp; Shaping</a>
            <a href={yarnGaugeHref} class="kbm-btn kbm-btn-accent">Continue: Yarn &amp; Gauge →</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .express-custom-build-callout__link {
    color: var(--sg-accent, #c2614e);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
