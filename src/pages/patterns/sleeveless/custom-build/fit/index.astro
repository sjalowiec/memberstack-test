---
import Layout from "../../../../../layouts/Layout.astro";
import WizardBackLink from "../../../../../components/wizards/WizardBackLink.astro";
import PatternWorkspaceTabs from "../../../../../components/patterns/PatternWorkspaceTabs.astro";
import UnitToggle from "../../../../../components/wizards/UnitToggle.astro";
import "../../../../../styles/sleeveless-express-wizard-layout.css";

const customBuildHref = "/patterns/sleeveless/custom-build/";
const foundationHref = "/patterns/sleeveless/custom-build/design";
const styleHref = "/patterns/sleeveless/custom-style";
const yarnGaugeHref = "/patterns/sleeveless/custom-build/yarn-gauge";
const patternHref = "/patterns/sleeveless/pattern/";

type WizardStep = {
  step: number;
  label: string;
  href?: string;
  state: "link-back" | "current" | "upcoming";
};

const customWizardSteps: WizardStep[] = [
  { step: 1, label: "Foundation", href: foundationHref, state: "link-back" },
  { step: 2, label: "Style & Shaping", href: styleHref, state: "link-back" },
  { step: 3, label: "Measurements", state: "current" },
  { step: 4, label: "Yarn & Gauge", state: "upcoming" },
  { step: 5, label: "Pattern", state: "upcoming" },
];
---

<Layout
  title="Custom Pattern — Measurements | Sleeveless Sweater"
  description="Custom Pattern body measurements follow your Foundation size and Style choices. Continue to yarn and gauge for the next step."
>
  <main class="express-page wizard-page sleeveless-express-page">
    <div class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternWorkspaceTabs
          rootClass="pattern-tabs-scope"
          activeTab="custom"
          expressHref="/patterns/sleeveless-express/"
          customBuildHref={customBuildHref}
          patternHref={patternHref}
          askShareHref="/patterns/sleeveless/ask-share/"
          inspirationHref="/patterns/sleeveless/inspiration/"
        />

        <WizardBackLink className="back-link no-print" fallback="/patterns" />

        <div class="sg-tab-build">
          <div class="express-builder-nav-row express-builder-nav-row--custom-flow no-print">
            <nav class="express-step-nav sg-builder-nav" aria-label="Custom build steps">
              <ol class="express-step-nav__list sg-builder-nav__list" role="list">
                {
                  customWizardSteps.map((s, i) => (
                    <li
                      class:list={[
                        "express-step-nav__item",
                        "sg-builder-nav__item",
                        { active: s.step === 3 },
                      ]}
                    >
                      {s.state === "current" ? (
                        <span
                          class:list={["express-step-nav__btn", "sg-builder-nav__link", "is-current"]}
                          aria-current="page"
                          aria-label={`${s.label}, current step`}
                        >
                          <span class="express-step-nav__track">
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--before",
                                { "express-step-nav__seg--empty": i === 0 },
                              ]}
                              aria-hidden="true"
                            />
                            <span class="express-step-nav__circle">
                              <span class="express-step-nav__num">{s.step}</span>
                              <span class="express-pill__check" aria-hidden="true">
                                ✓
                              </span>
                            </span>
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--after",
                                { "express-step-nav__seg--empty": i === customWizardSteps.length - 1 },
                              ]}
                              aria-hidden="true"
                            />
                          </span>
                          <span class="express-step-nav__label">{s.label}</span>
                        </span>
                      ) : s.state === "link-back" && s.href ? (
                        <a
                          href={s.href}
                          class:list={[
                            "express-step-nav__btn",
                            "sg-builder-nav__link",
                            "is-complete",
                            "express-step-nav__btn--link",
                          ]}
                          aria-label={`${s.label}, completed. Go back.`}
                        >
                          <span class="express-step-nav__track">
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--before",
                                { "express-step-nav__seg--empty": i === 0 },
                              ]}
                              aria-hidden="true"
                            />
                            <span class="express-step-nav__circle">
                              <span class="express-step-nav__num">{s.step}</span>
                              <span class="express-pill__check" aria-hidden="true">
                                ✓
                              </span>
                            </span>
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--after",
                                { "express-step-nav__seg--empty": i === customWizardSteps.length - 1 },
                              ]}
                              aria-hidden="true"
                            />
                          </span>
                          <span class="express-step-nav__label">{s.label}</span>
                        </a>
                      ) : (
                        <span
                          class:list={["express-step-nav__btn", "sg-builder-nav__link", "is-upcoming"]}
                          aria-disabled="true"
                          title="Use Continue to move through the Custom Pattern steps."
                        >
                          <span class="express-step-nav__track">
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--before",
                                { "express-step-nav__seg--empty": i === 0 },
                              ]}
                              aria-hidden="true"
                            />
                            <span class="express-step-nav__circle">
                              <span class="express-step-nav__num">{s.step}</span>
                              <span class="express-pill__check" aria-hidden="true">
                                ✓
                              </span>
                            </span>
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--after",
                                { "express-step-nav__seg--empty": i === customWizardSteps.length - 1 },
                              ]}
                              aria-hidden="true"
                            />
                          </span>
                          <span class="express-step-nav__label">{s.label}</span>
                        </span>
                      )}
                    </li>
                  ))
                }
              </ol>
            </nav>
          </div>

          <header class="pattern-header page-header">
            <p class="pattern-mode-label">Custom Pattern</p>
            <h1 class="pattern-title">Measurements</h1>
            <p class="pattern-subtext">
              In Custom Pattern, your sizing chart row comes from <a href={foundationHref} class="express-custom-build-callout__link">Foundation</a> (who and size) and your fit choice on <a href={styleHref} class="express-custom-build-callout__link">Style &amp; Shaping</a>. Those values feed the pattern after you enter yarn and gauge.
            </p>
            <p class="pattern-subtext">
              For a visual measurement confirmation before the pattern, use <a href="/patterns/sleeveless-express/" class="express-custom-build-callout__link">Express</a> and generate from there.
            </p>
          </header>

          <div class="express-panel calculator-card" data-cb-measure-root>
            <div class="express-builder-units no-print">
              <UnitToggle id="sleeveless-fit" />
            </div>
            <p class="pattern-subtext cb-measure-unit-hint" data-cb-measure-unit-hint>
              Measurements are shown in inches.
            </p>
            <p class="info-box cb-measure-missing" data-cb-measure-missing hidden role="status">
              Complete <a href={foundationHref} class="express-custom-build-callout__link">Foundation</a> (who and size) and
              <a href={styleHref} class="express-custom-build-callout__link">Style &amp; Shaping</a> (fit) to load body and finished measurements.
            </p>
            <div data-cb-measure-panel hidden>
              <section class="cb-measure-section" aria-labelledby="cb-body-measurements-heading">
                <h2 id="cb-body-measurements-heading" class="cb-measure-section__title">Body measurements (from chart)</h2>
                <p class="pattern-subtext cb-measure-section__intro">
                  These come from your sizing chart row. They are not used in pattern calculations yet.
                </p>
                <dl class="cb-measure-body-grid">
                  <div class="cb-measure-body-row">
                    <dt>Body bust/chest</dt>
                    <dd data-cb-body-display="bodyBustOrChest">—</dd>
                  </div>
                  <div class="cb-measure-body-row">
                    <dt>Body waist</dt>
                    <dd data-cb-body-display="bodyWaist">—</dd>
                  </div>
                  <div class="cb-measure-body-row">
                    <dt>Body hip</dt>
                    <dd data-cb-body-display="bodyHip">—</dd>
                  </div>
                </dl>
              </section>

              <section class="cb-measure-section" aria-labelledby="cb-finished-measurements-heading">
                <h2 id="cb-finished-measurements-heading" class="cb-measure-section__title">Finished measurements</h2>
                <p class="pattern-subtext cb-measure-section__intro">
                  Starting values use your fit choice (ease on bust/chest). Adjust if needed — saved for Custom Build only; pattern output is unchanged in this step.
                </p>
                <div class="cb-measure-finished-grid">
                  <label class="cb-measure-finished-field">
                    <span class="cb-measure-finished-field__label">Finished bust/chest</span>
                    <input
                      type="text"
                      inputmode="decimal"
                      class="form-control cb-measure-finished-field__input"
                      data-cb-finished-input="finishedBustOrChest"
                      autocomplete="off"
                    />
                  </label>
                  <label class="cb-measure-finished-field">
                    <span class="cb-measure-finished-field__label">Finished waist</span>
                    <input
                      type="text"
                      inputmode="decimal"
                      class="form-control cb-measure-finished-field__input"
                      data-cb-finished-input="finishedWaist"
                      autocomplete="off"
                    />
                  </label>
                  <label class="cb-measure-finished-field">
                    <span class="cb-measure-finished-field__label">Finished hip</span>
                    <input
                      type="text"
                      inputmode="decimal"
                      class="form-control cb-measure-finished-field__input"
                      data-cb-finished-input="finishedHip"
                      autocomplete="off"
                    />
                  </label>
                </div>
              </section>

              <section class="cb-measure-section cb-measure-summary-section" aria-labelledby="cb-measure-summary-heading">
                <h2 id="cb-measure-summary-heading" class="cb-measure-section__title">Saved values (review)</h2>
                <p class="pattern-subtext cb-measure-section__intro">
                  Confirms what is stored in your pattern — refresh the page to verify restore.
                </p>
                <dl class="cb-measure-summary-grid" data-cb-measure-summary></dl>
              </section>
            </div>
          </div>

          <div class="wizard-next-cta wizard-next-cta--split cb-design-wizard-nav no-print">
            <a href={styleHref} class="kbm-btn kbm-btn-outline">← Back: Style &amp; Shaping</a>
            <a href={yarnGaugeHref} class="kbm-btn kbm-btn-accent">Continue: Yarn &amp; Gauge →</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .express-custom-build-callout__link {
    color: var(--sg-accent, #c2614e);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cb-measure-section {
    margin-top: 1.5rem;
  }

  .cb-measure-section__title {
    font-size: 1.125rem;
    margin: 0 0 0.35rem;
  }

  .cb-measure-section__intro {
    margin-bottom: 0.75rem;
  }

  .cb-measure-body-grid,
  .cb-measure-summary-grid {
    display: grid;
    gap: 0.5rem 1rem;
    margin: 0;
  }

  .cb-measure-body-row,
  .cb-measure-summary-grid {
    grid-template-columns: minmax(8rem, 1fr) auto;
    align-items: baseline;
  }

  .cb-measure-body-row {
    display: contents;
  }

  .cb-measure-body-grid dt,
  .cb-measure-summary-grid dt {
    font-weight: 600;
    margin: 0;
  }

  .cb-measure-body-grid dd,
  .cb-measure-summary-grid dd {
    margin: 0;
    text-align: right;
  }

  .cb-measure-finished-grid {
    display: grid;
    gap: 0.75rem;
    max-width: 22rem;
  }

  .cb-measure-finished-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cb-measure-finished-field__label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .cb-measure-summary-section {
    padding-top: 0.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .cb-measure-missing {
    margin-top: 0.75rem;
  }
</style>

<script>
  import "/src/scripts/sleeveless-custom-build-measurements-page.ts";
</script>
