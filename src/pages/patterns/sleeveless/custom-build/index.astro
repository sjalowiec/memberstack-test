---
import Layout from "../../../../layouts/Layout.astro";
import PatternWorkspaceTabs from "../../../../components/patterns/PatternWorkspaceTabs.astro";
import "../../../../styles/wizard.css";
import "../../../../styles/sleeveless-express-wizard-layout.css";

const expressHref = "/patterns/sleeveless-express/";
const expressMeasurementsSummaryHref = "/patterns/sleeveless-express-measurements/";
const customBuildHref = "/patterns/sleeveless/custom-build/";
const patternHref = "/patterns/sleeveless/pattern/";
const askShareHref = "/patterns/sleeveless/ask-share/";
const inspirationHref = "/patterns/sleeveless/inspiration/";
---

<Layout
  title="Custom Pattern | Knit by Machine"
  description="Custom Pattern is in development and not yet available in beta. Use Express to build your sweater pattern today; more Custom Pattern options are coming soon."
>
  <main class="express-page wizard-page sleeveless-express-page custom-build-preview-page">
    <div class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternWorkspaceTabs
          rootClass="pattern-tabs-scope"
          activeTab="custom"
          expressHref={expressHref}
          customBuildHref={customBuildHref}
          patternHref={patternHref}
          askShareHref={askShareHref}
          inspirationHref={inspirationHref}
        />

        <div class="custom-build-preview-body">
          <header class="pattern-header page-header custom-build-preview-header">
            <div class="custom-build-preview-header__title-row">
              <h1 class="pattern-title">Custom Pattern</h1>
              <span class="custom-build-preview-badge">COMING SOON</span>
            </div>
            <p class="pattern-subtext custom-build-preview-intro">
              Custom Pattern is currently in development and not yet available in beta.
            </p>
            <p class="pattern-subtext custom-build-preview-followup">
              Express is the supported way to build your sweater pattern today.
            </p>
            <div class="custom-build-preview-blurbs">
              <div class="custom-build-preview-row">
                <img
                  class="custom-build-preview-row__icon"
                  src="/images/express-icon.svg"
                  alt="Express Pattern"
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                />
                <p class="pattern-subtext custom-build-preview-row__text">
                  <a href={expressHref} class="custom-build-preview-inline-link"><strong>Express Pattern</strong></a> is available now and creates a standard-fit pattern from your guided choices.
                </p>
              </div>
              <div class="custom-build-preview-row">
                <img
                  class="custom-build-preview-row__icon custom-build-preview-row__icon--kin"
                  src="/images/KINlogo.svg"
                  alt="Custom Pattern"
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                />
                <p class="pattern-subtext custom-build-preview-row__text">
                  <strong>Custom Pattern</strong> is coming next and will give knitters more control over fit, measurements, shaping, and personalization.
                </p>
              </div>
            </div>
          </header>

          <section class="pattern-card custom-build-preview-features" aria-labelledby="custom-build-features-heading">
            <h3 id="custom-build-features-heading">What’s planned for Custom Pattern</h3>
            <ul>
              <li>Save and return to your pattern later</li>
              <li>Reopen and edit saved patterns anytime</li>
              <li>Your own body and garment measurements</li>
              <li>Adjustable neckline depth and width</li>
              <li>Customizable shaping choices</li>
              <li>More garment style options</li>
            </ul>
          </section>

          <p class="info-box custom-build-preview-note" role="note">
            Custom Pattern is part of the Knit by Machine beta roadmap. For now, use <a href={expressHref} class="custom-build-preview-note__link">Express</a> to create your pattern. More
            Custom Pattern options are coming soon.
          </p>

          <div class="custom-build-preview-actions no-print">
            <a href={expressMeasurementsSummaryHref} class="kbm-btn kbm-btn-accent custom-build-preview-btn-express">
              <img
                class="custom-build-preview-btn-express__icon"
                src="/images/express-icon.svg"
                alt=""
                width="22"
                height="22"
                loading="lazy"
                decoding="async"
                aria-hidden="true"
              />
              <span>Back to Express Builder</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .custom-build-preview-page .custom-build-preview-body {
    margin-top: 0.35rem;
    padding: 0 0.35rem 0.25rem;
  }

  .custom-build-preview-page .custom-build-preview-header__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem 0.85rem;
    margin-bottom: 0.5rem;
  }

  .custom-build-preview-page .custom-build-preview-header__title-row .pattern-title {
    margin-bottom: 0;
  }

  .custom-build-preview-page .custom-build-preview-badge {
    display: inline-block;
    margin: 0;
    padding: 0.25rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #555;
    background: rgba(82, 104, 45, 0.12);
    border-radius: 4px;
    white-space: nowrap;
  }

  .custom-build-preview-page .custom-build-preview-intro {
    margin: 0 auto 0.4rem;
    max-width: 40rem;
    text-align: center;
  }

  .custom-build-preview-page .custom-build-preview-followup {
    margin: 0 auto 1rem;
    max-width: 40rem;
    text-align: center;
  }

  .custom-build-preview-page .custom-build-preview-blurbs {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 40rem;
    margin: 0 auto;
    text-align: left;
  }

  .custom-build-preview-page .custom-build-preview-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .custom-build-preview-page .custom-build-preview-row__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .custom-build-preview-page .custom-build-preview-row__icon--kin {
    width: auto;
    max-width: 56px;
    max-height: 48px;
    height: auto;
    object-fit: contain;
    object-position: left center;
  }

  .custom-build-preview-page .custom-build-preview-row__text {
    margin: 0;
    max-width: none;
    margin-inline: 0;
    text-align: left;
  }

  .custom-build-preview-page .custom-build-preview-row__text .custom-build-preview-inline-link,
  .custom-build-preview-page .custom-build-preview-row__text .custom-build-preview-inline-link:visited,
  .custom-build-preview-page .custom-build-preview-row__text .custom-build-preview-inline-link:hover,
  .custom-build-preview-page .custom-build-preview-row__text .custom-build-preview-inline-link:focus {
    color: inherit;
    text-decoration: none;
  }

  .custom-build-preview-page .custom-build-preview-note .custom-build-preview-note__link,
  .custom-build-preview-page .custom-build-preview-note .custom-build-preview-note__link:visited,
  .custom-build-preview-page .custom-build-preview-note .custom-build-preview-note__link:hover,
  .custom-build-preview-page .custom-build-preview-note .custom-build-preview-note__link:focus {
    color: inherit;
    font-weight: inherit;
    text-decoration: none;
  }

  .custom-build-preview-page .custom-build-preview-features ul {
    margin: 0.25rem 0 0;
    padding: 0 0 0 1.2rem;
    text-align: left;
    max-width: 38rem;
    margin-inline: auto;
  }

  .custom-build-preview-page .custom-build-preview-features li {
    margin: 0.4rem 0;
    line-height: 1.55;
    color: #374151;
  }

  .custom-build-preview-page .custom-build-preview-note {
    max-width: 40rem;
    margin-inline: auto;
    margin-bottom: 0;
  }

  .custom-build-preview-page .custom-build-preview-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e8e8e8;
  }

  .custom-build-preview-page .custom-build-preview-btn-express {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  .custom-build-preview-page .custom-build-preview-btn-express__icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    object-fit: contain;
    /* Orange/green SVG on terracotta accent: render as light for contrast with white label text */
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }
</style>
