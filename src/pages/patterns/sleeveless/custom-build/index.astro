---
import Layout from "../../../../layouts/Layout.astro";
import PatternWorkspaceTabs from "../../../../components/patterns/PatternTabs.astro";
import "../../../../styles/wizard.css";
import "../../../../styles/sleeveless-express-wizard-layout.css";

const quickBuildHref = "/patterns/sleeveless-express/";
const customBuildHref = "/patterns/sleeveless/custom-build/";
const patternHref = "/patterns/sleeveless/pattern/";
const askShareHref = "/patterns/sleeveless/ask-share/";
const inspirationHref = "/patterns/sleeveless/inspiration/";
---

<Layout
  title="Custom Build Preview | Sleeveless Sweater"
  description="Preview of upcoming Custom Build options for the sleeveless sweater pattern workspace. Use Express Build to create your pattern during the Knit by Machine beta."
>
  <main class="express-page wizard-page sleeveless-express-page custom-build-preview-page">
    <div class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternWorkspaceTabs
          rootClass="pattern-tabs-scope"
          activeTab="custom-build"
          workspaceBuildTabLabel="Custom Build"
          quickBuildHref={quickBuildHref}
          customBuildHref={customBuildHref}
          patternHref={patternHref}
          askShareHref={askShareHref}
          inspirationHref={inspirationHref}
        />

        <div class="custom-build-preview-body">
          <header class="pattern-header page-header">
            <p class="pattern-mode-label">Custom Build</p>
            <h1 class="pattern-title">Custom Build Preview</h1>
            <p class="pattern-subtext">
              Express Build helps you create a pattern quickly with guided choices and a printable PDF.
            </p>
            <p class="pattern-subtext custom-build-preview-intro-follow">
              Custom Build is being designed for knitters who want more control over fit, measurements, shaping, and
              pattern personalization.
            </p>
          </header>

          <section class="pattern-card custom-build-preview-features" aria-labelledby="custom-build-preview-heading">
            <h3 id="custom-build-preview-heading">What Custom Build will include</h3>
            <ul>
              <li>Save your pattern and return to it later</li>
              <li>Reopen and edit saved patterns anytime</li>
              <li>Enter your own body and garment measurements</li>
              <li>Adjust neckline depth and width</li>
              <li>Customize shaping choices</li>
              <li>Choose more garment style options</li>
              <li>Work with more yarn and gauge flexibility</li>
              <li>Access more advanced finishing and pattern details</li>
            </ul>
          </section>

          <p class="info-box custom-build-preview-note" role="note">
            Custom Build is currently in development as part of the Knit by Machine beta. For now, use Express Build to
            create your pattern, and watch for more Custom Build options soon.
          </p>

          <div class="custom-build-preview-actions no-print">
            <a href={quickBuildHref} class="kbm-btn kbm-btn-accent">Return to Express Build</a>
            <a href={patternHref} class="kbm-btn kbm-btn-outline">View Generated Pattern</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .custom-build-preview-page .custom-build-preview-body {
    margin-top: 0.35rem;
    padding: 0 0.35rem 0.25rem;
  }

  .custom-build-preview-page .pattern-header .pattern-subtext + .pattern-subtext {
    margin-top: 0.75rem;
  }

  .custom-build-preview-page .custom-build-preview-features ul {
    margin: 0.25rem 0 0;
    padding: 0 0 0 1.2rem;
    text-align: left;
    max-width: 38rem;
    margin-inline: auto;
  }

  .custom-build-preview-page .custom-build-preview-features li {
    margin: 0.4rem 0;
    line-height: 1.55;
    color: #374151;
  }

  .custom-build-preview-page .custom-build-preview-note {
    max-width: 40rem;
    margin-inline: auto;
    margin-bottom: 0;
  }

  .custom-build-preview-page .custom-build-preview-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e8e8e8;
  }
</style>
