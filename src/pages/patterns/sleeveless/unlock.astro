---
import Layout from "../../../layouts/Layout.astro";
import { MEMBERSHIPS } from "../../../config/memberships";

/**
 * Legacy unlock URL — kept so bookmarks and old links do not 404.
 * Individual pattern-system purchases are not sold; Dynamic Patterns require
 * active membership only (docs/membership-rules.md).
 */
const membershipHref = "/membership";
const myPatternsHref = "/account";
const monthlyPrice = MEMBERSHIPS.membership.prices.monthly.price;
const annualPrice = MEMBERSHIPS.membership.prices.annual.price;
---

<Layout
  title="Sleeveless Pattern System | Knit it Now"
  description="Dynamic Patterns are included with an active Knit it Now membership. Become a member to create, edit, and save custom sleeveless patterns."
>
  <div class="sleeveless-unlock-page page-wrap">
    <section class="sleeveless-unlock">
      <header class="sleeveless-unlock__intro">
        <h1 class="sleeveless-unlock__title">Sleeveless Pattern System</h1>
        <p class="sleeveless-unlock__lead">
          Dynamic Patterns are included with an <strong>active Knit it Now membership</strong>.
          Become a member to create, edit, save, and print custom sleeveless patterns.
        </p>
        <p class="sleeveless-unlock__lead">
          Membership is billed monthly (${monthlyPrice}) or annually (${annualPrice}).
          An account alone does not unlock pattern builders.
        </p>
      </header>

      <div class="sleeveless-unlock__actions">
        <a href={membershipHref} class="kbm-btn kbm-btn-accent sleeveless-unlock__btn">
          Become a Member
        </a>
        <a
          href="#"
          class="sleeveless-unlock__login"
          data-ms-content="!members"
          data-ms-modal="login"
          data-ms-redirect="current-url"
        >
          Already a member? Log in
        </a>
      </div>
    </section>

    <p class="sleeveless-unlock__back">
      <a href={myPatternsHref} class="sleeveless-unlock__back-link">
        Return to My Patterns
      </a>
    </p>
  </div>
</Layout>

<style>
  /* main.site-content already clears the fixed header; avoid stacking .page-wrap's default top padding */
  .sleeveless-unlock-page.page-wrap {
    padding-top: 8px;
  }

  .sleeveless-unlock {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0.5rem 0 0.5rem;
  }

  .sleeveless-unlock__intro {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .sleeveless-unlock__title {
    margin: 0 0 0.85rem;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    font-weight: 700;
    color: #2c3a57;
  }

  .sleeveless-unlock__lead {
    margin: 0 auto 0.85rem;
    max-width: 38rem;
    line-height: 1.6;
    color: #374151;
    font-size: 1.05rem;
  }

  .sleeveless-unlock__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .sleeveless-unlock__btn {
    text-align: center;
    min-width: 12rem;
  }

  .sleeveless-unlock__login {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--kbm-green, #52682d);
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  .sleeveless-unlock__login:hover {
    text-decoration-thickness: 2px;
  }

  .sleeveless-unlock__back {
    margin: 1.5rem 0 0.5rem;
    text-align: center;
  }

  .sleeveless-unlock__back-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--kbm-green, #52682d);
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  .sleeveless-unlock__back-link:hover {
    text-decoration-thickness: 2px;
  }
</style>
