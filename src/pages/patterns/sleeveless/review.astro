---
import Layout from "../../../layouts/Layout.astro";
import PatternWorkspaceTabs from "../../../components/patterns/PatternWorkspaceTabs.astro";
import UnitToggle from "../../../components/wizards/UnitToggle.astro";
import YarnRequirement from "../../../components/tools/YarnRequirement.astro";
import "../../../styles/wizard.css";
import "../../../styles/sleeveless-express-wizard-layout.css";
import "../../../styles/sleeveless-express-measurements-confirm.css";
import "../../../styles/sleeveless-review-measurements.css";

const builderHref = "/patterns/sleeveless/builder";
const expressHref = "/patterns/sleeveless-express/";
const customBuildHref = "/patterns/sleeveless/custom-build/";
const patternHref = "/patterns/sleeveless/pattern/";
const askShareHref = "/patterns/sleeveless/ask-share/";
const inspirationHref = "/patterns/sleeveless/inspiration/";
---

<Layout
  title="Review Measurements | Sleeveless Sweater"
  description="Review sizing and measurements, then generate your sleeveless sweater pattern."
>
  <main class="express-page wizard-page sleeveless-express-page express-measurements-confirm-page sleeveless-unified-review-page">
    <div class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternWorkspaceTabs
          rootClass="pattern-tabs-scope"
          activeTab="custom"
          expressHref={expressHref}
          customBuildHref={customBuildHref}
          patternHref={patternHref}
          askShareHref={askShareHref}
          inspirationHref={inspirationHref}
        />

        <div
          class="express-measurements-review"
          data-express-measurements-root
          data-cb-measure-root
          data-sleeveless-review-managed
          data-express-href={builderHref}
        >
          <div
            class="sleeveless-review-access-banner"
            data-sleeveless-review-access-banner
            hidden
            role="status"
          >
            <p class="sleeveless-review-access-banner__text" data-sleeveless-review-access-message></p>
          </div>

          <p
            class="express-measurements-status pattern-subtext"
            data-express-measurements-status
            hidden
            aria-live="polite"
          ></p>

          <header
            class="sleeveless-review-project-header"
            data-sleeveless-review-project-header
            aria-label="Pattern project"
          >
            <div class="sleeveless-review-project-header__name">
              <div
                class="sleeveless-review-project-header__title-view"
                data-sleeveless-pattern-project-title-view
              >
                <div
                  class="sleeveless-review-project-header__section-head"
                  data-sleeveless-pattern-project-title-edit
                  role="button"
                  tabindex="0"
                  title="Edit pattern name"
                  aria-label="Edit pattern name"
                >
                  <span class="sleeveless-review-project-header__section-pencil" aria-hidden="true">
                    <svg
                      class="sleeveless-review-project-header__pencil-icon"
                      width="21"
                      height="21"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <span class="sleeveless-review-project-header__label">Pattern name</span>
                </div>
                <p
                  class="sleeveless-review-project-header__title-display"
                  data-sleeveless-pattern-project-title-display
                ></p>
              </div>
              <div
                class="sleeveless-review-project-header__title-panel"
                data-sleeveless-pattern-project-title-panel
                hidden
              >
                <label class="sleeveless-review-project-header__label" for="sleeveless-pattern-name">
                  Pattern name
                </label>
                <div class="sleeveless-review-project-header__title-field">
                  <input
                    id="sleeveless-pattern-name"
                    class="sleeveless-review-project-header__title-input"
                    type="text"
                    data-sleeveless-pattern-project-title
                    autocomplete="off"
                    spellcheck="false"
                  />
                </div>
                <div class="sleeveless-review-project-header__title-footer">
                  <div
                    class="sleeveless-review-project-header__title-toolbar"
                    role="group"
                    aria-label="Pattern name actions"
                  >
                    <button
                      type="button"
                      class="sleeveless-review-project-header__notes-icon-btn sleeveless-review-project-header__notes-icon-btn--save"
                      data-sleeveless-pattern-project-title-save
                      title="Save pattern name"
                      aria-label="Save pattern name"
                    >
                      <i class="fa-solid fa-check" aria-hidden="true"></i>
                    </button>
                    <button
                      type="button"
                      class="sleeveless-review-project-header__notes-icon-btn sleeveless-review-project-header__notes-icon-btn--close"
                      data-sleeveless-pattern-project-title-cancel
                      title="Cancel"
                      aria-label="Cancel"
                    >
                      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <div class="sleeveless-review-project-header__notes">
              <div
                class="sleeveless-review-project-header__notes-readonly"
                data-sleeveless-pattern-project-notes-readonly
                hidden
              >
                <p class="sleeveless-review-project-header__label">Project notes</p>
                <p
                  class="sleeveless-review-project-header__notes-display"
                  data-sleeveless-pattern-project-notes-display
                ></p>
              </div>
              <div
                class="sleeveless-review-project-header__section-head"
                data-sleeveless-pattern-project-notes-header
                data-sleeveless-pattern-project-notes-edit
                role="button"
                tabindex="0"
                title="Edit project notes"
                aria-label="Edit project notes"
              >
                <span class="sleeveless-review-project-header__section-pencil" aria-hidden="true">
                  <svg
                    class="sleeveless-review-project-header__pencil-icon"
                    width="21"
                    height="21"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </span>
                <span class="sleeveless-review-project-header__label">Project notes</span>
              </div>
              <div
                class="sleeveless-review-project-header__notes-view"
                data-sleeveless-pattern-project-notes-view
                hidden
              >
                <p
                  class="sleeveless-review-project-header__notes-display"
                  data-sleeveless-pattern-project-notes-static
                ></p>
              </div>
              <div
                class="sleeveless-review-project-header__notes-panel"
                data-sleeveless-pattern-project-notes-panel
                hidden
              >
                <label class="sleeveless-review-project-header__label" for="sleeveless-pattern-notes">
                  Project notes
                </label>
                <textarea
                  id="sleeveless-pattern-notes"
                  class="sleeveless-review-project-header__notes-input"
                  data-sleeveless-pattern-project-notes
                  rows={3}
                  maxlength={300}
                  autocomplete="off"
                ></textarea>
                <div class="sleeveless-review-project-header__notes-footer">
                  <div
                    class="sleeveless-review-project-header__notes-toolbar"
                    role="group"
                    aria-label="Project notes actions"
                  >
                    <button
                      type="button"
                      class="sleeveless-review-project-header__notes-icon-btn sleeveless-review-project-header__notes-icon-btn--save"
                      data-sleeveless-pattern-project-notes-save
                      title="Save notes"
                      aria-label="Save notes"
                    >
                      <i class="fa-solid fa-check" aria-hidden="true"></i>
                    </button>
                    <button
                      type="button"
                      class="sleeveless-review-project-header__notes-icon-btn sleeveless-review-project-header__notes-icon-btn--close"
                      data-sleeveless-pattern-project-notes-cancel
                      title="Close"
                      aria-label="Close"
                    >
                      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                    <button
                      type="button"
                      class="sleeveless-review-project-header__notes-icon-btn sleeveless-review-project-header__notes-icon-btn--delete"
                      data-sleeveless-pattern-project-notes-delete
                      title="Delete notes"
                      aria-label="Delete notes"
                    >
                      <i class="fa-solid fa-trash" aria-hidden="true"></i>
                    </button>
                  </div>
                  <div class="sleeveless-review-project-header__notes-footer-end">
                    <span
                      class="sleeveless-review-project-header__notes-saved pattern-subtext"
                      data-sleeveless-pattern-project-notes-saved
                      hidden
                      aria-live="polite"
                    >
                      Notes saved
                    </span>
                    <span
                      class="sleeveless-review-project-header__notes-count pattern-subtext"
                      data-sleeveless-pattern-project-notes-count
                    >
                      0 / 300
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </header>

          <div
            class="sleeveless-measure-project-summary sleeveless-measure-project-summary--below-header"
            data-express-measurements-project-summary
            data-cb-build-summary
            aria-label="Project summary"
          >
            <div
              class="sleeveless-measure-summary-edit-row"
              data-sleeveless-review-summary-edit
              data-href={expressHref}
              role="button"
              tabindex="0"
              title="Edit pattern"
              aria-label="Edit pattern"
            >
              <span class="sleeveless-review-project-header__section-pencil" aria-hidden="true">
                <svg
                  class="sleeveless-review-project-header__pencil-icon"
                  width="21"
                  height="21"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
              <div
                class="sleeveless-measure-summary-edit-row__content"
                data-sleeveless-review-summary-line-slot
              ></div>
            </div>
            <div
              class="express-builder-units no-print express-measurements-intro-units"
              data-express-measurements-units-host
            >
              <UnitToggle id="sleeveless-fit" />
            </div>
          </div>

          <section class="sleeveless-review-diagram-section" aria-label="Body measurements diagram">
            <p class="cb-measure-missing" data-cb-measure-missing hidden>
              Complete the pattern builder steps to load measurements.
            </p>

            <div
              class="sleeveless-measure-diagram-host express-measurements-summary sleeveless-review-diagram-host"
              data-express-measurements-summary
              data-cb-measure-diagram
            >
              <p class="pattern-subtext">Loading measurements…</p>
            </div>
          </section>

          <div class="sleeveless-measure-actions express-measurements-actions no-print">
            <button type="button" id="express-yarn-drawer-open" class="kbm-btn kbm-btn-outline">
              Check Yarn Needed
            </button>
            <button
              type="button"
              class="kbm-btn kbm-btn-accent"
              data-cb-measure-continue
              data-cb-measure-continue-default="Build My Pattern"
            >
              Build My Pattern
            </button>
          </div>
        </div>
      </div>
    </div>

    <div
      id="express-yarn-drawer"
      class="hat-yarn-drawer no-print"
      aria-hidden="true"
    >
      <div
        id="express-yarn-drawer-panel"
        class="hat-yarn-drawer-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="express-yarn-drawer-title"
        aria-describedby="express-yarn-drawer-desc express-yarn-drawer-note"
      >
        <header class="hat-yarn-drawer-header">
          <div class="hat-yarn-drawer-header-text">
            <h2 id="express-yarn-drawer-title" class="hat-yarn-drawer-title">Check your yarn</h2>
            <p id="express-yarn-drawer-desc" class="hat-yarn-drawer-lede">
              Quick estimate from a weighed swatch using this sweater’s finished size.
            </p>
            <p id="express-yarn-drawer-note" class="hat-yarn-drawer-note">
              This is an estimate. Actual yarn use may vary with stitch pattern, ribbing, bands, shaping, and finishing.
            </p>
          </div>
          <button type="button" class="hat-yarn-drawer-close" id="express-yarn-drawer-close" aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M18 6L6 18M6 6l12 12"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </header>
        <div class="hat-yarn-drawer-body">
          <YarnRequirement
            variant="garment"
            layout="panel"
            presentation="drawer"
            projectWidth={0}
            projectLength={0}
            lengthUnit="in"
            source="custom"
          />
        </div>
      </div>
      <div
        id="express-yarn-drawer-backdrop"
        class="hat-yarn-drawer-backdrop"
        aria-hidden="true"
      ></div>
    </div>
  </main>
</Layout>

<style>
  .sleeveless-unified-review-page .sleeveless-review-access-banner {
    margin: 0 0 0.65rem;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .sleeveless-unified-review-page .sleeveless-review-access-banner--free {
    border: 1px solid color-mix(in srgb, var(--kbm-green, #52682d) 20%, #ddd);
    background: color-mix(in srgb, var(--kbm-green, #52682d) 6%, var(--page-bg, #fff));
    color: #374151;
  }

  .sleeveless-unified-review-page .sleeveless-review-access-banner--advanced {
    border: 1px solid color-mix(in srgb, var(--sg-accent, #c2614e) 22%, #e8e4df);
    background: color-mix(in srgb, var(--sg-accent, #c2614e) 6%, var(--page-bg, #fff));
    color: #374151;
  }

  .sleeveless-unified-review-page .sleeveless-review-access-banner__text {
    margin: 0;
  }
</style>

<script>
  import "/src/scripts/sleevelessReviewProjectHeader.ts";
  import "/src/scripts/sleeveless-builder-review-page.ts";
</script>
