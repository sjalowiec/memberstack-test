---
import Layout from "../../../layouts/Layout.astro";
import SleevelessPatternMemberGate from "../../../components/patterns/SleevelessPatternMemberGate.astro";
import WizardBackLink from "../../../components/wizards/WizardBackLink.astro";
import "../../../styles/sleeveless-express-builder-cards.css";
import "../../../styles/sleeveless-express-wizard-layout.css";
import "../../../styles/custom-pattern-editing-banner.css";
import { formatFitEaseApproxLabel } from "../../../lib/patterns/fitEaseInches";

const foundationHref = "/patterns/sleeveless/custom-build/design";
const measurementsHref = "/patterns/sleeveless/custom-build/fit/";

const customWizardSteps = [
  { step: 1, label: "Foundation", href: foundationHref as string | undefined },
  { step: 2, label: "Style & Shaping" },
  { step: 3, label: "Measurements" },
  { step: 4, label: "Yarn & Gauge" },
  { step: 5, label: "Pattern" },
] as const;

const imgBase = "/images/patterns/sleeveless";
const imgGarmentPullover = "/images/patterns/pullover.png";
const imgGarmentCardigan = "/images/patterns/cardigan.png";
---

<Layout
  title="Custom Pattern — Style &amp; Shaping | Sleeveless Sweater"
  description="Choose neckline, fit, body shape, and garment type for your custom sleeveless sweater. Style choices are saved for pattern generation."
>
  <SleevelessPatternMemberGate>
  <main class="express-page wizard-page sleeveless-express-page" data-express-page="sleeveless-custom-style">
    <div class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <WizardBackLink className="back-link no-print" fallback="/patterns" />
        <div data-cb-editing-banner-host hidden></div>

        <div class="sg-tab-build">
          <div class="express-builder-nav-row express-builder-nav-row--custom-flow no-print">
            <nav class="express-step-nav sg-builder-nav" aria-label="Custom build steps">
              <ol class="express-step-nav__list sg-builder-nav__list" role="list">
                {
                  customWizardSteps.map((s, i) => (
                    <li
                      class:list={[
                        "express-step-nav__item",
                        "sg-builder-nav__item",
                        { active: s.step === 2 },
                      ]}
                    >
                      {s.step === 2 ? (
                        <span
                          class:list={["express-step-nav__btn", "sg-builder-nav__link", "is-current"]}
                          aria-current="page"
                          aria-label={`${s.label}, current step`}
                        >
                          <span class="express-step-nav__track">
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--before",
                                { "express-step-nav__seg--empty": i === 0 },
                              ]}
                              aria-hidden="true"
                            />
                            <span class="express-step-nav__circle">
                              <span class="express-step-nav__num">{s.step}</span>
                              <span class="express-pill__check" aria-hidden="true">
                                ✓
                              </span>
                            </span>
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--after",
                                { "express-step-nav__seg--empty": i === customWizardSteps.length - 1 },
                              ]}
                              aria-hidden="true"
                            />
                          </span>
                          <span class="express-step-nav__label">{s.label}</span>
                        </span>
                      ) : "href" in s && s.href ? (
                        <a
                          href={s.href}
                          class:list={[
                            "express-step-nav__btn",
                            "sg-builder-nav__link",
                            "is-complete",
                            "express-step-nav__btn--link",
                          ]}
                          aria-label={`${s.label}, completed. Go back to foundation.`}
                        >
                          <span class="express-step-nav__track">
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--before",
                                { "express-step-nav__seg--empty": i === 0 },
                              ]}
                              aria-hidden="true"
                            />
                            <span class="express-step-nav__circle">
                              <span class="express-step-nav__num">{s.step}</span>
                              <span class="express-pill__check" aria-hidden="true">
                                ✓
                              </span>
                            </span>
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--after",
                                { "express-step-nav__seg--empty": i === customWizardSteps.length - 1 },
                              ]}
                              aria-hidden="true"
                            />
                          </span>
                          <span class="express-step-nav__label">{s.label}</span>
                        </a>
                      ) : (
                        <span
                          class:list={["express-step-nav__btn", "sg-builder-nav__link", "is-upcoming"]}
                          aria-disabled="true"
                          title="Use Continue to move through the Custom Pattern steps."
                        >
                          <span class="express-step-nav__track">
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--before",
                                { "express-step-nav__seg--empty": i === 0 },
                              ]}
                              aria-hidden="true"
                            />
                            <span class="express-step-nav__circle">
                              <span class="express-step-nav__num">{s.step}</span>
                              <span class="express-pill__check" aria-hidden="true">
                                ✓
                              </span>
                            </span>
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--after",
                                { "express-step-nav__seg--empty": i === customWizardSteps.length - 1 },
                              ]}
                              aria-hidden="true"
                            />
                          </span>
                          <span class="express-step-nav__label">{s.label}</span>
                        </span>
                      )}
                    </li>
                  ))
                }
              </ol>
            </nav>
          </div>

          <header class="pattern-header page-header">
            <p class="pattern-mode-label">Custom Pattern</p>
            <h1 class="pattern-title">Style &amp; Shaping</h1>
            <p class="pattern-subtext">
              Style &amp; Shaping covers neckline, fit (close, standard, or relaxed), body shape, and garment type —
              the visible sweater style and silhouette for your pattern.
            </p>
          </header>

          <div class="express-panel calculator-card">
            <div class="express-builder-root" data-cb-custom-style-root>
              <div class="express-accordions" id="cb-custom-style-accordions">
                <section class="express-acc express-acc--open express-acc--complete" data-cb-style-acc data-cb-style-step="neckline">
                  <div
                    class="express-acc__header"
                    data-cb-style-header
                    role="button"
                    tabindex="0"
                    aria-expanded="true"
                    aria-controls="cb-style-panel-neckline"
                    id="cb-style-label-neckline"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-cb-style-chevron
                      aria-label="Toggle neckline options"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" aria-hidden="true">✓</span>
                      <h2 class="express-acc__title" id="cb-style-title-neckline">Choose Your Neckline</h2>
                      <span class="express-acc__value" data-style-summary="neckline"></span>
                    </div>
                  </div>
                  <div
                    class="express-acc__body"
                    id="cb-style-panel-neckline"
                    role="region"
                    aria-labelledby="cb-style-title-neckline"
                    data-cb-style-body
                  >
                    <div
                      class="hat-length-picker__grid hat-brim-picker__grid express-style-card-grid"
                      role="radiogroup"
                      aria-labelledby="cb-style-title-neckline"
                      data-cb-style-group="neckline"
                    >
                      <button
                        type="button"
                        class="hat-length-picker__option sg-fit-preference-option"
                        data-cb-style-value="round"
                        aria-pressed="false"
                      >
                        <img
                          src="/images/patterns/choice-round.png"
                          alt=""
                          class="hat-length-picker__img sg-picker-img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="sg-fit-preference-title-row">
                          <span class="hat-length-picker__option-label">Round neck</span>
                          <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                        </span>
                        <span class="sg-fit-preference-note">Classic crew-style opening.</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option sg-fit-preference-option"
                        data-cb-style-value="v-neck"
                        aria-pressed="false"
                      >
                        <img
                          src="/images/patterns/choice-v.png"
                          alt=""
                          class="hat-length-picker__img sg-picker-img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="sg-fit-preference-title-row">
                          <span class="hat-length-picker__option-label">V-neck</span>
                          <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                        </span>
                        <span class="sg-fit-preference-note">Center front dips in a V.</span>
                      </button>
                    </div>
                  </div>
                </section>

                <section class="express-acc express-acc--complete" data-cb-style-acc data-cb-style-step="fit">
                  <div
                    class="express-acc__header"
                    data-cb-style-header
                    role="button"
                    tabindex="0"
                    aria-expanded="false"
                    aria-controls="cb-style-panel-fit"
                    id="cb-style-label-fit"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-cb-style-chevron
                      aria-label="Toggle fit preference options"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" aria-hidden="true">✓</span>
                      <h2 class="express-acc__title" id="cb-style-title-fit">Choose Your Fit</h2>
                      <span class="express-acc__value" data-style-summary="fit"></span>
                    </div>
                  </div>
                  <div
                    class="express-acc__body"
                    id="cb-style-panel-fit"
                    role="region"
                    aria-labelledby="cb-style-title-fit"
                    data-cb-style-body
                    hidden
                  >
                    <div
                      class="express-fit-cards hat-length-picker__grid sg-fit-preference-grid express-style-card-grid"
                      role="radiogroup"
                      aria-labelledby="cb-style-title-fit"
                      data-cb-style-group="fit"
                    >
                      <button
                        type="button"
                        class="hat-length-picker__option sg-fit-preference-option"
                        data-cb-style-value="close"
                        aria-pressed="false"
                      >
                        <img
                          class="fit-card-image"
                          src="/images/patterns/fit-close.jpg"
                          alt="Close fit sleeveless garment"
                        />
                        <span class="sg-fit-preference-title-row">
                          <span class="hat-length-picker__option-label">Close fit</span>
                          <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                        </span>
                        <span class="sg-fit-preference-note">Fits close to the body.</span>
                        <span class="sg-fit-preference-ease">{formatFitEaseApproxLabel("close")}</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option sg-fit-preference-option"
                        data-cb-style-value="standard"
                        aria-pressed="false"
                      >
                        <img
                          class="fit-card-image"
                          src="/images/pattern/fit-standard.jpg"
                          alt="Standard fit sleeveless garment"
                        />
                        <span class="sg-fit-preference-title-row">
                          <span class="hat-length-picker__option-label">Standard fit</span>
                          <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                        </span>
                        <span class="sg-fit-preference-note">Comfortable everyday fit.</span>
                        <span class="sg-fit-preference-ease">{formatFitEaseApproxLabel("standard")}</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option sg-fit-preference-option"
                        data-cb-style-value="relaxed"
                        aria-pressed="false"
                      >
                        <img
                          class="fit-card-image"
                          src="/images/patterns/fit-relaxed.jpg"
                          alt="Relaxed fit sleeveless garment"
                        />
                        <span class="sg-fit-preference-title-row">
                          <span class="hat-length-picker__option-label">Relaxed fit</span>
                          <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                        </span>
                        <span class="sg-fit-preference-note">More room and drape.</span>
                        <span class="sg-fit-preference-ease">{formatFitEaseApproxLabel("relaxed")}</span>
                      </button>
                    </div>
                  </div>
                </section>

                <section class="express-acc express-acc--complete" data-cb-style-acc data-cb-style-step="body">
                  <div
                    class="express-acc__header"
                    data-cb-style-header
                    role="button"
                    tabindex="0"
                    aria-expanded="false"
                    aria-controls="cb-style-panel-body"
                    id="cb-style-label-body"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-cb-style-chevron
                      aria-label="Toggle body shape options"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" aria-hidden="true">✓</span>
                      <h2 class="express-acc__title" id="cb-style-title-body">Choose Your Body Shape</h2>
                      <span class="express-acc__value" data-style-summary="bodyShape"></span>
                    </div>
                  </div>
                  <div
                    class="express-acc__body"
                    id="cb-style-panel-body"
                    role="region"
                    aria-labelledby="cb-style-title-body"
                    data-cb-style-body
                    hidden
                  >
                    <div
                      class="hat-length-picker__grid sg-fit-preference-grid express-style-card-grid express-style-card-grid--three"
                      role="radiogroup"
                      aria-labelledby="cb-style-title-body"
                      data-cb-style-group="bodyShape"
                    >
                      <button
                        type="button"
                        class="hat-length-picker__option sg-fit-preference-option"
                        data-cb-style-value="straight"
                        aria-pressed="false"
                      >
                        <img
                          src={`${imgBase}/shape-straight.svg`}
                          alt=""
                          class="hat-length-picker__img sg-picker-img"
                          width="120"
                          height="120"
                          loading="lazy"
                        />
                        <span class="sg-fit-preference-title-row">
                          <span class="hat-length-picker__option-label">Straight</span>
                          <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                        </span>
                        <span class="sg-fit-preference-note">Same width from bust to hem.</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option sg-fit-preference-option"
                        data-cb-style-value="aline"
                        aria-pressed="false"
                      >
                        <img
                          src={`${imgBase}/shape-aline.svg`}
                          alt=""
                          class="hat-length-picker__img sg-picker-img"
                          width="120"
                          height="120"
                          loading="lazy"
                        />
                        <span class="sg-fit-preference-title-row">
                          <span class="hat-length-picker__option-label">A-Line</span>
                        </span>
                        <span class="sg-fit-preference-note">Gentle flare toward the hem.</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option sg-fit-preference-option cb-style-option--disabled"
                        data-cb-style-value="shaped"
                        aria-pressed="false"
                        disabled
                        aria-disabled="true"
                      >
                        <span class="cb-style-coming-pill">Coming next</span>
                        <img
                          src={`${imgBase}/shape-gathered.svg`}
                          alt=""
                          class="hat-length-picker__img sg-picker-img"
                          width="120"
                          height="120"
                          loading="lazy"
                        />
                        <span class="sg-fit-preference-title-row">
                          <span class="hat-length-picker__option-label">Shaped Waist</span>
                        </span>
                        <span class="sg-fit-preference-note">Defined waist and hip curve.</span>
                      </button>
                    </div>
                  </div>
                </section>

                <section class="express-acc express-acc--open express-acc--complete" data-cb-style-acc data-cb-style-step="garment">
                  <div
                    class="express-acc__header"
                    data-cb-style-header
                    role="button"
                    tabindex="0"
                    aria-expanded="true"
                    aria-controls="cb-style-panel-garment"
                    id="cb-style-label-garment"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-cb-style-chevron
                      aria-label="Toggle garment type options"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" aria-hidden="true">✓</span>
                      <h2 class="express-acc__title" id="cb-style-title-garment">Choose Your Garment Type</h2>
                      <span class="express-acc__value" data-style-summary="garmentType"></span>
                    </div>
                  </div>
                  <div
                    class="express-acc__body"
                    id="cb-style-panel-garment"
                    role="region"
                    aria-labelledby="cb-style-title-garment"
                    data-cb-style-body
                  >
                    <div
                      class="hat-length-picker__grid hat-brim-picker__grid express-style-card-grid"
                      role="radiogroup"
                      aria-labelledby="cb-style-title-garment"
                      data-cb-style-group="garmentType"
                    >
                      <button
                        type="button"
                        class="hat-length-picker__option sg-fit-preference-option"
                        data-cb-style-value="pullover"
                        aria-pressed="false"
                      >
                        <span class="express-garment-type-card__img-wrap">
                          <img
                            src={imgGarmentPullover}
                            alt=""
                            class="hat-length-picker__img sg-picker-img express-garment-type-card__img"
                            width="433"
                            height="469"
                            loading="lazy"
                          />
                        </span>
                        <span class="sg-fit-preference-title-row">
                          <span class="hat-length-picker__option-label">Pullover</span>
                          <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                        </span>
                        <span class="sg-fit-preference-note">No front opening; knit as one piece.</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option sg-fit-preference-option"
                        data-cb-style-value="cardigan"
                        aria-pressed="false"
                      >
                        <span class="express-garment-type-card__img-wrap">
                          <img
                            src={imgGarmentCardigan}
                            alt=""
                            class="hat-length-picker__img sg-picker-img express-garment-type-card__img"
                            width="433"
                            height="469"
                            loading="lazy"
                          />
                        </span>
                        <span class="sg-fit-preference-title-row">
                          <span class="hat-length-picker__option-label">Cardigan</span>
                        </span>
                        <span class="sg-fit-preference-note">Front opening for wear layered open.</span>
                      </button>
                    </div>
                  </div>
                </section>
              </div>

              <div class="wizard-next-cta wizard-next-cta--split cb-design-wizard-nav no-print">
                <a href={foundationHref} class="kbm-btn kbm-btn-outline">← Back: Foundation</a>
                <a href={measurementsHref} class="kbm-btn kbm-btn-accent">Continue: Measurements →</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  </SleevelessPatternMemberGate>
</Layout>

<style>
  .express-builder-nav-row--custom-flow {
    max-width: 920px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 1.35rem;
  }

  .express-builder-nav-row--custom-flow .express-step-nav__label {
    font-size: clamp(0.68rem, 2.1vw, 0.8125rem);
    line-height: 1.15;
    hyphens: auto;
  }

  .express-page a.express-step-nav__btn--link {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .express-page a.express-step-nav__btn--link:focus-visible {
    outline: 2px solid var(--sg-accent, #c2614e);
    outline-offset: 3px;
    border-radius: 8px;
  }

  .express-page .express-step-nav__btn.is-upcoming {
    opacity: 0.55;
    cursor: not-allowed;
    pointer-events: none;
  }

  .express-style-card-grid {
    align-items: stretch;
  }

  .express-style-card-grid--three {
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
  }

  .cb-style-option--disabled {
    opacity: 0.58;
    cursor: not-allowed;
    position: relative;
    filter: saturate(0.88);
  }

  .cb-style-option--disabled .sg-fit-preference-note {
    color: rgba(75, 85, 99, 0.82);
  }

  .cb-style-coming-pill {
    display: inline-block;
    align-self: center;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6b7280;
    background: rgba(107, 114, 128, 0.12);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    margin-bottom: 0.35rem;
  }
</style>

<script>
  import "/src/scripts/sleeveless-custom-style-page.ts";
  import "/src/scripts/customPatternEditingBanner.ts";
</script>
