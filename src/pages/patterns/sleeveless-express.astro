---
import Layout from "../../layouts/Layout.astro";
import SleevelessPatternMemberGate from "../../components/patterns/SleevelessPatternMemberGate.astro";
import GlossaryTooltip from "../../components/common/GlossaryTooltip.astro";
import GaugeInput from "../../components/wizards/GaugeInput.astro";
import UnitToggle from "../../components/wizards/UnitToggle.astro";
import SleevelessExpressEditingBar from "../../components/patterns/SleevelessExpressEditingBar.astro";
import PatternBuilderMyPatternsLink from "../../components/patterns/PatternBuilderMyPatternsLink.astro";
import PatternWorkspaceLibraryDrawer from "../../components/patterns/PatternWorkspaceLibraryDrawer.astro";
/* Wizard is @import'd first inside sleeveless-express-builder-cards.css so Express overrides always win cascade */
import "../../styles/sleeveless-express-builder-cards.css";
import "../../styles/sleeveless-express-wizard-layout.css";
import "../../styles/express-size-selection.css";
import "../../styles/custom-pattern-editing-banner.css";

const expressNavSteps = [
  { step: 1, label: "Who & Size" },
  { step: 2, label: "Front" },
  { step: 3, label: "Neckline" },
  { step: 4, label: "Fit" },
  { step: 5, label: "Gauge" },
] as const;

const imgSleeveless = "/images/patterns/sleeveless";
/** Front style (Pullover / Cardigan) — shared flat garment art */
const imgGarmentPullover = "/images/patterns/pullover.png";
const imgGarmentCardigan = "/images/patterns/cardigan.png";
---

<Layout
  title="Express Pattern | Sleeveless Sweater"
  description="Create a ready-to-knit sleeveless sweater pattern in guided steps."
>
  <SleevelessPatternMemberGate>
  <main class="express-page wizard-page sleeveless-express-page" data-express-page="sleeveless-express">
    <div id="express-pattern-top" class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <div data-cb-editing-banner-host hidden></div>

        <div class="sg-tab-build">
            <div class="sg-builder-nav-row express-builder-nav-row no-print">
              <nav class="express-step-nav sg-builder-nav" aria-label="Express pattern steps">
                <ol class="express-step-nav__list sg-builder-nav__list" role="list">
                  {
                    expressNavSteps.map((s, i) => (
                      <li class:list={["express-step-nav__item", "sg-builder-nav__item", { active: s.step === 1 }]}>
                        <button
                          type="button"
                          class:list={[
                            "express-step-nav__btn",
                            "sg-builder-nav__link",
                            {
                              "is-current": s.step === 1,
                              "is-upcoming": s.step > 1,
                            },
                          ]}
                          data-pill-step={s.step}
                          data-pill-label={s.label}
                          aria-current={s.step === 1 ? "page" : undefined}
                          aria-disabled={s.step > 1 ? "true" : undefined}
                          title={s.step > 1 ? "Finish the previous step to continue." : undefined}
                        >
                          <span class="express-step-nav__track">
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--before",
                                { "express-step-nav__seg--empty": i === 0 },
                              ]}
                              aria-hidden="true"
                            />
                            <span class="express-step-nav__circle">
                              <span class="express-step-nav__num">{s.step}</span>
                              <span class="express-pill__check" aria-hidden="true">
                                ✓
                              </span>
                            </span>
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--after",
                                { "express-step-nav__seg--empty": i === expressNavSteps.length - 1 },
                              ]}
                              aria-hidden="true"
                            />
                          </span>
                          <span class="express-step-nav__label">{s.label}</span>
                        </button>
                      </li>
                    ))
                  }
                </ol>
              </nav>
            </div>

            <header class="pattern-header page-header">
              <div class="pattern-header__title-row">
                <h1 class="pattern-title">Sleeveless Sweater</h1>
                <PatternBuilderMyPatternsLink />
              </div>
              <SleevelessExpressEditingBar />
              <p class="pattern-subtext">
                Create a ready-to-knit sweater pattern in a few guided steps.
              </p>
            </header>

            <div class="express-panel">
              <div class="express-builder-root" data-express-builder>
                <div class="express-builder-units no-print">
                  <UnitToggle id="sleeveless-fit" />
                </div>
                <div class="express-accordions" id="express-accordions">
          <!-- Step 1 — Who + Size (single accordion) -->
          <section
            class="express-acc express-acc--open"
            data-express-step="1"
            data-express-field="who"
          >
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="0"
              aria-expanded="true"
              aria-controls="express-acc-panel-1"
              id="express-acc-label-1"
            >
              <button
                type="button"
                class="express-acc__chevron"
                data-express-chevron
                aria-label="Toggle who and size choices"
                tabindex="-1"
              >
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__step" aria-hidden="true">1</span>
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <h2 class="express-acc__title" id="express-step-1-title">Who & Size</h2>
                <span class="express-acc__value" data-express-summary="who"></span>
                <span class="express-acc__value" data-express-summary="selectedSize"></span>
              </div>
            </div>
            <div
              class="express-acc__body"
              id="express-acc-panel-1"
              role="region"
              aria-labelledby="express-step-1-title"
            >
              <div
                class="express-options--who hat-length-picker__grid"
                role="group"
                aria-labelledby="express-step-1-title"
              >
                <button
                  type="button"
                  class="hat-length-picker__option express-who-card"
                  data-choice
                  data-field="who"
                  data-value="women"
                  aria-pressed="false"
                >
                  <img
                    src="/images/patterns/sleeveless/people/sleeveless-woman-pullover-round-neck.webp"
                    alt=""
                    class="hat-length-picker__img sg-picker-img express-who-card__img"
                    width="168"
                    height="210"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hat-length-picker__option-label">Women</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option express-who-card"
                  data-choice
                  data-field="who"
                  data-value="men"
                  aria-pressed="false"
                >
                  <img
                    src="/images/patterns/sleeveless/people/sleeveless-man-pullover-round-neck.webp"
                    alt=""
                    class="hat-length-picker__img sg-picker-img express-who-card__img"
                    width="168"
                    height="210"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hat-length-picker__option-label">Men</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option express-who-card"
                  data-choice
                  data-field="who"
                  data-value="kids"
                  aria-pressed="false"
                >
                  <img
                    src="/images/patterns/sleeveless/people/sleeveless-kids-pullover-round-neck.webp"
                    alt=""
                    class="hat-length-picker__img sg-picker-img express-who-card__img"
                    width="168"
                    height="210"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hat-length-picker__option-label">Kids</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option express-who-card"
                  data-choice
                  data-field="who"
                  data-value="baby"
                  aria-pressed="false"
                >
                  <img
                    src="/images/patterns/sleeveless/people/sleeveless-baby-pullover-round-neck.webp"
                    alt=""
                    class="hat-length-picker__img sg-picker-img express-who-card__img"
                    width="168"
                    height="210"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hat-length-picker__option-label">Baby</span>
                </button>
              </div>
              <div class="express-who-size-nested" data-express-nested-size hidden>
                <p class="express-size-instruction" id="express-size-helper-text">
                  Choose your size: Select the bust/chest measurement closest to yours.
                </p>
                <p class="express-size-load-msg sg-fit-size-copy" data-express-size-status>
                  Loading size charts…
                </p>
                <div class="express-size-select-wrap" data-express-size-select-wrap hidden>
                  <div class="express-size-table-wrap">
                    <table class="express-size-table">
                      <thead>
                        <tr>
                          <th scope="col">Size</th>
                          <th scope="col">Bust/Chest</th>
                        </tr>
                      </thead>
                      <tbody
                        role="radiogroup"
                        aria-labelledby="express-size-helper-text"
                        data-express-size-table-body
                      ></tbody>
                    </table>
                  </div>
                  <select
                    id="express-body-size-select"
                    class="express-size-select express-size-select--visually-hidden"
                    data-express-size-select
                    tabindex="-1"
                    aria-hidden="true"
                    autocomplete="off"
                  ></select>
                </div>
              </div>
            </div>
          </section>

          <!-- Step 2 — front style (matches sleeveless-garment Express card layout) -->
          <section class="express-acc express-acc--locked" data-express-step="2" data-express-field="front">
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="-1"
              aria-expanded="false"
              aria-controls="express-acc-panel-2"
              id="express-acc-label-2"
            >
              <button type="button" class="express-acc__chevron" data-express-chevron aria-hidden="true" tabindex="-1">
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__step" aria-hidden="true">2</span>
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <h2 class="express-acc__title" id="express-step-2-title">Choose your front style</h2>
                <span class="express-acc__value" data-express-summary="front"></span>
              </div>
            </div>
            <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
              <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
              <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
            </p>
            <div
              class="express-acc__body"
              id="express-acc-panel-2"
              role="region"
              aria-labelledby="express-step-2-title"
              hidden
            >
              <div
                class="express-front-cards hat-length-picker__grid hat-brim-picker__grid"
                role="radiogroup"
                aria-labelledby="express-step-2-title"
              >
                <button
                  type="button"
                  class="hat-length-picker__option"
                  data-choice
                  data-field="front"
                  data-value="closed"
                  aria-pressed="false"
                >
                  <span class="express-front-card__img-wrap">
                    <img
                      src={imgGarmentPullover}
                      alt=""
                      class="hat-length-picker__img sg-picker-img express-front-card__img"
                      width="433"
                      height="469"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="hat-length-picker__option-label">Pullover</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option"
                  data-choice
                  data-field="front"
                  data-value="open"
                  aria-pressed="false"
                >
                  <span class="express-front-card__img-wrap">
                    <img
                      src={imgGarmentCardigan}
                      alt=""
                      class="hat-length-picker__img sg-picker-img express-front-card__img"
                      width="433"
                      height="469"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="hat-length-picker__option-label">Cardigan</span>
                </button>
              </div>
            </div>
          </section>

          <!-- Step 3 -->
          <section class="express-acc express-acc--locked" data-express-step="3" data-express-field="neckline">
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="-1"
              aria-expanded="false"
              aria-controls="express-acc-panel-3"
              id="express-acc-label-3"
            >
              <button type="button" class="express-acc__chevron" data-express-chevron aria-hidden="true" tabindex="-1">
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__step" aria-hidden="true">3</span>
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <h2 class="express-acc__title" id="express-step-3-title">Choose your neckline</h2>
                <span class="express-acc__value" data-express-summary="neckline"></span>
              </div>
            </div>
            <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
              <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
              <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
            </p>
            <div
              class="express-acc__body"
              id="express-acc-panel-3"
              role="region"
              aria-labelledby="express-step-3-title"
              hidden
            >
              <div
                class="express-neck-cards hat-length-picker__grid hat-brim-picker__grid"
                role="group"
                aria-labelledby="express-step-3-title"
              >
                <button
                  type="button"
                  class="hat-length-picker__option"
                  data-choice
                  data-field="neckline"
                  data-value="round"
                  aria-pressed="false"
                >
                  <img
                    src="/images/patterns/choice-round.png"
                    alt=""
                    class="hat-length-picker__img sg-picker-img"
                    width="120"
                    height="120"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hat-length-picker__option-label">Round</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option"
                  data-choice
                  data-field="neckline"
                  data-value="v-neck"
                  aria-pressed="false"
                >
                  <img
                    src="/images/patterns/choice-v.png"
                    alt=""
                    class="hat-length-picker__img sg-picker-img"
                    width="120"
                    height="120"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hat-length-picker__option-label">V-neck</span>
                </button>
              </div>
            </div>
          </section>

          <!-- Step 4 -->
          <section class="express-acc express-acc--locked" data-express-step="4" data-express-field="fit">
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="-1"
              aria-expanded="false"
              aria-controls="express-acc-panel-4"
              id="express-acc-label-4"
            >
              <button type="button" class="express-acc__chevron" data-express-chevron aria-hidden="true" tabindex="-1">
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__step" aria-hidden="true">4</span>
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <div class="express-acc__title-row express-acc__title-row--fit">
                  <h2 class="express-acc__title" id="express-step-4-title">Choose your fit</h2>
                  <button
                    type="button"
                    class="express-fit-help-btn"
                    data-fit-help-open
                    aria-haspopup="dialog"
                    aria-controls="express-fit-help-dialog"
                    aria-label="Learn about fit and ease"
                    title="Not sure which fit to choose?"
                  >
                    <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
                  </button>
                </div>
                <span class="express-acc__value" data-express-summary="fit"></span>
              </div>
            </div>
            <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
              <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
              <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
            </p>
            <div
              class="express-acc__body"
              id="express-acc-panel-4"
              role="region"
              aria-labelledby="express-step-4-title"
              hidden
            >
              <div
                class="express-fit-cards hat-length-picker__grid sg-fit-preference-grid"
                role="group"
                aria-labelledby="express-step-4-title"
              >
                <button
                  type="button"
                  class="hat-length-picker__option sg-fit-preference-option"
                  data-choice
                  data-field="fit"
                  data-value="close"
                  aria-pressed="false"
                >
                  <img
                    class="fit-card-image"
                    src="/images/patterns/fit-close.jpg"
                    alt="Close fit sleeveless garment"
                  />
                  <span class="sg-fit-preference-title-row">
                    <span class="hat-length-picker__option-label">Close fit</span>
                    <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                  </span>
                  <span class="sg-fit-preference-note">Fits close to the body.</span>
                  <span class="sg-fit-preference-ease">Approx. +1&quot; ease</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option sg-fit-preference-option"
                  data-choice
                  data-field="fit"
                  data-value="standard"
                  aria-pressed="false"
                >
                  <img
                    class="fit-card-image"
                    src="/images/pattern/fit-standard.jpg"
                    alt="Standard fit sleeveless garment"
                  />
                  <span class="sg-fit-preference-title-row">
                    <span class="hat-length-picker__option-label">Standard fit</span>
                    <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                  </span>
                  <span class="sg-fit-preference-note">Comfortable everyday fit.</span>
                  <span class="sg-fit-preference-ease">Approx. +3&quot; ease</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option sg-fit-preference-option"
                  data-choice
                  data-field="fit"
                  data-value="relaxed"
                  aria-pressed="false"
                >
                  <img
                    class="fit-card-image"
                    src="/images/patterns/fit-relaxed.jpg"
                    alt="Relaxed fit sleeveless garment"
                  />
                  <span class="sg-fit-preference-title-row">
                    <span class="hat-length-picker__option-label">Relaxed fit</span>
                    <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                  </span>
                  <span class="sg-fit-preference-note">More room and drape.</span>
                  <span class="sg-fit-preference-ease">Approx. +6&quot; ease</span>
                </button>
              </div>
            </div>
          </section>

          <!-- Step 5 -->
          <section
            class="express-acc express-acc--locked scroll-mt-[96px]"
            id="express-gauge-section"
            data-express-step="5"
            data-express-field="gauge"
          >
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="-1"
              aria-expanded="false"
              aria-controls="express-acc-panel-5"
              id="express-acc-label-5"
            >
              <button type="button" class="express-acc__chevron" data-express-chevron aria-hidden="true" tabindex="-1">
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__step" aria-hidden="true">5</span>
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <div class="express-acc__title-row express-acc__title-row--gauge">
                  <h2 class="express-acc__title" id="express-step-5-title">Enter your gauge</h2>
                  <span class="express-acc__title-glossary">
                    <GlossaryTooltip id={616}>Gauge</GlossaryTooltip>
                  </span>
                </div>
                <span class="express-acc__value" data-express-summary="gauge"></span>
              </div>
            </div>
            <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
              <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
              <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
            </p>
            <div
              class="express-acc__body"
              id="express-acc-panel-5"
              role="region"
              aria-labelledby="express-step-5-title"
              hidden
            >
              <form class="express-gauge" id="express-gauge-form" novalidate>
                <div class="express-gauge-intro-group">
                  <p class="express-gauge-intro">
                    Enter the gauge from your swatch over 4 inches / 10 cm.
                  </p>
                  <div class="express-gauge-help">
                    <button
                      type="button"
                      class="kbm-kin-catalog-video express-gauge-help-link"
                      data-vimeo-id="1046394794"
                      data-video-title="How to Knit a Proper Swatch: The Secret to Machine Knitting Success"
                    >
                      <span class="express-gauge-help-icon" aria-hidden="true">
                        <i class="fa-solid fa-circle-play"></i>
                      </span>
                      <span class="express-gauge-help-label">Watch how to knit a proper swatch.</span>
                    </button>
                  </div>
                </div>
                <div class="express-gauge-fields">
                  <div class="express-gauge-pair">
                    <GaugeInput
                      id="express"
                      flatRow={true}
                      showTitle={false}
                      showGaugeSubLabel={false}
                      showToggle={false}
                      toggleId="sleeveless-fit"
                      stitchLabelInches='Stitch gauge — sts / 4"'
                      stitchLabelCm="Stitch gauge — sts / 10 cm"
                      rowLabelInches='Row gauge — rows / 4"'
                      rowLabelCm="Row gauge — rows / 10 cm"
                    />
                  </div>
                  <div class="express-needle-block">
                    <div class="express-needle-label-row">
                      <label for="express-available-needles" class="express-needle-label">
                        Available needles
                      </label>
                    </div>
                    <p class="express-needle-label">
                      Used to check whether your pattern pieces will fit on your machine.
                    </p>
                    <div class="express-needle-input-group">
                      <input
                        type="number"
                        id="express-available-needles"
                        class="express-needle-input"
                        name="availableNeedles"
                        min="1"
                        step="1"
                        inputmode="numeric"
                        value="150"
                        required
                        data-testid="input-express-available-needles"
                      />
                      <span class="express-needle-suffix" aria-hidden="true">needles</span>
                    </div>
                  </div>
                </div>
              </form>
            </div>
            <!-- Submit lives outside collapsible .express-acc__body so it stays visible when Gauge is closed (see updateGeneratePatternAvailability). -->
            <div class="express-generate-wrap express-generate-wrap--footer" id="express-generate-wrap" hidden>
              <p class="express-generate-cta__helper">Your selections are ready to review.</p>
              <button type="submit" form="express-gauge-form" class="express-generate" id="express-generate">
                Review My Pattern
              </button>
            </div>
          </section>
                </div>
        </div>
            </div>
          </div>
      </div>
    </div>

    <dialog
      id="express-fit-help-dialog"
      class="fit-help-dialog"
      aria-labelledby="express-fit-help-title"
    >
      <div class="fit-help-dialog__shell">
        <div class="fit-help-dialog__header">
          <h2 id="express-fit-help-title" class="fit-help-dialog__title">
            Not Sure Which Fit to Choose?
          </h2>
          <button
            type="button"
            class="fit-help-dialog__close"
            data-fit-help-close
            aria-label="Close fit help"
          >
            ✕
          </button>
        </div>
        <div class="fit-help-dialog__body">
          <article class="fit-help-article">
            <p class="fit-help-article__lede">
              One of the most confusing terms in knitting patterns is <strong>ease</strong>.
            </p>

            <div class="fit-help-ease">
              <div class="fit-help-ease__text">
                <p>
                  Ease is simply the difference between your body measurement and the finished
                  measurement of the garment.
                </p>
                <p>
                  For example, if your bust measures 40&quot; and the finished sweater measures
                  44&quot;, the sweater has 4&quot; of positive ease.
                </p>
              </div>
              <div class="fit-help-ease__media">
                <img
