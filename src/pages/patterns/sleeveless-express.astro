---
import Layout from "../../layouts/Layout.astro";
import GaugeInput from "../../components/wizards/GaugeInput.astro";
import UnitToggle from "../../components/wizards/UnitToggle.astro";
import PatternTabs from "../../components/patterns/PatternTabs.astro";
import PatternModeIndicator from "../../components/patterns/PatternModeIndicator.astro";
import PatternComments from "../../components/patterns/PatternComments.astro";
/* Wizard is @import'd first inside sleeveless-express-builder-cards.css so Express overrides always win cascade */
import "../../styles/sleeveless-express-builder-cards.css";

/** Top tabs: open Pattern panel when arriving with `?tab=pattern`. */
const initialPatternSubTab = Astro.url.searchParams.get("tab") === "pattern" ? "pattern" : "build";

const expressNavSteps = [
  { step: 1, label: "Who" },
  { step: 2, label: "Style" },
  { step: 3, label: "Neckline" },
  { step: 4, label: "Fit" },
  { step: 5, label: "Gauge" },
] as const;
---

<Layout
  title="Express Pattern | Sleeveless Sweater"
  description="Create a ready-to-knit sleeveless sweater pattern in quick steps."
>
  <main class="express-page wizard-page sleeveless-express-page" data-express-page="sleeveless-express">
    <div id="express-pattern-top" class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternTabs
          rootClass="pattern-tabs-scope"
          defaultTab={initialPatternSubTab}
          managePatternReadiness={true}
          patternInitiallyReady={false}
        >
          <div slot="build" class="sg-tab-build">
            <div class="sg-builder-nav-row express-builder-nav-row no-print">
              <nav class="sg-builder-nav" aria-label="Express steps">
                <ol class="sg-builder-nav__list" role="list">
                  {
                    expressNavSteps.map((s, i) => (
                      <li class:list={["sg-builder-nav__item", { active: s.step === 1 }]}>
                        {i > 0 && <span class="sg-builder-nav__rule" aria-hidden="true" />}
                        <button
                          type="button"
                          class:list={[
                            "sg-builder-nav__link",
                            {
                              "is-current": s.step === 1,
                              "is-upcoming": s.step > 1,
                            },
                          ]}
                          data-pill-step={s.step}
                          data-pill-label={s.label}
                          aria-current={s.step === 1 ? "page" : undefined}
                          aria-disabled={s.step > 1 ? "true" : undefined}
                          title={s.step > 1 ? "Finish the previous step to continue." : undefined}
                        >
                          <span class="sg-builder-nav__pill">
                            <span class="express-pill__check" aria-hidden="true">
                              ✓
                            </span>
                            <span class="express-pill__label">{s.label}</span>
                          </span>
                        </button>
                      </li>
                    ))
                  }
                </ol>
              </nav>
            </div>

            <header class="pattern-header page-header">
              <p class="pattern-mode-label">Express Pattern</p>
              <h1 class="pattern-title">Sleeveless Sweater</h1>
              <p class="pattern-subtext">
                Create a ready-to-knit sweater pattern in just a few quick steps.
              </p>
              <p class="express-alt-path no-print">
                <strong>Need more control?</strong>
                Switch to the <a href="/patterns/sleeveless-custom">Custom Builder</a> for exact measurements and detailed shaping.
                <span class="text-muted">Your choices can carry over.</span>
              </p>
            </header>

            <PatternModeIndicator mode="express" integratedCard cardClass="express-panel">
              <div class="express-builder-root" data-express-builder>
                <div class="express-builder-toolbar no-print">
                  <button type="button" id="express-start-over-btn" class="btn btn-outline-secondary btn-sm">
                    Start over
                  </button>
                </div>
                <div class="express-builder-units no-print">
                  <UnitToggle id="sleeveless" />
                </div>
                <div class="express-accordions" id="express-accordions">
          <!-- Step 1 -->
          <section
            class="express-acc express-acc--open"
            data-express-step="1"
            data-express-field="who"
          >
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="0"
              aria-expanded="true"
              aria-controls="express-acc-panel-1"
              id="express-acc-label-1"
            >
              <button
                type="button"
                class="express-acc__chevron"
                data-express-chevron
                aria-label="Toggle who you are knitting for"
                tabindex="-1"
              >
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <h2 class="express-acc__title" id="express-step-1-title">Who are you knitting for?</h2>
                <span class="express-acc__value" data-express-summary="who"></span>
              </div>
            </div>
            <div
              class="express-acc__body"
              id="express-acc-panel-1"
              role="region"
              aria-labelledby="express-step-1-title"
            >
              <div class="express-options express-options--who" role="group" aria-labelledby="express-step-1-title">
                <button type="button" class="express-option" data-choice data-field="who" data-value="women">
                  Women
                </button>
                <button type="button" class="express-option" data-choice data-field="who" data-value="men">
                  Men
                </button>
                <button type="button" class="express-option" data-choice data-field="who" data-value="kids">
                  Kids
                </button>
                <button type="button" class="express-option" data-choice data-field="who" data-value="baby">
                  Baby
                </button>
              </div>

              <div class="express-who-size-nested" data-express-nested-size hidden>
                <h3 class="express-who-size-heading" id="express-step-1-size-heading">Choose a size</h3>
                <p class="express-size-helper sg-fit-size-copy">
                  Choose the size closest to your body measurement.
                </p>
                <p class="express-size-load-msg sg-fit-size-copy" data-express-size-status>
                  Loading size charts…
                </p>
                <div class="express-size-select-wrap" data-express-size-select-wrap hidden>
                  <label for="express-body-size-select" class="sr-only">
                    Choose body size (includes bust or chest measurement)
                  </label>
                  <select
                    id="express-body-size-select"
                    class="express-size-select"
                    data-express-size-select
                    autocomplete="off"
                  ></select>
                </div>
              </div>
            </div>
          </section>

          <!-- Step 2 -->
          <section class="express-acc express-acc--locked" data-express-step="2" data-express-field="style">
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="-1"
              aria-expanded="false"
              aria-controls="express-acc-panel-2"
              id="express-acc-label-2"
            >
              <button type="button" class="express-acc__chevron" data-express-chevron aria-hidden="true" tabindex="-1">
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <h2 class="express-acc__title" id="express-step-2-title">Choose your style</h2>
                <span class="express-acc__value" data-express-summary="style"></span>
              </div>
            </div>
            <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
              <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
              <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
            </p>
            <div
              class="express-acc__body"
              id="express-acc-panel-2"
              role="region"
              aria-labelledby="express-step-2-title"
              hidden
            >
              <div class="express-style-design" role="group" aria-labelledby="express-step-2-title">
                <div class="express-style-block">
                  <div
                    class="express-options express-options--front-toggle"
                    role="radiogroup"
                    aria-label="Pullover or cardigan"
                    data-express-front-toggle
                  >
                    <button
                      type="button"
                      class="express-option"
                      data-choice
                      data-field="front"
                      data-value="closed"
                      aria-pressed="false"
                    >
                      Pullover
                    </button>
                    <button
                      type="button"
                      class="express-option sg-option is-coming-next sg-express-kin-locked"
                      data-field="front"
                      data-value="open"
                      disabled
                      aria-disabled="true"
                      aria-pressed="false"
                      aria-label="Cardigan (Custom Pattern)"
                    >
                      <div class="locked-card-ribbon locked-card-ribbon--pill-swatch" aria-hidden="true"></div>
                      <span class="sg-express-kin-locked__body sg-express-kin-locked__body--pill">Cardigan</span>
                    </button>
                  </div>
                  <h3 id="express-step-2-shape-heading" class="express-style-block__title express-style-block__title--after-toggle">
                    Choose your sweater shape
                  </h3>
                  <div
                    class="hat-length-picker__grid sg-shape-grid"
                    role="radiogroup"
                    aria-labelledby="express-step-2-shape-heading"
                    data-express-shape-grid
                  >
                    <button
                      type="button"
                      class="hat-length-picker__option"
                      data-choice
                      data-field="shape"
                      data-value="straight"
                      aria-pressed="false"
                    >
                      <img
                        src="/images/patterns/sleeveless/shape-straight.svg"
                        alt=""
                        class="hat-length-picker__img sg-picker-img"
                        width="120"
                        height="120"
                        loading="lazy"
                        decoding="async"
                        data-express-shape-img="straight"
                      />
                      <span class="sg-shape-card-title-row">
                        <span class="hat-length-picker__option-label">Straight</span>
                        <span class="sg-shape-option-check" aria-hidden="true">✓</span>
                      </span>
                    </button>
                    <button
                      type="button"
                      class="hat-length-picker__option sg-option is-coming-next sg-express-kin-locked"
                      disabled
                      aria-disabled="true"
                      aria-pressed="false"
                      aria-label="A-line sweater shape (Custom Pattern)"
                    >
                      <div class="locked-card-ribbon" aria-hidden="true">
                        <img
                          src="/images/patterns/stripe.svg"
                          alt=""
                          width="48"
                          height="181"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <span class="sg-express-kin-locked__body">
                        <img
                          src="/images/patterns/sleeveless/shape-aline.svg"
                          alt=""
                          class="hat-length-picker__img sg-picker-img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                          data-express-shape-img="aline"
                        />
                        <span class="hat-length-picker__option-label">A-line</span>
                      </span>
                    </button>
                    <button
                      type="button"
                      class="hat-length-picker__option sg-option is-coming-next sg-express-kin-locked"
                      disabled
                      aria-disabled="true"
                      aria-pressed="false"
                      aria-label="Waist shaped sweater (Custom Pattern)"
                    >
                      <div class="locked-card-ribbon" aria-hidden="true">
                        <img
                          src="/images/patterns/stripe.svg"
                          alt=""
                          width="48"
                          height="181"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <span class="sg-express-kin-locked__body">
                        <img
                          src="/images/patterns/sleeveless/shape-fitted.svg"
                          alt=""
                          class="hat-length-picker__img sg-picker-img"
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                          data-express-shape-img="waist"
                        />
                        <span class="hat-length-picker__option-label">Waist Shaped</span>
                      </span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Step 3 -->
          <section class="express-acc express-acc--locked" data-express-step="3" data-express-field="neckline">
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="-1"
              aria-expanded="false"
              aria-controls="express-acc-panel-3"
              id="express-acc-label-3"
            >
              <button type="button" class="express-acc__chevron" data-express-chevron aria-hidden="true" tabindex="-1">
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <h2 class="express-acc__title" id="express-step-3-title">Choose your neckline</h2>
                <span class="express-acc__value" data-express-summary="neckline"></span>
              </div>
            </div>
            <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
              <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
              <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
            </p>
            <div
              class="express-acc__body"
              id="express-acc-panel-3"
              role="region"
              aria-labelledby="express-step-3-title"
              hidden
            >
              <div
                class="express-neck-cards hat-length-picker__grid hat-brim-picker__grid"
                role="group"
                aria-labelledby="express-step-3-title"
              >
                <button
                  type="button"
                  class="hat-length-picker__option"
                  data-choice
                  data-field="neckline"
                  data-value="round"
                  aria-pressed="false"
                >
                  <img
                    src="/images/patterns/sleeveless/neck-round.svg"
                    alt=""
                    class="hat-length-picker__img sg-picker-img"
                    width="120"
                    height="120"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hat-length-picker__option-label">Round</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option sg-option is-coming-next sg-express-kin-locked express-neckline-vneck-locked"
                  disabled
                  aria-disabled="true"
                  aria-pressed="false"
                  aria-label="V-neck (Custom Pattern)"
                >
                  <div class="custom-builder-stripe" aria-hidden="true"></div>
                  <span class="sg-express-kin-locked__body">
                    <img
                      src="/images/patterns/sleeveless/neck-v.svg"
                      alt=""
                      class="hat-length-picker__img sg-picker-img"
                      width="120"
                      height="120"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="hat-length-picker__option-label">V-neck</span>
                  </span>
                </button>
              </div>
            </div>
          </section>

          <!-- Step 4 -->
          <section class="express-acc express-acc--locked" data-express-step="4" data-express-field="fit">
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="-1"
              aria-expanded="false"
              aria-controls="express-acc-panel-4"
              id="express-acc-label-4"
            >
              <button type="button" class="express-acc__chevron" data-express-chevron aria-hidden="true" tabindex="-1">
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <h2 class="express-acc__title" id="express-step-4-title">Choose your fit</h2>
                <span class="express-acc__value" data-express-summary="fit"></span>
              </div>
            </div>
            <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
              <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
              <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
            </p>
            <div
              class="express-acc__body"
              id="express-acc-panel-4"
              role="region"
              aria-labelledby="express-step-4-title"
              hidden
            >
              <div
                class="express-fit-cards hat-length-picker__grid sg-fit-preference-grid"
                role="group"
                aria-labelledby="express-step-4-title"
              >
                <button
                  type="button"
                  class="hat-length-picker__option sg-fit-preference-option"
                  data-choice
                  data-field="fit"
                  data-value="close"
                  aria-pressed="false"
                >
                  <img
                    class="fit-card-image"
                    src="/images/patterns/sleeveless/close-fit.png"
                    alt="Close fit sleeveless garment"
                  />
                  <span class="sg-fit-preference-title-row">
                    <span class="hat-length-picker__option-label">Close fit</span>
                    <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                  </span>
                  <span class="sg-fit-preference-note">Fits close to the body.</span>
                  <span class="sg-fit-preference-ease">Approx. +1&quot; ease</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option sg-fit-preference-option"
                  data-choice
                  data-field="fit"
                  data-value="standard"
                  aria-pressed="false"
                >
                  <img
                    class="fit-card-image"
                    src="/images/patterns/sleeveless/standard-fit.png"
                    alt="Standard fit sleeveless garment"
                  />
                  <span class="sg-fit-preference-title-row">
                    <span class="hat-length-picker__option-label">Standard fit</span>
                    <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                  </span>
                  <span class="sg-fit-preference-note">Comfortable everyday fit.</span>
                  <span class="sg-fit-preference-ease">Approx. +3&quot; ease</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option sg-fit-preference-option"
                  data-choice
                  data-field="fit"
                  data-value="relaxed"
                  aria-pressed="false"
                >
                  <img
                    class="fit-card-image"
                    src="/images/patterns/sleeveless/relaxed-fit.png"
                    alt="Relaxed fit sleeveless garment"
                  />
                  <span class="sg-fit-preference-title-row">
                    <span class="hat-length-picker__option-label">Relaxed fit</span>
                    <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                  </span>
                  <span class="sg-fit-preference-note">More room and drape.</span>
                  <span class="sg-fit-preference-ease">Approx. +6&quot; ease</span>
                </button>
              </div>
            </div>
          </section>

          <!-- Step 5 -->
          <section class="express-acc express-acc--locked" data-express-step="5" data-express-field="gauge">
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="-1"
              aria-expanded="false"
              aria-controls="express-acc-panel-5"
              id="express-acc-label-5"
            >
              <button type="button" class="express-acc__chevron" data-express-chevron aria-hidden="true" tabindex="-1">
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <h2 class="express-acc__title" id="express-step-5-title">Enter your gauge</h2>
                <span class="express-acc__value" data-express-summary="gauge"></span>
              </div>
            </div>
            <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
              <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
              <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
            </p>
            <div
              class="express-acc__body"
              id="express-acc-panel-5"
              role="region"
              aria-labelledby="express-step-5-title"
              hidden
            >
              <form class="express-gauge" id="express-gauge-form" novalidate>
                <p class="express-gauge-intro">
                  Enter the gauge from your swatch over 4 inches / 10 cm. We’ll use the same stitch and row math as the
                  full pattern builder.
                </p>
                <div class="express-gauge-units-row no-print">
                  <UnitToggle id="sleeveless" buttonSuffix="gauge" class="units-toggle--express-gauge" />
                </div>
                <div class="express-gauge-block">
                  <GaugeInput
                    id="express"
                    showTitle={false}
                    showGaugeSubLabel={false}
                    showToggle={false}
                    toggleId="sleeveless"
                    stitchLabelInches='Stitch gauge — stitches over 4"'
                    stitchLabelCm="Stitch gauge — stitches over 10 cm"
                    rowLabelInches='Row gauge — rows over 4"'
                    rowLabelCm="Row gauge — rows over 10 cm"
                  />
                </div>
                <div class="express-generate-wrap" id="express-generate-wrap" hidden>
                  <button type="submit" class="express-generate" id="express-generate">Generate Pattern</button>
                </div>
              </form>
            </div>
          </section>
                </div>
        </div>
            </PatternModeIndicator>
          </div>

          <div slot="pattern" class="sg-tab-pattern express-tab-pattern"></div>

          <div slot="share" class="sg-tab-share">
            <p class="sg-tab-share__intro">Ask questions or share your results.</p>
            <PatternComments />
          </div>

          <div slot="inspiration" class="sg-tab-inspiration">
            <div class="inspiration-section">
              <h3 class="inspiration-heading">Get inspired</h3>
              <div class="pinterest-embed">
                <a
                  data-pin-do="embedBoard"
                  data-pin-board-width="100%"
                  data-pin-scale-height="900"
                  data-pin-scale-width="80"
                ></a>
              </div>
              <p class="hat-pinterest-fallback-link">
                <a
                  href="https://www.pinterest.com/knititnow/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Open machine knitting inspiration on Pinterest
                </a>
              </p>
            </div>
          </div>
        </PatternTabs>
      </div>
    </div>
  </main>
</Layout>

<style>
  .express-page {
    --express-terracotta: #c2614e;
    --sg-accent: #c2614e;
    --accent-color: var(--sg-accent);
    --express-muted: rgba(0, 0, 0, 0.45);
    --express-nav-green: var(--kbm-green, #52682d);
    padding-top: 0;
    padding-bottom: 2rem;
  }

  .express-wizard {
    max-width: 1000px;
  }

  .pattern-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .pattern-header.page-header {
    margin-bottom: 1.5rem;
    padding: 0 0.5rem;
  }

  .pattern-mode-label {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .pattern-title {
    font-size: 2rem;
    font-weight: 600;
    color: var(--kbm-green, #52682d);
    margin: 0 0 8px;
  }

  .pattern-subtext {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--express-muted);
    max-width: 36rem;
    margin-inline: auto;
  }

  .express-panel.calculator-card:not(.pattern-mode-layout--integrated) {
    margin-bottom: 0;
    padding: 1.35rem 1.25rem 1.5rem;
  }

  @media (min-width: 640px) {
    .express-panel.calculator-card:not(.pattern-mode-layout--integrated) {
      padding: 1.5rem 1.75rem 1.75rem;
    }
  }

  /* Express step nav: same structure/styles as SleevelessBuilderNav; wider row than wizard default (800px) */
  .express-page .express-builder-nav-row.sg-builder-nav-row {
    max-width: 920px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 1.35rem;
  }

  .express-alt-path {
    margin: 16px 0 20px;
    font-size: 0.95rem;
    color: #555;
    text-align: left;
  }

  .express-alt-path .text-muted {
    color: var(--text-muted, #6b7280);
  }

  .express-alt-path a {
    color: var(--accent-color);
    font-weight: 500;
    text-decoration: underline;
  }

  .express-page .express-builder-nav-row .express-pill__check {
    display: none;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    color: var(--kbm-green, #52682d);
  }

  .express-page .express-builder-nav-row .sg-builder-nav__link.is-complete:not(.is-current) .express-pill__check {
    display: inline;
  }

