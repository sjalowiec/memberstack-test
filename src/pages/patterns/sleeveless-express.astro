<script>
  // Fit help article modal (Step 4). Native <dialog> handles Esc + focus trap; the open button
  // lives inside the accordion header (role="button"), so stop propagation to avoid toggling the step.
  const fitHelpDialog = document.getElementById("express-fit-help-dialog");
  if (fitHelpDialog instanceof HTMLDialogElement) {
    const openBtn = document.querySelector("[data-fit-help-open]");
    const closeBtn = fitHelpDialog.querySelector("[data-fit-help-close]");
    let lastFocused: HTMLElement | null = null;

    openBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      fitHelpDialog.showModal();
      if (closeBtn instanceof HTMLElement) closeBtn.focus();
    });

    openBtn?.addEventListener("keydown", (e) => {
      if (e instanceof KeyboardEvent && (e.key === "Enter" || e.key === " ")) {
        e.stopPropagation();
      }
    });

    closeBtn?.addEventListener("click", () => fitHelpDialog.close());

    fitHelpDialog.addEventListener("click", (e) => {
      if (e.target === fitHelpDialog) fitHelpDialog.close();
    });

    fitHelpDialog.addEventListener("close", () => {
      if (lastFocused) lastFocused.focus();
    });
  }
</script>
