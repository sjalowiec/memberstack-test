---
import Layout from '../../layouts/Layout.astro';
import PatternsMarketingHero from '../../components/patterns/PatternsMarketingHero.astro';
import PatternsFeaturesSection from '../../components/patterns/PatternsFeaturesSection.astro';
import PatternBuilderMyPatternsLink from '../../components/patterns/PatternBuilderMyPatternsLink.astro';
import { PATTERN_CATALOG_HREF } from '../../lib/patterns/customPatternProjectNavigation';
---

<Layout title="Pattern Builders">

    <div class="patterns-page">

        <nav class="patterns-action-bar" aria-label="Pattern builder actions">
          <a href={PATTERN_CATALOG_HREF} class="patterns-action-bar__primary kbm-btn kbm-btn-accent">
            Choose a Pattern
          </a>
          <PatternBuilderMyPatternsLink />
        </nav>

        <PatternsMarketingHero />

        <PatternsFeaturesSection
          headingId="patterns-builders-features-heading"
          title="Why These Pattern Builders Are Different"
        />

  </div>

</Layout>

<style>
.patterns-page {
  max-width: 1000px;
  margin: 0 auto;
  padding: 20px;
}

.patterns-action-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin: 0 0 20px;
}

.patterns-action-bar__primary {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 14rem;
  min-height: 3.25rem;
  padding: 0.85rem 1.25rem;
  margin: 0;
  font-size: 1.05rem;
  font-weight: 600;
  text-align: center;
  text-decoration: none;
}
</style>
