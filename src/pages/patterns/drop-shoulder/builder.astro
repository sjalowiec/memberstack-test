---
import Layout from "../../../layouts/Layout.astro";
import SleevelessPatternMemberGate from "../../../components/patterns/SleevelessPatternMemberGate.astro";
import PatternBuilderMyPatternsLink from "../../../components/patterns/PatternBuilderMyPatternsLink.astro";
import ExpressBuilderWhoSizeSection from "../../../components/patterns/ExpressBuilderWhoSizeSection.astro";
import GlossaryTooltip from "../../../components/common/GlossaryTooltip.astro";
import GaugeInput from "../../../components/wizards/GaugeInput.astro";
import UnitToggle from "../../../components/wizards/UnitToggle.astro";
import FloatingInput from "../../../components/lego/FloatingInput.astro";
import {
  AVAILABLE_NEEDLES_HELPER_TEXT,
  AVAILABLE_NEEDLES_LABEL,
  AVAILABLE_NEEDLES_REQUIRED_MESSAGE,
} from "../../../lib/patterns/sleevelessExpressAvailableNeedles";
import { formatFitEaseApproxLabel } from "../../../lib/patterns/fitEaseInches";
import { buildSweaterSizingChartHref } from "../../../lib/reference/sweaterSizingChartNavigation";

const sweaterSizingChartHref = buildSweaterSizingChartHref("/patterns/drop-shoulder/builder");
/* Wizard is @import'd first inside sleeveless-express-builder-cards.css so Express overrides always win cascade */
import "../../../styles/sleeveless-express-builder-cards.css";
import "../../../styles/sleeveless-express-wizard-layout.css";
import "../../../styles/express-size-selection.css";
import "../../../styles/custom-pattern-editing-banner.css";

/*
 * Drop Shoulder builder — reuses the sleeveless Express wizard client + the sleeveless
 * review/pattern flow. The construction flag (style.construction = "drop-shoulder") and the
 * sleeve direction default are written by `drop-shoulder-builder-page.ts`; the pattern generator
 * branches on that flag (see dropShoulderPatternOutput.ts).
 */
const expressNavSteps = [
  { step: 1, label: "Who & Size" },
  { step: 2, label: "Style" },
  { step: 3, label: "Fit" },
  { step: 4, label: "Sleeve Length" },
  { step: 5, label: "Gauge" },
] as const;

const imgGarmentPullover = "/images/patterns/drop-shoulder/picker/drop-pullover-round.webp";
const imgGarmentCardigan = "/images/patterns/drop-shoulder/picker/drop-cardigan-round.webp";
---

<Layout
  title="Drop Shoulder Pattern Builder"
  description="Create a ready-to-knit drop shoulder sweater pattern in guided steps."
>
  <SleevelessPatternMemberGate>
  <main
    class="express-page wizard-page sleeveless-express-page sleeveless-unified-builder-page drop-shoulder-builder-page"
    data-express-page="drop-shoulder-builder"
    data-express-construction="drop-shoulder"
    data-express-review-href="/patterns/drop-shoulder/pattern/?generated=1"
  >
    <div id="express-pattern-top" class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <div class="sg-tab-build">
            <div class="sg-builder-nav-row express-builder-nav-row no-print">
              <nav class="express-step-nav sg-builder-nav" aria-label="Drop shoulder pattern steps">
                <ol class="express-step-nav__list sg-builder-nav__list" role="list">
                  {
                    expressNavSteps.map((s, i) => (
                      <li class:list={["express-step-nav__item", "sg-builder-nav__item", { active: s.step === 1 }]}>
                        <button
                          type="button"
                          class:list={[
                            "express-step-nav__btn",
                            "sg-builder-nav__link",
                            {
                              "is-current": s.step === 1,
                              "is-upcoming": s.step > 1,
                            },
                          ]}
                          data-pill-step={s.step}
                          data-pill-label={s.label}
                          aria-current={s.step === 1 ? "page" : undefined}
                          aria-disabled={s.step > 1 ? "true" : undefined}
                          title={s.step > 1 ? "Finish the previous step to continue." : undefined}
                        >
                          <span class="express-step-nav__track">
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--before",
                                { "express-step-nav__seg--empty": i === 0 },
                              ]}
                              aria-hidden="true"
                            />
                            <span class="express-step-nav__circle">
                              <span class="express-step-nav__num">{s.step}</span>
                              <span class="express-pill__check" aria-hidden="true">
                                ✓
                              </span>
                            </span>
                            <span
                              class:list={[
                                "express-step-nav__seg",
                                "express-step-nav__seg--after",
                                { "express-step-nav__seg--empty": i === expressNavSteps.length - 1 },
                              ]}
                              aria-hidden="true"
                            />
                          </span>
                          <span class="express-step-nav__label">{s.label}</span>
                        </button>
                      </li>
                    ))
                  }
                </ol>
              </nav>
            </div>

            <header class="pattern-header page-header">
              <div class="pattern-header__title-row">
                <h1 class="pattern-title">Drop Shoulder Sweater</h1>
                <PatternBuilderMyPatternsLink />
              </div>
              <p class="pattern-subtext">
                Create a ready-to-knit drop shoulder sweater pattern in a few guided steps.
              </p>
            </header>
            <div data-cb-editing-banner-host hidden></div>

            <div class="express-panel">
              <div class="express-builder-root" data-express-builder>
                <div class="express-builder-toolbar no-print">
                  <button type="button" id="express-start-over-btn" class="btn btn-outline-secondary btn-sm">
                    Start over
                  </button>
                </div>
                <div class="express-builder-units no-print">
                  <UnitToggle id="sleeveless-fit" />
                </div>
                <div class="express-accordions" id="express-accordions">
          <!-- Step 1 — Who + Size -->
          <section
            class="express-acc express-acc--open"
            data-express-step="1"
            data-express-field="who"
          >
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="0"
              aria-expanded="true"
              aria-controls="express-acc-panel-1"
              id="express-acc-label-1"
            >
              <button
                type="button"
                class="express-acc__chevron"
                data-express-chevron
                aria-label="Toggle who and size choices"
                tabindex="-1"
              >
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <h2 class="express-acc__title" id="express-step-1-title">Who & Size</h2>
                <span class="express-acc__value" data-express-summary="who"></span>
                <span class="express-acc__value" data-express-summary="selectedSize"></span>
              </div>
            </div>
            <div
              class="express-acc__body"
              id="express-acc-panel-1"
              role="region"
              aria-labelledby="express-step-1-title"
            >
              <div
                class="express-options--who hat-length-picker__grid"
                role="group"
                aria-labelledby="express-step-1-title"
              >
                <button
                  type="button"
                  class="hat-length-picker__option express-who-card"
                  data-choice
                  data-field="who"
                  data-value="women"
                  aria-pressed="false"
                >
                  <img
                    src="/images/patterns/drop-shoulder/drop-woman-pullover-round.webp"
                    alt=""
                    class="hat-length-picker__img sg-picker-img express-who-card__img"
                    width="168"
                    height="210"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hat-length-picker__option-label">Women</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option express-who-card"
                  data-choice
                  data-field="who"
                  data-value="men"
                  aria-pressed="false"
                >
                  <img
                    src="/images/patterns/drop-shoulder/drop-man-pullover-round.webp"
                    alt=""
                    class="hat-length-picker__img sg-picker-img express-who-card__img"
                    width="168"
                    height="210"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hat-length-picker__option-label">Men</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option express-who-card"
                  data-choice
                  data-field="who"
                  data-value="kids"
                  aria-pressed="false"
                >
                  <img
                    src="/images/patterns/drop-shoulder/drop-kids-pullover-round.webp"
                    alt=""
                    class="hat-length-picker__img sg-picker-img express-who-card__img"
                    width="168"
                    height="210"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hat-length-picker__option-label">Kids</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option express-who-card"
                  data-choice
                  data-field="who"
                  data-value="baby"
                  aria-pressed="false"
                >
                  <img
                    src="/images/patterns/drop-shoulder/drop-baby-pullover-round.webp"
                    alt=""
                    class="hat-length-picker__img sg-picker-img express-who-card__img"
                    width="168"
                    height="210"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hat-length-picker__option-label">Baby</span>
                </button>
              </div>
              <ExpressBuilderWhoSizeSection sweaterSizingChartHref={sweaterSizingChartHref} />
            </div>
          </section>

          <!-- Step 2 — style (front + neckline) -->
          <section
            class="express-acc express-acc--locked"
            data-express-step="2"
            data-express-field="front neckline"
          >
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="-1"
              aria-expanded="false"
              aria-controls="express-acc-panel-2"
              id="express-acc-label-2"
            >
              <button type="button" class="express-acc__chevron" data-express-chevron aria-hidden="true" tabindex="-1">
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <h2 class="express-acc__title" id="express-step-2-title">Choose your style</h2>
                <span class="express-acc__value" data-express-summary="frontNeckline"></span>
              </div>
            </div>
            <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
              <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
              <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
            </p>
            <div
              class="express-acc__body"
              id="express-acc-panel-2"
              role="region"
              aria-labelledby="express-step-2-title"
              hidden
            >
              <div class="express-style-group">
                <p class="express-style-sublabel" id="express-front-sublabel">Front style</p>
                <div
                  class="express-front-cards hat-length-picker__grid hat-brim-picker__grid"
                  role="radiogroup"
                  aria-labelledby="express-front-sublabel"
                >
                  <button
                    type="button"
                    class="hat-length-picker__option is-selected"
                    data-choice
                    data-field="front"
                    data-value="closed"
                    aria-pressed="true"
                  >
                    <span class="express-front-card__img-wrap">
                      <img
                        src={imgGarmentPullover}
                        alt=""
                        class="hat-length-picker__img sg-picker-img express-front-card__img"
                        width="433"
                        height="469"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <span class="hat-length-picker__option-label">Pullover</span>
                  </button>
                  <button
                    type="button"
                    class="hat-length-picker__option"
                    data-choice
                    data-field="front"
                    data-value="open"
                    aria-pressed="false"
                  >
                    <span class="express-front-card__img-wrap">
                      <img
                        src={imgGarmentCardigan}
                        alt=""
                        class="hat-length-picker__img sg-picker-img express-front-card__img"
                        width="433"
                        height="469"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <span class="hat-length-picker__option-label">Cardigan</span>
                  </button>
                </div>
              </div>
              <div class="express-style-group">
                <p class="express-style-sublabel" id="express-neck-sublabel">Neckline</p>
                <div
                  class="express-neck-cards hat-length-picker__grid hat-brim-picker__grid"
                  role="group"
                  aria-labelledby="express-neck-sublabel"
                >
                  <button
                    type="button"
                    class="hat-length-picker__option"
                    data-choice
                    data-field="neckline"
                    data-value="round"
                    aria-pressed="false"
                  >
                    <img
                      src="/images/patterns/drop-shoulder/picker/drop-round.webp"
                      alt=""
                      class="hat-length-picker__img sg-picker-img"
                      width="120"
                      height="120"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="hat-length-picker__option-label">Round</span>
                  </button>
                  <button
                    type="button"
                    class="hat-length-picker__option"
                    data-choice
                    data-field="neckline"
                    data-value="v-neck"
                    aria-pressed="false"
                  >
                    <img
                      src="/images/patterns/drop-shoulder/picker/v-neck.webp"
                      alt=""
                      class="hat-length-picker__img sg-picker-img"
                      width="120"
                      height="120"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="hat-length-picker__option-label">V-neck</span>
                  </button>
                </div>
              </div>
            </div>
          </section>

          <!-- Step 3 — fit -->
          <section class="express-acc express-acc--locked" data-express-step="3" data-express-field="fit">
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="-1"
              aria-expanded="false"
              aria-controls="express-acc-panel-3"
              id="express-acc-label-3"
            >
              <button type="button" class="express-acc__chevron" data-express-chevron aria-hidden="true" tabindex="-1">
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <h2 class="express-acc__title" id="express-step-3-title">Choose a starting fit</h2>
                <span class="express-acc__value" data-express-summary="fit"></span>
              </div>
            </div>
            <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
              <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
              <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
            </p>
            <div
              class="express-acc__body"
              id="express-acc-panel-3"
              role="region"
              aria-labelledby="express-step-3-title"
              hidden
            >
              <p class="express-fit-instruction">
                Your selected fit adds ease to the standard body measurements shown above. You can adjust the finished garment measurements after the pattern is built.
              </p>
              <div
                class="express-fit-cards hat-length-picker__grid sg-fit-preference-grid"
                role="group"
                aria-labelledby="express-step-3-title"
              >
                <button
                  type="button"
                  class="hat-length-picker__option sg-fit-preference-option"
                  data-choice
                  data-field="fit"
                  data-value="close"
                  aria-pressed="false"
                >
                  <img class="fit-card-image" src="/images/patterns/drop-shoulder/picker/close-fit.webp" alt="Close fit garment" />
                  <span class="sg-fit-preference-title-row">
                    <span class="hat-length-picker__option-label">Close fit</span>
                    <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                  </span>
                  <span class="sg-fit-preference-note">Fits close to the body.</span>
                  <span class="sg-fit-preference-ease">{formatFitEaseApproxLabel("close")}</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option sg-fit-preference-option"
                  data-choice
                  data-field="fit"
                  data-value="standard"
                  aria-pressed="false"
                >
                  <img class="fit-card-image" src="/images/patterns/drop-shoulder/picker/standard-fit.webp" alt="Standard fit garment" />
                  <span class="sg-fit-preference-title-row">
                    <span class="hat-length-picker__option-label">Standard fit</span>
                    <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                  </span>
                  <span class="sg-fit-preference-note">Comfortable everyday fit.</span>
                  <span class="sg-fit-preference-ease">{formatFitEaseApproxLabel("standard")}</span>
                </button>
                <button
                  type="button"
                  class="hat-length-picker__option sg-fit-preference-option"
                  data-choice
                  data-field="fit"
                  data-value="relaxed"
                  aria-pressed="false"
                >
                  <img class="fit-card-image" src="/images/patterns/drop-shoulder/picker/relaxed-fit.webp" alt="Relaxed fit garment" />
                  <span class="sg-fit-preference-title-row">
                    <span class="hat-length-picker__option-label">Relaxed fit</span>
                    <span class="sg-fit-option-check" aria-hidden="true">✓</span>
                  </span>
                  <span class="sg-fit-preference-note">More room and drape.</span>
                  <span class="sg-fit-preference-ease">{formatFitEaseApproxLabel("relaxed")}</span>
                </button>
              </div>
            </div>
          </section>

          <!-- Step 4 — sleeve length -->
          <section
            class="express-acc express-acc--locked"
            data-express-step="4"
            data-express-field="sleeveLength"
          >
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="-1"
              aria-expanded="false"
              aria-controls="express-acc-panel-4"
              id="express-acc-label-4"
            >
              <button type="button" class="express-acc__chevron" data-express-chevron aria-hidden="true" tabindex="-1">
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <h2 class="express-acc__title" id="express-step-4-title">Choose your sleeve length</h2>
                <span class="express-acc__value" data-ds-sleeve-length-summary></span>
              </div>
            </div>
            <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
              <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
              <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
            </p>
            <div
              class="express-acc__body"
              id="express-acc-panel-4"
              role="region"
              aria-labelledby="express-step-4-title"
              hidden
            >
              <div class="ds-sleeve-length" data-ds-sleeve-length>
                <div class="ds-sleeve-length__grid hat-length-picker__grid hat-brim-picker__grid" role="group" aria-labelledby="express-step-4-title">
                  <button
                    type="button"
                    class="hat-length-picker__option ds-sleeve-length__option is-selected"
                    data-ds-sleeve-length-option
                    data-value="long"
                    aria-pressed="true"
                  >
                    <img
                      src="/images/patterns/drop-shoulder/picker/long.webp"
                      alt="Long sleeve"
                      class="hat-length-picker__img sg-picker-img"
                      width="120"
                      height="120"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="hat-length-picker__option-label">Long</span>
                  </button>
                  <button
                    type="button"
                    class="hat-length-picker__option ds-sleeve-length__option"
                    data-ds-sleeve-length-option
                    data-value="three-quarter"
                    aria-pressed="false"
                  >
                    <img
                      src="/images/patterns/drop-shoulder/picker/3-4.webp"
                      alt="Three-quarter sleeve"
                      class="hat-length-picker__img sg-picker-img"
                      width="120"
                      height="120"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="hat-length-picker__option-label">3/4</span>
                  </button>
                  <button
                    type="button"
                    class="hat-length-picker__option ds-sleeve-length__option"
                    data-ds-sleeve-length-option
                    data-value="elbow"
                    aria-pressed="false"
                  >
                    <img
                      src="/images/patterns/drop-shoulder/picker/elbow.webp"
                      alt="Elbow sleeve"
                      class="hat-length-picker__img sg-picker-img"
                      width="120"
                      height="120"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="hat-length-picker__option-label">Elbow</span>
                  </button>
                  <button
                    type="button"
                    class="hat-length-picker__option ds-sleeve-length__option"
                    data-ds-sleeve-length-option
                    data-value="short"
                    aria-pressed="false"
                  >
                    <img
                      src="/images/patterns/drop-shoulder/picker/short.webp"
                      alt="Short sleeve"
                      class="hat-length-picker__img sg-picker-img"
                      width="120"
                      height="120"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="hat-length-picker__option-label">Short</span>
                  </button>
                </div>
              </div>
            </div>
          </section>

          <!-- Step 5 — gauge (+ sleeve direction + available needles) -->
          <section
            class="express-acc express-acc--locked scroll-mt-[96px]"
            id="express-gauge-section"
            data-express-step="5"
            data-express-field="gauge"
          >
            <div
              class="express-acc__header"
              data-express-header
              role="button"
              tabindex="-1"
              aria-expanded="false"
              aria-controls="express-acc-panel-5"
              id="express-acc-label-5"
            >
              <button type="button" class="express-acc__chevron" data-express-chevron aria-hidden="true" tabindex="-1">
                ▾
              </button>
              <div class="express-acc__header-main">
                <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                <div class="express-acc__title-row express-acc__title-row--gauge">
                  <h2 class="express-acc__title" id="express-step-5-title">Enter your gauge</h2>
                  <span class="express-acc__title-glossary">
                    <GlossaryTooltip id={616}>Gauge</GlossaryTooltip>
                  </span>
                </div>
                <span class="express-acc__value" data-express-summary="gauge"></span>
              </div>
            </div>
            <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
              <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
              <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
            </p>
            <div
              class="express-acc__body"
              id="express-acc-panel-5"
              role="region"
              aria-labelledby="express-step-5-title"
              hidden
            >
              <form class="express-gauge" id="express-gauge-form" novalidate>
                <div class="express-gauge-intro-group">
                  <p class="express-gauge-intro">
                    Enter the gauge from your swatch over 4 inches / 10 cm.
                  </p>
                  <div class="express-gauge-help">
                    <button
                      type="button"
                      class="kbm-kin-catalog-video express-gauge-help-link"
                      data-vimeo-id="1046394794"
                      data-video-title="How to Knit a Proper Swatch: The Secret to Machine Knitting Success"
                    >
                      <span class="express-gauge-help-icon" aria-hidden="true">
                        <i class="fa-solid fa-circle-play"></i>
                      </span>
                      <span class="express-gauge-help-label">Watch how to knit a proper swatch.</span>
                    </button>
                  </div>
                </div>
                <div class="express-gauge-block">
                  <GaugeInput
                    id="express"
                    showTitle={false}
                    showGaugeSubLabel={false}
                    showToggle={false}
                    toggleId="sleeveless-fit"
                    stitchLabelInches='Stitch gauge — stitches over 4"'
                    stitchLabelCm="Stitch gauge — stitches over 10 cm"
                    rowLabelInches='Row gauge — rows over 4"'
                    rowLabelCm="Row gauge — rows over 10 cm"
                  />
                </div>
                <div class="express-needle-block" hidden>
                  <FloatingInput
                    id="express-available-needles"
                    name="availableNeedles"
                    label={AVAILABLE_NEEDLES_LABEL}
                    type="number"
                    inputMode="numeric"
                    min="1"
                    step="1"
                    required
                    errorId="express-available-needles-error"
                    errorText={AVAILABLE_NEEDLES_REQUIRED_MESSAGE}
                  />
                  <p class="express-needle-help" id="express-available-needles-help">
                    {AVAILABLE_NEEDLES_HELPER_TEXT}
