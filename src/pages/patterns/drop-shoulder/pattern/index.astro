---
import Layout from "../../../../layouts/Layout.astro";
import SleevelessPatternMemberGate from "../../../../components/patterns/SleevelessPatternMemberGate.astro";
import PatternPrintFooter from "../../../../components/common/PatternPrintFooter.astro";
import PatternPrintPersonalization from "../../../../components/common/PatternPrintPersonalization.astro";
import PatternTipsToggle from "../../../../components/patterns/PatternTipsToggle.astro";
import PatternEditablePencilIcon from "../../../../components/patterns/PatternEditablePencilIcon.astro";
import PatternPhoneWorkspaceNotice from "../../../../components/patterns/PatternPhoneWorkspaceNotice.astro";
import EditWorkspaceGaugeFields from "../../../../components/patterns/EditWorkspaceGaugeFields.astro";
import SleevelessPatternPrintNotice from "../../../../components/patterns/SleevelessPatternPrintNotice.astro";
import PatternEditingUnlockModal from "../../../../components/patterns/PatternEditingUnlockModal.astro";
import PatternAutoSaveSuccessDialog from "../../../../components/patterns/PatternAutoSaveSuccessDialog.astro";
import BustDartPatternModal from "../../../../components/patterns/BustDartPatternModal.astro";
import GarmentPatternYarnDrawer from "../../../../components/patterns/GarmentPatternYarnDrawer.astro";
import FloatingInput from "../../../../components/lego/FloatingInput.astro";
import {
  AVAILABLE_NEEDLES_HELPER_TEXT,
  AVAILABLE_NEEDLES_LABEL,
  AVAILABLE_NEEDLES_REQUIRED_MESSAGE,
} from "../../../../lib/patterns/sleevelessExpressAvailableNeedles";

import "../../../../styles/ns-shaping-chart.css";
import "../../../../styles/shaping-map.css";
import "../../../../styles/wizard.css";
import "../../../../styles/glossary-tooltip.css";
import "../../../../styles/pattern-tips.css";
import "../../../../styles/pattern-quick-tip.css";
import "../../../../styles/pattern-help-card.css";

import "../../../../styles/patterns/sleeveless-pattern-shared.css";
import "../../../../styles/patterns/pattern-app-shell.css";
import "../../../../styles/patterns/pattern-editable-pencil.css";
import "../../../../styles/tools/yarn-requirement-drawer-shell.css";

// Reused measurement editor styling (same diagram/overlay as Custom Build → Measurements).
import "../../../../styles/sleeveless-express-measurements-confirm.css";
import "../../../../styles/sleeveless-custom-build-measurements.css";
import "../../../../styles/patterns/sweater-edit-measurement-diagram.css";
---

<Layout
  title="Drop Shoulder Sweater Pattern | Knit it Now"
  description="Generated drop shoulder sweater pattern instructions, diagrams, glossary help, and videos from your saved builder choices."
  bodyClass="pattern-print-global-footer"
  patternWorkspace={true}
>
  <PatternPrintFooter footerBottomLeftExtra=" · KnitItNow.com/drop-shoulder" />
  <SleevelessPatternMemberGate>
  <main class="wizard-page sleeveless-pattern-page sleeveless-workspace-subpage pattern-app-shell" data-pattern-print-skip-modal>
    <div id="sleeveless-pattern-top" class="wizard-container scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <div class="pattern-action-bar no-print" data-pattern-action-bar>
          <div class="pattern-action-bar__group pattern-action-bar__group--start">
            <button
              type="button"
              class="sleeveless-pattern-edit-action no-print"
              data-pattern-workspace-library-trigger
              data-testid="pattern-workspace-library-trigger"
              aria-haspopup="dialog"
              aria-controls="pattern-workspace-library-drawer-panel"
              aria-expanded="false"
            >
              <i class="fa-solid fa-folder-open" aria-hidden="true"></i> My Patterns
            </button>
            <button
              type="button"
              class="sleeveless-pattern-edit-action no-print"
              data-pattern-workspace-new-pattern-trigger
              data-testid="pattern-workspace-new-pattern-trigger"
            >
              <i class="fa-solid fa-plus" aria-hidden="true"></i> New Pattern
            </button>
          </div>
          <div
            class="pattern-action-bar__group pattern-action-bar__group--end"
            data-sleeveless-pattern-actions
          >
            <button
              type="button"
              id="express-yarn-drawer-open"
              class="sleeveless-pattern-edit-action no-print"
              data-garment-yarn-open
              data-testid="garment-pattern-how-much-yarn"
              hidden
              aria-haspopup="dialog"
              aria-controls="express-yarn-drawer-panel"
              aria-expanded="false"
            >
              How Much Yarn?
            </button>
            <button
              type="button"
              class="sleeveless-pattern-edit-action no-print"
              data-sl-edit-open
              data-testid="button-edit-pattern"
              aria-haspopup="dialog"
              aria-controls="sl-edit-drawer-panel"
            >
              <i class="fas fa-pen" aria-hidden="true"></i> Edit Pattern
            </button>
            <!-- Print button (#print-btn) is injected here by mountSleevelessPrintAction(). -->
          </div>
        </div>

        <div id="sg-sleeveless-results" class="sg-sleeveless-results">
          <div id="sleeveless-pattern-tips-scope" class="pattern-tips-scope" data-show-tips="true">
            <SleevelessPatternPrintNotice />
            <section class="sleeveless-pattern-intro">
              <div class="sleeveless-pattern-intro__image">
                <div class="beta-pattern-video">
                  <div class="beta-pattern-video__wrap">
                    <img
                      src="/images/patterns/drop-shoulder/drop-woman-pullover-round.webp"
                      alt="Drop shoulder sweater pattern preview"
                      width="593"
                      height="664"
                      loading="lazy"
                      decoding="async"
                      class="sg-pattern-hero-image"
                      data-sleeveless-audience-hero
                    />
                  </div>
                </div>
                <div class="pattern-print-origin" aria-hidden="true">
                  <div class="pattern-print-origin__label">Created with the Knit It Now Drop Shoulder Pattern Builder</div>
                  <div class="pattern-print-origin__url">KnitItNow.com/drop-shoulder</div>
                </div>
              </div>
              <div class="sleeveless-pattern-intro__content">
                <div class="sleeveless-pattern-online-project-header no-print">
                  <div class="sleeveless-pattern-online-heading-row">
                    <p class="sleeveless-pattern-online-heading" data-sleeveless-pattern-online-heading>
                      Drop shoulder sweater · Pattern instructions
                    </p>
                  </div>
                  <div
                    class="sleeveless-pattern-project-notes-wrap"
                    data-sleeveless-pattern-online-notes-wrap
                    hidden
                  >
                    <div class="sleeveless-pattern-project-notes__head">
                      <p class="sleeveless-pattern-project-notes__label">Project notes</p>
                    </div>
                    <div
                      class="sleeveless-pattern-project-notes"
                      data-sleeveless-pattern-online-notes
                      hidden
                    >
                      <div
                        class="sleeveless-pattern-project-notes__text"
                        data-sleeveless-pattern-online-notes-text
                      ></div>
                    </div>
                  </div>
                </div>
                <PatternPrintPersonalization>
                  <div slot="print-summary" class="sg-pattern-print-at-a-glance" data-sg-pattern-print-at-a-glance>
                    <h2 class="print-heading-major print-heading-major--hero">At a glance</h2>
                    <div data-sg-pattern-print-basics-body></div>
                  </div>
                </PatternPrintPersonalization>
                <div
                  class="sg-pattern-intro-metadata pattern-generated-description"
                  data-sg-pattern-intro
                  data-pattern-generated-description
                  aria-label="Pattern summary"
                ></div>
                <PatternTipsToggle
                  storageKey="sleeveless-show-tips"
                  scopeSelector="#sleeveless-pattern-tips-scope"
                />
              </div>
            </section>

            <div id="pattern-content" data-pattern-content>
              <nav
                class="sleeveless-pattern-inpage-nav no-print"
                data-sleeveless-pattern-inpage-nav
                aria-label="Jump to pattern section"
                hidden
              ></nav>
              <div class="sleeveless-pattern-mount" data-sleeveless-mount>
                <p class="sleeveless-pattern-boot-msg">Loading pattern…</p>
              </div>
            </div>
          </div>
        </div>

        <noscript>
          <div class="pattern-section">
            <h2 class="pattern-noscript-heading">Pattern</h2>
            <p>Turn on JavaScript to view this pattern.</p>
          </div>
        </noscript>
      </div>
    </div>

    <!--
      Edit Pattern workspace — ONE combined editing surface (full-width app shell).
      Left column: quick edits (Size, Front Style, Neckline, Gauge, Needles).
      Right column: the reused Custom Build measurement editor SVG — visible immediately,
      no separate "Edit Measurements" click.
    -->
    <div class="sl-edit-drawer sl-edit-drawer--workspace no-print" data-sl-edit-drawer aria-hidden="true">
      <div class="sl-edit-drawer__backdrop" data-sl-edit-close aria-hidden="true"></div>
      <section
        id="sl-edit-drawer-panel"
        class="sl-edit-drawer__panel"
        role="dialog"
        aria-modal="true"
        aria-label="Edit pattern"
        tabindex="-1"
      >
        <PatternPhoneWorkspaceNotice />
        <div class="sl-edit-workspace__layout">
          <!-- LEFT: quick edits panel (narrower). `.sl-edit-drawer__body` is the JS field scope. -->
          <div class="sl-edit-workspace__quick">
            <div class="sl-edit-drawer__body">
              <div class="sl-edit-field">
                <label class="sl-edit-label" for="sl-edit-title">
                  <span class="pattern-editable-heading">
                    Pattern title
                    <PatternEditablePencilIcon />
                  </span>
                </label>
                <input
                  type="text"
                  id="sl-edit-title"
                  class="sl-edit-input"
                  placeholder="Drop shoulder sweater"
                  autocomplete="off"
                />
              </div>

              <div class="sl-edit-field sl-edit-notes-field" data-sl-notes-field data-collapsed="true">
                <button
                  type="button"
                  class="sl-edit-notes-toggle"
                  data-sl-notes-toggle
                  aria-expanded="false"
                  aria-controls="sl-edit-notes-region"
                >
                  <span class="sl-edit-notes-toggle__label pattern-editable-heading">
                    Notes
                    <PatternEditablePencilIcon />
                  </span>
                  <span class="sl-edit-notes-toggle__preview" data-sl-notes-preview hidden></span>
                  <i class="fa-solid fa-chevron-down sl-edit-notes-toggle__chevron" aria-hidden="true"></i>
                </button>
                <div class="sl-edit-notes-region" id="sl-edit-notes-region" data-sl-notes-region hidden>
                  <textarea
                    id="sl-edit-notes"
                    class="sl-edit-input sl-edit-textarea"
                    rows="4"
                    aria-label="Notes"
                    placeholder="Add your own notes — yarn, needles, tweaks to remember…"
                  ></textarea>
                </div>
              </div>

              <section class="sl-edit-section sl-edit-units-section" aria-labelledby="sl-edit-units-heading">
                <h3 class="sl-edit-section__title" id="sl-edit-units-heading">Units</h3>
                <div
                  class="sl-edit-units-toggle"
                  role="group"
                  aria-labelledby="sl-edit-units-heading"
                  data-sl-edit-units
                >
                  <button
                    type="button"
                    class="sl-edit-unit-btn is-active"
                    data-sl-edit-unit="in"
                    aria-pressed="true"
                  >
                    Inches
                  </button>
                  <button
                    type="button"
                    class="sl-edit-unit-btn"
                    data-sl-edit-unit="cm"
                    aria-pressed="false"
                  >
                    Centimeters
                  </button>
                </div>
                <p class="sl-edit-ease">
                  Switch how measurements and gauge are shown. Your pattern's measurements don't change.
                </p>
              </section>

              <section class="sl-edit-section" aria-labelledby="sl-edit-setup-heading">
                <h3 class="sl-edit-section__title pattern-editable-heading" id="sl-edit-setup-heading">
                  Quick edits
                  <PatternEditablePencilIcon />
                </h3>

                <div class="sl-edit-field">
                  <label class="sl-edit-sublabel" for="sl-edit-size">Size</label>
                  <select id="sl-edit-size" class="sl-edit-input sl-edit-select" data-sl-edit-size>
                    <option value="">Loading sizes…</option>
                  </select>
                  <p class="sl-edit-ease">
                    Changing the size updates the pattern measurements automatically.
                  </p>
                </div>

                <fieldset class="sl-edit-field sl-edit-fieldset">
                  <legend class="sl-edit-sublabel">Front style</legend>
                  <div class="sl-edit-segment" role="radiogroup" aria-label="Front style">
                    <label class="sl-edit-segment__option">
                      <input type="radio" name="sl-edit-garment" value="pullover" checked />
                      <span class="sl-edit-segment__pill">Pullover</span>
                    </label>
                    <label class="sl-edit-segment__option">
                      <input type="radio" name="sl-edit-garment" value="cardigan" />
                      <span class="sl-edit-segment__pill">Cardigan</span>
                    </label>
                  </div>
                </fieldset>

                <fieldset class="sl-edit-field sl-edit-fieldset">
                  <legend class="sl-edit-sublabel">Neckline</legend>
                  <div class="sl-edit-segment" role="radiogroup" aria-label="Neckline">
                    <label class="sl-edit-segment__option">
                      <input type="radio" name="sl-edit-neckline" value="round" checked />
                      <span class="sl-edit-segment__pill">Round Neck</span>
                    </label>
                    <label class="sl-edit-segment__option">
                      <input type="radio" name="sl-edit-neckline" value="v-neck" />
                      <span class="sl-edit-segment__pill">V-Neck</span>
                    </label>
                  </div>
                </fieldset>

                <fieldset class="sl-edit-field sl-edit-fieldset">
                  <legend class="sl-edit-sublabel">Choose your sleeve length</legend>
                  <div class="sl-edit-segment" role="radiogroup" aria-label="Choose your sleeve length">
                    <label class="sl-edit-segment__option">
                      <input type="radio" name="sl-edit-sleeve-length" value="long" checked />
                      <span class="sl-edit-segment__pill">Long</span>
                    </label>
                    <label class="sl-edit-segment__option">
                      <input type="radio" name="sl-edit-sleeve-length" value="three-quarter" />
                      <span class="sl-edit-segment__pill">3/4</span>
                    </label>
                    <label class="sl-edit-segment__option">
                      <input type="radio" name="sl-edit-sleeve-length" value="elbow" />
                      <span class="sl-edit-segment__pill">Elbow</span>
                    </label>
                    <label class="sl-edit-segment__option">
                      <input type="radio" name="sl-edit-sleeve-length" value="short" />
                      <span class="sl-edit-segment__pill">Short</span>
                    </label>
                  </div>
                </fieldset>
              </section>

              <section class="sl-edit-section" aria-labelledby="sl-edit-gauge-heading">
                <h3 class="sl-edit-section__title pattern-editable-heading" id="sl-edit-gauge-heading">
                  Gauge
                  <PatternEditablePencilIcon />
                </h3>
                <EditWorkspaceGaugeFields />
                <div class="sl-edit-needles-field">
                  <FloatingInput
                    id="sl-edit-needles"
                    label={AVAILABLE_NEEDLES_LABEL}
                    type="number"
                    inputMode="numeric"
                    min="1"
                    step="1"
                    required
                    errorId="sl-edit-needles-error"
                    errorText={AVAILABLE_NEEDLES_REQUIRED_MESSAGE}
                  />
                  <p class="sl-edit-needles-help" id="sl-edit-needles-help">
                    {AVAILABLE_NEEDLES_HELPER_TEXT}
                  </p>
                </div>
              </section>
            </div>
          </div>

          <!--
            RIGHT: measurement SVG workspace. Reuses the live Custom Build measurement editor
            (`initCustomBuildMeasurementsPage`): Drop Shoulder summary diagram, labels, field names,
            and overlay positions. `data-sleeveless-review-managed` suppresses the editor's auto-init
            so this combined workspace initialises it when Edit Pattern opens.
          -->
          <div class="sl-edit-workspace__measure" data-sl-measure-pane>
            <header class="sl-edit-workspace__measure-head">
              <div class="sl-edit-workspace__measure-headrow">
                <h3 class="sl-edit-workspace__measure-title pattern-editable-heading">
                  Measurements
                  <PatternEditablePencilIcon />
                </h3>
                <div class="sl-edit-workspace__measure-actions" data-sl-edit-actions>
                  <div class="sl-edit-workspace__notes">
                    <p class="sl-edit-error-note" data-sl-edit-errors hidden role="alert"></p>
                    <p class="sl-edit-saved-note" data-sl-edit-note hidden role="status">
                      Pattern updated.
                    </p>
                  </div>
                  <div class="sl-edit-drawer__actions">
                    <button
                      type="button"
                      class="sl-edit-btn sl-edit-btn--ghost"
                      data-sl-edit-close
                      data-testid="button-edit-cancel"
                    >
                      Cancel
                    </button>
                    <button
                      type="button"
                      class="sl-edit-btn sl-edit-btn--primary"
                      data-sl-edit-apply
                      data-testid="button-edit-apply"
                    >
                      Save Changes
                    </button>
                  </div>
                </div>
              </div>
              <p class="sl-edit-workspace__measure-hint">
                Make your changes, then click Save Changes to update your pattern.
              </p>
            </header>
            <div class="sl-measure-workspace__body cb-measure-page express-measurements-confirm-page">
              <div
                class="sl-measure-workspace__editor"
                data-cb-measure-root
                data-sleeveless-review-managed
                data-express-construction="drop-shoulder"
                data-drop-shoulder-workspace-measure-summary
              >
                <div class="sleeveless-measure-review-body">
                  <div
                    class="sleeveless-measure-project-summary"
                    data-cb-build-summary
                    aria-label="Current build summary"
                  ></div>
                  <p class="cb-measure-missing" data-cb-measure-missing hidden>
                    Complete Foundation and Style &amp; Shaping to load measurements.
                  </p>
                  <div
                    class="sleeveless-measure-diagram-host cb-measure-diagram-host"
                    data-cb-measure-diagram
                  ></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

  </main>

  <!-- How Much Yarn? — page-level drawer outside Edit Pattern; body + sleeve area from rendered pattern. -->
  <GarmentPatternYarnDrawer lede="Quick estimate from a weighed swatch using this drop shoulder sweater’s finished size and sleeves." />

  <PatternEditingUnlockModal />
  <BustDartPatternModal />
  <PatternAutoSaveSuccessDialog />
  </SleevelessPatternMemberGate>
</Layout>

<style>
  /*
   * Pattern workspace action bar — replaces the former tab navigation.
   */
  .pattern-action-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(82, 104, 45, 0.12);
  }

  .pattern-action-bar__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .pattern-action-bar__group--end {
    justify-content: flex-end;
  }

  .sleeveless-pattern-online-project-header {
    margin: 0 0 0.75rem;
  }

  .sleeveless-pattern-online-heading-row {
    margin: 0 0 0.4rem;
  }

  .sleeveless-pattern-online-heading {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    color: #374151;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .sleeveless-pattern-project-notes-wrap {
    margin: 0;
  }

  .sleeveless-pattern-project-notes__head {
    margin-bottom: 0.25rem;
  }

  .sleeveless-pattern-project-notes {
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--kbm-green, #52682d) 14%, #e5e7eb);
    background: color-mix(in srgb, var(--kbm-green, #52682d) 4%, #fff);
  }

  .sleeveless-pattern-project-notes__label {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--kbm-green, #52682d) 55%, #6b7280);
  }

  .sleeveless-pattern-project-notes__text {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: #4b5563;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .sleeveless-pattern-intro__image {
    width: 100%;
    min-width: 280px;
    justify-self: end;
  }

  .beta-pattern-video {
    display: block;
    width: 360px;
    max-width: 100%;
  }

  .beta-pattern-video__wrap {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    border-radius: 8px;
    background: transparent;
  }

  .sg-pattern-hero-image {
    display: block;
    width: 100%;
    max-height: 320px;
    height: auto;
    object-fit: contain;
    border-radius: inherit;
  }

  @media (max-width: 560px) {
    .sleeveless-pattern-intro__image {
      min-width: 0;
      justify-self: stretch;
    }

    .beta-pattern-video {
      width: 100%;
    }
  }

  @media print {
    :global(#pattern-content .pattern-section),
    :global(#pattern-content .pattern-section--garment-piece),
    :global(#pattern-content .pattern-layout.pattern-layout--garment-columns),
    :global(#pattern-content .sleeveless-piece-split) {
      break-inside: auto !important;
      page-break-inside: auto !important;
    }

    :global(#pattern-content .pattern-section) {
      break-before: auto !important;
      page-break-before: auto !important;
    }

    :global(#pattern-content .pattern-section__heading),
    :global(#pattern-content .pattern-subsection__heading),
    :global(#pattern-content .sleeveless-piece-split__diagram) {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }

    :global(#pattern-content .pattern-layout.pattern-layout--garment-columns),
    :global(#pattern-content .sleeveless-piece-split) {
      --garment-print-diagram-track: 2.6in;
      --garment-print-column-gap: 0.35in;
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(180px, var(--garment-print-diagram-track)) !important;
      column-gap: var(--garment-print-column-gap) !important;
      row-gap: 0 !important;
      align-items: start !important;
    }

    :global(#pattern-content .pattern-layout__content),
    :global(#pattern-content .sleeveless-piece-split__text) {
      min-width: 0 !important;
      order: 0 !important;
    }

    :global(#pattern-content .pattern-layout__sidebar),
    :global(#pattern-content .sleeveless-piece-split__diagram) {
      display: block !important;
      visibility: visible !important;
      position: static !important;
      top: auto !important;
      inset: auto !important;
      order: 0 !important;
      align-self: start !important;
      justify-self: end !important;
      width: auto !important;
      max-width: 2.6in !important;
      overflow: visible !important;
    }

    :global(#pattern-content .sleeveless-piece-split__diagram-inner),
    :global(#pattern-content .sleeveless-piece-split__diagram-trigger) {
      display: block !important;
      visibility: visible !important;
      position: static !important;
      cursor: default !important;
      width: 100% !important;
      max-width: 2.6in !important;
      height: auto !important;
      overflow: visible !important;
    }

    :global(#pattern-content .sleeveless-piece-split__diagram-svg),
    :global(#pattern-content .sleeveless-piece-split__diagram-inline),
    :global(#pattern-content .sleeveless-piece-split__diagram-svg > svg),
    :global(#pattern-content .sleeveless-piece-split__diagram img),
    :global(#pattern-content .sleeveless-piece-split__diagram svg) {
      display: block !important;
      visibility: visible !important;
      width: 100% !important;
      max-width: 2.6in !important;
      height: auto !important;
      opacity: 1 !important;
      overflow: visible !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
  }

  /*
   * Edit Pattern drawer.
   */
  .sl-edit-drawer {
    position: fixed;
    inset: 0;
    z-index: 1450;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0s linear 0.2s;
  }

  .sl-edit-drawer.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.2s ease;
  }

