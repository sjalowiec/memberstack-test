---
/**
 * Mitten builder. Same Express step navigation, accordions, and picker cards
 * as the hat and drop-shoulder builders. Measurements are loaded from the
 * chart size and edited on Summary/Edit.
 */
import Layout from "../../../layouts/Layout.astro";
import PatternPhoneWorkspaceNotice from "../../../components/patterns/PatternPhoneWorkspaceNotice.astro";
import GaugeInput from "../../../components/wizards/GaugeInput.astro";
import UnitToggle from "../../../components/wizards/UnitToggle.astro";
import { MITTEN_BUILDER_STEPS } from "../../../lib/patterns/mitten/mittenBuilderState";
import { MITTEN_SIZING_CHART } from "../../../lib/patterns/mitten/mittenSizingChart";

import "../../../styles/sleeveless-express-builder-cards.css";
import "../../../styles/sleeveless-express-wizard-layout.css";
import "../../../styles/wizard.css";
import "../../../styles/tools/pattern-select-completion.css";

const expressNavSteps = MITTEN_BUILDER_STEPS;
---

<Layout
  title="Mitten Pattern Builder | Knit it Now"
  description="Create a machine-knit mitten pattern from a chart size, thumb construction, and your gauge."
  patternWorkspace={true}
>
  <main
    class="express-page wizard-page sleeveless-express-page mitten-express-builder-page"
    data-express-page="mitten-builder"
    data-mitten-builder
    data-testid="mitten-builder-page"
  >
    <div id="mitten-builder-form-top" class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternPhoneWorkspaceNotice />
        <div class="sg-tab-build">
          <div class="sg-builder-nav-row express-builder-nav-row no-print">
            <nav class="express-step-nav sg-builder-nav" aria-label="Mitten pattern steps">
              <ol class="express-step-nav__list sg-builder-nav__list" role="list">
                {
                  expressNavSteps.map((s, i) => (
                    <li
                      class:list={[
                        "express-step-nav__item",
                        "sg-builder-nav__item",
                        { active: s.step === 1 },
                      ]}
                    >
                      <button
                        type="button"
                        class:list={[
                          "express-step-nav__btn",
                          "sg-builder-nav__link",
                          {
                            "is-current": s.step === 1,
                            "is-upcoming": s.step > 1,
                          },
                        ]}
                        data-pill-step={s.step}
                        data-pill-label={s.label}
                        aria-current={s.step === 1 ? "page" : undefined}
                        aria-disabled={s.step > 1 ? "true" : undefined}
                        title={s.step > 1 ? "Finish the previous step to continue." : undefined}
                      >
                        <span class="express-step-nav__track">
                          <span
                            class:list={[
                              "express-step-nav__seg",
                              "express-step-nav__seg--before",
                              { "express-step-nav__seg--empty": i === 0 },
                            ]}
                            aria-hidden="true"
                          />
                          <span class="express-step-nav__circle">
                            <span class="express-step-nav__num">{s.step}</span>
                            <span class="express-pill__check" aria-hidden="true">
                              ✓
                            </span>
                          </span>
                          <span
                            class:list={[
                              "express-step-nav__seg",
                              "express-step-nav__seg--after",
                              {
                                "express-step-nav__seg--empty": i === expressNavSteps.length - 1,
                              },
                            ]}
                            aria-hidden="true"
                          />
                        </span>
                        <span class="express-step-nav__label">{s.label}</span>
                      </button>
                    </li>
                  ))
                }
              </ol>
            </nav>
          </div>

          <header class="pattern-header page-header">
            <div class="mitten-builder-hero-image">
              <img
                src="/images/patterns/mittens.png"
                alt="A pair of machine-knit mittens"
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
                class="sg-pattern-hero-image mitten-pattern-hero-image"
              />
            </div>
            <div class="pattern-header__title-row">
              <h1 class="pattern-title">Mitten Pattern</h1>
            </div>
            <p class="pattern-subtext">
              Choose a size and a thumb, then enter your gauge. Measurements from the chart
              can be changed on the next page.
            </p>
          </header>

          <div class="express-panel">
            <div class="express-builder-root" data-express-builder data-mitten-builder-root>
              <div class="express-builder-toolbar no-print">
                <button
                  type="button"
                  id="mitten-builder-start-over"
                  class="btn btn-outline-secondary btn-sm"
                  data-testid="mitten-builder-start-over"
                >
                  Start over
                </button>
              </div>
              <div class="express-builder-units no-print">
                <UnitToggle id="mitten" />
              </div>

              <div class="express-accordions" id="express-accordions">
                <section
                  class="express-acc express-acc--open"
                  data-express-step="1"
                  data-express-field="size"
                >
                  <div
                    class="express-acc__header"
                    data-express-header
                    role="button"
                    tabindex="0"
                    aria-expanded="true"
                    aria-controls="express-acc-panel-1"
                    id="express-acc-label-1"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-express-chevron
                      aria-label="Toggle size choices"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                      <h2 class="express-acc__title" id="express-step-1-title">Mitten size</h2>
                      <span class="express-acc__value" data-express-summary="size"></span>
                    </div>
                  </div>
                  <div
                    class="express-acc__body"
                    id="express-acc-panel-1"
                    role="region"
                    aria-labelledby="express-step-1-title"
                  >
                    <div class="input-group">
                      <div class="hat-select-wrap">
                        <span class="hat-select-wrap__check" aria-hidden="true"></span>
                        <select
                          id="mitten-size"
                          data-testid="mitten-size"
                          aria-label="Choose a mitten size"
                          autocomplete="off"
                        >
                          <option value="" disabled selected hidden>Choose a mitten size...</option>
                          {MITTEN_SIZING_CHART.map((row) => <option value={row.size}>{row.label}</option>)}
                        </select>
                      </div>
                    </div>
                  </div>
                </section>

                <section
                  class="express-acc express-acc--locked"
                  data-express-step="2"
                  data-express-field="thumb"
                >
                  <div
                    class="express-acc__header"
                    data-express-header
                    role="button"
                    tabindex="-1"
                    aria-expanded="false"
                    aria-controls="express-acc-panel-2"
                    id="express-acc-label-2"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-express-chevron
                      aria-hidden="true"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                      <h2 class="express-acc__title" id="express-step-2-title">Thumb construction</h2>
                      <span class="express-acc__value" data-express-summary="thumb"></span>
                    </div>
                  </div>
                  <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
                    <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
                    <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
                  </p>
                  <div
                    class="express-acc__body"
                    id="express-acc-panel-2"
                    role="region"
                    aria-labelledby="express-step-2-title"
                    hidden
                  >
                    <p class="mitten-builder-step-intro">
                      Both thumbs use the same length, measured from the web to the tip.
                    </p>
                    <select id="mitten-thumb-style" class="sr-only" data-testid="mitten-thumb-style" autocomplete="off">
                      <option value="" selected>Choose a thumb</option>
                      <option value="slotted">Slotted thumb</option>
                      <option value="gored">Gored thumb</option>
                    </select>
                    <div
                      class="hat-length-picker__grid mitten-thumb-picker__grid"
                      role="radiogroup"
                      aria-label="Thumb construction"
                    >
                      <button
                        type="button"
                        class="hat-length-picker__option"
                        data-choice
                        data-field="thumbStyle"
                        data-value="slotted"
                        aria-pressed="false"
                      >
                        <span class="hat-length-picker__option-label">Slotted thumb</span>
                      </button>
                      <button
                        type="button"
                        class="hat-length-picker__option"
                        data-choice
                        data-field="thumbStyle"
                        data-value="gored"
                        aria-pressed="false"
                      >
                        <span class="hat-length-picker__option-label">Gored thumb</span>
                      </button>
                    </div>
                  </div>
                </section>

                <section
                  class="express-acc express-acc--locked scroll-mt-[96px]"
                  id="express-gauge-section"
                  data-express-step="3"
                  data-express-field="gauge"
                >
                  <div
                    class="express-acc__header"
                    data-express-header
                    role="button"
                    tabindex="-1"
                    aria-expanded="false"
                    aria-controls="express-acc-panel-3"
                    id="express-acc-label-3"
                  >
                    <button
                      type="button"
                      class="express-acc__chevron"
                      data-express-chevron
                      aria-hidden="true"
                      tabindex="-1"
                    >
                      ▾
                    </button>
                    <div class="express-acc__header-main">
                      <span class="express-acc__check" data-express-check aria-hidden="true">✓</span>
                      <h2 class="express-acc__title" id="express-step-3-title">Enter your gauge</h2>
                      <span class="express-acc__value" data-express-summary="gauge"></span>
                    </div>
                  </div>
                  <p class="express-acc__locked-feedback" data-express-locked-feedback hidden role="status">
                    <span class="express-acc__locked-arrow" aria-hidden="true">↑</span>
                    <span class="express-acc__locked-msg">Finish the previous step to continue.</span>
                  </p>
                  <div
                    class="express-acc__body"
                    id="express-acc-panel-3"
                    role="region"
                    aria-labelledby="express-step-3-title"
                    hidden
                  >
                    <p class="express-gauge-intro">
                      Enter the gauge from your swatch over 4 inches / 10 cm.
                    </p>
                    <div class="express-gauge-block">
                      <GaugeInput
                        id="mitten"
                        showTitle={false}
                        showGaugeSubLabel={false}
                        showToggle={false}
                        toggleId="mitten"
                        formFields={true}
                      />
                    </div>
                  </div>
                  <div class="express-generate-wrap express-generate-wrap--footer" id="build-pattern-cta">
                    <button
                      type="button"
                      class="express-generate button-disabled"
                      id="create-pattern-btn"
                      data-testid="create-pattern-btn"
                      aria-disabled="true"
                    >
                      Review My Pattern
                    </button>
                    <p
                      id="create-pattern-feedback"
                      class="create-pattern-feedback"
                      role="status"
                      aria-live="polite"
                      hidden
                    >
                    </p>
                  </div>
                </section>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { initMittenBuilderPage } from "../../../scripts/mitten-builder-page";
  initMittenBuilderPage();
</script>

<style>
  .mitten-express-builder-page .mitten-builder-hero-image {
    width: 360px;
    max-width: 100%;
    margin: 0 auto 1rem;
  }

  .mitten-express-builder-page .mitten-pattern-hero-image {
    display: block;
    width: 100%;
    max-height: 320px;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
  }

  .mitten-express-builder-page .mitten-builder-step-intro,
  .mitten-express-builder-page .express-gauge-intro {
    margin: 0 0 0.85rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--express-muted, #6b7280);
  }

  .mitten-express-builder-page .mitten-thumb-picker__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .mitten-express-builder-page #create-pattern-btn.button-disabled,
  .mitten-express-builder-page #create-pattern-btn[aria-disabled="true"] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .mitten-express-builder-page .create-pattern-feedback {
    margin: 0.75rem 0 0;
    min-height: 1.25em;
    font-size: 0.9375rem;
    color: #6b7280;
    text-align: center;
  }

  .mitten-express-builder-page .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
