---
/**
 * Mitten summary / edit checkpoint between the builder and the finished pattern.
 */
import Layout from "../../../../layouts/Layout.astro";
import { MITTEN_BUILDER_HREF } from "../../../../lib/patterns/mitten/mittenDraft";
import { MITTEN_SIZING_CHART, THUMB_LENGTH_DEFINITION, THUMB_VALUE_SOURCES } from "../../../../lib/patterns/mitten/mittenSizingChart";

import "../../../../styles/wizard.css";
import "../../../../styles/patterns/sleeveless-pattern-shared.css";
import "../../../../styles/patterns/pattern-app-shell.css";
---

<Layout
  title="Review Mitten Pattern | Knit it Now"
  description="Review slotted mitten counts before opening the finished pattern."
  bodyClass="pattern-print-global-footer"
  patternWorkspace={true}
>
  <main class="wizard-page pattern-app-shell mitten-summary-page" data-mitten-summary data-testid="mitten-summary-page">
    <div class="wizard-container">
      <p class="no-print"><a href={MITTEN_BUILDER_HREF}>Back to Builder</a></p>
      <h1>Review your mitten</h1>
      <p>The lengths above include the fingertip setup row at your row gauge. The fields below are the measurements you entered.</p>
      <dl id="mitten-summary-counts" class="mitten-counts" data-testid="mitten-summary-counts"></dl>
      <div id="mitten-summary-diagrams" class="mitten-summary-diagrams" data-testid="mitten-summary-diagrams"></div>
      <p id="mitten-summary-feedback" role="status" hidden></p>

      <section class="mitten-summary-edit">
        <h2>Measurements and gauge</h2>
        <p>{THUMB_LENGTH_DEFINITION} {THUMB_VALUE_SOURCES}</p>
        <label>Pattern name <input id="mitten-pattern-name" type="text" autocomplete="off" /></label>
        <label>Thumb construction
          <select id="mitten-thumb-style" data-testid="mitten-thumb-style">
            <option value="slotted">Slotted thumb</option>
            <option value="gored">Gored thumb</option>
          </select>
        </label>
        <label>Size
          <select id="mitten-size">
            <option value="">Custom</option>
            {MITTEN_SIZING_CHART.map((row) => <option value={row.size}>{row.label}</option>)}
          </select>
        </label>
        <div class="mitten-fields">
          <label>Cuff circumference <input id="mitten-cuff-circ" type="number" min="0" step="0.01" /></label>
          <label>Cuff length <input id="mitten-cuff-length" type="number" min="0" step="0.01" /></label>
          <label>Hand circumference <input id="mitten-hand-circ" type="number" min="0" step="0.01" /></label>
          <label>Hand length <input id="mitten-hand-length" type="number" min="0" step="0.01" /></label>
          <label>Hand above the thumb <input id="mitten-hand2" type="number" min="0" step="0.01" /></label>
          <label>Thumb length, web to tip <input id="mitten-thumb-length" type="number" min="0" step="0.01" /></label>
          <label>Thumb circumference, temporary <input id="mitten-thumb-circ" type="number" min="0" step="0.01" /></label>
          <label>Stitches over 4 inches <input id="mitten-stitch-gauge" type="number" min="0" step="0.1" /></label>
          <label>Rows over 4 inches <input id="mitten-row-gauge" type="number" min="0" step="0.1" /></label>
        </div>
      </section>

      <p class="mitten-summary-actions no-print">
        <button type="button" id="mitten-save-pattern" class="express-generate" data-testid="mitten-save-pattern">
          Save to My Patterns
        </button>
        <button type="button" id="mitten-view-pattern" class="express-generate" data-testid="mitten-view-pattern">
          View My Pattern
        </button>
      </p>
    </div>
  </main>
</Layout>

<script>
  import { initMittenSummaryPage } from "../../../../scripts/mitten-pattern-page";
  initMittenSummaryPage();
</script>

<style>
  .mitten-counts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
    margin: 1rem 0 1.5rem;
  }
  .mitten-count {
    margin: 0;
    padding: 0.75rem;
    background: #f4f7ef;
  }
  .mitten-count dt {
    font-size: 0.85rem;
    color: #4b5563;
  }
  .mitten-count dd {
    margin: 0.2rem 0 0;
    font-size: 1.25rem;
    font-weight: 650;
  }
  .mitten-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .mitten-summary-edit label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mitten-summary-page input,
  .mitten-summary-page select {
    font: inherit;
    padding: 0.5rem 0.6rem;
  }
  .mitten-summary-diagrams {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin: 0 0 1.5rem;
  }
  .mitten-summary-diagrams :global(svg) {
    width: 100%;
    height: auto;
  }
  .mitten-summary-diagrams :global(.mitten-diagram-note) {
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .mitten-summary-actions {
    margin-top: 1.25rem;
  }
  .express-generate {
    background: #52682d;
    color: #fff;
    border: 0;
    border-radius: 6px;
    padding: 0.8rem 1.2rem;
    font: inherit;
    cursor: pointer;
  }
</style>
