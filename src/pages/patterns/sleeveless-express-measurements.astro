---
import Layout from "../../layouts/Layout.astro";
import PatternWorkspaceTabs from "../../components/patterns/PatternTabs.astro";
import UnitToggle from "../../components/wizards/UnitToggle.astro";
import "../../styles/wizard.css";
import "../../styles/sleeveless-express-wizard-layout.css";
import "../../styles/sleeveless-express-measurements-confirm.css";

const quickBuildHref = "/patterns/sleeveless-express/";
const customBuildHref = "/patterns/sleeveless/custom-build/";
const patternHref = "/patterns/sleeveless/pattern/";
const askShareHref = "/patterns/sleeveless/ask-share/";
const inspirationHref = "/patterns/sleeveless/inspiration/";
---

<Layout
  title="Express Build — Review Measurements | Sleeveless Sweater"
  description="Confirm sizing chart measurements from your Express Build choices before opening the generated pattern."
>
  <main class="express-page wizard-page sleeveless-express-page express-measurements-confirm-page">
    <div class="wizard-container express-wizard scroll-mt-[96px]">
      <div class="calculator-card hat-builder-inputs">
        <PatternWorkspaceTabs
          rootClass="pattern-tabs-scope"
          activeTab="quick-build"
          workspaceBuildTabLabel="Express Build"
          quickBuildHref={quickBuildHref}
          customBuildHref={customBuildHref}
          patternHref={patternHref}
          askShareHref={askShareHref}
          inspirationHref={inspirationHref}
        />

        <div class="express-measurements-review" data-express-measurements-root>
          <nav class="page-nav express-measurements-page-nav no-print" aria-label="Section">
            <a href={quickBuildHref} class="page-nav__back">← Back to Express Build</a>
          </nav>

          <p class="express-measurements-status pattern-subtext" data-express-measurements-status hidden aria-live="polite"></p>

          <div class="express-mbp-page-grid">
            <aside class="express-mbp-page-grid__rail">
              <header class="pattern-header page-header express-mbp-page-grid__header">
                <p class="pattern-mode-label">Express Build</p>
                <h1 class="pattern-title">Review measurements</h1>
                <p class="pattern-subtext">
                  Express Build automatically creates your garment measurements using your selected size and gauge.
                </p>
                <p class="pattern-subtext express-measurements-intro-follow">
                  Want to explore finer measurement and shaping control later? See the
                  <a href={customBuildHref} class="express-custom-build-callout__link">Custom Build preview</a>.
                </p>
                <div class="express-builder-units no-print express-measurements-intro-units">
                  <UnitToggle id="sleeveless-fit" />
                </div>
              </header>

              <div class="express-measurements-rail-fill" data-express-measurements-rail-fill></div>
            </aside>

            <div class="express-mbp-page-grid__diagram">
              <p class="express-measurements-diagram-hint" aria-live="off">
                Express Build uses standard garment measurements based on your selected size.
              </p>
              <div class="express-measurements-summary" data-express-measurements-summary>
                <p class="pattern-subtext">Loading measurements…</p>
              </div>
            </div>
          </div>

          <div class="express-measurements-actions no-print">
            <a href={quickBuildHref} class="kbm-btn kbm-btn-outline">← Back to Express Build</a>
            <a class="kbm-btn kbm-btn-accent" data-express-measurements-continue hidden>Continue to Your Pattern</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  /* Client bundle: drives blueprint layout + Continue (see sleeveless-express-measurements-page.ts) */
  import "/src/scripts/sleeveless-express-measurements-page.ts";
</script>
