---
// Server-rendered so the Knit-able link follows the live Pacific publish date.
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import PatternBuilderLandingPage from "../../../components/patterns/PatternBuilderLandingPage.astro";
import { applyKnitAbleCacheHeaders } from "../../../lib/knit-ables/pageAccess";
import { SOCKS_PATTERN_BUILDER_LANDING } from "../../../lib/patterns/socksPatternLanding";

applyKnitAbleCacheHeaders(Astro.response.headers);

const landing = SOCKS_PATTERN_BUILDER_LANDING;
---

<Layout
  title={landing.seo.title}
  description={landing.seo.description}
  bodyClass="page--tight-header"
>
  <Fragment slot="head">
    <link rel="canonical" href={landing.seo.canonicalUrl} />
  </Fragment>

  <PatternBuilderLandingPage content={landing} socksSavedPatternRedirect />
</Layout>
