---
/**
 * Socks Summary — checkpoint between Builder inputs and eventual knitting instructions.
 * Free / ungated. Draft: kbm_socks_draft. Finished Pattern / diagrams / instructions
 * are not part of this pass.
 */
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import Layout from "../../../../layouts/Layout.astro";
import PatternSummaryEditWorkspace from "../../../../components/patterns/PatternSummaryEditWorkspace.astro";
import {
  AVAILABLE_NEEDLES_LABEL,
} from "../../../../lib/patterns/sock/sockAvailableNeedles";
import {
  SOCK_PATTERN_BUILDER_HREF,
  SOCK_SUMMARY_CANCEL_LABEL,
  SOCK_SUMMARY_HINT,
  SOCK_SUMMARY_PATTERN_NOT_READY_MESSAGE,
  SOCK_SUMMARY_PRIMARY_LABEL,
} from "../../../../lib/patterns/sock/sockPatternNavigation";
import { SOCK_PATTERN_MISSING_DRAFT_MESSAGE } from "../../../../lib/patterns/sock/sockPatternFromDraft";
import {
  BASIC_SOCK_PATTERN_NAME,
  SOCK_PATTERN_SYSTEM_DISPLAY_NAME,
} from "../../../../lib/patterns/sock/sockDraft";

import "../../../../styles/wizard.css";
import "../../../../styles/patterns/sleeveless-pattern-shared.css";
import "../../../../styles/patterns/pattern-app-shell.css";

const sockSizingJson = JSON.parse(
  readFileSync(resolve("public/data/sizing_socks.json"), "utf8"),
) as unknown;
---

<Layout
  title="Socks Summary | Knit it Now"
  description="Review your Basic Socks measurements, gauge, and calculated machine-knitting geometry."
  bodyClass="pattern-print-global-footer"
  patternWorkspace={true}
>
  <main
    class="wizard-page sleeveless-pattern-page sleeveless-workspace-subpage pattern-app-shell socks-summary-page"
    data-socks-summary-page
    data-testid="socks-summary-page"
  >
    <div class="wizard-container">
      <div class="calculator-card hat-builder-inputs">
        <div class="hat-pattern-empty" data-socks-summary-empty role="status" hidden>
          <h1 class="hat-pattern-empty__title">{SOCK_PATTERN_SYSTEM_DISPLAY_NAME}</h1>
          <p class="hat-pattern-empty__message" data-socks-summary-empty-message>
            {SOCK_PATTERN_MISSING_DRAFT_MESSAGE}
          </p>
          <a
            href={SOCK_PATTERN_BUILDER_HREF}
            class="kbm-btn kbm-btn-accent"
            data-testid="socks-summary-empty-cta"
          >
            Go to Socks Builder
          </a>
        </div>

        <div
          class="socks-summary-workspace"
          data-socks-summary-workspace
          data-testid="socks-summary-workspace"
          hidden
        >
          <PatternSummaryEditWorkspace
            measurePaneAttr="data-socks-measure-pane"
            actionsAttr="data-socks-summary-actions"
            headingClass="socks-summary-geometry-heading"
          >
            <Fragment slot="heading">Calculated geometry</Fragment>

            <Fragment slot="quick">
              <section class="sl-edit-section" aria-labelledby="socks-summary-basic-heading">
                <h3 class="sl-edit-section__title" id="socks-summary-basic-heading">
                  Basic information
                </h3>
                <dl class="socks-summary-dl">
                  <div class="socks-summary-dl__row">
                    <dt>Pattern</dt>
                    <dd data-socks-summary="patternName">{BASIC_SOCK_PATTERN_NAME}</dd>
                  </div>
                  <div class="socks-summary-dl__row">
                    <dt>Size</dt>
                    <dd data-socks-summary="sizeLabel"></dd>
                  </div>
                  <div class="socks-summary-dl__row">
                    <dt>Construction</dt>
                    <dd data-socks-summary="constructionLabel"></dd>
                  </div>
                  <div class="socks-summary-dl__row">
                    <dt>Units</dt>
                    <dd data-socks-summary="unitsLabel"></dd>
                  </div>
                </dl>
              </section>

              <section class="sl-edit-section" aria-labelledby="socks-summary-measure-heading">
                <h3 class="sl-edit-section__title" id="socks-summary-measure-heading">
                  Finished measurements
                </h3>
                <p class="sl-edit-ease">
                  These are finished measurements. No ease is added.
                </p>
                <dl class="socks-summary-dl">
                  <div class="socks-summary-dl__row">
                    <dt>Foot Circumference</dt>
                    <dd data-socks-summary="footCircumference"></dd>
                  </div>
                  <div class="socks-summary-dl__row">
                    <dt>Foot Length</dt>
                    <dd data-socks-summary="footLength"></dd>
                  </div>
                  <div class="socks-summary-dl__row">
                    <dt>Leg Circumference</dt>
                    <dd data-socks-summary="legCircumference"></dd>
                  </div>
                  <div class="socks-summary-dl__row">
                    <dt>Leg Length</dt>
                    <dd data-socks-summary="legLength"></dd>
                  </div>
                </dl>
              </section>

              <section class="sl-edit-section" aria-labelledby="socks-summary-gauge-heading">
                <h3 class="sl-edit-section__title" id="socks-summary-gauge-heading">Gauge</h3>
                <p class="sl-edit-ease" data-socks-summary="gaugeBasisLabel"></p>
                <dl class="socks-summary-dl">
                  <div class="socks-summary-dl__row">
                    <dt>Stitch gauge</dt>
                    <dd data-socks-summary="stitchGauge"></dd>
                  </div>
                  <div class="socks-summary-dl__row">
                    <dt>Row gauge</dt>
                    <dd data-socks-summary="rowGauge"></dd>
                  </div>
                  <div class="socks-summary-dl__row">
                    <dt>Swatch</dt>
                    <dd data-socks-summary="gaugeLabel"></dd>
                  </div>
                </dl>
              </section>

              <section class="sl-edit-section" aria-labelledby="socks-summary-needles-heading">
                <h3 class="sl-edit-section__title" id="socks-summary-needles-heading">
                  Machine capacity
                </h3>
                <dl class="socks-summary-dl">
                  <div class="socks-summary-dl__row">
                    <dt>Needles required</dt>
                    <dd data-socks-summary="requiredNeedles"></dd>
                  </div>
                  <div class="socks-summary-dl__row">
                    <dt>{AVAILABLE_NEEDLES_LABEL}</dt>
                    <dd data-socks-summary="availableNeedles"></dd>
                  </div>
                </dl>
              </section>
            </Fragment>

            <Fragment slot="notes">
              <p
                class="sl-edit-error-note"
                data-socks-summary-form-error
                hidden
                role="alert"
              >
              </p>
            </Fragment>

            <Fragment slot="actions">
              <a
                href={SOCK_PATTERN_BUILDER_HREF}
                class="sl-edit-btn sl-edit-btn--ghost"
                data-socks-summary-back
                data-testid="button-socks-summary-back"
              >
                {SOCK_SUMMARY_CANCEL_LABEL}
              </a>
              <button
                type="button"
                class="sl-edit-btn sl-edit-btn--primary"
                data-socks-summary-view-pattern
                data-testid="button-socks-summary-view-pattern"
                disabled
                aria-disabled="true"
                title={SOCK_SUMMARY_PATTERN_NOT_READY_MESSAGE}
              >
                {SOCK_SUMMARY_PRIMARY_LABEL}
              </button>
            </Fragment>

            <span slot="hint" data-socks-summary-hint>
              {SOCK_SUMMARY_HINT}
            </span>

            <Fragment slot="diagram">
              <div
                class="socks-summary-geometry"
                data-socks-summary-geometry
                data-testid="socks-summary-geometry"
              >
                <section
                  class="sl-edit-section"
                  aria-labelledby="socks-summary-stitches-heading"
                >
                  <h3 class="sl-edit-section__title" id="socks-summary-stitches-heading">
                    Stitch geometry
                  </h3>
                  <dl class="socks-summary-dl">
                    <div class="socks-summary-dl__row">
                      <dt>Total sock stitches</dt>
                      <dd data-socks-summary="totalSockStitches"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Leg stitches</dt>
                      <dd data-socks-summary="legStitches"></dd>
                    </div>
                  </dl>
                </section>

                <section
                  class="sl-edit-section"
                  aria-labelledby="socks-summary-heel-toe-heading"
                >
                  <h3 class="sl-edit-section__title" id="socks-summary-heel-toe-heading">
                    Heel &amp; Toe Shaping
                  </h3>
                  <p class="sl-edit-ease">
                    Heel and toe use the same short-row geometry.
                  </p>
                  <dl class="socks-summary-dl">
                    <div class="socks-summary-dl__row">
                      <dt>Working stitches</dt>
                      <dd data-socks-summary="workingStitches"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Held stitches</dt>
                      <dd data-socks-summary="heldStitches"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Center stitches remaining</dt>
                      <dd data-socks-summary="remainingStitches"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Short-row shaping (one direction)</dt>
                      <dd data-socks-summary="shortRowShapingRows"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Return to work</dt>
                      <dd data-socks-summary="returnToWorkRows"></dd>
                    </div>
                  </dl>
                  <p class="sl-edit-ease socks-summary-depth-note">
                    Physical heel and toe depth use one-way shaping rows divided by row
                    gauge. Return-to-work rows are not added to depth.
                  </p>
                </section>

                <section
                  class="sl-edit-section"
                  aria-labelledby="socks-summary-length-heading"
                >
                  <h3 class="sl-edit-section__title" id="socks-summary-length-heading">
                    Length &amp; rows
                  </h3>
                  <dl class="socks-summary-dl">
                    <div class="socks-summary-dl__row">
                      <dt>Heel depth</dt>
                      <dd data-socks-summary="heelDepth"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Toe depth</dt>
                      <dd data-socks-summary="toeDepth"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Straight foot length</dt>
                      <dd data-socks-summary="straightFootLength"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Straight foot rows</dt>
                      <dd data-socks-summary="straightFootRows"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Straight ankle</dt>
                      <dd data-socks-summary="ankleStraightLength"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Straight ankle rows</dt>
                      <dd data-socks-summary="ankleStraightRows"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Leg rows</dt>
                      <dd data-socks-summary="legRows"></dd>
                    </div>
                  </dl>
                </section>

                <section
                  class="sl-edit-section"
                  aria-labelledby="socks-summary-leg-heading"
                >
                  <h3 class="sl-edit-section__title" id="socks-summary-leg-heading">
                    Leg shaping
                  </h3>
                  <p
                    class="socks-summary-leg-status"
                    data-socks-summary="legShapingStatus"
                    data-testid="socks-summary-leg-status"
                  >
                  </p>
                  <dl
                    class="socks-summary-dl socks-summary-leg-details"
                    data-socks-summary-leg-details
                    hidden
                  >
                    <div class="socks-summary-dl__row">
                      <dt>Ankle stitches</dt>
                      <dd data-socks-summary="ankleStitches"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Top leg stitches</dt>
                      <dd data-socks-summary="topLegStitches"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Shaping rows</dt>
                      <dd data-socks-summary="legShapingRowsAvailable"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt data-socks-summary="pairedEventLabel">Paired increase events</dt>
                      <dd data-socks-summary="pairedShapingEvents"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Magic Formula</dt>
                      <dd data-socks-summary="magicFormulaSchedule"></dd>
                    </div>
                    <div class="socks-summary-dl__row">
                      <dt>Knitting order</dt>
                      <dd data-socks-summary="knitOrderSummary"></dd>
                    </div>
                  </dl>
                </section>
              </div>
            </Fragment>
          </PatternSummaryEditWorkspace>
        </div>
      </div>
    </div>
  </main>

  <script
    type="application/json"
    id="socks-sizing-chart"
    set:html={JSON.stringify(sockSizingJson)}
  />
</Layout>

<script>
  import "/src/scripts/socks-summary-page.ts";
</script>

<style>
  .hat-pattern-empty {
    max-width: 36rem;
    margin: 1.5rem auto;
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .hat-pattern-empty__title {
    margin: 0 0 0.65rem;
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--kbm-green, #52682d);
  }

  .hat-pattern-empty__message {
    margin: 0 0 1.1rem;
    font-size: 0.98rem;
    line-height: 1.5;
    color: #4b5563;
  }

  .socks-summary-workspace[hidden] {
    display: none;
  }

  .socks-summary-page :global(.sl-edit-btn--ghost) {
    text-decoration: none;
    box-sizing: border-box;
  }

  .socks-summary-page :global(.sl-edit-btn--primary:disabled),
  .socks-summary-page :global(.sl-edit-btn--primary[aria-disabled="true"]) {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .socks-summary-geometry {
    padding: 0.35rem 0.85rem 1.15rem;
  }

  .socks-summary-dl {
    margin: 0;
  }

  .socks-summary-dl__row {
    display: grid;
    grid-template-columns: minmax(7.5rem, 1.4fr) minmax(4rem, 0.8fr);
    gap: 0.35rem 0.85rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid #ece8df;
  }

  .socks-summary-dl__row dt {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: #4b5563;
  }

  .socks-summary-dl__row dd {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: #1f2937;
    text-align: right;
  }

  .socks-summary-leg-status {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #1f2937;
  }

  .socks-summary-leg-details {
    margin-top: 0.75rem;
  }

  .socks-summary-depth-note {
    margin-top: 0.65rem;
  }
</style>
