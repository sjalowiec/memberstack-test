---
/**
 * Dedicated Socks Edit workspace for an EXISTING Basic Socks pattern.
 * Compact choices + gauge; finished measurements are chips on the sock image.
 * Draft: kbm_socks_draft. Update Pattern returns to the finished Pattern page.
 */
import Layout from "../../../../layouts/Layout.astro";
import SleevelessPatternMemberGate from "../../../../components/patterns/SleevelessPatternMemberGate.astro";
import SocksPatternEditWorkspace from "../../../../components/patterns/SocksPatternEditWorkspace.astro";

import "../../../../styles/wizard.css";
import "../../../../styles/patterns/sleeveless-pattern-shared.css";
import "../../../../styles/patterns/pattern-app-shell.css";
import "../../../../styles/patterns/pattern-editable-pencil.css";
---

<Layout
  title="Edit Socks Pattern | Knit it Now"
  description="Edit your custom machine-knit Basic Socks pattern choices, measurements, and gauge."
  bodyClass="pattern-print-global-footer"
  patternWorkspace={true}
>
  <SleevelessPatternMemberGate>
  <main
    class="wizard-page sleeveless-pattern-page sleeveless-workspace-subpage pattern-app-shell socks-edit-page"
    data-socks-edit-page
    data-testid="socks-edit-page"
  >
    <div class="wizard-container">
      <div class="calculator-card hat-builder-inputs">
        <SocksPatternEditWorkspace />
      </div>
    </div>
  </main>
  </SleevelessPatternMemberGate>
</Layout>

<script>
  import "/src/scripts/socks-edit-page.ts";
</script>
