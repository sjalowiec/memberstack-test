---
import Layout from "../../layouts/Layout.astro";
import SleevelessBuilderNav from "../../components/patterns/SleevelessBuilderNav.astro";
import SleevelessGarmentDesignStep from "../../components/patterns/sleeveless/SleevelessGarmentDesignStep.astro";
import "../../styles/wizard.css";
---

<Layout
  title="Design Your Sleeveless Sweater | Knit it Now"
  description="Choose a sizing chart for a straight sleeveless pullover with a round neckline (Version 1). Visual selections update your design summary."
>
  <main class="wizard-page sg-pattern-page">
    <div class="wizard-container">
      <SleevelessBuilderNav currentStep="style" />
      <SleevelessGarmentDesignStep />
    </div>
  </main>
</Layout>
