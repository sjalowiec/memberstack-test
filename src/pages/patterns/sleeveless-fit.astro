---
import Layout from "../../layouts/Layout.astro";
import SleevelessBuilderNav from "../../components/patterns/SleevelessBuilderNav.astro";
import SleevelessGarmentFitStep from "../../components/patterns/sleeveless/SleevelessGarmentFitStep.astro";
import "../../styles/wizard.css";
---

<Layout
  title="Set the Fit for Your Sweater | Knit it Now"
  description="Review your design, pick a size from the chart you chose on the design page, then choose close, standard, or relaxed fit and fine-tune measurements."
>
  <main class="wizard-page sg-fit-page">
    <div class="wizard-container">
      <SleevelessBuilderNav currentStep="fit" />
      <SleevelessGarmentFitStep />
    </div>
  </main>
</Layout>
