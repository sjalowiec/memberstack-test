  function persistPatternInputs() {
    if (!brimTypeSelect && !crownSelect && !fitSelect && !brimLengthInput) return;
    try {
      localStorage.setItem(
        HAT_PATTERN_INPUTS_STORAGE_KEY,
        JSON.stringify({
          brimType: brimTypeSelect?.value ?? '',
          brimLength: brimLengthInput?.value ?? '',
          crownShaping: crownSelect?.value ?? '',
          fit: fitSelect?.value ?? '',
          customHatLength:
            fitSelect?.value === 'custom' && customHatLengthInput
              ? customHatLengthInput.value ?? ''
              : ''
        })
      );
    } catch (_) {
      /* ignore */
    }
  }

  /**
   * Restore brim type, visible brim length, crown, and fit from localStorage. Missing or invalid
   * keys → "" (placeholder), never a default real option. Only keys with valid saved values are applied.
   */
  function loadPatternInputs() {
    const result = {
      restoredBrim: false,
      restoredCrown: false,
      restoredFit: false
    };
    try {
      const raw = localStorage.getItem(HAT_PATTERN_INPUTS_STORAGE_KEY);
      if (!raw || !raw.trim()) return result;
      const o = JSON.parse(raw);
      if (!o || typeof o !== 'object') return result;

      const validFits = new Set(['beanie', 'watchcap', 'slouchy', 'relaxed', 'custom']);

      if (brimTypeSelect) {
        if (o.brimType === 'single' || o.brimType === 'folded') {
          brimTypeSelect.value = o.brimType;
          result.restoredBrim = true;
        } else {
          brimTypeSelect.value = '';
        }
      }

      if (brimLengthInput && typeof o.brimLength === 'string') {
        setCrownDepthFieldValue(brimLengthInput, o.brimLength.trim());
      }

      if (crownSelect) {
        let crownVal =
          typeof o.crownShaping === 'string' ? o.crownShaping.trim() : '';
        if (crownVal === 'wedge-4') crownVal = 'wedge-4-decrease';
        if (crownVal) {
          const match = Array.from(crownSelect.options).find(
            (opt) => opt.value === crownVal && !opt.disabled
          );
          if (match) {
            crownSelect.value = crownVal;
            result.restoredCrown = true;
          } else {
            crownSelect.value = '';
          }
        } else {
          crownSelect.value = '';
        }
      }

      if (fitSelect) {
        const fitVal = typeof o.fit === 'string' ? o.fit.trim() : '';
        if (fitVal && validFits.has(fitVal)) {
          fitSelect.value = fitVal;
          result.restoredFit = true;
          if (fitVal === 'custom' && customHatLengthInput) {
            const cl =
              typeof o.customHatLength === 'string' ? o.customHatLength.trim() : '';
            customHatLengthInput.value = cl;
          } else if (customHatLengthInput) {
            customHatLengthInput.value = '';
          }
          if (fitVal !== 'custom') previousFit = fitVal;
        } else {
          fitSelect.value = '';
          if (customHatLengthInput) customHatLengthInput.value = '';
        }
      }
    } catch (_) {
      /* ignore */
    }
    return result;
  }

