---
import Layout from "../../layouts/Layout.astro";
import ActionBar from "../../components/wizards/ActionBar.astro";
import UnitToggle from "../../components/wizards/UnitToggle.astro";
import GaugeInput from "../../components/wizards/GaugeInput.astro";
import PatternDiagram from "../../components/wizards/PatternDiagram.astro";
import Tooltip from "../../components/Tooltip.astro";
import WhyUseThisToolTooltip from "../../components/common/WhyUseThisToolTooltip.astro";
import PatternPrintFooter from "../../components/common/PatternPrintFooter.astro";
import PatternPrintPersonalization from "../../components/common/PatternPrintPersonalization.astro";
import WizardBackLink from "../../components/wizards/WizardBackLink.astro";
import FloatingInput from "../../components/tools/FloatingInput.astro";
import YarnRequirement from "../../components/tools/YarnRequirement.astro";
import PatternComments from "../../components/patterns/PatternComments.astro";
import PatternHeaderImage from "../../components/patterns/PatternHeaderImage.astro";
import PatternBuilderAccountGate from "../../components/patterns/PatternBuilderAccountGate.astro";
import WarningBox from "../../components/ui/WarningBox.astro";
import glossaryJson from "../../data/glossary.json";
import hatSizingRows from "../../data/sizing_hats.json";

type HatGlossaryRow = { glossaryId?: number; english?: string; example?: string };
const hatGlossaryRows: HatGlossaryRow[] = Array.isArray(glossaryJson) ? (glossaryJson as HatGlossaryRow[]) : [];
const hatGlossary311 = hatGlossaryRows.find((e) => e.glossaryId === 311);
/** Plain text for pattern-term data-tooltip (glossary id 311 example). */
function hatPlainGlossaryExample(raw: string | undefined): string {
  const s = (raw ?? "").trim();
  if (!s) return "";
  if (!/[<>]/.test(s)) return s;
  return s.replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim();
}
const scrapOffPatternTooltip =
  hatPlainGlossaryExample(hatGlossary311?.example) || (hatGlossary311?.english ?? "Scrap Off").trim();

/** Chart JSON circumference = head size (inches). Builder uses 10% negative ease, rounded to 0.5". */
function roundFinishedHatSizeFromHead(headInches: number): number {
  const n = Number(headInches);
  if (!Number.isFinite(n)) return NaN;
  return Math.round(n * 0.9 * 2) / 2;
}

function formatFinishedInchesForLabel(n: number): string {
  if (!Number.isFinite(n)) return "";
  const rounded = Math.round(n * 2) / 2;
  return rounded % 1 === 0 ? String(rounded) : rounded.toFixed(1);
}

const INCH_TO_CM_DISPLAY = 2.54;

/** Head measurement token(s) in inches (e.g. "14", "21–22") → display string for the active unit. */
function formatHeadInchTokenForDisplay(
  cleanInchPart: string,
  displayUnit: "inches" | "cm"
): string {
  if (displayUnit === "inches") return cleanInchPart;
  const parts = cleanInchPart.split(/[\u2013\-]/).map((s) => s.trim()).filter(Boolean);
  if (parts.length === 0) return cleanInchPart;
  const nums = parts.map((p) => {
    const n = parseFloat(p);
    if (!Number.isFinite(n)) return p;
    return String(Math.round(n * INCH_TO_CM_DISPLAY));
  });
  return nums.length === 1 ? nums[0] : nums.join("–");
}

function hatSizeDisplayName(row: (typeof hatSizingRows)[number]): string {
  const ext = row.extended_label || row.label || row.size;
  const withoutHead = ext.replace(/\s*\([^)]*\bhead\b[^)]*\)\s*$/i, "").trim();
  return withoutHead || row.label || row.size;
}

function hatFitsClause(
  row: (typeof hatSizingRows)[number],
  displayUnit: "inches" | "cm" = "inches"
): string | null {
  const ext = row.extended_label || row.label || "";
  const paren = ext.match(/\(([^)]+)\)\s*$/);
  if (paren) {
    const inner = paren[1].trim();
    if (/\bhead\b/i.test(inner)) {
      let headPart = inner.replace(/\s*head\s*$/i, "").trim();
      headPart = headPart.replace(/^approx\.\s*/i, "").trim();
      const clean = headPart.replace(/["″]/g, "").trim();
      if (displayUnit === "inches") {
        return `fits ~${clean}" head`;
      }
      const display = formatHeadInchTokenForDisplay(clean, displayUnit);
      return `fits ~${display} cm head`;
    }
    if (/\blbs\b|\bmonth\b|\bmonths\b|\byear\b|\byears\b/i.test(inner)) {
      return null;
    }
    return null;
  }
  const head = Number(row.circumference);
  if (Number.isFinite(head) && head > 0) {
    if (displayUnit === "inches") {
      const clean = String(head).replace(/["″]/g, "").trim();
      return `fits ~${clean}" head`;
    }
    const cm = Math.round(head * INCH_TO_CM_DISPLAY);
    return `fits ~${cm} cm head`;
  }
  return null;
}

function buildHatSizeOptionLabel(
  row: (typeof hatSizingRows)[number],
  finishedInches: number,
  displayUnit: "inches" | "cm" = "inches"
): string {
  const name = hatSizeDisplayName(row);
  const finStr =
    displayUnit === "inches"
      ? `${formatFinishedInchesForLabel(finishedInches)}"`
      : `${Math.round(finishedInches * INCH_TO_CM_DISPLAY)} cm`;
  const fits = hatFitsClause(row, displayUnit);
  return fits
    ? `${name} — ${finStr} finished (${fits})`
    : `${name} — ${finStr} finished`;
}

const hatSizingBuilderRows = hatSizingRows.map((row) => {
  const finishedSizeInches = roundFinishedHatSizeFromHead(Number(row.circumference));
  return {
    ...row,
    finishedSizeInches,
    optionLabel: buildHatSizeOptionLabel(row, finishedSizeInches),
  };
});

// Import shared wizard styles
import '../../styles/wizard.css';

const whyUseThisTool = '';
const wizardTitle = 'Machine Knit Hat Pattern Builder';
const wizardDescription = 'Design the perfect custom hat with precise sizing, brim options, and crown shaping.';

const patternPersistWarning =
  "This builder creates a temporary pattern — it isn't saved to your account. Print it or download it as a PDF before you leave this page, or your pattern will be gone.";

const hatZeroBodyRowsWarningMessage =
  "Your current settings don't leave any room for the body of the hat. Try increasing the finished hat length, reducing the brim height, or choosing a shallower crown style.";
---

<Layout
  title="Machine Knit Hat Pattern Builder | Knit it Now"
  description="Create a custom machine knit hat pattern with your gauge, size, brim, and crown shaping. Get clear knitting instructions instantly."
  bodyClass="pattern-print-global-footer"
>

<PatternPrintFooter />

<style>
/* Hat-specific styles only */
.back-link {
  display: inline-block;
  color: #52682D;
  text-decoration: none;
  font-weight: 500;
  margin-bottom: 1.5rem;
  padding: 0.5rem 0;
  transition: color 0.2s;
}

.back-link:hover {
  color: #3d4e21;
  text-decoration: underline;
}

/* Pattern term tooltip styling - :global needed for dynamically generated content */
:global(.pattern-term) {
  text-decoration: underline;
  text-decoration-style: dotted;
  text-decoration-color: #52682D;
  text-underline-offset: 2px;
  cursor: help;
  position: relative;
}

:global(.pattern-term)::after {
  content: attr(data-tooltip);
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: #333;
  color: #fff;
  padding: 0.5rem 0.75rem;
  border-radius: 4px;
  font-size: 0.85rem;
  font-style: normal;
  font-weight: normal;
  white-space: normal;
  width: max-content;
  max-width: 280px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s, visibility 0.2s;
  z-index: 100;
  pointer-events: none;
  margin-bottom: 4px;
  line-height: 1.4;
}

:global(.pattern-term):hover::after,
:global(.pattern-term):focus::after {
  opacity: 1;
  visibility: visible;
}

/* Disabled select styling */
select.disabled {
  opacity: 0.5;
  cursor: not-allowed;
  background-color: #f5f5f5;
}

/* Helper text for inputs */
.helper-text {
  display: block;
  font-size: 0.85rem;
  color: #666;
  margin-top: 0.25rem;
  line-height: 1.4;
}

/* Hat builder: grouped form sections (Build tab) — soft blocks, not card-heavy */
.hat-builder-inputs .hat-form-section {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  background: color-mix(in srgb, var(--kbm-green, #52682d) 4.5%, var(--page-bg, #fff));
  border: 1px solid rgba(82, 104, 45, 0.09);
  border-radius: 12px;
  padding: 1.15rem 1.2rem 1.2rem;
  margin-bottom: 1.5rem;
  box-shadow: 0 1px 2px rgba(45, 55, 30, 0.04);
}

@supports not (background: color-mix(in srgb, white, black)) {
  .hat-builder-inputs .hat-form-section {
    background: rgba(82, 104, 45, 0.045);
  }
}

.hat-builder-inputs .hat-form-section:last-of-type {
  margin-bottom: 0;
}

/* Collapse yarn section until the optional trigger is shown */
.hat-builder-inputs .hat-form-section--yarn:has(#hat-yarn-drawer-trigger-wrap[hidden]) {
  display: none;
}

.hat-builder-inputs .tab-panel#tab-build form > .hat-form-section:first-of-type {
  margin-top: 0.85rem;
}

#clear-hat-builder {
  background: none;
  border: none;
  color: #C2614e;
  font-size: 13px;
  text-decoration: underline;
  cursor: pointer;
  padding: 4px 8px;
}

#clear-hat-builder:hover {
  opacity: 0.7;
}

/* Section heading — distinct from field labels (.hat-field__label, floating labels) */
.hat-builder-inputs .hat-form-section__title,
.hat-builder-inputs .hat-form-section__heading {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--kbm-green, #52682d);
  letter-spacing: 0.02em;
  line-height: 1.25;
  margin: 0 0 0.7rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(82, 104, 45, 0.14);
}

/* Optional one-line intro under the section title (add element with this class when needed) */
.hat-builder-inputs .hat-form-section__intro {
  font-size: 0.9rem;
  font-weight: 400;
  color: #6b7280;
  line-height: 1.5;
  margin: -0.35rem 0 0.65rem;
  max-width: 40rem;
}

/* Tighter rhythm inside the block than between sections */
.hat-builder-inputs .hat-form-section .input-group {
  margin-bottom: 0.4rem;
}

.hat-builder-inputs .hat-form-section > .input-group:last-child {
  margin-bottom: 0;
}

.hat-builder-inputs .hat-form-section .hat-builder-custom-subfield {
  margin-top: 0.1rem;
}

.hat-builder-inputs .hat-form-section .helper-text {
  margin-top: 0.2rem;
}

/* Hat length: visual picker (native #fit stays for logic; UI replaces visible dropdown) */
.hat-length-picker-wrap {
  align-items: flex-start;
}

.hat-length-picker__native {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  clip-path: inset(50%);
  white-space: nowrap;
  border: 0;
}

.hat-length-picker__flex-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 0;
}

.hat-length-picker {
  flex: 1;
  min-width: 0;
}

.hat-length-picker__summary {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  margin: 0;
  padding: 10px 12px;
  border: 1px solid #ccc;
  border-radius: 8px;
  background: #fff;
  font: inherit;
  font-size: 1rem;
  line-height: 1.35;
  color: #111;
  text-align: left;
  cursor: pointer;
  transition: border-color 0.15s, box-shadow 0.15s;
}

.hat-length-picker__summary:hover {
  border-color: #aeb79a;
}

.hat-length-picker-wrap.is-complete .hat-length-picker__summary {
  border-color: #52682d;
}

.hat-length-picker__summary-text {
  flex: 1;
  min-width: 0;
}

.hat-length-picker__panel {
  margin-top: 10px;
  padding-top: 2px;
}

.hat-length-picker__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}

.hat-length-picker__option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  margin: 0;
  border: 1px solid #ddd;
  border-radius: 10px;
  background: #fff;
  padding: 8px;
  text-align: center;
  cursor: pointer;
  font: inherit;
  color: inherit;
  transition: border-color 0.15s, background 0.15s;
}

.hat-length-picker__option:hover {
  border-color: #aeb79a;
}

.hat-length-picker__option.is-selected {
  border-color: #52682d;
  background: #f7f9f3;
}

.hat-length-picker__option:disabled,
.hat-length-picker__option[aria-disabled='true'],
.hat-length-picker__option.is-disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

.hat-length-picker__option:disabled:hover,
.hat-length-picker__option[aria-disabled='true']:hover,
.hat-length-picker__option.is-disabled:hover {
  border-color: #ddd;
}

.hat-length-picker__img {
  display: block;
  max-width: 100%;
  height: auto;
}

.hat-brim-picker__grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.hat-brim-picker__img {
  width: 120px;
  max-width: 100%;
  height: auto;
  margin: 0 auto;
}

.hat-crown-picker__img {
  width: 120px;
  max-width: 100%;
  height: auto;
  margin: 0 auto;
}

.hat-brim-preview {
  margin-top: 10px;
}

.hat-brim-preview[hidden] {
  display: none;
}

.hat-length-picker__option-label {
  display: block;
  margin-top: 6px;
  font-size: 0.9rem;
  font-weight: 600;
  line-height: 1.25;
}

.hat-length-picker__custom {
  display: block;
  width: 100%;
  margin: 12px 0 0;
  padding: 8px 10px;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: #52682d;
  font: inherit;
  font-size: 0.9rem;
  font-weight: 600;
  text-align: center;
  text-decoration: underline;
  cursor: pointer;
}

.hat-length-picker__custom:hover {
  color: #3d4e21;
}

@media (max-width: 380px) {
  .hat-length-picker__grid {
    gap: 6px;
  }

  .hat-length-picker__option {
    padding: 4px;
  }
}

@media (max-width: 640px) {
  .hat-length-picker__grid {
    gap: 8px;
  }

  .hat-length-picker__option {
    padding: 6px;
  }

  .hat-builder-inputs .hat-form-section {
    padding: 1.2rem 1.05rem 1.25rem;
    margin-bottom: 1.35rem;
  }

  .hat-builder-inputs .hat-form-section__title,
  .hat-builder-inputs .hat-form-section__heading {
    font-size: 1.08rem;
    margin-bottom: 0.75rem;
  }
}

/* Hat builder: default input stack outside sections (e.g. if any remain) */
.hat-builder-inputs .input-group {
  margin-bottom: 0.55rem;
}

.hat-builder-inputs .hat-form-section--gauge :global(.gauge-input-wrapper) {
  margin-top: 0;
  margin-bottom: 0;
}

/* Needle estimate preview (stitch gauge × finished circumference; same styling as DIY blanket) */
.diy-blanket-needle-result-preview {
  margin: 0.65rem 0 0;
  padding: 0;
}
.diy-blanket-needle-result-preview__line {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 600;
  line-height: 1.35;
  color: #c2644e;
}
.diy-blanket-needle-result-preview__line strong {
  font-weight: 700;
}
.diy-blanket-needle-result-preview__line #needle-count-value-preview {
  font-size: 1.25rem;
  font-weight: 800;
}
.diy-blanket-needle-result-preview__context {
  margin: 0.2rem 0 0;
  font-size: 0.8125rem;
  font-weight: 400;
  line-height: 1.35;
  color: #9ca3af;
}
.diy-blanket-needle-result-preview__context:empty {
  display: none;
}

.hat-builder-inputs :global(.gauge-input-wrapper) {
  margin-top: 0.35rem;
  margin-bottom: 1rem;
}

/* Yarn drawer: presentation styles live on YarnRequirement (yarn--presentation-drawer) */
.hat-yarn-drawer-body :global(.yarn-requirement-tool) {
  margin: 0;
}

.hat-builder-inputs :global(.floating-input) {
  margin-bottom: 0;
}

.hat-builder-inputs :global(.floating-input input) {
  min-height: 52px;
  font-size: 1rem;
}

/* Tab labels: desktop shows text; mobile shows emoji icons (see max-width: 767px block below) */
.hat-builder-inputs .pattern-tab-nav .tab-icon {
  display: none;
}

/* Hat builder only: Pattern tab locked until required build fields are complete */
.hat-builder-inputs .pattern-tab-nav .tab-btn.is-disabled {
  color: #9ca3af;
  opacity: 0.55;
  cursor: not-allowed;
}

.hat-builder-inputs .pattern-tab-nav .tab-btn.is-disabled:hover,
.hat-builder-inputs .pattern-tab-nav .tab-btn.is-disabled:focus-visible {
  color: #9ca3af;
  border-bottom-color: transparent;
  opacity: 0.55;
}

.hat-builder-inputs .pattern-tab-nav .tab-btn.is-disabled.active {
  color: #9ca3af;
  border-bottom-color: transparent;
}

/* Build tab: let the form column use full main width on small screens (parent min-width / flex tracks can squeeze selects). */
@media (max-width: 767px) {
  :global(main.site-content):has(#hat-builder-form-top),
  :global(.pattern-page):has(#hat-builder-form-top),
  :global(.pattern-layout):has(#hat-builder-form-top),
  .wizard-page,
  #hat-builder-form-top.wizard-container,
  .hat-builder-inputs,
  .hat-builder-inputs .pattern-tabs,
  .hat-builder-inputs .pattern-tab-content,
  .hat-builder-inputs .tab-panel#tab-build,
  .hat-builder-inputs #hat-builder-form {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  :global(main.site-content):has(#hat-builder-form-top),
  :global(.pattern-page):has(#hat-builder-form-top),
  :global(.pattern-layout):has(#hat-builder-form-top),
  .wizard-page,
  .hat-builder-inputs .pattern-tabs,
  .hat-builder-inputs .pattern-tab-content,
  .hat-builder-inputs .tab-panel#tab-build {
    overflow-x: visible;
  }

  .hat-builder-inputs .pattern-tab-nav .tab-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    line-height: 1;
  }

  .hat-builder-inputs .pattern-tab-nav .tab-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hat-builder-inputs .pattern-tab-nav .tab-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0;
  }
}

#create-pattern-btn.button-disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.create-pattern-feedback {
  margin: 0.75rem 0 0;
  min-height: 1.25em;
  font-size: 0.9375rem;
  color: #6b7280;
}

/* Main page header: example photo + title (single intro for the whole wizard) */
.hat-builder-page-header {
  display: flex;
  gap: 24px;
  align-items: flex-start;
  text-align: left;
}

.hat-builder-page-header__media {
  flex-shrink: 0;
  max-width: min(420px, 100%);
  width: 100%;
}

.hat-builder-page-header__main {
  flex: 1;
  min-width: 0;
}

.hat-builder-page-header .page-header-title {
  justify-content: flex-start;
  margin-bottom: 0.5rem;
}

.hat-builder-page-header__main h1 {
  text-align: left;
  margin: 0 0 0.5rem 0;
}

.hat-builder-page-header__subtitle {
  text-align: left;
  margin: 0;
  color: #6b7280;
  font-size: 1.05rem;
  line-height: 1.6;
}

@media (max-width: 640px) {
  .hat-builder-page-header {
    flex-direction: column;
    align-items: stretch;
  }

  .hat-builder-page-header__media {
    max-width: 100%;
  }

  .hat-builder-page-header .page-header-title {
    justify-content: center;
  }

  .hat-builder-page-header__main h1,
  .hat-builder-page-header__subtitle {
    text-align: center;
  }

}

.inspiration-section {
  margin-top: 20px;
}

.inspiration-heading {
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 12px;
}

.pinterest-embed {
  display: flex;
  justify-content: center;
  width: 100%;
  overflow: hidden;
}

@media (max-width: 768px) {
  .pinterest-embed a {
    transform: scale(0.9);
    transform-origin: top center;
  }
}

.hat-pinterest-fallback-link {
  margin: 12px 0 0;
  font-size: 0.95rem;
}

.hat-pinterest-fallback-link a {
  color: var(--kbm-green, #52682d);
}

/* Subtle indent: custom numeric fields read as sub-fields of the custom dropdown choice */
.hat-builder-inputs .hat-builder-custom-subfield {
  padding-left: 14px;
  box-sizing: border-box;
}

/* Hat size select: site green for accent/focus; option colors where browsers allow */
#hat-size {
  accent-color: var(--kbm-green, #52682D);
}

/* Avoid styling option:checked on native <select>: Chromium can paint the wrong closed label. */

#hat-size option:hover,
