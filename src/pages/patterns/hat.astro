  const HAT_GAUGE_SLOTS_KEY = 'hat-builder-gauge-slots';
  const IN_TO_CM_GAUGE = 2.54;
  /** Stitches/rows per 4" ↔ per 10 cm (same fabric density) */
  const GAUGE_IN_TO_CM_FACTOR = 10 / (4 * IN_TO_CM_GAUGE);
  const GAUGE_CM_TO_IN_FACTOR = (4 * IN_TO_CM_GAUGE) / 10;

  function emptyHatGaugeSlot() {
    return { stitch: '', row: '' };
  }

  function loadHatGaugeSlots() {
    try {
      const raw = localStorage.getItem(HAT_GAUGE_SLOTS_KEY);
      if (!raw) return { inches: emptyHatGaugeSlot(), cm: emptyHatGaugeSlot() };
      const o = JSON.parse(raw);
      return {
        inches: {
          stitch: String(o.inches?.stitch ?? ''),
          row: String(o.inches?.row ?? ''),
        },
        cm: {
          stitch: String(o.cm?.stitch ?? ''),
          row: String(o.cm?.row ?? ''),
        },
      };
    } catch (_) {
      return { inches: emptyHatGaugeSlot(), cm: emptyHatGaugeSlot() };
    }
