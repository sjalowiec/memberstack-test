  function setHatZeroBodyWarningVisible(visible) {
    const el = document.getElementById('hat-zero-body-warning');
    if (!el) return;
    if (visible) el.removeAttribute('hidden');
    else el.setAttribute('hidden', '');
  }

  // Calculate Function
  function calculate() {
    console.log('calculate started');
    const currentUnit = unitStore.get();

    // Finished hat body circumference: standard sizes use precomputed finishedSizeInches (head × 0.9, rounded); custom = direct finished size
    let finishedCircRaw = 0;

    const hatSizeValue = hatSizeSelect.value;
    if (hatSizeValue === 'custom') {
      finishedCircRaw = parseFloat(customCircInput.value) || 0;
    } else if (hatSizeValue) {
      const selectedSize = hatSizingData.find((s) => s.size === hatSizeValue);
      if (selectedSize) {
        finishedCircRaw = selectedSize.finishedSizeInches;
      }
    }
    
    // Get other inputs
    const crown = crownSelect.value;
    const fit = fitSelect.value;
    const stitchGauge = parseFloat(stitchGaugeInput.value) || 0;
    const rowGauge = parseFloat(rowGaugeInput.value) || 0;
    
    function abortIncomplete() {
      hideResults(resultsVisibilityConfig);
      const printFooterEl = document.querySelector(resultsVisibilityConfig.printFooterSelector);
      if (printFooterEl) printFooterEl.style.display = 'none';
      setHatZeroBodyWarningVisible(false);
    }

    if (!requiredPatternInputsComplete()) {
      abortIncomplete();
      return;
    }

    // Convert to inches for calculations
    // Standard sizes: finishedSizeInches is already in inches (ease baked into chart row)
    // Custom: convert when display unit is cm
    let finishedHatCircInches;
    if (hatSizeValue === 'custom') {
      finishedHatCircInches =
        currentUnit === 'inches'
          ? finishedCircRaw
          : convertLength(finishedCircRaw, 'cm', 'inches');
    } else {
      finishedHatCircInches = finishedCircRaw;
    }

    const stGaugePerInch = gaugeToPerUnit(stitchGauge, currentUnit);
    const rowGaugePerInch = gaugeToPerUnit(rowGauge, currentUnit);

    // Body width = finished circumference (chart applies 10% negative ease vs head; custom is direct)
    const targetWidth = finishedHatCircInches;
    const castOnSts = roundToEvenPreferUp(targetWidth * stGaugePerInch);
    
    const totalHatLength = resolveTotalHatLengthInches(fit, hatSizeValue, currentUnit);
    if (totalHatLength == null || totalHatLength <= 0) {
      abortIncomplete();
      return;
    }
    const hatHeight = totalHatLength;
    
    const brimLengthRaw = parseFloat(brimLengthInput.value) || 0;
    const brimDepth =
      currentUnit === 'inches'
        ? brimLengthRaw
        : convertLength(brimLengthRaw, 'cm', 'inches');
    const selectedSizeRow =
      hatSizeValue && hatSizeValue !== 'custom'
        ? hatSizingData.find((s) => s.size === hatSizeValue)
        : null;
    const suggestedCrownDepth = Number(
      selectedSizeRow?.suggestedCrownDepth ?? selectedSizeRow?.defaultCrownDepth
    );
    const crownPlan = buildHatCrownPlan({
      crown,
      finishedHatLength: hatHeight,
      suggestedCrownDepth: Number.isFinite(suggestedCrownDepth) ? suggestedCrownDepth : 0,
      castOnStitches: castOnSts,
      rowGaugePerInch,
    });
    const crownHeightInches = Math.max(0, crownPlan.crownDepth);
    const brimType = brimTypeSelect?.value === 'folded' ? 'folded' : 'single';
    const brimRows =
      brimType === 'folded'
        ? roundToEvenPreferUp(brimDepth * 2 * rowGaugePerInch)
        : roundToEvenPreferUp(brimDepth * rowGaugePerInch);
    const crownRowCount =
      crown === 'spiral'
        ? Math.max(0, crownPlan.crownRows)
        : roundToEvenPreferUp(crownHeightInches * rowGaugePerInch);
    
    // Calculate body height: total height minus brim minus crown
    const bodyHeightInches = Math.max(0, crownPlan.bodyLength - brimDepth);
    const bodyRows = roundToEvenPreferUp(bodyHeightInches * rowGaugePerInch);
    
    // Generate pattern
    const patternCalc = {
      targetWidth,
      castOnSts,
      hatHeight,
      brimDepth,
      brimRows,
      brimType,
      bodyRows,
      crownRowCount,
      bodyHeightInches,
      crownHeightInches,
      crownPlan,
      crown,
      fit,
      stGaugePerInch,
      rowGaugePerInch,
      stitchGaugeRaw: stitchGauge,
      rowGaugeRaw: rowGauge
    };
    generatePattern(patternCalc);
    setHatZeroBodyWarningVisible(bodyRows <= 0);
    console.log('[hat-builder debug] pattern data (after generatePattern)', {
      finishedHatCircInches,
      targetWidth,
      castOnSts,
      hatHeight,
      brimDepth,
      brimRows,
      brimType,
      bodyRows,
      crownRowCount,
      bodyHeightInches,
      crownHeightInches,
      crown,
      fit,
      stGaugePerInch,
      rowGaugePerInch,
      stitchGaugeRaw: stitchGauge,
      rowGaugeRaw: rowGauge,
      fourWedgeCrownSetup: patternCalc.fourWedgeCrownSetup,
    });

    // Yarn estimator: same numbers as Finished Measurements (targetWidth = finished body circumference)
    const yarnLengthUnit = currentUnit === 'inches' ? 'in' : 'cm';
    const yarnProjectWidth =
      yarnLengthUnit === 'in'
        ? targetWidth
        : convertLength(targetWidth, 'inches', 'cm');
    const yarnProjectLength =
      yarnLengthUnit === 'in'
        ? hatHeight
        : convertLength(hatHeight, 'inches', 'cm');
    window.dispatchEvent(
      new CustomEvent('kbm:yarnDimensions', {
        detail: {
          projectWidth: yarnProjectWidth,
          projectLength: yarnProjectLength,
          lengthUnit: yarnLengthUnit,
          source: 'custom',
        },
      })
    );
    
    // Show results (pattern content updates in the Pattern tab; tab switch only via Create My Pattern)
    {
      const resultsEl = document.querySelector(resultsVisibilityConfig.resultsSelector);
      const patternTabNav = document.getElementById('hat-tab-pattern');
      console.log('[hat-builder debug] before showResults', {
        showResults: typeof showResults,
        resultsContainerDisplayState: resultsEl ? resultsEl.style.display : '(no results el)',
        patternTabIsDisabledClass: patternTabNav
          ? patternTabNav.classList.contains('is-disabled')
          : '(no pattern tab el)',
        patternTabAriaDisabled: patternTabNav?.getAttribute('aria-disabled') ?? '(n/a)',
        activateWizardTabPatternNote:
          'activateWizardTab("pattern") runs in Create button handler after calculate() returns',
      });
    }
    showResults(resultsVisibilityConfig);

    // Update print summary
    updatePrintSummary({
      headCirc: finishedCircRaw,
      brimDepth,
      crownDepthInches: crownHeightInches,
      crownPlan,
      crown,
      fit,
      hatHeight,
      stitchGauge,
      rowGauge,
      isCustom: hatSizeSelect.value === 'custom',
      isCustomLength: fit === 'custom',
      currentUnit
    });
  }
  
  function updatePrintSummary(data) {
    const {
      headCirc,
      brimDepth,
      crownDepthInches,
      crownPlan,
      crown,
      fit,
      hatHeight,
      stitchGauge,
      rowGauge,
      isCustom,
      isCustomLength,
      currentUnit
    } = data;
    
    // Size display
    const sizeLabel = isCustom
      ? `Custom — ${headCirc}${currentUnit === 'inches' ? '"' : ' cm'}`
      : hatSizeSelect.value && hatSizeSelect.selectedIndex >= 0
        ? hatSizeSelect.options[hatSizeSelect.selectedIndex].text
        : '—';
    document.getElementById('print-size').textContent = `Hat size: ${sizeLabel}`;
    
    const displayBrimLen =
      currentUnit === 'inches'
        ? formatLength(brimDepth, 'inches')
        : formatLength(convertLength(brimDepth, 'inches', 'cm'), 'cm');
    const displayCrownDep =
      currentUnit === 'inches'
        ? formatLength(crownDepthInches, 'inches')
        : formatLength(convertLength(crownDepthInches, 'inches', 'cm'), 'cm');
    const unitSuffix = currentUnit === 'inches' ? '"' : ' cm';
    document.getElementById('print-brim').textContent = `Visible Brim Height: ${displayBrimLen}${unitSuffix}`;

    // Crown display
    const crownLabels = {
      gathered: 'Gathered (cinched top)',
      'wedge-4-decrease': '4-Wedge Decrease',
      'wedge-4': '4-Wedge Decrease',
      spiral: 'Spiral Crown (Smooth, Continuous)',
    };
    const crownPrintLabel = crownLabels[crown] ?? crown;
    const displayBeginAt =
      currentUnit === 'inches'
        ? formatLength(crownPlan.bodyLength, 'inches')
        : formatLength(convertLength(crownPlan.bodyLength, 'inches', 'cm'), 'cm');
    document.getElementById('print-crown').textContent =
      `Crown: ${crownPrintLabel} — Calculated crown depth: ${displayCrownDep}${unitSuffix}. Begin crown shaping at ${displayBeginAt}${unitSuffix} from cast-on edge.`;
    
    // Hat length display
    let lengthLabel;
    if (isCustomLength) {
      const displayHeight = currentUnit === 'inches' 
        ? hatHeight 
        : convertLength(hatHeight, 'inches', 'cm');
      lengthLabel = `Custom — ${displayHeight.toFixed(1)}${currentUnit === 'inches' ? '"' : ' cm'}`;
    } else {
      const fitLabels = {
        beanie: 'Beanie (7" finished hat length)',
        watchcap: 'Classic (8.5" finished hat length)',
        slouchy: 'Slouchy (10" finished hat length)',
        relaxed: 'Relaxed (9" finished hat length)'
      };
      lengthLabel = fit ? fitLabels[fit] : '—';
    }
    document.getElementById('print-fit').textContent = `Finished Hat Length: ${lengthLabel}`;
    
    // Gauge display (matches active measurement unit)
    const gaugeRefPrint = currentUnit === 'inches' ? '4"' : '10 cm';
    document.getElementById('print-gauge').textContent = `Gauge: ${stitchGauge} sts / ${rowGauge} rows per ${gaugeRefPrint}`;
  }
  
  function generatePattern(calc) {
    const currentUnit = unitStore.get();
    const {
      targetWidth,
      castOnSts,
      hatHeight,
      brimDepth,
      brimRows,
      brimType,
      bodyRows,
      crownRowCount,
      crown,
      fit,
      stGaugePerInch,
      rowGaugePerInch,
      stitchGaugeRaw,
      rowGaugeRaw,
      bodyHeightInches,
      crownHeightInches,
      crownPlan,
    } = calc;

    // Finished body circumference (same as targetWidth; chart + custom are finished size)
    const displayWidth = currentUnit === 'inches'
      ? formatLength(targetWidth, 'inches')
      : formatLength(convertLength(targetWidth, 'inches', 'cm'), 'cm');
    
    const displayHeight = currentUnit === 'inches'
      ? formatLength(hatHeight, 'inches')
      : formatLength(convertLength(hatHeight, 'inches', 'cm'), 'cm');
    
    const displayBrimDepth = currentUnit === 'inches'
      ? formatLength(brimDepth, 'inches')
      : formatLength(convertLength(brimDepth, 'inches', 'cm'), 'cm');
    const displayCrownDepth = currentUnit === 'inches'
      ? formatLength(crownPlan.crownDepth, 'inches')
      : formatLength(convertLength(crownPlan.crownDepth, 'inches', 'cm'), 'cm');
    const displayCrownStartLength = currentUnit === 'inches'
      ? formatLength(crownPlan.bodyLength, 'inches')
      : formatLength(convertLength(crownPlan.bodyLength, 'inches', 'cm'), 'cm');

    const crownStartRow = brimRows + bodyRows;

    const unit = currentUnit === 'inches' ? 'inches' : 'cm';
    
    const brimInstructionHtml =
      'Work even in your chosen brim treatment — for example 1x1 or 2x2 ribbing or <span class="pattern-term" data-tooltip="Stitch pattern that copies knit and purl ribbing by having needles out of work. A favorite for knitters without a ribber.">mock ribbing</span>, a rolled stockinette edge, a fold-up band, or a <span class="pattern-term" data-tooltip="A folded, double-layer hem formed by hanging the cast-on stitches back onto the needles.">hung hem</span> — for the depth shown.';
    
    // Adjusted cast-on for wedge crown sizes (diagram + cast-on line only; crown text is unified below)
    const patternCastOnSts = applyHatCrownCastOnAdjustment(castOnSts, crown);

    // 4 wedge crown setup
    // stitch count must be divisible by 4
    if (crown === 'wedge-4-decrease') {
      const adjustedCastOnStitches = patternCastOnSts;
      const wedgeStitchCount = adjustedCastOnStitches / 4;
      // map 4 wedge crown stitches to actual needles
      // never output needle 0
      const N = adjustedCastOnStitches;
      const wedgeNeedleRanges = buildFourWedgeNeedleRanges(N, wedgeStitchCount);
      const scrapOffEndIdx = 3 * wedgeStitchCount - 1;
      const firstWedgeStartIdx = 3 * wedgeStitchCount;
      const firstWedgeEndIdx = N - 1;
      // simplify scrap-off display to a single L→R range for readability
      const scrapOffDisplayRange = `${hatCastOnNeedleAtIndex(0, N).label} to ${hatCastOnNeedleAtIndex(scrapOffEndIdx, N).label}`;
      calc.fourWedgeCrownSetup = {
        baseCastOnStitches: castOnSts,
        adjustedCastOnStitches,
        castOnAdjustedFromBase: adjustedCastOnStitches !== castOnSts,
        wedgeStitchCount,
        scrapOffStitchCount: adjustedCastOnStitches - wedgeStitchCount,
        crownStartRow: brimRows + bodyRows,
        wedgeNeedleRanges,
        scrapOffDisplayRange,
        firstWedgeDisplayRange: formatHatWedgeNeedleDisplayRange(
          firstWedgeStartIdx,
          firstWedgeEndIdx,
          N
        ),
      };
    } else {
      calc.fourWedgeCrownSetup = null;
    }

    if (typeof window !== 'undefined') {
      window.hatPatternLastCalc = calc;
    }

    const crownHeading =
      crown === 'wedge-4-decrease' && calc.fourWedgeCrownSetup
        ? 'Crown Setup'
        : 'Crown Decrease';
    const breakYarnTailPhrase =
      currentUnit === 'inches'
        ? 'a 12" tail'
        : `a ${Math.round(convertLength(12, 'inches', 'cm'))} cm tail`;

    function buildSpiralCrownInstructions(startStitches, crownStartRowNumber, spiralPlan) {
      const transferStepDefinition =
        '<p class="pattern-transfer-step"><span class="instruction-tag"><span class="icon">↔</span> [Transfer Step]</span> Using a garter bar or the method of your choice, transfer all stitches to fill emptied needles and knit across the row.</p>';
      const transferMarker =
        '<span class="instruction-tag"><span class="icon">↔</span> [Transfer]</span>';
      const buildRowInstruction = (rowNumber, instruction) =>
        `<p class="pattern-row-instruction"><span class="pattern-row-check" aria-hidden="true"></span><strong class="pattern-row-label">Row ${rowNumber}:</strong> ${instruction}</p>`;
      const stitchesRemovedPerDecreaseRow = spiralPlan.decreasePoints;
      const targetFinalStitches = spiralPlan.targetStitches;

      let currentStitches = startStitches;
      /** @type {string[]} */
      const lines = [
        transferStepDefinition,
        `<p>Plan ${spiralPlan.decreaseRows} decrease rows across ${spiralPlan.crownRows} crown rows: ${spiralPlan.gradual} decreases every other row, then ${spiralPlan.rapid} decreases every row.</p>`,
      ];

      for (let i = 0; i < spiralPlan.gradual && currentStitches > targetFinalStitches; i += 1) {
        const rowNumber = crownStartRowNumber + i * 2;
        const spacing = Math.max(
          0,
          Math.floor(currentStitches / stitchesRemovedPerDecreaseRow) - 1
        );
        const nextStitches = Math.max(
          targetFinalStitches,
          currentStitches - stitchesRemovedPerDecreaseRow
        );
        const decreaseInstruction = `Count ${spacing} needles, transfer the next stitch to the needle on the left, and repeat across the row.`;
        lines.push(
          buildRowInstruction(
            rowNumber,
            `${decreaseInstruction} ${transferMarker} (${nextStitches} stitches)`
          )
        );
        currentStitches = nextStitches;
      }
      for (let i = 0; i < spiralPlan.rapid && currentStitches > targetFinalStitches; i += 1) {
        const rowNumber = crownStartRowNumber + spiralPlan.gradualRows + i;
        const spacing = Math.max(
          0,
          Math.floor(currentStitches / stitchesRemovedPerDecreaseRow) - 1
        );
        const nextStitches = Math.max(
          targetFinalStitches,
          currentStitches - stitchesRemovedPerDecreaseRow
        );
        const decreaseInstruction = `Count ${spacing} needles, transfer the next stitch to the needle on the left, and repeat across the row.`;
        lines.push(
          buildRowInstruction(
            rowNumber,
            `${decreaseInstruction} ${transferMarker} (${nextStitches} stitches)`
          )
        );
        currentStitches = nextStitches;
      }

      lines.push('<p>Gather the remaining stitches and secure.</p>');

      return lines.join('\n');
    }

    // Crown decrease instructions
    /** @type {string} */
    let crownInstructions = '';
    /** @type {string} */
    let crownSectionsHtml = '';
    if (crown === 'wedge-4-decrease' && calc.fourWedgeCrownSetup) {
      const fws = calc.fourWedgeCrownSetup;
      const {
        wedgeStitchCount,
        scrapOffStitchCount,
        scrapOffDisplayRange,
        firstWedgeDisplayRange,
        castOnAdjustedFromBase,
        wedgeNeedleRanges,
      } = fws;
      const adjustNote = castOnAdjustedFromBase
        ? '<p>The stitch count was adjusted so the crown can be divided evenly into 4 wedges.</p>'
        : '';
      const finalWedgeStitchCount = wedgeStitchCount % 2 === 1 ? 1 : 2;
      const decreaseCount = (wedgeStitchCount - finalWedgeStitchCount) / 2;
      const rowFrequency =
        decreaseCount > 0
          ? Math.max(1, Math.round(crownRowCount / decreaseCount))
          : 1;
      const rowFrequencyPhrase =
        rowFrequency === 1 ? 'every 1 row' : `every ${rowFrequency} rows`;
      const wedgeFinishLine = `<p>When ${finalWedgeStitchCount} ${finalWedgeStitchCount === 1 ? 'stitch remains' : 'stitches remain'}, break yarn and secure.</p>`;
      const wedgeShapingBlock =
        decreaseCount > 0
          ? `<p>Decrease 1 stitch at each edge ${rowFrequencyPhrase}, ${decreaseCount} times.</p>
      ${wedgeFinishLine}`
          : wedgeFinishLine;
      const [, w2r, w3r, w4r] = wedgeNeedleRanges;
      const wedgeCrownBody = (html) =>
        `<div class="pattern-wedge-crown-body">${html}</div>`;
      const scrapOffFirstUseHtml = `<span class="pattern-term" data-tooltip="${escapePatternTermAttr(scrapOffPatternTooltip)}">Scrap off</span>`;
      const introHtml = `
      <p>The stitches are divided into 4 equal wedges of ${wedgeStitchCount} stitches each.</p>
      ${adjustNote}
      <p>${scrapOffFirstUseHtml} ${scrapOffStitchCount} stitches from needles ${scrapOffDisplayRange}.</p>`;
      const wedge1Html = wedgeCrownBody(`<p>Knit Wedge 1 over ${wedgeStitchCount} stitches on needles ${firstWedgeDisplayRange}.</p>
      ${wedgeShapingBlock}`);
      const wedge2Html = wedgeCrownBody(`<p>Pick up and rehang ${wedgeStitchCount} stitches from needles ${w2r.displayRange} back onto those same needles.</p>
      ${wedgeShapingBlock}`);
      const wedge3Html = wedgeCrownBody(`<p>Pick up and rehang ${wedgeStitchCount} stitches from needles ${w3r.displayRange} back onto those same needles.</p>
      ${wedgeShapingBlock}`);
      const wedge4Html = wedgeCrownBody(`<p>Pick up and rehang ${wedgeStitchCount} stitches from needles ${w4r.displayRange} back onto those same needles.</p>
      ${wedgeShapingBlock}`);
      crownSectionsHtml = [
        wrapHatPatternSection('crown-intro', '<h4>Crown setup</h4>', introHtml),
        wrapHatPatternSection('crown-wedge-1', '<h4>Wedge 1</h4>', wedge1Html),
        wrapHatPatternSection('crown-wedge-2', '<h4>Wedge 2</h4>', wedge2Html),
        wrapHatPatternSection('crown-wedge-3', '<h4>Wedge 3</h4>', wedge3Html),
        wrapHatPatternSection('crown-wedge-4', '<h4>Wedge 4</h4>', wedge4Html),
      ].join('\n');
    } else if (crown === 'spiral') {
      const spiralPlan = crownPlan.spiral || {
        decreasePoints: 6,
        targetStitches: 6,
        decreaseRows: 0,
        gradual: 0,
        rapid: 0,
        gradualRows: 0,
        rapidRows: 0,
        crownRows: 0,
      };
      crownInstructions = `
      <figure class="pattern-diagram">
        <img src="/images/hats/spiral_shaping.jpg" alt="Spiral crown shaping with 6 evenly spaced decrease points forming wedges" />
        <figcaption>Spiral crown shaping: 6 evenly spaced decrease points worked across the row.</figcaption>
      </figure>
      ${buildSpiralCrownInstructions(patternCastOnSts, crownStartRow, spiralPlan)}`;
    } else if (crown === 'gathered') {
      crownInstructions = `
      <p>Transfer every other needle to its neighbor, leaving emptied needles out of work.</p>
      <div class="pattern-tip" data-tip data-tip-id="hat-crown-seaming-edges"><strong>Tip:</strong> Keep 2 stitches in work on each edge for seaming.</div>
      <p>After knitting the full hat length, break the yarn, leaving ${breakYarnTailPhrase}.</p>
      <p>Use a darning needle to run the yarn tail through the remaining live stitches and draw closed.</p>
    `;
    } else {
      crownInstructions = `
      <p>Transfer every other needle to its neighbor, leaving emptied needles out of work.</p>
      <div class="pattern-tip" data-tip data-tip-id="hat-crown-seaming-edges"><strong>Tip:</strong> Keep 2 stitches in work on each edge for seaming.</div>
      <p>Knit ${crownRowCount} rows.</p>
      <p>Break yarn, leaving ${breakYarnTailPhrase}.</p>
    `;
    }

    if (!crownSectionsHtml) {
      crownSectionsHtml = wrapHatPatternSection(
        'crown',
        `<h4>${crownHeading}</h4>`,
        crownInstructions
      );
    }

    const finishingGathered = `
        <p>Block the hat to set the shape.</p>
      <p>Pull the tail tight to gather the top of the hat.</p>
      <p>Use the tail to seam the body.</p>
      <p>Work in yarn ends.</p>`;
    const finishingSpiral = `
      <p>Run the end of the yarn through the remaining stitches, tighten and tie off, leaving a tail to sew the seam. Finish with a pompom or tassel if you choose.</p>
      <p>Seam the body using <span class="pattern-term" data-tooltip="An invisible, right-side seaming method that joins two edges neatly.">mattress stitch</span> or your preferred method. <span class="pattern-term" data-tooltip="Wet or steam to set the finished shape.">Block</span> if desired and weave in all ends.</p>`;
    const finishingWedgeSeamed = `
      <p>Seam each crown wedge first, then seam the body using <span class="pattern-term" data-tooltip="An invisible, right-side seaming method that joins two edges neatly.">mattress stitch</span> or your preferred method. <span class="pattern-term" data-tooltip="Wet or steam to set the finished shape.">Block</span> if desired and weave in all ends.</p>`;
    const finishingHtml =
      crown === 'gathered'
        ? finishingGathered
        : crown === 'spiral'
          ? finishingSpiral
          : finishingWedgeSeamed;
    
    // Pattern HTML — ON: full intro tip + Hide link; OFF: quiet “Show pattern tips” row only
    const savedShowTipsForBtn = localStorage.getItem('hat-show-tips') === 'true';
    const renderControl = window.kbmPatternTipsControlBoxHtml;
    const tipsIntroSlotHtml = `<div class="pattern-tips-intro-slot">${
      typeof renderControl === 'function' ? renderControl(savedShowTipsForBtn) : ''
    }</div>`;
    const brimDeeperBodyTipHtml =
      bodyRows > 0
        ? `<div class="pattern-tip" data-tip data-tip-id="hat-deeper-brim"><strong>Tip:</strong> Want a deeper brim? Knit extra brim rows before continuing to the body.</div>`
        : '';
    const bodySectionWrapped =
      bodyRows > 0
        ? wrapHatPatternSection(
            'body',
            '<h4>Body</h4>',
            `<p>Work ${bodyRows} rows in pattern after the brim.</p>`
          )
        : '';
    const patternHTML = `
      ${tipsIntroSlotHtml}
      ${wrapHatPatternSection(
        'measurements',
        '<h4>Finished measurements</h4>',
        `<div class="highlight-box">
        <p>Finished hat circumference (body): ${displayWidth} ${unit}</p>
        <p>Finished Hat Length: ${displayHeight} ${unit} | Visible Brim Height: ${displayBrimDepth} ${unit}</p>
      </div>`
      )}
      ${wrapHatPatternSection(
        'gauge',
        '<h4>Gauge (from your swatch)</h4>',
        `<p>${stitchGaugeRaw} stitches & ${rowGaugeRaw} rows per ${currentUnit === 'inches' ? '4"' : '10 cm'}</p>`
      )}
      ${wrapHatPatternSection(
        'cast-on',
        '<h4>Cast-On</h4>',
        `<p>Cast on <strong>${patternCastOnSts} stitches</strong>.</p>
      <div class="pattern-tip" data-tip data-tip-id="hat-cast-on-method"><strong>Tip:</strong> Use the cast-on method of your choice.</div>`
      )}
      ${wrapHatPatternSection(
        'brim',
        `<h4>Visible Brim Height (${displayBrimDepth} ${unit})</h4>`,
        `<p>Work ${brimRows} rows:</p>
      ${brimType === 'folded' ? '<div class="pattern-tip" data-tip data-tip-id="hat-folded-brim-length"><strong>Tip:</strong> This length includes extra rows for folding.</div>' : ''}
      <p>${brimInstructionHtml}</p>
      ${brimDeeperBodyTipHtml}`
      )}
      ${bodySectionWrapped}
      ${wrapHatPatternSection(
        'crown-timing',
        '<h4>Crown depth &amp; start</h4>',
        `<p><strong>Calculated crown depth: ${displayCrownDepth} ${unit}.</strong></p>
      <p><strong>Begin crown shaping when hat measures ${displayCrownStartLength} ${unit} from the cast-on edge.</strong></p>
      <p>${crownPlan.note}</p>`
      )}
      ${crownSectionsHtml}
      ${wrapHatPatternSection('finishing', '<h4>Finishing</h4>', finishingHtml)}
    `;
    
    updateHTML('#pattern-content', patternHTML);
    patternContent.dataset.showTips = savedShowTipsForBtn ? 'true' : 'false';
    window.dispatchEvent(new CustomEvent('kbm:hat-pattern-rendered'));
    applyHatPatternSectionCollapseState(patternContent);

    // Generate diagram
    generateDiagram(calc);
  }
  
  async function generateDiagram(calc) {
    const currentUnit = unitStore.get();
    const { hatHeight, brimDepth, targetWidth, castOnSts, brimRows, bodyRows, crown, crownRowCount, bodyHeightInches, crownHeightInches, stGaugePerInch } = calc;
    
    // Format values with units
    const displayWidth = formatLengthWithUnit(
      currentUnit === 'inches' ? targetWidth : convertLength(targetWidth, 'inches', currentUnit),
      currentUnit
    );
    
    const displayHeight = formatLengthWithUnit(
      currentUnit === 'inches' ? hatHeight : convertLength(hatHeight, 'inches', currentUnit),
      currentUnit
    );
    
    const displayBrimDepth = formatLengthWithUnit(
      currentUnit === 'inches' ? brimDepth : convertLength(brimDepth, 'inches', currentUnit),
      currentUnit
    );
    
    const displayBodyHeight = formatLengthWithUnit(
      currentUnit === 'inches'
        ? bodyHeightInches
        : convertLength(bodyHeightInches, 'inches', currentUnit),
      currentUnit
    );
    
    const displayCrownDepth = formatLengthWithUnit(
      currentUnit === 'inches'
        ? crownHeightInches
        : convertLength(crownHeightInches, 'inches', currentUnit),
      currentUnit
    );
    
    const displayCastOnSts = applyHatCrownCastOnAdjustment(castOnSts, crown);

    const isWedgeCrown = crown === 'wedge-4' || crown === 'wedge-4-decrease';

    let wedgeStsLabel = '';
    let wedgeWidthLabel = '';

    if (isWedgeCrown && castOnSts) {
      const wedgeSts = Math.round(castOnSts / 4);

      const finishedWidth = targetWidth || (castOnSts / stGaugePerInch);
      const wedgeWidth = finishedWidth / 4;

      wedgeStsLabel = String(wedgeSts);
      wedgeWidthLabel = formatLengthWithUnit(
        currentUnit === 'inches' ? wedgeWidth : convertLength(wedgeWidth, 'inches', currentUnit),
        currentUnit
      );
    }

    // Map crown type to template name
    let templateName;
    
    // Map crown values to correct SVG filenames
    if (crown === 'wedge-4' || crown === 'wedge-4-decrease') {
      templateName = 'hat-4-wedge';
    } else {
      // gathered + spiral: use gathered dimension diagram (no hat-spiral.svg in /diagrams yet)
      templateName = 'hat-gathered';
    }
    
    try {
      // Load SVG template from diagrams directory
      const response = await fetch(`/diagrams/${templateName}.svg`);
      let svgContent = await response.text();
      
      // Replace placeholders with fully-formatted values (including units)
      svgContent = svgContent
        .replace(/{{WIDTH}}/g, displayWidth)
        .replace(/{{HEIGHT}}/g, displayHeight)
        .replace(/{{BRIM_DEPTH}}/g, displayBrimDepth)
        .replace(/{{BODY_HEIGHT}}/g, displayBodyHeight)
        .replace(/{{CROWN_DEPTH}}/g, displayCrownDepth)
        .replace(/{{CAST_ON_STS}}/g, `${displayCastOnSts} sts`)
        .replace(/{{BRIM_ROWS}}/g, `${brimRows} rows`)
        .replace(/{{BODY_ROWS}}/g, `${bodyRows} rows`)
        .replace(/{{CROWN_ROWS}}/g, `${crownRowCount} rows`)
        .replace(/{{WEDGE_STS}}/g, wedgeStsLabel)
        .replace(/{{WEDGE_WIDTH}}/g, wedgeWidthLabel);
      
      updateHTML('#diagram-content', svgContent);
    } catch (error) {
      console.error('Failed to load diagram template:', templateName, error);
      updateHTML('#diagram-content', '<p style="text-align: center; color: #6b7280;">Diagram unavailable</p>');
    }
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => {
    void initHatBuilder();
  });
} else {
  void initHatBuilder();
}
</script>

<script is:inline>
  const clearBtn = document.getElementById('clear-hat-builder');

  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      const confirmed = confirm('Clear all inputs and start over?');
      if (!confirmed) return;

      // Remove hat builder storage keys
      localStorage.removeItem('hat-builder-pattern-inputs');
      localStorage.removeItem('hat-builder-hat-size');
      localStorage.removeItem('hat-builder-gauge-slots');
      localStorage.removeItem('hat-unit');
      localStorage.removeItem('hat-show-tips');

      // Reset form
      const form = document.querySelector('#hat-builder-form');
      if (form) form.reset();

      // Clear custom inputs
      const customCirc = document.getElementById('custom-circumference');
      if (customCirc) customCirc.value = '';

      const customLength = document.getElementById('custom-hat-length');
      if (customLength) customLength.value = '';

      // Reset selects
      document.querySelectorAll('#hat-builder-form select').forEach((sel) => {
        sel.value = '';
        sel.selectedIndex = 0;
      });

      if (typeof window.hatBuilderClearInMemory === 'function') {
        window.hatBuilderClearInMemory();
      }

      // Re-sync UI if function exists
      if (typeof syncHatSelectCompletion === 'function') {
        syncHatSelectCompletion();
      }

      // Hide results
      const results = document.getElementById('results');
      if (results) results.style.display = 'none';

      const zeroBodyWarn = document.getElementById('hat-zero-body-warning');
      if (zeroBodyWarn) zeroBodyWarn.setAttribute('hidden', '');

      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<PatternBuilderAccountGate />

</Layout>
