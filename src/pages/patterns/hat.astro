    });
  }

  updateUnitToggle();
  applyHatGaugeSlotsToInputs();

  function syncCustomLengthSection() {
    if (!customLengthDiv || !fitSelect) return;
    customLengthDiv.style.display = fitSelect.value === 'custom' ? 'block' : 'none';
  }

  window.hatBuilderClearInMemory = function () {
    gaugeSlots.inches = emptyHatGaugeSlot();
    gaugeSlots.cm = emptyHatGaugeSlot();
    unitStore.set('inches');
    try {
      localStorage.removeItem(HAT_GAUGE_SLOTS_KEY);
    } catch (_) {
      /* ignore */
    }
    updateUnitToggle();
    applyHatGaugeSlotsToInputs();
    syncCustomSizeSection();
    syncCustomLengthSection();
  };

  if (fitSelect) {
