<!-- Load shared wizard utilities -->
<script is:inline src="/js/wizard-utils.js"></script>

<script define:vars={{ hatSizingRows }}>
async function initHatBuilder() {
  console.log('Wizard initializing...');

  console.log('HAT BUILDER FILE LOADED');
  
  // Use shared wizard utilities from window.WizardUtils (or shorthand WU)
  const {
    convertLength,
    formatLength,
    formatLengthWithUnit,
    gaugeToPerUnit,
    createUnitStore,
    showResults,
    hideResults,
    setupAutoCalculate,
    updateHTML
  } = window.WizardUtils;

  const resultsVisibilityConfig = {
    resultsSelector: '#results',
    actionBarSelector: '#action-bar',
    printButtonSelector: '#print-btn',
    printFooterSelector: '#print-footer'
  };

  const tabButtons = document.querySelectorAll('.pattern-tabs .tab-btn');
  const tabPanels = document.querySelectorAll('.pattern-tabs .tab-panel');

  function loadPatternComments() {
    const el = document.querySelector('[data-pattern-comments]');
    if (!el || !(el instanceof HTMLElement)) return;

    const commentsEl = el;
    const alreadyLoaded = commentsEl.dataset.hyvorLoaded === 'true';
    const websiteId = commentsEl.dataset.hyvorWebsiteId;
    const cleanPath = window.location.pathname.replace(/\/$/, '') || '/';

    const w = window;
    w.HYVOR_TALK_WEBSITE = Number(websiteId);
    w.HYVOR_TALK_CONFIG = {
      url: window.location.origin + cleanPath,
      id: cleanPath
    };

    if (alreadyLoaded) {
      if (w.HyvorTalk && typeof w.HyvorTalk.reload === 'function') {
        w.HyvorTalk.reload();
      }
      return;
    }

    const existingScript = document.querySelector('script[data-hyvor-embed]');
    if (existingScript) {
      commentsEl.dataset.hyvorLoaded = 'true';
      if (w.HyvorTalk && typeof w.HyvorTalk.reload === 'function') {
        w.HyvorTalk.reload();
      }
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://talk.hyvor.com/web-api/embed.js';
    script.async = true;
    script.type = 'text/javascript';
    script.setAttribute('data-hyvor-embed', 'true');

    script.onload = () => {
      commentsEl.dataset.hyvorLoaded = 'true';
      if (w.HyvorTalk && typeof w.HyvorTalk.reload === 'function') {
        w.HyvorTalk.reload();
      }
    };

    document.body.appendChild(script);
  }

  function activateWizardTab(target) {
    const activeTabBtnsBefore = Array.from(
      document.querySelectorAll('.pattern-tabs .tab-btn.active')
    ).map((b) => b.dataset.tab);
    const activePanelsBefore = Array.from(
      document.querySelectorAll('.pattern-tabs .tab-panel.active')
    ).map((p) => p.id);
    console.log('[hat-builder debug] activateWizardTab requested tabName:', target);
    console.log('[hat-builder debug] activateWizardTab active tab before:', {
      activeTabButtons: activeTabBtnsBefore,
      activePanels: activePanelsBefore,
    });
    // Tab clicks are already blocked when .is-disabled (see tab button listeners).
    // Do not block programmatic switches (e.g. Create My Pattern) — the Pattern tab could
    // still carry .is-disabled if readiness UI missed that node, which would hide results.
    const panel = document.getElementById(`tab-${target}`);
    if (!panel) return;
    tabButtons.forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.tab === target);
    });
    tabPanels.forEach((p) => {
      p.classList.toggle('active', p.id === `tab-${target}`);
    });
    const activeTabBtnsAfter = Array.from(
      document.querySelectorAll('.pattern-tabs .tab-btn.active')
    ).map((b) => b.dataset.tab);
    const activePanelsAfter = Array.from(
      document.querySelectorAll('.pattern-tabs .tab-panel.active')
    ).map((p) => p.id);
    console.log('[hat-builder debug] activateWizardTab active tab after:', {
      activeTabButtons: activeTabBtnsAfter,
      activePanels: activePanelsAfter,
    });
    if (target === 'share') {
      loadPatternComments();
    }
    if (target === 'inspiration') {
      if (window.PinUtils && typeof window.PinUtils.build === 'function') {
        window.PinUtils.build();
      }
      window.kbmSchedulePinterestEmbedsRefresh?.();
    }
  }

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (button.classList.contains('is-disabled')) return;
      const target = button.dataset.tab;
      if (!target) return;
      activateWizardTab(target);
    });
  });

  const shareTabIsActive =
    document
      .querySelector('.pattern-tabs .tab-btn[data-tab="share"]')
      ?.classList.contains('active') ||
    document.querySelector('#tab-share')?.classList.contains('active');

  if (shareTabIsActive) {
    loadPatternComments();
  }

  // Do not run Pinterest refresh on load: Inspiration tab is display:none, so
  // pinit sees parent offsetWidth 0 and can fail to render the board. Refresh
  // only when the user opens Inspiration (see activateWizardTab).

  const editBtn = document.getElementById('edit-btn');
  if (editBtn) {
    editBtn.addEventListener('click', () => {
      activateWizardTab('build');
      const topEl = document.getElementById('hat-builder-form-top');
      if (topEl) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        topEl.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      }
    });
  }

  const mobileEditChoicesBtn = document.getElementById('action-bar-mobile-scroll-btn');
  if (mobileEditChoicesBtn) {
    mobileEditChoicesBtn.addEventListener(
      'click',
      () => {
        activateWizardTab('build');
      },
      true
    );
  }

  // ========== HAT BUILDER SPECIFIC CODE ==========
  
  // State (SSR options + data from bundled JSON; fetch below is fallback only)
  let hatSizingData = Array.isArray(hatSizingRows) ? hatSizingRows.slice() : [];
  /** Must be declared before any syncHatSelectCompletion() → updatePatternReadinessUi() (avoid TDZ on `let`). */
  let isPatternReady = false;
  const unitStore = createUnitStore('hat-unit', 'inches');
  const fitHeightsPreset = { beanie: 7, watchcap: 8.5, slouchy: 10, relaxed: 9 };

  const HAT_GAUGE_SLOTS_KEY = 'hat-builder-gauge-slots';
  const IN_TO_CM_GAUGE = 2.54;
  /** Stitches/rows per 4" ↔ per 10 cm (same fabric density) */
  const GAUGE_IN_TO_CM_FACTOR = 10 / (4 * IN_TO_CM_GAUGE);
  const GAUGE_CM_TO_IN_FACTOR = (4 * IN_TO_CM_GAUGE) / 10;

  function emptyHatGaugeSlot() {
    return { stitch: '', row: '' };
  }

  function loadHatGaugeSlots() {
    try {
      const raw = localStorage.getItem(HAT_GAUGE_SLOTS_KEY);
      if (!raw) return { inches: emptyHatGaugeSlot(), cm: emptyHatGaugeSlot() };
      const o = JSON.parse(raw);
      return {
        inches: {
          stitch: String(o.inches?.stitch ?? ''),
          row: String(o.inches?.row ?? ''),
        },
        cm: {
          stitch: String(o.cm?.stitch ?? ''),
          row: String(o.cm?.row ?? ''),
        },
      };
    } catch (_) {
      return { inches: emptyHatGaugeSlot(), cm: emptyHatGaugeSlot() };
    }
  }

  const gaugeSlots = loadHatGaugeSlots();

  // DOM Elements
  const HAT_SIZE_STORAGE_KEY = 'hat-builder-hat-size';
  const HAT_PATTERN_INPUTS_STORAGE_KEY = 'hat-builder-pattern-inputs';

  const btnInches = document.getElementById('hat-btn-inches');
  const btnCm = document.getElementById('hat-btn-cm');
  const customSizeDiv = document.getElementById('custom-size');
  const hatSizeSelect = document.getElementById('hat-size');
  const customCircInput = document.getElementById('custom-circumference');
  const brimLengthInput = document.getElementById('brimLength');
  const brimTypeSelect = document.getElementById('brimType');

  /** Crown depth: resolve from Build tab (avoids stale/wrong node if DOM differs from getElementById alone). */
  function resolveCrownDepthInput() {
    const byTestId = document.querySelector(
      '#tab-build input[data-testid="input-crown-depth"]'
    );
    if (byTestId instanceof HTMLInputElement) return byTestId;
    const byId = document.getElementById('crownDepth');
    return byId instanceof HTMLInputElement ? byId : null;
  }

  function formatCrownDepthInchesForInput(inches) {
    const n = Number(inches);
    if (!Number.isFinite(n)) return '';
    const rounded = Math.round(n * 100) / 100;
    return String(rounded);
  }

  /** Ensures floating-label + listeners see the new value (not placeholder-only). */
  function setCrownDepthFieldValue(/** @type {HTMLInputElement} */ el, str) {
    el.defaultValue = str;
    el.value = str;
    el.setAttribute('value', str);
    el.dispatchEvent(new Event('input', { bubbles: true }));
    el.dispatchEvent(new Event('change', { bubbles: true }));
  }

  /** Convert displayed crown depth when switching units (preserves manual edits as a measurement). */
  function convertCrownDepthFieldBetweenUnits(prevUnit, nextUnit) {
    const el = resolveCrownDepthInput();
    if (!el) return;
    crownDepthInput = el;
    const raw = el.value?.trim();
    if (raw === '') return;
    const n = parseFloat(raw);
    if (!Number.isFinite(n)) return;
    const inches =
      prevUnit === 'inches' ? n : convertLength(n, 'cm', 'inches');
    const displayNum =
      nextUnit === 'inches' ? inches : convertLength(inches, 'inches', 'cm');
    const str =
      nextUnit === 'inches'
        ? formatCrownDepthInchesForInput(displayNum)
        : displayNum.toFixed(1);
    setCrownDepthFieldValue(el, str);
  }

  let crownDepthInput = resolveCrownDepthInput();
  const crownSelect = document.getElementById('crown');
  const crownHelpOverlay = document.getElementById('crown-help-overlay');
  const crownHelpOpenBtn = document.getElementById('crown-help-open');
  const crownHelpCloseBtn = crownHelpOverlay?.querySelector('.crown-help-close');
  const fitSelect = document.getElementById('fit');

  /** Preset used when switching fit → custom (before customHatLengthInput exists in DOM order). */
  let previousFit = 'beanie';

  function persistPatternInputs() {
    if (!brimTypeSelect && !crownSelect && !fitSelect) return;
    try {
      localStorage.setItem(
        HAT_PATTERN_INPUTS_STORAGE_KEY,
        JSON.stringify({
          brimType: brimTypeSelect?.value ?? '',
          crownShaping: crownSelect?.value ?? '',
          fit: fitSelect?.value ?? '',
          customHatLength:
            fitSelect?.value === 'custom' && customHatLengthInput
              ? customHatLengthInput.value ?? ''
              : ''
        })
      );
    } catch (_) {
      /* ignore */
    }
  }

  /**
   * Restore brim / crown / fit from localStorage. Missing or invalid keys → "" (placeholder),
   * never a default real option. Only keys with valid saved values are applied.
   */
  function loadPatternInputs() {
    const result = {
      restoredBrim: false,
      restoredCrown: false,
      restoredFit: false
    };
    try {
      const raw = localStorage.getItem(HAT_PATTERN_INPUTS_STORAGE_KEY);
      if (!raw || !raw.trim()) return result;
      const o = JSON.parse(raw);
      if (!o || typeof o !== 'object') return result;

      const validFits = new Set(['beanie', 'watchcap', 'slouchy', 'relaxed', 'custom']);

      if (brimTypeSelect) {
        if (o.brimType === 'single' || o.brimType === 'folded') {
          brimTypeSelect.value = o.brimType;
          result.restoredBrim = true;
        } else {
          brimTypeSelect.value = '';
        }
      }

      if (crownSelect) {
        const crownVal =
          typeof o.crownShaping === 'string' ? o.crownShaping.trim() : '';
        if (crownVal) {
          const match = Array.from(crownSelect.options).find(
            (opt) => opt.value === crownVal && !opt.disabled
          );
          if (match) {
            crownSelect.value = crownVal;
            result.restoredCrown = true;
          } else {
            crownSelect.value = '';
          }
        } else {
          crownSelect.value = '';
        }
      }

      if (fitSelect) {
        const fitVal = typeof o.fit === 'string' ? o.fit.trim() : '';
        if (fitVal && validFits.has(fitVal)) {
          fitSelect.value = fitVal;
          result.restoredFit = true;
          if (fitVal === 'custom' && customHatLengthInput) {
            const cl =
              typeof o.customHatLength === 'string' ? o.customHatLength.trim() : '';
            customHatLengthInput.value = cl;
          } else if (customHatLengthInput) {
            customHatLengthInput.value = '';
          }
          if (fitVal !== 'custom') previousFit = fitVal;
        } else {
          fitSelect.value = '';
          if (customHatLengthInput) customHatLengthInput.value = '';
        }
      }
    } catch (_) {
      /* ignore */
    }
    return result;
  }

  function openCrownHelpModal() {
    if (!crownHelpOverlay) return;
    crownHelpOverlay.removeAttribute('hidden');
    crownHelpOverlay.setAttribute('aria-hidden', 'false');
    crownHelpCloseBtn?.focus();
  }

  function closeCrownHelpModal() {
    if (!crownHelpOverlay) return;
    crownHelpOverlay.setAttribute('hidden', '');
    crownHelpOverlay.setAttribute('aria-hidden', 'true');
    crownHelpOpenBtn?.focus();
  }

  crownHelpOpenBtn?.addEventListener('click', () => openCrownHelpModal());
  crownHelpCloseBtn?.addEventListener('click', () => closeCrownHelpModal());
  crownHelpOverlay?.addEventListener('click', (e) => {
    if (e.target === crownHelpOverlay) closeCrownHelpModal();
  });

  const hatYarnDrawerRoot = document.getElementById('hat-yarn-drawer');
  const hatYarnDrawerOpenBtn = document.getElementById('hat-yarn-drawer-open');
  const hatYarnDrawerTriggerWrap = document.getElementById('hat-yarn-drawer-trigger-wrap');
  const hatYarnDrawerCloseBtn = document.getElementById('hat-yarn-drawer-close');
  const hatYarnDrawerBackdrop = document.getElementById('hat-yarn-drawer-backdrop');
  /** @type {HTMLElement | null} */
  let hatYarnDrawerLastFocus = null;

  function openHatYarnDrawer() {
    if (!hatYarnDrawerRoot) return;
    hatYarnDrawerLastFocus =
      document.activeElement instanceof HTMLElement ? document.activeElement : null;
    hatYarnDrawerRoot.classList.add('is-open');
    hatYarnDrawerRoot.setAttribute('aria-hidden', 'false');
    document.body.classList.add('hat-yarn-drawer-open');
    hatYarnDrawerCloseBtn?.focus();
  }

  function closeHatYarnDrawer() {
    if (!hatYarnDrawerRoot?.classList.contains('is-open')) return;
    hatYarnDrawerRoot.classList.remove('is-open');
    hatYarnDrawerRoot.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('hat-yarn-drawer-open');
    const restore = hatYarnDrawerLastFocus;
    if (restore instanceof HTMLElement) {
      restore.focus();
    } else if (
      hatYarnDrawerOpenBtn instanceof HTMLElement &&
      hatYarnDrawerTriggerWrap &&
      !hatYarnDrawerTriggerWrap.hidden
    ) {
      hatYarnDrawerOpenBtn.focus();
    } else {
      hatSizeSelect?.focus();
    }
    hatYarnDrawerLastFocus = null;
  }

  hatYarnDrawerBackdrop?.addEventListener('click', () => closeHatYarnDrawer());
  hatYarnDrawerCloseBtn?.addEventListener('click', () => closeHatYarnDrawer());

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (hatYarnDrawerRoot?.classList.contains('is-open')) {
      closeHatYarnDrawer();
      e.preventDefault();
      return;
    }
    if (crownHelpOverlay && !crownHelpOverlay.hasAttribute('hidden')) {
      closeCrownHelpModal();
    }
  });

  const customLengthDiv = document.getElementById('custom-length-div');
  const customHatLengthInput = document.getElementById('custom-hat-length');
  const stitchGaugeInput = document.getElementById('hat-stitch-gauge');
  const rowGaugeInput = document.getElementById('hat-row-gauge');
  const printBtn = document.getElementById('print-btn');

  loadPatternInputs();
  persistPatternInputs();
  syncHatSelectCompletion();

  const CREATE_PATTERN_BTN_SELECTOR = '#create-pattern-btn';
  const createPatternBtnForClick = document.querySelector(CREATE_PATTERN_BTN_SELECTOR);
  console.log('[hat-builder debug] bind create-pattern-btn', {
    selector: CREATE_PATTERN_BTN_SELECTOR,
    buttonFound: Boolean(createPatternBtnForClick),
    element: createPatternBtnForClick,
  });
  if (createPatternBtnForClick) {
    // Keep focus on the last edited field during mousedown so the subsequent click is not lost
    // (browser may cancel click when focus/blur moves the layout) and .value reads stay current.
    createPatternBtnForClick.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      e.preventDefault();
    });
    createPatternBtnForClick.addEventListener('click', () => {
      console.log('build button clicked');
      crownDepthInput = resolveCrownDepthInput() || crownDepthInput;
      syncHatGaugeInputsToActiveSlot();
      const crownDepthElForDebug = resolveCrownDepthInput();
      const requiredValuesSnapshot = {
        hatSize: hatSizeSelect?.value,
        customCirc: customCircInput?.value?.trim(),
        brimLen: brimLengthInput?.value?.trim(),
        crownDep: crownDepthElForDebug?.value?.trim(),
        crown: crownSelect?.value,
        brimType: brimTypeSelect?.value,
        fit: fitSelect?.value,
        customHatLen: customHatLengthInput?.value?.trim(),
        stitchGauge: stitchGaugeInput?.value?.trim(),
        rowGauge: rowGaugeInput?.value?.trim(),
        hatSizingDataLength: hatSizingData?.length,
      };
      const readyNow = requiredPatternInputsComplete();
      isPatternReady = readyNow;
      console.log('[hat-builder debug] completion check', {
        completionResult: readyNow,
        requiredValuesUsedInCheck: requiredValuesSnapshot,
      });
      if (!readyNow) {
        console.log('form incomplete');
        showFinishRequiredSectionsMessage();
        return;
      }
      console.log('calling calculate()');
      calculate();
      console.log(
        '[hat-builder debug] Create handler: about to call activateWizardTab("pattern")'
      );
      const patternNav = document.getElementById('hat-tab-pattern');
      patternNav?.classList.remove('is-disabled');
      patternNav?.removeAttribute('aria-disabled');
      activateWizardTab('pattern');
    });
    console.log('build listener attached');
  } else {
    console.warn(
      '[hat-builder debug] create-pattern-btn not found; listener not attached (selector:',
      CREATE_PATTERN_BTN_SELECTOR,
      ')'
    );
  }

  function persistHatGaugeSlots() {
    try {
      localStorage.setItem(HAT_GAUGE_SLOTS_KEY, JSON.stringify(gaugeSlots));
    } catch (_) {
      /* ignore */
    }
  }

  /**
   * @param {'inches'|'cm'} fromU
   * @param {'inches'|'cm'} toU
   */
  function maybeFillHatGaugeSlotFromOtherUnit(fromU, toU) {
    const to = gaugeSlots[toU];
    if (to.stitch.trim() || to.row.trim()) return;
    const from = gaugeSlots[fromU];
    if (!from.stitch.trim() && !from.row.trim()) return;
    const fs = parseFloat(from.stitch);
    const fr = parseFloat(from.row);
    if (fromU === 'inches' && toU === 'cm') {
      if (Number.isFinite(fs)) to.stitch = (fs * GAUGE_IN_TO_CM_FACTOR).toFixed(1);
      if (Number.isFinite(fr)) to.row = (fr * GAUGE_IN_TO_CM_FACTOR).toFixed(1);
    } else if (fromU === 'cm' && toU === 'inches') {
      if (Number.isFinite(fs)) to.stitch = (fs * GAUGE_CM_TO_IN_FACTOR).toFixed(1);
      if (Number.isFinite(fr)) to.row = (fr * GAUGE_CM_TO_IN_FACTOR).toFixed(1);
    }
  }

  function applyHatGaugeSlotsToInputs() {
    if (!stitchGaugeInput || !rowGaugeInput) return;
    const u = unitStore.get() === 'cm' ? 'cm' : 'inches';
    stitchGaugeInput.value = gaugeSlots[u].stitch;
    rowGaugeInput.value = gaugeSlots[u].row;
  }

  function syncHatGaugeInputsToActiveSlot() {
    if (!stitchGaugeInput || !rowGaugeInput) return;
    const u = unitStore.get() === 'cm' ? 'cm' : 'inches';
    gaugeSlots[u] = {
      stitch: stitchGaugeInput.value,
      row: rowGaugeInput.value,
    };
    persistHatGaugeSlots();
  }

  stitchGaugeInput?.addEventListener('input', syncHatGaugeInputsToActiveSlot);
  stitchGaugeInput?.addEventListener('change', syncHatGaugeInputsToActiveSlot);
  rowGaugeInput?.addEventListener('input', syncHatGaugeInputsToActiveSlot);
  rowGaugeInput?.addEventListener('change', syncHatGaugeInputsToActiveSlot);

  /** Total finished hat length (inches): custom input, size chart hatLength, or fit style preset. */
  function resolveTotalHatLengthInches(fit, hatSizeValue, currentUnit) {
    if (!fit) return null;
    if (fit === 'custom') {
      const customLengthValue = parseFloat(customHatLengthInput?.value) || 0;
      if (customLengthValue <= 0) return null;
      return currentUnit === 'inches'
        ? customLengthValue
        : convertLength(customLengthValue, 'cm', 'inches');
    }
    const selectedSize =
      hatSizeValue && hatSizeValue !== 'custom'
        ? hatSizingData.find((s) => s.size === hatSizeValue)
        : null;
    const fromChart =
      selectedSize != null && Number(selectedSize.hatLength) > 0
        ? Number(selectedSize.hatLength)
        : null;
    const fromFit = fitHeightsPreset[fit];
    const inches = fromChart ?? fromFit;
    return inches != null ? inches : null;
  }

  /** Keeps YarnRequirement (Build tab) aligned with size, length, and unit — no gauge needed for area estimate */
  function syncHatYarnDimensions() {
    const currentUnit = unitStore.get();
    const lengthUnit = currentUnit === 'inches' ? 'in' : 'cm';
    const emptyDetail = { projectWidth: 0, projectLength: 0, lengthUnit, source: 'custom' };

    const hatSizeValue = hatSizeSelect?.value;
    if (!hatSizeValue) {
      window.dispatchEvent(new CustomEvent('kbm:yarnDimensions', { detail: emptyDetail }));
      return;
    }

    let headCircInches = 0;
    if (hatSizeValue === 'custom') {
      const headCirc = parseFloat(customCircInput?.value) || 0;
      if (headCirc <= 0) {
        window.dispatchEvent(new CustomEvent('kbm:yarnDimensions', { detail: emptyDetail }));
        return;
      }
      headCircInches = currentUnit === 'inches' ? headCirc : convertLength(headCirc, 'cm', 'inches');
    } else {
      const selectedSize = hatSizingData.find((s) => s.size === hatSizeValue);
      if (!selectedSize) {
        window.dispatchEvent(new CustomEvent('kbm:yarnDimensions', { detail: emptyDetail }));
        return;
      }
      headCircInches = selectedSize.circumference;
    }

    const fit = fitSelect?.value;
    if (!fit) {
      window.dispatchEvent(new CustomEvent('kbm:yarnDimensions', { detail: emptyDetail }));
      return;
    }

    const totalHatLengthInches = resolveTotalHatLengthInches(fit, hatSizeValue, currentUnit);
    if (totalHatLengthInches == null || totalHatLengthInches <= 0) {
      window.dispatchEvent(new CustomEvent('kbm:yarnDimensions', { detail: emptyDetail }));
      return;
    }

    const targetWidthInches = headCircInches * 0.9;
    let projectWidth;
    let projectLength;
    if (lengthUnit === 'in') {
      projectWidth = targetWidthInches;
      projectLength = totalHatLengthInches;
    } else {
      projectWidth = convertLength(targetWidthInches, 'inches', 'cm');
      projectLength = convertLength(totalHatLengthInches, 'inches', 'cm');
    }

    window.dispatchEvent(
      new CustomEvent('kbm:yarnDimensions', {
        detail: { projectWidth, projectLength, lengthUnit, source: 'custom' },
      })
    );
  }

  /** Size, hat length, and gauge only — for optional yarn estimator link (not brim/crown). */
  function isYarnEstimatorInputsReady() {
    const size = hatSizeSelect?.value;
    if (!size) return false;
    if (size === 'custom') {
      const circ = customCircInput?.value?.trim();
      if (!circ || Number(circ) <= 0) return false;
    } else {
      const selectedSize = hatSizingData.find((s) => s.size === size);
      if (!selectedSize || !(Number(selectedSize.circumference) > 0)) return false;
    }

    const fit = fitSelect?.value;
    if (!fit) return false;
    if (fit === 'custom') {
      const len = customHatLengthInput?.value?.trim();
      if (!len || Number(len) <= 0) return false;
    }

    const gaugeSts = stitchGaugeInput?.value?.trim();
    const gaugeRows = rowGaugeInput?.value?.trim();
    if (!gaugeSts || !gaugeRows) return false;
    const st = Number(gaugeSts);
    const rg = Number(gaugeRows);
    if (!Number.isFinite(st) || st <= 0 || !Number.isFinite(rg) || rg <= 0) return false;

    return true;
  }

  /** Predicate: all required build fields complete (same rules as section checks / Pattern tab). */
  function requiredPatternInputsComplete() {
    const size = hatSizeSelect?.value;
    if (!size) return false;
    if (size === 'custom') {
      const circ = customCircInput?.value?.trim();
      if (!circ || Number(circ) <= 0) return false;
    } else {
      const selectedSize = hatSizingData.find((s) => s.size === size);
      if (!selectedSize || !(Number(selectedSize.circumference) > 0)) return false;
    }

    const brimLen = brimLengthInput?.value?.trim();
    const crownDepthEl = resolveCrownDepthInput();
    const crownDep = crownDepthEl?.value?.trim();
    if (!brimLen || Number(brimLen) <= 0 || !crownDep || Number(crownDep) <= 0) return false;
    if (!crownSelect?.value) return false;
    const bt = brimTypeSelect?.value;
    if (bt !== 'single' && bt !== 'folded') return false;

    const fit = fitSelect?.value;
    if (!fit) return false;
    if (fit === 'custom') {
      const len = customHatLengthInput?.value?.trim();
      if (!len || Number(len) <= 0) return false;
    }

    const gaugeSts = stitchGaugeInput?.value?.trim();
    const gaugeRows = rowGaugeInput?.value?.trim();
    if (!gaugeSts || !gaugeRows) return false;
    const st = Number(gaugeSts);
    const rg = Number(gaugeRows);
    if (!Number.isFinite(st) || st <= 0 || !Number.isFinite(rg) || rg <= 0) return false;

    return true;
  }

  /** Computed flag: mirrors requiredPatternInputsComplete(); refreshed in updatePatternReadinessUi and on Create click. */
  let createPatternFeedbackTimer = 0;
  function showFinishRequiredSectionsMessage() {
    const el = document.getElementById('create-pattern-feedback');
    if (!el) return;
    window.clearTimeout(createPatternFeedbackTimer);
    el.textContent = 'Finish the required sections to build your pattern.';
    el.hidden = false;
    createPatternFeedbackTimer = window.setTimeout(() => {
      el.textContent = '';
      el.hidden = true;
    }, 4000);
  }

  function updatePatternReadinessUi() {
    const cta = document.getElementById('build-pattern-cta');
    const patternTabBtn =
      document.getElementById('hat-tab-pattern') ||
      document.querySelector('.pattern-tabs .tab-btn[data-tab="pattern"]');
    const createPatternBtn = document.getElementById('create-pattern-btn');
    isPatternReady = requiredPatternInputsComplete();
    const ready = isPatternReady;

    if (hatYarnDrawerTriggerWrap) {
      hatYarnDrawerTriggerWrap.hidden = !isYarnEstimatorInputsReady();
    }

    if (cta) {
      cta.style.display = 'block';
    }
    if (createPatternBtn) {
      createPatternBtn.removeAttribute('disabled');
      createPatternBtn.classList.toggle('button-disabled', !ready);
      if (ready) {
        createPatternBtn.removeAttribute('aria-disabled');
      } else {
        createPatternBtn.setAttribute('aria-disabled', 'true');
      }
    }
    if (patternTabBtn) {
      patternTabBtn.classList.toggle('is-disabled', !ready);
      if (ready) {
        patternTabBtn.removeAttribute('aria-disabled');
      } else {
        patternTabBtn.setAttribute('aria-disabled', 'true');
      }
    }

    if (!ready) {
      const patternNavBtn =
        document.getElementById('hat-tab-pattern') ||
        document.querySelector('.pattern-tabs .tab-btn[data-tab="pattern"]');
      if (patternNavBtn?.classList.contains('active')) {
        activateWizardTab('build');
      }
    }
  }

  window.addEventListener('kbm:units-change', (/** @type {CustomEvent<{ unit?: string }>} */ e) => {
    const d = e.detail;
    if (!d || !d.unit) return;
    if (!stitchGaugeInput || !rowGaugeInput) return;
    const prevU = unitStore.get() === 'cm' ? 'cm' : 'inches';
    gaugeSlots[prevU] = {
      stitch: stitchGaugeInput.value,
      row: rowGaugeInput.value,
    };
    persistHatGaugeSlots();
    const nextU = d.unit === 'cm' ? 'cm' : 'inches';
    maybeFillHatGaugeSlotFromOtherUnit(prevU, nextU);
    stitchGaugeInput.value = gaugeSlots[nextU].stitch;
    rowGaugeInput.value = gaugeSlots[nextU].row;
    persistHatGaugeSlots();
    updatePatternReadinessUi();
  });

  hatYarnDrawerOpenBtn?.addEventListener('click', () => {
    if (!isYarnEstimatorInputsReady()) return;
    openHatYarnDrawer();
  });

  /**
   * Keep the native control's selected option in sync with .value. Some browsers report
   * value "" while selectedIndex still points at a real option, so the closed dropdown shows
   * the wrong label and :checked styling can mispaint.
   */
  function alignHatSelectPlaceholderIndex(sel) {
    if (!(sel instanceof HTMLSelectElement)) return;
    const v = (sel.value ?? '').trim();
    if (v !== '') return;
    const idx = Array.from(sel.options).findIndex(
      (opt) => !opt.disabled && String(opt.value ?? '').trim() === ''
    );
    if (idx >= 0 && sel.selectedIndex !== idx) sel.selectedIndex = idx;
  }

  function syncHatSelectCompletion() {
    [hatSizeSelect, brimTypeSelect, crownSelect, fitSelect].forEach((sel) => {
      if (!sel) return;
      alignHatSelectPlaceholderIndex(sel);
      const wrap = sel.closest('.hat-select-wrap');
      if (!wrap) return;
      const v = (sel.value ?? '').trim();
      wrap.classList.toggle('is-complete', v !== '');
    });
    updatePatternReadinessUi();
  }

  window.syncHatSelectCompletion = syncHatSelectCompletion;

  // Hat sizes: options are server-rendered from src/data/sizing_hats.json. Fetch only if SSR list missing (e.g. stale HTML).
  try {
    const ssrOk =
      hatSizeSelect &&
      hatSizeSelect.getAttribute('data-sizes-source') === 'ssr' &&
      hatSizeSelect.options.length > 2 &&
      Array.isArray(hatSizingData) &&
      hatSizingData.length > 0;

    if (!ssrOk && hatSizeSelect) {
      while (hatSizeSelect.options.length > 1) {
        hatSizeSelect.remove(1);
      }
      hatSizingData = [];
      const response = await fetch('/data/sizing_hats.json');
      if (!response.ok) {
        throw new Error(`Hat sizing fetch failed: ${response.status} ${response.statusText}`);
      }
      const parsed = await response.json();
      hatSizingData = Array.isArray(parsed) ? parsed : [];
      hatSizingData.forEach((size) => {
        const option = document.createElement('option');
        option.value = size.size;
        option.textContent = size.extended_label || size.label || size.size || 'Unnamed size';
        hatSizeSelect.appendChild(option);
      });
      const customOption = document.createElement('option');
      customOption.value = 'custom';
      customOption.textContent = '✏️ Enter your own size';
      hatSizeSelect.appendChild(customOption);
    } else if (!hatSizeSelect) {
      console.error('hat-size select element not found; cannot populate dropdown');
    }

    crownDepthInput = resolveCrownDepthInput() || crownDepthInput;
    restoreHatBuilderSizeFromStorage();
    syncHatYarnDimensions();
  } catch (error) {
    console.error('Failed to load hat sizing data:', error);
    if (hatSizeSelect && !Array.from(hatSizeSelect.options).some((o) => o.value === 'custom')) {
      const customOption = document.createElement('option');
      customOption.value = 'custom';
      customOption.textContent = '✏️ Enter your own size';
      hatSizeSelect.appendChild(customOption);
    }
    crownDepthInput = resolveCrownDepthInput() || crownDepthInput;
    restoreHatBuilderSizeFromStorage();
    syncHatYarnDimensions();
  }

  function syncCustomSizeSection() {
    if (!customSizeDiv || !hatSizeSelect) return;
    customSizeDiv.style.display = hatSizeSelect.value === 'custom' ? 'block' : 'none';
  }

  /** Fills Crown Depth from sizing JSON for standard sizes only (inches in JSON → current display unit). */
  function applySuggestedCrownDepthFromSize() {
    const el = resolveCrownDepthInput();
    crownDepthInput = el;
    if (!el || !hatSizeSelect || !Array.isArray(hatSizingData)) {
      console.log('[hat-builder crown] apply skip', {
        hasEl: Boolean(el),
        hasSelect: Boolean(hatSizeSelect),
        dataLen: hatSizingData?.length
      });
      return;
    }
    const sizeVal = hatSizeSelect.value;
    if (!sizeVal || sizeVal === 'custom') {
      console.log('[hat-builder crown] apply skip (no standard size)', { sizeVal });
      return;
    }
    const entry = hatSizingData.find((s) => s.size === sizeVal);
    const depthInches = Number(entry?.suggestedCrownDepth ?? entry?.defaultCrownDepth);
    if (!entry || !Number.isFinite(depthInches) || depthInches <= 0) {
      console.log('[hat-builder crown] apply skip (no row or depth)', {
        sizeVal,
        entry: entry ?? null,
        depthInches
      });
      return;
    }
    const currentUnit = unitStore.get();
    const displayNum =
      currentUnit === 'inches'
        ? depthInches
        : convertLength(depthInches, 'inches', 'cm');
    const str =
      currentUnit === 'inches'
        ? formatCrownDepthInchesForInput(displayNum)
        : displayNum.toFixed(1);
    console.log('[hat-builder crown] apply', {
      selectedSize: sizeVal,
      matchedRow: entry,
      suggestedCrownDepthInches: depthInches,
      finalInputValue: str
    });
    setCrownDepthFieldValue(el, str);
  }

  /** Restore hat size (and crown suggestion for standard sizes) from localStorage after options exist. */
  function restoreHatBuilderSizeFromStorage() {
    if (!hatSizeSelect) return;
    const clearSizeToPlaceholder = () => {
      hatSizeSelect.selectedIndex = 0;
      if (customCircInput) customCircInput.value = '';
      syncCustomSizeSection();
      persistHatSize();
      syncHatSelectCompletion();
    };
    try {
      const raw = localStorage.getItem(HAT_SIZE_STORAGE_KEY);
      if (!raw || !String(raw).trim()) {
        clearSizeToPlaceholder();
        return;
      }
      const o = JSON.parse(raw);
      const sel = o && typeof o.sel === 'string' ? o.sel.trim() : '';
      if (!sel) {
        try {
          localStorage.removeItem(HAT_SIZE_STORAGE_KEY);
        } catch (_) {
          /* ignore */
        }
        clearSizeToPlaceholder();
        return;
      }
      const ok = Array.from(hatSizeSelect.options).some((opt) => opt.value === sel);
      if (!ok) {
        try {
          localStorage.removeItem(HAT_SIZE_STORAGE_KEY);
        } catch (_) {
          /* ignore */
        }
        clearSizeToPlaceholder();
        return;
      }
      hatSizeSelect.value = sel;
      if (customCircInput) {
        if (sel === 'custom') {
          customCircInput.value = typeof o.circ === 'string' ? o.circ : '';
        } else {
          customCircInput.value = '';
        }
      }
      syncCustomSizeSection();
      applySuggestedCrownDepthFromSize();
      updatePlaceholders();
      persistHatSize();
      syncHatSelectCompletion();
    } catch (_) {
      try {
        localStorage.removeItem(HAT_SIZE_STORAGE_KEY);
      } catch (_) {
        /* ignore */
      }
      clearSizeToPlaceholder();
    }
  }

  function persistHatSize() {
    if (!hatSizeSelect) return;
    try {
      const sel = hatSizeSelect.value;
      if (!sel) {
        localStorage.removeItem(HAT_SIZE_STORAGE_KEY);
        return;
      }
      localStorage.setItem(
        HAT_SIZE_STORAGE_KEY,
        JSON.stringify({
          sel,
          circ: sel === 'custom' && customCircInput ? customCircInput.value : ''
        })
      );
    } catch (_) {
      /* ignore quota / private mode */
    }
  }

  if (hatSizeSelect) {
    syncCustomSizeSection();
    hatSizeSelect.addEventListener('change', () => {
      syncCustomSizeSection();
      applySuggestedCrownDepthFromSize();
      updatePlaceholders();
      persistHatSize();
      syncHatSelectCompletion();
      syncHatYarnDimensions();
    });
    if (customCircInput) {
      customCircInput.addEventListener('input', persistHatSize);
      customCircInput.addEventListener('change', persistHatSize);
      customCircInput.addEventListener('input', syncHatYarnDimensions);
      customCircInput.addEventListener('change', syncHatYarnDimensions);
    }
    syncHatSelectCompletion();
  }

  if (crownSelect) {
    crownSelect.addEventListener('change', () => {
      persistPatternInputs();
      syncHatSelectCompletion();
    });
  }

  if (brimTypeSelect) {
    brimTypeSelect.addEventListener('change', () => {
      persistPatternInputs();
      syncHatSelectCompletion();
    });
    syncHatSelectCompletion();
  }

  // Unit Toggle
  function updateUnitToggle() {
    const currentUnit = unitStore.get();
    if (btnInches && btnCm) {
      if (currentUnit === 'inches') {
        btnInches.classList.add('active');
        btnCm.classList.remove('active');
      } else {
        btnCm.classList.add('active');
        btnInches.classList.remove('active');
      }
    }
    updatePlaceholders();
  }
  
  function updateCustomFloatingLabels() {
    const currentUnit = unitStore.get();
    const unitWord = currentUnit === 'inches' ? 'inches' : 'cm';
    const circLab = document.querySelector('label[for="custom-circumference"]');
    const lenLab = document.querySelector('label[for="custom-hat-length"]');
    const brimLenLab = document.querySelector('label[for="brimLength"]');
    const crownDepthLab = document.querySelector('label[for="crownDepth"]');
    if (circLab) circLab.textContent = `Custom Head Measurement (${unitWord})`;
    if (lenLab) lenLab.textContent = `Custom Hat Length (${unitWord})`;
