<script define:vars={{ hatSizingBuilderRows, scrapOffPatternTooltip }}>
async function initHatBuilder() {
  console.log('Wizard initializing...');

  console.log('HAT BUILDER FILE LOADED');
  
  // Use shared wizard utilities from window.WizardUtils (or shorthand WU)
  const {
    convertLength,
    formatLength,
    formatLengthWithUnit,
    gaugeToPerUnit,
    createUnitStore,
    showResults,
    hideResults,
    setupAutoCalculate,
    updateHTML
  } = window.WizardUtils;

  /** Escape for HTML attribute (pattern-term data-tooltip). */
  function escapePatternTermAttr(s) {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;');
  }

  /**
   * Collapsible pattern section: checkbox checked = collapsed (is-collapsed + hidden content).
   * Persists via localStorage hatPattern_section_[sectionId].
   */
  function wrapHatPatternSection(sectionId, titleHtml, contentHtml) {
    const sid = String(sectionId).replace(/[^a-zA-Z0-9_-]/g, '');
    return `<section class="hat-pattern-section" data-section-id="${sid}">
  <div class="hat-pattern-section__header">
    <label class="hat-pattern-section__collapse-label">
      <input type="checkbox" class="hat-pattern-section__collapse" data-section-id="${sid}" aria-label="Collapse this section" />
    </label>
    <div class="hat-pattern-section__heading">${titleHtml}</div>
  </div>
  <div class="hat-pattern-section__content">${contentHtml}</div>
</section>`;
  }

  /** Restore collapsed state from localStorage after pattern HTML is injected. */
  function applyHatPatternSectionCollapseState(root) {
    if (!root) return;
    root.querySelectorAll('.hat-pattern-section').forEach((section) => {
      const id = section.dataset.sectionId;
      if (!id) return;
      const header = section.querySelector(':scope > .hat-pattern-section__header');
      const checkbox = header?.querySelector('input.hat-pattern-section__collapse');
      if (!(checkbox instanceof HTMLInputElement)) return;
      const collapsed = localStorage.getItem(`hatPattern_section_${id}`) === 'true';
      checkbox.checked = collapsed;
      section.classList.toggle('is-collapsed', collapsed);
    });
  }

  /** Round to integer; if odd, bump up to next even (stitch/row parity). @param {number} value */
  function roundToEvenPreferUp(value) {
    const n = Math.round(value);
    return n % 2 === 0 ? n : n + 1;
  }

  /** Spiral crown: stitch count must be divisible by 6 (six decrease sections). Snaps to nearest multiple of 6. */
  function snapCastOnToNearestMultipleOf6(castOnStitches) {
    let n = castOnStitches;
    if (n % 6 !== 0) {
      const lower = Math.floor(n / 6) * 6;
      const upper = Math.ceil(n / 6) * 6;
      n = Math.abs(n - lower) <= Math.abs(upper - n) ? lower : upper;
    }
    return n;
  }

  /** Wedge crown: trim cast-on for legacy wedge-4; 4-wedge decrease rounds up to multiple of 4. */
  function applyHatCrownCastOnAdjustment(castOnSts, crown) {
    if (crown === 'wedge-4') return castOnSts - (castOnSts % 4);
    if (crown === 'wedge-4-decrease') {
      // 4 wedge crown setup
      // stitch count must be divisible by 4
      const r = castOnSts % 4;
      return r === 0 ? castOnSts : castOnSts + (4 - r);
    }
    if (crown === 'spiral') return snapCastOnToNearestMultipleOf6(castOnSts);
    return castOnSts;
  }

  /**
   * Shared crown planning logic used by calculations + instruction generation.
   * All values returned in inches unless otherwise stated.
   */
  function buildHatCrownPlan({
    crown,
    finishedHatLength,
    suggestedCrownDepth,
    castOnStitches,
    rowGaugePerInch,
  }) {
    const safeLength = Number.isFinite(finishedHatLength) ? finishedHatLength : 0;
    const safeSuggestedDepth = Number.isFinite(suggestedCrownDepth) ? suggestedCrownDepth : 0;
    const safeCastOn = Number.isFinite(castOnStitches) ? castOnStitches : 0;
    const safeRowGauge = Number.isFinite(rowGaugePerInch) && rowGaugePerInch > 0 ? rowGaugePerInch : 0;

    if (crown === 'gathered') {
      return {
        crownDepth: 0,
        bodyLength: safeLength,
        note: 'Gathered crowns are closed after the full hat length is knitted.',
        crownRows: 0,
        spiral: null,
      };
    }

    if (crown === 'spiral') {
      const decreasePoints = 6;
      const targetStitches = 6;
      let castOnStitches = snapCastOnToNearestMultipleOf6(safeCastOn);
      if ((castOnStitches - targetStitches) % 6 !== 0) {
        console.warn('Spiral crown math mismatch: stitches not reducing cleanly by 6.');
      }
      const decreaseRows = Math.max(0, (castOnStitches - targetStitches) / decreasePoints);
      const gradual = Math.round(decreaseRows * 0.67);
      const rapid = decreaseRows - gradual;
      const gradualRows = Math.max(0, gradual > 0 ? gradual * 2 - 1 : 0);
      const rapidRows = rapid;
      const crownRows = gradualRows + rapidRows;
      const crownDepth = safeRowGauge > 0 ? crownRows / safeRowGauge : 0;
      return {
        crownDepth,
        bodyLength: safeLength - crownDepth,
        note: 'Spiral crown depth is calculated from the shaping schedule.',
        crownRows,
        spiral: {
          decreasePoints,
          targetStitches,
          decreaseRows,
          gradual,
          rapid,
          gradualRows,
          rapidRows,
          crownRows,
        },
      };
    }

    const crownDepth = safeSuggestedDepth;
    return {
      crownDepth,
      bodyLength: safeLength - crownDepth,
      note: 'Wedge crown depth is based on the sizing chart.',
      crownRows: Math.max(0, Math.round(crownDepth * safeRowGauge)),
      spiral: null,
    };
  }

  /**
   * Centered cast-on: half the stitches on the left of center (L1 = next to center on the left),
   * half on the right (R1 = next to center on the right). Physical order left → right along the bed:
   * L(half), L(half−1), …, L1, R1, …, R(half). Matches the hat builder’s even split for cast-on count.
   * @param {number} stitchIndex 0 … N−1 left to right
   * @param {number} N total cast-on stitches (even)
   */
  function hatCastOnNeedleAtIndex(stitchIndex, N) {
    const half = N / 2;
    if (stitchIndex < half) {
      const num = half - stitchIndex;
      return { side: 'L', num, label: `L${num}` };
    }
    const num = stitchIndex - half + 1;
    return { side: 'R', num, label: `R${num}` };
  }

  /**
   * map 4 wedge crown stitches to actual needles
   * never output needle 0
   * @param {number} startIdx inclusive, left-to-right position
   * @param {number} endIdx inclusive
   * @param {number} N total cast-on stitches
   */
  function formatHatWedgeNeedleDisplayRange(startIdx, endIdx, N) {
    const half = N / 2;
    if (
      !Number.isFinite(startIdx) ||
      !Number.isFinite(endIdx) ||
      !Number.isFinite(N) ||
      N <= 0 ||
      startIdx > endIdx
    ) {
      return '';
    }
    const a = Math.max(0, Math.min(N - 1, startIdx));
    const b = Math.max(0, Math.min(N - 1, endIdx));

    function leftSpan(s, e) {
      if (s > e) return '';
      const outer = half - s;
      const inner = half - e;
      if (outer < 1 || inner < 1) return '';
      if (outer === inner) return `L${outer}`;
      return `L${outer} to L${inner}`;
    }
    function rightSpan(s, e) {
      if (s > e) return '';
      const lo = s - half + 1;
      const hi = e - half + 1;
      if (lo < 1 || hi < 1) return '';
      if (lo === hi) return `R${lo}`;
      return `R${lo} to R${hi}`;
    }

    if (b < half) {
      return leftSpan(a, b);
    }
    if (a >= half) {
      return rightSpan(a, b);
    }
    const leftPart = leftSpan(a, half - 1);
    const rightPart = rightSpan(half, b);
    if (leftPart && rightPart) return `${leftPart}, then ${rightPart}`;
    return leftPart || rightPart || '';
  }

  /**
   * @param {number} N adjusted cast-on (must be divisible by 4)
   * @returns {{ wedgeNumber: number, stitchCount: number, startNeedleLabel: string, endNeedleLabel: string, displayRange: string, needleLabels: string[] }[]}
   */
  function buildFourWedgeNeedleRanges(N, wedgeStitchCount) {
    const w = wedgeStitchCount;
    if (!Number.isFinite(N) || N <= 0 || N % 4 !== 0 || !Number.isFinite(w) || w !== N / 4) {
      return [];
    }
    const wedges = [];
    for (let wn = 1; wn <= 4; wn += 1) {
      const physicalSlot = 4 - wn;
      const startIdx = physicalSlot * w;
      const endIdx = startIdx + w - 1;
      const needleLabels = [];
      for (let i = startIdx; i <= endIdx; i += 1) {
        needleLabels.push(hatCastOnNeedleAtIndex(i, N).label);
      }
      const startL = hatCastOnNeedleAtIndex(startIdx, N);
      const endL = hatCastOnNeedleAtIndex(endIdx, N);
      wedges.push({
        wedgeNumber: wn,
        stitchCount: w,
        startNeedleLabel: startL.label,
        endNeedleLabel: endL.label,
        displayRange: formatHatWedgeNeedleDisplayRange(startIdx, endIdx, N),
        needleLabels,
      });
    }
    return wedges;
  }

