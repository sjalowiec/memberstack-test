  /** Ensures floating-label + listeners see the new value (not placeholder-only). */
  function setCrownDepthFieldValue(/** @type {HTMLInputElement} */ el, str) {
    el.defaultValue = str;
    el.value = str;
    el.setAttribute('value', str);
    el.dispatchEvent(new Event('input', { bubbles: true }));
    el.dispatchEvent(new Event('change', { bubbles: true }));
  }

  /** Convert displayed brim length when switching units (same pattern as crown depth). */
  function convertBrimLengthFieldBetweenUnits(prevUnit, nextUnit) {
    const el = brimLengthInput;
    if (!el || !(el instanceof HTMLInputElement)) return;
    const raw = el.value?.trim();
    if (raw === '') return;
    const n = parseFloat(raw);
    if (!Number.isFinite(n)) return;
    const inches =
      prevUnit === 'inches' ? n : convertLength(n, 'cm', 'inches');
    const displayNum =
      nextUnit === 'inches' ? inches : convertLength(inches, 'inches', 'cm');
    const str =
      nextUnit === 'inches'
        ? formatCrownDepthInchesForInput(displayNum)
        : displayNum.toFixed(1);
    setCrownDepthFieldValue(el, str);
