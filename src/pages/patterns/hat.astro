<script>
  import "../../scripts/patternPrintPersonalizationBridge.ts";
  import {
    bindPatternTipDismiss,
    patternTipsControlBoxHtml,
    refreshPatternTipDismiss,
    updateTipsResetLinkVisibility,
  } from "../../lib/patterns/patternTipDismiss";
  import {
    installPatternBuilderAccountGate,
    lockPatternBuilderForLoggedOut,
  } from "../../lib/patterns/patternBuilderAccountGate";

  installPatternBuilderAccountGate();

  // Upfront membership gate: lock the interactive builder until active Knit it Now membership is
  // confirmed. Closing the prompt leaves the builder locked; clicking/focusing any control re-opens
  // the prompt. Login alone does not unlock. Create / Pattern tab gates remain the fail-closed backup.
  void lockPatternBuilderForLoggedOut(
    document.querySelector<HTMLElement>("[data-pattern-builder-lock]"),
  );

  const HAT_TIPS_STORAGE_KEY = "hat-show-tips";
  window.kbmPatternTipsControlBoxHtml = patternTipsControlBoxHtml;
  window.kbmUpdateTipsResetLinkVisibility = updateTipsResetLinkVisibility;

  function initHatPatternTipDismiss() {
    const scope = document.getElementById("pattern-content");
    if (!(scope instanceof HTMLElement)) return;
    bindPatternTipDismiss(scope, HAT_TIPS_STORAGE_KEY, null);
    refreshPatternTipDismiss(scope, HAT_TIPS_STORAGE_KEY);
    updateTipsResetLinkVisibility(scope, HAT_TIPS_STORAGE_KEY);
  }

  document.addEventListener("DOMContentLoaded", initHatPatternTipDismiss);
  window.addEventListener("kbm:hat-pattern-rendered", initHatPatternTipDismiss);
</script>

