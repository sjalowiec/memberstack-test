  const CREATE_PATTERN_BTN_SELECTOR = '#create-pattern-btn';
  const createPatternBtnForClick = document.querySelector(CREATE_PATTERN_BTN_SELECTOR);
  console.log('[hat-builder debug] bind create-pattern-btn', {
    selector: CREATE_PATTERN_BTN_SELECTOR,
    buttonFound: Boolean(createPatternBtnForClick),
    element: createPatternBtnForClick,
  });
  if (createPatternBtnForClick) {
    // Keep focus on the last edited field during mousedown so the subsequent click is not lost
    // (browser may cancel click when focus/blur moves the layout) and .value reads stay current.
    createPatternBtnForClick.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      e.preventDefault();
    });
    const runCreateHatPattern = () => {
      console.log('build button clicked');
      syncHatGaugeInputsToActiveSlot();
      const requiredValuesSnapshot = {
        hatSize: hatSizeSelect?.value,
        customCirc: customCircInput?.value?.trim(),
        brimLen: brimLengthInput?.value?.trim(),
        crown: crownSelect?.value,
        brimType: brimTypeSelect?.value,
        fit: fitSelect?.value,
        customHatLen: customHatLengthInput?.value?.trim(),
