  }

  function updatePlaceholders() {
    const currentUnit = unitStore.get();
    const unitWord = currentUnit === 'inches' ? 'inches' : 'cm';

    updateCustomFloatingLabels();
    if (customCircInput) {
      customCircInput.placeholder = `Enter head measurement (${unitWord})`;
    }
    if (brimLengthInput) {
      brimLengthInput.placeholder = `Enter finished brim length (${unitWord})`;
    }
    const cdEl = resolveCrownDepthInput() || crownDepthInput;
    if (cdEl) {
      crownDepthInput = cdEl;
      const hv = hatSizeSelect?.value;
      const isStandard = Boolean(hv && hv !== 'custom');
      cdEl.placeholder = isStandard
