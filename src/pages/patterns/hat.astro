---
import Layout from "../../layouts/Layout.astro";
import ActionBar from "../../components/wizards/ActionBar.astro";
import UnitToggle from "../../components/wizards/UnitToggle.astro";
import GaugeInput from "../../components/wizards/GaugeInput.astro";
import PatternDiagram from "../../components/wizards/PatternDiagram.astro";
import Tooltip from "../../components/Tooltip.astro";
import WhyUseThisToolTooltip from "../../components/common/WhyUseThisToolTooltip.astro";
import PrintFooter from "../../components/common/PrintFooter.astro";
import WizardBackLink from "../../components/wizards/WizardBackLink.astro";
import FloatingInput from "../../components/tools/FloatingInput.astro";
import YarnRequirement from "../../components/tools/YarnRequirement.astro";
import PatternComments from "../../components/patterns/PatternComments.astro";
import PatternHeaderImage from "../../components/patterns/PatternHeaderImage.astro";
import WarningBox from "../../components/ui/WarningBox.astro";
import hatSizingRows from "../../data/sizing_hats.json";

// Import shared wizard styles
import '../../styles/wizard.css';

const pageUrl = "https://knitbymachine.com/wizards/hat-builder";

const whyUseThisTool = '';
const wizardTitle = 'Machine Knit Hat Pattern Builder';
const wizardDescription = 'Design the perfect custom hat with precise sizing, brim options, and crown shaping.';

const patternPersistWarning =
  "Your pattern will not be saved on this site. Please be sure to download and save your PDF — once you leave this page, your pattern will be gone.";
---

<Layout
  title="Machine Knit Hat Pattern Builder | Knit it Now"
  description="Create a custom machine knit hat pattern with your gauge, size, brim, and crown shaping. Get clear knitting instructions instantly."
>

<style>
/* Hat-specific styles only */
.back-link {
  display: inline-block;
  color: #52682D;
  text-decoration: none;
  font-weight: 500;
  margin-bottom: 1.5rem;
  padding: 0.5rem 0;
  transition: color 0.2s;
}

.back-link:hover {
  color: #3d4e21;
  text-decoration: underline;
}

/* Pattern term tooltip styling - :global needed for dynamically generated content */
:global(.pattern-term) {
  text-decoration: underline;
  text-decoration-style: dotted;
  text-decoration-color: #52682D;
  text-underline-offset: 2px;
  cursor: help;
  position: relative;
}

:global(.pattern-term)::after {
  content: attr(data-tooltip);
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: #333;
  color: #fff;
  padding: 0.5rem 0.75rem;
  border-radius: 4px;
  font-size: 0.85rem;
  font-style: normal;
  font-weight: normal;
  white-space: normal;
  width: max-content;
  max-width: 280px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s, visibility 0.2s;
  z-index: 100;
  pointer-events: none;
  margin-bottom: 4px;
  line-height: 1.4;
}

:global(.pattern-term):hover::after,
:global(.pattern-term):focus::after {
  opacity: 1;
  visibility: visible;
}

/* Disabled select styling */
select.disabled {
  opacity: 0.5;
  cursor: not-allowed;
  background-color: #f5f5f5;
}

/* Helper text for inputs */
.helper-text {
  display: block;
  font-size: 0.85rem;
  color: #666;
  margin-top: 0.25rem;
  line-height: 1.4;
}

/* Hat builder: grouped form sections (Build tab) — soft blocks, not card-heavy */
.hat-builder-inputs .hat-form-section {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  background: color-mix(in srgb, var(--kbm-green, #52682d) 4.5%, var(--page-bg, #fff));
  border: 1px solid rgba(82, 104, 45, 0.09);
  border-radius: 12px;
  padding: 1.15rem 1.2rem 1.2rem;
  margin-bottom: 1.5rem;
  box-shadow: 0 1px 2px rgba(45, 55, 30, 0.04);
}

@supports not (background: color-mix(in srgb, white, black)) {
  .hat-builder-inputs .hat-form-section {
    background: rgba(82, 104, 45, 0.045);
  }
}

.hat-builder-inputs .hat-form-section:last-of-type {
  margin-bottom: 0;
}

/* Collapse yarn section until the optional trigger is shown */
.hat-builder-inputs .hat-form-section--yarn:has(#hat-yarn-drawer-trigger-wrap[hidden]) {
  display: none;
}

.hat-builder-inputs .tab-panel#tab-build form > .hat-form-section:first-of-type {
  margin-top: 0.85rem;
}

#clear-hat-builder {
  background: none;
  border: none;
  color: #C2614e;
  font-size: 13px;
  text-decoration: underline;
  cursor: pointer;
  padding: 4px 8px;
}

#clear-hat-builder:hover {
  opacity: 0.7;
}

/* Section heading — distinct from field labels (.hat-field__label, floating labels) */
.hat-builder-inputs .hat-form-section__title,
.hat-builder-inputs .hat-form-section__heading {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--kbm-green, #52682d);
  letter-spacing: 0.02em;
  line-height: 1.25;
  margin: 0 0 0.7rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(82, 104, 45, 0.14);
}

/* Optional one-line intro under the section title (add element with this class when needed) */
.hat-builder-inputs .hat-form-section__intro {
  font-size: 0.9rem;
  font-weight: 400;
  color: #6b7280;
  line-height: 1.5;
  margin: -0.35rem 0 0.65rem;
  max-width: 40rem;
}

/* Tighter rhythm inside the block than between sections */
.hat-builder-inputs .hat-form-section .input-group {
  margin-bottom: 0.4rem;
}

.hat-builder-inputs .hat-form-section > .input-group:last-child {
  margin-bottom: 0;
}

.hat-builder-inputs .hat-form-section .hat-builder-custom-subfield {
  margin-top: 0.1rem;
}

.hat-builder-inputs .hat-form-section .helper-text {
  margin-top: 0.2rem;
}

@media (max-width: 640px) {
  .hat-builder-inputs .hat-form-section {
    padding: 1.2rem 1.05rem 1.25rem;
    margin-bottom: 1.35rem;
  }

  .hat-builder-inputs .hat-form-section__title,
  .hat-builder-inputs .hat-form-section__heading {
    font-size: 1.08rem;
    margin-bottom: 0.75rem;
  }
}

/* Hat builder: default input stack outside sections (e.g. if any remain) */
.hat-builder-inputs .input-group {
  margin-bottom: 0.55rem;
}

.hat-builder-inputs .hat-form-section--gauge :global(.gauge-input-wrapper) {
  margin-top: 0;
  margin-bottom: 0;
}

.hat-builder-inputs :global(.gauge-input-wrapper) {
  margin-top: 0.35rem;
  margin-bottom: 1rem;
}

/* Yarn drawer: presentation styles live on YarnRequirement (yarn--presentation-drawer) */
.hat-yarn-drawer-body :global(.yarn-requirement-tool) {
  margin: 0;
}

.hat-builder-inputs :global(.floating-input) {
  margin-bottom: 0;
}

.hat-builder-inputs :global(.floating-input input) {
  min-height: 52px;
  font-size: 1rem;
}

/* Hat builder only: Pattern tab locked until required build fields are complete */
.hat-builder-inputs .pattern-tab-nav .tab-btn.is-disabled {
  color: #9ca3af;
  opacity: 0.55;
  cursor: not-allowed;
}

.hat-builder-inputs .pattern-tab-nav .tab-btn.is-disabled:hover,
.hat-builder-inputs .pattern-tab-nav .tab-btn.is-disabled:focus-visible {
  color: #9ca3af;
  border-bottom-color: transparent;
  opacity: 0.55;
}

.hat-builder-inputs .pattern-tab-nav .tab-btn.is-disabled.active {
  color: #9ca3af;
  border-bottom-color: transparent;
}

#create-pattern-btn.button-disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.create-pattern-feedback {
  margin: 0.75rem 0 0;
  min-height: 1.25em;
  font-size: 0.9375rem;
  color: #6b7280;
}

/* Main page header: example photo + title (single intro for the whole wizard) */
.hat-builder-page-header {
  display: flex;
  gap: 24px;
  align-items: flex-start;
  text-align: left;
}

.hat-builder-page-header__media {
  flex-shrink: 0;
  max-width: min(420px, 100%);
  width: 100%;
}

.hat-builder-page-header__main {
  flex: 1;
  min-width: 0;
}

.hat-builder-page-header .page-header-title {
  justify-content: flex-start;
  margin-bottom: 0.5rem;
}

.hat-builder-page-header__main h1 {
  text-align: left;
  margin: 0 0 0.5rem 0;
}

.hat-builder-page-header__subtitle {
  text-align: left;
  margin: 0;
  color: #6b7280;
  font-size: 1.05rem;
  line-height: 1.6;
}

@media (max-width: 640px) {
  .hat-builder-page-header {
    flex-direction: column;
    align-items: stretch;
  }

  .hat-builder-page-header__media {
    max-width: 100%;
  }

  .hat-builder-page-header .page-header-title {
    justify-content: center;
  }

  .hat-builder-page-header__main h1,
  .hat-builder-page-header__subtitle {
    text-align: center;
  }

}

.inspiration-section {
  margin-top: 20px;
}

.inspiration-heading {
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 12px;
}

.pinterest-embed {
  display: flex;
  justify-content: center;
  width: 100%;
  overflow: hidden;
}

@media (max-width: 768px) {
  .pinterest-embed a {
    transform: scale(0.9);
    transform-origin: top center;
  }
}

.hat-pinterest-fallback-link {
  margin: 12px 0 0;
  font-size: 0.95rem;
}

.hat-pinterest-fallback-link a {
  color: var(--kbm-green, #52682d);
}

/* Subtle indent: custom numeric fields read as sub-fields of the custom dropdown choice */
.hat-builder-inputs .hat-builder-custom-subfield {
  padding-left: 14px;
  box-sizing: border-box;
}

/* Hat size select: site green for accent/focus; option colors where browsers allow */
#hat-size {
  accent-color: var(--kbm-green, #52682D);
}

/* Avoid styling option:checked on native <select>: Chromium can paint the wrong closed label. */

#hat-size option:hover,
#hat-size option:focus-visible {
  background-color: #dce8d0;
  color: #1f2937;
}

/* Dropdown completion: small check on the left inside the field (Build tab selects only) */
.hat-builder-inputs .hat-select-wrap {
  position: relative;
  display: block;
  width: 100%;
}

.hat-builder-inputs .hat-select-wrap__check {
  position: absolute;
  left: 0.65rem;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  width: 0.75rem;
  text-align: center;
  font-size: 0.68rem;
  line-height: 1;
  font-weight: 700;
  color: #52682d;
  pointer-events: none;
}

.hat-builder-inputs .hat-select-wrap:not(.is-complete) .hat-select-wrap__check::before {
  content: none;
}

.hat-builder-inputs .hat-select-wrap.is-complete .hat-select-wrap__check::before {
  content: "\2713";
}

.hat-builder-inputs .hat-select-wrap select {
  width: 100%;
  box-sizing: border-box;
}

.hat-builder-inputs .hat-select-wrap.is-complete select {
  padding-left: 1.9rem;
}

/* Crown Shaping: label row + slot for future help icon/tooltip */
.hat-builder-inputs .hat-field--crown .hat-field__label-row {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  margin-bottom: 0.35rem;
}

.hat-builder-inputs .hat-field--crown .hat-field__label {
  display: block;
  font-size: 0.8125rem;
  font-weight: 500;
  color: #374151;
  margin: 0;
  line-height: 1.25;
  text-align: left;
  flex: 0 0 auto;
}

.hat-builder-inputs .hat-field--crown .hat-field__help-slot {
  flex-shrink: 0;
}

.hat-builder-inputs .crown-help-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.375rem;
  height: 1.375rem;
  padding: 0;
  margin: 0;
  border: 1px solid #d1d5db;
  border-radius: 9999px;
  background: #fff;
  color: #6b7280;
  font-size: 0.75rem;
  font-weight: 600;
  line-height: 1;
  cursor: pointer;
}

.hat-builder-inputs .crown-help-trigger:hover {
  color: #374151;
  border-color: #9ca3af;
  background: #f9fafb;
}

.hat-builder-inputs .crown-help-trigger:focus-visible {
  outline: 2px solid #52682d;
  outline-offset: 2px;
}

.crown-help-overlay {
  position: fixed;
  inset: 0;
  z-index: 10050;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.55);
}

.crown-help-overlay:not([hidden]) {
  display: flex;
}

.crown-help-modal {
  position: relative;
  width: 90%;
  max-width: 42rem;
  margin: auto;
  padding: 1.5rem 1.5rem 1.25rem;
  background: #fff;
  border-radius: 0.75rem;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  box-sizing: border-box;
}

.crown-help-modal h2 {
  margin: 0 0 0.5rem 0;
  font-size: 1.125rem;
  font-weight: 600;
  color: #111827;
  padding-right: 2rem;
}

.crown-help-modal > p {
  margin: 0 0 1rem 0;
  font-size: 0.9375rem;
  line-height: 1.5;
  color: #4b5563;
}

.crown-help-close {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  width: 2rem;
  height: 2rem;
  padding: 0;
  border: none;
  background: transparent;
  color: #6b7280;
  font-size: 1.5rem;
  line-height: 1;
  cursor: pointer;
  border-radius: 0.25rem;
}

.crown-help-close:hover {
  color: #111827;
  background: #f3f4f6;
}

.crown-help-close:focus-visible {
  outline: 2px solid #52682d;
  outline-offset: 2px;
}

.crown-help-image {
  display: block;
  max-width: 100%;
  height: auto;
  margin: 0 auto;
}

/* Yarn estimator: right drawer (Build tab) */
:global(body.hat-yarn-drawer-open) {
  overflow: hidden;
}

.hat-yarn-drawer-trigger-wrap {
  text-align: center;
  margin-top: 0.75rem;
}

/* Unstyled button + optional yarn drawer trigger */
.yarn-check-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  color: var(--text-muted);
  margin: 0;
  padding: 0.25rem 0.125rem;
  border: none;
  background: none;
  font: inherit;
  font-size: 0.95rem;
  text-decoration: none;
  text-align: center;
}

.yarn-check-link .arrow {
  font-size: 0.9em;
  transition: transform 0.2s ease;
}

.yarn-check-link:hover .arrow {
  transform: translateX(3px);
}

.yarn-check-link:focus-visible {
  outline: 2px solid #52682d;
  outline-offset: 2px;
  border-radius: 2px;
}

.hat-yarn-drawer {
  position: fixed;
  inset: 0;
  z-index: 10040;
  pointer-events: none;
  visibility: hidden;
}

.hat-yarn-drawer.is-open {
  pointer-events: auto;
  visibility: visible;
}

.hat-yarn-drawer-backdrop {
  position: absolute;
  inset: 0;
  z-index: 0;
  margin: 0;
  padding: 0;
  border: none;
  display: block;
  width: 100%;
  height: 100%;
  cursor: default;
  background: rgba(30, 41, 59, 0.38);
  opacity: 0;
  transition: opacity 0.22s ease;
}

.hat-yarn-drawer.is-open .hat-yarn-drawer-backdrop {
  opacity: 1;
}

.hat-yarn-drawer-panel {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  width: min(30rem, 100vw);
  max-width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  background: linear-gradient(180deg, #faf9f6 0%, #f4f3ee 100%);
  border-radius: 20px 0 0 20px;
  box-shadow:
    inset 1px 0 0 rgba(255, 255, 255, 0.75),
    -1px 0 0 rgba(82, 104, 45, 0.07),
    -16px 0 48px rgba(15, 23, 42, 0.07),
    -6px 0 24px rgba(15, 23, 42, 0.04);
}

.hat-yarn-drawer.is-open .hat-yarn-drawer-panel {
  transform: translateX(0);
}

@media (prefers-reduced-motion: reduce) {
  .hat-yarn-drawer-backdrop,
  .hat-yarn-drawer-panel {
    transition: none;
  }
}

.hat-yarn-drawer-header {
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem 1.25rem;
  padding: 1.4rem 1.25rem 1rem 1.5rem;
  border-bottom: none;
}

.hat-yarn-drawer-header-text {
  flex: 1;
  min-width: 0;
}

.hat-yarn-drawer-eyebrow {
  margin: 0 0 0.4rem;
  font-size: 0.625rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #9ca3af;
}

.hat-yarn-drawer-title {
  margin: 0 0 0.5rem;
  font-size: 1.28rem;
  font-weight: 700;
  letter-spacing: -0.025em;
  color: #374151;
  line-height: 1.2;
}

.hat-yarn-drawer-lede {
  margin: 0;
  font-size: 0.875rem;
  line-height: 1.55;
  font-weight: 450;
  color: #6b7280;
  max-width: 36ch;
}

.hat-yarn-drawer-close {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.375rem;
  height: 2.375rem;
  margin-top: 0.1rem;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: rgba(55, 65, 81, 0.07);
  color: #6b7280;
  cursor: pointer;
  transition:
    background 0.15s ease,
    color 0.15s ease;
}

.hat-yarn-drawer-close:hover {
  background: rgba(82, 104, 45, 0.14);
  color: #3d4a2f;
}

.hat-yarn-drawer-close:focus-visible {
  outline: 2px solid #52682d;
  outline-offset: 2px;
}

.hat-yarn-drawer-close svg {
  display: block;
}

.hat-yarn-drawer-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 0.35rem 1.5rem 1.75rem;
  padding-bottom: max(1.75rem, env(safe-area-inset-bottom, 0px));
  -webkit-overflow-scrolling: touch;
}

@media (max-width: 640px) {
  .hat-yarn-drawer-panel {
    width: 100%;
    max-width: 100%;
    border-radius: 0;
    box-shadow: -8px 0 40px rgba(15, 23, 42, 0.08);
  }

  .hat-yarn-drawer-header {
    padding: max(0.85rem, env(safe-area-inset-top, 0px)) 1rem 0.85rem 1.15rem;
  }

  .hat-yarn-drawer-title {
    font-size: 1.15rem;
  }

  .hat-yarn-drawer-lede {
    max-width: none;
  }

  .hat-yarn-drawer-close {
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .hat-yarn-drawer-body {
    padding: 0.25rem 1.1rem max(1.5rem, env(safe-area-inset-bottom, 0px));
  }

  .yarn-check-link {
    min-height: 44px;
    padding: 0.5rem 0.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
}

/* At-a-Glance summary block styling */
.summary-block {
  background: #f8f9fa;
  border: 1px solid #e9ecef;
  border-radius: 8px;
  padding: 1.25rem;
  margin-top: 1.5rem;
}

.summary-block h4 {
  margin: 0 0 1rem 0;
  font-size: 1.1rem;
  color: #333;
}

.summary-total {
  font-size: 1.5rem;
  font-weight: 700;
  color: #52682D;
  margin-bottom: 1rem;
}

.summary-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

.summary-table th,
.summary-table td {
  padding: 0.5rem 0.75rem;
  text-align: left;
  border-bottom: 1px solid #e9ecef;
}

.summary-table th {
  font-weight: 600;
  color: #555;
  background: #f0f0f0;
}

.summary-table td:nth-child(2),
.summary-table td:nth-child(3),
.summary-table th:nth-child(2),
.summary-table th:nth-child(3) {
  text-align: center;
}

.summary-crown-style {
  margin-top: 0.75rem;
  font-size: 0.9rem;
  color: #666;
}

.summary-crown-style-inline {
  font-size: 0.85rem;
  font-weight: normal;
  color: #666;
}

/* Tips styling - :global needed for dynamically generated content */
:global(.pattern-tip) {
  font-size: 0.85rem;
  color: #374151;
  background: rgba(194, 97, 78, 0.07);
  border-left: 4px solid #c2614e;
  border-radius: 6px;
  padding: 0.75rem 1rem;
  margin: 0.5rem 0 0.75rem 0;
  line-height: 1.4;
}

:global(.pattern-tip strong) {
  font-weight: 700;
  color: #c2614e;
}

:global(.tips-inline-toggle) {
  color: #c2614e;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
}

:global(.tips-inline-toggle:hover) {
  text-decoration: underline;
}

:global(.tips-icon) {
  color: #c2614e;
  margin-right: 6px;
  font-size: 0.9em;
  vertical-align: middle;
  opacity: 0.85;
}

/* Tips OFF: quiet utility link only (no tip box) */
:global(.pattern-tips-off-row) {
  margin: 0 0 0.5rem 0;
  padding: 0;
  font-size: 0.8rem;
  line-height: 1.4;
}

:global(.pattern-tips-off-row .tips-icon) {
  cursor: pointer;
}

/* Results container styling */
.results-container {
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid #e9ecef;
}

/* Pattern tab: output only — no duplicate intro above */
.tab-panel#tab-pattern .results-container {
  margin-top: 0;
  padding-top: 0.5rem;
  border-top: none;
}

/* Print summary - hidden on screen, shown on print */
.print-summary {
  display: none;
}

.print-summary h3 {
  font-size: 0.95rem;
  margin: 0 0 0.5rem 0;
  font-weight: 600;
  color: #333;
}

.print-summary p {
  margin: 0.15rem 0;
  font-size: 0.85rem;
  color: #444;
}

/* Tips visibility (OFF row is not .pattern-tip, so it stays visible) */
:global(#pattern-content[data-show-tips="false"] .pattern-tip) {
  display: none;
}

:global(#pattern-content[data-show-tips="true"] .pattern-tip) {
  display: block;
}

/* Print-specific overrides for hat patterns */
@media print {
  @page {
    margin: 0.75in;
    @bottom-center {
      content: "Page " counter(page) " of " counter(pages);
    }
  }
  
  * {
    background: white !important;
    background-color: white !important;
  }
  
  body {
    background: white !important;
  }
  
  .page-header, .video-button {
    display: none;
  }

  :global(.back-link) {
    display: none !important;
  }
  
  /* Print header with pattern name */
  .print-header {
    display: block !important;
    text-align: center;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #333;
  }
  
  .highlight-box {
    background: white !important;
    border-left: 2px solid #333 !important;
    padding: 0.5rem !important;
  }
  
  :global(.pattern-term)::after {
    display: none !important;
  }
  
  /* Hide wizard inputs on print */
  .section-title,
  .input-group,
  .checkbox-group,
  .wizard-header,
  #standard-size,
  #custom-size,
  .gauge-inputs,
  .hat-builder-inputs .hat-form-section__title,
  .hat-builder-inputs .hat-form-section__heading {
    display: none !important;
  }

  .hat-builder-inputs .hat-form-section {
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    display: block !important;
  }

  .hat-builder-inputs .hat-form-section__intro {
    display: none !important;
  }
  
  /* Show print summary on print */
  .print-summary {
    display: block !important;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #ccc;
  }
  
  /* Print tips: when off, hide all tips including intro; when on, show all */
  :global(#pattern-content[data-show-tips="false"] .pattern-tip) {
    display: none !important;
  }

  :global(#pattern-content[data-show-tips="true"] .pattern-tip) {
    display: block !important;
    border-left: 1px solid #333 !important;
  }

  :global(.pattern-tips-off-row) {
    display: none !important;
  }

  /* Tabs: show Build + Pattern for print (summary + instructions); hide nav and placeholder tabs */
  .pattern-tab-nav {
    display: none !important;
  }

  .pattern-tabs .tab-panel#tab-share,
  .pattern-tabs .tab-panel#tab-inspiration {
    display: none !important;
  }

  .pattern-tabs .tab-panel#tab-build,
  .pattern-tabs .tab-panel#tab-pattern {
    display: block !important;
  }

  :global(.no-print) {
    display: none !important;
  }

  /* Build tab: only print header + settings summary; drop inputs/sections/CTA from layout. */
  .hat-builder-inputs #hat-builder-form > *:not(.print-header):not(#print-summary) {
    display: none !important;
  }

  /*
   * Shared pattern print shell (hat first; same class names for blankets/sweaters later).
   * Global print.css sets page-break-inside: avoid on .results-section / .pattern-card — override
   * inside .pattern-print-results so instructions can flow across pages; diagram uses .pattern-print-new-page.
   */
  .hat-builder-inputs #results .results-section,
  .hat-builder-inputs #results .pattern-print-results,
  .hat-builder-inputs #results .pattern-print-results .pattern-print-section--instructions,
  .hat-builder-inputs #results .pattern-print-results .pattern-card {
    break-inside: auto !important;
    page-break-inside: auto !important;
  }

  .pattern-print-new-page {
    break-before: page !important;
    page-break-before: always !important;
  }

  .pattern-print-keep-together {
    break-inside: avoid !important;
    page-break-inside: avoid !important;
  }

  .hat-builder-inputs #results .kbm-warning-box {
    display: none !important;
  }

  /* Diagram is the last pattern content; hide trailing site footer so it is not an extra final page. */
  .wizard-page:has(.hat-builder-inputs) > footer.kbm-print-footer {
    display: none !important;
  }
}
</style>

