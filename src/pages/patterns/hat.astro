  // Tips Toggle Functionality - called after pattern content is rendered
  const patternContent = document.getElementById('pattern-content');
  
  // Apply saved preference to pattern content on initial load
  const savedShowTips = localStorage.getItem('hat-show-tips') === 'true';
  patternContent.dataset.showTips = savedShowTips ? 'true' : 'false';

  function updatePatternTipsIntroUi(tipsOn) {
    const slot = patternContent.querySelector('.pattern-tips-intro-slot');
    if (!slot) return;
    const renderControl = window.kbmPatternTipsControlBoxHtml;
    slot.innerHTML = typeof renderControl === 'function' ? renderControl(tipsOn) : '';
    if (typeof window.kbmUpdateTipsResetLinkVisibility === 'function') {
      window.kbmUpdateTipsResetLinkVisibility(patternContent, 'hat-show-tips');
