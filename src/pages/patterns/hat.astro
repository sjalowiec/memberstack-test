        rowGauge: rowGaugeInput?.value?.trim(),
        hatSizingDataLength: hatSizingData?.length,
      };
      const readyNow = requiredPatternInputsComplete();
      isPatternReady = readyNow;
      console.log('[hat-builder debug] completion check', {
        completionResult: readyNow,
        requiredValuesUsedInCheck: requiredValuesSnapshot,
      });
      if (!readyNow) {
        console.log('form incomplete');
        showFinishRequiredSectionsMessage();
        return;
      }
      console.log('calling calculate()');
      calculate();
      console.log(
        '[hat-builder debug] Create handler: about to call activateWizardTab("pattern")'
      );
      const patternNav = document.getElementById('hat-tab-pattern');
      patternNav?.classList.remove('is-disabled');
      patternNav?.removeAttribute('aria-disabled');
      activateWizardTab('pattern');
    };

    /** Dev-only account-gate tracing (localhost hosts only; no-op in production). */
    const kbmGateDebug = (...args) => {
      try {
        if (/(^|\.)localhost$|^127\.0\.0\.1$|^0\.0\.0\.0$/.test(location.hostname)) {
          console.debug('[account-gate][hat]', ...args);
        }
      } catch (_) {
        /* ignore */
      }
    };

    createPatternBtnForClick.addEventListener('click', () => {
      // Membership gate: generating the pattern requires active Knit it Now membership.
      // The gate opens the membership prompt when access is denied (no silent fail).
      kbmGateDebug('Create My Pattern clicked');
      const gate = window.kbmEnsurePatternBuilderAccountGate;
      if (typeof gate !== 'function') {
        // Gate helper unavailable: fail closed so an anonymous visitor can never generate the
        // pattern. Surface the signup/login prompt if we can, then block (never generate).
        kbmGateDebug('gate helper missing — blocking + prompting');
        window.kbmOpenPatternBuilderAccountPrompt?.();
        return;
      }
      void gate()
        .then((allowed) => {
          kbmGateDebug('Create gate resolved — allowed:', allowed);
          // Strict: ONLY generate when the gate positively confirms an account.
          if (allowed === true) {
            kbmGateDebug('allowed — running runCreateHatPattern()');
            runCreateHatPattern();
          } else {
            kbmGateDebug('blocked — pattern NOT generated');
          }
        })
        .catch((err) => {
          // Fail closed on any error: never generate; re-surface the prompt.
          kbmGateDebug('gate errored — blocking + prompting', err);
          window.kbmOpenPatternBuilderAccountPrompt?.();
        });
    });
    console.log('build listener attached');
  } else {
    console.warn(
      '[hat-builder debug] create-pattern-btn not found; listener not attached (selector:',
      CREATE_PATTERN_BTN_SELECTOR,
      ')'
    );
  }

  function persistHatGaugeSlots() {
    try {
      localStorage.setItem(HAT_GAUGE_SLOTS_KEY, JSON.stringify(gaugeSlots));
    } catch (_) {
      /* ignore */
    }
  }

  /**
   * @param {'inches'|'cm'} fromU
   * @param {'inches'|'cm'} toU
   */
  function maybeFillHatGaugeSlotFromOtherUnit(fromU, toU) {
    const to = gaugeSlots[toU];
    if (to.stitch.trim() || to.row.trim()) return;
    const from = gaugeSlots[fromU];
    if (!from.stitch.trim() && !from.row.trim()) return;
    const fs = parseFloat(from.stitch);
    const fr = parseFloat(from.row);
    if (fromU === 'inches' && toU === 'cm') {
      if (Number.isFinite(fs)) to.stitch = (fs * GAUGE_IN_TO_CM_FACTOR).toFixed(1);
      if (Number.isFinite(fr)) to.row = (fr * GAUGE_IN_TO_CM_FACTOR).toFixed(1);
    } else if (fromU === 'cm' && toU === 'inches') {
      if (Number.isFinite(fs)) to.stitch = (fs * GAUGE_CM_TO_IN_FACTOR).toFixed(1);
      if (Number.isFinite(fr)) to.row = (fr * GAUGE_CM_TO_IN_FACTOR).toFixed(1);
    }
  }

  function applyHatGaugeSlotsToInputs() {
    if (!stitchGaugeInput || !rowGaugeInput) return;
    const u = unitStore.get() === 'cm' ? 'cm' : 'inches';
    stitchGaugeInput.value = gaugeSlots[u].stitch;
    rowGaugeInput.value = gaugeSlots[u].row;
  }

  function syncHatGaugeInputsToActiveSlot() {
    if (!stitchGaugeInput || !rowGaugeInput) return;
    const u = unitStore.get() === 'cm' ? 'cm' : 'inches';
    gaugeSlots[u] = {
      stitch: stitchGaugeInput.value,
      row: rowGaugeInput.value,
    };
    persistHatGaugeSlots();
  }

  stitchGaugeInput?.addEventListener('input', syncHatGaugeInputsToActiveSlot);
  stitchGaugeInput?.addEventListener('change', syncHatGaugeInputsToActiveSlot);
  rowGaugeInput?.addEventListener('input', syncHatGaugeInputsToActiveSlot);
  rowGaugeInput?.addEventListener('change', syncHatGaugeInputsToActiveSlot);

  function updateHatNeedleEstimate() {
    const needleValue = document.getElementById('needle-count-value-preview');
    const needleContext = document.getElementById('needle-size-context-preview');
    const previewWrap = document.getElementById('needle-check-result-preview');

    if (!needleValue || !needleContext || !previewWrap) return;

    const currentUnit = unitStore.get() === 'cm' ? 'cm' : 'inches';

    // Same finished circumference + gauge path as calculate() → cast-on line in generatePattern()
    let finishedCircRaw = 0;
    const hatSizeValue = hatSizeSelect?.value ?? '';
    if (hatSizeValue === 'custom') {
      finishedCircRaw = parseFloat(customCircInput?.value) || 0;
    } else if (hatSizeValue) {
      const selectedSize = hatSizingData.find((s) => s.size === hatSizeValue);
      if (selectedSize) finishedCircRaw = selectedSize.finishedSizeInches;
    }

    let finishedHatCircInches;
    if (hatSizeValue === 'custom') {
      finishedHatCircInches =
        currentUnit === 'inches'
          ? finishedCircRaw
          : convertLength(finishedCircRaw, 'cm', 'inches');
    } else {
      finishedHatCircInches = finishedCircRaw;
    }

    const stitchGauge = parseFloat(stitchGaugeInput?.value) || 0;
    const crown = crownSelect?.value ?? '';

    if (
      !Number.isFinite(finishedHatCircInches) ||
      finishedHatCircInches <= 0 ||
      !Number.isFinite(stitchGauge) ||
      stitchGauge <= 0
    ) {
      previewWrap.hidden = true;
      return;
    }

    const stGaugePerInch = gaugeToPerUnit(stitchGauge, currentUnit);
    const castOnSts = roundToEvenPreferUp(finishedHatCircInches * stGaugePerInch);
    const needles = applyHatCrownCastOnAdjustment(castOnSts, crown);

    needleValue.textContent = String(needles);
    const finLabel =
      finishedHatCircInches % 1 === 0
        ? String(finishedHatCircInches)
        : finishedHatCircInches.toFixed(1);
    needleContext.textContent = `for ${finLabel}" hat`;

    previewWrap.hidden = false;
  }

  document.getElementById('hat-stitch-gauge')?.addEventListener('input', updateHatNeedleEstimate);
  document.getElementById('hat-size')?.addEventListener('change', updateHatNeedleEstimate);
  crownSelect?.addEventListener('change', updateHatNeedleEstimate);
  customCircInput?.addEventListener('input', updateHatNeedleEstimate);
  customCircInput?.addEventListener('change', updateHatNeedleEstimate);

  /** Total finished hat length (inches): custom input, size chart hatLength, or fit style preset. */
  function resolveTotalHatLengthInches(fit, hatSizeValue, currentUnit) {
    if (!fit) return null;
    if (fit === 'custom') {
      const customLengthValue = parseFloat(customHatLengthInput?.value) || 0;
      if (customLengthValue <= 0) return null;
      return currentUnit === 'inches'
        ? customLengthValue
        : convertLength(customLengthValue, 'cm', 'inches');
    }
    const selectedSize =
      hatSizeValue && hatSizeValue !== 'custom'
        ? hatSizingData.find((s) => s.size === hatSizeValue)
        : null;
    const fromChart =
      selectedSize != null && Number(selectedSize.hatLength) > 0
        ? Number(selectedSize.hatLength)
        : null;
    const fromFit = fitHeightsPreset[fit];
    const inches = fromChart ?? fromFit;
    return inches != null ? inches : null;
  }

  /** Keeps YarnRequirement (Build tab) aligned with size, length, and unit — no gauge needed for area estimate */
  function syncHatYarnDimensions() {
    const currentUnit = unitStore.get();
    const lengthUnit = currentUnit === 'inches' ? 'in' : 'cm';
    const emptyDetail = { projectWidth: 0, projectLength: 0, lengthUnit, source: 'custom' };

    const hatSizeValue = hatSizeSelect?.value;
    if (!hatSizeValue) {
      window.dispatchEvent(new CustomEvent('kbm:yarnDimensions', { detail: emptyDetail }));
      return;
    }

    let finishedHatCircInches = 0;
    if (hatSizeValue === 'custom') {
      const circ = parseFloat(customCircInput?.value) || 0;
      if (circ <= 0) {
        window.dispatchEvent(new CustomEvent('kbm:yarnDimensions', { detail: emptyDetail }));
        return;
      }
      finishedHatCircInches = currentUnit === 'inches' ? circ : convertLength(circ, 'cm', 'inches');
    } else {
      const selectedSize = hatSizingData.find((s) => s.size === hatSizeValue);
      if (!selectedSize) {
        window.dispatchEvent(new CustomEvent('kbm:yarnDimensions', { detail: emptyDetail }));
        return;
      }
      finishedHatCircInches = selectedSize.finishedSizeInches;
    }

    const fit = fitSelect?.value;
    if (!fit) {
      window.dispatchEvent(new CustomEvent('kbm:yarnDimensions', { detail: emptyDetail }));
      return;
    }

    const totalHatLengthInches = resolveTotalHatLengthInches(fit, hatSizeValue, currentUnit);
    if (totalHatLengthInches == null || totalHatLengthInches <= 0) {
      window.dispatchEvent(new CustomEvent('kbm:yarnDimensions', { detail: emptyDetail }));
      return;
    }

    const targetWidthInches = finishedHatCircInches;
    let projectWidth;
    let projectLength;
    if (lengthUnit === 'in') {
      projectWidth = targetWidthInches;
      projectLength = totalHatLengthInches;
    } else {
      projectWidth = convertLength(targetWidthInches, 'inches', 'cm');
      projectLength = convertLength(totalHatLengthInches, 'inches', 'cm');
    }

    window.dispatchEvent(
      new CustomEvent('kbm:yarnDimensions', {
        detail: { projectWidth, projectLength, lengthUnit, source: 'custom' },
      })
    );
  }

  /** Size, hat length, and gauge only — for optional yarn estimator link (not brim/crown). */
  function isYarnEstimatorInputsReady() {
    const size = hatSizeSelect?.value;
    if (!size) return false;
    if (size === 'custom') {
      const circ = customCircInput?.value?.trim();
      if (!circ || Number(circ) <= 0) return false;
    } else {
      const selectedSize = hatSizingData.find((s) => s.size === size);
      if (!selectedSize || !(Number(selectedSize.finishedSizeInches) > 0)) return false;
    }

    const fit = fitSelect?.value;
    if (!fit) return false;
    if (fit === 'custom') {
      const len = customHatLengthInput?.value?.trim();
      if (!len || Number(len) <= 0) return false;
    }

    const gaugeSts = stitchGaugeInput?.value?.trim();
    const gaugeRows = rowGaugeInput?.value?.trim();
    if (!gaugeSts || !gaugeRows) return false;
    const st = Number(gaugeSts);
    const rg = Number(gaugeRows);
    if (!Number.isFinite(st) || st <= 0 || !Number.isFinite(rg) || rg <= 0) return false;

    return true;
  }

  /** Predicate: all required build fields complete (same rules as section checks / Pattern tab). */
  function requiredPatternInputsComplete() {
    const size = hatSizeSelect?.value;
    if (!size) return false;
    if (size === 'custom') {
      const circ = customCircInput?.value?.trim();
      if (!circ || Number(circ) <= 0) return false;
    } else {
      const selectedSize = hatSizingData.find((s) => s.size === size);
      if (!selectedSize || !(Number(selectedSize.finishedSizeInches) > 0)) return false;
    }

    const brimLen = brimLengthInput?.value?.trim();
    if (!brimLen || Number(brimLen) <= 0) return false;
    const crownVal = crownSelect?.value ?? '';
    const allowedCrowns = new Set(['gathered', 'wedge-4-decrease', 'spiral']);
    if (!allowedCrowns.has(crownVal)) return false;
    const bt = brimTypeSelect?.value;
    if (bt !== 'single' && bt !== 'folded') return false;

    const fit = fitSelect?.value;
    if (!fit) return false;
    if (fit === 'custom') {
      const len = customHatLengthInput?.value?.trim();
      if (!len || Number(len) <= 0) return false;
    }

    const gaugeSts = stitchGaugeInput?.value?.trim();
    const gaugeRows = rowGaugeInput?.value?.trim();
    if (!gaugeSts || !gaugeRows) return false;
    const st = Number(gaugeSts);
    const rg = Number(gaugeRows);
    if (!Number.isFinite(st) || st <= 0 || !Number.isFinite(rg) || rg <= 0) return false;

    return true;
  }

  /** Computed flag: mirrors requiredPatternInputsComplete(); refreshed in updatePatternReadinessUi and on Create click. */
  let createPatternFeedbackTimer = 0;
  function showFinishRequiredSectionsMessage() {
    const el = document.getElementById('create-pattern-feedback');
    if (!el) return;
    window.clearTimeout(createPatternFeedbackTimer);
    el.textContent = 'Finish the required sections to generate your pattern.';
    el.hidden = false;
    createPatternFeedbackTimer = window.setTimeout(() => {
      el.textContent = '';
      el.hidden = true;
    }, 4000);
  }

  function updatePatternReadinessUi() {
    const cta = document.getElementById('build-pattern-cta');
    const patternTabBtn =
      document.getElementById('hat-tab-pattern') ||
      document.querySelector('.pattern-tabs .tab-btn[data-tab="pattern"]');
    const createPatternBtn = document.getElementById('create-pattern-btn');
    isPatternReady = requiredPatternInputsComplete();
    const ready = isPatternReady;

    if (hatYarnDrawerTriggerWrap) {
      hatYarnDrawerTriggerWrap.hidden = !isYarnEstimatorInputsReady();
    }

    if (cta) {
      cta.style.display = 'block';
    }
    if (createPatternBtn) {
      createPatternBtn.removeAttribute('disabled');
      createPatternBtn.classList.toggle('button-disabled', !ready);
      if (ready) {
        createPatternBtn.removeAttribute('aria-disabled');
      } else {
        createPatternBtn.setAttribute('aria-disabled', 'true');
      }
    }
    if (patternTabBtn) {
      patternTabBtn.classList.toggle('is-disabled', !ready);
      if (ready) {
        patternTabBtn.removeAttribute('aria-disabled');
      } else {
        patternTabBtn.setAttribute('aria-disabled', 'true');
      }
    }

    if (!ready) {
      setHatZeroBodyWarningVisible(false);
      const patternNavBtn =
        document.getElementById('hat-tab-pattern') ||
        document.querySelector('.pattern-tabs .tab-btn[data-tab="pattern"]');
      if (patternNavBtn?.classList.contains('active')) {
        activateWizardTab('build');
      }
    }
  }

  window.addEventListener('kbm:units-change', (/** @type {CustomEvent<{ unit?: string }>} */ e) => {
    const d = e.detail;
    if (!d || !d.unit) return;
    const nextU = d.unit === 'cm' ? 'cm' : 'inches';
    refreshHatSizeDropdownLabels(nextU);
    refreshFitDropdownLabels(nextU);
    updatePlaceholders(nextU);

    if (!stitchGaugeInput || !rowGaugeInput) return;
    const prevU = unitStore.get() === 'cm' ? 'cm' : 'inches';
    gaugeSlots[prevU] = {
      stitch: stitchGaugeInput.value,
      row: rowGaugeInput.value,
    };
    persistHatGaugeSlots();
    maybeFillHatGaugeSlotFromOtherUnit(prevU, nextU);
    stitchGaugeInput.value = gaugeSlots[nextU].stitch;
    rowGaugeInput.value = gaugeSlots[nextU].row;
    persistHatGaugeSlots();
    updatePatternReadinessUi();
    updateHatNeedleEstimate();
  });

  hatYarnDrawerOpenBtn?.addEventListener('click', () => {
    if (!isYarnEstimatorInputsReady()) return;
    openHatYarnDrawer();
  });

  /**
   * Keep the native control's selected option in sync with .value. Some browsers report
   * value "" while selectedIndex still points at a real option, so the closed dropdown shows
   * the wrong label and :checked styling can mispaint.
   */
  function alignHatSelectPlaceholderIndex(sel) {
    if (!(sel instanceof HTMLSelectElement)) return;
    const v = (sel.value ?? '').trim();
    if (v !== '') return;
    const idx = Array.from(sel.options).findIndex(
      (opt) => String(opt.value ?? '').trim() === ''
    );
    if (idx >= 0 && sel.selectedIndex !== idx) sel.selectedIndex = idx;
  }

  function syncHatSelectCompletion() {
    [hatSizeSelect, brimTypeSelect, crownSelect, fitSelect].forEach((sel) => {
      if (!sel) return;
      alignHatSelectPlaceholderIndex(sel);
      const wrap = sel.closest('.hat-select-wrap');
      if (!wrap) return;
      const v = (sel.value ?? '').trim();
      wrap.classList.toggle('is-complete', v !== '');
    });
    syncHatLengthPickerUi();
    syncBrimTypePickerUi();
    updatePatternReadinessUi();
  }

  window.syncHatSelectCompletion = syncHatSelectCompletion;

  // Hat sizes: options are server-rendered from src/data/sizing_hats.json. Fetch only if SSR list missing (e.g. stale HTML).
  try {
    const ssrOk =
      hatSizeSelect &&
      hatSizeSelect.getAttribute('data-sizes-source') === 'ssr' &&
      hatSizeSelect.options.length > 2 &&
      Array.isArray(hatSizingData) &&
      hatSizingData.length > 0;

    if (!ssrOk && hatSizeSelect) {
      while (hatSizeSelect.options.length > 1) {
        hatSizeSelect.remove(1);
      }
      hatSizingData = [];
      const response = await fetch('/data/sizing_hats.json');
      if (!response.ok) {
        throw new Error(`Hat sizing fetch failed: ${response.status} ${response.statusText}`);
      }
      const parsed = await response.json();
      hatSizingData = Array.isArray(parsed) ? parsed.map(enrichHatSizingRow) : [];
      hatSizingData.forEach((size) => {
        const option = document.createElement('option');
        option.value = size.size;
        if (size.finishedSizeInches != null) {
          option.dataset.finishedSizeInches = String(size.finishedSizeInches);
        }
        option.textContent =
          size.optionLabel ||
          size.extended_label ||
          size.label ||
          size.size ||
          'Unnamed size';
        hatSizeSelect.appendChild(option);
      });
      const customOption = document.createElement('option');
      customOption.value = 'custom';
      customOption.textContent = '✏️ Enter your own finished hat size';
      hatSizeSelect.appendChild(customOption);
    } else if (!hatSizeSelect) {
      console.error('hat-size select element not found; cannot populate dropdown');
    }

    restoreHatBuilderSizeFromStorage();
    syncHatYarnDimensions();
    updateHatNeedleEstimate();
  } catch (error) {
    console.error('Failed to load hat sizing data:', error);
    if (hatSizeSelect && !Array.from(hatSizeSelect.options).some((o) => o.value === 'custom')) {
      const customOption = document.createElement('option');
      customOption.value = 'custom';
      customOption.textContent = '✏️ Enter your own finished hat size';
      hatSizeSelect.appendChild(customOption);
    }
    restoreHatBuilderSizeFromStorage();
    syncHatYarnDimensions();
    updateHatNeedleEstimate();
  }

  function syncCustomSizeSection() {
    if (!customSizeDiv || !hatSizeSelect) return;
    customSizeDiv.style.display = hatSizeSelect.value === 'custom' ? 'block' : 'none';
  }

  /** Restore hat size from localStorage after options exist. */
  function restoreHatBuilderSizeFromStorage() {
    if (!hatSizeSelect) return;
    const clearSizeToPlaceholder = () => {
      hatSizeSelect.selectedIndex = 0;
      if (customCircInput) customCircInput.value = '';
      syncCustomSizeSection();
      persistHatSize();
      syncHatSelectCompletion();
    };
    try {
      const raw = localStorage.getItem(HAT_SIZE_STORAGE_KEY);
      if (!raw || !String(raw).trim()) {
        clearSizeToPlaceholder();
        return;
      }
      const o = JSON.parse(raw);
      const sel = o && typeof o.sel === 'string' ? o.sel.trim() : '';
      if (!sel) {
        try {
          localStorage.removeItem(HAT_SIZE_STORAGE_KEY);
        } catch (_) {
          /* ignore */
        }
        clearSizeToPlaceholder();
        return;
      }
      const ok = Array.from(hatSizeSelect.options).some((opt) => opt.value === sel);
      if (!ok) {
        try {
          localStorage.removeItem(HAT_SIZE_STORAGE_KEY);
        } catch (_) {
          /* ignore */
        }
        clearSizeToPlaceholder();
        return;
      }
      hatSizeSelect.value = sel;
      if (customCircInput) {
        if (sel === 'custom') {
          customCircInput.value = typeof o.circ === 'string' ? o.circ : '';
        } else {
          customCircInput.value = '';
        }
      }
      syncCustomSizeSection();
      updatePlaceholders();
      persistHatSize();
      syncHatSelectCompletion();
    } catch (_) {
      try {
        localStorage.removeItem(HAT_SIZE_STORAGE_KEY);
      } catch (_) {
        /* ignore */
      }
      clearSizeToPlaceholder();
    }
  }

  function persistHatSize() {
    if (!hatSizeSelect) return;
    try {
      const sel = hatSizeSelect.value;
      if (!sel) {
        localStorage.removeItem(HAT_SIZE_STORAGE_KEY);
        return;
      }
      localStorage.setItem(
        HAT_SIZE_STORAGE_KEY,
        JSON.stringify({
          sel,
          circ: sel === 'custom' && customCircInput ? customCircInput.value : ''
        })
      );
    } catch (_) {
      /* ignore quota / private mode */
    }
  }

  if (hatSizeSelect) {
    syncCustomSizeSection();
