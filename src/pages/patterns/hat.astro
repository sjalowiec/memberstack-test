/* Crown Shaping: label row + slot for future help icon/tooltip */
.hat-builder-inputs .hat-field--crown .hat-field__label-row {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  margin-bottom: 0.35rem;
}

.hat-builder-inputs .hat-field--crown .hat-field__label {
  display: block;
  font-size: 0.8125rem;
  font-weight: 500;
  color: #374151;
  margin: 0;
  line-height: 1.25;
  text-align: left;
  flex: 0 0 auto;
}

.hat-builder-inputs .hat-field--crown .hat-field__help-slot {
  flex-shrink: 0;
}

.hat-builder-inputs .crown-help-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.375rem;
  height: 1.375rem;
  padding: 0;
  margin: 0;
  border: 1px solid #d1d5db;
  border-radius: 9999px;
  background: #fff;
  color: #6b7280;
  font-size: 0.75rem;
  font-weight: 600;
  line-height: 1;
  cursor: pointer;
}

.hat-builder-inputs .crown-help-trigger:hover {
  color: #374151;
  border-color: #9ca3af;
  background: #f9fafb;
}

.hat-builder-inputs .crown-help-trigger:focus-visible {
  outline: 2px solid #52682d;
  outline-offset: 2px;
}

