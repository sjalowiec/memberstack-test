    console.log('[hat-builder debug] activateWizardTab requested tabName:', target);
    console.log('[hat-builder debug] activateWizardTab active tab before:', {
      activeTabButtons: activeTabBtnsBefore,
      activePanels: activePanelsBefore,
    });
    // Tab clicks are already blocked when .is-disabled (see tab button listeners).
    // Do not block programmatic switches (e.g. Create My Pattern) — the Pattern tab could
    // still carry .is-disabled if readiness UI missed that node, which would hide results.
    const panel = document.getElementById(`tab-${target}`);
    if (!panel) return;
    tabButtons.forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.tab === target);
    });
    tabPanels.forEach((p) => {
      p.classList.toggle('active', p.id === `tab-${target}`);
    });
    const activeTabBtnsAfter = Array.from(
      document.querySelectorAll('.pattern-tabs .tab-btn.active')
    ).map((b) => b.dataset.tab);
    const activePanelsAfter = Array.from(
      document.querySelectorAll('.pattern-tabs .tab-panel.active')
    ).map((p) => p.id);
    console.log('[hat-builder debug] activateWizardTab active tab after:', {
      activeTabButtons: activeTabBtnsAfter,
      activePanels: activePanelsAfter,
    });
    if (target === 'share') {
      loadPatternComments();
