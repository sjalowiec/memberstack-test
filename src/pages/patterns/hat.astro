    syncHatSelectCompletion();
  }

  if (customHatLengthInput) {
    customHatLengthInput.addEventListener('input', () => {
      if (fitSelect?.value === 'custom') persistPatternInputs();
      syncHatYarnDimensions();
    });
    customHatLengthInput.addEventListener('change', () => {
      if (fitSelect?.value === 'custom') persistPatternInputs();
      syncHatYarnDimensions();
    });
  }
  
  // Auto-scroll state - resets when user edits after scrolling
  let hasAutoScrolled = false;
  
  // Auto-scroll helper function
  function maybeAutoScroll() {
    const resultsEl = document.getElementById('results');
    const isPatternVisible = resultsEl && resultsEl.style.display !== 'none';
    
    if (isPatternVisible && !hasAutoScrolled) {
      hasAutoScrolled = true;
      
      // Use requestAnimationFrame for timing, then a small delay for DOM settle
      requestAnimationFrame(() => {
        setTimeout(() => {
          const scrollTargetEl = document.getElementById('results');
          if (scrollTargetEl) {
            const siteHeader = document.querySelector('.kbm-header-wrap');
            const headerHeight = siteHeader?.offsetHeight ?? 120;
            const headerOffset = headerHeight + 16;
            const elementPosition = scrollTargetEl.getBoundingClientRect().top + window.scrollY;
            const offsetPosition = elementPosition - headerOffset;
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            window.scrollTo({
              top: offsetPosition,
              behavior: prefersReducedMotion ? 'auto' : 'smooth'
            });
          }
        }, 150); // Small delay for DOM to settle
      });
    }
  }
  
  // Reset scroll flag when user edits any field after scrolling
  const allInputs = [hatSizeSelect, customCircInput, brimLengthInput, brimTypeSelect, crownDepthInput, crownSelect, fitSelect, customHatLengthInput, stitchGaugeInput, rowGaugeInput];
  allInputs.forEach(input => {
    if (input) {
      input.addEventListener('input', () => {
        if (hasAutoScrolled) {
          hasAutoScrolled = false;
        }
      });
    }
  });
  
  // Auto-calculate (live updates as user types)
  setupAutoCalculate(
    [hatSizeSelect, customCircInput, brimLengthInput, brimTypeSelect, crownDepthInput, crownSelect, fitSelect, customHatLengthInput, stitchGaugeInput, rowGaugeInput],
    calculate
  );

  document.querySelectorAll('#tab-build select, #tab-build input').forEach((el) => {
    el.addEventListener('change', updatePatternReadinessUi);
    el.addEventListener('input', updatePatternReadinessUi);
  });

  updatePatternReadinessUi();
  syncHatYarnDimensions();

  window.addEventListener(
    'load',
    () => {
      syncHatSelectCompletion();
    },
    { once: true }
  );

  // Auto-scroll triggers on last required input (row gauge)
  // Triggers on: blur OR Enter key press
  if (rowGaugeInput) {
    rowGaugeInput.addEventListener('blur', maybeAutoScroll);
    
    rowGaugeInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        rowGaugeInput.blur(); // Blur will trigger maybeAutoScroll
      }
    });
  }
  
  // Action Bar
  printBtn.addEventListener('click', () => {
    window.print();
  });
  
  // Tips Toggle Functionality - called after pattern content is rendered
  const patternContent = document.getElementById('pattern-content');
  
  // Apply saved preference to pattern content on initial load
  const savedShowTips = localStorage.getItem('hat-show-tips') === 'true';
  patternContent.dataset.showTips = savedShowTips ? 'true' : 'false';
  
  function updatePatternTipsIntroUi(tipsOn) {
    const slot = patternContent.querySelector('.pattern-tips-intro-slot');
    if (!slot) return;
    if (tipsOn) {
      slot.innerHTML =
        '<div class="pattern-tip pattern-tip-intro" data-tip><strong>Tip:</strong> Pattern Tips are on to give you quick help and helpful reminders as you knit. <a href="#" class="tips-inline-toggle" data-testid="link-tips-toggle">Hide tips</a></div>';
    } else {
      slot.innerHTML =
        '<p class="pattern-tips-off-row"><i class="fa-regular fa-lightbulb" style="color: #c2614e;"></i><a href="#" class="tips-inline-toggle" data-testid="link-tips-toggle"> Show pattern tips</a></p>';
    }
  }

  patternContent.addEventListener('click', (e) => {
    const link = e.target.closest('.tips-inline-toggle');
    const icon = e.target.closest('.tips-icon');
    const iconInOffRow =
      icon && icon.closest('.pattern-tips-off-row') && patternContent.contains(icon);
    if (!((link && patternContent.contains(link)) || iconInOffRow)) return;
    e.preventDefault();
    const isShowing = patternContent.dataset.showTips === 'true';
    const newState = !isShowing;
    patternContent.dataset.showTips = newState ? 'true' : 'false';
    localStorage.setItem('hat-show-tips', newState ? 'true' : 'false');
    updatePatternTipsIntroUi(newState);
  });

  /** Round to integer; if odd, bump up to next even (stitch/row parity). @param {number} value */
  function roundToEvenPreferUp(value) {
    const n = Math.round(value);
    return n % 2 === 0 ? n : n + 1;
  }

  // Calculate Function
  function calculate() {
    console.log('calculate started');
    const currentUnit = unitStore.get();
    
    // Get head circumference
    let headCirc = 0;

    const hatSizeValue = hatSizeSelect.value;
    if (hatSizeValue === 'custom') {
      headCirc = parseFloat(customCircInput.value) || 0;
    } else if (hatSizeValue) {
      const selectedSize = hatSizingData.find((s) => s.size === hatSizeValue);
      if (selectedSize) {
        headCirc = selectedSize.circumference;
      }
    }
    
    // Get other inputs
    const crown = crownSelect.value;
    const fit = fitSelect.value;
    const stitchGauge = parseFloat(stitchGaugeInput.value) || 0;
    const rowGauge = parseFloat(rowGaugeInput.value) || 0;
    
    function abortIncomplete() {
      hideResults(resultsVisibilityConfig);
      const printFooterEl = document.querySelector(resultsVisibilityConfig.printFooterSelector);
      if (printFooterEl) printFooterEl.style.display = 'none';
    }

    if (!requiredPatternInputsComplete()) {
      abortIncomplete();
      return;
    }

    // Convert to inches for calculations
    // Note: Sizing data from dropdown is always in inches
    // Only convert custom input when in cm mode
    let headCircInches;
    if (hatSizeValue === 'custom') {
      headCircInches =
        currentUnit === 'inches'
          ? headCirc
          : convertLength(headCirc, 'cm', 'inches');
    } else {
      headCircInches = headCirc;
    }
    
    const stGaugePerInch = gaugeToPerUnit(stitchGauge, currentUnit);
    const rowGaugePerInch = gaugeToPerUnit(rowGauge, currentUnit);
    
    // Calculations
    const negativeEase = 0.90;
    const targetWidth = headCircInches * negativeEase;
    const castOnSts = roundToEvenPreferUp(targetWidth * stGaugePerInch);
    
    const totalHatLength = resolveTotalHatLengthInches(fit, hatSizeValue, currentUnit);
    if (totalHatLength == null || totalHatLength <= 0) {
      abortIncomplete();
      return;
    }
    const hatHeight = totalHatLength;
    
    const brimLengthRaw = parseFloat(brimLengthInput.value) || 0;
    const crownDepthField = resolveCrownDepthInput() || crownDepthInput;
    if (!crownDepthField) {
      abortIncomplete();
      return;
    }
    const crownDepthRaw = parseFloat(crownDepthField.value) || 0;
    const brimDepth =
      currentUnit === 'inches'
        ? brimLengthRaw
        : convertLength(brimLengthRaw, 'cm', 'inches');
    const crownHeightInches =
      currentUnit === 'inches'
        ? crownDepthRaw
        : convertLength(crownDepthRaw, 'cm', 'inches');
    const brimType = brimTypeSelect?.value === 'folded' ? 'folded' : 'single';
    const brimRows =
      brimType === 'folded'
        ? roundToEvenPreferUp(brimDepth * 2 * rowGaugePerInch)
        : roundToEvenPreferUp(brimDepth * rowGaugePerInch);
    const crownRowCount = roundToEvenPreferUp(crownHeightInches * rowGaugePerInch);
    
    // Calculate body height: total height minus brim minus crown
    const bodyHeightInches = Math.max(0, hatHeight - brimDepth - crownHeightInches);
    const bodyRows = roundToEvenPreferUp(bodyHeightInches * rowGaugePerInch);
    
    // Generate pattern
    generatePattern({
      headCircInches,
      targetWidth,
      castOnSts,
      hatHeight,
      brimDepth,
      brimRows,
      brimType,
      bodyRows,
      crownRowCount,
      bodyHeightInches,
      crownHeightInches,
      crown,
      fit,
      stGaugePerInch,
      rowGaugePerInch,
      stitchGaugeRaw: stitchGauge,
      rowGaugeRaw: rowGauge
    });
    console.log('[hat-builder debug] pattern data (after generatePattern)', {
      headCircInches,
      targetWidth,
      castOnSts,
      hatHeight,
      brimDepth,
      brimRows,
      brimType,
      bodyRows,
      crownRowCount,
      bodyHeightInches,
      crownHeightInches,
      crown,
      fit,
      stGaugePerInch,
      rowGaugePerInch,
      stitchGaugeRaw: stitchGauge,
      rowGaugeRaw: rowGauge,
    });

    // Yarn estimator: same numbers as Finished Measurements (targetWidth = eased body circumference)
    const yarnLengthUnit = currentUnit === 'inches' ? 'in' : 'cm';
    const yarnProjectWidth =
      yarnLengthUnit === 'in'
        ? targetWidth
        : convertLength(targetWidth, 'inches', 'cm');
    const yarnProjectLength =
      yarnLengthUnit === 'in'
        ? hatHeight
        : convertLength(hatHeight, 'inches', 'cm');
    window.dispatchEvent(
      new CustomEvent('kbm:yarnDimensions', {
        detail: {
          projectWidth: yarnProjectWidth,
          projectLength: yarnProjectLength,
          lengthUnit: yarnLengthUnit,
          source: 'custom',
        },
      })
    );
    
    // Show results (pattern content updates in the Pattern tab; tab switch only via Create My Pattern)
    {
      const resultsEl = document.querySelector(resultsVisibilityConfig.resultsSelector);
      const patternTabNav = document.getElementById('hat-tab-pattern');
      console.log('[hat-builder debug] before showResults', {
        showResults: typeof showResults,
        resultsContainerDisplayState: resultsEl ? resultsEl.style.display : '(no results el)',
        patternTabIsDisabledClass: patternTabNav
          ? patternTabNav.classList.contains('is-disabled')
          : '(no pattern tab el)',
        patternTabAriaDisabled: patternTabNav?.getAttribute('aria-disabled') ?? '(n/a)',
        activateWizardTabPatternNote:
          'activateWizardTab("pattern") runs in Create button handler after calculate() returns',
      });
    }
    showResults(resultsVisibilityConfig);

    // Update print summary
    updatePrintSummary({
      headCirc,
      headCircInches,
      brimDepth,
      crownDepthInches: crownHeightInches,
      crown,
      fit,
      hatHeight,
      stitchGauge,
      rowGauge,
      isCustom: hatSizeSelect.value === 'custom',
      isCustomLength: fit === 'custom',
      currentUnit
    });
  }
  
  function updatePrintSummary(data) {
    const {
      headCirc,
      headCircInches,
      brimDepth,
      crownDepthInches,
      crown,
      fit,
      hatHeight,
      stitchGauge,
      rowGauge,
      isCustom,
      isCustomLength,
      currentUnit
    } = data;
    
    // Size display
    const sizeLabel = isCustom
      ? `Custom — ${headCirc}${currentUnit === 'inches' ? '"' : ' cm'}`
      : hatSizeSelect.value && hatSizeSelect.selectedIndex >= 0
        ? hatSizeSelect.options[hatSizeSelect.selectedIndex].text
        : '—';
    document.getElementById('print-size').textContent = `Hat size: ${sizeLabel}`;
    
    const displayBrimLen =
      currentUnit === 'inches'
        ? formatLength(brimDepth, 'inches')
        : formatLength(convertLength(brimDepth, 'inches', 'cm'), 'cm');
    const displayCrownDep =
      currentUnit === 'inches'
        ? formatLength(crownDepthInches, 'inches')
        : formatLength(convertLength(crownDepthInches, 'inches', 'cm'), 'cm');
    const unitSuffix = currentUnit === 'inches' ? '"' : ' cm';
    document.getElementById('print-brim').textContent = `Finished Brim length: ${displayBrimLen}${unitSuffix}`;

    // Crown display
    const crownLabels = {
      gathered: 'Gathered (cinched top)',
      'wedge-4': '4-Wedge Decreases',
      'wedge-6': '6-Wedge Decreases',
      spiral: 'Spiral Crown (Smooth, Continuous)'
    };
    document.getElementById('print-crown').textContent = `Crown: ${crownLabels[crown]} — depth ${displayCrownDep}${unitSuffix}`;
    
    // Hat length display
    let lengthLabel;
    if (isCustomLength) {
      const displayHeight = currentUnit === 'inches' 
        ? hatHeight 
        : convertLength(hatHeight, 'inches', 'cm');
      lengthLabel = `Custom — ${displayHeight.toFixed(1)}${currentUnit === 'inches' ? '"' : ' cm'}`;
    } else {
      const fitLabels = {
        beanie: 'Beanie (7" height)',
        watchcap: 'Watch Cap (8.5" height)',
        slouchy: 'Slouchy (10" height)',
        relaxed: 'Relaxed (9" height)'
      };
      lengthLabel = fit ? fitLabels[fit] : '—';
    }
    document.getElementById('print-fit').textContent = `Hat length: ${lengthLabel}`;
    
    // Gauge display (matches active measurement unit)
    const gaugeRefPrint = currentUnit === 'inches' ? '4"' : '10 cm';
    document.getElementById('print-gauge').textContent = `Gauge: ${stitchGauge} sts / ${rowGauge} rows per ${gaugeRefPrint}`;
  }
  
  function generatePattern(calc) {
    const currentUnit = unitStore.get();
    const { headCircInches, targetWidth, castOnSts, hatHeight, brimDepth, brimRows, brimType, bodyRows, crownRowCount, crown, fit, stGaugePerInch, rowGaugePerInch, stitchGaugeRaw, rowGaugeRaw } = calc;
    
    // Convert display values
    const displayHeadCirc = currentUnit === 'inches' 
      ? formatLength(headCircInches, 'inches')
      : formatLength(convertLength(headCircInches, 'inches', 'cm'), 'cm');
    
    const displayWidth = currentUnit === 'inches'
      ? formatLength(targetWidth, 'inches')
      : formatLength(convertLength(targetWidth, 'inches', 'cm'), 'cm');
    
    const displayHeight = currentUnit === 'inches'
      ? formatLength(hatHeight, 'inches')
      : formatLength(convertLength(hatHeight, 'inches', 'cm'), 'cm');
    
    const displayBrimDepth = currentUnit === 'inches'
      ? formatLength(brimDepth, 'inches')
      : formatLength(convertLength(brimDepth, 'inches', 'cm'), 'cm');
    
    const unit = currentUnit === 'inches' ? 'inches' : 'cm';
    
    const brimInstructionHtml =
      'Work even in your chosen brim treatment — for example 1x1 or 2x2 ribbing or <span class="pattern-term" data-tooltip="Stitch pattern that copies knit and purl ribbing by having needles out of work. A favorite for knitters without a ribber.">mock ribbing</span>, a rolled stockinette edge, a fold-up band, or a <span class="pattern-term" data-tooltip="A folded, double-layer hem formed by hanging the cast-on stitches back onto the needles.">hung hem</span> — for the depth shown.';
    
    // Adjusted cast-on for wedge crown sizes (diagram + cast-on line only; crown text is unified below)
    let patternCastOnSts = castOnSts;
    if (crown === 'wedge-4') {
      patternCastOnSts = castOnSts - (castOnSts % 4);
    } else if (crown === 'wedge-6') {
      patternCastOnSts = castOnSts - (castOnSts % 6);
    }

    const crownHeading = 'Crown Decrease';
    const breakYarnTailPhrase =
      currentUnit === 'inches'
        ? 'a 12" tail'
        : `a ${Math.round(convertLength(12, 'inches', 'cm'))} cm tail`;
    const crownInstructions = `
      <p>Transfer every other needle to its neighbor, leaving emptied needles out of work.</p>
      <div class="pattern-tip" data-tip><strong>Tip:</strong> Keep 2 stitches in work on each edge for seaming.</div>
      <p>Knit ${crownRowCount} rows.</p>
      <p>Break yarn, leaving ${breakYarnTailPhrase}.</p>
    `;

    const finishingHtml =
      crown === 'gathered'
        ? ` 
        <p>Block the hat to set the shape.</p>
      <p>Pull the tail tight to gather the top of the hat.</p>
      <p>Use the tail to seam the body.</p>
      <p>Work in yarn ends.</p>`
        : `
      <p>Seam each crown wedge first, then seam the body using <span class="pattern-term" data-tooltip="An invisible, right-side seaming method that joins two edges neatly.">mattress stitch</span> or your preferred method. <span class="pattern-term" data-tooltip="Wet or steam to set the finished shape.">Block</span> if desired and weave in all ends.</p>`;
    
    // Pattern HTML — ON: full intro tip + Hide link; OFF: quiet “Show pattern tips” row only
    const savedShowTipsForBtn = localStorage.getItem('hat-show-tips') === 'true';
    const tipsIntroSlotHtml = savedShowTipsForBtn
      ? `<div class="pattern-tips-intro-slot"><div class="pattern-tip pattern-tip-intro" data-tip><strong>Tip:</strong> Pattern Tips are on to give you quick help and helpful reminders as you knit. <a href="#" class="tips-inline-toggle" data-testid="link-tips-toggle">Hide tips</a></div></div>`
      : `<div class="pattern-tips-intro-slot"><p class="pattern-tips-off-row"><i class="fa-regular fa-lightbulb" style="color: #c2614e;"></i><a href="#" class="tips-inline-toggle" data-testid="link-tips-toggle"> Show pattern tips</a></p></div>`;
    const patternHTML = `
      ${tipsIntroSlotHtml}
      <div class="highlight-box">
        <p><strong>Finished Measurements:</strong></p>
        <p>Head Circumference: ${displayHeadCirc} ${unit} → Hat Width: ${displayWidth} ${unit} (with <span data-tooltip-term="negative-ease">negative ease</span>)</p>
        <p>Total Height: ${displayHeight} ${unit} | Brim Depth: ${displayBrimDepth} ${unit}</p>
      </div>
      
      <h4>Gauge (from your swatch)</h4>
      <p>${stitchGaugeRaw} stitches & ${rowGaugeRaw} rows per ${currentUnit === 'inches' ? '4"' : '10 cm'}</p>
      
      <h4>Cast-On</h4>
      <p>Cast on <strong>${patternCastOnSts} stitches</strong>.</p>
      <div class="pattern-tip" data-tip><strong>Tip:</strong> Use the cast-on method of your choice.</div>
      
      <h4>Finished Brim (${displayBrimDepth} ${unit})</h4>
      <p>Work ${brimRows} rows:</p>
      ${brimType === 'folded' ? '<div class="pattern-tip" data-tip><strong>Tip:</strong> This length includes extra rows for folding. After knitting, fold the brim and secure if desired.</div>' : ''}
      <p>${brimInstructionHtml}</p>
      <div class="pattern-tip" data-tip><strong>Tip:</strong> Want a deeper brim? Knit extra brim rows before continuing to the body.</div>
      
      <h4>Body</h4>
      <p>Work ${bodyRows} rows in pattern after the brim.</p>
      
      <h4>${crownHeading}</h4>
      ${crownInstructions}
      
      <h4>Finishing</h4>
      ${finishingHtml}
    `;
    
    updateHTML('#pattern-content', patternHTML);
    patternContent.dataset.showTips = savedShowTipsForBtn ? 'true' : 'false';

    // Generate diagram
    generateDiagram(calc);
  }
  
  async function generateDiagram(calc) {
    const currentUnit = unitStore.get();
    const { hatHeight, brimDepth, targetWidth, castOnSts, brimRows, bodyRows, crown, crownRowCount, bodyHeightInches, crownHeightInches } = calc;
    
    // Format values with units
    const displayWidth = formatLengthWithUnit(
      currentUnit === 'inches' ? targetWidth : convertLength(targetWidth, 'inches', currentUnit),
      currentUnit
    );
    
    const displayHeight = formatLengthWithUnit(
      currentUnit === 'inches' ? hatHeight : convertLength(hatHeight, 'inches', currentUnit),
      currentUnit
    );
    
    const displayBrimDepth = formatLengthWithUnit(
      currentUnit === 'inches' ? brimDepth : convertLength(brimDepth, 'inches', currentUnit),
      currentUnit
    );
    
    const displayBodyHeight = formatLengthWithUnit(
      currentUnit === 'inches'
        ? bodyHeightInches
        : convertLength(bodyHeightInches, 'inches', currentUnit),
      currentUnit
    );
    
    const displayCrownDepth = formatLengthWithUnit(
      currentUnit === 'inches'
        ? crownHeightInches
        : convertLength(crownHeightInches, 'inches', currentUnit),
      currentUnit
    );
    
    // Calculate adjusted cast-on for wedge crowns (for display)
    let displayCastOnSts = castOnSts;
    if (crown === 'wedge-4') {
      displayCastOnSts = castOnSts - (castOnSts % 4);
    } else if (crown === 'wedge-6') {
      displayCastOnSts = castOnSts - (castOnSts % 6);
    }
    
    // Map crown type to template name
    let templateName;
    
    // Map crown values to correct SVG filenames
    if (crown === 'wedge-4') {
      templateName = 'hat-4-wedge';
    } else if (crown === 'wedge-6') {
      templateName = 'hat-6-wedge';
    } else {
      templateName = `hat-${crown}`; // gathered, spiral
    }
    
    try {
      // Load SVG template from diagrams directory
      const response = await fetch(`/diagrams/${templateName}.svg`);
      let svgContent = await response.text();
      
      // Replace placeholders with fully-formatted values (including units)
      svgContent = svgContent
        .replace(/{{WIDTH}}/g, displayWidth)
        .replace(/{{HEIGHT}}/g, displayHeight)
        .replace(/{{BRIM_DEPTH}}/g, displayBrimDepth)
        .replace(/{{BODY_HEIGHT}}/g, displayBodyHeight)
        .replace(/{{CROWN_DEPTH}}/g, displayCrownDepth)
        .replace(/{{CAST_ON_STS}}/g, `${displayCastOnSts} sts`)
        .replace(/{{BRIM_ROWS}}/g, `${brimRows} rows`)
        .replace(/{{BODY_ROWS}}/g, `${bodyRows} rows`)
        .replace(/{{CROWN_ROWS}}/g, `${crownRowCount} rows`);
      
      updateHTML('#diagram-content', svgContent);
    } catch (error) {
      console.error('Failed to load diagram template:', templateName, error);
      updateHTML('#diagram-content', '<p style="text-align: center; color: #6b7280;">Diagram unavailable</p>');
    }
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => {
    void initHatBuilder();
  });
} else {
  void initHatBuilder();
}
</script>

<script is:inline>
  const clearBtn = document.getElementById('clear-hat-builder');

  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      const confirmed = confirm('Clear all inputs and start over?');
      if (!confirmed) return;

      // Remove hat builder storage keys
      localStorage.removeItem('hat-builder-pattern-inputs');
      localStorage.removeItem('hat-builder-hat-size');
      localStorage.removeItem('hat-builder-gauge-slots');
      localStorage.removeItem('hat-unit');
      localStorage.removeItem('hat-show-tips');

      // Reset form
      const form = document.querySelector('#hat-builder-form');
      if (form) form.reset();

      // Clear custom inputs
      const customCirc = document.getElementById('custom-circumference');
      if (customCirc) customCirc.value = '';

      const customLength = document.getElementById('custom-hat-length');
      if (customLength) customLength.value = '';

      // Reset selects
      document.querySelectorAll('#hat-builder-form select').forEach((sel) => {
        sel.value = '';
        sel.selectedIndex = 0;
      });

      if (typeof window.hatBuilderClearInMemory === 'function') {
        window.hatBuilderClearInMemory();
      }

      // Re-sync UI if function exists
      if (typeof syncHatSelectCompletion === 'function') {
        syncHatSelectCompletion();
      }

      // Hide results
      const results = document.getElementById('results');
      if (results) results.style.display = 'none';

      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

</Layout>
