---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

const pageTitle = "Take a Look at the New Knit It Now";
const description =
  "An early look at the new Knit It Now — starting with the Help Hub. Share your beta feedback.";
---

<Layout
  title={pageTitle}
  description={description}
  bodyClass="page--tight-header"
  skipGlobalHyvor={true}
>
  <section class="container" style="max-width: 720px; margin: 0 auto; padding: 40px 20px;">
    <h1 style="margin-bottom: 16px;">Take a Look at the New Knit It Now</h1>

    <p style="font-size: 18px; line-height: 1.6; margin-bottom: 24px;">
      This is an early look at the new Knit It Now — starting with the Help Hub and growing from here.
    </p>

    <p style="margin-bottom: 20px;">
      Take a look around, then tell me what you think.
    </p>

    <ul style="margin-bottom: 32px;">
      <li>What feels helpful?</li>
      <li>What would you use?</li>
      <li>What would help you next?</li>
    </ul>

    <h2 style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
      <img
        src="/images/community-logo.svg"
        alt=""
        style="height: 24px; width: auto; opacity: 0.8;"
      />
      Share Your Thoughts
    </h2>

    <p style="margin-bottom: 30px;">
      Leave a comment below — I’d love to hear from you.
    </p>
  </section>

  <div class="kin-discussion beta-feedback__hyvor">
    <script async src="https://talk.hyvor.com/embed/embed.js" type="module"></script>
    <!-- Replace YOUR_WEBSITE_ID with your Hyvor Talk website ID (numeric string from Hyvor console). -->
    <hyvor-talk-comments
      website-id="14706"
      page-id="beta-feedback"
    ></hyvor-talk-comments>
  </div>

  <p class="beta-feedback__footer-link">
    <a href="/help-hub">Return to the Help Hub</a>
  </p>
</Layout>

<style>
  .beta-feedback__hyvor {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 0;
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 3rem;
  }

  .beta-feedback__footer-link {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 20px 2rem;
    text-align: center;
    font-size: 0.95rem;
  }

  .beta-feedback__footer-link a {
    color: var(--kbm-green, #52682d);
    font-weight: 600;
    text-decoration: none;
  }

  .beta-feedback__footer-link a:hover {
    text-decoration: underline;
  }
</style>
