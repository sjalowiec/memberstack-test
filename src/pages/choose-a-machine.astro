---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import WizardBackLink from "../components/wizards/WizardBackLink.astro";
import MachineChooser from "../components/machines/MachineChooser.astro";
---

<Layout
  title="Choose a Knitting Machine | Knit it Now"
  description="Answer a few questions to discover which knitting machine control types and features fit your goals."
  toolPrintTitle="Choose a Knitting Machine"
>
  <div class="wizard-page">
    <WizardBackLink fallback="/reference" label="? Back to Reference" />
    <PageHead title="Looking to buy a knitting machine?" />
    <MachineChooser
      bookingUrl="https://tidycal.com/quick-help/lets-talk-about-knitting-machines"
      titleTag="h2"
    />
  </div>
</Layout>

<style>
  .wizard-page {
    padding-top: 1rem;
    padding-bottom: 3rem;
    background: var(--page-bg);
    max-width: 1400px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .wizard-page :global(.page-head) {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .wizard-page :global(.page-title) {
    text-wrap: balance;
  }
</style>
