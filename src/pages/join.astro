---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import MembershipPricing from "../components/membership/MembershipPricing.astro";
---

<Layout title="Become a Member" description="Join Knit It Now — Basic or Premium membership, monthly or annual.">
  <div class="page-wrap">
    <PageHead title="Become a Member" breadcrumb="Home / Join" />

    <div class="join-content">
      <p class="join-intro">
        Choose the membership that fits how you knit. Checkout is handled securely through Memberstack.
      </p>

      <MembershipPricing />
    </div>
  </div>

  <style>
    .join-content {
      max-width: 56rem;
      margin-bottom: 2rem;
    }

    .join-intro {
      margin: 0 0 1.5rem 0;
      font-size: var(--text-base, 1rem);
      line-height: 1.5;
    }
  </style>

  <script>
    import "../scripts/joinCheckout.ts";
  </script>
</Layout>
