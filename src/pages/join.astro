---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import MembershipPricing from "../components/membership/MembershipPricing.astro";
---

<Layout
  title="Become a Member"
  description="Join Knit It Now membership — monthly or annual billing."
  bodyClass="page--tight-header"
>
  <div class="join-page page-wrap">
    <PageHead title="Become a Member" breadcrumb="Home / Join" />

    <div class="join-content membership-billing-scope">
      <p class="join-intro">
        Choose monthly or annual billing. Checkout is handled securely through Memberstack.
      </p>

      <MembershipPricing />
    </div>
  </div>

  <style>
    /* main.site-content already clears the fixed header; avoid stacking .page-wrap’s default top padding */
    .join-page.page-wrap {
      padding-top: 8px;
    }

    .join-content {
      max-width: 56rem;
      margin-bottom: 2rem;
    }

    .join-intro {
      margin: 0 0 1.5rem 0;
      font-size: var(--text-base, 1rem);
      line-height: 1.5;
    }
  </style>

  <script>
    import "../scripts/joinCheckout.ts";
    import "../scripts/membershipBillingToggle.ts";
  </script>
</Layout>
