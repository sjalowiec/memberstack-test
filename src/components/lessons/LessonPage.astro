---
import Layout from "../../layouts/Layout.astro";
import LessonInstructionalBody from "./LessonInstructionalBody.astro";
import { lessonPreviewBaseHref } from "../../lib/lessons/previewDocument";
import type { PreparedLessonPage } from "../../lib/lessons/prepareLessonPageTypes";

interface Props extends PreparedLessonPage {
  preview?: boolean;
}

const {
  lesson,
  requiresMemberAccess,
  showHelpHubBackLink,
  backToTipHref,
  backToTipLabel,
  relatedTipHref,
  hasLessonBlocks,
  renderableLessonBlocks,
  showLessonBodyEmptyState,
  inlineVimeoSrc,
  lessonLibraryVideos,
  hasLessonVideo,
  videoPreviewUsesSupportImage,
  supportImageForPreview,
  videoOpenLabel,
  hasSupportCard,
  showSupportImageInCard,
  hasLessonModalVideo,
  vimeoPlayerSrc,
  summaryHtml,
  preview = false,
} = Astro.props;

const lessonBodyProps = {
  lesson,
  hasLessonBlocks,
  renderableLessonBlocks,
  showLessonBodyEmptyState,
  relatedTipHref,
  inlineVimeoSrc,
  lessonLibraryVideos,
  hasLessonVideo,
  videoPreviewUsesSupportImage,
  supportImageForPreview,
  videoOpenLabel,
  hasSupportCard,
  showSupportImageInCard,
  hasLessonModalVideo,
  vimeoPlayerSrc,
};

const previewDocumentBaseHref = preview ? lessonPreviewBaseHref(Astro.url.origin) : "";
const title =
  typeof lesson.title === "string" && lesson.title.trim() !== ""
    ? lesson.title.trim()
    : "Member Lesson";
---

<Layout
  title={`${title} | Knit it Now`}
  documentBaseHref={previewDocumentBaseHref}
>
  <main class="site-content">
    <div class="lesson-page">
      <div class="lesson-page__inner">
        {preview && (
          <p class="lesson-preview-banner">
            Preview — saved {typeof lesson.status === "string" ? lesson.status : "draft"} (not public)
          </p>
        )}
        <header class="lesson-header">
          {showHelpHubBackLink && (
            <p class="lesson-back-link">
              <a href={backToTipHref}>← {backToTipLabel}</a>
            </p>
          )}
          <p class="lesson-badge">Member Lesson</p>
          <h1 class="lesson-header__title">{lesson.title}</h1>
          {summaryHtml && (
            <div class="lesson-header__intro" set:html={summaryHtml} />
          )}
        </header>

        {requiresMemberAccess && (
          <div class="lesson-member-gate" data-gated="locked" data-lesson-member-gate>
            <div class="lesson-member-gate__panel">
              <h2 class="lesson-member-gate__title">Members only</h2>
              <p class="lesson-member-gate__message">
                This lesson is included with Knit it Now membership.
              </p>
              <div class="lesson-member-gate__actions">
                <button type="button" class="kbm-btn kbm-btn-outline" data-lesson-gate-login>
                  Log in
                </button>
                <a href="/membership" class="kbm-btn kbm-btn-accent">
                  View Membership Options
                </a>
              </div>
            </div>
          </div>
        )}

        {requiresMemberAccess ? (
          <>
            <template data-lesson-member-body-template>
              <LessonInstructionalBody {...lessonBodyProps} />
            </template>
            <div data-lesson-member-body-mount hidden></div>
          </>
        ) : (
          <LessonInstructionalBody {...lessonBodyProps} />
        )}
      </div>
    </div>
  </main>
</Layout>

{/*
  Single client script (not a ternary of two <script> tags).
  Astro can hoist/emit only one branch of conditional scripts, which previously
  shipped bootLessonVideoModalForPublicLesson on member lessons and never mounted
  the deferred body. Runtime presence of [data-lesson-member-gate] selects the path.
*/}
<script>
  import {
    bootHelpHubMemberLessonGates,
    bootLessonVideoModalForPublicLesson,
  } from "../../scripts/helpHubMemberLessonGateClient";

  function bootLessonPageClient() {
    const needsMemberGate = Boolean(document.querySelector("[data-lesson-member-gate]"));
    if (needsMemberGate) {
      bootHelpHubMemberLessonGates();
    } else {
      bootLessonVideoModalForPublicLesson();
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootLessonPageClient);
  } else {
    bootLessonPageClient();
  }
</script>

<style>
  .site-content {
    padding-top: 1rem;
  }

  .lesson-page {
    padding: 0 1rem 2.5rem;
  }

  @media (min-width: 640px) {
    .lesson-page {
      padding: 0 1.5rem 3rem;
    }
  }

  .lesson-page__inner {
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    box-sizing: border-box;
  }

  .lesson-preview-banner {
    margin: 0 0 1rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #92400e;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 8px;
  }

  .lesson-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(82, 104, 45, 0.12);
  }

  .lesson-back-link {
    margin-bottom: 1rem;
  }

  .lesson-back-link a {
    font-weight: 600;
    text-decoration: none;
  }

  .lesson-back-link a:hover {
    text-decoration: underline;
  }

  .lesson-badge {
    display: inline-block;
    margin: 0 0 0.65rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #3d4a28;
    background: rgba(82, 104, 45, 0.1);
    border: 1px solid rgba(82, 104, 45, 0.18);
    border-radius: 4px;
  }

  .lesson-header__title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.45rem, 2.5vw, 1.85rem);
    font-weight: 700;
    line-height: 1.2;
    color: #243015;
  }

  .lesson-header__intro {
    font-size: 1.02rem;
    line-height: 1.65;
    color: #3a3f35;
  }

  .lesson-header__intro :first-child {
    margin-top: 0;
  }

  .lesson-header__intro :last-child {
    margin-bottom: 0;
  }

  .lesson-header__intro a {
    color: var(--kbm-green, #52682d);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .lesson-header__intro a:hover {
    color: #3d4f22;
  }

  .lesson-member-gate {
    margin: 0 0 1.5rem;
  }

  .lesson-member-gate__panel {
    padding: 1.25rem 1.35rem;
    border: 1px solid rgba(82, 104, 45, 0.2);
    border-radius: 12px;
    background: #f8faf6;
    text-align: center;
  }

  .lesson-member-gate__title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: #52682d;
  }

  .lesson-member-gate__message {
    margin: 0 0 1rem;
    color: #4d5a48;
    line-height: 1.5;
  }

  .lesson-member-gate__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    align-items: center;
  }

  [data-lesson-member-body-mount][hidden] {
    display: none !important;
  }

  :global(footer) {
    margin-top: 60px;
  }
</style>
<script is:inline>
  function printLessonExercise() {
    document.body.classList.add("print-exercise-only");
    window.print();
  }

  window.addEventListener("afterprint", () => {
    document.body.classList.remove("print-exercise-only");
  });
</script>
