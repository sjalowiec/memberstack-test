---
import {
  WHATS_NEW_ANNOUNCEMENT_NOTE,
  WHATS_NEW_ANNOUNCEMENT_READ_MORE,
} from "../../lib/whatsNew/announcement";

interface Props {
  /** Fetch and show the current announcement. Watson and admin pages leave this off. */
  auto?: boolean;
}

const { auto = false } = Astro.props;
---

<div
  class="wn-announce"
  data-wn-announcement
  data-wn-announcement-auto={auto ? "true" : undefined}
  hidden
  aria-hidden="true"
>
  <div class="wn-announce__backdrop" data-wn-announcement-backdrop></div>
  <div
    class="wn-announce__dialog"
    data-wn-announcement-dialog
    role="dialog"
    aria-modal="true"
    aria-labelledby="wn-announce-title"
    aria-describedby="wn-announce-intro wn-announce-note"
    tabindex="-1"
  >
    <div class="wn-announce__toolbar">
      <p class="wn-announce__kicker">What’s New</p>
      <button type="button" class="wn-announce__close" data-wn-announcement-close>
        Close
      </button>
    </div>
    <h2 id="wn-announce-title" class="wn-announce__title" data-wn-announcement-title></h2>
    <div id="wn-announce-intro" class="wn-announce__intro" data-wn-announcement-intro></div>
    <a class="kbm-btn kbm-btn-primary wn-announce__read" data-wn-announcement-read href="/whats-new">
      {WHATS_NEW_ANNOUNCEMENT_READ_MORE}
    </a>
    <p id="wn-announce-note" class="wn-announce__note">{WHATS_NEW_ANNOUNCEMENT_NOTE}</p>
    <p class="wn-announce__preview" data-wn-announcement-preview hidden>
      Preview only. This will not be marked as seen.
    </p>
  </div>
</div>

<script>
  import { initWhatsNewAnnouncement } from "../../scripts/whatsNewAnnouncement";
  initWhatsNewAnnouncement(document);
</script>

<style>
  .wn-announce[hidden] {
    display: none !important;
  }

  .wn-announce {
    position: fixed;
    inset: 0;
    z-index: 12000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .wn-announce__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(28, 36, 32, 0.55);
  }

  .wn-announce__dialog {
    position: relative;
    width: min(28rem, 100%);
    max-height: min(32rem, calc(100vh - 2rem));
    overflow: auto;
    background: #fff;
    color: #243028;
    border-radius: 14px;
    border: 1px solid #d5decc;
    box-shadow: 0 18px 50px rgba(28, 36, 32, 0.28);
    padding: 1rem 1.1rem 1.15rem;
  }

  .wn-announce__dialog:focus {
    outline: none;
  }

  .wn-announce__dialog:focus-visible {
    outline: 3px solid #c5d4b0;
    outline-offset: 3px;
  }

  .wn-announce__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .wn-announce__kicker {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--kbm-green, #52682d);
  }

  .wn-announce__close {
    appearance: none;
    border: 1px solid #c5d0bc;
    background: #f4f7f1;
    color: #243028;
    font: inherit;
    font-weight: 700;
    border-radius: 999px;
    min-height: 44px;
    padding: 0.4rem 0.95rem;
    cursor: pointer;
  }

  .wn-announce__close:hover,
  .wn-announce__close:focus-visible {
    background: #e7efe0;
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }

  .wn-announce__title {
    margin: 0 0 0.55rem;
    font-size: 1.35rem;
    line-height: 1.25;
  }

  .wn-announce__intro {
    margin: 0 0 0.9rem;
    max-height: 9.5rem;
    overflow: auto;
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .wn-announce__intro :global(p) {
    margin: 0 0 0.55rem;
  }

  .wn-announce__intro :global(p:last-child) {
    margin-bottom: 0;
  }

  .wn-announce__intro :global(ul),
  .wn-announce__intro :global(ol) {
    margin: 0.25rem 0 0.55rem;
    padding-left: 1.2rem;
  }

  .wn-announce__read {
    display: inline-flex;
    text-decoration: none;
  }

  .wn-announce__note {
    margin: 0.9rem 0 0;
    padding: 0.7rem 0.75rem;
    background: #f6f8f3;
    border-radius: 8px;
    color: #3d4a40;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .wn-announce__preview {
    margin: 0.75rem 0 0;
    color: #6b4e16;
    font-size: 0.88rem;
    font-weight: 600;
  }

  @media print {
    .wn-announce {
      display: none !important;
    }
  }
</style>
