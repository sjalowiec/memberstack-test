---
import type { CurrentLegacyMembersReport } from "../../lib/watson/currentLegacyMembersReport";
import { currentLegacyMemberRowToCsvCells } from "../../lib/watson/currentLegacyMembersReport";

interface Props {
  report: CurrentLegacyMembersReport;
}

const { report } = Astro.props;
const { rows, summary, note, asOfDateDisplay } = report;
const subscriptionTypes = summary.bySubscriptionType.map((item) => item.type);
---

<section
  class="watson__panel watson--report-wide"
  aria-labelledby="current-legacy-members-heading"
  data-current-legacy-report
>
  <h2 id="current-legacy-members-heading" class="watson__panel-title">
    Current Legacy Members
  </h2>
  <p class="watson-report__note">{note}</p>
  <p class="watson-report__meta">As of {asOfDateDisplay} - one row per legacy member</p>

  <div class="watson-report__cards" data-summary-cards>
    <article class="watson-report__card">
      <h3 class="watson-report__card-label">Total current members</h3>
      <p class="watson-report__card-value" data-summary="total">
        {summary.totalMembers.toLocaleString("en-US")}
      </p>
    </article>
    <article class="watson-report__card">
      <h3 class="watson-report__card-label">Expiring ? 30 days</h3>
      <p class="watson-report__card-value" data-summary="exp30">
        {summary.expiring30.toLocaleString("en-US")}
      </p>
    </article>
    <article class="watson-report__card">
      <h3 class="watson-report__card-label">Expiring ? 60 days</h3>
      <p class="watson-report__card-value" data-summary="exp60">
        {summary.expiring60.toLocaleString("en-US")}
      </p>
    </article>
    <article class="watson-report__card">
      <h3 class="watson-report__card-label">Expiring ? 90 days</h3>
      <p class="watson-report__card-value" data-summary="exp90">
        {summary.expiring90.toLocaleString("en-US")}
      </p>
    </article>
    <article class="watson-report__card">
      <h3 class="watson-report__card-label">Monthly</h3>
      <p class="watson-report__card-value" data-summary="monthly">
        {summary.monthlyCount.toLocaleString("en-US")}
      </p>
    </article>
    <article class="watson-report__card">
      <h3 class="watson-report__card-label">Non-monthly</h3>
      <p class="watson-report__card-value" data-summary="nonMonthly">
        {summary.nonMonthlyCount.toLocaleString("en-US")}
      </p>
    </article>
    <article class="watson-report__card">
      <h3 class="watson-report__card-label">With Stripe customer ID</h3>
      <p class="watson-report__card-value" data-summary="withStripe">
        {summary.withStripeCustomerId.toLocaleString("en-US")}
      </p>
    </article>
    <article class="watson-report__card">
      <h3 class="watson-report__card-label">Without Stripe customer ID</h3>
      <p class="watson-report__card-value" data-summary="withoutStripe">
        {summary.withoutStripeCustomerId.toLocaleString("en-US")}
      </p>
    </article>
  </div>

  <h3 class="watson__panel-title" style="font-size:1rem;">Counts by subscription type</h3>
  <ul class="watson-report__type-list" data-type-list>
    {
      summary.bySubscriptionType.map((item) => (
        <li data-type-row data-type={item.type}>
          <span>{item.type}</span>
          <span data-type-count>{item.count.toLocaleString("en-US")}</span>
        </li>
      ))
    }
  </ul>

  <div class="watson-report__filters">
    <div class="watson-report__filter">
      <label for="clm-filter-type">Subscription type</label>
      <select id="clm-filter-type" multiple size="6" data-filter="type">
        {subscriptionTypes.map((type) => <option value={type}>{type}</option>)}
      </select>
    </div>
    <div class="watson-report__filter">
      <label for="clm-filter-monthly">Monthly flag</label>
      <select id="clm-filter-monthly" data-filter="monthly">
        <option value="">All</option>
        <option value="1">monthlysubscriber = 1</option>
        <option value="0">monthlysubscriber ? 1</option>
      </select>
    </div>
    <div class="watson-report__filter">
      <label for="clm-filter-exp">Expiration range</label>
      <select id="clm-filter-exp" data-filter="exp">
        <option value="">All</option>
        <option value="30">Within 30 days</option>
        <option value="60">Within 60 days</option>
        <option value="90">Within 90 days</option>
      </select>
    </div>
    <div class="watson-report__filter">
      <label for="clm-filter-exceptions">
        <input type="checkbox" id="clm-filter-exceptions" data-filter="exceptionsOnly" />
        Exceptions only
      </label>
    </div>
    <div class="watson-report__filter">
      <label for="clm-filter-search">Search</label>
      <input id="clm-filter-search" type="search" placeholder="Name, email, ID" data-filter="search" />
    </div>
    <div class="watson-report__actions">
      <button type="button" class="watson-report__button--secondary watson-report__button" data-action="reset">
        Reset filters
      </button>
      <button type="button" class="watson-report__button" data-action="csv">
        Export CSV
      </button>
    </div>
  </div>

  <p class="watson-report__count">
    Showing <span data-visible-count>{rows.length}</span> of {rows.length} members
  </p>

  {
    rows.length === 0 ? (
      <p class="watson__placeholder">No current legacy members matched the active-member rule.</p>
    ) : (
      <div class="watson__table-wrap">
        <table class="watson-table" data-sortable-table data-report-table>
          <thead>
            <tr>
              <th scope="col" data-sort-key="name" data-sort-type="string" tabindex="0">Name</th>
              <th scope="col" data-sort-key="email" data-sort-type="string" tabindex="0">Email</th>
              <th scope="col" data-sort-key="memberid" data-sort-type="string" tabindex="0">
                Legacy member ID
              </th>
              <th scope="col" data-sort-key="type" data-sort-type="string" tabindex="0">
                Subscription type
              </th>
              <th
                scope="col"
                data-sort-key="expiration"
                data-sort-type="string"
                data-sort-default="true"
                data-sort-default-direction="asc"
                tabindex="0"
              >
                Membership expiration
              </th>
              <th scope="col" data-sort-key="days" data-sort-type="number" tabindex="0">
                Days remaining
              </th>
              <th scope="col">monthlysubscriber</th>
              <th scope="col">subscriptionrenewal</th>
              <th scope="col">currentsubscriber</th>
              <th scope="col">Stripe customer ID</th>
              <th scope="col">Latest amount</th>
              <th scope="col">Latest processor</th>
              <th scope="col">Latest rate ID</th>
              <th scope="col">Latest sub expiration</th>
              <th scope="col">Exceptions</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr
                  data-report-row
                  data-type={row.subscriptionTypeDisplay}
                  data-monthly={row.monthlysubscriber === 1 ? "1" : "0"}
                  data-days={row.daysRemaining ?? ""}
                  data-exceptions={row.exceptions.length > 0 ? "1" : "0"}
                  data-search={`${row.name} ${row.email ?? ""} ${row.memberid}`.toLowerCase()}
                  data-csv={JSON.stringify(currentLegacyMemberRowToCsvCells(row))}
                >
                  <td data-sort-value={row.name}>
                    <a href={row.profileHref}>{row.name}</a>
                  </td>
                  <td data-sort-value={row.email ?? ""}>{row.email ?? ""}</td>
                  <td data-sort-value={row.memberid}>
                    <code>{row.memberid}</code>
                  </td>
                  <td data-sort-value={row.subscriptionTypeDisplay}>{row.subscriptionTypeDisplay}</td>
                  <td data-sort-value={row.memberExpirationSort}>
                    {row.memberExpirationDisplay ?? ""}
                  </td>
                  <td data-sort-value={String(row.daysRemaining ?? "")}>
                    {row.daysRemaining ?? ""}
                  </td>
                  <td>{row.monthlysubscriberDisplay}</td>
                  <td>{row.subscriptionrenewalDisplay}</td>
                  <td>{row.currentsubscriberDisplay}</td>
                  <td>{row.stripeCustomerId ?? ""}</td>
                  <td>{row.latestAmountDisplay ?? ""}</td>
                  <td>{row.latestProcessorDisplay}</td>
                  <td>
                    {row.latestRateId ? <code>{row.latestRateId}</code> : ""}
                  </td>
                  <td data-sort-value={row.latestExpirationSort}>
                    {row.latestExpirationDisplay ?? ""}
                  </td>
                  <td class="watson-report__exceptions">{row.exceptionsDisplay}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    )
  }
</section>

<script>
  import { buildCsv, downloadCsv, parseMultiSelectValues } from "../../lib/watson/reportClientFilters";

  const root = document.querySelector("[data-current-legacy-report]");
  if (root instanceof HTMLElement) {
    const typeSelect = root.querySelector<HTMLSelectElement>('[data-filter="type"]');
    const monthlySelect = root.querySelector<HTMLSelectElement>('[data-filter="monthly"]');
    const expSelect = root.querySelector<HTMLSelectElement>('[data-filter="exp"]');
    const exceptionsOnly = root.querySelector<HTMLInputElement>('[data-filter="exceptionsOnly"]');
    const searchInput = root.querySelector<HTMLInputElement>('[data-filter="search"]');
    const rows = [...root.querySelectorAll<HTMLTableRowElement>("[data-report-row]")];
    const visibleCount = root.querySelector("[data-visible-count]");
    const csvHeaders = [
      "Name",
      "Email",
      "Legacy member ID",
      "Subscription type",
      "Membership expiration date",
      "Days remaining",
      "monthlysubscriber",
      "subscriptionrenewal",
      "currentsubscriber",
      "Legacy Stripe customer ID",
      "Latest subscription amount",
      "Latest subscription processor",
      "Latest subscription rate ID",
      "Latest subscription expiration",
      "Exceptions",
    ];

    function applyFilters() {
      const types = typeSelect ? parseMultiSelectValues(typeSelect) : [];
      const monthly = monthlySelect?.value ?? "";
      const exp = expSelect?.value ?? "";
      const onlyExceptions = Boolean(exceptionsOnly?.checked);
      const search = searchInput?.value.trim().toLowerCase() ?? "";
      let visible = 0;
      const typeCounts = new Map<string, number>();
      let monthlyCount = 0;
      let nonMonthlyCount = 0;
      let withStripe = 0;
      let withoutStripe = 0;
      let exp30 = 0;
      let exp60 = 0;
      let exp90 = 0;

      for (const row of rows) {
        const rowType = row.dataset.type ?? "";
        const rowMonthly = row.dataset.monthly ?? "0";
        const days = row.dataset.days === "" ? null : Number(row.dataset.days);
        const hasExceptions = row.dataset.exceptions === "1";
        const haystack = row.dataset.search ?? "";
        let show = true;
        if (types.length > 0 && !types.includes(rowType)) show = false;
        if (monthly === "1" && rowMonthly !== "1") show = false;
        if (monthly === "0" && rowMonthly === "1") show = false;
        if (exp && (days == null || days > Number(exp))) show = false;
        if (onlyExceptions && !hasExceptions) show = false;
        if (search && !haystack.includes(search)) show = false;
        row.hidden = !show;
        if (!show) continue;
        visible += 1;
        typeCounts.set(rowType, (typeCounts.get(rowType) ?? 0) + 1);
        if (rowMonthly === "1") monthlyCount += 1;
        else nonMonthlyCount += 1;
        const stripeCell = row.children[9]?.textContent?.trim() ?? "";
        if (stripeCell) withStripe += 1;
        else withoutStripe += 1;
        if (days != null && days <= 30) exp30 += 1;
        if (days != null && days <= 60) exp60 += 1;
        if (days != null && days <= 90) exp90 += 1;
      }

      if (visibleCount) visibleCount.textContent = String(visible);
      const setSummary = (key: string, value: number) => {
        const el = root.querySelector(`[data-summary="${key}"]`);
        if (el) el.textContent = value.toLocaleString("en-US");
      };
      setSummary("total", visible);
      setSummary("exp30", exp30);
      setSummary("exp60", exp60);
      setSummary("exp90", exp90);
      setSummary("monthly", monthlyCount);
      setSummary("nonMonthly", nonMonthlyCount);
      setSummary("withStripe", withStripe);
      setSummary("withoutStripe", withoutStripe);

      for (const typeRow of root.querySelectorAll<HTMLElement>("[data-type-row]")) {
        const type = typeRow.dataset.type ?? "";
        const countEl = typeRow.querySelector("[data-type-count]");
        const count = typeCounts.get(type) ?? 0;
        if (countEl) countEl.textContent = count.toLocaleString("en-US");
        typeRow.hidden = types.length > 0 ? !types.includes(type) : false;
      }
    }

    root.querySelector('[data-action="reset"]')?.addEventListener("click", () => {
      if (typeSelect) [...typeSelect.options].forEach((o) => (o.selected = false));
      if (monthlySelect) monthlySelect.value = "";
      if (expSelect) expSelect.value = "";
      if (exceptionsOnly) exceptionsOnly.checked = false;
      if (searchInput) searchInput.value = "";
      applyFilters();
    });

    root.querySelector('[data-action="csv"]')?.addEventListener("click", () => {
      const visibleRows = rows
        .filter((row) => !row.hidden)
        .map((row) => JSON.parse(row.dataset.csv ?? "[]") as string[]);
      downloadCsv(
        "watson-current-legacy-members.csv",
        buildCsv(csvHeaders, visibleRows),
      );
    });

    for (const el of [typeSelect, monthlySelect, expSelect, exceptionsOnly, searchInput]) {
      el?.addEventListener("change", applyFilters);
      el?.addEventListener("input", applyFilters);
    }
  }
</script>
