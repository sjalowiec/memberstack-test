---
import {
  buildCurrentBusinessSummaryCardViews,
  buildCurrentBusinessSummaryNotes,
  CURRENT_BUSINESS_PLACEHOLDER,
  CURRENT_BUSINESS_SECTIONS,
  formatCurrentBusinessAsOf,
  type CurrentBusinessSummaryCardView,
} from "../../lib/watson/currentBusiness";

interface Props {
  cards: CurrentBusinessSummaryCardView[];
  asOf: string | null;
  notes: string[];
  loadError: string | null;
}

const { cards, asOf, notes, loadError } = Astro.props;
---

{
  loadError ? (
    <p class="watson__status watson__status--error" role="alert">
      {loadError}
    </p>
  ) : null
}

{
  asOf ? (
    <p class="watson-current__as-of">
      Membership summary as of {formatCurrentBusinessAsOf(asOf)} UTC
    </p>
  ) : null
}

{
  notes.length > 0 ? (
    <div class="watson-current__notes" role="note">
      {notes.map((note) => (
        <p>{note}</p>
      ))}
    </div>
  ) : null
}

<section class="watson__panel" aria-labelledby="watson-current-summary-heading">
  <h2 id="watson-current-summary-heading" class="watson__panel-title">Summary</h2>
  <div class="watson-current__cards">
    {
      cards.map((card) => (
        <article class="watson-current__card" data-card-id={card.id}>
          <h3 class="watson-current__card-label">{card.label}</h3>
          <p
            class:list={[
              "watson-current__card-status",
              { "watson-current__card-status--live": card.isLive },
            ]}
          >
            {card.id === "shopify-sales" ? (
              <a href="/watson/sales">{card.displayValue}</a>
            ) : (
              card.displayValue
            )}
          </p>
          {card.note ? <p class="watson-current__card-note">{card.note}</p> : null}
        </article>
      ))
    }
  </div>
</section>

<section class="watson-current__sections" aria-label="Current business sections">
  {
    CURRENT_BUSINESS_SECTIONS.map((section) => (
      <article class="watson__panel watson__panel--placeholder" id={section.id}>
        <h2 class="watson__panel-title">{section.title}</h2>
        <p class="watson__placeholder">{CURRENT_BUSINESS_PLACEHOLDER}</p>
        {
          section.futureDataSources.length > 0 ? (
            <p class="watson-current__sources">
              Future data source: {section.futureDataSources.join(", ")}
            </p>
          ) : null
        }
        {
          section.futureExamples && section.futureExamples.length > 0 ? (
            <p class="watson-current__examples">
              Future examples: {section.futureExamples.join(", ")}
            </p>
          ) : null
        }
      </article>
    ))
  }
</section>

<style>
  .watson-current__as-of {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: #475569;
  }

  .watson-current__notes {
    margin: 0 0 1rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid #fde68a;
    border-radius: 8px;
    background: #fffbeb;
    color: #92400e;
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .watson-current__notes p {
    margin: 0;
  }

  .watson-current__notes p + p {
    margin-top: 0.35rem;
  }

  .watson-current__cards {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }

  .watson-current__card {
    padding: 0.85rem 0.95rem;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #f8fafc;
  }

  .watson-current__card-label {
    margin: 0 0 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #64748b;
  }

  .watson-current__card-status {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: #64748b;
  }

  .watson-current__card-status--live {
    font-size: 1.35rem;
    color: #243015;
  }

  .watson-current__card-note {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
    line-height: 1.4;
    color: #64748b;
  }

  .watson-current__sections {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 720px) {
    .watson-current__sections {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .watson-current__sources,
  .watson-current__examples {
    margin: 0.5rem 0 0;
    font-size: 0.86rem;
    line-height: 1.45;
    color: #64748b;
  }
</style>
