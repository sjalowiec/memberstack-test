---
import {
  getVisibleSavedPatternColumns,
  type MemberSavedPatternDisplay,
} from "../../lib/watson/memberSavedPatterns";

interface Props {
  records: MemberSavedPatternDisplay[];
}

const { records } = Astro.props;
const visibleColumns = getVisibleSavedPatternColumns(records);
---

{
  records.length === 0 ? (
    <p class="watson__placeholder">No saved pattern records found for this member.</p>
  ) : (
    <div class="watson__table-wrap">
      <table class="watson-table" data-sortable-table data-saved-patterns-table>
        <thead>
          <tr>
            {
              visibleColumns.showPatternName ? (
                <th
                  scope="col"
                  data-sort-key="patternname"
                  data-sort-type="string"
                  data-sort-default={visibleColumns.showSavedDate ? undefined : "true"}
                  tabindex="0"
                >
                  Pattern name
                </th>
              ) : null
            }
            {
              visibleColumns.showSavedAs ? (
                <th scope="col" data-sort-key="savedas" data-sort-type="string" tabindex="0">
                  Saved as
                </th>
              ) : null
            }
            {
              visibleColumns.showSavedDate ? (
                <th
                  scope="col"
                  data-sort-key="saveddate"
                  data-sort-type="date"
                  data-sort-default="true"
                  data-sort-default-direction="desc"
                  tabindex="0"
                >
                  Saved date
                </th>
              ) : null
            }
            {
              visibleColumns.showSize ? (
                <th scope="col" data-sort-key="size" data-sort-type="string" tabindex="0">
                  Size
                </th>
              ) : null
            }
            {
              visibleColumns.showBuildNotes ? (
                <th scope="col" data-sort-key="buildnotes" data-sort-type="string" tabindex="0">
                  Build notes
                </th>
              ) : null
            }
          </tr>
        </thead>
        <tbody>
          {
            records.map((record) => (
              <tr>
                {
                  visibleColumns.showPatternName ? (
                    <td data-sort-value={record.patternName}>
                      <div class="watson-saved-patterns__name">{record.patternName}</div>
                      {
                        record.garmentDescriptionPreview ? (
                          <p class="watson-saved-patterns__description">
                            {record.garmentDescriptionPreview}
                          </p>
                        ) : null
                      }
                    </td>
                  ) : null
                }
                {
                  visibleColumns.showSavedAs ? (
                    <td data-sort-value={record.savedAs ?? ""}>{record.savedAs ?? ""}</td>
                  ) : null
                }
                {
                  visibleColumns.showSavedDate ? (
                    <td data-sort-value={record.savedDateSort}>{record.savedDate ?? ""}</td>
                  ) : null
                }
                {
                  visibleColumns.showSize ? (
                    <td data-sort-value={record.size ?? ""}>{record.size ?? ""}</td>
                  ) : null
                }
                {
                  visibleColumns.showBuildNotes ? (
                    <td data-sort-value={record.buildNotes ?? ""}>{record.buildNotes ?? ""}</td>
                  ) : null
                }
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  )
}

<script>
  import { initSortableTables } from "../../lib/watson/sortableTable";
  initSortableTables(document);
</script>

<style>
  .watson-table td {
    max-width: 18rem;
    word-break: break-word;
  }

  .watson-saved-patterns__name {
    font-weight: 600;
  }

  .watson-saved-patterns__description {
    margin: 0.2rem 0 0;
    max-width: 22rem;
    overflow: hidden;
    color: #475569;
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
