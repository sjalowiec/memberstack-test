---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/watson.css";

interface Props {
  title: string;
  description?: string;
  heading: string;
  intro?: string;
}

const { title, description, heading, intro } = Astro.props;
---

<BaseLayout title={title} description={description} skipGlobalHyvor={true} bodyClass="watson-body">
  <main class="watson">
    <header class="watson__head">
      <nav class="watson__nav" aria-label="Watson">
        <a href="/watson">Dashboard</a>
        <a href="/watson/customers">Customers</a>
        <a href="/watson/birthdays">Birthdays</a>
        <a href="/watson/contact-messages">Contact Messages</a>
        <a href="/watson/video-replies">Video Replies</a>
        <a href="/watson/pattern-inspector">Saved Pattern Inspector</a>
        <a href="/watson/current">Current</a>
        <a href="/watson/reports">Reports</a>
        <a href="/admin">Admin</a>
        <form class="watson__logout" method="post" action="/api/watson/logout">
          <button type="submit">Logout</button>
        </form>
      </nav>
      <h1 class="watson__title">{heading}</h1>
      {intro ? <p class="watson__subtitle">{intro}</p> : null}
      <slot name="head" />
    </header>
    <slot />
  </main>
</BaseLayout>

<script>
  import { initSortableTables } from "../../lib/watson/sortableTable";
  initSortableTables(document);
</script>
