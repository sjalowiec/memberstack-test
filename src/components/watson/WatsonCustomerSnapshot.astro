---
import WatsonCustomerAccordionSection from "./WatsonCustomerAccordionSection.astro";
import { type CustomerSnapshotMetric } from "../../lib/watson/customerProfile";

interface Props {
  metrics: CustomerSnapshotMetric[];
}

const { metrics } = Astro.props;
---

<WatsonCustomerAccordionSection
  id="customer-snapshot"
  title="Customer Snapshot"
  class="watson-customer__snapshot"
>
  {
    metrics.length > 0 ? (
      <dl class="watson-customer__snapshot-grid">
        {
          metrics.map((metric) => (
            <div class="watson-customer__snapshot-item">
              <dt>{metric.label}</dt>
              <dd class:list={[{ "watson-customer__unavailable": metric.unavailable }]}>
                {metric.value}
              </dd>
            </div>
          ))
        }
      </dl>
    ) : (
      <p class="watson__placeholder">No snapshot metrics are available for this customer.</p>
    )
  }
</WatsonCustomerAccordionSection>
