---
import WatsonMemberCourses from "./WatsonMemberCourses.astro";
import WatsonMemberOrdersTable from "./WatsonMemberOrdersTable.astro";
import WatsonMemberPdfPurchases from "./WatsonMemberPdfPurchases.astro";
import { type MemberCourseDisplay } from "../../lib/watson/memberCourses";
import { type MemberOrderDisplay } from "../../lib/watson/memberOrders";

interface Props {
  courses: MemberCourseDisplay[];
  orders: MemberOrderDisplay[];
  hasLegacyHistory: boolean;
  legacyMemberid?: string | null;
  pdfPurchaseCount?: number | null;
}

const {
  courses,
  orders,
  hasLegacyHistory,
  legacyMemberid = null,
  pdfPurchaseCount = null,
} = Astro.props;

function formatRecentSummary(count: number, label: string, recentDate: string | null | undefined): string {
  const plural = count === 1 ? label : `${label}s`;
  if (recentDate) {
    return `${count} ${plural} - most recent ${recentDate}`;
  }
  return `${count} ${plural}`;
}
---

<div class="watson-customer__purchases" aria-label="Purchases and enrollments">
  <section id="customer-store-orders" class="watson__panel" aria-labelledby="watson-customer-orders-heading">
    <h2 id="watson-customer-orders-heading" class="watson__panel-title">Store purchases</h2>
    {
      hasLegacyHistory ? (
        <>
          <p class="watson__section-note">
            Imported legacy store transactions and line items from confirmed paid purchases.
          </p>
          {
            orders.length > 0 ? (
              <p class="watson-customer__purchase-summary">
                {formatRecentSummary(orders.length, "order", orders[0]?.orderDate)}
              </p>
            ) : null
          }
          <WatsonMemberOrdersTable orders={orders} />
        </>
      ) : (
        <p class="watson__placeholder watson-customer__unavailable">No legacy history</p>
      )
    }
  </section>

  <div id="customer-course-enrollments">
    {
      hasLegacyHistory ? (
        <WatsonMemberCourses
          courses={courses}
          heading="Learn DesignaKnit purchases and enrollments"
        />
      ) : (
        <section class="watson__panel" aria-labelledby="watson-customer-courses-heading">
          <h2 id="watson-customer-courses-heading" class="watson__panel-title">
            Learn DesignaKnit purchases and enrollments
          </h2>
          <p class="watson__placeholder watson-customer__unavailable">No legacy history</p>
        </section>
      )
    }
  </div>

  {
    hasLegacyHistory && legacyMemberid ? (
      <WatsonMemberPdfPurchases memberid={legacyMemberid} recordCount={pdfPurchaseCount ?? 0} />
    ) : (
      <section class="watson__panel" aria-labelledby="watson-customer-pdf-heading">
        <h2 id="watson-customer-pdf-heading" class="watson__panel-title">Pattern PDF purchases</h2>
        <p class="watson__placeholder watson-customer__unavailable">
          {hasLegacyHistory ? "Not available yet" : "No legacy history"}
        </p>
      </section>
    )
  }

  <section class="watson__panel" aria-labelledby="watson-customer-kin-courses-heading">
    <h2 id="watson-customer-kin-courses-heading" class="watson__panel-title">
      Knit It Now course ownership
    </h2>
    <p class="watson__placeholder watson-customer__unavailable">Not available yet</p>
  </section>

  <section class="watson__panel" aria-labelledby="watson-customer-quick-help-heading">
    <h2 id="watson-customer-quick-help-heading" class="watson__panel-title">Quick Help purchases</h2>
    <p class="watson__placeholder watson-customer__unavailable">Not available yet</p>
  </section>
</div>

<style>
  .watson-customer__purchases > :global(.watson__panel),
  .watson-customer__purchases > div > :global(.watson__panel) {
    margin-top: 1.25rem;
  }

  .watson-customer__purchase-summary {
    margin: 0 0 0.85rem;
    font-size: 0.9rem;
    color: #475569;
  }
</style>
