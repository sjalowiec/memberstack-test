---
import WatsonCustomerAccordionSection from "./WatsonCustomerAccordionSection.astro";
import WatsonCustomerStoreFulfillment from "./WatsonCustomerStoreFulfillment.astro";
import WatsonMemberCourses from "./WatsonMemberCourses.astro";
import WatsonMemberOrdersTable from "./WatsonMemberOrdersTable.astro";
import {
  buildPdfPurchasesFragmentUrl,
} from "../../lib/watson/watsonMemberPdfPurchasesSection";
import { type MemberCourseDisplay } from "../../lib/watson/memberCourses";
import { type MemberOrderDisplay } from "../../lib/watson/memberOrders";

interface Props {
  courses: MemberCourseDisplay[];
  orders: MemberOrderDisplay[];
  hasLegacyHistory: boolean;
  legacyMemberid?: string | null;
  pdfPurchaseCount?: number | null;
  notesWriteId: string;
  memberstackId?: string | null;
  profileType: "legacy" | "memberstack";
  destinationState?: string | null;
  destinationPostal?: string | null;
}

const {
  courses,
  orders,
  hasLegacyHistory,
  legacyMemberid = null,
  pdfPurchaseCount = null,
  notesWriteId,
  memberstackId = null,
  profileType,
  destinationState = null,
  destinationPostal = null,
} = Astro.props;

const pdfCount = pdfPurchaseCount ?? 0;
const pdfFragmentUrl =
  hasLegacyHistory && legacyMemberid ? buildPdfPurchasesFragmentUrl(legacyMemberid) : "";

function formatRecentSummary(count: number, label: string, recentDate: string | null | undefined): string {
  const plural = count === 1 ? label : `${label}s`;
  if (recentDate) {
    return `${count} ${plural} - most recent ${recentDate}`;
  }
  return `${count} ${plural}`;
}
---

<div class="watson-customer__purchases" aria-label="Purchases and enrollments">
  <WatsonCustomerAccordionSection
    id="customer-store-orders"
    title="Store Purchases"
    count={hasLegacyHistory ? orders.length : 0}
  >
    {
      hasLegacyHistory ? (
        <>
          <p class="watson__section-note">
            Imported legacy store transactions and line items from confirmed paid purchases.
          </p>
          {
            orders.length > 0 ? (
              <p class="watson-customer__purchase-summary">
                {formatRecentSummary(orders.length, "order", orders[0]?.orderDate)}
              </p>
            ) : null
          }
          <WatsonMemberOrdersTable orders={orders} />
        </>
      ) : (
        <p class="watson__placeholder watson-customer__unavailable">No legacy history</p>
      )
    }
  </WatsonCustomerAccordionSection>

  <WatsonCustomerStoreFulfillment
    notesWriteId={notesWriteId}
    memberstackId={memberstackId}
    legacyMemberid={legacyMemberid}
    profileType={profileType}
    destinationState={destinationState}
    destinationPostal={destinationPostal}
  />

  <WatsonCustomerAccordionSection
    id="customer-course-enrollments"
    title="Course Access"
    count={hasLegacyHistory ? courses.length : 0}
  >
    {
      hasLegacyHistory ? (
        <WatsonMemberCourses courses={courses} embedded={true} />
      ) : (
        <p class="watson__placeholder watson-customer__unavailable">No legacy history</p>
      )
    }
  </WatsonCustomerAccordionSection>

  <WatsonCustomerAccordionSection
    id="customer-pdf-purchases"
    title="PDF Purchases"
    count={hasLegacyHistory ? pdfCount : 0}
  >
    {
      hasLegacyHistory && legacyMemberid ? (
        <>
          <p class="watson__section-note">
            Imported from <code>legacy_pattern_library_purchases</code>, with PDF metadata from
            <code>legacy_pattern_library</code> and optional store totals from
            <code>legacy_store_transactions.transactionid</code> when the transaction GUID matches.
            There is no separate download-status field in this export.
          </p>
          <div
            data-watson-customer-pdf-panel
            data-record-count={String(pdfCount)}
            data-pdf-purchases-fragment-url={pdfFragmentUrl}
          ></div>
        </>
      ) : (
        <p class="watson__placeholder watson-customer__unavailable">
          {hasLegacyHistory ? "Not available yet" : "No legacy history"}
        </p>
      )
    }
  </WatsonCustomerAccordionSection>

  <WatsonCustomerAccordionSection
    id="customer-kin-courses"
    title="Knit It Now Course Ownership"
  >
    <p class="watson__placeholder watson-customer__unavailable">Not available yet</p>
  </WatsonCustomerAccordionSection>

  <WatsonCustomerAccordionSection id="customer-quick-help" title="Quick Help Purchases">
    <p class="watson__placeholder watson-customer__unavailable">Not available yet</p>
  </WatsonCustomerAccordionSection>
</div>

<style>
  .watson-customer__purchase-summary {
    margin: 0 0 0.85rem;
    font-size: 0.9rem;
    color: #475569;
  }
</style>
