---
import videosPublic from "../data/videos-public.json";
import { buildGlossaryRelatedVideosHtml } from "../lib/glossary/glossaryCatalogVideos";
import type { PublicVideoRow } from "../lib/lessonVideo";
import { filterPublicCatalogVideos } from "../lib/videoPublic";

interface Props {
  entry: any;
  relatedTermsData?: Array<{ slug: string; term: string }>;
}

const { entry, relatedTermsData = [] } = Astro.props;

const vimeoIdsRaw = entry?.vimeoIds;
const vimeoIds: string[] = Array.isArray(vimeoIdsRaw)
  ? Array.from(
      new Set(
        vimeoIdsRaw
          .map((id: unknown) => String(id ?? "").trim())
          .filter((id: string) => id.length > 0)
      )
    )
  : [];
const videoTitleBase = (entry?.english ?? "").toString().replace(/<[^>]*>/g, "").trim();

const catalogVideos = filterPublicCatalogVideos(videosPublic as PublicVideoRow[]);
const relatedVideosHtml = buildGlossaryRelatedVideosHtml(entry, catalogVideos, vimeoIds);

const imageSrc = entry?.image
  ? (entry.image.startsWith("http") || entry.image.startsWith("/")
    ? entry.image
    : `/images/glossary/${String(entry.image).replace(/^\.?\//, "")}`)
  : "";

const helpinfoRaw = (entry?.helpinfo ?? entry?.helpInfo ?? entry?.Helpinfo ?? "").toString();
function isNonemptyHelpinfo(raw: string): boolean {
  const s = raw.trim();
  if (!s || s.toUpperCase() === "NULL") return false;
  const textOnly = s.replace(/<[^>]*>/g, "").replace(/&nbsp;/gi, " ").replace(/\s+/g, " ").trim();
  if (textOnly.length > 0) return true;
  return /<img\b/i.test(s);
}
const showHelpinfo = isNonemptyHelpinfo(helpinfoRaw);

const relatedToolsRaw = entry?.relatedTools;
const relatedTools = Array.isArray(relatedToolsRaw)
  ? relatedToolsRaw.filter(
      (t: { name?: string; url?: string; icon?: string }) =>
        t && typeof t.url === "string" && t.url.trim() && typeof t.name === "string" && t.name.trim()
    )
  : [];
const showRelatedTools = relatedTools.length > 0;
---

<style>
  .glossary-entry {
    max-width: 1200px;
    margin: 0 auto;
    margin-top: 0;
    padding: 0 20px 60px;
    padding-top: 0;
  }

  .glossary-entry > :first-child {
    margin-top: 0 !important;
  }

  .glossary-entry h1 {
    margin-top: 0 !important;
  }

  .glossary-entry__title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #1f2937;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .back-link {
    display: inline-block;
    color: var(--kbm-green);
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .glossary-entry-image {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin: 0 0 1.25rem;
    text-align: center;
    box-sizing: border-box;
  }

  .glossary-entry-image .glossary-image {
    display: block;
    margin: 0 auto;
    max-width: min(100%, 520px);
    width: auto;
    height: auto;
    border-radius: 12px;
    border: 1px solid #e2e6df;
    object-fit: contain;
  }

 
  /* Container-safe: fills the content column in both the full page and the
     narrow glossary popup dialog. Large viewing is handled by "Watch Larger". */
  .glossary-entry-videos {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    max-width: 900px;
    margin: 1.5rem auto 2rem;
  }

  .glossary-video-block {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.6rem;
  }

  .glossary-video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e2e6df;
    background: #000;
  }

  .glossary-video iframe {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    display: block;
    border: 0;
  }

  .glossary-video-enlarge {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--kbm-green, #52682d);
    background: var(--kbm-green, #52682d);
    color: #fff;
    font: inherit;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .glossary-video-enlarge:hover,
  .glossary-video-enlarge:focus-visible {
    background: #3f5323;
    outline: none;
  }

  .glossary-video-enlarge:focus-visible {
    outline: 2px solid rgba(82, 104, 45, 0.45);
    outline-offset: 2px;
  }

  .glossary-entry-helpinfo {
    margin: 0 auto 1.5rem;
    max-width: 680px;
    line-height: 1.65;
    color: #374151;
    font-size: 1.05rem;
  }

  /* Template + helpinfo (set:html): injected nodes lack scoped data-astro attrs — use :global under helpinfo */
  .glossary-related-tools,
  .glossary-entry-helpinfo :global(.glossary-related-tools) {
    margin-top: 1.25rem;
    padding: 0.9rem 1rem;
    border-radius: 10px;
    background: rgba(82, 104, 45, 0.06);
    border: 1px solid rgba(82, 104, 45, 0.15);
  }

  .glossary-related-tools__heading,
  .glossary-entry-helpinfo :global(.glossary-related-tools__heading) {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #52682d;
  }

  .glossary-related-tools__list,
  .glossary-entry-helpinfo :global(.glossary-related-tools ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .glossary-related-tools__item,
  .glossary-entry-helpinfo :global(.glossary-related-tools li) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .glossary-related-tools__link,
  .glossary-entry-helpinfo :global(.glossary-related-tools__link) {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.65rem;
    padding: 0.4rem 0.5rem;
    border-radius: 8px;
    text-decoration: none;
    color: #1f2937;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .glossary-related-tools__link:hover,
  .glossary-related-tools__link:focus-visible,
  .glossary-entry-helpinfo :global(.glossary-related-tools__link:hover),
  .glossary-entry-helpinfo :global(.glossary-related-tools__link:focus-visible) {
    background: rgba(82, 104, 45, 0.12);
    color: #52682d;
    outline: none;
  }

  .glossary-related-tools__icon,
  .glossary-entry-helpinfo :global(.glossary-related-tools__link img) {
    width: 26px;
    height: 26px;
    max-width: 26px;
    max-height: 26px;
    flex-shrink: 0;
    display: block;
    object-fit: contain;
  }

  .glossary-related-tools__name {
    display: inline-block;
  }

  .glossary-entry-helpinfo :global(a[data-glossary-id]) {
    color: var(--kbm-green, #52682d);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .glossary-entry-helpinfo :global(.glossary-tooltip-wrap) {
    display: inline;
  }

  .glossary-entry-helpinfo :global(.glossary-tooltip-trigger) {
    display: inline;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    color: var(--kbm-green, #52682d);
    text-decoration: underline;
    text-underline-offset: 0.12em;
    cursor: pointer;
  }

  .glossary-entry-helpinfo :global(.glossary-tooltip-icon) {
    display: none;
  }

  .glossary-related-videos-mount {
    display: contents;
  }

  .glossary-related-videos {
    margin: 1.1rem auto 0;
    max-width: 680px;
    padding: 0.85rem 0.95rem;
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.03);
    border: 1px solid rgba(17, 24, 39, 0.08);
  }

  .glossary-related-videos__title {
    margin: 0 0 0.55rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #52682d;
  }

  .glossary-related-videos__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .glossary-related-videos__item {
    margin: 0;
    padding: 0;
  }

  .glossary-related-videos__btn {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.35rem;
    width: 100%;
    text-align: left;
    padding: 0.55rem 0.65rem;
    border-radius: 10px;
    border: 1px solid rgba(82, 104, 45, 0.35);
    background: rgba(82, 104, 45, 0.08);
    color: #3d4f22;
    font: inherit;
    font-size: 0.98rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .glossary-related-videos__btn:hover,
  .glossary-related-videos__btn:focus-visible {
    background: rgba(82, 104, 45, 0.14);
    border-color: rgba(82, 104, 45, 0.55);
    outline: none;
  }

  .glossary-related-videos__btn:focus-visible {
    outline: 2px solid rgba(82, 104, 45, 0.45);
    outline-offset: 2px;
  }

  .glossary-related-videos__link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    width: 100%;
    padding: 0.55rem 0.65rem;
    border-radius: 10px;
    border: 1px solid rgba(17, 24, 39, 0.1);
    background: rgba(255, 255, 255, 0.85);
    color: #1f2937;
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    box-sizing: border-box;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .glossary-related-videos__link:hover,
  .glossary-related-videos__link:focus-visible {
    background: rgba(82, 104, 45, 0.08);
    border-color: rgba(82, 104, 45, 0.28);
    outline: none;
  }

  .glossary-related-videos__link:focus-visible {
    outline: 2px solid rgba(82, 104, 45, 0.45);
    outline-offset: 2px;
  }

  .glossary-related-videos__link--member {
    border-style: dashed;
  }

  .glossary-related-videos__lock {
    flex-shrink: 0;
    font-size: 1rem;
    line-height: 1;
  }

  .glossary-related-videos__label {
    flex: 1 1 auto;
    min-width: 0;
  }

  .glossary-related-videos__badge {
    flex: 0 0 auto;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6b7280;
  }

  .glossary-entry-tail {
    max-width: 680px;
    margin: 0 auto;
  }

  .term-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #1f2937;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .term-title small {
    font-size: 0.7em;
    font-weight: 500;
    opacity: 0.8;
  }

  .term-title em {
    font-style: italic;
  }

  .term-intro {
    margin: 0.25rem 0 1rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #2a2a2a;
  }

  .term-body {
    margin-top: 1.5rem;
    padding: 1.75rem;
    border-radius: 16px;
    background: #ffffff;
    border: 1px solid #e6eadf;
  }

  .term-tooltip {
    font-size: 1.2rem;
    color: #6b7280;
    margin: 0 0 1.5rem;
    font-style: italic;
  }

  .term-example {
    background: #f9fafb;
    border-left: 4px solid var(--kbm-green);
    padding: 1rem 1.25rem;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .term-example-label {
    font-weight: 700;
    color: var(--kbm-green);
    margin-bottom: 0.5rem;
  }

  .term-example-text {
    color: #374151;
    line-height: 1.6;
    white-space: pre-line;
  }

  .term-promo {
    margin: 1.75rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--kbm-green);
    font-size: 1.05rem;
    line-height: 1.6;
    color: #374151;
  }

  .term-promo strong {
    font-weight: 700;
    color: #1f2937;
  }

  .term-promo :global(a),
  .term-promo :global(a:visited) {
    color: #52682d !important;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .term-promo :global(a:hover),
  .term-promo :global(a:focus-visible) {
    opacity: 0.85;
  }

  .glossary-example-full {
    max-width: 1200px;
    margin: 3rem auto 0;
    padding: 0 20px;
  }

  .glossary-example-full .term-example {
    background: transparent;
    border-left: none;
    padding: 0;
    border-radius: 0;
    margin: 0;
  }

  .glossary-example-full .term-example-label {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #52682d;
    margin: 0 0 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(82, 104, 45, 0.18);
  }

  .glossary-example-full .term-example-text {
    color: #374151;
    line-height: 1.7;
    white-space: normal;
    max-width: 900px;
  }

  .related-terms {
    margin: 1.5rem 0;
    padding: 0;
  }

  .related-terms-label {
    font-weight: 700;
    color: #1f2937;
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
  }

  .related-terms-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .related-term-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--kbm-green);
    font-weight: 600;
    font-size: 1rem;
    transition: opacity 0.2s;
  }

  .related-term-link:hover {
    opacity: 0.7;
  }

  .related-term-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .member-only,
  .non-member-cta {
    margin-top: 2rem;
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid #e2e6df;
  }

  .member-only {
    background: #f6f8f2;
  }

  .member-only h3 {
    margin: 0 0 1rem;
    color: #1f2937;
    font-size: 1.3rem;
  }

  .non-member-cta {
    background: linear-gradient(135deg, #f0f4ea 0%, #ffffff 100%);
    text-align: center;
  }

  .non-member-cta p {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    color: #374151;
  }

  .btn-primary {
    display: inline-block;
    background: var(--kbm-green);
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: #3f5323;
  }

  @media (max-width: 768px) {
    .glossary-entry-image .glossary-image {
      max-width: 100%;
    }

    .term-title {
      font-size: 2rem;
    }

    .term-tooltip {
      font-size: 1rem;
    }
  }
</style>

<div class="glossary-entry">
  <h1 class="glossary-entry__title">{entry?.english ?? ""}</h1>
  <a href="/glossary" class="back-link">← Back to Glossary </a>
  {entry?.example && (
    <div class="term-intro" set:html={entry.example}></div>
  )}

  <div class="term-body">
    {vimeoIds.length > 0 && (
      <div class="glossary-entry-videos">
        {vimeoIds.map((vimeoId: string) => (
          <div class="glossary-video-block">
            <div class="glossary-video">
              <iframe
                src={`https://player.vimeo.com/video/${vimeoId}`}
                title={`${videoTitleBase} video`}
                loading="lazy"
                frameborder="0"
                allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
                allowfullscreen
              ></iframe>
            </div>
            <button
              type="button"
              class="kbm-kin-catalog-video glossary-video-enlarge"
              data-vimeo-id={vimeoId}
              data-vimeo-defer
              data-video-title={videoTitleBase ? `${videoTitleBase} video` : "Video"}
            >
              <span aria-hidden="true">⤢</span> Watch Larger
            </button>
          </div>
        ))}
      </div>
    )}
    {imageSrc && (
      <div class="glossary-entry-image">
        {entry?.link && String(entry.link).trim() ? (
          <a href={String(entry.link).trim()} class="easter-egg-link">
            <img
  src={imageSrc}
  alt={entry?.image_alt ?? entry?.imageAlt ?? entry?.english ?? ""}
  class="glossary-image"
  style="cursor:pointer; transition: transform 0.2s ease;"
  onmouseover="this.style.transform='scale(1.05)'"
  onmouseout="this.style.transform='scale(1)'"
/>
          </a>
        ) : (
          <img
            class="glossary-image"
            src={imageSrc}
            alt={entry?.image_alt ?? entry?.imageAlt ?? entry?.english ?? ""}
          />
        )}
      </div>
    )}
    {showHelpinfo && (
      <div class="glossary-entry-helpinfo" set:html={helpinfoRaw} />
    )}
    {relatedVideosHtml ? (
      <div class="glossary-related-videos-mount" style="display: contents" set:html={relatedVideosHtml} />
    ) : null}
    {showRelatedTools && (
      <div class="glossary-related-tools">
        <p class="glossary-related-tools__heading">Use this tool</p>
        <ul class="glossary-related-tools__list">
          {relatedTools.map((tool: { name: string; url: string; icon?: string }) => (
            <li class="glossary-related-tools__item">
              <a href={tool.url} class="glossary-related-tools__link">
                {tool.icon ? (
                  <img
                    src={tool.icon}
                    alt=""
                    class="glossary-related-tools__icon"
                    width="26"
                    height="26"
                    loading="lazy"
                    decoding="async"
                  />
                ) : null}
                <span class="glossary-related-tools__name">{tool.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    <div class="glossary-entry-tail">
      {entry?.tooltip && <p class="term-tooltip"><em>{entry.tooltip}</em></p>}

      {entry?.promoText && (
        <div class="term-promo" set:html={entry.promoText} />
      )}

      {relatedTermsData && relatedTermsData.length > 0 && (
        <div class="related-terms">
          <div class="related-terms-label">Related terms:</div>
          <div class="related-terms-list">
            {relatedTermsData.map((relatedTerm: any) => (
              <a href={`/glossary/${relatedTerm.slug}`} class="related-term-link">
                <img
                  src="/images/glossary/glossary_logo.svg"
                  alt=""
                  class="related-term-icon"
                />
                {relatedTerm.term}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</div>
