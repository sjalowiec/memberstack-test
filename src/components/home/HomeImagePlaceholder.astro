---
/**
 * Labeled placeholder for homepage screenshots and photos.
 * Replace the inner block with a real <img> when assets are ready.
 */
interface Props {
  label: string;
  aspect?: string;
  /** Tighter padding and smaller label for card thumbnails */
  compact?: boolean;
  /** Fill a fixed-height area (e.g. hero background) instead of aspect-ratio */
  fill?: boolean;
  minHeight?: string;
}

const {
  label,
  aspect = "16 / 10",
  compact = false,
  fill = false,
  minHeight = "420px",
} = Astro.props;

const style = fill
  ? `min-height: ${minHeight}; height: 100%;`
  : `aspect-ratio: ${aspect}`;
---

<div
  class:list={["home-img-placeholder", { "home-img-placeholder--compact": compact, "home-img-placeholder--fill": fill }]}
  style={style}
  role="img"
  aria-label={label}
>
  <!-- TODO: Replace with image - {label} -->
  <span class="home-img-placeholder__label">{label}</span>
</div>

<style>
  .home-img-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border-radius: 0.75rem;
    border: 2px dashed rgba(82, 104, 45, 0.35);
    background: linear-gradient(145deg, #eef1e8 0%, #e4e9dc 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
    overflow: hidden;
  }

  .home-img-placeholder--fill {
    border-radius: 0;
    border-left: none;
    border-right: none;
    border-top: none;
  }

  .home-img-placeholder--compact .home-img-placeholder__label {
    font-size: 0.78rem;
    padding: 0.5rem 0.65rem;
  }

  .home-img-placeholder__label {
    max-width: 90%;
    padding: 0.75rem 1rem;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    color: #5f6b58;
  }
</style>
