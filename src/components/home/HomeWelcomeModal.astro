---
import {
  HOME_WELCOME_MODAL_BODY,
  HOME_WELCOME_MODAL_PRIMARY_HREF,
  HOME_WELCOME_MODAL_PRIMARY_LABEL,
  HOME_WELCOME_MODAL_SECONDARY_LABEL,
  HOME_WELCOME_MODAL_TITLE,
} from "../../lib/home/homeWelcomeModal";
---

<div
  class="home-welcome-modal"
  data-home-welcome-modal
  aria-hidden="true"
>
  <div
    class="home-welcome-modal__dialog"
    data-home-welcome-dialog
    role="dialog"
    aria-modal="true"
    aria-labelledby="home-welcome-modal-title"
    tabindex="-1"
  >
    <button
      type="button"
      class="home-welcome-modal__close"
      data-home-welcome-close
      aria-label="Close welcome message"
    >
      &times;
    </button>

    <h2 id="home-welcome-modal-title" class="home-welcome-modal__title">
      {HOME_WELCOME_MODAL_TITLE}
    </h2>

    <p class="home-welcome-modal__body">{HOME_WELCOME_MODAL_BODY}</p>

    <div class="home-welcome-modal__actions">
      <a
        href={HOME_WELCOME_MODAL_PRIMARY_HREF}
        class="kbm-btn kbm-btn-primary home-welcome-modal__primary"
        data-home-welcome-primary
      >
        {HOME_WELCOME_MODAL_PRIMARY_LABEL}
      </a>
      <button
        type="button"
        class="kbm-btn kbm-btn-outline home-welcome-modal__secondary"
        data-home-welcome-secondary
      >
        {HOME_WELCOME_MODAL_SECONDARY_LABEL}
      </button>
    </div>
  </div>
</div>

<script>
  import { initHomeWelcomeModal } from "../../lib/home/homeWelcomeModal";

  initHomeWelcomeModal();
</script>

<style>
  .home-welcome-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    padding-bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    background: rgba(15, 23, 42, 0.45);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .home-welcome-modal.is-open {
    opacity: 1;
    visibility: visible;
  }

  .home-welcome-modal__dialog {
    position: relative;
    width: 100%;
    max-width: min(92vw, 28rem);
    max-height: min(90vh, 36rem);
    overflow-y: auto;
    padding: clamp(1.35rem, 3.5vw, 1.85rem);
    background: #fff;
    border: 1px solid rgba(82, 104, 45, 0.14);
    border-radius: 1rem;
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.18);
    transform: translateY(12px);
    transition: transform 0.25s ease;
  }

  .home-welcome-modal.is-open .home-welcome-modal__dialog {
    transform: translateY(0);
  }

  .home-welcome-modal__dialog:focus {
    outline: none;
  }

  .home-welcome-modal__dialog:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }

  .home-welcome-modal__close {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: #666;
    font: inherit;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .home-welcome-modal__close:hover {
    background: #f0f0f0;
    color: #333;
  }

  .home-welcome-modal__close:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }

  .home-welcome-modal__title {
    margin: 0 2rem 0.85rem 0;
    font-size: clamp(1.25rem, 3.5vw, 1.5rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--kbm-green, #52682d);
  }

  .home-welcome-modal__body {
    margin: 0 0 1.35rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #374151;
  }

  .home-welcome-modal__actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .home-welcome-modal__primary,
  .home-welcome-modal__secondary {
    width: 100%;
    text-align: center;
    text-decoration: none;
    box-sizing: border-box;
  }

  @media (max-width: 479px) {
    .home-welcome-modal {
      align-items: flex-end;
      padding: 0.75rem;
    }

    .home-welcome-modal__dialog {
      max-height: min(88vh, 34rem);
      border-radius: 1rem 1rem 0.75rem 0.75rem;
    }

    .home-welcome-modal__title {
      font-size: 1.25rem;
    }

    .home-welcome-modal__body {
      font-size: 0.95rem;
      line-height: 1.55;
    }
  }
</style>
