---
/** Shared Women / Men / Kids / Baby text buttons for sweater Pattern Builders. */

interface WhoOption {
  value: string;
  label: string;
}

interface Props {
  labelledBy: string;
  /** Set-In Sleeve passes Misses / Women's / Men's. Other builders keep the default four. */
  whoOptions?: readonly WhoOption[];
}

/** Presentation-only labels. Default values stay `women` / `men` / `kids` / `baby` for sizing. */
const defaultWhoOptions = [
  { value: "women", label: "Women" },
  { value: "men", label: "Men" },
  { value: "kids", label: "Kids" },
  { value: "baby", label: "Baby" },
] as const;

const { labelledBy, whoOptions = defaultWhoOptions } = Astro.props;
const usesAdultRanges = whoOptions.some((opt) => opt.value === "plus");
---

<div
  class:list={[
    "express-options--who",
    "express-options--who-text",
    "hat-length-picker__grid",
    { "express-options--who-ranges": usesAdultRanges },
  ]}
  role="group"
  aria-labelledby={labelledBy}
>
  {
    whoOptions.map((opt) => (
      <button
        type="button"
        class="hat-length-picker__option express-who-card"
        data-choice
        data-field="who"
        data-value={opt.value}
        aria-pressed="false"
      >
        <span class="hat-length-picker__option-label">{opt.label}</span>
      </button>
    ))
  }
</div>
