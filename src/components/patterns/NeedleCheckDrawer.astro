---
// Needle Check Drawer (pattern-neutral UI only)
// NOTE: No logic here yet — just reusable markup
---

<div id="needle-check-trigger-wrap" class="needle-check needle-check--width-drawer no-print" aria-live="polite">
  <div id="needle-check-result-preview" class="diy-blanket-needle-result-preview" hidden>
    <p class="diy-blanket-needle-result-preview__line">
      <strong><span id="needle-count-value-preview"></span> needles required</strong>
    </p>
    <p class="diy-blanket-needle-result-preview__context" id="needle-size-context-preview"></p>
  </div>

  <button
    type="button"
    id="needle-check-toggle"
    class="needle-check__header"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-controls="needle-check-panel"
  >
    <span class="needle-check__chevron" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M10 7l5 5-5 5"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
    <span class="needle-check__header-text">
      <span class="needle-check__title">Will this fit on your machine?</span>
    </span>
  </button>
</div>
