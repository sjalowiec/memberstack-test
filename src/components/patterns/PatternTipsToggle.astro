---
import "../../styles/pattern-tips.css";

interface Props {
  /** localStorage key, e.g. hat-show-tips, sleeveless-show-tips */
  storageKey: string;
  /**
   * Element that wraps this host and all generated `.pattern-tip` blocks (gets `data-show-tips`).
   * Must be an ancestor of the intro slot and pattern HTML so visibility applies to every tip.
   */
  scopeSelector?: string;
}

const { storageKey, scopeSelector = "#pattern-content" } = Astro.props;
---

<div
  class="pattern-tips-toggle-host"
  data-pattern-tips-host
  data-storage-key={storageKey}
  data-scope-selector={scopeSelector}
>
  <div class="pattern-tips-intro-slot"></div>
</div>

<script>
  import {
    bindPatternTipDismiss,
    patternTipsControlBoxHtml,
    refreshPatternTipDismiss,
    restoreAllDismissedPatternTips,
  } from "../../lib/patterns/patternTipDismiss";
  import { SLEEVELESS_PATTERN_TIPS_STORAGE_KEY } from "../../lib/patterns/patternReadingWorkflow";
  import { scheduleReadingWorkflowSync } from "../../lib/patterns/patternReadingWorkflowSync";
  import { getCurrentPattern } from "../../lib/patterns/patternStorage";

  function tipsPreferenceVisible(key: string) {
    const v = localStorage.getItem(key);
    if (v === "false") return false;
    return true;
  }

  function renderIntro(slot: HTMLElement | null, tipsOn: boolean) {
    if (!slot) return;
    slot.innerHTML = patternTipsControlBoxHtml(tipsOn);
  }

  document.querySelectorAll("[data-pattern-tips-host]:not([data-pattern-tips-init])").forEach((host) => {
    if (!(host instanceof HTMLElement)) return;
    host.setAttribute("data-pattern-tips-init", "");
    const key = host.getAttribute("data-storage-key");
    const sel = host.getAttribute("data-scope-selector") || "#pattern-content";
    if (!key) return;

    const scope = document.querySelector(sel);
    if (!(scope instanceof HTMLElement)) return;

    const slot = host.querySelector(".pattern-tips-intro-slot");
    const slotEl = slot instanceof HTMLElement ? slot : null;
    const visible = tipsPreferenceVisible(key);
    scope.setAttribute("data-show-tips", visible ? "true" : "false");
    renderIntro(slotEl, visible);
    bindPatternTipDismiss(scope, key);

    scope.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const toggleBtn = target.closest('[data-testid="link-tips-toggle"]');
      if (!(toggleBtn && scope.contains(toggleBtn))) return;
      e.preventDefault();
      const wasShowing = scope.getAttribute("data-show-tips") === "true";
      const newState = !wasShowing;
      scope.setAttribute("data-show-tips", newState ? "true" : "false");
      localStorage.setItem(key, newState ? "true" : "false");
      renderIntro(slotEl, newState);
      // OFF → ON: clear individual dismissals so every eligible tip returns.
      if (newState && !wasShowing) {
        restoreAllDismissedPatternTips(scope, key);
      } else {
        refreshPatternTipDismiss(scope, key);
      }
      if (key === SLEEVELESS_PATTERN_TIPS_STORAGE_KEY) {
        try {
          scheduleReadingWorkflowSync(getCurrentPattern().id);
        } catch {
          /* ignore */
        }
      }
    });
  });
</script>
