---
import { randomUUID } from "node:crypto";

const messageId = `pattern-tips-message-${randomUUID()}`;
---

<div class="pattern-tips-toggle" data-pattern-tips-toggle>
  <div
    class="pattern-tips-message"
    id={messageId}
    data-pattern-tips-message
  >
    <strong>Tip:</strong>
    <span>
      Pattern Tips are on to give you quick help and helpful reminders as you knit.
    </span>
  </div>
  <button
    type="button"
    class="pattern-tips-button"
    data-pattern-tips-button
    aria-expanded="true"
    aria-controls={messageId}
  >
    Hide tips
  </button>
</div>

<style>
  .pattern-tips-toggle {
    font-size: 0.85rem;
    color: #374151;
    background: rgba(194, 97, 78, 0.07);
    border-left: 4px solid #c2614e;
    border-radius: 6px;
    padding: 0.75rem 1rem;
    margin: 0.5rem 0 0.75rem 0;
    line-height: 1.4;
  }

  .pattern-tips-message strong {
    font-weight: 700;
    color: #c2614e;
  }

  .pattern-tips-message span {
    margin-left: 0.25rem;
  }

  .pattern-tips-button {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: #c2614e;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    text-align: left;
  }

  .pattern-tips-button:hover {
    text-decoration: underline;
  }

  .pattern-tips-button:focus-visible {
    outline: 2px solid #c2614e;
    outline-offset: 2px;
  }

  .pattern-tips-toggle.is-hidden {
    background: transparent;
    border-left: none;
    padding: 0;
    margin: 0.35rem 0 0.5rem 0;
  }

  .pattern-tips-toggle.is-hidden .pattern-tips-message {
    display: none;
  }

  .pattern-tips-toggle.is-hidden .pattern-tips-button {
    margin-top: 0;
  }
</style>

<script is:inline>
  (function () {
    document
      .querySelectorAll("[data-pattern-tips-toggle]:not([data-pattern-tips-init])")
      .forEach(function (root) {
        root.setAttribute("data-pattern-tips-init", "");
        var btn = root.querySelector("[data-pattern-tips-button]");
        var message = root.querySelector("[data-pattern-tips-message]");
        if (!btn || !message) return;

        function setExpanded(expanded) {
          btn.setAttribute("aria-expanded", expanded ? "true" : "false");
          message.setAttribute("aria-hidden", expanded ? "false" : "true");
        }

        setExpanded(true);

        btn.addEventListener("click", function () {
          var nowHidden = root.classList.toggle("is-hidden");
          btn.textContent = nowHidden ? "Show tips" : "Hide tips";
          setExpanded(!nowHidden);
        });
      });
  })();
</script>
