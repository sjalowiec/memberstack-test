---
import "../../styles/pattern-tips.css";

interface Props {
  /** localStorage key, e.g. hat-show-tips, sleeveless-show-tips */
  storageKey: string;
  /**
   * Element that wraps this host and all generated `.pattern-tip` blocks (gets `data-show-tips`).
   * Must be an ancestor of the intro slot and pattern HTML so visibility applies to every tip.
   */
  scopeSelector?: string;
}

const { storageKey, scopeSelector = "#pattern-content" } = Astro.props;
---

<div
  class="pattern-tips-toggle-host"
  data-pattern-tips-host
  data-storage-key={storageKey}
  data-scope-selector={scopeSelector}
>
  <div class="pattern-tips-intro-slot"></div>
</div>

<script is:inline>
  (function () {
    function tipsPreferenceVisible(key) {
      var v = localStorage.getItem(key);
      if (v === "false") return false;
      return true;
    }

    function renderIntro(slot, tipsOn) {
      if (!slot) return;
      if (tipsOn) {
        slot.innerHTML =
          '<div class="pattern-tip pattern-tip-intro" data-tip><strong>Tip:</strong> Pattern Tips are on to give you quick help and helpful reminders as you knit. <a href="#" class="tips-inline-toggle" data-testid="link-tips-toggle">Hide tips</a></div>';
      } else {
        slot.innerHTML =
          '<p class="pattern-tips-off-row"><i class="fa-regular fa-lightbulb tips-icon" style="color: #c2614e;"></i><a href="#" class="tips-inline-toggle" data-testid="link-tips-toggle">Show pattern tips</a></p>';
      }
    }

    document.querySelectorAll("[data-pattern-tips-host]:not([data-pattern-tips-init])").forEach(function (host) {
      host.setAttribute("data-pattern-tips-init", "");
      var key = host.getAttribute("data-storage-key");
      var sel = host.getAttribute("data-scope-selector") || "#pattern-content";
      if (!key) return;

      var scope = document.querySelector(sel);
      if (!scope) return;

      var slot = host.querySelector(".pattern-tips-intro-slot");
      var visible = tipsPreferenceVisible(key);
      scope.setAttribute("data-show-tips", visible ? "true" : "false");
      renderIntro(slot, visible);

      scope.addEventListener("click", function (e) {
        var link = e.target.closest(".tips-inline-toggle");
        var icon = e.target.closest(".tips-icon");
        var iconInOffRow =
          icon && icon.closest(".pattern-tips-off-row") && scope.contains(icon);
        if (!((link && scope.contains(link)) || iconInOffRow)) return;
        e.preventDefault();
        var isShowing = scope.getAttribute("data-show-tips") === "true";
        var newState = !isShowing;
        scope.setAttribute("data-show-tips", newState ? "true" : "false");
        localStorage.setItem(key, newState ? "true" : "false");
        renderIntro(slot, newState);
      });
    });
  })();
</script>
