---
import "../../styles/patterns/pattern-tabs-scope.css";

interface Props {
  /** When true, Pattern tab cannot be activated by click (programmatic switches still work). */
  patternTabDisabled?: boolean;
  patternTabButtonId?: string;
  hidePattern?: boolean;
  hideShare?: boolean;
  hideInspiration?: boolean;
  /** Extra classes on the outer `.pattern-tabs` wrapper (e.g. `pattern-tabs-scope`). */
  rootClass?: string;
  /** Sleeveless workspace: which high-level area is active (drives tab highlights; express vs custom affects Build href + active state). */
  activeTab?: "quick-build" | "custom-build" | "pattern" | "build" | "share" | "inspiration";
  /** First workspace tab label (default "Build"). Use e.g. "Express Build" / "Custom Build" during beta so the tab matches the linked flow. */
  workspaceBuildTabLabel?: string;
  quickBuildHref?: string;
  customBuildHref?: string;
  patternHref?: string;
  askShareHref?: string;
  inspirationHref?: string;
}

const {
  patternTabDisabled = false,
  patternTabButtonId,
  hidePattern = false,
  hideShare = false,
  hideInspiration = false,
  rootClass = "",
  activeTab = "build",
  workspaceBuildTabLabel = "",
  quickBuildHref = "",
  customBuildHref = "",
  patternHref = "",
  askShareHref = "",
  inspirationHref = "",
} = Astro.props;

const workspaceNav = Boolean(String(patternHref ?? "").trim());

function normPath(p: string): string {
  const t = String(p ?? "").trim();
  if (!t) return "";
  const noTrail = t.replace(/\/+$/, "");
  return noTrail || "/";
}

function pathMatchesHref(pathNow: string, href: string | undefined): boolean {
  const h = normPath(String(href ?? ""));
  if (!h || !pathNow) return false;
  return pathNow === h || pathNow.startsWith(`${h}/`);
}

const pathNow = normPath(Astro.url.pathname);

const workspaceBuildTabText = String(workspaceBuildTabLabel ?? "").trim() || "Build";

const hasBuildSlot = Astro.slots.has("build");

const qb = String(quickBuildHref ?? "").trim();
const cb = String(customBuildHref ?? "").trim();

const buildNavHref =
  activeTab === "custom-build" ? cb || qb || "#" : qb || cb || "#";

const buildTabActive =
  activeTab !== "share" &&
  activeTab !== "inspiration" &&
  (hasBuildSlot ||
    activeTab === "quick-build" ||
    activeTab === "custom-build" ||
    (Boolean(buildNavHref && buildNavHref !== "#") &&
      pathMatchesHref(pathNow, buildNavHref) &&
      activeTab !== "pattern"));

const patternTabActive =
  activeTab !== "share" &&
  activeTab !== "inspiration" &&
  (activeTab === "pattern" || (!patternTabDisabled && pathMatchesHref(pathNow, patternHref)));

const shareTabActive = activeTab === "share" || pathMatchesHref(pathNow, askShareHref);
const inspirationTabActive = activeTab === "inspiration" || pathMatchesHref(pathNow, inspirationHref);
---

<div
  class:list={[
    "pattern-tabs",
    rootClass,
    { "pattern-workspace-tabs": workspaceNav },
  ]}
>
  <div class="pattern-tab-nav">
    {
      workspaceNav ? (
        <>
          {hasBuildSlot ? (
            <button type="button" class:list={["tab-btn", { active: buildTabActive }]} data-tab="build">
              <span class="tab-label">{workspaceBuildTabText}</span>
            </button>
          ) : (
            <a class:list={["tab-btn", { active: buildTabActive }]} href={buildNavHref} data-tab="build">
              <span class="tab-label">{workspaceBuildTabText}</span>
            </a>
          )}
          {!hidePattern &&
            (patternTabDisabled ? (
              <span
                id={patternTabButtonId}
                class:list={["tab-btn", "is-disabled"]}
                data-tab="pattern"
                role="button"
                aria-disabled="true"
              >
                <span class="tab-label">Pattern</span>
              </span>
            ) : (
              <a
                id={patternTabButtonId}
                class:list={["tab-btn", { active: patternTabActive }]}
                href={String(patternHref).trim()}
                data-tab="pattern"
                aria-current={patternTabActive ? "page" : undefined}
              >
                <span class="tab-label">Pattern</span>
              </a>
            ))}
          {!hideShare && (
            <a
              class:list={["tab-btn", { active: shareTabActive }]}
              href={String(askShareHref).trim()}
              data-tab="share"
              aria-current={shareTabActive ? "page" : undefined}
            >
              <span class="tab-label">Ask / Share</span>
            </a>
          )}
          {!hideInspiration && (
            <a
              class:list={["tab-btn", { active: inspirationTabActive }]}
              href={String(inspirationHref).trim()}
              data-tab="inspiration"
              aria-current={inspirationTabActive ? "page" : undefined}
            >
              <span class="tab-label">Inspiration</span>
            </a>
          )}
        </>
      ) : (
        <>
          <button type="button" class="tab-btn active" data-tab="build">
            <span class="tab-icon" aria-hidden="true">⚙️</span>
            <span class="tab-label">Build</span>
          </button>
          {
            !hidePattern && (
              <button
                type="button"
                id={patternTabButtonId}
                class:list={["tab-btn", patternTabDisabled && "is-disabled"]}
                data-tab="pattern"
                aria-disabled={patternTabDisabled ? "true" : undefined}
              >
                <span class="tab-icon" aria-hidden="true">📝</span>
                <span class="tab-label">Pattern</span>
              </button>
            )
          }
          {
            !hideShare && (
              <button type="button" class="tab-btn" data-tab="share">
                <span class="tab-icon" aria-hidden="true">💬</span>
                <span class="tab-label">Ask / Share</span>
              </button>
            )
          }
          {
            !hideInspiration && (
              <button type="button" class="tab-btn" data-tab="inspiration">
                <span class="tab-icon" aria-hidden="true">💡</span>
                <span class="tab-label">Inspiration</span>
              </button>
            )
          }
        </>
      )
    }
  </div>

  {
    workspaceNav ? (
      hasBuildSlot ? (
        <div class="pattern-tab-content">
          <div class:list={["tab-panel", "active"]} id="tab-build">
            <slot name="build" />
          </div>
        </div>
      ) : null
    ) : (
      <div class="pattern-tab-content">
        <div class="tab-panel active" id="tab-build">
          <slot name="build" />
        </div>
        {
          !hidePattern && (
            <div class="tab-panel" id="tab-pattern">
              <slot name="pattern" />
            </div>
          )
        }
        {
          !hideShare && (
            <div class="tab-panel" id="tab-share">
              <slot name="share" />
            </div>
          )
        }
        {
          !hideInspiration && (
            <div class="tab-panel" id="tab-inspiration">
              <slot name="inspiration" />
            </div>
          )
        }
      </div>
    )
  }
</div>

<style>
  /* Sleeveless workspace: modern pill tabs (scoped; does not affect non-workspace PatternTabs). */
  .pattern-workspace-tabs .pattern-tab-nav {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-end;
    gap: 0.2rem;
    margin: 0 0 1.125rem;
    padding: 0.25rem 0 0.2rem;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(82, 104, 45, 0.12);
    border-radius: 0;
    box-shadow: none;
  }

  .pattern-workspace-tabs .pattern-tab-nav::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn {
    position: relative;
    z-index: 0;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0.45rem 0.7rem;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.25;
    color: #4a5c32;
    text-decoration: none;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(82, 104, 45, 0.14);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    box-shadow: none;
    transition:
      background 0.12s ease,
      color 0.12s ease,
      border-color 0.12s ease,
      box-shadow 0.12s ease;
  }

  .pattern-workspace-tabs .pattern-tab-nav a.tab-btn {
    color: #4a5c32;
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn:hover:not(.active):not(.is-disabled) {
    background: rgba(255, 255, 255, 0.88);
    color: #3d4d29;
    border-color: rgba(82, 104, 45, 0.22);
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn:focus-visible {
    outline: 2px solid #c2614e;
    outline-offset: 2px;
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn.active {
    z-index: 2;
    margin-bottom: -1px;
    padding-bottom: calc(0.45rem + 1px);
    color: #3d4d29;
    background: #f7f8f7;
    border-color: rgba(82, 104, 45, 0.18);
    border-bottom: 1px solid #f7f8f7;
    border-top: 2px solid #c2614e;
    border-radius: 8px 8px 0 0;
    box-shadow: 0 1px 0 0 #f7f8f7;
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn.is-disabled {
    color: #8a9a78;
    opacity: 0.75;
    cursor: not-allowed;
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(82, 104, 45, 0.08);
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn.is-disabled:hover {
    color: #8a9a78;
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(82, 104, 45, 0.08);
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-label {
    position: static;
    width: auto;
    height: auto;
    padding: 0;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 767px) {
    .pattern-workspace-tabs .pattern-tab-nav {
      gap: 0.15rem;
      margin: 0 0 1rem;
      padding: 0.2rem 0 0.15rem;
    }

    .pattern-workspace-tabs .pattern-tab-nav .tab-btn {
      padding: 0.4rem 0.55rem;
      font-size: 0.82rem;
    }

    .pattern-workspace-tabs.pattern-tabs-scope .pattern-tab-nav .tab-label {
      position: static;
      width: auto;
      height: auto;
      padding: 0;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: nowrap;
      border: 0;
    }
  }
</style>
