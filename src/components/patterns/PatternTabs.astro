---
import "../../styles/patterns/pattern-tabs-scope.css";
import "../../styles/patterns/pattern-editable-pencil.css";
import PatternEditablePencilIcon from "./PatternEditablePencilIcon.astro";
import PatternWorkspaceLibraryDrawer from "./PatternWorkspaceLibraryDrawer.astro";

interface Props {
  /** When true, Pattern tab cannot be activated by click (programmatic switches still work). */
  patternTabDisabled?: boolean;
  patternTabButtonId?: string;
  hidePattern?: boolean;
  hideShare?: boolean;
  hideInspiration?: boolean;
  /** Extra classes on the outer `.pattern-tabs` wrapper (e.g. `pattern-tabs-scope`). */
  rootClass?: string;
  /**
   * Sleeveless workspace: which high-level area is active (drives tab highlights).
   * Non-workspace pages (e.g. triangle scarf) use `build` / `pattern` / `share` / `inspiration` for in-page tabs only.
   */
  activeTab?: "express" | "custom" | "pattern" | "build" | "share" | "inspiration";
  /** Express builder entry (trailing slash recommended). */
  expressHref?: string;
  /** Custom Build hub or upsell (trailing slash recommended). */
  customBuildHref?: string;
  patternHref?: string;
  askShareHref?: string;
  inspirationHref?: string;
}

const {
  patternTabDisabled = false,
  patternTabButtonId,
  hidePattern = false,
  hideShare = false,
  hideInspiration = false,
  rootClass = "",
  activeTab = "build",
  expressHref = "",
  customBuildHref = "",
  patternHref = "",
  askShareHref = "",
  inspirationHref = "",
} = Astro.props;

const workspaceNav = Boolean(String(patternHref ?? "").trim());

function normPath(p: string): string {
  const t = String(p ?? "").trim();
  if (!t) return "";
  const noTrail = t.replace(/\/+$/, "");
  return noTrail || "/";
}

function pathMatchesHref(pathNow: string, href: string | undefined): boolean {
  const h = normPath(String(href ?? ""));
  if (!h || !pathNow) return false;
  return pathNow === h || pathNow.startsWith(`${h}/`);
}

const pathNow = normPath(Astro.url.pathname);

const ex = String(expressHref ?? "").trim();
const cb = String(customBuildHref ?? "").trim();

/** Custom style wizard lives outside `custom-build/` but belongs on the Summary workspace tab. */
const customStyleRoot = normPath("/patterns/sleeveless/custom-style");
const pathIsCustomStyleFlow =
  pathNow === customStyleRoot || (customStyleRoot && pathNow.startsWith(`${customStyleRoot}/`));

const summaryRoot = normPath("/patterns/sleeveless/review");
const pathIsSummaryFlow =
  (summaryRoot && (pathNow === summaryRoot || pathNow.startsWith(`${summaryRoot}/`))) ||
  pathIsCustomStyleFlow;

/** Custom Build Foundation — workspace Create tab, not Customize. */
const customBuildFoundationRoot = normPath("/patterns/sleeveless/custom-build/design");
const pathIsCustomBuildFoundationFlow =
  pathNow === customBuildFoundationRoot ||
  (customBuildFoundationRoot && pathNow.startsWith(`${customBuildFoundationRoot}/`));

/**
 * Pattern Setup (the former "custom"/Summary tab) is now the first workflow tab.
 * The user-facing "Create"/express tab was removed (New Pattern button replaces it),
 * so Pattern Setup absorbs the express + custom-build foundation route highlights to
 * keep an active tab visible on those flows.
 */
const customTabActive =
  activeTab === "express" ||
  activeTab === "custom" ||
  pathIsSummaryFlow ||
  pathIsCustomBuildFoundationFlow ||
  (Boolean(ex) && pathMatchesHref(pathNow, ex));

const patternTabActive =
  activeTab === "pattern" || (!patternTabDisabled && pathMatchesHref(pathNow, patternHref));

const shareTabActive = activeTab === "share" || pathMatchesHref(pathNow, askShareHref);
const inspirationTabActive = activeTab === "inspiration" || pathMatchesHref(pathNow, inspirationHref);

const summaryNavHref = summaryRoot ? `${summaryRoot}/` : cb || "#";
---

<div
  class:list={[
    "pattern-tabs",
    rootClass,
    { "pattern-workspace-tabs": workspaceNav },
  ]}
>
  {
    workspaceNav ? (
        <div class="pattern-tab-nav">
          <div class="pattern-tab-nav__workflow">
          <a
            class:list={["tab-btn", "tab-btn--custom", "tab-btn--workspace-brand", { active: customTabActive }]}
            href={summaryNavHref}
            data-tab="custom"
            aria-current={customTabActive ? "page" : undefined}
            aria-label="Pattern Setup"
            title="Pattern Setup"
          >
            <PatternEditablePencilIcon size="md" class="tab-workspace-brand-icon tab-workspace-summary-pencil-icon" />
            <span class="pattern-workspace-tabs__visible-label" aria-hidden="true">Pattern Setup</span>
          </a>
          {!hidePattern &&
            (patternTabDisabled ? (
              <span
                id={patternTabButtonId}
                class:list={["tab-btn", "is-disabled"]}
                data-tab="pattern"
                role="button"
                aria-disabled="true"
                aria-label="My Pattern"
              >
                <span class="pattern-workspace-tabs__visible-label" aria-hidden="true">My Pattern</span>
                <i class="fa-solid fa-file-lines tab-workspace-mobile-icon" aria-hidden="true"></i>
              </span>
            ) : (
              <a
                id={patternTabButtonId}
                class:list={["tab-btn", { active: patternTabActive }]}
                href={String(patternHref).trim()}
                data-tab="pattern"
                aria-current={patternTabActive ? "page" : undefined}
                aria-label="My Pattern"
              >
                <span class="pattern-workspace-tabs__visible-label" aria-hidden="true">My Pattern</span>
                <i class="fa-solid fa-file-lines tab-workspace-mobile-icon" aria-hidden="true"></i>
              </a>
            ))}
          {!hideShare && (
            <a
              class:list={["tab-btn", "tab-btn--ask-share", { active: shareTabActive }]}
              href={String(askShareHref).trim()}
              data-tab="share"
              aria-current={shareTabActive ? "page" : undefined}
              aria-label="Connect"
            >
              <span class="pattern-workspace-tabs__visible-label" aria-hidden="true">Connect</span>
              <i class="fa-solid fa-comments tab-workspace-mobile-icon" aria-hidden="true"></i>
            </a>
          )}
          {!hideInspiration && (
            <a
              class:list={["tab-btn", { active: inspirationTabActive }]}
              href={String(inspirationHref).trim()}
              data-tab="inspiration"
              aria-current={inspirationTabActive ? "page" : undefined}
              aria-label="Inspire"
            >
              <span class="pattern-workspace-tabs__visible-label" aria-hidden="true">Inspire</span>
              <i class="fa-solid fa-lightbulb tab-workspace-mobile-icon" aria-hidden="true"></i>
            </a>
          )}
          </div>
          <div class="pattern-tab-nav__actions">
          <button
            type="button"
            class="pattern-workspace-new-pattern-trigger"
            data-pattern-workspace-new-pattern-trigger
            data-testid="pattern-workspace-new-pattern-trigger"
            title="New Pattern"
          >
            New Pattern
          </button>
          <button
            type="button"
            class="pattern-workspace-library-trigger"
            data-pattern-workspace-library-trigger
            data-testid="pattern-workspace-library-trigger"
            aria-label="Saved patterns"
            aria-haspopup="dialog"
            aria-controls="pattern-workspace-library-drawer-panel"
            aria-expanded="false"
            title="Saved patterns"
          >
            <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
          </button>
          </div>
        </div>
    ) : (
      <div class="pattern-tab-nav">
        <>
          <button type="button" class="tab-btn active" data-tab="build">
            <span class="tab-icon" aria-hidden="true">⚙️</span>
            <span class="tab-label">Create</span>
          </button>
          {
            !hidePattern && (
              <button
                type="button"
                id={patternTabButtonId}
                class:list={["tab-btn", patternTabDisabled && "is-disabled"]}
                data-tab="pattern"
                aria-disabled={patternTabDisabled ? "true" : undefined}
              >
                <span class="tab-icon" aria-hidden="true">📝</span>
                <span class="tab-label">Pattern</span>
              </button>
            )
          }
          {
            !hideShare && (
              <button type="button" class="tab-btn" data-tab="share">
                <span class="tab-icon" aria-hidden="true">💬</span>
                <span class="tab-label">Ask / Share</span>
              </button>
            )
          }
          {
            !hideInspiration && (
              <button type="button" class="tab-btn" data-tab="inspiration">
                <span class="tab-icon" aria-hidden="true">💡</span>
                <span class="tab-label">Inspiration</span>
              </button>
            )
          }
        </>
      </div>
    )
  }

  {workspaceNav ? <PatternWorkspaceLibraryDrawer /> : null}

  {
    workspaceNav ? null : (
      <div class="pattern-tab-content">
        <div class="tab-panel active" id="tab-build">
          <slot name="build" />
        </div>
        {
          !hidePattern && (
            <div class="tab-panel" id="tab-pattern">
              <slot name="pattern" />
            </div>
          )
        }
        {
          !hideShare && (
            <div class="tab-panel" id="tab-share">
              <slot name="share" />
            </div>
          )
        }
        {
          !hideInspiration && (
            <div class="tab-panel" id="tab-inspiration">
              <slot name="inspiration" />
            </div>
          )
        }
      </div>
    )
  }
</div>

<style>
  /* Sleeveless workspace: modern pill tabs (scoped; does not affect non-workspace PatternTabs). */
  .pattern-workspace-tabs .pattern-tab-nav {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-end;
    gap: 0.15rem;
    margin: 0 0 1.125rem;
    padding: 0.25rem 0 0.2rem;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(82, 104, 45, 0.12);
    border-radius: 0;
    box-shadow: none;
  }

  .pattern-workspace-tabs .pattern-tab-nav::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  /* Left section: primary workflow tabs. */
  .pattern-workspace-tabs .pattern-tab-nav__workflow {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: nowrap;
    align-items: flex-end;
    gap: 0.15rem;
    min-width: 0;
  }

  /* Right section: actions (New Pattern + Library), aligned right. */
  .pattern-workspace-tabs .pattern-tab-nav__actions {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: nowrap;
    align-items: flex-end;
    margin-left: auto;
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn {
    position: relative;
    z-index: 0;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0.45rem 0.55rem;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.25;
    color: #4a5c32;
    text-decoration: none;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(82, 104, 45, 0.14);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    box-shadow: none;
    transition:
      background 0.12s ease,
      color 0.12s ease,
      border-color 0.12s ease,
      box-shadow 0.12s ease;
  }

  .pattern-workspace-tabs .pattern-tab-nav a.tab-btn {
    color: #4a5c32;
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn:hover:not(.active):not(.is-disabled) {
    background: rgba(255, 255, 255, 0.88);
    color: #3d4d29;
    border-color: rgba(82, 104, 45, 0.22);
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn:focus-visible {
    outline: 2px solid #c2614e;
    outline-offset: 2px;
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn.active {
    z-index: 2;
    margin-bottom: -1px;
    padding-bottom: calc(0.45rem + 1px);
    color: #3d4d29;
    background: #f7f8f7;
    border-color: rgba(82, 104, 45, 0.18);
    border-bottom: 1px solid #f7f8f7;
    border-top: 2px solid #c2614e;
    border-radius: 8px 8px 0 0;
    box-shadow: 0 1px 0 0 #f7f8f7;
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn.is-disabled {
    color: #8a9a78;
    opacity: 0.75;
    cursor: not-allowed;
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(82, 104, 45, 0.08);
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn.is-disabled:hover {
    color: #8a9a78;
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(82, 104, 45, 0.08);
  }

  .pattern-workspace-tabs .pattern-workspace-tabs__visible-label {
    display: inline;
    white-space: nowrap;
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-btn--workspace-brand {
    gap: 0.35rem;
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-workspace-brand-icon {
    flex-shrink: 0;
    width: 1.0625rem;
    height: 1.0625rem;
    object-fit: contain;
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-workspace-summary-pencil-icon {
    display: block;
    color: currentColor;
  }

  .pattern-workspace-tabs .pattern-tab-nav .tab-workspace-mobile-icon {
    display: none;
    color: currentColor;
  }

  .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-new-pattern-trigger {
    flex: 0 0 auto;
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    margin: 0 0 0.3rem 0.35rem;
    padding: 0.28rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    color: #4a5c32;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(82, 104, 45, 0.14);
    border-radius: 999px;
    box-shadow: none;
    transition:
      background 0.12s ease,
      color 0.12s ease,
      border-color 0.12s ease;
  }

  .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-new-pattern-trigger:hover {
    color: #3d4d29;
    background: rgba(255, 255, 255, 0.88);
    border-color: rgba(82, 104, 45, 0.22);
  }

  .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-new-pattern-trigger:focus-visible {
    outline: 2px solid #c2614e;
    outline-offset: 2px;
  }

  .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-library-trigger {
    flex: 0 0 auto;
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 1.625rem;
    height: 1.625rem;
    margin: 0 0 0.3rem 0.25rem;
    padding: 0;
    font: inherit;
    line-height: 1;
    color: #4a5c32;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(82, 104, 45, 0.14);
    border-radius: 50%;
    box-shadow: none;
    opacity: 1;
    transition:
      background 0.12s ease,
      color 0.12s ease,
      border-color 0.12s ease,
      opacity 0.12s ease;
  }

  .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-library-trigger:hover {
    opacity: 1;
    color: #4a5c32;
    background: rgba(255, 255, 255, 0.72);
    border-color: rgba(82, 104, 45, 0.18);
  }

  .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-library-trigger:focus-visible {
    opacity: 1;
    outline: 2px solid #c2614e;
    outline-offset: 2px;
  }

  .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-library-trigger[aria-expanded="true"] {
    opacity: 1;
    color: #4a5c32;
    background: rgba(82, 104, 45, 0.09);
    border-color: rgba(82, 104, 45, 0.2);
  }

  .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-library-trigger i {
    display: block;
    font-size: 0.72rem;
    line-height: 1;
  }

  @media (max-width: 767px) {
    .pattern-workspace-tabs .pattern-tab-nav {
      gap: 0.06rem;
      margin: 0 0 1rem;
      padding: 0.18rem 0 0.12rem;
    }

    .pattern-workspace-tabs .pattern-tab-nav__workflow {
      gap: 0.06rem;
    }

    .pattern-workspace-tabs .pattern-tab-nav .tab-btn {
      flex: 1 1 0;
      min-width: 0;
      min-height: 2.75rem;
      padding: 0.35rem 0.28rem;
      font-size: 0.76rem;
      box-sizing: border-box;
      justify-content: center;
    }

    .pattern-workspace-tabs .pattern-tab-nav .tab-btn.active {
      padding-bottom: calc(0.35rem + 1px);
    }

    .pattern-workspace-tabs .pattern-workspace-tabs__visible-label {
      display: none;
    }

    .pattern-workspace-tabs .pattern-tab-nav .tab-workspace-brand-icon {
      width: 1.2rem;
      height: 1.2rem;
    }

    .pattern-workspace-tabs .pattern-tab-nav .tab-btn--workspace-brand {
      gap: 0;
    }

    .pattern-workspace-tabs .pattern-tab-nav .tab-workspace-mobile-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      line-height: 1;
    }

    .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-new-pattern-trigger {
      margin-bottom: 0.22rem;
      margin-left: 0.28rem;
      padding: 0.32rem 0.5rem;
      font-size: 0.68rem;
    }

    .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-library-trigger {
      width: 1.875rem;
      height: 1.875rem;
      margin-bottom: 0.22rem;
      margin-left: 0.2rem;
    }

    .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-library-trigger i {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 420px) {
    .pattern-workspace-tabs .pattern-tab-nav .tab-btn {
      padding: 0.32rem 0.18rem;
      font-size: 0.7rem;
    }

    .pattern-workspace-tabs .pattern-tab-nav .tab-btn.active {
      padding-bottom: calc(0.32rem + 1px);
    }

    .pattern-workspace-tabs .pattern-tab-nav .tab-workspace-brand-icon {
      width: 1.1rem;
      height: 1.1rem;
    }

    .pattern-workspace-tabs .pattern-tab-nav .tab-workspace-mobile-icon {
      font-size: 1.02rem;
    }

    .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-new-pattern-trigger {
      margin-left: 0.22rem;
      padding: 0.28rem 0.42rem;
      font-size: 0.64rem;
    }

    .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-library-trigger {
      width: 1.75rem;
      height: 1.75rem;
      margin-left: 0.18rem;
    }

    .pattern-workspace-tabs .pattern-tab-nav .pattern-workspace-library-trigger i {
      font-size: 0.76rem;
    }
  }
</style>
