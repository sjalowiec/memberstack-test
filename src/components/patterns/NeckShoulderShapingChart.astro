---
import type { NeckShoulderShapingChart } from "../../lib/patterns/neckShoulderShapingChart";
import { getNeckShoulderChartRowHighlightFromRow } from "../../lib/patterns/neckShoulderShapingChart";
import { renderShoulderShapingSvg } from "../../lib/patterns/shoulderShapingSvg";

interface Props {
  chart: NeckShoulderShapingChart;
  class?: string;
  /** Dev-only: whether chart rows are live-calculated or demo fallback. */
  dataSourceNote?: string;
}

const { chart, class: className = "", dataSourceNote } = Astro.props;

const necklineShoulderChartRows = chart.rows;
const shoulderPreviewSvg = renderShoulderShapingSvg(necklineShoulderChartRows, "right");
---

<section class:list={["ns-shaping-chart", className]} aria-labelledby="ns-shaping-chart-heading">
  <h2 id="ns-shaping-chart-heading" class="ns-shaping-chart__title">Neckline / Shoulder Shaping Chart</h2>
  <p class="ns-shaping-chart__intro">
    Work each shoulder separately.<br />
    Right and Left refer to each side on the needlebed.<br />
    Highlighted rows indicate action happening on both sides.
  </p>
  <div class="ns-shaping-chart__table-wrap">
    <table class="ns-shaping-chart__table">
      <thead>
        <tr>
          <th scope="col" rowspan="2" class="ns-shaping-chart__th-row">Row</th>
          <th scope="col" rowspan="2" class="ns-shaping-chart__th-action">Action</th>
          <th scope="colgroup" colspan="2" class="ns-shaping-chart__th-group">Left</th>
          <th scope="colgroup" colspan="1" class="ns-shaping-chart__th-group">Center</th>
          <th scope="colgroup" colspan="2" class="ns-shaping-chart__th-group">Right</th>
          <th scope="colgroup" colspan="2" class="ns-shaping-chart__th-group">Stitch count</th>
        </tr>
        <tr>
          <th scope="col" class="ns-shaping-chart__th-sub">Side</th>
          <th scope="col" class="ns-shaping-chart__th-sub">Neck</th>
          <th scope="col" class="ns-shaping-chart__th-sub">Neck center</th>
          <th scope="col" class="ns-shaping-chart__th-sub">Neck</th>
          <th scope="col" class="ns-shaping-chart__th-sub">Side</th>
          <th scope="col" class="ns-shaping-chart__th-sub">Left</th>
          <th scope="col" class="ns-shaping-chart__th-sub">Right</th>
        </tr>
      </thead>
      <tbody>
        {
          chart.rows.map((r) => {
            const hi = getNeckShoulderChartRowHighlightFromRow(r);
            const rowClass =
              hi === "neckBothSides"
                ? "ns-shaping-chart__tr ns-shaping-chart__tr--neck-both"
                : hi === "shoulderAndNeck"
                  ? "ns-shaping-chart__tr ns-shaping-chart__tr--shoulder-neck"
                  : hi === "shoulderBothSides"
                    ? "ns-shaping-chart__tr ns-shaping-chart__tr--shoulder-both"
                    : "ns-shaping-chart__tr";
            return (
              <tr class={rowClass}>
                <td class="ns-shaping-chart__td-num">{r.row}</td>
                <td>{r.action}</td>
                <td class="ns-shaping-chart__td-center">{r.leftSide}</td>
                <td class="ns-shaping-chart__td-center">{r.leftNeck}</td>
                <td class="ns-shaping-chart__td-center">{r.centerNeck}</td>
                <td class="ns-shaping-chart__td-center">{r.rightNeck}</td>
                <td class="ns-shaping-chart__td-center">{r.rightSide}</td>
                <td class="ns-shaping-chart__td-num">{r.leftStitchCount}</td>
                <td class="ns-shaping-chart__td-num">{r.rightStitchCount}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  {
    dataSourceNote ? (
      <p class="ns-shaping-chart__dev-note">{dataSourceNote}</p>
    ) : null
  }

  <div class="ns-shaping-chart__preview" aria-labelledby="ns-shaping-preview-heading">
    <h3 id="ns-shaping-preview-heading" class="ns-shaping-chart__preview-title">Neckline / Shoulder Shape Preview</h3>
    <p class="ns-shaping-chart__preview-caption">Right shoulder (same data as table). Grid: 10 px per stitch, 10 px per row.</p>
    <div class="ns-shaping-chart__preview-svg-wrap" set:html={shoulderPreviewSvg} />
  </div>
</section>

<style is:global>
  .ns-shaping-chart {
    margin: 1.25rem 0 1.5rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: #1f2937;
  }

  .ns-shaping-chart__title {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--kbm-green, #52682d);
    letter-spacing: 0.02em;
  }

  .ns-shaping-chart__intro {
    margin: 0 0 0.65rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #374151;
  }

  .ns-shaping-chart__dev-note {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: #7c3aed;
    font-weight: 600;
  }

  .ns-shaping-chart__table-wrap {
    overflow-x: auto;
    margin: 0 0 0.6rem;
    border: 1px solid rgba(55, 65, 81, 0.2);
    border-radius: 6px;
    background: #fff;
  }

  .ns-shaping-chart__table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .ns-shaping-chart__table th,
  .ns-shaping-chart__table td {
    padding: 0.28rem 0.45rem;
    border-bottom: 1px solid rgba(55, 65, 81, 0.12);
    vertical-align: middle;
  }

  .ns-shaping-chart__table tbody tr:last-child td {
    border-bottom: none;
  }

  .ns-shaping-chart__th-group {
    text-align: center;
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #374151;
    background: rgba(82, 104, 45, 0.06);
    border-bottom: 1px solid rgba(55, 65, 81, 0.15);
  }

  .ns-shaping-chart__th-sub {
    text-align: center;
    font-weight: 600;
    font-size: 0.75rem;
    background: rgba(82, 104, 45, 0.04);
    color: #4b5563;
  }

  .ns-shaping-chart__th-row,
  .ns-shaping-chart__th-action {
    text-align: left;
    vertical-align: bottom;
    font-weight: 700;
    font-size: 0.75rem;
    background: rgba(82, 104, 45, 0.06);
    border-bottom: 1px solid rgba(55, 65, 81, 0.15);
  }

  .ns-shaping-chart__td-num {
    text-align: right;
    white-space: nowrap;
  }

  .ns-shaping-chart__td-center {
    text-align: center;
  }

  /* Neck shaping on both sides */
  .ns-shaping-chart__tr--neck-both td {
    background: #f3f4f6;
  }

  /* Shoulder + neck together */
  .ns-shaping-chart__tr--shoulder-neck td {
    background: #fdf2f8;
  }

  /* Shoulder on both sides */
  .ns-shaping-chart__tr--shoulder-both td {
    background: #f3f4f6;
  }

  .ns-shaping-chart__preview {
    margin: 1rem 0 0.75rem;
    padding: 0.75rem 0 0;
    border-top: 1px solid rgba(55, 65, 81, 0.12);
  }

  .ns-shaping-chart__preview-title {
    margin: 0 0 0.35rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--kbm-green, #52682d);
  }

  .ns-shaping-chart__preview-caption {
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: #6b7280;
  }

  .ns-shaping-chart__preview-svg-wrap {
    overflow-x: auto;
    max-width: 100%;
  }

  .ns-shaping-chart__preview-svg-wrap :global(svg) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  @media print {
    .ns-shaping-chart {
      font-size: 9pt;
      break-inside: avoid;
    }

    .ns-shaping-chart__table-wrap {
      border-color: #999;
    }

    .ns-shaping-chart__tr--neck-both td {
      background: #eee !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .ns-shaping-chart__tr--shoulder-neck td {
      background: #fce7f3 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .ns-shaping-chart__tr--shoulder-both td {
      background: #eee !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
