/**
 * Phone-only tip for pattern Builder / Edit workspaces.
 * Hidden on tablet and desktop via CSS (max-width: 767.98px).
 * Do not place on finished pattern viewing chrome — only builders and Edit surfaces.
 */
---

<aside
  class="pattern-phone-workspace-notice no-print"
  data-pattern-phone-workspace-notice
  role="note"
>
  <p class="pattern-phone-workspace-notice__text">
    Pattern building works best on a computer or tablet. Saved patterns are phone-friendly, so you
    can easily follow them while you knit.
  </p>
</aside>
