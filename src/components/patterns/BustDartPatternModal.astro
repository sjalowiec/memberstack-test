---
/**
 * Finished-pattern optional Bust Dart customization dialog.
 * Prefills construction/style from the pattern; user chooses cup size, edits width/depth, then Add to Pattern.
 * Help video lives on the pattern page (inactive Optional Bust Dart prompt), not in this modal.
 */
import FloatingSelect from "../tools/FloatingSelect.astro";
import FloatingInput from "../tools/FloatingInput.astro";
import { DART_CUP_SIZES, formatDartCupOptionLabel } from "../../lib/tools/dartFormulaMath";

const cupOptions = DART_CUP_SIZES.map((value) => ({
  label: formatDartCupOptionLabel(value, "in"),
  value,
}));
---

<dialog
  class="bust-dart-pattern-modal"
  data-bust-dart-pattern-modal
  aria-labelledby="bust-dart-modal-title"
>
  <!--
    Not method="dialog": Cancel/× are type=button and close in JS.
    Add/Update is type=submit with formnovalidate so Enter runs custom validation
    (never native constraint validation / never Cancel).
  -->
  <form class="bust-dart-pattern-modal__panel" data-bust-dart-modal-form>
    <header class="bust-dart-pattern-modal__header">
      <h2 id="bust-dart-modal-title" class="bust-dart-pattern-modal__title">Optional Bust Dart</h2>
      <button
        type="button"
        class="bust-dart-pattern-modal__close"
        aria-label="Close"
        data-bust-dart-modal-close
      >
        <span class="bust-dart-pattern-modal__close-icon" aria-hidden="true">×</span>
      </button>
    </header>

    <div class="bust-dart-pattern-modal__body">
      <p class="bust-dart-pattern-modal__intro">
        Add short-row bust darts to the <strong>front only</strong>, starting <span data-bust-dart-modal-intro-placement>1″</span> below the armhole opening.
        Choose a cup size, adjust width and depth if needed, then add to the pattern.
      </p>

      <p class="bust-dart-pattern-modal__summary-line" data-bust-dart-modal-summary-line>—</p>

      <div class="bust-dart-pattern-modal__field">
        <FloatingSelect
          id="bust-dart-pattern-cup"
          name="bustDartCupSize"
          label="Cup size"
          placeholder="Select cup size"
          options={cupOptions}
          required
          dataTestid="select-bust-dart-pattern-cup"
        />
      </div>

      <div class="bust-dart-pattern-modal__dims" data-bust-dart-modal-dims hidden>
        <FloatingInput
          id="bust-dart-pattern-width"
          name="bustDartWidth"
          label="Dart width (in)"
          type="number"
          min={0.01}
          step="any"
          inputmode="decimal"
          required
          labelId="bust-dart-pattern-width-label"
          dataTestid="input-bust-dart-pattern-width"
        />
        <FloatingInput
          id="bust-dart-pattern-depth"
          name="bustDartDepth"
          label="Dart depth (in)"
          type="number"
          min={0.01}
          step="any"
          inputmode="decimal"
          required
          labelId="bust-dart-pattern-depth-label"
          dataTestid="input-bust-dart-pattern-depth"
        />
      </div>
      <p class="bust-dart-pattern-modal__customized" data-bust-dart-modal-customized hidden>
        Customized
      </p>

      <p class="bust-dart-pattern-modal__error" data-bust-dart-modal-error hidden role="alert"></p>

      <div class="bust-dart-pattern-modal__preview" data-bust-dart-modal-preview hidden>
        <h3 class="bust-dart-pattern-modal__preview-title">Preview</h3>
        <ul data-bust-dart-modal-preview-list></ul>
      </div>
    </div>

    <footer class="bust-dart-pattern-modal__footer">
      <button
        type="button"
        class="kbm-btn kbm-btn-outline bust-dart-pattern-modal__btn bust-dart-pattern-modal__btn--remove"
        data-bust-dart-modal-remove
        hidden
      >
        Remove Bust Dart
      </button>
      <div class="bust-dart-pattern-modal__footer-end">
        <button
          type="button"
          class="kbm-btn kbm-btn-outline bust-dart-pattern-modal__btn"
          data-bust-dart-modal-cancel
        >
          Cancel
        </button>
        <button
          type="submit"
          class="kbm-btn kbm-btn-primary bust-dart-pattern-modal__btn bust-dart-pattern-modal__btn--primary"
          data-bust-dart-modal-add
          data-testid="button-bust-dart-add-to-pattern"
          formnovalidate
        >
          Add to Pattern
        </button>
      </div>
    </footer>
  </form>
</dialog>

<style is:global>
  .bust-dart-pattern-modal {
    border: none;
    border-radius: 12px;
    padding: 0;
    max-width: min(28rem, calc(100vw - 1.25rem));
    width: 100%;
    max-height: min(92dvh, calc(100vh - 1.5rem));
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    overflow: hidden;
  }
  .bust-dart-pattern-modal::backdrop {
    background: rgba(17, 24, 39, 0.45);
  }
  .bust-dart-pattern-modal__panel {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    max-height: min(92dvh, calc(100vh - 1.5rem));
    overflow: hidden;
  }
  .bust-dart-pattern-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.1rem 1.15rem 0.35rem 1.25rem;
    flex-shrink: 0;
  }
  .bust-dart-pattern-modal__title {
    margin: 0;
    font-size: 1.25rem;
    color: #1f2937;
  }
  .bust-dart-pattern-modal__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    margin: -0.35rem -0.35rem 0 0;
    border: none;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    color: #6b7280;
    -webkit-tap-highlight-color: transparent;
  }
  .bust-dart-pattern-modal__close:hover,
  .bust-dart-pattern-modal__close:focus-visible {
    background: #f3f4f6;
    color: #374151;
    outline: none;
  }
  .bust-dart-pattern-modal__close:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }
  .bust-dart-pattern-modal__close-icon {
    font-size: 1.5rem;
    line-height: 1;
  }
  .bust-dart-pattern-modal__body {
    flex: 1 1 auto;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.35rem 1.25rem 0.85rem;
  }
  .bust-dart-pattern-modal__intro {
    margin: 0.35rem 0 0.65rem;
    color: #4b5563;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .bust-dart-pattern-modal__summary-line {
    margin: 0 0 0.85rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #374151;
    line-height: 1.35;
  }
  .bust-dart-pattern-modal__field {
    margin-bottom: 0.75rem;
  }
  .bust-dart-pattern-modal__dims {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }
  .bust-dart-pattern-modal__dims[hidden] {
    display: none !important;
  }
  .bust-dart-pattern-modal__customized {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #52682d;
  }
  .bust-dart-pattern-modal__error {
    color: #b91c1c;
    font-size: 0.9rem;
    margin: 0.5rem 0;
  }
  .bust-dart-pattern-modal__preview {
    margin: 0.75rem 0 0.25rem;
    padding: 0.75rem 0.9rem;
    background: #f9fafb;
    border-radius: 8px;
    border-left: 4px solid var(--kbm-green, #52682d);
  }
  .bust-dart-pattern-modal__preview-title {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
  }
  .bust-dart-pattern-modal__preview ul {
    margin: 0;
    padding-left: 1.15rem;
  }
  .bust-dart-pattern-modal__preview li {
    margin-bottom: 0.25rem;
    font-size: 0.9rem;
    color: #374151;
  }
  .bust-dart-pattern-modal__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.65rem;
    flex-shrink: 0;
    margin: 0;
    padding: 0.85rem 1.15rem 1.1rem;
    border-top: 1px solid #e5e7eb;
    background: #fff;
  }
  .bust-dart-pattern-modal__footer-end {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-left: auto;
    flex: 1 1 auto;
    justify-content: flex-end;
  }
  .bust-dart-pattern-modal__btn {
    min-height: 44px;
    padding: 0.65rem 1.1rem;
    font-size: 1rem;
    line-height: 1.2;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }
  .bust-dart-pattern-modal__btn--primary {
    min-width: 9.5rem;
  }
  .bust-dart-pattern-modal__btn--remove {
    border-color: color-mix(in srgb, #b91c1c 45%, #d1d5db);
    color: #991b1b;
    order: -1;
    flex: 0 1 auto;
  }
  .bust-dart-pattern-modal__btn--remove:hover,
  .bust-dart-pattern-modal__btn--remove:focus-visible {
    background: #fef2f2;
    border-color: #b91c1c;
    color: #7f1d1d;
  }
  .bust-dart-pattern-modal__btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (max-width: 480px) {
    .bust-dart-pattern-modal__dims {
      grid-template-columns: 1fr;
    }
    .bust-dart-pattern-modal__footer {
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .bust-dart-pattern-modal__footer-end {
      margin-left: 0;
      flex-direction: column-reverse;
      width: 100%;
    }
    .bust-dart-pattern-modal__btn,
    .bust-dart-pattern-modal__btn--primary,
    .bust-dart-pattern-modal__btn--remove {
      width: 100%;
      min-width: 0;
    }
    /* Remove stays visually quieter / less accidental after primary+cancel stack */
    .bust-dart-pattern-modal__btn--remove {
      order: 0;
      margin-top: 0.15rem;
      font-size: 0.92rem;
      opacity: 0.95;
    }
  }
</style>
