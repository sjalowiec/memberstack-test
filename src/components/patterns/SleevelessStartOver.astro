---
/** Subtle “Start over” for sleeveless wizard pages — clears builder storage and sends users to the first step. */
---

<div class="sg-start-over-wrap no-print">
  <button
    type="button"
    class="sg-start-over"
    data-sleeveless-start-over
  >
    Start over
  </button>
</div>

<style>
  .sg-start-over-wrap {
    display: flex;
    justify-content: center;
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(82, 104, 45, 0.1);
  }

  .sg-start-over {
    appearance: none;
    margin: 0;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    color: #6b7280;
    background: transparent;
    border: 1px solid rgba(107, 114, 128, 0.45);
    border-radius: 8px;
    padding: 0.4rem 0.95rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .sg-start-over:hover {
    color: #4b5563;
    border-color: rgba(107, 114, 128, 0.65);
    background: rgba(107, 114, 128, 0.06);
  }

  .sg-start-over:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }
</style>

<script>
  import {
    clearSleevelessPatternBuilderData,
    SLEEVELESS_BUILDER_RESET_PARAM,
    SLEEVELESS_BUILDER_RESET_VALUE,
  } from "../../lib/patterns/patternStorage.ts";

  const CONFIRM_MSG =
    "Start over? This will clear your style, fit, yarn, and gauge choices for this pattern.";

  function bindStartOver(): void {
    document.querySelectorAll<HTMLButtonElement>("[data-sleeveless-start-over]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!window.confirm(CONFIRM_MSG)) return;
        clearSleevelessPatternBuilderData();
        const path = window.location.pathname.replace(/\/$/, "") || "/";
        let base = "/patterns/sleeveless-garment";
        if (path.includes("/patterns/sleeveless-pattern")) {
          base = "/patterns/sleeveless-pattern";
        }
        const next = new URL(base, window.location.origin);
        next.searchParams.set(SLEEVELESS_BUILDER_RESET_PARAM, SLEEVELESS_BUILDER_RESET_VALUE);
        window.location.assign(next.pathname + next.search);
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bindStartOver);
  } else {
    bindStartOver();
  }
</script>
