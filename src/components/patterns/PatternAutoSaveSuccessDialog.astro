---
import { buildAutoSaveSuccessMessage } from "../../lib/patterns/patternAutoSaveFirstFree";
---

<dialog
  class="pattern-auto-save-success-dialog"
  data-pattern-auto-save-success-dialog
  aria-labelledby="pattern-auto-save-success-title"
>
  <div class="pattern-auto-save-success-dialog__inner">
    <h2 id="pattern-auto-save-success-title" class="pattern-auto-save-success-dialog__title">
      Pattern saved
    </h2>
    <p class="pattern-auto-save-success-dialog__message" data-pattern-auto-save-success-message>
      {buildAutoSaveSuccessMessage("sleeveless")}
    </p>
    <div class="pattern-auto-save-success-dialog__actions">
      <button
        type="button"
        class="pattern-auto-save-success-dialog__secondary"
        data-pattern-auto-save-continue
      >
        Continue
      </button>
      <button
        type="button"
        class="pattern-auto-save-success-dialog__primary kbm-btn kbm-btn-primary"
        data-pattern-auto-save-open-library
      >
        Open My Patterns
      </button>
    </div>
  </div>
</dialog>

<script>
  import { initPatternAutoSaveSuccessDialog } from "../../lib/patterns/patternAutoSaveSuccessDialog";

  initPatternAutoSaveSuccessDialog();
</script>

<style>
  .pattern-auto-save-success-dialog {
    max-width: min(92vw, 28rem);
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.18);
  }

  .pattern-auto-save-success-dialog::backdrop {
    background: rgba(15, 23, 42, 0.35);
  }

  .pattern-auto-save-success-dialog__inner {
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .pattern-auto-save-success-dialog__title {
    margin: 0 0 0.75rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: #2c3a57;
    line-height: 1.25;
  }

  .pattern-auto-save-success-dialog__message {
    margin: 0 0 1.25rem;
    font-size: 1rem;
    line-height: 1.55;
    color: #374151;
  }

  .pattern-auto-save-success-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: flex-end;
  }

  .pattern-auto-save-success-dialog__secondary {
    appearance: none;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    background: #fff;
    color: #374151;
    font: inherit;
    font-weight: 600;
    padding: 0.55rem 0.95rem;
    cursor: pointer;
  }

  .pattern-auto-save-success-dialog__secondary:hover {
    background: #f9fafb;
  }
</style>
