---
/** Compact “Editing: …” row when an Express session is resumed; visibility set client-side. */
---

<div class="express-editing-bar no-print" data-express-editing-bar hidden>
  <p class="express-editing-bar__status">
    <span class="express-editing-bar__prefix">Editing:</span>
    <span class="express-editing-bar__name" data-express-editing-name></span>
  </p>
  <button type="button" class="btn btn-outline-secondary btn-sm" data-express-editing-start-new>
    Start New Pattern
  </button>
</div>
