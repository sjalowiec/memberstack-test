---
import {
  PATTERN_EDITING_UNLOCK_MODAL_BODY_DETAIL,
  PATTERN_EDITING_UNLOCK_MODAL_BODY_LEAD,
  PATTERN_EDITING_UNLOCK_MODAL_KEEP_LABEL,
  PATTERN_EDITING_UNLOCK_MODAL_MEMBERSHIP_HREF,
  PATTERN_EDITING_UNLOCK_MODAL_MEMBERSHIP_LABEL,
  PATTERN_EDITING_UNLOCK_MODAL_TITLE,
} from "../../lib/patterns/patternEditingUnlockModal";
---

<dialog
  class="pattern-editing-unlock-modal"
  data-pattern-editing-unlock-modal
  aria-labelledby="pattern-editing-unlock-modal-title"
>
  <div class="pattern-editing-unlock-modal__inner">
    <h2 id="pattern-editing-unlock-modal-title" class="pattern-editing-unlock-modal__title">
      {PATTERN_EDITING_UNLOCK_MODAL_TITLE}
    </h2>
    <p class="pattern-editing-unlock-modal__message">{PATTERN_EDITING_UNLOCK_MODAL_BODY_LEAD}</p>
    <p class="pattern-editing-unlock-modal__message">{PATTERN_EDITING_UNLOCK_MODAL_BODY_DETAIL}</p>
    <div class="pattern-editing-unlock-modal__actions">
      <button
        type="button"
        class="pattern-editing-unlock-modal__dismiss"
        data-pattern-editing-unlock-dismiss
      >
        {PATTERN_EDITING_UNLOCK_MODAL_KEEP_LABEL}
      </button>
      <a
        href={PATTERN_EDITING_UNLOCK_MODAL_MEMBERSHIP_HREF}
        class="pattern-editing-unlock-modal__primary kbm-btn kbm-btn-primary"
      >
        {PATTERN_EDITING_UNLOCK_MODAL_MEMBERSHIP_LABEL}
      </a>
    </div>
  </div>
</dialog>

<script>
  import {
    initPatternEditingUnlockModal,
    wirePatternEditingUnlockClickIntercepts,
  } from "../../lib/patterns/patternEditingUnlockModal";

  initPatternEditingUnlockModal();
  wirePatternEditingUnlockClickIntercepts();
</script>

<style>
  .pattern-editing-unlock-modal {
    max-width: min(92vw, 28rem);
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.18);
  }

  .pattern-editing-unlock-modal::backdrop {
    background: rgba(15, 23, 42, 0.45);
  }

  .pattern-editing-unlock-modal__inner {
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .pattern-editing-unlock-modal__title {
    margin: 0 0 0.75rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: #2c3a57;
    line-height: 1.25;
  }

  .pattern-editing-unlock-modal__message {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    line-height: 1.55;
    color: #374151;
  }

  .pattern-editing-unlock-modal__message:last-of-type {
    margin-bottom: 1.25rem;
  }

  .pattern-editing-unlock-modal__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: flex-end;
  }

  .pattern-editing-unlock-modal__primary {
    text-decoration: none;
  }

  .pattern-editing-unlock-modal__dismiss {
    appearance: none;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    background: #fff;
    color: #374151;
    font: inherit;
    font-weight: 600;
    padding: 0.55rem 0.95rem;
    cursor: pointer;
  }

  .pattern-editing-unlock-modal__dismiss:hover {
    background: #f9fafb;
  }

  .pattern-editing-unlock-modal__dismiss:focus-visible {
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }
</style>
