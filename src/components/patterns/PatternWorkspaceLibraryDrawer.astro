---
import "../../styles/pattern-workspace-library-drawer.css";
import "../../styles/pattern-workspace-new-pattern.css";
---

<div
  class="pattern-workspace-library-drawer hat-yarn-drawer no-print"
  data-pattern-workspace-library-drawer
  aria-hidden="true"
>
  <div
    id="pattern-workspace-library-drawer-panel"
    class="hat-yarn-drawer-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="pattern-workspace-library-drawer-title"
    aria-hidden="true"
  >
    <header class="hat-yarn-drawer-header">
      <div class="hat-yarn-drawer-header-text">
        <h2 id="pattern-workspace-library-drawer-title" class="hat-yarn-drawer-title">
          Your Saved Patterns
        </h2>
      </div>
      <button
        type="button"
        class="hat-yarn-drawer-close"
        data-pattern-workspace-library-close
        data-testid="pattern-workspace-library-close"
        aria-label="Close saved patterns"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M18 6L6 18M6 6l12 12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </header>
    <div class="hat-yarn-drawer-body">
      <div class="pattern-workspace-library__manage-row">
        <a class="pattern-workspace-library__manage-link" href="/account#my-patterns">
          Manage saved patterns
        </a>
      </div>
      <div
        class="pattern-workspace-library__status"
        data-pattern-workspace-library-status
        role="status"
        aria-live="polite"
        hidden
      ></div>
      <ul
        class="pattern-workspace-library__list"
        data-pattern-workspace-library-list
        data-testid="pattern-workspace-library-list"
        hidden
      ></ul>
    </div>
  </div>
  <div
    class="hat-yarn-drawer-backdrop"
    data-pattern-workspace-library-backdrop
    aria-hidden="true"
  ></div>
</div>

<dialog
  id="pattern-workspace-new-pattern-unsaved-dialog"
  class="pattern-workspace-new-pattern-dialog"
  aria-labelledby="pattern-workspace-new-pattern-unsaved-title"
>
  <div class="pattern-workspace-new-pattern-dialog__panel" data-pattern-new-unsaved-panel>
    <span class="pattern-workspace-new-pattern-dialog__icon" aria-hidden="true">
      <svg
        class="pattern-workspace-new-pattern-dialog__icon-svg"
        width="26"
        height="26"
        viewBox="0 0 24 24"
        fill="none"
        focusable="false"
      >
        <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.75"></circle>
        <path
          d="M12 7.75v5.25M12 15.5h.01"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </span>
    <div class="pattern-workspace-new-pattern-dialog__content">
      <h2
        id="pattern-workspace-new-pattern-unsaved-title"
        class="pattern-workspace-new-pattern-dialog__title"
        data-pattern-new-unsaved-title
      >
        You have unsaved changes to this pattern.
      </h2>
      <p class="pattern-workspace-new-pattern-dialog__message" data-pattern-new-unsaved-body>
        Would you like to save your edits before starting a new pattern?
      </p>
      <p
        class="pattern-workspace-new-pattern-dialog__fallback-hint"
        data-pattern-new-unsaved-fallback-hint
        hidden
      ></p>
    </div>
    <div class="pattern-workspace-new-pattern-dialog__actions">
      <button
        type="button"
        class="pattern-workspace-new-pattern-dialog__btn pattern-workspace-new-pattern-dialog__btn--primary"
        data-pattern-new-unsaved-save
      >
        Save &amp; Start New
      </button>
      <button
        type="button"
        class="pattern-workspace-new-pattern-dialog__btn pattern-workspace-new-pattern-dialog__btn--secondary"
        data-pattern-new-unsaved-discard
      >
        Start New Without Saving
      </button>
      <button
        type="button"
        class="pattern-workspace-new-pattern-dialog__btn pattern-workspace-new-pattern-dialog__btn--minimal"
        data-pattern-new-unsaved-cancel
      >
        Cancel
      </button>
    </div>
  </div>
</dialog>

<script>
  import { initPatternWorkspaceLibraryDrawer } from "../../lib/patterns/patternWorkspaceLibraryDrawer";
  import { initPatternWorkspaceNewPattern } from "../../lib/patterns/patternWorkspaceNewPattern";
  import { initPatternWorkspaceCreateTab } from "../../lib/patterns/patternWorkspaceCreateTab";
  import { initPatternWorkspaceExpressTabLabel } from "../../lib/patterns/patternWorkspaceExpressTabLabel";

  initPatternWorkspaceLibraryDrawer();
  initPatternWorkspaceNewPattern();
  initPatternWorkspaceCreateTab();
  initPatternWorkspaceExpressTabLabel();
</script>
