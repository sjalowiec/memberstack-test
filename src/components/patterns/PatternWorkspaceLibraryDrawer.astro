---
import "../../styles/pattern-workspace-library-drawer.css";
---

<div
  class="pattern-workspace-library-drawer hat-yarn-drawer no-print"
  data-pattern-workspace-library-drawer
  aria-hidden="true"
>
  <div
    id="pattern-workspace-library-drawer-panel"
    class="hat-yarn-drawer-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="pattern-workspace-library-drawer-title"
    aria-hidden="true"
  >
    <header class="hat-yarn-drawer-header">
      <div class="hat-yarn-drawer-header-text">
        <h2 id="pattern-workspace-library-drawer-title" class="hat-yarn-drawer-title">
          Saved patterns
        </h2>
      </div>
      <button
        type="button"
        class="hat-yarn-drawer-close"
        data-pattern-workspace-library-close
        data-testid="pattern-workspace-library-close"
        aria-label="Close saved patterns"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M18 6L6 18M6 6l12 12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </header>
    <div class="hat-yarn-drawer-body">
      <div class="pattern-workspace-library__manage-row">
        <a class="pattern-workspace-library__manage-link" href="/account#my-patterns">
          Manage saved patterns
        </a>
      </div>
      <p
        class="pattern-workspace-library__status"
        data-pattern-workspace-library-status
        role="status"
        aria-live="polite"
        hidden
      ></p>
      <ul
        class="pattern-workspace-library__list"
        data-pattern-workspace-library-list
        data-testid="pattern-workspace-library-list"
        hidden
      ></ul>
    </div>
  </div>
  <div
    class="hat-yarn-drawer-backdrop"
    data-pattern-workspace-library-backdrop
    aria-hidden="true"
  ></div>
</div>

<script>
  import { initPatternWorkspaceLibraryDrawer } from "../../lib/patterns/patternWorkspaceLibraryDrawer";

  initPatternWorkspaceLibraryDrawer();
</script>
