---
import SleevelessStartOver from "../SleevelessStartOver.astro";
import "../../../styles/wizard.css";

export interface Props {
  /** When true, CTAs switch steps inside {@link SleevelessBuildWorkspace}; omit standalone Start Over. */
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<div class="sg-fit-page sg-build-panel" data-sg-build-panel="fit">
      <header class="page-header">
        <p data-sg-fit-page-intro>
          Pick a size from the sizing chart, then decide how closely the sweater should fit and fine-tune the numbers that matter.
        </p>
        <p class="kbm-pattern-save-status" data-pattern-save-status aria-live="polite"></p>
      </header>

      <div class="calculator-card hat-builder-inputs" id="sleeveless-fit-builder">
        <h2 class="sg-section-title">Set the Fit</h2>
        <section class="hat-form-section sg-fit-so-far-section" aria-labelledby="sg-fit-so-far-heading">
          <div class="builder-summary">
            <h2 id="sg-fit-so-far-heading" class="builder-summary-title hat-form-section__title hat-form-section__heading">
              <span class="sg-so-far-summary-heading__icon" aria-hidden="true">
                <svg
                  class="sg-so-far-summary-heading__svg"
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                  <path d="m9 14 2 2 4-4"></path>
                </svg>
              </span>
              Your Design Choices:
            </h2>
            <div class="builder-summary-content">
              <div class="sg-summary-panel">
                <p id="garment-config-so-far-sentence" class="sg-summary-sentence">Women's straight sleeveless pullover with a round neckline</p>
              </div>
            </div>
          </div>
        </section>

        <section
          id="pattern-builder-size-selection"
          class="hat-form-section sg-selector-section sg-fit-placeholder-section sg-fit-size-section is-locked"
          aria-labelledby="sg-fit-size-heading"
          data-size-section
          data-selector-key="size"
        >
          <div class="sg-section-header" data-section-toggle role="button" tabindex="0" aria-expanded="false">
            <button type="button" class="sg-section-chevron-btn" data-section-chevron aria-label="Toggle Choose a size section">▾</button>
            <div class="sg-section-header-main">
              <h2 id="sg-fit-size-heading" class="hat-form-section__title hat-form-section__heading">7. Choose a size</h2>
              <span class="sg-section-selected-check" data-selected-check aria-hidden="true">✓</span>
              <span class="sg-section-selected-value" data-selected-value></span>
            </div>
          </div>
          <div class="sg-section-options">
          <p class="sg-fit-size-copy" data-size-helper-copy>Go back to the design page to choose Women's, Men's, Kids', or Baby.</p>
          <p class="sg-fit-size-chart-label" data-size-chart-label hidden></p>
          <p class="sg-fit-size-copy" data-size-body-measurement-hint hidden>Choose the size that matches your body measurement.</p>
          <p class="sg-fit-size-load-msg" data-size-charts-status>Loading size charts…</p>
          <div class="sg-fit-size-charts" data-size-charts>
            <div class="sg-fit-size-chart-panel" data-size-chart="misses" data-size-audience="misses" hidden>
              <select
                id="sg-fit-size-select-misses"
                class="sg-fit-size-select"
                data-fit-size-select
                data-size-audience="misses"
                aria-labelledby="sg-fit-size-heading"
              ></select>
            </div>
            <div class="sg-fit-size-chart-panel" data-size-chart="plus" data-size-audience="plus" hidden data-sg-v1-hidden>
              <select
                id="sg-fit-size-select-plus"
                class="sg-fit-size-select"
                data-fit-size-select
                data-size-audience="plus"
                aria-labelledby="sg-fit-size-heading"
              ></select>
            </div>
            <div class="sg-fit-size-chart-panel" data-size-chart="men" data-size-audience="men" hidden>
              <select
                id="sg-fit-size-select-men"
                class="sg-fit-size-select"
                data-fit-size-select
                data-size-audience="men"
                aria-labelledby="sg-fit-size-heading"
              ></select>
            </div>
            <div class="sg-fit-size-chart-panel" data-size-chart="kids" data-size-audience="kids" hidden>
              <select
                id="sg-fit-size-select-kids"
                class="sg-fit-size-select"
                data-fit-size-select
                data-size-audience="kids"
                aria-labelledby="sg-fit-size-heading"
              ></select>
            </div>
            <div class="sg-fit-size-chart-panel" data-size-chart="baby" data-size-audience="baby" hidden>
              <select
                id="sg-fit-size-select-baby"
                class="sg-fit-size-select"
                data-fit-size-select
                data-size-audience="baby"
                aria-labelledby="sg-fit-size-heading"
              ></select>
            </div>
          </div>
          </div>
        </section>

        <section
          class="hat-form-section sg-selector-section sg-fit-placeholder-section sg-fit-preference-section is-locked"
          aria-labelledby="sg-fit-choice-heading"
          data-fit-preference-section
          data-selector-key="fitPreference"
        >
          <div class="sg-section-header" data-section-toggle role="button" tabindex="0" aria-expanded="false">
            <button type="button" class="sg-section-chevron-btn" data-section-chevron aria-label="Toggle Choose your fit section">▾</button>
            <div class="sg-section-header-main">
              <h2 id="sg-fit-choice-heading" class="hat-form-section__title hat-form-section__heading">8. Choose your fit</h2>
              <span class="sg-section-selected-check" data-selected-check aria-hidden="true">✓</span>
              <span class="sg-section-selected-value" data-selected-value></span>
            </div>
          </div>
          <div class="sg-section-options">
          <p class="sg-fit-placeholder-copy" data-fit-preference-helper-copy>Choose a size first.</p>
          <div class="hat-length-picker__grid sg-fit-preference-grid" role="radiogroup" aria-labelledby="sg-fit-choice-heading">
            <button type="button" class="hat-length-picker__option sg-fit-preference-option" data-fit-preference-option="close" aria-pressed="false">
              <img class="fit-card-image" src="/images/patterns/sleeveless/close-fit.png" alt="Close fit sleeveless garment" />
              <span class="hat-length-picker__option-label">Close fit</span>
              <span class="sg-fit-preference-note">Fits close to the body.</span>
              <span class="sg-fit-option-check" aria-hidden="true">✓</span>
            </button>
            <button type="button" class="hat-length-picker__option sg-fit-preference-option" data-fit-preference-option="standard" aria-pressed="false">
              <img class="fit-card-image" src="/images/patterns/sleeveless/standard-fit.png" alt="Standard fit sleeveless garment" />
              <span class="hat-length-picker__option-label">Standard fit</span>
              <span class="sg-fit-preference-note">Comfortable everyday fit</span>
              <span class="sg-fit-option-check" aria-hidden="true">✓</span>
            </button>
            <button type="button" class="hat-length-picker__option sg-fit-preference-option" data-fit-preference-option="relaxed" aria-pressed="false">
              <img class="fit-card-image" src="/images/patterns/sleeveless/relaxed-fit.png" alt="Relaxed fit sleeveless garment" />
              <span class="hat-length-picker__option-label">Relaxed fit</span>
              <span class="sg-fit-preference-note">More room and drape</span>
              <span class="sg-fit-option-check" aria-hidden="true">✓</span>
            </button>
          </div>
          </div>
        </section>

        <section
          id="fine-tune"
          class="hat-form-section sg-selector-section sg-fit-placeholder-section sg-fit-detail-section sg-fit-fine-tune-section is-locked"
          aria-labelledby="sg-fit-fine-tune-heading"
          data-fit-detail-section
          data-selector-key="fineTune"
        >
          <div class="sg-section-header" data-section-toggle role="button" tabindex="0" aria-expanded="false">
            <button type="button" class="sg-section-chevron-btn" data-section-chevron aria-label="Toggle Fine-tune the fit section">▾</button>
            <div class="sg-section-header-main">
              <h2 id="sg-fit-fine-tune-heading" class="hat-form-section__title hat-form-section__heading">9. Fine-tune the fit</h2>
              <span class="sg-section-selected-check" data-selected-check aria-hidden="true">✓</span>
              <span class="sg-section-selected-value" data-selected-value></span>
            </div>
          </div>
          <div class="sg-section-options">
          <p class="sg-fit-placeholder-copy" data-fit-detail-helper-copy>Choose a size first.</p>
          <div class="sg-fit-fine-tune-body" data-fit-fine-tune-body>
            <p class="sg-fit-size-copy sg-fit-fine-tune-lead" data-fit-fine-tune-lead>
              We've filled these in from the size and fit you selected. You can use them as-is, or adjust any measurement before
              building your pattern.
            </p>
            <p class="sg-fit-placeholder-copy sg-fit-fine-tune-reassurance">
              <strong> 👉 Not sure? Leave the numbers as they are. You can always come back and change them.</strong>
            </p>
            <div class="sg-fit-measurement-panel sg-fit-fine-tune-panel" data-fit-detail-panel>
              <div class="sg-fit-measurement-row">
                <div class="sg-fit-measurement-main">
                  <label class="sg-fit-measurement-name" for="sg-fit-m-finished_bust_chest">Finished bust/chest</label>
                </div>
                <div class="sg-fit-measurement-value-cell">
                  <input
                    id="sg-fit-m-finished_bust_chest"
                    class="sg-fit-measurement-input"
                    type="number"
                    step="0.25"
                    min="0"
                    inputmode="decimal"
                    data-fit-measurement-input
                    data-fit-measurement-key="finished_bust_chest"
                  />
                  <span class="sg-fit-measurement-unit" data-fit-measurement-unit aria-hidden="true"></span>
                </div>
              </div>
              <div class="sg-fit-measurement-row">
                <div class="sg-fit-measurement-main">
                  <label class="sg-fit-measurement-name" for="sg-fit-m-finished_waist">Finished waist</label>
                </div>
                <div class="sg-fit-measurement-value-cell">
                  <input
                    id="sg-fit-m-finished_waist"
                    class="sg-fit-measurement-input"
                    type="number"
                    step="0.25"
                    min="0"
                    inputmode="decimal"
                    data-fit-measurement-input
                    data-fit-measurement-key="finished_waist"
                  />
                  <span class="sg-fit-measurement-unit" data-fit-measurement-unit aria-hidden="true"></span>
                </div>
              </div>
              <div class="sg-fit-measurement-row">
                <div class="sg-fit-measurement-main">
                  <label class="sg-fit-measurement-name" for="sg-fit-m-finished_hip">Finished hip</label>
                </div>
                <div class="sg-fit-measurement-value-cell">
                  <input
                    id="sg-fit-m-finished_hip"
                    class="sg-fit-measurement-input"
                    type="number"
                    step="0.25"
                    min="0"
                    inputmode="decimal"
                    data-fit-measurement-input
                    data-fit-measurement-key="finished_hip"
                  />
                  <span class="sg-fit-measurement-unit" data-fit-measurement-unit aria-hidden="true"></span>
                </div>
              </div>
              <div class="sg-fit-measurement-row">
                <div class="sg-fit-measurement-main">
                  <label class="sg-fit-measurement-name" for="sg-fit-m-back_neck_to_hem">Back neck to hem</label>
                </div>
                <div class="sg-fit-measurement-value-cell">
                  <input
                    id="sg-fit-m-back_neck_to_hem"
                    class="sg-fit-measurement-input"
                    type="number"
                    step="0.25"
                    min="0"
                    inputmode="decimal"
                    data-fit-measurement-input
                    data-fit-measurement-key="back_neck_to_hem"
                  />
                  <span class="sg-fit-measurement-unit" data-fit-measurement-unit aria-hidden="true"></span>
                </div>
              </div>
              <div class="sg-fit-measurement-row">
                <div class="sg-fit-measurement-main">
                  <label class="sg-fit-measurement-name" for="sg-fit-m-armhole_depth">Armhole depth</label>
                </div>
                <div class="sg-fit-measurement-value-cell">
                  <input
                    id="sg-fit-m-armhole_depth"
                    class="sg-fit-measurement-input"
                    type="number"
                    step="0.25"
                    min="0"
                    inputmode="decimal"
                    data-fit-measurement-input
                    data-fit-measurement-key="armhole_depth"
                  />
                  <span class="sg-fit-measurement-unit" data-fit-measurement-unit aria-hidden="true"></span>
                </div>
              </div>
              <div class="sg-fit-measurement-row">
                <div class="sg-fit-measurement-main">
                  <label class="sg-fit-measurement-name" for="sg-fit-m-shoulder_width">Shoulder width</label>
                </div>
                <div class="sg-fit-measurement-value-cell">
                  <input
                    id="sg-fit-m-shoulder_width"
                    class="sg-fit-measurement-input"
                    type="number"
                    step="0.25"
                    min="0"
                    inputmode="decimal"
                    data-fit-measurement-input
                    data-fit-measurement-key="shoulder_width"
                  />
                  <span class="sg-fit-measurement-unit" data-fit-measurement-unit aria-hidden="true"></span>
                </div>
              </div>
              <div class="sg-fit-measurement-row">
                <div class="sg-fit-measurement-main">
                  <label class="sg-fit-measurement-name" for="sg-fit-m-neck_width">Neck width</label>
                </div>
                <div class="sg-fit-measurement-value-cell">
                  <input
                    id="sg-fit-m-neck_width"
                    class="sg-fit-measurement-input"
                    type="number"
                    step="0.25"
                    min="0"
                    inputmode="decimal"
                    data-fit-measurement-input
                    data-fit-measurement-key="neck_width"
                  />
                  <span class="sg-fit-measurement-unit" data-fit-measurement-unit aria-hidden="true"></span>
                </div>
              </div>
              <div class="sg-fit-measurement-row">
                <div class="sg-fit-measurement-main">
                  <label class="sg-fit-measurement-name" for="sg-fit-m-front_neck_depth">Front neck depth</label>
                </div>
                <div class="sg-fit-measurement-value-cell">
                  <input
                    id="sg-fit-m-front_neck_depth"
                    class="sg-fit-measurement-input"
                    type="number"
                    step="0.25"
                    min="0"
                    inputmode="decimal"
                    data-fit-measurement-input
                    data-fit-measurement-key="front_neck_depth"
                  />
                  <span class="sg-fit-measurement-unit" data-fit-measurement-unit aria-hidden="true"></span>
                </div>
              </div>
              <div class="sg-fit-measurement-row">
                <div class="sg-fit-measurement-main">
                  <label class="sg-fit-measurement-name" for="sg-fit-m-back_neck_depth">Back neck depth</label>
                </div>
                <div class="sg-fit-measurement-value-cell">
                  <input
                    id="sg-fit-m-back_neck_depth"
                    class="sg-fit-measurement-input"
                    type="number"
                    step="0.25"
                    min="0"
                    inputmode="decimal"
                    data-fit-measurement-input
                    data-fit-measurement-key="back_neck_depth"
                  />
                  <span class="sg-fit-measurement-unit" data-fit-measurement-unit aria-hidden="true"></span>
                </div>
              </div>
            </div>
            <div class="sg-fit-fine-tune-reset">
              <button type="button" class="kbm-btn kbm-btn-outline sg-fit-reset-btn" data-fit-measurements-reset>
                Reset to size defaults
              </button>
              <p class="sg-fit-reset-note">Resetting will replace your edited measurements with the defaults for the selected size and fit.</p>
            </div>
          </div>
          </div>
        </section>

        <section class="hat-form-section sg-fit-so-far-section" aria-labelledby="sg-fit-summary-heading">
          <div class="builder-summary">
            <h2 id="sg-fit-summary-heading" class="builder-summary-title hat-form-section__title hat-form-section__heading">
              <span class="sg-so-far-summary-heading__icon" aria-hidden="true">
                <svg
                  class="sg-so-far-summary-heading__svg"
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="4" x2="4" y1="21" y2="14"></line>
                  <line x1="4" x2="4" y1="10" y2="3"></line>
                  <line x1="12" x2="12" y1="21" y2="12"></line>
                  <line x1="12" x2="12" y1="8" y2="3"></line>
                  <line x1="20" x2="20" y1="21" y2="16"></line>
                  <line x1="20" x2="20" y1="12" y2="3"></line>
                  <line x1="2" x2="6" y1="14" y2="14"></line>
                  <line x1="10" x2="14" y1="8" y2="8"></line>
                  <line x1="18" x2="22" y1="16" y2="16"></line>
                </svg>
              </span>
              Fit Summary
            </h2>
            <div class="builder-summary-content">
              <div class="sg-summary-panel sg-fit-summary">
                <p class="sg-fit-size-copy" data-fit-summary-line="size">
                  <strong>Size:</strong>
                  <span data-fit-summary-size-value>—</span>
                </p>
                <p class="sg-fit-size-copy" data-fit-summary-line="ease">
                  <strong>Ease:</strong>
                  <span data-fit-summary-ease-value>—</span>
                </p>
                <p class="sg-fit-size-copy" data-fit-summary-line="adjustments">
                  <strong>Adjustments:</strong>
                  <span data-fit-summary-adjustments-value>—</span>
                </p>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div class="wizard-next-cta wizard-next-cta--split no-print">
        {embedded ? (
          <>
            <button type="button" class="kbm-btn kbm-btn-outline" data-sg-build-go="style">
              ← Back to Style &amp; Design
            </button>
            <button type="button" class="kbm-btn kbm-btn-accent" data-sg-build-go="yarn">
              10. Next: Yarn &amp; Gauge →
            </button>
          </>
        ) : (
          <>
            <a href="/patterns/sleeveless-garment" class="kbm-btn kbm-btn-outline">← Back to Style &amp; Design</a>
            <a href="/patterns/sleeveless-yarn-gauge" class="kbm-btn kbm-btn-accent">10. Next: Yarn &amp; Gauge →</a>
          </>
        )}
      </div>
      {!embedded && <SleevelessStartOver />}
</div>

<style>
  .sg-fit-page {
    --sg-accent: #c2614e;
  }

  .hat-builder-inputs .hat-form-section {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: color-mix(in srgb, var(--kbm-green, #52682d) 4.5%, var(--page-bg, #fff));
    border: 1px solid rgba(82, 104, 45, 0.09);
    border-radius: 12px;
    padding: 1.15rem 1.2rem 1.2rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 1px 2px rgba(45, 55, 30, 0.04);
  }

  @supports not (background: color-mix(in srgb, white, black)) {
    .hat-builder-inputs .hat-form-section {
      background: rgba(82, 104, 45, 0.045);
    }
  }

  .hat-builder-inputs .hat-form-section:last-of-type {
    margin-bottom: 0;
  }

  .hat-builder-inputs .hat-form-section__title,
  .hat-builder-inputs .hat-form-section__heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--kbm-green, #52682d);
    letter-spacing: 0.02em;
    line-height: 1.25;
    margin: 0 0 0.7rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(82, 104, 45, 0.14);
  }

  /* Match global wizard “bookend” summary cards (terracotta title, no green section divider). */
  .hat-builder-inputs .builder-summary .builder-summary-title.hat-form-section__title,
  .hat-builder-inputs .builder-summary .builder-summary-title.hat-form-section__heading {
    color: #c2614e;
    font-weight: 600;
    margin: 0;
    padding: 0;
    border-bottom: none;
  }

  .builder-summary .sg-fit-summary .sg-fit-size-copy:first-of-type {
    margin-top: 0;
  }

  .sg-section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
  }

  .sg-section-header-main {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
  }

  .sg-section-selected-check {
    color: var(--sg-accent);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1;
  }

  .sg-section-selected-value {
    font-size: 0.9rem;
    font-weight: 600;
    color: #4b5563;
    line-height: 1.2;
  }

  .sg-section-chevron-btn {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--sg-accent) 45%, #ffffff);
    background: #f7f9f3;
    color: var(--sg-accent);
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    border-radius: 6px;
    flex-shrink: 0;
    box-shadow: 0 1px 1px rgba(45, 55, 30, 0.06);
  }

  .sg-section-chevron-btn:hover {
    background: color-mix(in srgb, var(--sg-accent) 8%, #ffffff);
    border-color: color-mix(in srgb, var(--sg-accent) 62%, #ffffff);
  }

  @supports not (background: color-mix(in srgb, white, black)) {
    .sg-section-chevron-btn {
      border-color: rgba(194, 97, 78, 0.45);
    }

    .sg-section-chevron-btn:hover {
      background: rgba(194, 97, 78, 0.08);
      border-color: rgba(194, 97, 78, 0.62);
    }
  }

  .sg-selector-section .sg-section-selected-check {
    display: inline;
  }

  .sg-selector-section .sg-section-chevron-btn {
    transform: rotate(-90deg);
    transition: transform 0.15s ease;
  }

  .sg-selector-section.is-open .sg-section-chevron-btn {
    transform: rotate(0deg);
  }

  .sg-selector-section .sg-section-options {
    display: none;
  }

  .sg-selector-section.is-open .sg-section-options {
    display: block;
  }

  .sg-selector-section .hat-form-section__title,
  .sg-selector-section .hat-form-section__heading {
    margin: 0;
    padding-bottom: 0;
    border-bottom: 0;
  }

  .hat-length-picker__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .hat-length-picker__option {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 78px;
    gap: 0.3rem;
    margin: 0;
    border: 1px solid #ddd;
    border-radius: 10px;
    background: #fff;
