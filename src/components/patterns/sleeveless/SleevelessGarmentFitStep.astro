<script>
  // @ts-nocheck
  import {
    getCurrentPattern,
    saveCurrentPattern,
    updatePatternSection,
    notifyPatternSaved,
    getPatternData,
    savePatternData,
    getSleevelessChartAudience,
    getSleevelessChartAudienceLabel,
    normalizeSleevelessAudience,
    normalizeSleevelessAudienceV1,
    SLEEVELESS_CHART_AUDIENCE_LABELS,
    SLEEVELESS_CHART_INTRO,
  } from "../../../lib/patterns/patternStorage.ts";
  import {
    bodyMeasurementInchesToCmRounded,
    formatBodyMeasurementInchesForLabel,
    garmentCmTypedToInches,
    garmentFinishedInchesToCmDisplay,
    pickBodyBustChestCmFromRow,
  } from "../../../lib/patterns/sizingDisplay.ts";

  /** Same sweater chart JSON as /reference/sizing-charts (project root `data/`, served at /data/). */
  const SWEATER_CHART_URLS = {
    misses: "/data/sizing_sweaters_misses.json",
    plus: "/data/sizing_sweaters_plus.json",
    men: "/data/sizing_sweaters_men.json",
    kids: "/data/sizing_sweaters_kids.json",
    baby: "/data/sizing_sweaters_baby.json",
  };

  const CHART_AUDIENCES = ["misses", "plus", "men", "kids", "baby"];

  const CHART_INTRO = SLEEVELESS_CHART_INTRO;

  const AUDIENCE_LABELS = SLEEVELESS_CHART_AUDIENCE_LABELS;

  const FIT_PAGE_HEADER_INTRO_FALLBACK =
    "Pick a size from the sizing chart, then decide how closely the sweater should fit and fine-tune the numbers that matter.";

  function buildFitPageHeaderIntro(chartAudienceKey) {
    const v1 = normalizeSleevelessAudienceV1(chartAudienceKey);
    const frag = v1 ? getSleevelessChartAudienceLabel(v1) : "";
    if (!frag) return FIT_PAGE_HEADER_INTRO_FALLBACK;
    return `Pick a size from the ${frag} chart, then decide how closely the sweater should fit and fine-tune the numbers that matter.`;
  }

  function updateFitPageHeaderIntro(root) {
    const panel = root?.closest(".sg-fit-page");
    const el = panel?.querySelector("[data-sg-fit-page-intro]");
    if (!el) return;
    const p = getCurrentPattern();
    const patternData = getPatternData();
    const st = { ...(p.style || {}), ...(patternData.style || {}) };
    const ft = { ...(p.fit || {}), ...(patternData.fit || {}) };
    const chartKeyRaw = getSleevelessChartAudience({ ...p, style: st, fit: ft });
    const chartKey = normalizeSleevelessAudienceV1(chartKeyRaw);
    el.textContent = buildFitPageHeaderIntro(chartKey);
  }

  const FIT_EASE_LABELS = {
    close: "Close fit",
    standard: "Standard fit",
    relaxed: "Relaxed fit",
  };

  /** Filled after fetch: each key is a chart id → Set of `String(row.size)` from JSON. */
  const chartSizeSets = {};

  /** Full chart rows per audience for default measurements. */
  const chartRowsByAudience = {};

  const MEASUREMENT_KEYS = [
    "finished_bust_chest",
    "finished_waist",
    "finished_hip",
    "back_neck_to_hem",
    "armhole_depth",
    "shoulder_width",
    "neck_width",
    "front_neck_depth",
    "back_neck_depth",
  ];

  const MEASUREMENT_LABELS = {
    finished_bust_chest: "Finished bust/chest",
    finished_waist: "Finished waist",
    finished_hip: "Finished hip",
    back_neck_to_hem: "Back neck to hem",
    armhole_depth: "Armhole depth",
    shoulder_width: "Shoulder width",
    neck_width: "Neck width",
    front_neck_depth: "Front neck depth",
    back_neck_depth: "Back neck depth",
  };

  /** Circumference ease added to body bust and waist for finished garment inches by fit choice. (Hip defaults do not use chart hip — see `computeDefaultMeasurementsFromRow`.) */
  const EASE_INCHES_BY_FIT = {
    close: 1,
    standard: 3,
    relaxed: 6,
  };

  const fitConfig = {
    knitFor: "",
    size: "",
    fitPreference: "",
    shape: "straight",
    length: "hip",
    frontStyle: "closed",
    neckline: "round",
  };

  /** Snapshot of chart + ease defaults for the current size/fit (fine-tune “edited” styling). */
  let defaultMeasurements = null;

  /**
   * Canonical fine-tune measurements in inches only — always derived from chart defaults + saved `selectedMeasurements`
   * (never from displayed DOM). Inputs reflect this + active unit; toggling units reformats from here only.
   * @type {Record<string, number | ""> | null}
   */
  let fineTuneInchesCanonical = null;

  /** Skip size `<select>` side effects while syncing labels during unit toggle (prevents mis-parsing cm as inches). */
  let suppressFitSizeChartChange = false;

  function emptyFineTuneCanonical() {
    /** @type {Record<string, number | "">} */
    const o = {};
    MEASUREMENT_KEYS.forEach((k) => {
      o[k] = "";
    });
    return o;
  }

  function ensureFineTuneCanonical() {
    if (!fineTuneInchesCanonical) fineTuneInchesCanonical = emptyFineTuneCanonical();
  }

  /** Replace canonical inch map from a merged/hydrated object (values already in inches). */
  function hydrateFineTuneCanonicalFromInchObject(obj) {
    fineTuneInchesCanonical = emptyFineTuneCanonical();
    MEASUREMENT_KEYS.forEach((k) => {
      const n = toFiniteNumber(obj[k]);
      fineTuneInchesCanonical[k] = Number.isFinite(n) && n > 0 ? roundQuarter(n) : "";
    });
  }

  /** Persist / summary / edited-state: inch snapshot only (never read from input elements). */
  function snapshotFineTuneInches() {
    if (!fineTuneInchesCanonical) {
      return emptyFineTuneCanonical();
    }
    const out = {};
    MEASUREMENT_KEYS.forEach((k) => {
      const raw = fineTuneInchesCanonical[k];
      if (raw === "" || raw === undefined || raw === null) {
        out[k] = "";
      } else {
        const n = toFiniteNumber(raw);
        out[k] = Number.isFinite(n) ? roundQuarter(n) : "";
      }
    });
    return out;
  }

  /** Write one field from the current display unit into canonical inches (used on input). */
  function applyFineTuneCanonicalFromField(key, displayValue, displayUnit) {
    ensureFineTuneCanonical();
    const inches = inchesFromFineTuneInputText(displayValue, displayUnit);
    if (!Number.isFinite(inches) || inches <= 0) {
      fineTuneInchesCanonical[key] = "";
    } else {
      fineTuneInchesCanonical[key] = roundQuarter(inches);
    }
  }

  function syncFineTuneInputsFromCanonical(root) {
    ensureFineTuneCanonical();
    setMeasurementInputs(root, fineTuneInchesCanonical);
  }

  function isFitSelectorKey(k) {
    return k === "size" || k === "fitPreference" || k === "fineTune";
  }

  function getFitSelectorSections(root) {
    return Array.from(root.querySelectorAll(".sg-selector-section[data-selector-key]"));
  }

  function setOpenFitSection(root, selectorKey) {
    getFitSelectorSections(root).forEach((section) => {
      const isOpen = selectorKey !== null && section.getAttribute("data-selector-key") === selectorKey;
      section.classList.toggle("is-open", isOpen);
      const headerToggle = section.querySelector("[data-section-toggle]");
      const chevronBtn = section.querySelector("[data-section-chevron]");
      if (headerToggle) {
        headerToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
      }
      if (chevronBtn) {
        chevronBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
      }
    });
  }

  function toggleFitSection(root, selectorKey) {
    const currentOpen = getFitSelectorSections(root).find((section) => section.classList.contains("is-open"));
    const currentOpenKey = currentOpen?.getAttribute("data-selector-key");
    if (currentOpenKey === selectorKey) {
      setOpenFitSection(root, null);
      return;
    }
    setOpenFitSection(root, selectorKey);
  }

  function getDefaultOpenFitSectionKey(root) {
    if (!normalizeSleevelessAudienceV1(fitConfig.knitFor)) return "size";
    if (!hasChosenSize()) return "size";
    if (!fitConfig.fitPreference) return "fitPreference";
    return "fineTune";
  }

  function bindFitAccordion(root) {
    root.querySelectorAll("[data-section-toggle]").forEach((header) => {
      const onToggle = () => {
        const section = header.closest(".sg-selector-section");
        const rawKey = section?.getAttribute("data-selector-key");
        const key = isFitSelectorKey(rawKey) ? rawKey : null;
        if (key) toggleFitSection(root, key);
      };
      header.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("[data-section-chevron]")) return;
        onToggle();
      });
      header.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          onToggle();
        }
      });
    });

    root.querySelectorAll("[data-section-chevron]").forEach((btn) => {
      btn.addEventListener("click", (event) => {
        event.stopPropagation();
        const section = btn.closest(".sg-selector-section");
        const rawKey = section?.getAttribute("data-selector-key");
        const key = isFitSelectorKey(rawKey) ? rawKey : null;
        if (key) toggleFitSection(root, key);
      });
    });
  }

  function syncFitHeaderSummaries(root) {
    getFitSelectorSections(root).forEach((section) => {
      const rawKey = section.getAttribute("data-selector-key");
      const key = isFitSelectorKey(rawKey) ? rawKey : null;
      if (!key) return;
      const valueSpan = section.querySelector("[data-selected-value]");
      const checkmark = section.querySelector("[data-selected-check]");
      if (!valueSpan) return;

      let resolved = "";
      if (key === "size") {
        if (hasChosenSize()) {
          const audLabel = AUDIENCE_LABELS[fitConfig.knitFor] ?? fitConfig.knitFor;
          const row = findChartRow(fitConfig.knitFor, fitConfig.size);
          const uiUnit = getCurrentUiUnit();
          if (row) {
            resolved = `${audLabel} — ${buildSizeOptionLabelText(row, fitConfig.knitFor, uiUnit)}`;
          } else {
            resolved = `${audLabel} — ${fitConfig.size}`;
          }
        }
      } else if (key === "fitPreference") {
        resolved =
          fitConfig.fitPreference && FIT_EASE_LABELS[fitConfig.fitPreference]
            ? FIT_EASE_LABELS[fitConfig.fitPreference]
            : "";
      } else if (key === "fineTune") {
        const detail = root.querySelector("[data-fit-detail-section]");
        const unlocked = detail && !detail.classList.contains("is-locked");
        if (unlocked && hasChosenSize() && fitConfig.fitPreference) {
          const adj = formatAdjustmentsSummary(root);
          if (adj && adj !== "—") {
            resolved = adj.length > 80 ? `${adj.slice(0, 77)}…` : adj;
          }
        }
      }

      valueSpan.textContent = resolved;
      if (checkmark) {
        checkmark.style.display = resolved ? "inline" : "none";
      }
    });
  }

  function normalizeRowSize(row) {
    if (!row || row.size === undefined || row.size === null) return "";
    return String(row.size);
  }

  /**
   * UI unit from UnitToggle (`#unit`) or kbm-units — display only; internal math stays in inches.
   * @returns {'in' | 'cm'}
   */
  function getCurrentUiUnit() {
    const hidden = document.getElementById("unit");
    if (hidden instanceof HTMLInputElement && (hidden.value === "in" || hidden.value === "cm")) {
      return hidden.value;
    }
    try {
      const u = localStorage.getItem("kbm-units");
      if (u === "in" || u === "cm") return u;
    } catch {
      /* ignore */
    }
    return "in";
  }

  /** Pattern math + `selectedMeasurements` stay in inches; convert at UI boundary only (see `sizingDisplay` INCH_TO_CM). */

  /**
   * Parse a fine-tune field value into stored inches, given how the input text was shown.
   * @param {'in' | 'cm'} inputUnit Unit the user was typing in (not necessarily `getCurrentUiUnit()` during toggles).
   */
  function inchesFromFineTuneInputText(raw, inputUnit) {
    const n = typeof raw === "number" ? raw : parseFloat(String(raw).trim());
    if (!Number.isFinite(n) || n <= 0) return NaN;
    if (inputUnit === "cm") {
      return roundQuarter(garmentCmTypedToInches(n));
    }
    return roundQuarter(n);
  }

  /** Format stored inches for the measurement inputs for the active display unit. */
  function formatInchesForFineTuneInput(inches, displayUnit) {
    if (!Number.isFinite(inches) || inches <= 0) return "";
    if (displayUnit === "cm") {
      const cm = garmentFinishedInchesToCmDisplay(inches);
      return cm % 1 === 0 ? String(Math.round(cm)) : cm.toFixed(1);
    }
    return String(roundQuarter(inches));
  }

  /** Summary / accordion text for one stored inch value in the current UI unit. */
  function formatFineTuneSummaryFragment(inches, uiUnit) {
    if (!Number.isFinite(inches) || inches <= 0) return "";
    if (uiUnit === "cm") {
      const cm = garmentFinishedInchesToCmDisplay(inches);
      const s = cm % 1 === 0 ? String(Math.round(cm)) : cm.toFixed(1);
      return `${s} cm`;
    }
    const q = roundQuarter(inches);
    const s = q % 1 === 0 ? String(q) : String(q);
    return `${s}"`;
  }

  function updateFineTuneMetricChrome(root) {
    const ui = getCurrentUiUnit();
    root.querySelectorAll("[data-fit-measurement-unit]").forEach((el) => {
      el.textContent = ui === "cm" ? "cm" : '"';
    });
    root.querySelectorAll("[data-fit-measurement-input]").forEach((input) => {
      if (ui === "cm") {
        input.setAttribute("step", "0.1");
      } else {
        input.setAttribute("step", "0.25");
      }
    });
  }

  /** Dropdown / summary label — Women's/Plus Size charts use Bust; others use Chest. */
  function buildSizeOptionLabelText(row, audience, uiUnit) {
    const key = normalizeRowSize(row);
    const measureWord = audience === "misses" || audience === "plus" ? "Bust" : "Chest";
    const rowObj = row && typeof row === "object" ? /** @type {Record<string, unknown>} */ (row) : {};

    if (uiUnit === "cm") {
      let cm = pickBodyBustChestCmFromRow(rowObj);
      if (cm === null) {
        const inches = toFiniteNumber(row.bust_or_chest);
        cm = Number.isFinite(inches) ? bodyMeasurementInchesToCmRounded(inches) : null;
      }
      if (cm === null) return `Size ${key}`;
      return `Size ${key} — ${measureWord}: ${cm} cm (body measurement)`;
    }

    const inches = toFiniteNumber(row.bust_or_chest);
    if (!Number.isFinite(inches)) return `Size ${key}`;
    const inchStr = formatBodyMeasurementInchesForLabel(inches);
    return `Size ${key} — ${measureWord}: ${inchStr}" (body measurement)`;
  }

  function populateAudienceSizeSelect(root, aud, uiUnit) {
    const list = chartRowsByAudience[aud];
    const chartEl = root.querySelector(`[data-size-chart="${aud}"]`);
    const selectEl = chartEl?.querySelector("[data-fit-size-select]");
    if (!selectEl || !Array.isArray(list)) return;
    const prev = selectEl.value;
    const optionsHtml =
      `<option value="">${escapeHtml("Select a size…")}</option>` +
      list
        .map((row) => {
          const key = normalizeRowSize(row);
          const labelText = buildSizeOptionLabelText(row, aud, uiUnit);
          return `<option value="${escapeAttr(key)}">${escapeHtml(labelText)}</option>`;
        })
        .join("");
    selectEl.innerHTML = optionsHtml;
    if (prev && chartSizeSets[aud]?.has(prev)) {
      selectEl.value = prev;
    }
  }

  function rebuildSizeDropdownLabels(root, uiUnit) {
    CHART_AUDIENCES.forEach((aud) => populateAudienceSizeSelect(root, aud, uiUnit));
    syncSizeSelection(root);
  }

  function escapeAttr(s) {
    return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
  }

  function escapeHtml(s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function isValidSizeForAudience(audience, size) {
    if (!audience || size === undefined || size === null || size === "") return false;
    const set = chartSizeSets[audience];
    return set instanceof Set && set.has(String(size));
  }

  function hasChosenSize() {
    return isValidSizeForAudience(fitConfig.knitFor, fitConfig.size);
  }

  async function loadSweaterCharts(root) {
    const statusEl = root.querySelector("[data-size-charts-status]");
    try {
      await Promise.all(
        CHART_AUDIENCES.map(async (aud) => {
          const url = SWEATER_CHART_URLS[aud];
          const res = await fetch(url);
          if (!res.ok) throw new Error(`${aud}: ${res.status}`);
          const rows = await res.json();
          const list = Array.isArray(rows) ? rows : [];
          chartSizeSets[aud] = new Set();
          chartRowsByAudience[aud] = list;
          list.forEach((row) => {
            const k = normalizeRowSize(row);
            if (k) chartSizeSets[aud].add(k);
          });
        }),
      );
      const uiUnit = getCurrentUiUnit();
      CHART_AUDIENCES.forEach((aud) => populateAudienceSizeSelect(root, aud, uiUnit));
      if (statusEl) statusEl.style.display = "none";
    } catch (err) {
      console.error("Sweater chart load failed", err);
      if (statusEl) {
        statusEl.textContent = "Could not load size charts. Check your connection and refresh.";
        statusEl.style.color = "#b91c1c";
      }
    }
  }

  function setSaveStatusMessage(message) {
    const el = document.querySelector("[data-pattern-save-status]");
    if (el) el.textContent = message ?? "";
  }

  function toFiniteNumber(val) {
    if (val === undefined || val === null || val === "") return NaN;
    const n = typeof val === "number" ? val : parseFloat(String(val));
    return Number.isFinite(n) ? n : NaN;
  }

  function roundQuarter(n) {
    if (!Number.isFinite(n)) return 0;
    return Math.round(n * 4) / 4;
  }

  function easeInchesForFit(fitPreference) {
    const e = EASE_INCHES_BY_FIT[fitPreference];
    return typeof e === "number" ? e : EASE_INCHES_BY_FIT.standard;
  }

  /**
   * Defaults from the sizing chart row + fit ease.
   * Finished hip is never taken from sizing JSON `hip`: it matches finished bust/chest so ease is not applied
   * twice to the body, and straight sweaters stay cylindrical until the user changes fine-tune. For A-line,
   * widening hip is an explicit edit — chart hip is never applied automatically.
   */
  function computeDefaultMeasurementsFromRow(row, fitPreference) {
    const ease = easeInchesForFit(fitPreference);
    const bust = toFiniteNumber(row.bust_or_chest);
    const waist = toFiniteNumber(row.waist);
    const finishedBustChest = roundQuarter(bust + ease);
    return {
      finished_bust_chest: finishedBustChest,
      finished_waist: roundQuarter(waist + ease),
      finished_hip: finishedBustChest,
      back_neck_to_hem: roundQuarter(toFiniteNumber(row.garment_back_length)),
      armhole_depth: roundQuarter(toFiniteNumber(row.armhole_depth)),
      shoulder_width: roundQuarter(toFiniteNumber(row.shoulder_width)),
      neck_width: roundQuarter(toFiniteNumber(row.neck_opening)),
      front_neck_depth: roundQuarter(toFiniteNumber(row.front_neck_depth)),
      back_neck_depth: roundQuarter(toFiniteNumber(row.back_neck_depth)),
    };
  }

  function findChartRow(audience, sizeStr) {
    const list = chartRowsByAudience[audience];
    if (!Array.isArray(list)) return null;
    const key = String(sizeStr);
    return list.find((row) => normalizeRowSize(row) === key) ?? null;
  }

  /** Default inch values for the current chart row + ease (for “edited vs default” in Fit Summary). */
  function getDefaultMeasurementsForSummary() {
    const row = findChartRow(fitConfig.knitFor, fitConfig.size);
    if (!row || !fitConfig.fitPreference) return null;
    return computeDefaultMeasurementsFromRow(row, fitConfig.fitPreference);
  }

  /**
   * Fine-tune measurements for persist/summary — always the canonical inch map (never parsed from DOM).
   * @deprecated Parameters ignored; kept for call-site compatibility.
   */
  function collectMeasurementSnapshot(_root, _inputUnit = null) {
    void _root;
    void _inputUnit;
    return snapshotFineTuneInches();
  }

  function clearMeasurementInputs(root) {
    root.querySelectorAll("[data-fit-measurement-input]").forEach((input) => {
      input.value = "";
    });
  }

  function setMeasurementInputs(root, values) {
    const displayUnit = getCurrentUiUnit();
    root.querySelectorAll("[data-fit-measurement-input]").forEach((input) => {
      const key = input.getAttribute("data-fit-measurement-key");
      if (!key) return;
      if (!values || values[key] === undefined || values[key] === null) {
        input.value = "";
        return;
      }
      const n = toFiniteNumber(values[key]);
      input.value = Number.isFinite(n) ? formatInchesForFineTuneInput(n, displayUnit) : "";
    });
  }

  function applyDefaultMeasurements(root) {
    const row = findChartRow(fitConfig.knitFor, fitConfig.size);
    if (!row || !fitConfig.fitPreference) return;
    const defs = computeDefaultMeasurementsFromRow(row, fitConfig.fitPreference);
    defaultMeasurements = { ...defs };
    hydrateFineTuneCanonicalFromInchObject(defs);
    syncFineTuneInputsFromCanonical(root);
    updateFineTuneEditedClasses(root);
  }

  /**
   * Older sessions could save bogus “inch” values after cm/in parsing raced with chart rebuild (~200+).
   * Heuristic repair only when clearly out of garment scale (whole-inch sizing charts stay under ~90).
   */
  function repairLegacyMisstoredFineTuneInches(n) {
    if (!Number.isFinite(n) || n <= 90) return n;
    const by254 = n / 25.4;
    if (n >= 200 && by254 >= 8 && by254 <= 90) return by254;
    const by10 = n / 10;
    if (by10 >= 8 && by10 <= 90) return by10;
    return n;
  }

  function mergeMeasurements(into, from) {
    if (!from || typeof from !== "object") return into;
    MEASUREMENT_KEYS.forEach((k) => {
      const n = toFiniteNumber(from[k]);
      if (Number.isFinite(n) && n > 0) into[k] = roundQuarter(repairLegacyMisstoredFineTuneInches(n));
    });
    return into;
  }

  function hydrateFineTuneMeasurements(root) {
    const patternData = getPatternData();
    const saved = patternData.fit?.selectedMeasurements;
    const merged = {};
    mergeMeasurements(merged, saved);

    const hasAnySaved = MEASUREMENT_KEYS.some((k) => merged[k] !== undefined);

    if (hasChosenSize() && fitConfig.fitPreference) {
      const row = findChartRow(fitConfig.knitFor, fitConfig.size);
      if (row) {
        const defs = computeDefaultMeasurementsFromRow(row, fitConfig.fitPreference);
        MEASUREMENT_KEYS.forEach((k) => {
          if (merged[k] === undefined) merged[k] = defs[k];
        });
      }
    }

    if (!hasAnySaved && !(hasChosenSize() && fitConfig.fitPreference)) {
      fineTuneInchesCanonical = null;
      clearMeasurementInputs(root);
      return;
    }

    syncDefaultMeasurementsSnapshot();
    hydrateFineTuneCanonicalFromInchObject(merged);
    syncFineTuneInputsFromCanonical(root);
    updateFineTuneEditedClasses(root);
  }

  function hydrateFromPattern() {
    const patternData = getPatternData();
    const styleData = patternData.style || {};
    const fitData = patternData.fit || {};
    const p = getCurrentPattern();
    const st = { ...(p.style || {}), ...styleData };
    const ft = { ...(p.fit || {}), ...fitData };

    fitConfig.shape = "straight";
    fitConfig.length = "hip";
    fitConfig.frontStyle = "closed";
    fitConfig.neckline = "round";

    const chartKeyRaw = getSleevelessChartAudience({ ...p, style: st, fit: ft });
    const chartKey = normalizeSleevelessAudienceV1(chartKeyRaw);
    if (chartKey) {
      fitConfig.knitFor = chartKey;
    }

    if (normalizeSleevelessAudience(chartKeyRaw) === "plus") {
      saveCurrentPattern({
        style: {
          recipientCategory: "misses",
          bodyShape: "straight",
          length: "hip",
          frontStyle: "closed",
          neckline: "round",
          armholeStyle: "standard",
        },
        fit: { sizingChart: "misses" },
      });
    }

    if (typeof ft.selectedSize === "string" && ft.selectedSize !== "") {
      fitConfig.size = ft.selectedSize;
    }

    const ease = ft.easeChoice ?? ft.fitChoice;
    if (ease === "close" || ease === "standard" || ease === "relaxed") {
      fitConfig.fitPreference = ease;
    }

    if (import.meta.env.DEV) {
      console.info(
        "[sleeveless-fit] loaded recipientCategory=",
        st.recipientCategory,
        "chartKey=",
        chartKey,
        "selectedSize=",
        ft.selectedSize,
      );
    }
  }

  function persistFitConfig(root, { silent } = {}) {
    const fitPayload = {
      sizingChart: fitConfig.knitFor,
      selectedSize: fitConfig.size,
      easeChoice: fitConfig.fitPreference,
      fitChoice: fitConfig.fitPreference,
      fineTuneAdjustments: {
        summaryLine: formatAdjustmentsSummary(root),
      },
      selectedMeasurements: collectMeasurementSnapshot(root),
    };
    updatePatternSection("fit", fitPayload);
    savePatternData("fit", fitPayload);
    if (!silent) notifyPatternSaved(setSaveStatusMessage);
    if (import.meta.env.DEV && !silent) {
      console.info("[sleeveless-fit] saved selectedSize=", fitConfig.size, "sizingChart=", fitConfig.knitFor);
    }
  }

  /** Design-only recap — matches sleeveless garment V1 summary. */
  function buildDesignSummarySentence() {
    return "straight sleeveless pullover with a round neckline";
  }

  /** Short chart title from CHART_INTRO (text before " — "), e.g. "Men's sweater chart". */
  function chartIntroShortLabel(audienceKey) {
    const intro = audienceKey && CHART_INTRO[audienceKey];
    if (!intro) return "";
    return intro.split(" — ")[0]?.trim() ?? "";
  }

  /** Possessive / group label for "So Far" sentence, from chart title before " sweater chart". */
  function audienceSummaryPrefix(audienceKey) {
    const short = chartIntroShortLabel(audienceKey);
    if (!short) return "";
    const needle = " sweater chart";
    const idx = short.toLowerCase().indexOf(needle);
    if (idx === -1) return short.trim();
    return short.slice(0, idx).trim();
  }

  /** Style recap plus sizing group in one sentence when a chart audience is selected. */
  function buildSoFarSummarySentence() {
    const design = buildDesignSummarySentence();
    const aud = normalizeSleevelessAudienceV1(fitConfig.knitFor);
    if (!aud || !AUDIENCE_LABELS[aud]) return design;
    return `${AUDIENCE_LABELS[aud]} ${design}`;
  }

  function isEditedValue(key, selectedMeasurements, defaultMeasurements) {
    if (!defaultMeasurements) return false;
    const raw = selectedMeasurements[key];
    if (raw === "" || raw === undefined || raw === null) return false;
    const selected = Number(raw);
    const def = Number(defaultMeasurements[key]);
    if (!Number.isFinite(selected) || !Number.isFinite(def)) return false;
    return Math.abs(selected - def) > 0.01;
  }

  function updateFineTuneEditedClasses(root) {
    const snap = snapshotFineTuneInches();
    const defs = defaultMeasurements;
    root.querySelectorAll("[data-fit-measurement-input]").forEach((input) => {
      const key = input.getAttribute("data-fit-measurement-key");
      if (!key) return;
      const edited = isEditedValue(key, snap, defs);
      input.classList.toggle("sg-fit-edited", edited);
    });
  }

  function syncDefaultMeasurementsSnapshot() {
    const d = getDefaultMeasurementsForSummary();
    defaultMeasurements = d ? { ...d } : null;
  }

  /**
   * @param {{ asHtml?: boolean }} [options]
   * Plain text for storage and section headers; HTML only for Fit Summary adjustments line.
   */
  function formatAdjustmentsSummary(root, options = {}) {
    void root;
    const asHtml = options.asHtml === true;
    const snap = snapshotFineTuneInches();
    const defaultMeasurements = getDefaultMeasurementsForSummary();
    const uiUnit = getCurrentUiUnit();
    const parts = [];
    MEASUREMENT_KEYS.forEach((key) => {
      const raw = snap[key];
      const n = typeof raw === "number" ? raw : parseFloat(String(raw));
      if (!Number.isFinite(n) || n <= 0) return;
      const label = MEASUREMENT_LABELS[key] ?? key;
      const fragment = formatFineTuneSummaryFragment(n, uiUnit);
      if (!fragment) return;
      if (asHtml) {
        const edited = isEditedValue(key, snap, defaultMeasurements);
        const valuePart = edited ? `<span class="sg-fit-edited">${fragment}</span>` : fragment;
        parts.push(`${label}: ${valuePart}`);
      } else {
        parts.push(`${label}: ${fragment}`);
      }
    });
    return parts.length ? parts.join("; ") : "—";
  }

  /** Intro copy inside Fine-tune: reflects chart row, ease for current fit, and example bust (respects active unit). */
  function updateFineTuneLead(root) {
    const el = root.querySelector("[data-fit-fine-tune-lead]");
    if (!el) return;
    const fallback =
      "We've filled these in from the size and fit you selected. You can use them as-is, or adjust any measurement before building your pattern.";
    if (!hasChosenSize() || !fitConfig.fitPreference) {
      el.textContent = fallback;
      return;
    }
    const row = findChartRow(fitConfig.knitFor, fitConfig.size);
    if (!row) {
      el.textContent = fallback;
      return;
    }
    const uiUnit = getCurrentUiUnit();
    const easeIn = easeInchesForFit(fitConfig.fitPreference);
    const defs = computeDefaultMeasurementsFromRow(row, fitConfig.fitPreference);
    const bodyBust = toFiniteNumber(row.bust_or_chest);
    const finishedBust = toFiniteNumber(defs?.finished_bust_chest);
    const fitLabel = FIT_EASE_LABELS[fitConfig.fitPreference] ?? fitConfig.fitPreference;
    const measureWord = fitConfig.knitFor === "misses" || fitConfig.knitFor === "plus" ? "Bust" : "Chest";
    const easeFrag =
      uiUnit === "cm"
        ? `${garmentFinishedInchesToCmDisplay(easeIn)} cm`
        : `${easeIn}"`;
    const bodyFrag =
      Number.isFinite(bodyBust) && bodyBust > 0 ? formatFineTuneSummaryFragment(bodyBust, uiUnit) : "—";
    const finishedFrag =
      Number.isFinite(finishedBust) && finishedBust > 0 ? formatFineTuneSummaryFragment(finishedBust, uiUnit) : "—";
    const shape = fitConfig.shape === "aline" ? "aline" : "straight";
    const hipSentence =
      shape === "aline"
        ? ` Finished hip starts the same as finished bust/chest — increase it below if you want more room at the hem (sizing-chart hip is not applied automatically).`
        : ` Finished hip matches finished bust/chest for a straight body (sizing-chart hip is not used).`;
    el.textContent = `These defaults use ${fitLabel}: add ${easeFrag} ease to bust and waist from your chart row (${measureWord} ${bodyFrag} → finished bust/chest ${finishedFrag}).${hipSentence} Other lengths and openings follow the chart. Adjust any value below.`;
  }

  function renderFitSummary(root) {
    const sizeVal = root.querySelector("[data-fit-summary-size-value]");
    const easeVal = root.querySelector("[data-fit-summary-ease-value]");
    const adjVal = root.querySelector("[data-fit-summary-adjustments-value]");
    if (!sizeVal || !easeVal || !adjVal) return;

    if (hasChosenSize()) {
      const audLabel = AUDIENCE_LABELS[fitConfig.knitFor] ?? fitConfig.knitFor;
      const row = findChartRow(fitConfig.knitFor, fitConfig.size);
      const uiUnit = getCurrentUiUnit();
      if (row) {
        sizeVal.textContent = `${audLabel} — ${buildSizeOptionLabelText(row, fitConfig.knitFor, uiUnit)}`;
      } else {
        sizeVal.textContent = `${audLabel} — ${fitConfig.size}`;
      }
    } else {
      sizeVal.textContent = "—";
    }

    easeVal.textContent =
      fitConfig.fitPreference && FIT_EASE_LABELS[fitConfig.fitPreference]
        ? FIT_EASE_LABELS[fitConfig.fitPreference]
        : "—";

    const selectedMeasurements = snapshotFineTuneInches();
    const defaultMeasurements = getDefaultMeasurementsForSummary();
    const adjPlain = formatAdjustmentsSummary(root);
    const adjustmentsHtml = adjPlain === "—" ? "" : formatAdjustmentsSummary(root, { asHtml: true });

    if (import.meta.env.DEV) {
      console.log("Fit summary selectedMeasurements", selectedMeasurements);
      console.log("Fit summary defaultMeasurements", defaultMeasurements);
      console.log("Fit summary html", adjustmentsHtml);
    }

    if (adjPlain === "—") {
      adjVal.textContent = "—";
    } else {
      adjVal.innerHTML = adjustmentsHtml;
    }
    updateFineTuneLead(root);
    syncFitHeaderSummaries(root);
  }

  function syncSizeSelection(root) {
    root.querySelectorAll("[data-fit-size-select]").forEach((sel) => {
      const aud = sel.getAttribute("data-size-audience");
      if (aud === fitConfig.knitFor) {
        const ok = fitConfig.size && isValidSizeForAudience(aud, fitConfig.size);
        sel.value = ok ? fitConfig.size : "";
      } else {
        sel.value = "";
      }
    });
  }

  function updateVisibleSizeChart(root) {
    const labelEl = root.querySelector("[data-size-chart-label]");
    root.querySelectorAll(".sg-fit-size-charts > [data-size-chart]").forEach((chart) => {
      if (chart.hasAttribute("data-sg-v1-hidden")) {
        chart.setAttribute("hidden", "");
        chart.setAttribute("aria-hidden", "true");
        return;
      }
      const aud = chart.getAttribute("data-size-audience");
      const show = Boolean(fitConfig.knitFor && aud === fitConfig.knitFor);
      chart.toggleAttribute("hidden", !show);
      chart.setAttribute("aria-hidden", show ? "false" : "true");
    });
    if (labelEl) {
      if (fitConfig.knitFor && CHART_INTRO[fitConfig.knitFor]) {
        labelEl.textContent = CHART_INTRO[fitConfig.knitFor];
        labelEl.removeAttribute("hidden");
      } else {
        labelEl.textContent = "";
        labelEl.setAttribute("hidden", "");
      }
    }
  }

  function updateSizeSectionState(root) {
    const section = root.querySelector("[data-size-section]");
    const copy = root.querySelector("[data-size-helper-copy]");
    if (!section || !copy) return;
    const hasAudience = Boolean(normalizeSleevelessAudienceV1(fitConfig.knitFor));
    section.classList.toggle("is-locked", !hasAudience);
    copy.textContent = hasAudience
      ? "Pick the size from the chart for this group. Fit type (close / standard / relaxed) comes next."
      : "Go back to the design page to choose Women's, Men's, Kids', or Baby.";
    const bodyHint = root.querySelector("[data-size-body-measurement-hint]");
    if (bodyHint) bodyHint.toggleAttribute("hidden", !hasAudience);
    root.querySelectorAll("[data-fit-size-select]").forEach((sel) => {
      sel.disabled = !hasAudience;
    });
    updateVisibleSizeChart(root);
  }

  function updateFitDetailSectionState(root) {
    const section = root.querySelector("[data-fit-detail-section]");
    const copy = root.querySelector("[data-fit-detail-helper-copy]");
    if (!section || !copy) return;
    const hasSize = hasChosenSize();
    section.classList.toggle("is-locked", !hasSize);
    if (!hasSize) {
      copy.textContent = "Choose a size first.";
      copy.removeAttribute("hidden");
    } else {
      copy.setAttribute("hidden", "");
    }
  }

  function syncFitPreferenceSelection(root) {
    root.querySelectorAll("[data-fit-preference-option]").forEach((btn) => {
      const v = btn.getAttribute("data-fit-preference-option");
      const on = v === fitConfig.fitPreference;
      btn.classList.toggle("is-selected", on);
      btn.setAttribute("aria-pressed", on ? "true" : "false");
    });
  }

  function updateFitPreferenceSectionState(root) {
    const section = root.querySelector("[data-fit-preference-section]");
    const copy = root.querySelector("[data-fit-preference-helper-copy]");
    if (!section || !copy) return;
    const hasSize = hasChosenSize();
    section.classList.toggle("is-locked", !hasSize);
    copy.textContent = hasSize
      ? "Ease is the extra room added to your body measurement so the garment feels comfortable."
      : "Choose a size first.";
  }

  function renderSoFarSentence(root) {
    const sentenceEl = root.querySelector("#garment-config-so-far-sentence");
    if (sentenceEl) sentenceEl.textContent = buildSoFarSummarySentence();
  }

  function bind(root) {
    const chartsRoot = root.querySelector("[data-size-charts]");
    if (chartsRoot) {
      chartsRoot.addEventListener("change", (e) => {
        const sel = e.target.closest("[data-fit-size-select]");
        if (!sel || !chartsRoot.contains(sel)) return;
        if (suppressFitSizeChartChange) return;
        const aud = sel.getAttribute("data-size-audience");
        const v = sel.value;
        if (!aud || aud !== fitConfig.knitFor) return;
        if (!v) {
          fitConfig.size = "";
          fineTuneInchesCanonical = null;
          clearMeasurementInputs(root);
          defaultMeasurements = null;
          root.querySelectorAll(".sg-fit-edited").forEach((el) => el.classList.remove("sg-fit-edited"));
          syncSizeSelection(root);
          updateFitDetailSectionState(root);
          updateFitPreferenceSectionState(root);
          renderFitSummary(root);
          persistFitConfig(root);
          setOpenFitSection(root, "size");
          return;
        }
        if (!isValidSizeForAudience(aud, v)) return;
        fitConfig.size = v;
        syncSizeSelection(root);
        if (fitConfig.fitPreference) {
          applyDefaultMeasurements(root);
        }
        updateFitDetailSectionState(root);
        updateFitPreferenceSectionState(root);
        renderFitSummary(root);
        persistFitConfig(root);
        setOpenFitSection(root, "fitPreference");
      });
    }

    root.querySelectorAll("[data-fit-preference-option]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const v = btn.getAttribute("data-fit-preference-option");
        if (!hasChosenSize()) return;
        if (v === "close" || v === "standard" || v === "relaxed") {
          const previousFit = fitConfig.fitPreference;
          fitConfig.fitPreference = v;
          syncFitPreferenceSelection(root);
          if (previousFit !== v) {
            applyDefaultMeasurements(root);
          } else {
            syncDefaultMeasurementsSnapshot();
            updateFineTuneEditedClasses(root);
          }
          renderFitSummary(root);
          persistFitConfig(root);
          setOpenFitSection(root, "fineTune");
        }
      });
    });

    const resetBtn = root.querySelector("[data-fit-measurements-reset]");
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        if (!hasChosenSize() || !fitConfig.fitPreference) return;
        applyDefaultMeasurements(root);
        root.querySelectorAll(".sg-fit-edited").forEach((el) => el.classList.remove("sg-fit-edited"));
        renderFitSummary(root);
        persistFitConfig(root);
      });
    }

    root.addEventListener("input", (e) => {
      const t = e.target;
      if (!(t instanceof HTMLInputElement)) return;
      if (!t.matches("[data-fit-measurement-input]") || !root.contains(t)) return;
      const key = t.getAttribute("data-fit-measurement-key");
      if (!key) return;
      applyFineTuneCanonicalFromField(key, t.value, getCurrentUiUnit());
      updateFineTuneEditedClasses(root);
      renderFitSummary(root);
      persistFitConfig(root);
    });

    bindFitAccordion(root);

    window.addEventListener("kbm:units-change", (e) => {
      const u = e.detail?.unit;
      if (u !== "in" && u !== "cm") return;
      suppressFitSizeChartChange = true;
      try {
        updateFineTuneMetricChrome(root);
        syncFineTuneInputsFromCanonical(root);
        rebuildSizeDropdownLabels(root, u);
        updateFineTuneEditedClasses(root);
        renderFitSummary(root);
        syncFitHeaderSummaries(root);
        persistFitConfig(root, { silent: true });
      } finally {
        setTimeout(() => {
          suppressFitSizeChartChange = false;
        }, 0);
      }
    });
  }

  /**
   * Reload fit + design fields from storage and refresh the Fit panel (used when returning via build pills).
   * Charts load only if not yet populated (e.g. user switched step before init finished).
   */
  async function refreshFitFromStorage() {
    const root = document.getElementById("sleeveless-fit-builder");
    if (!root) return;
    hydrateFromPattern();
    const needCharts = CHART_AUDIENCES.some((a) => {
      const list = chartRowsByAudience[a];
      return !Array.isArray(list) || list.length === 0;
    });
    if (needCharts) await loadSweaterCharts(root);
    if (fitConfig.size && !isValidSizeForAudience(fitConfig.knitFor, fitConfig.size)) {
      if (import.meta.env.DEV) {
        console.info("[sleeveless-fit] refresh: dropping selectedSize not in chart", fitConfig.size, "for", fitConfig.knitFor);
      }
      fitConfig.size = "";
    }
    renderSoFarSentence(root);
    updateFitPageHeaderIntro(root);
    updateSizeSectionState(root);
    syncSizeSelection(root);
    syncFitPreferenceSelection(root);
    updateFineTuneMetricChrome(root);
    hydrateFineTuneMeasurements(root);
    updateFitDetailSectionState(root);
    updateFitPreferenceSectionState(root);
    renderFitSummary(root);
    persistFitConfig(root, { silent: true });
  }

  window.addEventListener("kbm:sleeveless-before-step-change", (e) => {
    if (e.detail?.from !== "fit") return;
    const root = document.getElementById("sleeveless-fit-builder");
    if (!root) return;
    persistFitConfig(root, { silent: true });
  });

  window.addEventListener("kbm:sleeveless-after-step-change", (e) => {
    if (e.detail?.step !== "fit") return;
    void refreshFitFromStorage();
  });

  async function init() {
    const root = document.getElementById("sleeveless-fit-builder");
    if (!root) return;
    hydrateFromPattern();
    await loadSweaterCharts(root);
    if (fitConfig.size && !isValidSizeForAudience(fitConfig.knitFor, fitConfig.size)) {
      if (import.meta.env.DEV) {
        console.info("[sleeveless-fit] dropping selectedSize not in chart", fitConfig.size, "for", fitConfig.knitFor);
      }
      fitConfig.size = "";
    }
    renderSoFarSentence(root);
    updateFitPageHeaderIntro(root);
    updateSizeSectionState(root);
    syncSizeSelection(root);
    syncFitPreferenceSelection(root);
    updateFineTuneMetricChrome(root);
    hydrateFineTuneMeasurements(root);
    updateFitDetailSectionState(root);
    updateFitPreferenceSectionState(root);
    renderFitSummary(root);
    persistFitConfig(root, { silent: true });
    bind(root);
    setOpenFitSection(root, getDefaultOpenFitSectionKey(root));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => void init());
  } else {
    void init();
  }
</script>
