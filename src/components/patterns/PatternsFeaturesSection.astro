---
interface Props {
  sectionId?: string;
  headingId?: string;
  title?: string;
  subtitle?: string;
}

const {
  sectionId = "pattern-features",
  headingId = "patterns-features-heading",
  title = "Why These Patterns Are Different",
  subtitle,
} = Astro.props;
---

<section
  id={sectionId}
  class="patterns-features"
  data-patterns-feature-preview-root
  aria-labelledby={headingId}
>
  <div class="patterns-features__header">
    <div class="patterns-features__title-row">
      <img
        class="patterns-pinwheel"
        src="/images/KINlogo.svg"
        alt=""
        width="36"
        height="36"
        decoding="async"
        aria-hidden="true"
      />
      <h2 id={headingId} class="patterns-features__title">{title}</h2>
    </div>
    {subtitle && <p class="patterns-features__subtitle">{subtitle}</p>}
  </div>
  <ul class="patterns-features__grid">
    <li>
      <button
        type="button"
        class="patterns-feature-card"
        data-feature-title="Interactive row tracking"
        data-feature-media="/images/patterns/features/Chart-Action.gif"
        aria-haspopup="dialog"
      >Interactive Row Tracking</button>
    </li>
    <li>
      <button
        type="button"
        class="patterns-feature-card"
        data-feature-title="Japanese Shaping Notation"
        data-feature-media="/images/patterns/features/shaping-notation.gif"
        aria-haspopup="dialog"
      >Japanese Shaping Notation</button>
    </li>
    <li>
      <button
        type="button"
        class="patterns-feature-card"
        data-feature-title="Custom Fit & Ease Options"
        data-feature-media="/images/patterns/features/fit-ease.png"
        aria-haspopup="dialog"
      >Custom Fit &amp; Ease Options</button>
    </li>
    <li>
      <button
        type="button"
        class="patterns-feature-card"
        data-feature-title="Built-in Knitting Help"
        data-feature-media="/images/patterns/features/tips.gif"
        aria-haspopup="dialog"
      >Built-In Knitting Help</button>
    </li>
    <li>
      <button
        type="button"
        class="patterns-feature-card"
        data-feature-title="Printable Pattern Output"
        data-feature-media="/images/patterns/features/print.gif"
        aria-haspopup="dialog"
      >Printable Pattern Output</button>
    </li>
    <li>
      <button
        type="button"
        class="patterns-feature-card"
        data-feature-title="Designed for your machine and gauge"
        data-feature-media="/images/patterns/features/gauge.gif"
        aria-haspopup="dialog"
      >Designed for Your Machine &amp; Gauge</button>
    </li>
  </ul>
</section>

<div
  class="patterns-feature-preview-modal"
  data-patterns-feature-preview-modal
  hidden
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="patterns-feature-preview-title"
>
  <div
    class="patterns-feature-preview-modal__dialog"
    data-patterns-feature-preview-dialog
  >
    <div class="patterns-feature-preview-modal__actions">
      <button
        type="button"
        class="patterns-feature-preview-modal__close"
        data-patterns-feature-preview-close
        aria-label="Close feature preview"
      >X</button>
    </div>
    <h2 id="patterns-feature-preview-title" class="patterns-feature-preview-modal__title" data-patterns-feature-preview-title></h2>
    <div class="patterns-feature-preview-modal__media-wrap">
      <img
        class="patterns-feature-preview-modal__media"
        data-patterns-feature-preview-media
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</div>

<script>
  import { initPatternsFeaturePreviewModal } from "../../scripts/patternsFeaturePreviewModal.ts";
  initPatternsFeaturePreviewModal();
</script>

<style>
  .patterns-pinwheel {
    width: 36px;
    height: 36px;
    object-fit: contain;
    opacity: 0.72;
    flex-shrink: 0;
  }

  .patterns-features {
    margin-top: 1.25rem;
    margin-bottom: 36px;
    padding-top: 4px;
    scroll-margin-top: calc(var(--site-header-offset, 72px) + 16px);
  }

  .patterns-features__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .patterns-features__title-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    max-width: 100%;
  }

  .patterns-features__title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: #52682d;
    line-height: 1.25;
    text-align: left;
  }

  .patterns-features__subtitle {
    margin: 0;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #4d5a48;
    text-align: center;
  }

  .patterns-features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .patterns-features__grid > li {
    display: flex;
  }

  .patterns-feature-card {
    width: 100%;
    padding: 16px 38px 16px 18px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid #d6dbc9;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.06);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.4;
    color: #333;
    text-align: center;
    font-family: inherit;
    cursor: pointer;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .patterns-feature-card::after {
    content: "";
    position: absolute;
    right: 16px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 2px solid #b5bea8;
    border-bottom: 2px solid #b5bea8;
    transform: translateY(-50%) rotate(-45deg);
    transition: transform 0.2s ease, border-color 0.2s ease;
    pointer-events: none;
  }

  .patterns-feature-card:hover,
  .patterns-feature-card:focus-visible {
    border-color: #52682d;
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.12);
    transform: translateY(-2px);
  }

  .patterns-feature-card:hover::after,
  .patterns-feature-card:focus-visible::after {
    border-color: #52682d;
    transform: translateY(-50%) rotate(-45deg) translateX(3px);
  }

  .patterns-feature-card:focus-visible {
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }

  .patterns-feature-preview-modal {
    position: fixed;
    inset: 0;
    z-index: 1500;
    display: none;
    place-items: center;
    padding: 1rem;
    box-sizing: border-box;
    background: rgba(17, 24, 39, 0.72);
  }

  .patterns-feature-preview-modal.is-open {
    display: grid;
  }

  .patterns-feature-preview-modal[hidden] {
    display: none !important;
  }

  .patterns-feature-preview-modal__dialog {
    position: relative;
    width: min(92vw, 720px);
    max-height: 92vh;
    padding: 2.5rem 1rem 1rem;
    box-sizing: border-box;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.32);
    overflow: auto;
  }

  .patterns-feature-preview-modal__actions {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    z-index: 1;
  }

  .patterns-feature-preview-modal__close {
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.9);
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .patterns-feature-preview-modal__close:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .patterns-feature-preview-modal__title {
    margin: 0 0 0.75rem;
    padding: 0 2rem 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: #52682d;
    text-align: center;
    line-height: 1.3;
  }

  .patterns-feature-preview-modal__media-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    max-height: calc(92vh - 5rem);
    overflow: auto;
  }

  .patterns-feature-preview-modal__media {
    display: block;
    max-width: 100%;
    width: auto;
    height: auto;
    max-height: min(70vh, 520px);
    border-radius: 8px;
    object-fit: contain;
  }

  :global(body.patterns-feature-preview-open) {
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .patterns-features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .patterns-features__title-row {
      gap: 12px;
    }

    .patterns-features__title {
      font-size: 1.05rem;
    }

    .patterns-features__grid {
      grid-template-columns: 1fr;
    }

    .patterns-feature-preview-modal__dialog {
      width: min(96vw, 100%);
      padding-top: 2.25rem;
    }

    .patterns-feature-preview-modal__title {
      font-size: 0.98rem;
      padding-right: 1.75rem;
    }

    .patterns-feature-preview-modal__media {
      max-height: min(60vh, 400px);
    }
  }
</style>
