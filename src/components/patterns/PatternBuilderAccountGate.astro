---
/**
 * Signup-first account gate modal for the Hat and Blanket pattern builders.
 * Shown to logged-out visitors when they try to Create a pattern or open the Pattern tab.
 * Primary CTA opens Memberstack signup/register; secondary CTA opens Memberstack login.
 */
import {
  PATTERN_BUILDER_ACCOUNT_GATE_BODY,
  PATTERN_BUILDER_ACCOUNT_GATE_PRIMARY_LABEL,
  PATTERN_BUILDER_ACCOUNT_GATE_SECONDARY_LABEL,
  PATTERN_BUILDER_ACCOUNT_GATE_TITLE,
} from "../../lib/patterns/patternBuilderAccountGate";
---

<dialog
  class="pattern-builder-account-gate"
  data-pattern-builder-account-gate
  aria-labelledby="pattern-builder-account-gate-title"
>
  <div class="pattern-builder-account-gate__inner">
    <button
      type="button"
      class="pattern-builder-account-gate__close"
      data-account-gate-dismiss
      aria-label="Close"
    >&times;</button>
    <h2 id="pattern-builder-account-gate-title" class="pattern-builder-account-gate__title">
      {PATTERN_BUILDER_ACCOUNT_GATE_TITLE}
    </h2>
    <p class="pattern-builder-account-gate__message">{PATTERN_BUILDER_ACCOUNT_GATE_BODY}</p>
    <div class="pattern-builder-account-gate__actions">
      <button
        type="button"
        class="pattern-builder-account-gate__primary kbm-btn kbm-btn-primary"
        data-account-gate-signup
      >
        {PATTERN_BUILDER_ACCOUNT_GATE_PRIMARY_LABEL}
      </button>
      <button
        type="button"
        class="pattern-builder-account-gate__secondary"
        data-account-gate-login
      >
        {PATTERN_BUILDER_ACCOUNT_GATE_SECONDARY_LABEL}
      </button>
    </div>
  </div>
</dialog>

<script>
  import {
    initPatternBuilderAccountGate,
    installPatternBuilderAccountGate,
  } from "../../lib/patterns/patternBuilderAccountGate";

  initPatternBuilderAccountGate();
  installPatternBuilderAccountGate();
</script>

<style>
  .pattern-builder-account-gate {
    max-width: min(92vw, 28rem);
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.18);
  }

  .pattern-builder-account-gate::backdrop {
    background: rgba(15, 23, 42, 0.45);
  }

  .pattern-builder-account-gate__inner {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2rem);
    text-align: center;
  }

  .pattern-builder-account-gate__close {
    position: absolute;
    top: 0.5rem;
    right: 0.65rem;
    appearance: none;
    border: none;
    background: transparent;
    font-size: 1.6rem;
    line-height: 1;
    color: #9ca3af;
    cursor: pointer;
    padding: 0.25rem 0.4rem;
  }

  .pattern-builder-account-gate__close:hover {
    color: #4b5563;
  }

  .pattern-builder-account-gate__title {
    margin: 0 0 0.75rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: #2c3a57;
    line-height: 1.25;
  }

  .pattern-builder-account-gate__message {
    margin: 0 0 1.25rem;
    font-size: 1rem;
    line-height: 1.55;
    color: #374151;
  }

  .pattern-builder-account-gate__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .pattern-builder-account-gate__primary {
    width: 100%;
    text-decoration: none;
  }

  .pattern-builder-account-gate__secondary {
    appearance: none;
    border: none;
    background: transparent;
    color: #52682d;
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }

  .pattern-builder-account-gate__secondary:hover {
    color: #3f5122;
  }

  .pattern-builder-account-gate__secondary:focus-visible,
  .pattern-builder-account-gate__close:focus-visible {
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }
</style>
