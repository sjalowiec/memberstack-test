---
const { title = "Ask or Share" } = Astro.props;
---

<div
  class="pattern-comments"
  data-pattern-comments
  data-hyvor-loaded="false"
  data-hyvor-website-id="14706"
>
  <h3 class="pattern-section-title">{title}</h3>
  <div id="hyvor-talk-view"></div>
</div>

<style>
  .pattern-comments {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid #e5e5e5;
  }

  .pattern-comments h3 {
    margin-bottom: 15px;
  }
</style>
