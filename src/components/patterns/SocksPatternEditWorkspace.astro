---
/**
 * Shared Socks Summary/Edit workspace.
 * Compact choices + gauge; finished measurements are chips on the sock image.
 * Used by `/patterns/socks/edit/` and `/patterns/socks/summary/`.
 * Draft: kbm_socks_draft. Update Pattern returns to the finished Pattern page.
 */
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import PatternSummaryEditWorkspace from "./PatternSummaryEditWorkspace.astro";
import PatternSummaryDiagramStage from "./PatternSummaryDiagramStage.astro";
import PatternSummaryMeasurementChip from "./PatternSummaryMeasurementChip.astro";
import {
  SOCK_SUMMARY_ART_SRC,
  SOCK_SUMMARY_CHIP_TARGET_POINTS,
  SOCK_SUMMARY_MEASUREMENT_FIELDS,
  SOCK_EDIT_MEASUREMENT_TARGETS,
} from "../../lib/patterns/sock/sockPatternEditTargets";
import {
  AVAILABLE_NEEDLES_HELPER_TEXT,
  AVAILABLE_NEEDLES_LABEL,
} from "../../lib/patterns/sock/sockAvailableNeedles";
import {
  createSockSizingAdapter,
  listSockSizingOptions,
} from "../../lib/patterns/sock/sockSizing";
import {
  SOCK_EDIT_CANCEL_LABEL,
  SOCK_EDIT_PRIMARY_LABEL,
  SOCK_PATTERN_BUILDER_HREF,
  SOCK_PATTERN_HREF,
} from "../../lib/patterns/sock/sockPatternNavigation";
import {
  SOCK_CONSTRUCTION_DIRECTION_LABELS,
  SOCK_PATTERN_MISSING_DRAFT_MESSAGE,
} from "../../lib/patterns/sock/sockPatternFromDraft";
import { SOCK_PATTERN_SYSTEM_DISPLAY_NAME } from "../../lib/patterns/sock/sockDraft";

const sockSizingJson = JSON.parse(
  readFileSync(resolve("public/data/sizing_socks.json"), "utf8"),
) as unknown;
const sockSizingRows = listSockSizingOptions(createSockSizingAdapter(sockSizingJson), "inches");
---

<div class="hat-pattern-empty" data-socks-edit-empty role="status" hidden>
  <h1 class="hat-pattern-empty__title">{SOCK_PATTERN_SYSTEM_DISPLAY_NAME}</h1>
  <p class="hat-pattern-empty__message" data-socks-edit-empty-message>
    {SOCK_PATTERN_MISSING_DRAFT_MESSAGE}
  </p>
  <a
    href={SOCK_PATTERN_BUILDER_HREF}
    class="kbm-btn kbm-btn-accent"
    data-testid="socks-edit-empty-cta"
  >
    Go to Socks Builder
  </a>
</div>

<div
  class="socks-edit-workspace"
  data-socks-edit-workspace
  data-testid="socks-edit-workspace"
  hidden
>
  <PatternSummaryEditWorkspace
    measurePaneAttr="data-socks-edit-measure-pane"
    actionsAttr="data-socks-edit-actions"
  >
    <Fragment slot="quick">
      <section class="sl-edit-section sl-edit-units-section" aria-labelledby="socks-edit-units-heading">
        <h3 class="sl-edit-section__title" id="socks-edit-units-heading">Units</h3>
        <div
          class="sl-edit-units-toggle"
          role="group"
          aria-labelledby="socks-edit-units-heading"
          data-socks-edit-units
        >
          <button
            type="button"
            class="sl-edit-unit-btn is-active"
            data-socks-edit-unit="inches"
            aria-pressed="true"
          >
            Inches
          </button>
          <button
            type="button"
            class="sl-edit-unit-btn"
            data-socks-edit-unit="cm"
            aria-pressed="false"
          >
            Centimeters
          </button>
        </div>
      </section>

      <section class="sl-edit-section" aria-labelledby="socks-edit-choices-heading">
        <h3 class="sl-edit-section__title" id="socks-edit-choices-heading">
          Pattern choices
        </h3>

        <div class="sl-edit-field">
          <label class="sl-edit-sublabel" for="socks-edit-size">Sock size</label>
          <select
            id="socks-edit-size"
            class="sl-edit-input sl-edit-select"
            data-socks-edit-size
            data-testid="socks-edit-size"
          >
            <option value="">Choose a finished sock size…</option>
            {
              sockSizingRows.map((row) => (
                <option value={row.size}>{row.optionLabel}</option>
              ))
            }
          </select>
          <p class="sl-edit-field-error" data-socks-edit-error="sizeSel" hidden role="alert"></p>
        </div>

        <div class="sl-edit-field">
          <label class="sl-edit-sublabel" for="socks-edit-construction">
            Construction direction
          </label>
          <select
            id="socks-edit-construction"
            class="sl-edit-input sl-edit-select"
            data-socks-edit-construction
            data-testid="socks-edit-construction"
          >
            <option value="">Choose construction direction</option>
            <option value="cuff-to-toe">{SOCK_CONSTRUCTION_DIRECTION_LABELS["cuff-to-toe"]}</option>
            <option value="toe-up">{SOCK_CONSTRUCTION_DIRECTION_LABELS["toe-up"]}</option>
          </select>
          <p
            class="sl-edit-field-error"
            data-socks-edit-error="constructionDirection"
            hidden
            role="alert"
          >
          </p>
        </div>
      </section>

      <section class="sl-edit-section" aria-labelledby="socks-edit-gauge-heading">
        <h3 class="sl-edit-section__title" id="socks-edit-gauge-heading">
          Gauge / machine
        </h3>
        <p class="sl-edit-ease" data-socks-edit-gauge-help>stitches / rows over 4 inches</p>
        <div class="socks-edit-gauge-grid">
          <div class="sl-edit-field">
            <label class="sl-edit-sublabel" for="socks-edit-stitch-gauge">Stitch gauge</label>
            <input
              id="socks-edit-stitch-gauge"
              class="sl-edit-input"
              type="number"
              inputmode="decimal"
              step="0.1"
              min="0"
              data-socks-edit-stitch-gauge
              data-testid="socks-edit-stitch-gauge"
            />
            <p
              class="sl-edit-field-error"
              data-socks-edit-error="stitchGauge"
              hidden
              role="alert"
            >
            </p>
          </div>
          <div class="sl-edit-field">
            <label class="sl-edit-sublabel" for="socks-edit-row-gauge">Row gauge</label>
            <input
              id="socks-edit-row-gauge"
              class="sl-edit-input"
              type="number"
              inputmode="decimal"
              step="0.1"
              min="0"
              data-socks-edit-row-gauge
              data-testid="socks-edit-row-gauge"
            />
            <p class="sl-edit-field-error" data-socks-edit-error="rowGauge" hidden role="alert"></p>
          </div>
        </div>
        <div class="sl-edit-field socks-edit-needles-field">
          <label class="sl-edit-sublabel" for="socks-edit-available-needles"
            >{AVAILABLE_NEEDLES_LABEL}</label
          >
          <input
            id="socks-edit-available-needles"
            class="sl-edit-input"
            type="number"
            inputmode="numeric"
            min="1"
            step="1"
            data-socks-edit-available-needles
            data-testid="socks-edit-available-needles"
          />
          <p class="sl-edit-ease">{AVAILABLE_NEEDLES_HELPER_TEXT}</p>
          <p
            class="sl-edit-field-error"
            data-socks-edit-error="availableNeedles"
            hidden
            role="alert"
          >
          </p>
        </div>
      </section>
    </Fragment>

    <Fragment slot="notes">
      <p class="sl-edit-error-note" data-socks-edit-form-error hidden role="alert"></p>
    </Fragment>

    <Fragment slot="actions">
      <a
        href={SOCK_PATTERN_HREF}
        class="sl-edit-btn sl-edit-btn--ghost"
        data-socks-edit-cancel
        data-testid="button-edit-cancel"
      >
        {SOCK_EDIT_CANCEL_LABEL}
      </a>
      <button
        type="button"
        class="sl-edit-btn sl-edit-btn--primary"
        data-socks-edit-update
        data-testid="button-edit-update"
      >
        {SOCK_EDIT_PRIMARY_LABEL}
      </button>
    </Fragment>

    <Fragment slot="diagram">
      <PatternSummaryDiagramStage
        stageTestId="socks-edit-diagram-area"
        diagramAttr="data-socks-edit-diagram"
        overlayAttr="data-socks-edit-overlay"
        stageInnerAttr="data-socks-edit-stage"
      >
        <Fragment slot="art">
          <img
            class="socks-edit-art"
            src={SOCK_SUMMARY_ART_SRC}
            alt="Finished Basic Socks"
            width="640"
            height="800"
            decoding="async"
            data-socks-edit-art
          />
          <svg
            class="socks-edit-chip-targets"
            viewBox="0 0 100 100"
            preserveAspectRatio="xMidYMid meet"
            aria-hidden="true"
            focusable="false"
            data-socks-edit-chip-targets
          >
            <circle
              id={SOCK_EDIT_MEASUREMENT_TARGETS.legLength}
              cx={SOCK_SUMMARY_CHIP_TARGET_POINTS.legLength.x}
              cy={SOCK_SUMMARY_CHIP_TARGET_POINTS.legLength.y}
              r="2"
              fill="none"
            />
            <circle
              id={SOCK_EDIT_MEASUREMENT_TARGETS.legCircumference}
              cx={SOCK_SUMMARY_CHIP_TARGET_POINTS.legCircumference.x}
              cy={SOCK_SUMMARY_CHIP_TARGET_POINTS.legCircumference.y}
              r="2"
              fill="none"
            />
            <circle
              id={SOCK_EDIT_MEASUREMENT_TARGETS.footLength}
              cx={SOCK_SUMMARY_CHIP_TARGET_POINTS.footLength.x}
              cy={SOCK_SUMMARY_CHIP_TARGET_POINTS.footLength.y}
              r="2"
              fill="none"
            />
            <circle
              id={SOCK_EDIT_MEASUREMENT_TARGETS.footCircumference}
              cx={SOCK_SUMMARY_CHIP_TARGET_POINTS.footCircumference.x}
              cy={SOCK_SUMMARY_CHIP_TARGET_POINTS.footCircumference.y}
              r="2"
              fill="none"
            />
          </svg>
        </Fragment>
        {SOCK_SUMMARY_MEASUREMENT_FIELDS.map((field) => (
          <PatternSummaryMeasurementChip field={field} />
        ))}
      </PatternSummaryDiagramStage>
    </Fragment>
  </PatternSummaryEditWorkspace>
</div>

<script
  type="application/json"
  id="socks-sizing-chart"
  set:html={JSON.stringify(sockSizingJson)}
/>

<style>
  .hat-pattern-empty {
    max-width: 36rem;
    margin: 1.5rem auto;
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .hat-pattern-empty__title {
    margin: 0 0 0.65rem;
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--kbm-green, #52682d);
  }

  .hat-pattern-empty__message {
    margin: 0 0 1.1rem;
    font-size: 0.98rem;
    line-height: 1.5;
    color: #4b5563;
  }

  .socks-edit-workspace[hidden] {
    display: none;
  }

  :global(.socks-edit-page .sl-edit-btn--ghost),
  :global(.socks-edit-page .sl-edit-btn--primary) {
    text-decoration: none;
    box-sizing: border-box;
  }

  :global(.socks-edit-page .sl-edit-workspace__measure-hint) {
    display: none;
  }

  :global(.socks-edit-page .sl-edit-workspace__quick) {
    max-width: 22rem;
  }

  .socks-edit-gauge-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
  }

  .socks-edit-needles-field {
    max-width: 14rem;
  }

  :global(.socks-edit-page .ps-measure) {
    margin: 0 0 0.75rem;
  }

  :global(.socks-edit-page .ps-measure-art) {
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }

  :global(.socks-edit-page .socks-edit-art) {
    display: block;
    width: 100%;
    max-width: 18rem;
    height: auto;
  }

  :global(.socks-edit-page .socks-edit-chip-targets) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  :global(.socks-edit-page .ps-measure-stage__inner[data-measurement-overlay-mode="desktop"]) {
    padding: 2.75rem 6.5rem 3.25rem 6.75rem;
  }
</style>
