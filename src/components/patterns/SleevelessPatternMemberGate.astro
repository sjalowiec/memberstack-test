---
/**
 * Wraps Dynamic Pattern pages (catalog, builders, workspaces, print).
 * Content stays hidden until active Knit it Now membership (or lifetime builder
 * entitlement) is confirmed. Login alone never unlocks pattern UI.
 *
 * Logged-out: Become a Member + Log In
 * Logged-in without access: Become a Member + View Membership
 */
---

<div class="sleeveless-pattern-gate" data-sleeveless-pattern-gate data-gate-pending>
  <section
    class="sleeveless-pattern-gate__locked"
    data-sleeveless-pattern-gate-locked
    aria-labelledby="sleeveless-pattern-gate-heading"
  >
    <p class="sleeveless-pattern-gate__loading" data-sleeveless-pattern-gate-loading>
      Checking membership…
    </p>

    <div class="sleeveless-pattern-gate__signin" data-sleeveless-pattern-gate-signin hidden>
      <h2 id="sleeveless-pattern-gate-heading" class="sleeveless-pattern-gate__title">
        Available with Knit it Now membership
      </h2>
      <p class="sleeveless-pattern-gate__lead">
        Dynamic Patterns are included with an active Knit it Now membership. Each pattern is
        customized for your machine, gauge, yarn, and measurements.
      </p>
      <div class="sleeveless-pattern-gate__actions">
        <a
          href="/membership"
          class="kbm-btn kbm-btn-primary"
          data-sleeveless-gate-membership
        >
          Become a Member
        </a>
        <a
          href="#"
          class="kbm-btn kbm-btn-outline"
          data-ms-modal="login"
          data-ms-redirect="current-url"
        >
          Already a Member? Log In
        </a>
      </div>
    </div>

    <div
      class="sleeveless-pattern-gate__signin"
      data-sleeveless-pattern-gate-no-access
      hidden
    >
      <h2 id="sleeveless-pattern-gate-no-access-heading" class="sleeveless-pattern-gate__title">
        Membership required for Dynamic Patterns
      </h2>
      <p class="sleeveless-pattern-gate__lead">
        You're signed in, but Dynamic Patterns need an active Knit it Now membership. Other
        purchases or an account without membership do not unlock the pattern builders.
      </p>
      <div class="sleeveless-pattern-gate__actions">
        <a
          href="/membership"
          class="kbm-btn kbm-btn-primary"
          data-sleeveless-gate-membership
        >
          Become a Member
        </a>
        <a href="/account#membership" class="kbm-btn kbm-btn-outline">
          View Membership
        </a>
      </div>
    </div>
  </section>

  <div class="sleeveless-pattern-gate__content" data-sleeveless-pattern-gate-content hidden>
    <slot />
  </div>
</div>

<script>
  import "/src/scripts/sleeveless-pattern-login-gate.ts";
  // Localhost-only access-source debug badge. Self-gated behind import.meta.env.DEV + a
  // localhost hostname check, so production builds dead-code-eliminate it.
  import "/src/scripts/sleevelessAccessDebugBadge.ts";
</script>

<style>
  .sleeveless-pattern-gate__locked {
    max-width: 36rem;
    margin: 2rem auto 2.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    text-align: center;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #f9fafb;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .sleeveless-pattern-gate__loading {
    margin: 0;
    color: #4b5563;
    font-size: 1rem;
  }

  .sleeveless-pattern-gate__title {
    margin: 0 0 0.65rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: #2c3a57;
  }

  .sleeveless-pattern-gate__lead {
    margin: 0 0 1.25rem;
    line-height: 1.55;
    color: #374151;
    font-size: 1rem;
  }

  .sleeveless-pattern-gate__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    margin-bottom: 0.25rem;
  }

  .sleeveless-pattern-gate[data-gate-state="member"] .sleeveless-pattern-gate__locked {
    display: none;
  }

  .sleeveless-pattern-gate[data-gate-pending] .sleeveless-pattern-gate__signin {
    display: none;
  }
</style>
