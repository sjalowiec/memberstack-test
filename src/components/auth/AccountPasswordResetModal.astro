---
/** Two-step forgot / reset password modal (MemberStack data-ms-form contract). */
---

<div
  id="kbm-account-password-reset-modal"
  class="kbm-account-reset-modal"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="kbm-account-reset-title"
>
  <div class="kbm-account-reset-modal__overlay" data-kbm-account-reset-close></div>

  <div class="kbm-account-reset-modal__panel">
    <button
      type="button"
      class="kbm-account-reset-modal__close"
      data-kbm-account-reset-close
      aria-label="Close password reset"
    >
      <span aria-hidden="true">&times;</span>
    </button>

    <div class="kbm-account-reset-modal__step" data-kbm-reset-step="email">
      <h2 id="kbm-account-reset-title" class="kbm-account-reset-modal__title">
        Reset your password
      </h2>
      <p class="kbm-account-reset-modal__lead">
        Enter the email on your Knit It Now account. We&rsquo;ll send a 6-digit code you can enter
        on the next step.
      </p>

      <form
        id="kbm-account-reset-email-form"
        class="contact-form account-page__form kbm-account-reset-modal__form"
        {...{ "data-ms-form": "forgot-password", redirect: "#kbm-reset-code" } as Record<string, string>}
      >
        <div class="contact-form__field">
          <label for="kbm-account-reset-email">Email</label>
          <input
            type="email"
            id="kbm-account-reset-email"
            name="email"
            data-ms-member="email"
            autocomplete="email"
            required
          />
        </div>
        <button type="submit" class="contact-form__submit">Send reset code</button>
      </form>
    </div>

    <div class="kbm-account-reset-modal__step" data-kbm-reset-step="code" hidden>
      <h2 class="kbm-account-reset-modal__title">Enter your reset code</h2>
      <p class="kbm-account-reset-modal__lead" id="kbm-account-reset-code-lead">
        Check your email for a 6-digit code, then choose a new password below.
      </p>

      <form
        id="kbm-account-reset-code-form"
        class="contact-form account-page__form kbm-account-reset-modal__form"
        {...{ "data-ms-form": "reset-password", redirect: "/account" } as Record<string, string>}
      >
        <div class="contact-form__field">
          <label for="kbm-account-reset-token">6-digit code</label>
          <input
            type="text"
            id="kbm-account-reset-token"
            name="reset-token"
            data-ms-member="token"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="6"
            pattern="[0-9]{6}"
            title="Enter the 6-digit code from your email"
            required
          />
        </div>
        <div class="contact-form__field">
          <label for="kbm-account-reset-password">New password</label>
          <input
            type="password"
            id="kbm-account-reset-password"
            name="new-password"
            data-ms-member="password"
            autocomplete="new-password"
            minlength="8"
            required
          />
          <p class="account-page__field-hint">Passwords must be at least 8 characters.</p>
        </div>
        <button type="submit" class="contact-form__submit">Set new password</button>
      </form>

      <p class="kbm-account-reset-modal__footer-links">
        <button type="button" class="kbm-account-reset-modal__link-btn" data-kbm-reset-resend>
          Resend code
        </button>
        <span class="kbm-account-reset-modal__sep" aria-hidden="true">&middot;</span>
        <button type="button" class="kbm-account-reset-modal__link-btn" data-kbm-reset-back-email>
          Use a different email
        </button>
      </p>
    </div>
  </div>
</div>

<style is:global>
  .kbm-account-reset-modal {
    position: fixed;
    inset: 0;
    z-index: 10050;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .kbm-account-reset-modal[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  .kbm-account-reset-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(2px);
  }

  .kbm-account-reset-modal__panel {
    position: relative;
    width: min(100%, 28rem);
    max-height: calc(100vh - 2.5rem);
    overflow-y: auto;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.5rem 1.5rem 1.35rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.14);
  }

  .kbm-account-reset-modal__close {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    width: 2rem;
    height: 2rem;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: #6b7280;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .kbm-account-reset-modal__close:hover,
  .kbm-account-reset-modal__close:focus-visible {
    background: #f3f4f6;
    color: #374151;
    outline: none;
  }

  .kbm-account-reset-modal__title {
    margin: 0 0 0.5rem;
    padding-right: 2rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: #2c3a57;
  }

  .kbm-account-reset-modal__lead {
    margin: 0 0 1.1rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #4b5563;
  }

  .kbm-account-reset-modal__form .contact-form__submit {
    width: 100%;
    margin-top: 0.15rem;
  }

  .kbm-account-reset-modal__form .contact-form__field label {
    display: block;
    font-weight: 600;
    color: #2c3a57;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .kbm-account-reset-modal__form .contact-form__field input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: #fafafa;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: var(--font);
  }

  .kbm-account-reset-modal__form .contact-form__field input:focus {
    outline: none;
    border-color: var(--kbm-green);
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.15);
    background: #fff;
  }

  .kbm-account-reset-modal__form .account-page__field-hint {
    margin: 0.45rem 0 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: #4b5563;
  }

  .kbm-account-reset-modal__footer-links {
    margin: 0.85rem 0 0;
    text-align: center;
    font-size: 0.92rem;
    line-height: 1.45;
    color: #4b5563;
  }

  .kbm-account-reset-modal__link-btn {
    border: none;
    padding: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    color: #2c3a57;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    cursor: pointer;
  }

  .kbm-account-reset-modal__link-btn:hover,
  .kbm-account-reset-modal__link-btn:focus-visible {
    color: var(--kbm-green, #52682d);
    outline: none;
  }

  .kbm-account-reset-modal__sep {
    margin: 0 0.35rem;
    color: #9ca3af;
  }
</style>
