---
import LegacyCourseBlock from "./LegacyCourseBlock.astro";
import LegacyCourseTextVideoLayout from "./LegacyCourseTextVideoLayout.astro";
import LegacyCourseTextImageLayout from "./LegacyCourseTextImageLayout.astro";
import LegacyCourseThreeVideosLayout from "./LegacyCourseThreeVideosLayout.astro";
import LegacyCourseAccordionLayout from "./LegacyCourseAccordionLayout.astro";
import LegacyCourseEmbeddedToolLayout from "./LegacyCourseEmbeddedToolLayout.astro";
import type { CourseComponent, CourseLesson } from "../../../lib/legacy_kin/coursePreviewPoc";
import {
  TEXT_IMAGE_LAYOUT_TYPE,
  TEXT_VIDEO_LAYOUT_TYPE,
  THREE_VIDEOS_LAYOUT_TYPE,
} from "../../../lib/legacy_kin/courseContentEditorTypes";
import {
  contentItemDisplayTitle,
  findBlockBySlug,
  flattenLessonContent,
  type FlatContentItem,
} from "../../../lib/legacy_kin/courseLessonContentItems";
import { isAccordionLayoutBlock } from "../../../lib/legacy_kin/courseAccordionLayout";
import { isEmbeddedToolLayoutBlock } from "../../../lib/legacy_kin/courseEmbeddedToolLayout";

interface Props {
  lesson: CourseLesson;
  item?: FlatContentItem;
  showItemTitles?: boolean;
}

const { lesson, item, showItemTitles = true } = Astro.props;
const items = item ? [item] : flattenLessonContent(lesson);
---

{
  items.map((entry) => {
    const block = findBlockBySlug(lesson, entry.blockSlug);
    const title = contentItemDisplayTitle(lesson, entry);
    const hideTitle =
      !showItemTitles ||
      !title ||
      entry.type === TEXT_IMAGE_LAYOUT_TYPE;

    return (
      <article class="course-preview__block legacy-course__block">
        {!hideTitle ? (
          <h2 class="course-preview__block-title legacy-course__block-title">
            {title}
          </h2>
        ) : null}

        {entry.type === TEXT_VIDEO_LAYOUT_TYPE && block ? (
          <LegacyCourseTextVideoLayout block={block} />
        ) : entry.type === THREE_VIDEOS_LAYOUT_TYPE && block ? (
          <LegacyCourseThreeVideosLayout block={block} />
        ) : entry.type === TEXT_IMAGE_LAYOUT_TYPE && block ? (
          <LegacyCourseTextImageLayout block={block} />
        ) : entry.type === "exerciseAccordion" &&
          block &&
          isAccordionLayoutBlock(block) ? (
          <LegacyCourseAccordionLayout block={block} />
        ) : entry.type === "embeddedTool" &&
          block &&
          isEmbeddedToolLayoutBlock(block) ? (
          <LegacyCourseEmbeddedToolLayout block={block} />
        ) : (
          <div class="course-preview__components legacy-course__components">
            <LegacyCourseBlock component={entry.component as CourseComponent} />
          </div>
        )}
      </article>
    );
  })
}
