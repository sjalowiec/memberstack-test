---
import LegacyCourseBlock from "./LegacyCourseBlock.astro";
import LegacyCourseTextVideoLayout from "./LegacyCourseTextVideoLayout.astro";
import LegacyCourseTextImageLayout from "./LegacyCourseTextImageLayout.astro";
import LegacyCourseThreeVideosLayout from "./LegacyCourseThreeVideosLayout.astro";
import LegacyCourseAccordionLayout from "./LegacyCourseAccordionLayout.astro";
import type { CourseBlock } from "../../../lib/legacy_kin/coursePreviewPoc";
import { sortedComponents } from "../../../lib/legacy_kin/coursePreviewPoc";
import { isAccordionLayoutBlock } from "../../../lib/legacy_kin/courseAccordionLayout";
import { isTextVideoLayoutBlock } from "../../../lib/legacy_kin/courseTextVideoLayout";
import { isTextImageLayoutBlock } from "../../../lib/legacy_kin/courseTextImageLayout";
import { isThreeVideosLayoutBlock } from "../../../lib/legacy_kin/courseThreeVideosLayout";

interface Props {
  blocks: CourseBlock[];
  lessonSlug: string;
  showBlockTitles?: boolean;
}

const { blocks, lessonSlug, showBlockTitles = true } = Astro.props;
---

{
  blocks.map((block) => (
    <article
      class="course-preview__block legacy-course__block"
      id={`${lessonSlug}--${block.slug}`}
    >
      {showBlockTitles && block.title?.trim() && !isTextImageLayoutBlock(block) ? (
        <h2 class="course-preview__block-title legacy-course__block-title">
          {block.title}
        </h2>
      ) : null}

      {isTextVideoLayoutBlock(block) ? (
        <LegacyCourseTextVideoLayout block={block} />
      ) : isThreeVideosLayoutBlock(block) ? (
        <LegacyCourseThreeVideosLayout block={block} />
      ) : isTextImageLayoutBlock(block) ? (
        <LegacyCourseTextImageLayout block={block} />
      ) : isAccordionLayoutBlock(block) ? (
        <LegacyCourseAccordionLayout block={block} />
      ) : (
        <div class="course-preview__components legacy-course__components">
          {sortedComponents(block).map((component) => (
            <LegacyCourseBlock component={component} />
          ))}
        </div>
      )}
    </article>
  ))
}
