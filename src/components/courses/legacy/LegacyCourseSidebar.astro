---
import {
  getLegacyCourses,
  getLegacyCourseBySlug,
  getSortedLessonsForCourse,
  legacyCourseHref,
  legacyLessonHref,
} from "../../../lib/legacy_kin/legacyCourseLoader";

interface Props {
  courseSlug: string;
  currentLessonSlug?: string;
  includeDrafts?: boolean;
}

const { courseSlug, currentLessonSlug, includeDrafts = false } = Astro.props;
const loaderOptions = { includeDrafts };
const course = getLegacyCourseBySlug(courseSlug, loaderOptions);
const lessons = course ? getSortedLessonsForCourse(course) : [];
const allCourses = getLegacyCourses(loaderOptions);
---

<aside class="course-preview__sidebar legacy-course__sidebar" aria-label="Course navigation">
  <header class="course-preview__sidebar-header">
    {
      allCourses.length > 1 ? (
        <label class="course-preview__course-select-wrap">
          <span class="course-preview__course-select-label">Course</span>
          <select
            class="course-preview__course-select"
            aria-label="Select course"
            data-legacy-course-select
          >
            {allCourses.map((item) => (
              <option
                value={legacyCourseHref(item.slug)}
                selected={item.slug === courseSlug}
              >
                {item.title}
              </option>
            ))}
          </select>
        </label>
      ) : null
    }

    {
      course ? (
        <>
          <h2 class="course-preview__sidebar-title">
            <a href={legacyCourseHref(courseSlug)}>{course.course.title}</a>
          </h2>
          <p class="course-preview__sidebar-meta">
            {lessons.length} lesson{lessons.length === 1 ? "" : "s"}
          </p>
        </>
      ) : null
    }
  </header>

  {
    course ? (
      <nav class="course-preview__sidebar-nav" aria-label="Lessons">
        <ol class="course-preview__sidebar-lessons">
          {
            lessons.map((lesson) => {
              const isActive = lesson.slug === currentLessonSlug;
              return (
                <li
                  class:list={[
                    "course-preview__sidebar-lesson",
                    isActive && "course-preview__sidebar-lesson--active",
                  ]}
                >
                  <a
                    class="course-preview__sidebar-lesson-link"
                    href={legacyLessonHref(courseSlug, lesson.slug)}
                    aria-current={isActive ? "page" : undefined}
                  >
                    <span class="course-preview__sidebar-lesson-order">
                      {lesson.displayOrder}.
                    </span>
                    {lesson.title}
                  </a>
                </li>
              );
            })
          }
        </ol>
      </nav>
    ) : null
  }
</aside>

<script>
  document.querySelectorAll("[data-legacy-course-select]").forEach((select) => {
    select.addEventListener("change", (event) => {
      const target = event.currentTarget;
      if (!(target instanceof HTMLSelectElement)) return;
      const url = target.value;
      if (url) window.location.href = url;
    });
  });
</script>
