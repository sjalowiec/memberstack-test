---
import {
  getLegacyCourses,
  getLegacyCourseBySlug,
  getSortedLessonsForCourse,
  legacyCourseHref,
  legacyLessonHref,
  legacyLessonItemHref,
} from "../../../lib/legacy_kin/legacyCourseLoader";
import type { LessonContentNavEntry } from "../../../lib/legacy_kin/courseLessonContentItems";

interface Props {
  courseSlug: string;
  currentLessonSlug?: string;
  currentItemSlug?: string;
  includeDrafts?: boolean;
  previewQuery?: string;
  contentNavEntries?: LessonContentNavEntry[];
}

const {
  courseSlug,
  currentLessonSlug,
  currentItemSlug,
  includeDrafts = false,
  previewQuery = "",
  contentNavEntries = [],
} = Astro.props;
const showContentNav = contentNavEntries.length > 1;
const loaderOptions = { includeDrafts };
const course = getLegacyCourseBySlug(courseSlug, loaderOptions);
const lessons = course ? getSortedLessonsForCourse(course, loaderOptions) : [];
const allCourses = getLegacyCourses(loaderOptions);

function lessonHref(lessonSlug: string): string {
  return `${legacyLessonHref(courseSlug, lessonSlug)}${previewQuery}`;
}

function itemHref(lessonSlug: string, itemSlug: string): string {
  return `${legacyLessonItemHref(courseSlug, lessonSlug, itemSlug)}${previewQuery}`;
}
---

<aside class="course-preview__sidebar legacy-course__sidebar" aria-label="Course navigation">
  <header class="course-preview__sidebar-header">
    {
      allCourses.length > 1 ? (
        <label class="course-preview__course-select-wrap">
          <span class="course-preview__course-select-label">Course</span>
          <select
            class="course-preview__course-select"
            aria-label="Select course"
            data-legacy-course-select
          >
            {allCourses.map((item) => (
              <option
                value={`${legacyCourseHref(item.slug)}${previewQuery}`}
                selected={item.slug === courseSlug}
              >
                {item.title}
              </option>
            ))}
          </select>
        </label>
      ) : null
    }

    {
      course ? (
        <>
          <h2 class="course-preview__sidebar-title">
            <a href={`${legacyCourseHref(courseSlug)}${previewQuery}`}>{course.course.title}</a>
          </h2>
          <p class="course-preview__sidebar-meta">
            {lessons.length} lesson{lessons.length === 1 ? "" : "s"}
          </p>
        </>
      ) : null
    }
  </header>

  {
    course ? (
      <nav class="course-preview__sidebar-nav" aria-label="Lessons">
        <ol class="course-preview__sidebar-lessons">
          {
            lessons.map((lesson) => {
              const isActive = lesson.slug === currentLessonSlug;
              return (
                <li
                  class:list={[
                    "course-preview__sidebar-lesson",
                    isActive && "course-preview__sidebar-lesson--active",
                  ]}
                >
                  <a
                    class="course-preview__sidebar-lesson-link"
                    href={lessonHref(lesson.slug)}
                    aria-current={isActive && !currentItemSlug ? "page" : undefined}
                  >
                    <span class="course-preview__sidebar-lesson-order">
                      {lesson.displayOrder}.
                    </span>
                    {lesson.title}
                  </a>

                  {
                    isActive && showContentNav ? (
                      <ol class="course-preview__sidebar-sections">
                        {contentNavEntries.map((entry) => {
                          const isActiveItem = entry.itemSlug === currentItemSlug;
                          return (
                            <li class="course-preview__sidebar-section">
                              <a
                                class:list={[
                                  "course-preview__sidebar-section-link",
                                  isActiveItem &&
                                    "course-preview__sidebar-section-link--active",
                                ]}
                                href={itemHref(lesson.slug, entry.itemSlug)}
                                aria-current={isActiveItem ? "page" : undefined}
                              >
                                {entry.title}
                              </a>
                            </li>
                          );
                        })}
                      </ol>
                    ) : null
                  }
                </li>
              );
            })
          }
        </ol>
      </nav>
    ) : null
  }
</aside>

<script>
  document.querySelectorAll("[data-legacy-course-select]").forEach((select) => {
    select.addEventListener("change", (event) => {
      const target = event.currentTarget;
      if (!(target instanceof HTMLSelectElement)) return;
      const url = target.value;
      if (url) window.location.href = url;
    });
  });
</script>
