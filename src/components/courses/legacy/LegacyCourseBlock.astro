---
import VimeoEmbed from "../../media/VimeoEmbed.astro";
import EmbeddedTool from "../../embedded/EmbeddedTool.astro";
import LegacyCourseImageCarousel from "./LegacyCourseImageCarousel.astro";
import LegacyCourseImage from "./LegacyCourseImage.astro";
import LegacyHotspot from "../../kinCourse/LegacyHotspot.astro";
import type { CourseComponent, MigrationPendingComponent } from "../../../lib/legacy_kin/coursePreviewPoc";
import {
  downloadUrl,
  legacyAssetUrl,
  rewriteLegacyHtml,
} from "../../../lib/legacy_kin/coursePreviewPoc";
import { numberedLegacyFields } from "../../../lib/kinCourse/legacyFields";
import LegacyVimeoJumpLinks from "../../kinCourse/LegacyVimeoJumpLinks.astro";
import { jumpLinkButtonLabel, jumpsFromComponent } from "../../../lib/kinCourse/vimeoJumpLinks";

interface Props {
  component: CourseComponent;
  jumpLinks?: Record<string, unknown>[];
}

const { component, jumpLinks = [] } = Astro.props;
const chapterJumps = jumpLinks.flatMap((jump) => jumpsFromComponent(jump));
const chapterPlayerKey = chapterJumps.length ? String(component.legacyComponentId) : "";

function legacyField(fields: Record<string, string> | undefined, name: string): string {
  if (!fields) return "";
  const key = Object.keys(fields).find((item) => item.toLowerCase() === name.toLowerCase());
  return key ? String(fields[key] ?? "").trim() : "";
}

function hotspotFromPending(pending: MigrationPendingComponent) {
  const fields = pending.legacyFields;
  const image = legacyAssetUrl(legacyField(fields, "SPOTT_IMAGE"));
  if (!image) return null;
  const texts = new Map(numberedLegacyFields(fields, "SPOT_TEXT").map((item) => [item.index, item.value]));
  const locations = new Map(
    numberedLegacyFields(fields, "SPOT_LOCATION").map((item) => [item.index, item.value]),
  );
  const spots = numberedLegacyFields(fields, "SPOT_CORD").map((cord) => ({
    index: cord.index,
    text: texts.get(cord.index),
    style: cord.value,
    location: locations.get(cord.index),
  }));
  if (spots.length === 0) return null;
  const width = Number(legacyField(fields, "IMAGE_WIDTH"));
  const height = Number(legacyField(fields, "IMAGE_HEIGHT"));
  return {
    image,
    spots,
    imageWidth: Number.isFinite(width) && width > 0 ? width : undefined,
    imageHeight: Number.isFinite(height) && height > 0 ? height : undefined,
    wrapperStyle: legacyField(fields, "TopDiv") || undefined,
  };
}

const hotspot =
  component.type === "migrationPending" && component.legacyType === "Hotspot"
    ? hotspotFromPending(component)
    : null;
---

{
  component.type === "richText" ? (
    <div
      class="course-preview__richtext legacy-course__richtext"
      set:html={rewriteLegacyHtml(component.html)}
      data-legacy-component={component.legacyComponentId}
    />
  ) : component.type === "video" ? (
    <figure
      class="course-preview__video legacy-course__video"
      data-legacy-component={component.legacyComponentId}
    >
      {component.title ? (
        <figcaption class="course-preview__video-title">{component.title}</figcaption>
      ) : null}
      <VimeoEmbed
        vimeoId={component.vimeoId}
        title={component.title ?? "Course video"}
        playerKey={chapterPlayerKey}
      />
      {chapterJumps.length ? (
        <LegacyVimeoJumpLinks
          lessonId={component.legacyComponentId}
          vimeoId={component.vimeoId}
          playerKey={chapterPlayerKey}
          jumps={chapterJumps}
        />
      ) : null}
    </figure>
  ) : component.type === "download" ? (
    <p
      class="course-preview__download legacy-course__download"
      data-legacy-component={component.legacyComponentId}
    >
      <a
        class="kbm-btn kbm-btn-accent legacy-course__download-btn"
        href={downloadUrl(component.filename)}
        target="_blank"
        rel="noopener noreferrer"
      >
        {component.label}
      </a>
      {component.showInline ? (
        <span class="course-preview__download-note"> — inline viewer on legacy site</span>
      ) : null}
    </p>
  ) : component.type === "imageGallery" ? (
    <LegacyCourseImageCarousel
      legacyComponentId={component.legacyComponentId}
      introHtml={component.introHtml}
      title={component.title}
      slides={component.slides.map((slide) => ({
        src: slide.src,
        alt: slide.caption ?? "",
        caption: slide.caption ?? null,
        linkUrl: slide.linkUrl,
      }))}
    />
  ) : component.type === "image" ? (
    <LegacyCourseImage component={component} />
  ) : component.type === "imageCarousel" ? (
    <LegacyCourseImageCarousel
      legacyComponentId={component.legacyComponentId}
      introHtml={component.introHtml}
      title={component.title}
      slides={component.slides}
      countFormat={component.countFormat}
      class={component.className}
      slideLabels={component.slideLabels}
    />
  ) : component.type === "exerciseAccordion" ? (
    <div
      class="course-preview__exercise legacy-course__exercise"
      data-legacy-component={component.legacyComponentId}
    >
      {component.sections.map((section) => (
        <details class="course-preview__exercise-section">
          <summary set:html={section.title} />
          {section.iconSrc ? (
            <img
              class="course-preview__exercise-icon"
              src={legacyAssetUrl(section.iconSrc)}
              alt=""
              loading="lazy"
            />
          ) : null}
          {section.bodyHtml ? (
            <div
              class="course-preview__richtext"
              set:html={rewriteLegacyHtml(section.bodyHtml)}
            />
          ) : null}
        </details>
      ))}
    </div>
  ) : component.type === "embeddedTool" ? (
    <div
      class="course-preview__embedded-tool legacy-course__embedded-tool"
      data-legacy-component={component.legacyComponentId}
    >
      <EmbeddedTool
        toolKey={component.toolKey}
        instanceId={`lc-${component.legacyComponentId}`}
      />
    </div>
  ) : component.type === "vimeoJumpLinks" ||
    (component.type === "migrationPending" && component.legacyType === "VimeoJumpLinks") ? (
    <nav
      class="legacy-jumplinks"
      data-legacy-component={component.legacyComponentId}
      aria-label="In this video"
    >
      <h3>In this video:</h3>
      {jumpsFromComponent(component).map((jump) => (
        <div class="legacy-jumplink">{jumpLinkButtonLabel(jump)}</div>
      ))}
    </nav>
  ) : hotspot ? (
    <LegacyHotspot
      lessonId={component.legacyComponentId}
      image={hotspot.image}
      imageWidth={hotspot.imageWidth}
      imageHeight={hotspot.imageHeight}
      wrapperStyle={hotspot.wrapperStyle}
      spots={hotspot.spots}
    />
  ) : component.type === "migrationPending" ? (
    <aside
      class="course-preview__migration legacy-course__migration"
      role="alert"
      data-legacy-component={component.legacyComponentId}
    >
      <p class="course-preview__migration-heading">
        Migration pending: <code>{component.legacyType}</code>
      </p>
      <ul class="course-preview__migration-notes">
        {component.notes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </aside>
  ) : null
}
