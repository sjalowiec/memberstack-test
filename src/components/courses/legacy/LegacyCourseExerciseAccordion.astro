---
import {
  legacyAssetUrl,
  rewriteLegacyHtml,
} from "../../../lib/legacy_kin/coursePreviewPoc";

interface ExerciseSection {
  title: string;
  bodyHtml?: string;
  iconSrc?: string;
}

interface Props {
  sections: ExerciseSection[];
  legacyComponentId?: number;
}

const { sections, legacyComponentId } = Astro.props;
---

<div
  class="course-preview__exercise legacy-course__exercise"
  data-legacy-component={legacyComponentId}
>
  {
    sections.map((section) => (
      <details class="course-preview__exercise-section">
        <summary>
          <span class="course-preview__exercise-caret" aria-hidden="true" />
          <span class="course-preview__exercise-heading" set:html={section.title} />
        </summary>
        {section.iconSrc ? (
          <img
            class="course-preview__exercise-icon"
            src={legacyAssetUrl(section.iconSrc)}
            alt=""
            loading="lazy"
          />
        ) : null}
        {section.bodyHtml ? (
          <div class="course-preview__richtext" set:html={rewriteLegacyHtml(section.bodyHtml)} />
        ) : null}
      </details>
    ))
  }
</div>
