---
import type { CourseBlock } from "../../../lib/legacy_kin/coursePreviewPoc";
import {
  rewriteLegacyHtml,
} from "../../../lib/legacy_kin/coursePreviewPoc";
import {
  getAccordionLayoutParts,
  richTextHasVisibleContent,
} from "../../../lib/legacy_kin/courseAccordionLayout";
import LegacyCourseExerciseAccordion from "./LegacyCourseExerciseAccordion.astro";

interface Props {
  block: CourseBlock;
}

const { block } = Astro.props;
const parts = getAccordionLayoutParts(block);
---

{
  parts ? (
    <div class="course-preview__accordion-layout legacy-course__accordion-layout">
      {parts.introText &&
      richTextHasVisibleContent(String(parts.introText.html ?? "")) ? (
        <div
          class="course-preview__richtext legacy-course__richtext course-preview__accordion-intro"
          set:html={rewriteLegacyHtml(String(parts.introText.html ?? ""))}
          data-legacy-component={parts.introText.legacyComponentId}
        />
      ) : null}
      <LegacyCourseExerciseAccordion
        legacyComponentId={parts.accordion.legacyComponentId}
        sections={Array.isArray(parts.accordion.sections) ? parts.accordion.sections : []}
      />
    </div>
  ) : null
}
