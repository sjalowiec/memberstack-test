---
/**
 * Keep-access offer for a signed-in member who already has the course through
 * membership. Start Course stays the primary button on the course page.
 * The block stays hidden until Memberstack resolves. Owners and visitors
 * without a ready one-time price never see the buy button.
 */
import {
  courseCheckoutPriceId,
  coursePurchasePriceLabel,
  courseStandalonePurchaseReady,
  MEMBER_COURSE_INCLUDED_COPY,
  MEMBER_COURSE_KEEP_ACCESS_COPY,
  MEMBER_COURSE_OWNED_COPY,
} from "../../lib/kinCourse/coursePurchase";

interface Props {
  courseSlug: string;
}

const { courseSlug } = Astro.props;
const ready = courseStandalonePurchaseReady(courseSlug);
const priceId = courseCheckoutPriceId(courseSlug);
const priceLabel = coursePurchasePriceLabel(courseSlug);
---

{
  ready && priceId && priceLabel ? (
    <div class="member-course-keep" data-member-course-keep data-course-slug={courseSlug} hidden>
      <p class="member-course-keep__note" data-member-keep="included" hidden>
        {MEMBER_COURSE_INCLUDED_COPY}
      </p>
      <p class="member-course-keep__note" data-member-keep="owned" hidden>
        {MEMBER_COURSE_OWNED_COPY}
      </p>
      <div data-member-keep="buy" hidden>
        <button
          type="button"
          class="member-course-keep__buy"
          data-course-checkout
          data-member-course-keep-buy
          data-course-slug={courseSlug}
          data-course-price-id={priceId}
        >
          Buy for {priceLabel}
        </button>
        <p class="member-course-keep__keep">{MEMBER_COURSE_KEEP_ACCESS_COPY}</p>
      </div>
    </div>
  ) : null
}

<style>
  .member-course-keep {
    margin-top: 14px;
    max-width: 36rem;
  }

  .member-course-keep__note,
  .member-course-keep__keep {
    margin: 0;
    color: #4d5a48;
    font-size: 1rem;
    line-height: 1.45;
  }

  .member-course-keep__buy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    min-height: 44px;
    padding: 8px 16px;
    border-radius: 4px;
    border: 2px solid #52682d;
    background: #fff;
    color: #52682d;
    font-family: inherit;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
  }

  .member-course-keep__buy:hover,
  .member-course-keep__buy:focus-visible {
    background: #f4f6ee;
    color: #3f5123;
    border-color: #3f5123;
    outline: 3px solid #52682d;
    outline-offset: 2px;
  }

  .member-course-keep__keep {
    margin-top: 8px;
  }
</style>
