---
/**
 * Public Beginner Workshop overview. Lesson HTML is not rendered here.
 * Start links to the Course 33 player. Lessons stay on their existing routes.
 */
import Layout from "../../layouts/Layout.astro";
import KinCourse33Sales from "./KinCourse33Sales.astro";
import { BEGINNER_WORKSHOP_COURSE_SLUG } from "../../config/legacyCourseEntitlements";
import { KIN_BEGINNER_WORKSHOP_SALES_COPY } from "../../lib/kinCourse/courseSalesCopy";

const pageTitle = "Beginner Workshop | Knit it Now";
---

<Layout
  title={pageTitle}
  description={KIN_BEGINNER_WORKSHOP_SALES_COPY.metaDescription}
  bodyClass="page--tight-header"
>
  <div class="beginner-workshop-sales">
    <KinCourse33Sales
      courseSlug={BEGINNER_WORKSHOP_COURSE_SLUG}
      thumbnailSrc="/images/courses/beginner.webp"
      thumbnailAlt="Beginner Workshop"
    />
  </div>
  <script>
    import { runKinCourseAccessGateBoot } from "../../scripts/kinCourseAccessGate";

    runKinCourseAccessGateBoot();
  </script>
</Layout>

<style>
  .beginner-workshop-sales {
    padding: 32px 16px 64px;
    background: #f7f7f7;
  }
</style>
