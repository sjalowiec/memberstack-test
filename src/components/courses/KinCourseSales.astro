---
/**
 * Shared KIN course sales page. Course 86 and Course 111 pass their own copy.
 * Access rules stay in canAccessCourse / kinCourseAccessGate. Members and
 * owners never see this because the gate paints the player instead.
 */
import CoursePurchaseButton from "./CoursePurchaseButton.astro";
import { getCourseCatalogEntries } from "../../lib/coursesCatalog";
import { getCourseAccessBySlug } from "../../lib/coursesCatalogAccess";
import { canonicalCourseCatalogSlug } from "../../config/legacyCourseEntitlements";
import {
  courseCheckoutPriceId,
  coursePurchasePriceLabel,
} from "../../lib/kinCourse/coursePurchase";
import type { KinCourseSalesAccessCta, KinCourseSalesCopy } from "../../lib/kinCourse/courseSalesCopy";

interface Props {
  courseSlug: string;
  copy: KinCourseSalesCopy;
  thumbnailSrc?: string;
  thumbnailAlt?: string;
}

const { courseSlug, copy, thumbnailSrc, thumbnailAlt } = Astro.props;
const catalogSlug = canonicalCourseCatalogSlug(courseSlug);
const catalogEntry = getCourseCatalogEntries().find((entry) => entry.slug === catalogSlug);
const imageSrc = (thumbnailSrc || catalogEntry?.thumbnail || "").trim();
const imageAlt = (thumbnailAlt || catalogEntry?.title || copy.fallbackImageAlt).trim();
const priceId = courseCheckoutPriceId(courseSlug);
const priceLabel = coursePurchasePriceLabel(courseSlug);
const accessCta: KinCourseSalesAccessCta | null = copy.accessCta ?? null;
const salesAccess = getCourseAccessBySlug(courseSlug);
const purchaseInfoItems = (copy.purchaseInfo?.items ?? [])
  .map((item) => (priceLabel ? item.replace(/\{price\}/g, priceLabel) : item))
  .filter((item) => !item.includes("{price}"));
---

<article class="kin-course-sales">
  <header class="kin-course-sales__hero">
    <div class="kin-course-sales__titles">
      {
        copy.courseTitle ? (
          <h1 class="kin-course-sales__course-title">{copy.courseTitle}</h1>
        ) : null
      }
      {
        copy.courseTitle ? (
          <h2 class="kin-course-sales__headline">{copy.headline}</h2>
        ) : (
          <h1 class="kin-course-sales__headline">{copy.headline}</h1>
        )
      }
    </div>
    {
      imageSrc ? (
        <figure class="kin-course-sales__figure">
          <img
            class="kin-course-sales__image"
            src={imageSrc}
            alt={imageAlt}
            width="600"
            height="338"
          />
        </figure>
      ) : null
    }
    <div class="kin-course-sales__intro">
      {copy.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </header>

  {
    copy.blocks?.length ? (
      copy.blocks.map((block) =>
        block.kind === "cta" && accessCta ? (
          <section class="kin-course-sales__cta">
            <div
              class="kin-course-sales-cta"
              data-kin-course-sales-cta
              data-course-slug={courseSlug}
              data-course-access={salesAccess}
            >
              <p class="kin-course-sales__checkout-status" data-sales-cta="pending" role="status">
                Checking access…
              </p>
              <div data-sales-cta="open" hidden>
                <div class="kin-course-sales__buy-row">
                  <a class="course-home-start kin-course-sales__join" href={accessCta.startHref}>
                    {accessCta.startLabel}
                  </a>
                </div>
              </div>
              <div data-sales-cta="loggedOut" hidden>
                <div class="kin-course-sales__buy-row">
                  <a class="course-home-start kin-course-sales__join" href={accessCta.joinHref}>
                    {accessCta.joinLabel}
                  </a>
                </div>
                <p class="kin-course-sales__owner">
                  {accessCta.signInBefore}{" "}
                  <button type="button" class="kin-course-sales__signin" data-course-111-login>
                    {accessCta.signInLabel}
                  </button>{" "}
                  {accessCta.signInAfter}
                </p>
              </div>
              <div data-sales-cta="loggedInNoAccess" hidden>
                <div class="kin-course-sales__buy-row">
                  <a class="course-home-start kin-course-sales__join" href={accessCta.memberHref}>
                    {accessCta.memberLabel}
                  </a>
                </div>
              </div>
            </div>
          </section>
        ) : block.kind === "prose" ? (
          <section class="kin-course-sales__benefits">
            <h2>{block.heading}</h2>
            {block.paragraphs.map((paragraph) => (
              <p class="kin-course-sales__prose">{paragraph}</p>
            ))}
          </section>
        ) : block.kind === "points" ? (
          <section class="kin-course-sales__benefits">
            <h2>{block.heading}</h2>
            <ul>
              {block.points.map((point) => (
                <li>
                  <strong>{point.title}:</strong> {point.text}
                </li>
              ))}
            </ul>
          </section>
        ) : null,
      )
    ) : (
      <>
        <section class="kin-course-sales__benefits" aria-labelledby="kin-course-sales-benefits-heading">
          <h2 id="kin-course-sales-benefits-heading">{copy.benefitsHeading}</h2>
          <ul>
            {copy.benefits.map((benefit) => (
              <li>{benefit}</li>
            ))}
          </ul>
          <p class="kin-course-sales__support">{copy.supportingCopy}</p>
        </section>

        <section class="kin-course-sales__cta" aria-labelledby="kin-course-sales-cta-heading">
          <h2 id="kin-course-sales-cta-heading">{copy.ctaHeading}</h2>
          {
            copy.accessLine ? (
              <p class="kin-course-sales__access">{copy.accessLine}</p>
            ) : null
          }
          {
            accessCta ? (
              <div
                class="kin-course-sales-cta"
                data-kin-course-sales-cta
                data-course-slug={courseSlug}
                data-course-access={salesAccess}
              >
                <p class="kin-course-sales__checkout-status" data-sales-cta="pending" role="status">
                  Checking access…
                </p>
                <div data-sales-cta="open" hidden>
                  <div class="kin-course-sales__buy-row">
                    <a class="course-home-start kin-course-sales__join" href={accessCta.startHref}>
                      {accessCta.startLabel}
                    </a>
                  </div>
                </div>
                <div data-sales-cta="loggedOut" hidden>
                  <div class="kin-course-sales__buy-row">
                    <a class="course-home-start kin-course-sales__join" href={accessCta.joinHref}>
                      {accessCta.joinLabel}
                    </a>
                  </div>
                  <p class="kin-course-sales__owner">
                    {accessCta.signInBefore}{" "}
                    <button type="button" class="kin-course-sales__signin" data-course-111-login>
                      {accessCta.signInLabel}
                    </button>{" "}
                    {accessCta.signInAfter}
                  </p>
                </div>
                <div data-sales-cta="loggedInNoAccess" hidden>
                  <div class="kin-course-sales__buy-row">
                    <a class="course-home-start kin-course-sales__join" href={accessCta.memberHref}>
                      {accessCta.memberLabel}
                    </a>
                  </div>
                </div>
              </div>
            ) : (
              <>
                <div class="kin-course-sales__buy-row">
                  {
                    priceLabel ? (
                      <p class="kin-course-sales__price">
                        <span class="kin-course-sales__price-value">{priceLabel}</span>
                      </p>
                    ) : null
                  }
                  {
                    priceId ? (
                      <CoursePurchaseButton
                        courseSlug={courseSlug}
                        label={copy.purchaseButtonLabel}
                        className="course-home-start kin-course-sales__buy"
                      />
                    ) : null
                  }
                </div>
                <p class="kin-course-sales__checkout-status" data-course-checkout-status hidden role="status"></p>
                <p class="kin-course-sales__owner" data-gate-copy="loggedOut">
                  {copy.ownerBefore}{" "}
                  <button type="button" class="kin-course-sales__signin" data-course-111-login>
                    {copy.ownerAction}
                  </button>{" "}
                  {copy.ownerAfter}
                </p>
                <div data-gate-copy="loggedInNoAccess" hidden></div>
              </>
            )
          }
        </section>
      </>
    )
  }

  {
    copy.purchaseInfo && purchaseInfoItems.length ? (
      <section class="kin-course-sales__info" aria-labelledby="kin-course-sales-info-heading">
        <h2 id="kin-course-sales-info-heading">{copy.purchaseInfo.heading}</h2>
        <ul>
          {purchaseInfoItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    ) : null
  }

  {
    copy.faq ? (
      <section class="kin-course-sales__faq" aria-labelledby="kin-course-sales-faq-heading">
        <h2 id="kin-course-sales-faq-heading">{copy.faq.heading}</h2>
        <dl>
          {copy.faq.items.map((item) => (
            <>
              <dt>{item.question}</dt>
              <dd>{item.answer}</dd>
            </>
          ))}
        </dl>
      </section>
    ) : null
  }
</article>

<style>
  .kin-course-sales {
    max-width: 960px;
    margin: 0 auto;
    color: #222;
  }

  .kin-course-sales__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 42%);
    grid-template-areas:
      "headline image"
      "intro image";
    gap: 12px 40px;
    align-items: start;
    margin-bottom: 28px;
  }

  .kin-course-sales__titles {
    grid-area: headline;
  }

  .kin-course-sales__course-title,
  .kin-course-sales__headline {
    margin: 0;
    font-family: var(--kin-chrome-font, "Poppins", sans-serif);
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: #1a1a1a;
  }

  .kin-course-sales__course-title {
    margin-bottom: 4px;
  }

  h2.kin-course-sales__headline {
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 600;
  }

  .kin-course-sales__figure {
    grid-area: image;
    margin: 0;
    overflow: hidden;
    border-radius: 10px;
  }

  .kin-course-sales__image {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #d7d7d7;
    border-radius: 10px;
    background: #fff;
  }

  .kin-course-sales__intro {
    grid-area: intro;
  }

  .kin-course-sales__intro p,
  .kin-course-sales__support,
  .kin-course-sales__access {
    margin: 0 0 12px;
    font-size: 1.05rem;
    line-height: 1.55;
    color: #222;
  }

  .kin-course-sales__intro p:last-child,
  .kin-course-sales__support {
    margin-bottom: 0;
  }

  .kin-course-sales__prose {
    margin: 0 0 12px;
    font-size: 1.05rem;
    line-height: 1.55;
    color: #222;
  }

  .kin-course-sales__prose:last-child {
    margin-bottom: 0;
  }

  .kin-course-sales :global(a.kin-course-sales__join) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 12px 22px;
    border-radius: 4px;
    border: 2px solid #52682d;
    background: #52682d;
    color: #fff;
    font-size: 18px;
    line-height: 1.3;
    font-weight: 700;
    text-decoration: none;
  }

  .kin-course-sales :global(a.kin-course-sales__join:link),
  .kin-course-sales :global(a.kin-course-sales__join:visited),
  .kin-course-sales :global(a.kin-course-sales__join:hover),
  .kin-course-sales :global(a.kin-course-sales__join:focus),
  .kin-course-sales :global(a.kin-course-sales__join:focus-visible) {
    color: #fff;
    text-decoration: none;
  }

  .kin-course-sales :global(a.kin-course-sales__join:hover),
  .kin-course-sales :global(a.kin-course-sales__join:focus-visible) {
    background: #3f5123;
    border-color: #3f5123;
  }

  .kin-course-sales__benefits,
  .kin-course-sales__cta,
  .kin-course-sales__info,
  .kin-course-sales__faq {
    margin: 0 0 28px;
  }

  .kin-course-sales__benefits h2,
  .kin-course-sales__cta h2,
  .kin-course-sales__info h2,
  .kin-course-sales__faq h2 {
    margin: 0 0 12px;
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 700;
    color: #1a1a1a;
  }

  .kin-course-sales__benefits ul,
  .kin-course-sales__info ul {
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }

  .kin-course-sales__benefits li,
  .kin-course-sales__info li {
    margin: 0 0 8px;
    padding-left: 18px;
    position: relative;
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .kin-course-sales__benefits li::before,
  .kin-course-sales__info li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #52682d;
  }

  .kin-course-sales__info ul {
    margin-bottom: 0;
  }

  .kin-course-sales__info li {
    font-size: 1rem;
  }

  .kin-course-sales__buy-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }

  .kin-course-sales__price {
    margin: 0;
    color: #52682d;
  }

  .kin-course-sales__price-value {
    display: inline-block;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  :global(button.kin-course-sales__buy) {
    cursor: pointer;
    font-family: inherit;
  }

  .kin-course-sales__checkout-status {
    margin: 10px 0 0;
    font-size: 0.88rem;
    color: #4d5a48;
  }

  .kin-course-sales__checkout-status[data-tone="error"] {
    color: #b91c1c;
  }

  .kin-course-sales__owner {
    margin: 14px 0 0;
    font-size: 0.98rem;
    color: #4d5a48;
  }

  .kin-course-sales__signin {
    padding: 0;
    border: 0;
    background: none;
    color: #52682d;
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.12em;
    cursor: pointer;
  }

  .kin-course-sales__signin:hover,
  .kin-course-sales__signin:focus-visible {
    color: #3f5123;
  }

  .kin-course-sales__faq {
    max-width: 40rem;
  }

  .kin-course-sales__faq dl {
    margin: 0;
  }

  .kin-course-sales__faq dt {
    margin: 12px 0 4px;
    font-size: 1rem;
    font-weight: 600;
    color: #1a1a1a;
  }

  .kin-course-sales__faq dt:first-child {
    margin-top: 0;
  }

  .kin-course-sales__faq dd {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.45;
    color: #4d5a48;
  }

  @media (max-width: 900px) {
    .kin-course-sales__hero {
      grid-template-columns: 1fr;
      grid-template-areas:
        "headline"
        "image"
        "intro";
      gap: 16px;
    }

    .kin-course-sales__course-title,
    .kin-course-sales__headline {
      font-size: 1.7rem;
    }

    h2.kin-course-sales__headline {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 767px) {
    .kin-course-sales__course-title,
    .kin-course-sales__headline {
      font-size: 1.45rem;
    }

    h2.kin-course-sales__headline {
      font-size: 1.15rem;
    }

    .kin-course-sales__buy-row :global(.course-home-start),
    .kin-course-sales__buy-row :global(a.kin-course-sales__join) {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  import { runKinCourseSalesCtaBoot } from "../../scripts/kinCourseSalesCta";

  runKinCourseSalesCtaBoot();
</script>
