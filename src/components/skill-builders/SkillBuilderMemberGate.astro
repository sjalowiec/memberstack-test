---
import MemberLockOverlay from "../ui/MemberLockOverlay.astro";
import SkillBuilderFeedback from "./SkillBuilderFeedback.astro";
import { getSkillBuilderFeedbackConfig } from "../../lib/skillBuilders/skillBuilderFeedback";
import {
  SKILL_BUILDER_MEMBER_LOCK_CTA,
  SKILL_BUILDER_MEMBER_LOCK_MESSAGE,
  SKILL_BUILDER_MEMBER_LOCK_TITLE,
  SKILL_BUILDER_MEMBER_PENDING_COPY,
} from "../../lib/skillBuilders/skillBuilderMemberGate";

interface Props {
  /** Existing Skill Builder module id. When set, practice feedback is appended automatically. */
  builderId?: string;
}

const { builderId } = Astro.props;
const feedback = builderId ? getSkillBuilderFeedbackConfig(builderId) : null;
---

<div class="sb-member-lock" data-sb-member-lock data-gated="pending" data-gate-pending>
  <p class="sb-member-lock__pending" data-sb-member-pending role="status">
    {SKILL_BUILDER_MEMBER_PENDING_COPY}
  </p>
  <div data-sb-member-locked hidden aria-hidden="true">
    <MemberLockOverlay
      title={SKILL_BUILDER_MEMBER_LOCK_TITLE}
      message={SKILL_BUILDER_MEMBER_LOCK_MESSAGE}
      ctaText={SKILL_BUILDER_MEMBER_LOCK_CTA}
    />
  </div>
</div>
<template data-sb-member-body-template>
  <slot />
  {
    feedback ? (
      <SkillBuilderFeedback
        skillBuilderId={feedback.id}
        title={feedback.title}
      />
    ) : null
  }
  <slot name="after-feedback" />
</template>
<div data-sb-member-body-mount hidden></div>

<script>
  import { bindSkillBuilderMemberGate } from "../../lib/skillBuilders/skillBuilderMemberGate";

  function start(): void {
    bindSkillBuilderMemberGate();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
</script>

<style>
  .sb-member-lock {
    position: relative;
    margin: 0.5rem 0 1.5rem;
  }

  .sb-member-lock__pending {
    margin: 0.35rem 0 0.85rem;
    color: #4b5563;
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .sb-member-lock[data-gated="pending"] :global([data-sb-member-locked]),
  .sb-member-lock[data-gate-pending] :global([data-sb-member-locked]) {
    display: none;
  }

  .sb-member-lock :global(.member-lock-overlay) {
    position: relative;
    inset: auto;
    padding: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .sb-member-lock :global(.member-lock-overlay-inner) {
    transform: none;
    max-width: 28rem;
  }
</style>
