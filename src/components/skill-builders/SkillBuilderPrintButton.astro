---
/**
 * Reusable Skill Builder print control. Calls window.print() and loads
 * skill-builders-print.css. Add data-sb-print-hide to regions that should
 * not appear on the printed sheet.
 */
import "../../styles/skill-builders-print.css";

interface Props {
  label?: string;
  ariaLabel?: string;
}

const { label = "Print Practice", ariaLabel } = Astro.props;
---

<button
  type="button"
  class="sb-print-button"
  data-sb-print-button
  aria-label={ariaLabel ?? label}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="6 9 6 2 18 2 18 9"></polyline>
    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
    <rect x="6" y="14" width="12" height="8"></rect>
  </svg>
  {label}
</button>

<script>
  import { bindSkillBuilderPrintButtons } from "../../lib/skillBuilders/skillBuilderPrint";

  bindSkillBuilderPrintButtons();
</script>
