---
import {
  ROUND_NECKLINE_SKILL_BUILDERS,
  skillBuilderExercisePath,
  type RoundNecklineSkillBuilderId,
} from "../../lib/skillBuilders/roundNecklineSkillBuilders";
import { skillBuilderVideoSlot } from "../../lib/skillBuilders/roundNecklineSkillBuilderVideos";
import SkillBuilderPageHeader from "./SkillBuilderPageHeader.astro";
import GatedVimeoEmbed from "../videos/GatedVimeoEmbed.astro";

interface Props {
  builderId: RoundNecklineSkillBuilderId;
}

const { builderId } = Astro.props;
const builder = ROUND_NECKLINE_SKILL_BUILDERS[builderId];
const video = skillBuilderVideoSlot(builderId);
---

<div class="sb-landing">
  <a class="sb-landing__back" href="/learn/skill-builders">Skill Builders</a>

  <header class="sb-landing__hero">
    <SkillBuilderPageHeader title={builder.title} />
    <p class="sb-landing__purpose">{builder.purpose}</p>
    {
      builder.prerequisiteNote && (
        <p class="sb-landing__note">{builder.prerequisiteNote}</p>
      )
    }
  </header>

  {
    video && (
      <section class="sb-landing__video" aria-label="Video">
        <h2>Watch</h2>
        <GatedVimeoEmbed videoId={video.vimeoId} title={video.title ?? builder.title} access_level="open" />
      </section>
    )
  }

  <section aria-labelledby="sb-landing-exercises">
    <h2 id="sb-landing-exercises">Choose a practice</h2>
    <ul class="sb-landing__list">
      {
        builder.exercises.map((exercise) => (
          <li>
            <a class="sb-landing__card" href={skillBuilderExercisePath(builderId, exercise.id)}>
              <span class="sb-landing__card-title">{exercise.title}</span>
              <span class="sb-landing__card-copy">{exercise.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</div>

<style>
  .sb-landing {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 20px 3.5rem;
  }

  .sb-landing__back {
    display: inline-block;
    margin: 0.25rem 0 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
    text-decoration: none;
  }

  .sb-landing__back:hover,
  .sb-landing__back:focus {
    color: #52682d;
  }

  .sb-landing__hero {
    margin: 0.5rem 0 1.75rem;
  }

  .sb-landing :global(h1) {
    margin: 0;
    font-size: clamp(1.55rem, 3vw, 1.95rem);
    font-weight: 600;
    color: #52682d;
    line-height: 1.2;
  }

  .sb-landing h2 {
    margin: 0 0 0.85rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: #52682d;
    padding-bottom: 0.45rem;
    border-bottom: 2px solid #c7d8a4;
  }

  .sb-landing__purpose {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #4d5a48;
  }

  .sb-landing__note {
    margin: 1rem 0 0;
    padding: 0.75rem 0.95rem;
    background: #f8faf6;
    border: 1px solid #e8ece3;
    border-radius: 8px;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #4d5a48;
  }

  .sb-landing__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sb-landing__card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    text-decoration: none;
    color: inherit;
  }

  .sb-landing__card:hover,
  .sb-landing__card:focus {
    border-color: #52682d;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.1);
    outline: none;
  }

  .sb-landing__card-title {
    font-size: 1rem;
    font-weight: 600;
    color: #52682d;
    line-height: 1.35;
  }

  .sb-landing__card-copy {
    font-size: 0.92rem;
    line-height: 1.5;
    color: #4d5a48;
  }

  .sb-landing__video {
    margin-bottom: 1.75rem;
  }

  @media (max-width: 600px) {
    .sb-landing {
      padding-inline: 16px;
    }
  }
</style>
