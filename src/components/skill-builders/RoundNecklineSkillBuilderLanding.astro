---
import SkillBuilderPageHeader from "./SkillBuilderPageHeader.astro";
import SkillBuilderMemberGate from "./SkillBuilderMemberGate.astro";
import RoundNecklineSkillBuilderLandingBody from "./RoundNecklineSkillBuilderLandingBody.astro";
import {
  ROUND_NECKLINE_SKILL_BUILDERS,
  parseRoundNecklinePracticeId,
  roundNecklineSkillBuilderIsMemberOnly,
  type RoundNecklineSkillBuilderExerciseId,
  type RoundNecklineSkillBuilderId,
} from "../../lib/skillBuilders/roundNecklineSkillBuilders";

interface Props {
  builderId: RoundNecklineSkillBuilderId;
  memberOnly?: boolean;
  initialExerciseId?: RoundNecklineSkillBuilderExerciseId;
}

const { builderId, memberOnly = roundNecklineSkillBuilderIsMemberOnly(builderId) } = Astro.props;
const builder = ROUND_NECKLINE_SKILL_BUILDERS[builderId];
const initialExerciseId =
  parseRoundNecklinePracticeId(Astro.props.initialExerciseId) ?? builder.exercises[0]!.id;
---

<div
  class="sb-landing"
  data-sb-round-neckline-exercise
  data-sb-builder={builderId}
  data-sb-exercise={initialExerciseId}
>
  <a class="sb-landing__back" href="/learn/skill-builders">Skill Builders</a>

  <header class="sb-landing__hero">
    <SkillBuilderPageHeader title={builder.title} />
  </header>

  {
    memberOnly ? (
      <SkillBuilderMemberGate>
        <RoundNecklineSkillBuilderLandingBody
          builderId={builderId}
          initialExerciseId={initialExerciseId}
          memberOnly
        />
      </SkillBuilderMemberGate>
    ) : (
      <RoundNecklineSkillBuilderLandingBody
        builderId={builderId}
        initialExerciseId={initialExerciseId}
      />
    )
  }
</div>

<style>
  .sb-landing {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 20px 3.5rem;
    overflow-x: hidden;
  }

  .sb-landing__back {
    display: inline-block;
    margin: 0.25rem 0 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
    text-decoration: none;
  }

  .sb-landing__back:hover,
  .sb-landing__back:focus {
    color: #52682d;
  }

  .sb-landing__hero {
    margin: 0.5rem 0 1.25rem;
  }

  .sb-landing :global(h1) {
    margin: 0;
    font-size: clamp(1.55rem, 3vw, 1.95rem);
    font-weight: 600;
    color: #52682d;
    line-height: 1.2;
  }

  @media (max-width: 600px) {
    .sb-landing {
      padding-inline: 16px;
    }
  }

  @media print {
    .sb-landing {
      max-width: none;
      padding: 0;
      overflow: visible;
    }

    .sb-landing__back {
      display: none;
    }
  }
</style>

<script>
  import { bindRoundNecklineSkillBuilderPage } from "../../lib/skillBuilders/roundNecklineSkillBuilderPage";
  import { SKILL_BUILDER_MEMBER_BODY_MOUNTED_EVENT } from "../../lib/skillBuilders/skillBuilderMemberGate";

  function start(): void {
    bindRoundNecklineSkillBuilderPage();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }

  window.addEventListener(SKILL_BUILDER_MEMBER_BODY_MOUNTED_EVENT, start);
</script>
