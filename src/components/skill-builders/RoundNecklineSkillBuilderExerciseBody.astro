---
import "../../styles/shaping-map.css";
import "../../styles/ns-shaping-chart.css";
import "../../styles/pattern-tips.css";
import SkillBuilderGaugeInput from "./SkillBuilderGaugeInput.astro";
import PrintButton from "../common/PrintButton.astro";
import GatedVimeoEmbed from "../videos/GatedVimeoEmbed.astro";
import {
  ROUND_NECKLINE_SKILL_BUILDERS,
  type RoundNecklineSkillBuilderExerciseId,
  type RoundNecklineSkillBuilderId,
} from "../../lib/skillBuilders/roundNecklineSkillBuilders";
import {
  skillBuilderVideoHelperCopy,
  skillBuilderVideoSlot,
} from "../../lib/skillBuilders/roundNecklineSkillBuilderVideos";

interface Props {
  builderId: RoundNecklineSkillBuilderId;
  exerciseId: RoundNecklineSkillBuilderExerciseId;
  memberOnly?: boolean;
}

const { builderId, exerciseId, memberOnly = false } = Astro.props;
const builder = ROUND_NECKLINE_SKILL_BUILDERS[builderId];
const exercise = builder.exercises.find((item) => item.id === exerciseId);
if (!exercise) {
  throw new Error(`Unknown Skill Builder exercise: ${builderId}/${exerciseId}`);
}
const practiceVideos = builder.exercises
  .map((item) => ({
    id: item.id,
    title: item.title,
    video: skillBuilderVideoSlot(`${builderId}/${item.id}`),
  }))
  .filter((item) => item.video);
const gaugeId = `sb-${builderId}`;
---

<section class="sb-practice-panel no-print" data-sb-setup aria-labelledby="sb-gauge-heading">
  <h2 id="sb-gauge-heading" class="sb-practice-panel__title">Your Gauge</h2>
  <p class="sb-practice-panel__note">
    Enter your gauge to create <strong>custom practice instructions</strong> for <strong>YOUR machine and yarn.</strong>
  </p>
  <SkillBuilderGaugeInput id={gaugeId} />
  <button
    type="button"
    class="sb-create-practice"
    data-sb-create-practice
    hidden
    disabled
  >
    GET KNITTING
  </button>
  <p
    class="sb-lead-error"
    hidden
    data-sb-create-error
    role="alert"
  ></p>
</section>

{
  !memberOnly && (
    <section
      class="sb-lead-capture no-print"
      data-sb-lead-capture
      hidden
      aria-labelledby="sb-lead-heading"
    >
      <h2 id="sb-lead-heading" class="sb-lead-capture__title">Ready to practice?</h2>
      <p class="sb-lead-capture__copy">
        Enter your email to create your personalized Round Neckline practice instructions.
      </p>
      <form class="sb-lead-capture__form" data-sb-lead-form novalidate>
        <p class="sb-lead-capture__honeypot" aria-hidden="true">
          <label for={`${gaugeId}-lead-bot`}>Company</label>
          <input
            type="text"
            id={`${gaugeId}-lead-bot`}
            name="bot-field"
            data-sb-lead-bot
            tabindex="-1"
            autocomplete="off"
          />
        </p>
        <div class="sb-lead-capture__field">
          <label class="sb-lead-capture__label" for={`${gaugeId}-lead-email`}>
            Email address
            <span class="sb-lead-capture__required" aria-hidden="true">*</span>
            <span class="sb-lead-capture__sr-only">(required)</span>
          </label>
          <input
            class="sb-lead-capture__input"
            id={`${gaugeId}-lead-email`}
            name="email"
            type="email"
            data-sb-lead-email
            autocomplete="email"
            maxlength="254"
            required
            aria-required="true"
            inputmode="email"
          />
        </div>
        <button
          type="submit"
          class="sb-create-practice"
          data-sb-lead-submit
        >
          Create My Practice Instructions
        </button>
        <p class="sb-lead-capture__helper">Free. No membership required.</p>
        <p class="sb-lead-capture__consent">
          By signing up, you agree to receive emails from Knit It Now. You can unsubscribe at
          any time. See our
          <a href="/privacy">Privacy Policy</a>.
        </p>
        <p
          class="sb-lead-error"
          hidden
          data-sb-lead-error
          role="alert"
        ></p>
      </form>
    </section>
  )
}

<div id="sb-practice-results" class="sb-practice-results" data-sb-results hidden>
  <p class="sb-gauge-print" data-sb-gauge-print></p>

  <section class="sb-get-started" aria-labelledby="sb-get-started-heading">
    <div class="sb-get-started__grid">
      <div class="sb-get-started__instructions">
        <h2 id="sb-get-started-heading">Get Started</h2>
        <ol class="sb-get-started__steps" data-sb-get-started></ol>
      </div>
      <div class="sb-get-started__diagram" aria-labelledby="sb-diagram-heading">
        <h2 id="sb-diagram-heading">Your Practice Piece</h2>
        <div class="sb-practice-diagram" data-sb-diagram aria-hidden="true"></div>
      </div>
    </div>
  </section>

  {
    practiceVideos.map(({ id, title, video }) => {
      const helper = skillBuilderVideoHelperCopy(`${builderId}/${id}`);
      return (
        video &&
        helper && (
          <aside
            class="sb-video-helper no-print"
            aria-labelledby={`sb-video-help-heading-${id}`}
            data-sb-video-exercise={id}
            data-sb-video-content-id={String(video.contentId)}
            hidden={id !== exerciseId}
          >
            <h3 id={`sb-video-help-heading-${id}`}>{helper.heading}</h3>
            {
              helper.notes.map((note) => (
                <p class="sb-video-helper__note">
                  {note.lead ? (
                    <>
                      <strong>{note.lead}</strong> {note.text}
                    </>
                  ) : (
                    note.text
                  )}
                </p>
              ))
            }
            <div class="sb-video-helper__embed">
              <GatedVimeoEmbed
                videoId={video.vimeoId}
                title={video.title ?? title}
                access_level={memberOnly ? "member" : "open"}
                privacyHash={video.privacyHash ?? ""}
              />
            </div>
          </aside>
        )
      );
    })
  }

  <section class="sb-card sb-shoulders" aria-labelledby="sb-shoulders-heading">
    <h2 id="sb-shoulders-heading">Shape the Shoulders</h2>
    <div class="sb-shoulder-tabs" data-sb-shoulder-tabs>
      <div class="sb-shoulder-tabs__list no-print" role="tablist" aria-label="Shoulder">
        <button
          type="button"
          class="sb-shoulder-tabs__tab"
          role="tab"
          id="sb-tab-left"
          aria-controls="sb-panel-left"
          aria-selected="true"
          tabindex="0"
        >
          Left Shoulder
        </button>
        <button
          type="button"
          class="sb-shoulder-tabs__tab"
          role="tab"
          id="sb-tab-right"
          aria-controls="sb-panel-right"
          aria-selected="false"
          tabindex="-1"
        >
          Right Shoulder
        </button>
      </div>

      <div
        class="sb-shoulder-tabs__panel"
        role="tabpanel"
        id="sb-panel-left"
        data-sb-shoulder-panel="left"
        aria-labelledby="sb-tab-left"
      >
        <h3 class="sb-shoulder-print-title">Left Shoulder</h3>
        <p class="sb-shoulder-note">Work the left shoulder after binding off the center neck stitches.</p>
        <div class="sb-shoulder-checklist" data-sb-shoulder-checklist="left"></div>
      </div>

      <div
        class="sb-shoulder-tabs__panel"
        role="tabpanel"
        id="sb-panel-right"
        data-sb-shoulder-panel="right"
        aria-labelledby="sb-tab-right"
        aria-hidden="true"
        hidden
      >
        <h3 class="sb-shoulder-print-title">Right Shoulder</h3>
        <p class="sb-shoulder-note">
          Rehang the right shoulder. Reset the row counter to 000, then follow this reversed checklist.
        </p>
        <div class="sb-shoulder-checklist" data-sb-shoulder-checklist="right"></div>
      </div>
    </div>
  </section>

  <section class="sb-worksheet__section" aria-labelledby="sb-finish-heading">
    <h2 id="sb-finish-heading">Finish</h2>
    <ul class="sb-finish-list">
      <li>Scrap off the remaining live shoulder stitches onto waste yarn.</li>
      <li>Keep this practice piece for the shoulder-joining and neckband-finishing practice.</li>
    </ul>
  </section>

  <section class="sb-worksheet__section no-print" aria-labelledby="sb-print-heading">
    <h2 id="sb-print-heading">Print Worksheet</h2>
    <PrintButton label="Print Worksheet" />
  </section>
</div>

<style>
  .sb-practice-panel {
    margin-bottom: 1.1rem;
    padding: 1.15rem 1.25rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .sb-practice-panel__title {
    margin: 0 0 0.45rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: #52682d;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid #c7d8a4;
  }

  .sb-practice-panel__note {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.5;
    color: #4d5a48;
  }

  .sb-practice-panel__note strong {
    font-weight: 700;
  }

  .sb-practice-panel :global(.gauge-input-wrapper) {
    margin-bottom: 0;
  }

  .sb-create-practice {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.7rem 1.2rem;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
    background: var(--kbm-accent, #C2614E);
    border: none;
    border-radius: 8px;
    cursor: pointer;
  }

  .sb-create-practice:hover,
  .sb-create-practice:focus-visible {
    background: var(--kbm-accent-hover, #a94e3d);
    outline: none;
  }

  .sb-create-practice[hidden] {
    display: none !important;
  }

  .sb-lead-capture {
    margin-bottom: 1.1rem;
    padding: 1.15rem 1.25rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .sb-lead-capture[hidden] {
    display: none !important;
  }

  .sb-lead-capture__title {
    margin: 0 0 0.45rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: #52682d;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid #c7d8a4;
  }

  .sb-lead-capture__copy {
    margin: 0 0 0.85rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #4d5a48;
  }

  .sb-lead-capture__field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 0.85rem;
  }

  .sb-lead-capture__label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1f2937;
  }

  .sb-lead-capture__required {
    color: var(--kbm-green, #52682d);
    margin-left: 0.15rem;
  }

  .sb-lead-capture__input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.55rem 0.7rem;
    border: 1px solid #c5cbb8;
    border-radius: 8px;
    font: inherit;
    font-size: 1rem;
    color: #1f2937;
    background: #fff;
  }

  .sb-lead-capture__input:focus-visible {
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }

  .sb-lead-capture__helper {
    margin: 0.65rem 0 0;
    font-size: 0.88rem;
    color: #4d5a48;
  }

  .sb-lead-capture__consent {
    margin: 0.55rem 0 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: #4b5563;
  }

  .sb-lead-capture__consent a {
    color: #52682d;
    font-weight: 600;
    text-decoration: underline;
  }

  .sb-lead-error {
    margin: 0.75rem 0 0;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    background: #fef2f2;
    color: #991b1b;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .sb-lead-capture__honeypot,
  .sb-lead-capture__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sb-practice-results {
    padding: 1.25rem 1.2rem 1.4rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .sb-gauge-print {
    display: none;
    margin: 0 0 1rem;
    font-size: 0.95rem;
    color: #243015;
  }

  .sb-get-started {
    margin-bottom: 1.25rem;
  }

  .sb-get-started__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 1.15rem 1.35rem;
    align-items: start;
  }

  .sb-get-started__instructions,
  .sb-get-started__diagram {
    min-width: 0;
  }

  .sb-get-started__steps {
    margin: 0;
    padding-left: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .sb-get-started__steps li {
    line-height: 1.5;
    color: #243015;
    font-size: 1rem;
  }

  .sb-get-started__steps strong {
    font-weight: 700;
  }

  .sb-practice-diagram {
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  .sb-practice-diagram :global(.shaping-map) {
    margin: 0;
  }

  .sb-practice-diagram :global(.shaping-map__scroll) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .sb-practice-diagram :global(.shaping-map__svg) {
    width: 100%;
    height: auto;
    display: block;
    max-width: 100%;
    min-width: 0;
  }

  @media (max-width: 800px) {
    .sb-get-started__grid {
      grid-template-columns: 1fr;
    }
  }

  .sb-worksheet__section {
    margin-bottom: 1.1rem;
  }

  .sb-worksheet__section:last-child {
    margin-bottom: 0;
  }

  .sb-get-started h2,
  .sb-worksheet__section > h2,
  .sb-card > h2 {
    margin: 0 0 0.65rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: #52682d;
  }

  .sb-shoulder-note {
    margin: 0 0 0.65rem;
    line-height: 1.55;
    color: #243015;
    font-size: 1rem;
  }

  .sb-worksheet__section p {
    margin: 0 0 0.65rem;
    line-height: 1.55;
    color: #243015;
    font-size: 1rem;
  }

  .sb-video-helper {
    margin: 0 0 1.25rem;
  }

  .sb-video-helper > h3 {
    margin: 0 0 0.2rem;
    font-size: 1rem;
    font-weight: 700;
    color: #4d5a48;
  }

  .sb-video-helper__note {
    margin: 0 0 0.65rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #666;
    font-style: italic;
  }

  .sb-video-helper__note strong {
    font-weight: 700;
    color: #243015;
  }

  .sb-video-helper__embed {
    max-width: 30rem;
  }

  .sb-finish-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .sb-finish-list li {
    line-height: 1.55;
    color: #243015;
    font-size: 1rem;
  }

  .sb-card {
    margin: 0 0 1.1rem;
    padding: 0.95rem 1rem;
    background: #f8faf6;
    border: 1px solid #d6dbc9;
    border-radius: 10px;
  }

  .sb-shoulder-tabs__list {
    display: flex;
    gap: 0.35rem;
    margin: 0 0 0.85rem;
    border-bottom: 1px solid #d6dbc9;
  }

  .sb-shoulder-tabs__tab {
    appearance: none;
    margin: 0 0 -1px;
    padding: 0.55rem 0.9rem;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    background: transparent;
    color: #4d5a48;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .sb-shoulder-tabs__tab[aria-selected="true"] {
    background: #fff;
    border-color: #d6dbc9;
    color: #52682d;
  }

  .sb-shoulder-tabs__tab:focus-visible {
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }

  .sb-shoulder-tabs__panel[hidden] {
    display: none !important;
  }

  .sb-shoulder-checklist :global(.ns-shaping-chart) {
    margin: 0.35rem 0 0;
  }

  .sb-shoulder-print-title {
    display: none;
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: #52682d;
  }

  @media (max-width: 600px) {
    .sb-practice-results,
    .sb-practice-panel,
    .sb-lead-capture,
    .sb-card {
      padding-inline: 0.85rem;
    }
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .sb-practice-results {
      border: none;
      box-shadow: none;
      padding: 0;
    }

    .sb-gauge-print {
      display: block;
    }

    .sb-get-started,
    .sb-practice-diagram,
    .sb-worksheet__section,
    .sb-card {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .sb-shoulder-print-title {
      display: block;
    }

    .sb-practice-diagram {
      max-width: 100%;
    }

    .sb-practice-diagram :global(.shaping-map__scroll) {
      overflow: visible;
      border: none;
      padding: 0;
    }

    .sb-practice-diagram :global(.shaping-map__svg) {
      min-width: 0;
      max-width: 100%;
    }

    .sb-shoulder-tabs__list {
      display: none !important;
    }

    .sb-shoulder-tabs__panel {
      display: block !important;
      margin-top: 1rem;
    }

    .sb-shoulder-tabs__panel[hidden] {
      display: block !important;
    }
  }
</style>
