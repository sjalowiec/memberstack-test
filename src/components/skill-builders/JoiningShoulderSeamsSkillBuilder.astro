---
import SkillBuilderPageHeader from "./SkillBuilderPageHeader.astro";
import SkillBuilderMemberGate from "./SkillBuilderMemberGate.astro";
import GatedVimeoEmbed from "../videos/GatedVimeoEmbed.astro";
import GlossaryTooltip from "../common/GlossaryTooltip.astro";
import {
  getJoiningShoulderSeamsSkillBuilder,
  joiningShoulderSeamsChecklistParts,
  joiningShoulderSeamsIntroParts,
  JOINING_SHOULDER_SEAMS_RELATED_PRACTICE,
} from "../../lib/skillBuilders/joiningShoulderSeamsSkillBuilder";

const builder = getJoiningShoulderSeamsSkillBuilder();
const video = builder.video;
const introParts = joiningShoulderSeamsIntroParts(builder.intro);
const checklistParts = joiningShoulderSeamsChecklistParts(builder.checklist);
---

<div
  class="sb-practice-page"
  data-sb-joining-shoulder-seams
  data-sb-builder={builder.id}
>
  <a class="sb-practice-eyebrow" href="/learn/skill-builders">Skill Builders</a>

  <header class="sb-practice-hero">
    <SkillBuilderPageHeader title={builder.title} />
    <p class="sb-practice-hero__intro">
      {
        introParts.map((part) =>
          part.type === "glossary" ? (
            <GlossaryTooltip id={part.glossaryId}>{part.text}</GlossaryTooltip>
          ) : (
            part.text
          )
        )
      }
    </p>
  </header>

  <SkillBuilderMemberGate>
    <section class="sb-worksheet__section" aria-labelledby="sb-practice-heading">
      <h2 id="sb-practice-heading">What You'll Practice</h2>
      <p>{builder.whatYoullPractice}</p>
    </section>

    <section class="sb-card" aria-labelledby="sb-checklist-heading">
      <h2 id="sb-checklist-heading">Shoulder Seam Checklist</h2>
      <ol class="sb-join-steps">
        {
          checklistParts.map((parts) => (
            <li class="sb-join-step">
              {parts.map((part) =>
                part.type === "glossary" ? (
                  <GlossaryTooltip id={part.glossaryId}>{part.text}</GlossaryTooltip>
                ) : (
                  part.text
                )
              )}
            </li>
          ))
        }
      </ol>
    </section>

    {
      video && (
        <section
          class="sb-worksheet__section"
          aria-label="Video"
          data-sb-video-content-id={String(video.contentId)}
        >
          <h2>Watch</h2>
          <GatedVimeoEmbed
            videoId={video.vimeoId}
            title={video.title ?? builder.title}
            access_level={video.accessLevel}
          />
        </section>
      )
    }
  </SkillBuilderMemberGate>

  <a
    class="sb-related-card"
    href={JOINING_SHOULDER_SEAMS_RELATED_PRACTICE.href}
    aria-labelledby="sb-related-title"
  >
    <span class="sb-related-card__eyebrow">{JOINING_SHOULDER_SEAMS_RELATED_PRACTICE.eyebrow}</span>
    <span class="sb-related-card__body">
      <img
        class="sb-related-card__icon"
        src="/icons/tools/skill-builder-steps.svg"
        alt=""
        aria-hidden="true"
        width="60"
        height="60"
      />
      <span class="sb-related-card__content">
        <span class="sb-related-card__title" id="sb-related-title">{JOINING_SHOULDER_SEAMS_RELATED_PRACTICE.title}</span>
        <span class="sb-related-card__copy">{JOINING_SHOULDER_SEAMS_RELATED_PRACTICE.supportingText}</span>
      </span>
    </span>
  </a>
</div>

<style>
  .sb-practice-page {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 20px 3.5rem;
    overflow-x: hidden;
  }

  .sb-practice-eyebrow {
    display: inline-block;
    margin: 0.25rem 0 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
    text-decoration: none;
  }

  .sb-practice-eyebrow:hover,
  .sb-practice-eyebrow:focus {
    color: #52682d;
  }

  .sb-practice-hero {
    margin: 0.5rem 0 1.25rem;
  }

  .sb-practice-hero :global(h1) {
    margin: 0;
    font-size: clamp(1.45rem, 3vw, 1.9rem);
    font-weight: 600;
    color: #52682d;
    line-height: 1.2;
  }

  .sb-practice-hero__intro {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: #4d5a48;
  }

  .sb-worksheet__section {
    margin-bottom: 1.1rem;
  }

  .sb-worksheet__section > h2,
  .sb-card > h2 {
    margin: 0 0 0.65rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: #52682d;
  }

  .sb-worksheet__section p {
    margin: 0;
    line-height: 1.55;
    color: #243015;
    font-size: 1rem;
  }

  .sb-card {
    margin: 0 0 1.1rem;
    padding: 0.95rem 1rem;
    background: #f8faf6;
    border: 1px solid #d6dbc9;
    border-radius: 10px;
  }

  .sb-join-steps {
    counter-reset: sb-join-step;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sb-join-step {
    counter-increment: sb-join-step;
    position: relative;
    padding: 0.75rem 0.85rem 0.75rem 3rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    border-radius: 8px;
    line-height: 1.55;
    color: #243015;
    font-size: 1rem;
  }

  .sb-join-step::before {
    content: counter(sb-join-step);
    position: absolute;
    left: 0.65rem;
    top: 0.7rem;
    width: 1.7rem;
    height: 1.7rem;
    background: #52682d;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .sb-related-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin: 0.15rem 0 0;
    padding: 1rem 1.1rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    text-decoration: none;
    color: inherit;
    box-sizing: border-box;
  }

  .sb-related-card:hover,
  .sb-related-card:focus {
    border-color: #52682d;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.1);
    outline: none;
  }

  .sb-related-card__eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b7280;
  }

  .sb-related-card__body {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .sb-related-card__icon {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    display: block;
  }

  .sb-related-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .sb-related-card__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #52682d;
    line-height: 1.35;
  }

  .sb-related-card:hover .sb-related-card__title,
  .sb-related-card:focus .sb-related-card__title {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .sb-related-card__copy {
    font-size: 0.92rem;
    line-height: 1.5;
    color: #4d5a48;
  }

  @media (max-width: 600px) {
    .sb-practice-page {
      padding-inline: 16px;
    }

    .sb-card {
      padding-inline: 0.85rem;
    }

    .sb-related-card__body {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
