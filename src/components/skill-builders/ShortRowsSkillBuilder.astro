---
import SkillBuilderPageHeader from "./SkillBuilderPageHeader.astro";
import SkillBuilderMemberGate from "./SkillBuilderMemberGate.astro";
import SkillBuilderPrintButton from "./SkillBuilderPrintButton.astro";
import GatedVimeoEmbed from "../videos/GatedVimeoEmbed.astro";
import GlossaryTooltip from "../common/GlossaryTooltip.astro";
import "../../styles/glossary-tooltip.css";
import {
  getShortRowsSkillBuilder,
  shortRowsIntroParts,
  shortRowsPractice1Parts,
  shortRowsPractice2LeadParts,
  shortRowsPractice2Parts,
  shortRowsWhatYoullLearnParts,
} from "../../lib/skillBuilders/shortRowsSkillBuilder";

const builder = getShortRowsSkillBuilder();
const video = builder.video;
const introParts = shortRowsIntroParts(builder.introParagraphs);
const learnParts = shortRowsWhatYoullLearnParts(builder.whatYoullLearn);
const practice1Parts = shortRowsPractice1Parts(builder.practice1Steps);
const practice2LeadParts = shortRowsPractice2LeadParts(builder.practice2Lead);
const practice2Parts = shortRowsPractice2Parts(builder.practice2Steps);
---

<div class="sb-practice-page" data-sb-short-rows data-sb-builder={builder.id} data-sb-print-root>
  <a class="sb-practice-eyebrow" href="/learn/skill-builders" data-sb-print-hide>Skill Builders</a>

  <header class="sb-practice-hero">
    <SkillBuilderPageHeader title={builder.title} />
    <p class="sb-practice-hero__subtitle">{builder.subtitle}</p>
  </header>

  <div class="sb-intro-layout">
    <div class="sb-intro-copy">
      {
        introParts.map((parts) => (
          <div class="sb-practice-hero__intro">
            {parts.map((part) =>
              part.type === "glossary" ? (
                <GlossaryTooltip id={part.glossaryId}>{part.text}</GlossaryTooltip>
              ) : (
                part.text
              )
            )}
          </div>
        ))
      }
    </div>
    <figure class="sb-intro-media">
      <img
        src="/images/skill-builders/short-rows.png"
        alt="Diagram showing progressively shortened rows in three colors"
        width="356"
        height="303"
        decoding="async"
      />
    </figure>

    <SkillBuilderMemberGate>
    <section class="sb-worksheet__section sb-intro-learn" aria-labelledby="sb-learn-heading">
      <h2 id="sb-learn-heading">What You'll Learn</h2>
      <ul class="sb-learn-list">
        {
          learnParts.map((parts) => (
            <li>
              {parts.map((part) =>
                part.type === "glossary" ? (
                  <GlossaryTooltip id={part.glossaryId}>{part.text}</GlossaryTooltip>
                ) : (
                  part.text
                )
              )}
            </li>
          ))
        }
      </ul>
    </section>

    {
      video && (
        <section
          class="sb-worksheet__section"
          aria-label="Video"
          data-sb-video-content-id={String(video.contentId)}
          data-sb-print-hide
        >
          <h2>Watch</h2>
          <GatedVimeoEmbed
            videoId={video.vimeoId}
            contentId={String(video.contentId)}
            title={video.title ?? builder.title}
            access_level={video.accessLevel}
          />
        </section>
      )
    }

    <section class="sb-card" aria-labelledby="sb-setup-heading">
      <div class="sb-card__heading">
        <h2 id="sb-setup-heading">Practice Setup</h2>
        <SkillBuilderPrintButton ariaLabel={`Print ${builder.title}`} />
      </div>
      <ul class="sb-setup-list">
        {builder.practiceSetup.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="sb-card" aria-labelledby="sb-practice-1-heading">
      <h2 id="sb-practice-1-heading">{builder.practice1Heading}</h2>
      <ol class="sb-join-steps">
        {
          practice1Parts.map((parts) => (
            <li class="sb-join-step">
              {parts.map((part) =>
                part.type === "glossary" ? (
                  <GlossaryTooltip id={part.glossaryId}>{part.text}</GlossaryTooltip>
                ) : (
                  part.text
                )
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sb-card" aria-labelledby="sb-practice-2-heading">
      <h2 id="sb-practice-2-heading">{builder.practice2Heading}</h2>
      <p class="sb-practice-lead">
        {
          practice2LeadParts.map((part) =>
            part.type === "glossary" ? (
              <GlossaryTooltip id={part.glossaryId}>{part.text}</GlossaryTooltip>
            ) : (
              part.text
            )
          )
        }
      </p>
      <ol class="sb-join-steps">
        {
          practice2Parts.map((parts) => (
            <li class="sb-join-step">
              {parts.map((part) =>
                part.type === "glossary" ? (
                  <GlossaryTooltip id={part.glossaryId}>{part.text}</GlossaryTooltip>
                ) : (
                  part.text
                )
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <aside class="sb-sue-tip" aria-labelledby="sb-sue-tip-heading" data-sb-sue-tip>
      <h2 id="sb-sue-tip-heading">{builder.sueTipHeading}</h2>
      <p>{builder.sueTip}</p>
    </aside>

    <section
      class="sb-card"
      aria-labelledby="sb-completion-heading"
      data-sb-completion
      data-sb-print-hide
    >
      <h2 id="sb-completion-heading">{builder.completionPrompt}</h2>
      <fieldset class="sb-completion">
        <legend class="sb-completion__legend">{builder.completionPrompt}</legend>
        {
          builder.completionOptions.map((option) => {
            const optionId = `sb-short-rows-${option.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
            return (
              <label class="sb-completion__option" for={optionId}>
                <input
                  id={optionId}
                  type="radio"
                  name="sb-short-rows-comfort"
                  value={option}
                />
                <span>{option}</span>
              </label>
            );
          })
        }
      </fieldset>
    </section>

    <a class="sb-practice-back" href="/learn/skill-builders" data-sb-print-hide>Back to Skill Builders</a>
    </SkillBuilderMemberGate>
  </div>
</div>

<style>
  .sb-practice-page {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 20px 3.5rem;
    overflow-x: hidden;
  }

  /* This Skill Builder only: glossary terms read as body copy. Hover/focus stay available. */
  .sb-practice-page[data-sb-short-rows] :global(button.glossary-tooltip-trigger) {
    font-weight: inherit;
    color: inherit;
    background-image: none;
    text-decoration: none;
  }

  .sb-practice-page[data-sb-short-rows] :global(button.glossary-tooltip-trigger:hover) {
    background-image: none;
    text-decoration: underline;
    text-underline-offset: 0.14em;
    text-decoration-thickness: from-font;
  }

  .sb-practice-page[data-sb-short-rows] :global(button.glossary-tooltip-trigger:focus-visible) {
    background-image: none;
    outline: 2px solid rgba(82, 104, 45, 0.35);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .sb-practice-page :global(sup.glossary-tooltip-icon) {
    display: none;
  }

  .sb-practice-page[data-sb-short-rows] :global(.glossary-tooltip-fallback) {
    text-decoration: none;
    color: inherit;
    font-weight: inherit;
  }

  .sb-practice-eyebrow {
    display: inline-block;
    margin: 0.25rem 0 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
    text-decoration: none;
  }

  .sb-practice-eyebrow:hover,
  .sb-practice-eyebrow:focus,
  .sb-practice-back:hover,
  .sb-practice-back:focus {
    color: #52682d;
  }

  .sb-practice-hero {
    margin: 0.5rem 0 0.75rem;
  }

  .sb-intro-layout {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
  }

  .sb-intro-copy {
    min-width: 0;
  }

  .sb-intro-media {
    margin: 0;
    max-width: 15.5rem;
    padding: 0.65rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    border-radius: 10px;
    box-sizing: border-box;
  }

  .sb-intro-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .sb-practice-hero :global(h1) {
    margin: 0;
    font-size: clamp(1.45rem, 3vw, 1.9rem);
    font-weight: 600;
    color: #52682d;
    line-height: 1.2;
  }

  .sb-practice-hero__subtitle {
    margin: 0.35rem 0 0.75rem;
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.4;
    color: #4d5a48;
  }

  .sb-practice-hero__intro {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    line-height: 1.5;
    color: #4d5a48;
  }

  .sb-practice-hero__intro:last-child {
    margin-bottom: 0;
  }

  .sb-worksheet__section {
    margin-bottom: 1.1rem;
  }

  .sb-worksheet__section > h2,
  .sb-card > h2,
  .sb-card__heading > h2 {
    margin: 0 0 0.65rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: #52682d;
  }

  .sb-card__heading > h2 {
    margin: 0;
  }

  .sb-worksheet__section p,
  .sb-practice-lead {
    margin: 0 0 0.85rem;
    line-height: 1.55;
    color: #243015;
    font-size: 1rem;
  }

  .sb-learn-list,
  .sb-setup-list {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    color: #243015;
    font-size: 1rem;
    line-height: 1.55;
  }

  .sb-card {
    margin: 0 0 1.1rem;
    padding: 0.95rem 1rem;
    background: #f8faf6;
    border: 1px solid #d6dbc9;
    border-radius: 10px;
  }

  .sb-join-steps {
    counter-reset: sb-join-step;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sb-join-step {
    counter-increment: sb-join-step;
    position: relative;
    padding: 0.75rem 0.85rem 0.75rem 3rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    border-radius: 8px;
    line-height: 1.55;
    color: #243015;
    font-size: 1rem;
  }

  .sb-join-step::before {
    content: counter(sb-join-step);
    position: absolute;
    left: 0.65rem;
    top: 0.7rem;
    width: 1.7rem;
    height: 1.7rem;
    background: #52682d;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .sb-sue-tip {
    margin: 0 0 1.1rem;
    padding: 0.15rem 0 0.15rem 0.95rem;
    border-left: 3px solid #d6dbc9;
  }

  .sb-sue-tip > h2 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    font-weight: 600;
    color: #4d5a48;
  }

  .sb-sue-tip p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #4d5a48;
  }

  .sb-completion {
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .sb-completion__legend {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sb-completion__option {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.75rem 0.85rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    border-radius: 8px;
    line-height: 1.45;
    color: #243015;
    font-size: 1rem;
    cursor: pointer;
  }

  .sb-completion__option:has(input:focus-visible) {
    border-color: #52682d;
    box-shadow: 0 0 0 2px rgba(82, 104, 45, 0.2);
  }

  .sb-completion__option input {
    margin-top: 0.2rem;
    accent-color: #52682d;
  }

  .sb-practice-back {
    display: inline-block;
    margin: 0.15rem 0 0;
    font-size: 0.92rem;
    font-weight: 600;
    color: #6b7280;
    text-decoration: none;
  }

  @media (min-width: 600px) {
    .sb-intro-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(11.5rem, 14.5rem);
      gap: 0;
      column-gap: 1.35rem;
      align-items: start;
    }

    .sb-intro-copy {
      grid-column: 1;
      grid-row: 1;
      margin-bottom: 1.1rem;
    }

    .sb-intro-media {
      grid-column: 2;
      grid-row: 1 / span 2;
      justify-self: end;
      width: 100%;
      max-width: 14.5rem;
    }

    .sb-intro-layout > :global([data-sb-member-body-mount]:not([hidden])) {
      display: contents;
    }

    .sb-intro-layout > :global([data-sb-member-lock]:not([hidden])) {
      grid-column: 1 / -1;
    }

    .sb-intro-layout :global(.sb-intro-learn) {
      grid-column: 1;
    }

    .sb-intro-layout :global(.sb-intro-learn ~ *) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .sb-practice-page {
      padding-inline: 16px;
    }

    .sb-card {
      padding-inline: 0.85rem;
    }
  }
</style>
