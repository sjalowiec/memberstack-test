---
import SkillBuilderPageHeader from "./SkillBuilderPageHeader.astro";
import SkillBuilderMemberGate from "./SkillBuilderMemberGate.astro";
import GatedVimeoEmbed from "../videos/GatedVimeoEmbed.astro";
import GlossaryTooltip from "../common/GlossaryTooltip.astro";
import {
  getEWrapCastOnSkillBuilder,
  eWrapCastOnChecklistParts,
  eWrapCastOnIntroParts,
  eWrapCastOnWeightsNoteParts,
} from "../../lib/skillBuilders/eWrapCastOnSkillBuilder";

const builder = getEWrapCastOnSkillBuilder();
const video = builder.video;
const introParts = eWrapCastOnIntroParts(builder.intro);
const checklistParts = eWrapCastOnChecklistParts(builder.checklist);
const weightsNoteParts = eWrapCastOnWeightsNoteParts(builder.weightsNote);
---

<div class="sb-practice-page" data-sb-e-wrap-cast-on data-sb-builder={builder.id}>
  <a class="sb-practice-eyebrow" href="/learn/skill-builders">Skill Builders</a>

  <header class="sb-practice-hero">
    <SkillBuilderPageHeader title={builder.title} />
    <p class="sb-practice-hero__intro">
      {
        introParts.map((part) =>
          part.type === "glossary" ? (
            <GlossaryTooltip id={part.glossaryId}>{part.text}</GlossaryTooltip>
          ) : (
            part.text
          )
        )
      }
    </p>
  </header>

  <SkillBuilderMemberGate>
    <section class="sb-worksheet__section" aria-labelledby="sb-practice-heading">
      <h2 id="sb-practice-heading">What You'll Practice</h2>
      <p>{builder.whatYoullPractice}</p>
    </section>

    {
      video && (
        <section
          class="sb-worksheet__section"
          aria-label="Video"
          data-sb-video-content-id={String(video.contentId)}
        >
          <h2>Watch</h2>
          <GatedVimeoEmbed
            videoId={video.vimeoId}
            title={video.title ?? builder.title}
            access_level={video.accessLevel}
          />
        </section>
      )
    }

    <section class="sb-card" aria-labelledby="sb-checklist-heading">
      <h2 id="sb-checklist-heading">E-Wrap Cast On Checklist</h2>
      <ol class="sb-join-steps">
        {
          checklistParts.map((parts) => (
            <li class="sb-join-step">
              {parts.map((part) =>
                part.type === "glossary" ? (
                  <GlossaryTooltip id={part.glossaryId}>{part.text}</GlossaryTooltip>
                ) : (
                  part.text
                )
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <aside class="sb-weights-note" aria-labelledby="sb-weights-heading" data-sb-weights-note>
      <h2 id="sb-weights-heading">Using weights</h2>
      <p>
        {
          weightsNoteParts.map((part) =>
            part.type === "glossary" ? (
              <GlossaryTooltip id={part.glossaryId}>{part.text}</GlossaryTooltip>
            ) : (
              part.text
            )
          )
        }
      </p>
    </aside>
  </SkillBuilderMemberGate>
</div>

<style>
  .sb-practice-page {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 20px 3.5rem;
    overflow-x: hidden;
  }

  .sb-practice-eyebrow {
    display: inline-block;
    margin: 0.25rem 0 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
    text-decoration: none;
  }

  .sb-practice-eyebrow:hover,
  .sb-practice-eyebrow:focus {
    color: #52682d;
  }

  .sb-practice-hero {
    margin: 0.5rem 0 1.25rem;
  }

  .sb-practice-hero :global(h1) {
    margin: 0;
    font-size: clamp(1.45rem, 3vw, 1.9rem);
    font-weight: 600;
    color: #52682d;
    line-height: 1.2;
  }

  .sb-practice-hero__intro {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: #4d5a48;
  }

  .sb-worksheet__section {
    margin-bottom: 1.1rem;
  }

  .sb-worksheet__section > h2,
  .sb-card > h2 {
    margin: 0 0 0.65rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: #52682d;
  }

  .sb-worksheet__section p {
    margin: 0;
    line-height: 1.55;
    color: #243015;
    font-size: 1rem;
  }

  .sb-card {
    margin: 0 0 1.1rem;
    padding: 0.95rem 1rem;
    background: #f8faf6;
    border: 1px solid #d6dbc9;
    border-radius: 10px;
  }

  .sb-join-steps {
    counter-reset: sb-join-step;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sb-join-step {
    counter-increment: sb-join-step;
    position: relative;
    padding: 0.75rem 0.85rem 0.75rem 3rem;
    background: #fff;
    border: 1px solid #d6dbc9;
    border-radius: 8px;
    line-height: 1.55;
    color: #243015;
    font-size: 1rem;
  }

  .sb-join-step::before {
    content: counter(sb-join-step);
    position: absolute;
    left: 0.65rem;
    top: 0.7rem;
    width: 1.7rem;
    height: 1.7rem;
    background: #52682d;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .sb-weights-note {
    margin: 0 0 1.1rem;
    padding: 0.15rem 0 0.15rem 0.95rem;
    border-left: 3px solid #d6dbc9;
  }

  .sb-weights-note > h2 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    font-weight: 600;
    color: #4d5a48;
  }

  .sb-weights-note p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #4d5a48;
  }

  @media (max-width: 600px) {
    .sb-practice-page {
      padding-inline: 16px;
    }

    .sb-card {
      padding-inline: 0.85rem;
    }
  }
</style>
