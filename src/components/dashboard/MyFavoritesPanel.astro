---
/**
 * Account My Favorites dashboard � accordion by content type (account-favorites.ts).
 * Visual pattern mirrors My Patterns (`details` / `summary` groups).
 */
import "../../styles/favorites.css";
import videosRaw from "../../data/videos-public.json";
import { filterPublicCatalogVideos } from "../../lib/videoPublic";
import { getStitchCatalogItems } from "../../lib/stitch-data";
import toolsRaw from "../../../data/tools.json";
import { REFERENCE_FAVORITE_CATALOG } from "../../lib/favorites/referenceFavoriteCatalog";
import { FAVORITE_GROUP_ORDER } from "../../lib/favorites/favoriteCatalog";

const publicVideos = filterPublicCatalogVideos(Array.isArray(videosRaw) ? videosRaw : []);
const videoMeta = publicVideos
  .map((v) => ({
    content_id: String(v.content_id ?? ""),
    title: typeof v.title === "string" ? v.title : "Video",
    href: `/videos/${encodeURIComponent(String(v.content_id ?? ""))}`,
    posterUrl:
      typeof (v as { posterUrl?: string }).posterUrl === "string"
        ? (v as { posterUrl?: string }).posterUrl
        : "",
  }))
  .filter((v) => v.content_id);

const stitchMeta = getStitchCatalogItems().map((it) => ({
  content_id: String(it.id),
  title: it.title || `Stitch #${it.id}`,
  href: `/stitch/${it.id}`,
  posterUrl: it.swatchSrc || "",
}));

const toolMeta = (Array.isArray(toolsRaw) ? toolsRaw : [])
  .filter((t: { id?: number; href?: string; active?: boolean }) => t.active !== false && t.id != null)
  .map((t: { id: number; title?: string; href?: string; icon?: string }) => ({
    content_id: String(t.id),
    title: typeof t.title === "string" && t.title.trim() ? t.title : "Tool",
    href: typeof t.href === "string" && t.href.startsWith("/") ? t.href : "/tools",
    posterUrl: t.icon ? `/icons/tools/${t.icon}` : "",
  }));

const referenceMeta = REFERENCE_FAVORITE_CATALOG;

const groupMeta = {
  video: videoMeta,
  stitch: stitchMeta,
  reference: referenceMeta,
  tool: toolMeta,
};

const ACCORDION_NAME = "account-my-favorites-groups";
---

<section
  id="my-favorites"
  class="dashboard-card dashboard-card--favorites"
  aria-labelledby="my-favorites-heading"
  data-kbm-my-favorites
>
  <details class="account-favorites__accordion" data-kbm-my-favorites-accordion>
    <summary class="account-favorites__summary">
      <div class="account-favorites__summary-copy">
        <h2 id="my-favorites-heading" class="dashboard-card__title account-favorites__heading">
          My Favorites
        </h2>
        <button
          type="button"
          class="account-favorites__help-link"
          data-favorites-help-open
          aria-haspopup="dialog"
          aria-controls="favorites-help-dialog"
        >
          How to save favorites
        </button>
      </div>
      <span class="account-favorites__chevron" aria-hidden="true"></span>
    </summary>
    <div class="account-favorites__panel">
  <p class="dashboard-card__subtitle">
    Items you have starred. Open a category to browse, open any title to view it, or remove it from favorites here.
  </p>

  <p
    class="dashboard-muted account-favorites__status"
    data-kbm-my-favorites-status
    role="status"
    aria-live="polite"
  >
    Loading your favorites...
  </p>

  <div class="account-favorites__groups" data-kbm-my-favorites-groups>
    {
      FAVORITE_GROUP_ORDER.map((group) => (
        <details
          class="account-favorites__group"
          data-kbm-my-favorites-group={group.contentType}
          name={ACCORDION_NAME}
          hidden
        >
          <summary class="account-favorites__group-summary">
            <span
              class="account-favorites__group-label"
              data-kbm-my-favorites-group-label={group.contentType}
            >
              {group.label}
            </span>
          </summary>
          <ul
            class="account-favorites__list"
            data-kbm-my-favorites-list={group.contentType}
          ></ul>
          {group.viewAllHref ? (
            <p class="account-favorites__view-all-wrap" data-kbm-my-favorites-view-all-wrap={group.contentType}>
              <a
                href={group.viewAllHref}
                class="kbm-btn kbm-btn-outline account-favorites__view-all"
                data-kbm-my-favorites-view-all={group.contentType}
              >
                View favorite {group.label.toLowerCase()}
              </a>
            </p>
          ) : null}
        </details>
      ))
    }
  </div>

  <div class="account-favorites__empty" data-kbm-my-favorites-empty hidden>
    <p class="account-favorites__empty-text">You haven't added any favorites yet.</p>
    <div class="account-favorites__empty-actions">
      <a href="/videos" class="kbm-btn kbm-btn-accent account-favorites__browse-btn">Browse Videos</a>
      <a href="/stitch" class="kbm-btn kbm-btn-outline account-favorites__browse-btn">Browse Stitches</a>
      <a href="/reference" class="kbm-btn kbm-btn-outline account-favorites__browse-btn">Browse Reference</a>
      <a href="/help-hub" class="kbm-btn kbm-btn-outline account-favorites__browse-btn">Browse Help Hub</a>
      <a href="/tools" class="kbm-btn kbm-btn-outline account-favorites__browse-btn">Browse Tools</a>
      <a href="/tip-of-the-week" class="kbm-btn kbm-btn-outline account-favorites__browse-btn">Browse Tips of the Week</a>
      <a href="/knit-ables" class="kbm-btn kbm-btn-outline account-favorites__browse-btn">Browse Knit-ables</a>
    </div>
  </div>
    </div>
  </details>

  <dialog
    id="favorites-help-dialog"
    class="account-favorites-help-modal"
    data-favorites-help-modal
    aria-modal="true"
    aria-labelledby="favorites-help-title"
  >
    <div class="account-favorites-help-modal__header">
      <h2 id="favorites-help-title">How to save favorites</h2>
      <button type="button" class="account-favorites-help-modal__close" data-favorites-help-close>
        Close
      </button>
    </div>
    <div class="account-favorites-help-modal__body">
      <p>
        While logged in, click the star beside something you want to save. Find your saved items in My Favorites on your account page. Click the star again to remove an item.
      </p>
      <img
        class="account-favorites-help-modal__demo"
        data-favorites-help-demo
        alt="Demonstration of saving a favorite and finding it on the account page."
        hidden
      />
      <p class="account-favorites-help-modal__missing" data-favorites-help-missing hidden>
        The favorites demonstration could not be loaded.
      </p>
      <p>
        Starring a Tip of the Week saves its video under Videos, so you can find it even after the weekly tip changes.
      </p>
    </div>
  </dialog>

  <script>
    import { initFavoritesHelpModal } from "../../lib/favorites/favoritesHelpModal";

    initFavoritesHelpModal();
  </script>

  <script
    id="account-favorites-meta"
    type="application/json"
    set:html={JSON.stringify(groupMeta)}
  />
</section>

<style>
  .dashboard-card.dashboard-card--favorites {
    grid-column: 1 / -1;
    scroll-margin-top: calc(var(--header-offset, 170px) + 1rem);
    min-width: 0;
    padding: 0;
  }

  .account-favorites__accordion {
    margin: 0;
  }

  .account-favorites__summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.15rem 1.5rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .account-favorites__summary-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    min-width: 0;
    flex: 1;
  }

  .account-favorites__help-link {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: #6b7280;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1.4;
    text-align: left;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .account-favorites__help-link:hover {
    color: #4b5563;
  }

  .account-favorites__help-link:focus-visible {
    color: #4b5563;
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .account-favorites__summary::-webkit-details-marker {
    display: none;
  }

  .account-favorites__summary::marker {
    content: "";
  }

  .account-favorites__summary:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: -2px;
    border-radius: 12px;
  }

  .account-favorites__heading {
    margin: 0;
    min-width: 0;
  }

  .account-favorites__chevron {
    flex-shrink: 0;
    margin-top: 0.1rem;
    width: 1.5rem;
    height: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    color: #6b7280;
    line-height: 1;
    background: #fff;
  }

  .account-favorites__chevron::after {
    content: "+";
  }

  .account-favorites__accordion[open] > .account-favorites__summary .account-favorites__chevron::after {
    content: "-";
  }

  .account-favorites__panel {
    padding: 0 1.5rem 1.5rem;
  }

  .dashboard-card--favorites .dashboard-card__subtitle {
    margin-bottom: 0.85rem;
  }

  .account-favorites__status {
    margin: 0 0 0.75rem;
  }

  .account-favorites__groups {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 0.25rem;
    min-width: 0;
    max-height: min(24rem, 70vh);
    overflow: auto;
  }

  .account-favorites__group {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #fff;
    min-width: 0;
  }

  .account-favorites__group-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.65rem 0.85rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.98rem;
    font-weight: 600;
    color: #2c3a57;
  }

  .account-favorites__group-summary::-webkit-details-marker {
    display: none;
  }

  .account-favorites__group-summary::after {
    content: "+";
    margin-left: auto;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    color: #6b7280;
    background: #fff;
    line-height: 1;
  }

  .account-favorites__group[open] > .account-favorites__group-summary::after {
    content: "?";
  }

  .account-favorites__group-summary:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
    border-radius: 6px;
  }

  .account-favorites__group-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .account-favorites__list {
    list-style: none;
    margin: 0;
    padding: 0 0.75rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .account-favorites__view-all-wrap {
    margin: 0;
    padding: 0 0.75rem 0.85rem;
  }

  .account-favorites__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .account-favorites__empty {
    margin-top: 0.35rem;
  }

  .account-favorites__empty-text {
    margin: 0 0 0.85rem;
    color: #4b5563;
    line-height: 1.5;
  }

  .account-favorites__empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .account-favorites__browse-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  :global(.account-favorites__remove) {
    flex: 0 0 auto;
    border: 1px solid #d1d5db;
    background: #fff;
    color: #374151;
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    font-size: 0.82rem;
    line-height: 1.3;
    cursor: pointer;
  }

  :global(.account-favorites__remove:focus-visible) {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }

  :global(.account-favorites__note) {
    display: block;
    color: #6b7280;
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .account-favorites__summary,
    .account-favorites__panel {
      padding-left: 1.15rem;
      padding-right: 1.15rem;
    }
  }

  :global(.account-favorites__item) {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.65rem 0.7rem;
    border: 1px solid #eef0f2;
    border-radius: 8px;
    background: #fafbfa;
    min-width: 0;
  }

  :global(.account-favorites__thumb) {
    flex: 0 0 4.5rem;
    width: 4.5rem;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background: #e5e7eb;
  }

  :global(.account-favorites__thumb--square) {
    aspect-ratio: 1;
  }

  :global(.account-favorites__thumb--icon) {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    background: #f3f4f6;
  }

  :global(.account-favorites__thumb img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.account-favorites__thumb--icon img) {
    width: 70%;
    height: 70%;
    object-fit: contain;
  }

  :global(.account-favorites__body) {
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.account-favorites__title-link) {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  :global(.account-favorites__title-link:hover) {
    color: var(--kbm-green, #52682d);
    text-decoration: underline;
  }

  .account-favorites-help-modal {
    width: min(42rem, calc(100vw - 1.5rem));
    max-width: calc(100vw - 1.5rem);
    max-height: calc(100dvh - 1.5rem);
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 14px;
    background: #fff;
    color: #1f2937;
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.18);
    overflow: hidden;
  }

  .account-favorites-help-modal::backdrop {
    background: rgba(15, 23, 42, 0.45);
  }

  .account-favorites-help-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.15rem 1.15rem 0;
  }

  .account-favorites-help-modal__header h2 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.25;
    color: #2c3a57;
  }

  .account-favorites-help-modal__close {
    flex-shrink: 0;
    min-height: 2.5rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid rgba(82, 104, 45, 0.35);
    border-radius: 8px;
    background: #fff;
    color: #3f4b35;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 650;
    cursor: pointer;
  }

  .account-favorites-help-modal__close:hover,
  .account-favorites-help-modal__close:focus-visible {
    background: #f3f6ee;
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }

  .account-favorites-help-modal__body {
    padding: 0.85rem 1.15rem 1.25rem;
    overflow: auto;
    max-height: calc(100dvh - 6.5rem);
  }

  .account-favorites-help-modal__body p {
    margin: 0 0 0.85rem;
    line-height: 1.5;
  }

  .account-favorites-help-modal__demo {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(52dvh, 28rem);
    object-fit: contain;
    margin: 0 auto 0.85rem;
  }

  .account-favorites-help-modal__demo[hidden] {
    display: none;
  }

  .account-favorites-help-modal__missing {
    margin-top: -0.35rem;
    color: #6b7280;
    font-size: 0.92rem;
  }
</style>
