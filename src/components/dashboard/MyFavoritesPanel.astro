---
/**
 * Account My Favorites - Videos group for version one.
 * Hydrated by account-favorites.ts from the member favorites API + catalog metadata.
 */
import "../../styles/favorites.css";
import videosRaw from "../../data/videos-public.json";
import { filterPublicCatalogVideos } from "../../lib/videoPublic";

const publicVideos = filterPublicCatalogVideos(Array.isArray(videosRaw) ? videosRaw : []);
const videoMeta = publicVideos
  .map((v) => ({
    content_id: String(v.content_id ?? ""),
    title: typeof v.title === "string" ? v.title : "Video",
    posterUrl:
      typeof (v as { posterUrl?: string }).posterUrl === "string"
        ? (v as { posterUrl?: string }).posterUrl
        : "",
  }))
  .filter((v) => v.content_id);
---

<section
  id="my-favorites"
  class="dashboard-card dashboard-card--favorites"
  aria-labelledby="my-favorites-heading"
  data-kbm-my-favorites
>
  <h2 id="my-favorites-heading" class="dashboard-card__title">My Favorites</h2>
  <p class="dashboard-card__subtitle">
    Videos you have saved with the star. Open any item to watch, or remove it from favorites here.
  </p>

  <p
    class="dashboard-muted account-favorites__status"
    data-kbm-my-favorites-status
    role="status"
    aria-live="polite"
  >
    Loading your favorites...
  </p>

  <div class="account-favorites__group" data-kbm-my-favorites-videos hidden>
    <h3 class="account-favorites__group-title">Videos</h3>
    <ul class="account-favorites__list" data-kbm-my-favorites-list></ul>
  </div>

  <div class="account-favorites__empty" data-kbm-my-favorites-empty hidden>
    <p class="account-favorites__empty-text">You haven't added any favorite videos yet.</p>
    <a href="/videos" class="kbm-btn kbm-btn-accent account-favorites__browse-btn">Browse Videos</a>
  </div>

  <script id="account-favorites-video-meta" type="application/json" set:html={JSON.stringify(videoMeta)} />
</section>

<style>
  .dashboard-card--favorites .dashboard-card__subtitle {
    margin-bottom: 0.85rem;
  }

  .account-favorites__status {
    margin: 0 0 0.75rem;
  }

  .account-favorites__group-title {
    margin: 0 0 0.65rem;
    font-size: 1rem;
    font-weight: 700;
    color: #374151;
  }

  .account-favorites__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .account-favorites__empty {
    margin-top: 0.35rem;
  }

  .account-favorites__empty-text {
    margin: 0 0 0.85rem;
    color: #4b5563;
    line-height: 1.5;
  }

  .account-favorites__browse-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  :global(.account-favorites__item) {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #fff;
  }

  :global(.account-favorites__thumb) {
    flex: 0 0 4.5rem;
    width: 4.5rem;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background: #e5e7eb;
  }

  :global(.account-favorites__thumb img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.account-favorites__body) {
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.account-favorites__title-link) {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    line-height: 1.35;
  }

  :global(.account-favorites__title-link:hover) {
    color: var(--kbm-green, #52682d);
    text-decoration: underline;
  }
</style>
