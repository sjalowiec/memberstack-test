---
/** Saved custom patterns table — wired by account-my-patterns.ts. */
---

<section
  id="my-patterns"
  class="dashboard-card dashboard-card--patterns dashboard-card--primary"
  aria-labelledby="my-patterns-heading"
  data-kbm-my-patterns
>
  <div class="dashboard-card__header-row dashboard-card__header-row--primary">
    <h2 id="my-patterns-heading" class="dashboard-card__title dashboard-card__title--primary">
      Your Saved Patterns
    </h2>
    <p class="dashboard-card__subtitle dashboard-card__subtitle--primary">
      Your saved projects — select a pattern to continue knitting.
    </p>
  </div>

  <p
    class="dashboard-muted account-my-patterns__status"
    data-kbm-my-patterns-status
    role="status"
    aria-live="polite"
  >
    Loading your saved patterns…
  </p>

  <div class="account-my-patterns__empty-cta" data-kbm-my-patterns-empty-cta hidden>
    <a href="/patterns" class="kbm-btn kbm-btn-accent account-my-patterns__create-btn">
      Create a Pattern
    </a>
  </div>

  <div
    class="account-my-patterns__table-wrap"
    data-kbm-my-patterns-list-wrap
    hidden
  >
    <table class="account-my-patterns__table" aria-label="Saved custom patterns">
      <thead>
        <tr>
          <th scope="col">
            <button
              type="button"
              class="account-my-patterns__sort"
              data-kbm-my-patterns-sort="name"
              aria-sort="none"
            >
              Pattern name
              <span class="account-my-patterns__sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col">Type</th>
          <th scope="col">Gauge</th>
          <th scope="col">
            <button
              type="button"
              class="account-my-patterns__sort"
              data-kbm-my-patterns-sort="updatedAt"
              aria-sort="descending"
            >
              Last updated
              <span class="account-my-patterns__sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
          <th scope="col" class="account-my-patterns__actions-header">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
      </thead>
      <tbody data-kbm-my-patterns-list></tbody>
    </table>
  </div>
</section>

<style>
  .account-my-patterns__empty-cta {
    margin-top: 1rem;
  }

  .account-my-patterns__create-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>
