---
/** Compact placeholder cards for workspace tools — links to existing site areas. */
---

<div class="dashboard-workspace-grid" aria-label="Workspace tools">
  <section id="calculators" class="dashboard-mini-card" aria-labelledby="calculators-heading">
    <h2 id="calculators-heading" class="dashboard-mini-card__title">Calculators</h2>
    <p class="dashboard-mini-card__text">
      Charting tools for shaping, gauge, and fit — without doing the math yourself.
    </p>
    <a href="/tools" class="dashboard-mini-card__link">Browse calculators</a>
  </section>

  <section id="purchases" class="dashboard-mini-card" aria-labelledby="purchases-heading">
    <h2 id="purchases-heading" class="dashboard-mini-card__title">Purchases</h2>
    <p class="dashboard-mini-card__text">
      Downloads and shop purchases tied to your account will live here.
    </p>
    <a href="/shop/downloads" class="dashboard-mini-card__link">View downloads</a>
  </section>

  <section id="membership" class="dashboard-mini-card" aria-labelledby="membership-heading">
    <h2 id="membership-heading" class="dashboard-mini-card__title">Membership</h2>
    <div data-ms-content="paid-plans">
      <p class="dashboard-mini-card__text dashboard-mini-card__text--status">
        Knit it Now member
      </p>
    </div>
    <div data-ms-content="no-plans">
      <p class="dashboard-mini-card__text">
        Membership details and plan options.
      </p>
    </div>
    <a href="/membership" class="dashboard-mini-card__link">Membership info</a>
  </section>

  <section id="help" class="dashboard-mini-card" aria-labelledby="help-heading">
    <h2 id="help-heading" class="dashboard-mini-card__title">Help</h2>
    <p class="dashboard-mini-card__text">
      Troubleshooting, guided help, and quick answers when you get stuck.
    </p>
    <a href="/help-hub" class="dashboard-mini-card__link">Open Help Hub</a>
  </section>
</div>

<style>
  .dashboard-workspace-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .dashboard-mini-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 1rem 1.1rem 1.05rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
  }

  .dashboard-mini-card__title {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #2c3a57;
  }

  .dashboard-mini-card__text {
    margin: 0 0 0.65rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: #6b7280;
  }

  .dashboard-mini-card__text--status {
    color: var(--kbm-green, #52682d);
    font-weight: 600;
  }

  .dashboard-mini-card__link {
    font-size: 0.88rem;
    font-weight: 600;
    color: #2c3a57;
    text-decoration: underline;
    text-decoration-color: rgba(44, 58, 87, 0.3);
    text-underline-offset: 0.15em;
  }

  .dashboard-mini-card__link:hover {
    color: var(--kbm-green, #52682d);
  }

  @media (max-width: 1100px) {
    .dashboard-workspace-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .dashboard-workspace-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
