---
/**
 * Account My Downloads dashboard — legacy ebooks and Stripe-paid printables
 * for the logged-in Memberstack email (account-my-downloads.ts).
 */
---

<section
  id="my-downloads"
  class="dashboard-card dashboard-card--downloads"
  aria-labelledby="my-downloads-heading"
  data-kbm-my-downloads
>
  <h2 id="my-downloads-heading" class="dashboard-card__title">My Downloads</h2>
  <p class="dashboard-card__subtitle">
    Downloads you purchased from Knit It Now appear here.
  </p>

  <p
    class="dashboard-muted account-downloads__status"
    data-kbm-my-downloads-status
    role="status"
    aria-live="polite"
  >
    Loading your downloads…
  </p>

  <ul
    class="account-downloads__list"
    data-kbm-my-downloads-list
    hidden
  ></ul>

  <div class="account-downloads__empty" data-kbm-my-downloads-empty hidden>
    <p class="account-downloads__empty-text">
      No previous purchases were found for this account email.
    </p>
    <p class="account-downloads__support-note">
      If you purchased with a different email address, contact support and we can help restore access.
    </p>
  </div>
</section>

<style>
  .dashboard-card--downloads {
    scroll-margin-top: calc(var(--header-offset, 170px) + 1rem);
    min-width: 0;
  }

  .dashboard-card--downloads .dashboard-card__subtitle {
    margin-bottom: 0.85rem;
  }

  .account-downloads__status {
    margin: 0 0 0.75rem;
  }

  .account-downloads__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .account-downloads__empty {
    margin-top: 0.35rem;
  }

  .account-downloads__empty-text {
    margin: 0 0 0.65rem;
    color: #4b5563;
    line-height: 1.5;
  }

  .account-downloads__support-note {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: #6b7280;
  }

  :global(.account-downloads__item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid #eef0f2;
    border-radius: 8px;
    background: #fafbfa;
    min-width: 0;
  }

  :global(.account-downloads__title) {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.35;
    color: #2c3a57;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  :global(.account-downloads__download) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
  }
</style>
