---
/**
 * Full-width account dashboard wrapper (no side navigation).
 * Kept as a shared shell so account page padding/layout stays consistent.
 */
---

<div class="dashboard-shell">
  <main class="dashboard-shell__main">
    <div class="dashboard-shell__content">
      <slot />
    </div>
  </main>
</div>

<style>
  .dashboard-shell {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0 clamp(1.25rem, 3.5vw, 3rem) 3.5rem;
    box-sizing: border-box;
  }

  .dashboard-shell__main {
    min-width: 0;
    padding-top: 0.15rem;
  }

  .dashboard-shell__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .dashboard-shell {
      padding-bottom: 3rem;
    }
  }
</style>
