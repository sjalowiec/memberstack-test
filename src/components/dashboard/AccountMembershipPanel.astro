---
/** Account Current Membership panel — populated by account-membership.ts. */
---

<section
  id="membership"
  class="dashboard-card account-membership-panel"
  aria-labelledby="membership-heading"
  data-kbm-account-membership
>
  <h2 id="membership-heading" class="dashboard-card__title">Current Membership</h2>

  <p
    class="account-membership-panel__loading"
    data-kbm-account-membership-loading
    aria-live="polite"
  >
    Loading membership detailsà
  </p>

  <p
    class="account-membership-panel__error"
    data-kbm-account-membership-error
    hidden
    role="alert"
  ></p>

  <div class="account-membership-panel__content" data-kbm-account-membership-content hidden>
    <dl class="account-membership-panel__facts">
      <div class="account-membership-panel__fact">
        <dt>Current Plan</dt>
        <dd data-kbm-account-membership-plan></dd>
      </div>
      <div class="account-membership-panel__fact">
        <dt>Status</dt>
        <dd data-kbm-account-membership-status></dd>
      </div>
      <div
        class="account-membership-panel__fact"
        data-kbm-account-membership-renews-row
        hidden
      >
        <dt>Next Renewal</dt>
        <dd data-kbm-account-membership-renews></dd>
      </div>
      <div
        class="account-membership-panel__fact"
        data-kbm-account-membership-date-row
        hidden
      >
        <dt data-kbm-account-membership-date-label>Member Since</dt>
        <dd data-kbm-account-membership-date-value></dd>
      </div>
    </dl>

    <p
      class="account-membership-panel__auto-renew"
      data-kbm-account-membership-auto-renew
      hidden
    ></p>

    <p
      class="account-membership-panel__active-until"
      data-kbm-account-membership-active-until
      hidden
    ></p>

    <div class="account-membership-panel__actions" data-kbm-account-membership-actions>
      <a
        href="/membership"
        class="kbm-btn kbm-btn-accent"
        data-kbm-account-membership-action="join"
        hidden
      >
        Become a Member
      </a>
      <button
        type="button"
        class="kbm-btn kbm-btn-accent"
        data-kbm-account-membership-action="manageBilling"
        data-kbm-account-membership-manage-billing
        hidden
      >
        Manage Billing
      </button>
      <button
        type="button"
        class="kbm-btn kbm-btn-outline"
        data-kbm-account-membership-action="switchToAnnual"
        data-kbm-account-membership-switch-annual
        hidden
      >
        Switch to Annual Membership
      </button>
      <button
        type="button"
        class="kbm-btn kbm-btn-accent"
        data-kbm-account-membership-action="renewAnnual"
        data-kbm-account-membership-renew-annual
        hidden
      >
        Renew Annual Membership
      </button>
      <button
        type="button"
        class="kbm-btn kbm-btn-outline"
        data-kbm-account-membership-action="becomeMonthly"
        data-kbm-account-membership-become-monthly
        hidden
      >
        Become a Monthly Member
      </button>
    </div>

    <p
      class="account-membership-panel__annual-switch-warning"
      data-kbm-account-membership-annual-switch-warning
      hidden
    ></p>

    <p
      class="account-membership-panel__billing-description"
      data-kbm-account-membership-billing-description
      hidden
    ></p>

    <p
      class="account-membership-panel__action-status"
      data-kbm-account-membership-action-status
      hidden
      role="status"
      aria-live="polite"
    ></p>

    <section
      class="account-membership-panel__history"
      data-kbm-account-membership-history
      hidden
    >
      <h3 class="account-membership-panel__history-heading">
        <button
          type="button"
          class="account-membership-panel__history-toggle"
          data-kbm-account-membership-history-toggle
          aria-expanded="false"
          aria-controls="membership-history-panel"
        >
          <span
            class="account-membership-panel__history-title"
            data-kbm-account-membership-history-title
          >Membership History</span>
          <span
            class="account-membership-panel__history-chevron"
            aria-hidden="true"
          ></span>
        </button>
      </h3>
      <div
        id="membership-history-panel"
        class="account-membership-panel__history-panel"
        data-kbm-account-membership-history-panel
        hidden
      >
        <ol
          class="account-membership-panel__timeline"
          data-kbm-account-membership-history-list
        ></ol>
      </div>
    </section>
  </div>
</section>

<style>
  .account-membership-panel {
    scroll-margin-top: calc(var(--header-offset, 170px) + 1rem);
    min-width: 0;
    border-color: #d8dfd0;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.06);
  }

  /* Author display rules (e.g. flex on actions) must not override native hidden. */
  .account-membership-panel [hidden] {
    display: none !important;
  }

  .account-membership-panel .dashboard-card__title {
    margin-bottom: 0.75rem;
  }

  .account-membership-panel__loading,
  .account-membership-panel__error {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #4b5563;
  }

  .account-membership-panel__error {
    color: #6b4f1d;
    background: #fbf6ea;
    border: 1px solid #ead9a8;
    border-radius: 8px;
    padding: 0.75rem 0.9rem;
  }

  .account-membership-panel__facts {
    display: grid;
    gap: 0.65rem 1.5rem;
    margin: 0 0 1.15rem;
    padding: 0;
  }

  @media (min-width: 560px) {
    .account-membership-panel__facts {
      grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    }
  }

  .account-membership-panel__fact {
    margin: 0;
    min-width: 0;
  }

  .account-membership-panel__fact dt {
    margin: 0 0 0.2rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #6b7280;
  }

  .account-membership-panel__fact dd {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    color: #2c3a57;
  }

  .account-membership-panel__auto-renew {
    margin: 0 0 1.15rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #4b5563;
  }

  .account-membership-panel__active-until {
    margin: 0 0 1.15rem;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    border: 1px solid #d8dfd0;
    background: #f4f7f0;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.45;
    color: #2c3a57;
  }

  .account-membership-panel__annual-switch-warning {
    margin: 0.65rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: #4b5563;
  }

  .account-membership-panel__billing-description {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: #6b7280;
  }

  .account-membership-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .account-membership-panel__actions .kbm-btn {
    min-width: 9.5rem;
  }

  .account-membership-panel__action-status {
    margin: 0.85rem 0 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: #6b4f1d;
  }

  @media (max-width: 480px) {
    .account-membership-panel__actions .kbm-btn {
      width: 100%;
      min-width: 0;
    }
  }

  .account-membership-panel__history {
    margin-top: 1.5rem;
    padding-top: 1.35rem;
    border-top: 1px solid #eef0f2;
  }

  .account-membership-panel__history-heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .account-membership-panel__history-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    width: 100%;
    margin: 0;
    padding: 0.35rem 0;
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
    color: #374151;
    text-align: left;
  }

  .account-membership-panel__history-toggle:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
    border-radius: 6px;
  }

  .account-membership-panel__history-title {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .account-membership-panel__history-chevron {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    color: #6b7280;
    line-height: 1;
  }

  .account-membership-panel__history-chevron::after {
    content: "+";
  }

  .account-membership-panel__history-toggle[aria-expanded="true"]
    .account-membership-panel__history-chevron::after {
    content: "-";
  }

  .account-membership-panel__history-panel {
    margin-top: 0.9rem;
  }

  .account-membership-panel__timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
</style>

<!-- History rows are created dynamically by account-membership-history.ts, so
     scoped styles would never match them. Scope these globally under the panel's
     data attribute instead. Compact newest-first two-column list: fixed MM/DD/YYYY
     date, then the label (with any secondary detail beneath it in column 2). -->
<style is:global>
  [data-kbm-account-membership] .membership-history-row {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    column-gap: 16px;
    align-items: start;
    padding: 0.3rem 0;
  }

  [data-kbm-account-membership]
    .membership-history-row
    + .membership-history-row {
    border-top: 1px solid #eef0f2;
  }

  [data-kbm-account-membership] .membership-history-date {
    font-size: 0.88rem;
    line-height: 1.4;
    color: #6b7280;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  [data-kbm-account-membership] .membership-history-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  [data-kbm-account-membership] .membership-history-label {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
    color: #2c3a57;
  }

  [data-kbm-account-membership] .membership-history-description {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.35;
    color: #6b7280;
  }

  /* Only stack the date above the label on very narrow screens. */
  @media (max-width: 360px) {
    [data-kbm-account-membership] .membership-history-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.1rem;
    }
  }
</style>
