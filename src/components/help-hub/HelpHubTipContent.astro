---
import "../talk-bubbles.css";
import videosPublic from "../../data/videos-public.json";
import {
  prepareHelpHubTipPage,
  type HelpHubPageTip,
} from "../../lib/helpHub/prepareTipPage";
import HelpHubRelatedTool from "./HelpHubRelatedTool.astro";
import type { HelpHubLessonRecord } from "../../lib/helpHubMemberLesson";
import {
  helpHubToolDomId,
  helpHubToolLoginReturnPath,
} from "../../lib/helpHub/relatedToolModal";

interface Props {
  tip: HelpHubPageTip;
  lessons: HelpHubLessonRecord[];
  /** Landing-page answer: skip the duplicate question heading and page chrome. */
  embedded?: boolean;
  /** Leave video/iframe src unset until the answer is opened. */
  deferMedia?: boolean;
  /** Unique prefix so several answers on one page do not share heading ids. */
  idPrefix?: string;
}

const { tip, lessons, embedded = false, deferMedia = false, idPrefix = "" } = Astro.props;

const view = prepareHelpHubTipPage(
  tip,
  Array.isArray(lessons) ? lessons : [],
  Array.isArray(videosPublic) ? videosPublic : [],
);

const {
  memberResourceCards,
  memberLessonsSectionTitle,
  whyBody,
  tipJumpLinks,
  appliesToList,
  showAllMachines,
  showSpecificMachines,
  quickSteps,
  tryObj,
  tryImageUrl,
  tryImageCaptionResolved,
  hasTrySection,
  mediaType,
  mediaUrl,
  mediaPoster,
  mediaAlt,
  mediaCaption,
  catalogVimeoEmbedUrl,
  hasHeroMedia,
  relatedTool,
  aboutHeading,
  tryHeading,
} = view;

const scope = idPrefix.trim();
const whyHeadingId = scope ? `${scope}-why` : "help-hub-why-heading";
const memberHeadingId = scope ? `${scope}-member-lessons` : "member-lessons-heading";
const lessonDomId = helpHubToolDomId(
  scope || (typeof tip.slug === "string" ? tip.slug : "") || "entry",
);
const lessonPanelId = `${lessonDomId}-member-lessons-panel`;
const lessonDialogId = `${lessonDomId}-lesson-modal`;
const lessonTitleId = `${lessonDialogId}-title`;
const lessonLoginReturn = helpHubToolLoginReturnPath(
  typeof tip.slug === "string" ? tip.slug : "",
);
const showLessonsLabel = memberResourceCards.length === 1 ? "Show lesson" : "Show lessons";
const hideLessonsLabel = memberResourceCards.length === 1 ? "Hide lesson" : "Hide lessons";
function liveMediaSrc(url: string): string | undefined {
  if (deferMedia || !url) return undefined;
  return url;
}

function deferredMediaSrc(url: string): string | undefined {
  if (!deferMedia || !url) return undefined;
  return url;
}

/** Keep the play mark on the same line as the last word of the lesson title. */
function lessonTitleEnding(title: string): { lead: string; end: string } {
  const trimmed = title.trim();
  const splitAt = trimmed.lastIndexOf(" ");
  if (splitAt <= 0) return { lead: "", end: trimmed };
  return { lead: trimmed.slice(0, splitAt + 1), end: trimmed.slice(splitAt + 1) };
}
---

<div
  class:list={["help-hub-tip-body", embedded && "help-hub-tip-body--embedded"]}
  data-pagefind-ignore={embedded ? true : undefined}
>
    <div class="tuesday-tip-hero">
      {typeof tip.hook === "string" && tip.hook.trim() !== "" && (
        <p class="bubble-hook tuesday-tip-hero__hook" data-placeholder="short subtitle/supporting sentence">
          {tip.hook}
        </p>
      )}

      {(showAllMachines || showSpecificMachines) && (
        <div class="tip-meta-row">
          {showAllMachines ? (
            <span class="machine-pill">All Machines</span>
          ) : (
            <p class="tuesday-tip-applies-to">
              <strong>Works for:</strong> {appliesToList.join(", ")}
            </p>
          )}
        </div>
      )}

      <div class:list={["tuesday-tip-hero__columns", !hasHeroMedia && "tuesday-tip-hero__columns--no-media"]}>
        <div class="tuesday-tip-hero__content">
          <div class="tuesday-tip-bubbles">
            {!embedded && (tip.question || tip.title) && (
              <div class="talk-row talk-left tuesday-tip-bubble-row">
                <h1 class="talk-bubble bubble-bl bubble-question tuesday-tip__question" data-placeholder="title">
                  {tip.question || tip.title || "Help Hub"}
                </h1>
              </div>
            )}

            {typeof tip.bubbleAnswer === "string" &&
              tip.bubbleAnswer.trim() !== "" && (
                <div class="talk-row talk-right tuesday-tip-bubble-row" aria-label="Quick answer">
                  <div class="talk-bubble bubble-br bubble-answer tuesday-tip__answer">
                    <div class="tuesday-tip__answer-inner">
                      <img
                        src="/images/KINlogo.svg"
                        alt="Knit it Now"
                        class="tuesday-tip__logo"
                        width="60"
                        height="60"
                      />
                      <div
                        class="tuesday-tip__answer-text"
                        data-placeholder="quick answer"
                        set:html={tip.bubbleAnswer}
                      />
                    </div>
                  </div>
                </div>
              )}
          </div>
        </div>

        {hasHeroMedia && (
        <div class="tuesday-tip-hero__media" aria-label="Free visual">
        <div class="tuesday-tip-video-shell" data-placeholder="hero media">
          <div class="tuesday-tip-video-aspect">
            {catalogVimeoEmbedUrl ? (
              <div class="help-hub-media">
                <iframe
                  src={liveMediaSrc(catalogVimeoEmbedUrl)}
                  data-src={deferredMediaSrc(catalogVimeoEmbedUrl)}
                  data-help-hub-deferred-media={deferMedia ? "true" : undefined}
                  class="tuesday-tip-video-iframe"
                  title={tip.question || tip.title || "Help Hub video"}
                  frameborder="0"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            ) : mediaType === "image" && mediaUrl ? (
              <img
                src={mediaUrl}
                alt={mediaAlt}
                class="tuesday-tip-media-image"
                loading="lazy"
              />
            ) : mediaType === "vimeo" && mediaUrl ? (
              <div class="help-hub-media">
                <iframe
                  src={liveMediaSrc(`https://player.vimeo.com/video/${mediaUrl}`)}
                  data-src={deferredMediaSrc(`https://player.vimeo.com/video/${mediaUrl}`)}
                  data-help-hub-deferred-media={deferMedia ? "true" : undefined}
                  class="tuesday-tip-video-iframe"
                  title={tip.question || tip.title || "Help Hub video"}
                  frameborder="0"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            ) : mediaType === "video" && mediaUrl ? (
              <video
                class="tuesday-tip-video-native"
                controls
                playsinline
                preload="metadata"
                poster={mediaPoster || undefined}
              >
                <source
                  src={liveMediaSrc(mediaUrl)}
                  data-src={deferredMediaSrc(mediaUrl)}
                  data-help-hub-deferred-media={deferMedia ? "true" : undefined}
                />
                {mediaAlt ? <p>{mediaAlt}</p> : null}
              </video>
            ) : null}
          </div>
        </div>
        {mediaType === "image" && mediaCaption ? (
          <p class="tuesday-tip-media-caption">{mediaCaption}</p>
        ) : null}
        </div>
        )}
      </div>
    </div>

    <section
      class="tuesday-tip__section tuesday-tip__section--why"
      aria-labelledby={whyHeadingId}
    >
      <h2 id={whyHeadingId} class="tuesday-tip__section-heading">
        {aboutHeading}
      </h2>
      <div class="tuesday-tip__section-card">
        {whyBody ? (
          <div
            class="tuesday-tip__description"
            data-placeholder="why this works text"
            set:html={whyBody}
          ></div>
        ) : (
          <p class="tuesday-tip__description" data-placeholder="why this works text">
            More detail for this tip will appear here when the Help Hub record includes a
            bridge.
          </p>
        )}
        {tipJumpLinks.length > 0 && (
          <nav class="tuesday-tip__jump-links" aria-label="Jump to sections on this page">
            <ul class="tuesday-tip__jump-links-list">
              {tipJumpLinks.map((j) => (
                <li>
                  <a href={j.href.trim()}>{j.label.trim()}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <section class="tuesday-tip__transcript" data-placeholder="transcript"></section>
      </div>
    </section>

    {hasTrySection && quickSteps.length > 0 && (
      <section class="tuesday-tip__section tuesday-tip__try-section">
        <div class="tuesday-tip__try-card">
          <h2 class="tuesday-tip__section-heading tuesday-tip__try-heading">{tryHeading}</h2>
          {typeof tryObj?.quickActionTitle === "string" &&
            tryObj.quickActionTitle.trim() !== "" && (
              <p class="tuesday-tip__try-subhead">{tryObj.quickActionTitle}</p>
            )}
          <div
            class:list={[
              "tuesday-tip__try-body",
              tryImageUrl && "tuesday-tip__try-body--with-image",
            ]}
          >
            <div class="tuesday-tip__try-checklist">
              <ul data-placeholder="try this checklist">
                {quickSteps.map((step) => (
                  <li set:html={step} />
                ))}
              </ul>
              {tryObj?.quickActionNote && (
                <div class="try-this-note" set:html={tryObj.quickActionNote}></div>
              )}
            </div>
            {tryImageUrl && (
              <div class="tuesday-tip__try-image-wrap">
                <img
                  src={tip.tryImage}
                  alt={tip.tryImageAlt || ""}
                  loading="lazy"
                  class="tuesday-tip__try-image"
                />
                {tryImageCaptionResolved ? (
  <p class="try-image-caption" set:html={tryImageCaptionResolved}></p>
) : null}
              </div>
            )}
            {tip.tryNote && (
            <p class="try-note" set:html={tip.tryNote}></p>)}
          </div>
        </div>
      </section>
    )}

    {relatedTool && (
      <HelpHubRelatedTool
        relatedTool={relatedTool}
        instanceId={scope || "entry"}
        entrySlug={typeof tip.slug === "string" ? tip.slug : ""}
      />
    )}

    {memberResourceCards.length > 0 && (
    <section
      class="help-hub-member-lessons"
      aria-labelledby={memberHeadingId}
      data-help-hub-lessons
      data-help-hub-lesson-return={lessonLoginReturn || undefined}
    >
      <div class="help-hub-member-lessons__header">
        <div class="help-hub-member-lessons__heading-row">
          <img
            src="/images/KINlogo.svg"
            alt=""
            width="48"
            height="48"
            class="help-hub-member-lessons__logo"
            aria-hidden="true"
          />
          <h2 id={memberHeadingId} class="help-hub-member-lessons__section-title">
            {memberLessonsSectionTitle}
          </h2>
        </div>
        <p class="help-hub-member-lessons__subhead">
          Go deeper with step-by-step guidance.
        </p>
      </div>

      <details class="help-hub-member-lessons__details" id={lessonPanelId}>
        <summary class="help-hub-member-lessons__toggle">
          <span class="help-hub-member-lessons__toggle-show">{showLessonsLabel}</span>
          <span class="help-hub-member-lessons__toggle-hide">{hideLessonsLabel}</span>
        </summary>
        <ul class="help-hub-member-lessons__list">
          {memberResourceCards.map((resource) => {
            const titleEnding = lessonTitleEnding(resource.title);
            return (
            <li class="help-hub-member-lessons__item">
              <button
                type="button"
                class="help-hub-member-lessons__lesson"
                data-help-hub-lesson-open
                data-lesson-title={resource.title}
                data-content-id={
                  resource.kind === "library" && resource.resourceId
                    ? String(resource.resourceId)
                    : undefined
                }
                aria-controls={lessonDialogId}
                aria-expanded="false"
              >
                <span class="help-hub-member-lessons__lesson-label">{titleEnding.lead}<span class="help-hub-member-lessons__title-end">{titleEnding.end}<span class="help-hub-member-lessons__play" aria-hidden="true"></span></span></span>
              </button>
              <div class="help-hub-member-lessons__gate" data-hh-lesson-gate hidden>
                <div
                  class="help-hub-member-lessons__cta-mount"
                  data-hh-lesson-cta
                  data-lesson-href={resource.href}
                ></div>
                <p class="help-hub-member-lessons__note" data-hh-lesson-note hidden>
                  Included with Knit it Now membership.
                </p>
              </div>
            </li>
            );
          })}
        </ul>
      </details>

      <div
        id={lessonDialogId}
        class="help-hub-lesson-modal"
        data-help-hub-lesson-modal
        role="dialog"
        aria-modal="true"
        aria-labelledby={lessonTitleId}
        tabindex="-1"
        hidden
      >
        <div class="help-hub-lesson-modal__panel">
          <div class="help-hub-lesson-modal__header">
            <h2 id={lessonTitleId} class="help-hub-lesson-modal__title" data-help-hub-lesson-modal-title>
              Lesson
            </h2>
            <button type="button" class="help-hub-lesson-modal__close" data-help-hub-lesson-close>
              Close
            </button>
          </div>
          <div class="help-hub-lesson-modal__body">
            <div class="help-hub-lesson-modal__player" data-help-hub-lesson-player>
              <p class="help-hub-lesson-modal__status" data-help-hub-lesson-status aria-live="polite"></p>
            </div>
          </div>
        </div>
      </div>
    </section>
    )}
</div>

<style>
  .help-hub-tip-body {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: break-word;
  }

  .tuesday-tip-hero {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 1.75rem;
    padding: clamp(1rem, 2.5vw, 1.4rem);
    border: 1px solid rgba(82, 104, 45, 0.18);
    border-radius: 16px;
    background: #f8faf6;
    position: relative;
  }

  .tuesday-tip-hero__hook {
    margin: 0 0 1rem 0;
    flex: 0 0 auto;
    order: 0;
  }

  /* Machine meta: direct child of .tuesday-tip-hero only — never inside .tuesday-tip-bubbles */
  .tuesday-tip-hero > .tip-meta-row {
    margin: 0 0 1rem 0;
    width: 100%;
    box-sizing: border-box;
    flex: 0 0 auto;
    order: 1;
    position: relative;
    /* Uncomment to verify DOM placement: outline: 2px solid red; */
  }

  .tip-meta-row .tuesday-tip-applies-to {
    margin: 0;
  }

  .tuesday-tip-hero__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    flex: 0 1 auto;
    order: 2;
    position: relative;
  }

  @media (min-width: 980px) {
    .tuesday-tip-hero__columns {
      grid-template-columns: minmax(320px, 1fr) minmax(420px, 1fr);
      gap: clamp(1.2rem, 2.5vw, 2rem);
      align-items: start;
    }

    .tuesday-tip-hero__columns--no-media {
      grid-template-columns: 1fr;
    }
  }

  .tuesday-tip-hero__content {
    min-width: 0;
  }

  .tuesday-tip-bubbles {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .tuesday-tip-hero > .tuesday-tip-hero__hook.bubble-hook {
    font-size: clamp(0.98rem, 1.45vw, 1.06rem);
    font-weight: 400;
    line-height: 1.55;
    color: #5e6c4d;
  }

  .tuesday-tip-applies-to {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: #475569;
  }

  .machine-pill {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(82, 104, 45, 0.25);
    background: rgba(82, 104, 45, 0.08);
    color: #3f4b35;
    font-size: 0.8rem;
    line-height: 1.2;
    font-weight: 600;
  }

  .tuesday-tip-bubble-row.talk-row {
    margin: 0;
  }

  .tuesday-tip-bubble-row.talk-left {
    margin-top: 0.3rem;
  }

  .tuesday-tip-bubbles .talk-bubble {
    max-width: 100%;
  }

  .talk-bubble.tuesday-tip__question {
    font-size: clamp(1.45rem, 2.6vw, 1.95rem);
    font-weight: 650;
    line-height: 1.16;
    margin: 0;
    color: #6f8550;
  }

  .talk-bubble.tuesday-tip__answer {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.55;
    padding: 16px 20px 16px 20px;
    margin-left: 60px;
  }

  .tuesday-tip__answer-inner {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .tuesday-tip__logo {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
  }

  .tuesday-tip__answer-text {
    flex: 1;
  }

  .tuesday-tip-hero__media {
    min-width: 0;
  }

  .tuesday-tip-video-shell {
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 0.5rem;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    width: 100%;
    max-width: 100%;
  }

  .tuesday-tip-video-aspect {
    position: relative;
    width: 100%;
    padding-bottom: 60%;
    height: 0;
    border-radius: 8px;
    background: #0f172a;
  }

  .tuesday-tip-video-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .tuesday-tip-video-native {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    object-fit: contain;
    background: #000;
  }

  .help-hub-media {
    position: absolute;
    inset: 0;
  }

  .tuesday-tip-media-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tuesday-tip-media-caption {
    margin: 0.55rem 0 0;
    font-style: italic;
    font-size: 0.9rem;
    line-height: 1.4;
    color: #6b7280;
  }

  .tuesday-tip-video-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: linear-gradient(160deg, #f1f5f9 0%, #e2e8f0 100%);
  }

  .tuesday-tip-video-fallback__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #64748b;
    text-align: center;
    max-width: 16rem;
  }

  .tuesday-tip__section {
    margin-top: 2rem;
  }

  .tuesday-tip__section--why {
    margin-top: 0.75rem;
  }

  .tuesday-tip__section-heading {
    margin: 0 0 0.7rem;
    font-size: clamp(1.12rem, 2.1vw, 1.32rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--kbm-green, #52682d);
  }

  .tuesday-tip__section-card {
    border-radius: 12px;
    border: 1px solid rgba(82, 104, 45, 0.16);
    background: #fff;
    padding: clamp(0.95rem, 2.1vw, 1.15rem);
  }

  .tuesday-tip__description {
    margin: 0;
    max-width: 100%;
    font-size: 1rem;
    line-height: 1.65;
    color: #2f3a25;
  }

  .tuesday-tip__jump-links {
    margin: 0 0 1rem;
    max-width: 100%;
  }

  .tuesday-tip__jump-links-list {
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.6;
    color: #334155;
  }

  .tuesday-tip__jump-links a {
    color: var(--kbm-green, #52682d);
    text-decoration: none;
  }

  .tuesday-tip__jump-links a:hover {
    text-decoration: underline;
  }

  .tuesday-tip__transcript {
    margin-top: 1.25rem;
    max-width: 100%;
  }

  .tuesday-tip__transcript:not(:empty) {
    padding-top: 1.15rem;
    border-top: 1px solid #e5e7eb;
  }

  .tuesday-tip__try-card {
    max-width: 860px;
    margin: 0;
    padding: clamp(1rem, 2.2vw, 1.35rem);
    border: 1px solid rgba(82, 104, 45, 0.25);
    border-radius: 12px;
    background: #f7faf4;
  }

  @media (max-width: 768px) {
    .tuesday-tip__try-card {
      padding: 1rem;
    }
  }

  .tuesday-tip__try-heading {
    margin: 0 0 0.75rem;
  }

  .tuesday-tip__try-subhead {
    margin: 0 0 0.65rem;
    font-weight: 600;
    color: #3f4b35;
  }

  .tuesday-tip__try-subhead--spaced {
    margin-top: 1.25rem;
  }

  .tuesday-tip__try-body--with-image {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 1.5rem);
    align-items: start;
  }

  @media (max-width: 768px) {
    .tuesday-tip__try-body--with-image {
      grid-template-columns: 1fr;
    }
  }

  .tuesday-tip__try-image-wrap {
    min-width: 0;
  }

  .tuesday-tip__try-image {
    display: block;
    max-width: 100%;
    width: 100%;
    height: auto;
    border-radius: 10px;
    object-fit: contain;
  }

  .try-image-caption {
    margin-top: 6px;
    padding-left: 10px;
    font-style: italic;
    font-size: 0.9rem;
    line-height: 1.4;
    color: #6b7280;
    white-space: pre-line;
  }

  .tuesday-tip__try-body ul {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }

  .tuesday-tip__try-body li {
    position: relative;
    padding-left: 1.6rem;
    margin-bottom: 10px;
  }

  .tuesday-tip__try-body li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 10px;
    height: 10px;
    border: 2px solid #52682d;
    border-radius: 3px;
    transform: translateY(-50%);
  }

  .try-this-note {
    margin-top: 10px;
    font-size: 14px;
    color: #555;
    padding-top: 8px;
    border-top: 1px solid #e0e0e0;
  }

  .try-this-note div:first-child {
    font-weight: 600;
    margin-bottom: 4px;
  }

  .try-note {
    margin-top: 12px;
    font-size: 0.95rem;
    color: #6b7280;
  }

  .gauge-table {
    width: 100%;
    margin-top: 10px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .gauge-table tr {
    border-bottom: 1px solid #e5e5e5;
  }

  .gauge-table td {
    padding: 10px 0;
    vertical-align: top;
  }

  .gauge-table td:first-child {
    font-weight: 600;
    width: 42%;
  }

  .gauge-table tr:first-child td {
    padding-top: 0;
    padding-bottom: 6px;
    font-weight: 700;
  }

  .help-hub-member-lessons {
    margin-top: clamp(3.5rem, 7vw, 4.75rem);
