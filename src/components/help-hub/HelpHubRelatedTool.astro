---
import BandPickupTool from "../tools/BandPickupTool.astro";
import { findToolByRequestPath } from "../../lib/tools/toolMembership";
import {
  helpHubToolDomId,
  helpHubToolLoginReturnPath,
} from "../../lib/helpHub/relatedToolModal";
import type { HelpHubRelatedToolView } from "../../lib/helpHub/prepareTipPage";

interface Props {
  relatedTool: HelpHubRelatedToolView;
  instanceId: string;
  entrySlug?: string;
}

const { relatedTool, instanceId, entrySlug = "" } = Astro.props;
const modal = relatedTool.modal;
const domId = helpHubToolDomId(instanceId);
const dialogId = `${domId}-tool-modal`;
const titleId = `${dialogId}-title`;
const catalogTool = modal ? findToolByRequestPath(relatedTool.href) : null;
const loginReturnPath = helpHubToolLoginReturnPath(entrySlug);
const showCard = Boolean(relatedTool.eyebrow || relatedTool.title || relatedTool.note);
---

<div
  class:list={[
    "help-hub-related-tool",
    showCard && "help-hub-related-tool--card",
  ]}
  data-help-hub-tool={modal ? "true" : undefined}
>
  {relatedTool.eyebrow ? (
    <p class="help-hub-related-tool__eyebrow">{relatedTool.eyebrow}</p>
  ) : null}
  {relatedTool.title ? (
    <h2 class="help-hub-related-tool__title">{relatedTool.title}</h2>
  ) : null}
  {relatedTool.note ? <p class="help-hub-related-tool__note">{relatedTool.note}</p> : null}
  <a
    class="kbm-btn kbm-btn-primary help-hub-related-tool__button"
    href={relatedTool.href}
    data-help-hub-tool-open={modal ? "true" : undefined}
    aria-haspopup={modal ? "dialog" : undefined}
    aria-expanded={modal ? "false" : undefined}
    aria-controls={modal ? dialogId : undefined}
  >
    {relatedTool.memberOnly ? (
      <span class="help-hub-related-tool__member-label">Member Tool</span>
    ) : null}
    <span class="help-hub-related-tool__button-label">{relatedTool.label}</span>
  </a>

  {
    modal && (
      <div
        id={dialogId}
        class="help-hub-tool-modal"
        data-help-hub-tool-modal
        data-help-hub-tool-return={loginReturnPath || undefined}
        role="dialog"
        aria-modal="true"
        aria-labelledby={titleId}
        tabindex="-1"
        hidden
      >
        <div class="help-hub-tool-modal__panel">
          <div class="help-hub-tool-modal__header">
            <h2 id={titleId} class="help-hub-tool-modal__title">
              {modal.title}
            </h2>
            <button type="button" class="help-hub-tool-modal__close" data-help-hub-tool-close>
              Close
            </button>
          </div>
          <div class="help-hub-tool-modal__body" data-help-hub-tool-body>
            {modal.toolPath === "/tools/band-pickup" && (
              <BandPickupTool
                context="help-hub"
                instanceId={domId}
                loginReturnPath={loginReturnPath}
                tool={catalogTool}
              />
            )}
          </div>
        </div>
      </div>
    )
  }
</div>

<script>
  import { initHelpHubToolModals } from "../../lib/helpHub/helpHubToolModal";

  initHelpHubToolModals();
</script>

<style>
  .help-hub-related-tool {
    margin-top: 1.25rem;
  }

  .help-hub-related-tool--card {
    margin-top: 1.5rem;
    padding: clamp(1.2rem, 2.2vw, 1.45rem) clamp(1.15rem, 2.1vw, 1.4rem);
    border-radius: 12px;
    background: #fff;
    border: 1px solid rgba(82, 104, 45, 0.18);
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
  }

  .help-hub-related-tool__eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--kbm-green, #52682d);
  }

  .help-hub-related-tool__title {
    margin: 0 0 0.9rem;
    font-size: 1.15rem;
    line-height: 1.3;
    font-weight: 650;
    color: #3f4b35;
  }

  .help-hub-related-tool__note {
    margin: 0 0 0.9rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: #334155;
  }

  .help-hub-related-tool__button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .help-hub-related-tool__member-label {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.55);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: none;
  }

  .help-hub-tool-modal[hidden] {
    display: none !important;
  }

  .help-hub-tool-modal:not([hidden]) {
    position: fixed;
    inset: 0;
    /* Above the DEV preview badge (9998) and header menus (9999). Memberstack login is raised to 100000 while this is open. */
    z-index: 10000;
    display: flex;
    align-items: stretch;
    justify-content: center;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(15, 23, 42, 0.48);
  }

  .help-hub-tool-modal:focus {
    outline: none;
  }

  .help-hub-tool-modal__panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    max-height: 100dvh;
    min-height: 0;
    background: var(--page-bg, #f6f4ef);
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.18);
  }

  .help-hub-tool-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    flex-shrink: 0;
    padding: calc(0.85rem + env(safe-area-inset-top, 0px)) 1rem 0.85rem;
    background: #fff;
    border-bottom: 1px solid rgba(82, 104, 45, 0.16);
  }

  .help-hub-tool-modal__title {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--kbm-green, #52682d);
  }

  .help-hub-tool-modal__close {
    flex-shrink: 0;
    min-height: 2.75rem;
    min-width: 4.5rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid rgba(82, 104, 45, 0.35);
    border-radius: 8px;
    background: #fff;
    color: #3f4b35;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 650;
    cursor: pointer;
  }

  .help-hub-tool-modal__close:hover,
  .help-hub-tool-modal__close:focus-visible {
    background: #f3f6ee;
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }

  .help-hub-tool-modal__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 0.85rem 1rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 700px) {
    .help-hub-tool-modal:not([hidden]) {
      align-items: center;
      padding: 1rem;
    }

    .help-hub-tool-modal__panel {
      width: min(72rem, 100%);
      height: min(100%, calc(100dvh - 2rem));
      max-height: calc(100dvh - 2rem);
      border-radius: 14px;
      overflow: hidden;
    }

    .help-hub-tool-modal__header {
      padding-top: 1rem;
      border-top-left-radius: 14px;
      border-top-right-radius: 14px;
    }
  }
</style>
