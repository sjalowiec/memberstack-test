---
import Layout from "../../layouts/Layout.astro";
import PageBackLink from "../common/PageBackLink.astro";
import PageHead from "../PageHead.astro";
import FavoritesRuntime from "../favorites/FavoritesRuntime.astro";
import HelpHubTipContent from "./HelpHubTipContent.astro";
import { loadMergedVideoCatalog } from "../../lib/videos/videoCatalogStore";
import {
  prepareHelpHubTipPage,
  type HelpHubPageTip,
} from "../../lib/helpHub/prepareTipPage";
import { helpHubPreviewBaseHref } from "../../lib/helpHub/previewDocument";
import type { HelpHubLessonRecord } from "../../lib/helpHubMemberLesson";

interface Props {
  tip: HelpHubPageTip;
  preview?: boolean;
  lessons: HelpHubLessonRecord[];
  /** Admin preview only. Does not change membership or who can open the saved page. */
  previewAudience?: "member" | "visitor";
}

const { tip, preview = false, lessons, previewAudience } = Astro.props;
const audience =
  preview && (previewAudience === "member" || previewAudience === "visitor")
    ? previewAudience
    : undefined;

const catalogVideos = await loadMergedVideoCatalog();

const view = prepareHelpHubTipPage(
  tip,
  Array.isArray(lessons) ? lessons : [],
  catalogVideos,
);

const { layoutTitle, pageDescription, faqJsonLd } = view;

const previewDocumentBaseHref = preview ? helpHubPreviewBaseHref(Astro.url.origin) : "";
const articleSlug = !preview && typeof tip.slug === "string" ? tip.slug.trim() : "";
---

<Layout
  title={layoutTitle}
  description={pageDescription}
  bodyClass="page--tight-header"
  documentBaseHref={previewDocumentBaseHref}
>
  {!preview && faqJsonLd && (
    <script type="application/ld+json" set:html={faqJsonLd} />
  )}
  <PageHead title="Help Hub" subhead={undefined} hideTitle={true} />

  <section
    class="container py-5 tips-page-section"
    data-help-hub-preview-audience={audience}
    data-help-hub-article-slug={articleSlug || undefined}
  >
    {preview && (
      <p class="help-hub-preview-banner">
        Preview — saved {typeof tip.status === "string" ? tip.status : "draft"} (not public)
      </p>
    )}
    <PageBackLink href="/help-hub" text="Back to Help Hub" />
    <HelpHubTipContent tip={tip} lessons={lessons} videos={catalogVideos} markSections={preview} />
    <FavoritesRuntime contentType="reference" />
  </section>
  <script>
    import { bootHelpHubMemberLessonGates } from "../../scripts/helpHubMemberLessonGateClient";
    import { initHelpHubArticleReturn } from "../../scripts/helpHubLandingReturnClient";

    const article = document.querySelector("[data-help-hub-article-slug]");
    if (article instanceof HTMLElement) initHelpHubArticleReturn(article);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bootHelpHubMemberLessonGates);
    } else {
      bootHelpHubMemberLessonGates();
    }
  </script>
</Layout>

<style>
  .help-hub-preview-banner {
    margin: 0 0 1rem;
    padding: 0.65rem 0.9rem;
    border-radius: 8px;
    border: 1px solid #f59e0b;
    background: #fffbeb;
    color: #92400e;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .tips-page-section {
    max-width: min(1180px, 100%);
    margin-left: auto;
    margin-right: auto;
  }
</style>
