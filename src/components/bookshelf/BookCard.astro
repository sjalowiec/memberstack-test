---
import type { Book } from "../../lib/bookshelf";
import { buildSearchIndex, hasRating } from "../../lib/bookshelf";

interface Props {
  book: Book;
}

const { book } = Astro.props;

const search = buildSearchIndex(book);
const tagsAttr = book.tags.map((t) => t.toLowerCase()).join("|");
const detailHref = `/reference/bookshelf/${book.id}`;
const showRating = hasRating(book);
const ratingRounded = Math.round(book.avgRating);
---

<article
  class="book-card"
  data-book-id={book.id}
  data-topic={book.topic.toLowerCase()}
  data-tags={tagsAttr}
  data-search={search}
>
  <a class="book-card__link" href={detailHref}>
    <div class="book-card__media">
      {book.image ? (
        <img
          class="book-card__img"
          src={book.image}
          alt={`Cover of ${book.title}`}
          loading="lazy"
          decoding="async"
          onerror="this.style.display='none';this.closest('.book-card__media').classList.add('is-missing');"
        />
      ) : null}
      <div class="book-card__placeholder" aria-hidden="true">
        <span>No cover image</span>
      </div>
    </div>

    <div class="book-card__body">
      {book.topic && <span class="book-card__topic">{book.topic}</span>}
      <h3 class="book-card__title">{book.title}</h3>
      {book.author && <p class="book-card__author">by {book.author}</p>}

      {showRating && (
        <p class="book-card__rating" aria-label={`Rated ${book.avgRating} out of 5`}>
          <span class="book-card__stars" aria-hidden="true">
            {"★".repeat(ratingRounded)}{"☆".repeat(5 - ratingRounded)}
          </span>
          <span class="book-card__rating-num">
            {book.avgRating.toFixed(1)}
            <span class="book-card__rating-count"> ({book.ratingCount})</span>
          </span>
        </p>
      )}

      {book.tags.length > 0 && (
        <ul class="book-card__tags">
          {book.tags.slice(0, 4).map((tag) => (
            <li class="book-card__tag">{tag}</li>
          ))}
        </ul>
      )}
    </div>
  </a>
</article>

<style>
  .book-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 2px solid #c7d8a4;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .book-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 22px rgba(82, 104, 45, 0.14);
    border-color: var(--kbm-green, #52682d);
  }

  .book-card__link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .book-card__media {
    position: relative;
    aspect-ratio: 3 / 4;
    background: #eef1e7;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .book-card__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #f7f8f5;
  }

  /* Fallback placeholder: shown when there is no image OR the image fails. */
  .book-card__placeholder {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    color: #8a9a72;
    font-size: 0.95rem;
    font-weight: 600;
    background: repeating-linear-gradient(
      45deg,
      #eef1e7,
      #eef1e7 12px,
      #e6ebdb 12px,
      #e6ebdb 24px
    );
  }

  .book-card__media.is-missing .book-card__placeholder,
  .book-card__media:not(:has(.book-card__img)) .book-card__placeholder {
    display: flex;
  }

  .book-card__body {
    padding: 0.75rem 1.1rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }

  .book-card__topic {
    align-self: flex-start;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #6b7a58;
    background: rgba(82, 104, 45, 0.08);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }

  .book-card__title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--kbm-green, #52682d);
    margin: 0.15rem 0 0;
  }

  .book-card__author {
    font-size: 0.95rem;
    color: #5a5a5a;
    margin: 0;
  }

  .book-card__rating {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.1rem 0;
    font-size: 0.95rem;
  }

  .book-card__stars {
    color: #d8a200;
    letter-spacing: 1px;
  }

  .book-card__rating-num {
    color: #5a5a5a;
    font-weight: 600;
  }

  .book-card__rating-count {
    font-weight: 400;
    color: #8a8a8a;
  }

  .book-card__tags {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .book-card__tag {
    font-size: 0.78rem;
    color: #52682d;
    background: #f0f4e7;
    border: 1px solid #dbe6c5;
    border-radius: 6px;
    padding: 0.15rem 0.5rem;
  }
</style>
