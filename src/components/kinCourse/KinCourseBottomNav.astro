---
import type { KinCourseNavLink } from "../../lib/kinCourse/hrefs";

interface Props {
  previous: KinCourseNavLink | null;
  next: KinCourseNavLink | null;
}

const { previous, next } = Astro.props;
---

<nav
  class:list={[
    "course-lesson-nav",
    "course-bottom-nav",
    !previous && "course-lesson-nav--no-prev",
    !next && "course-lesson-nav--no-next",
  ]}
  aria-label="End of lesson"
>
  {
    previous ? (
      <a class="course-nav-lesson course-nav-lesson--prev" href={previous.href}>
        {previous.label}
      </a>
    ) : null
  }

  <button type="button" class="course-nav-contents" data-course-contents-open>
    Course Contents
  </button>

  {
    next ? (
      <a class="course-nav-lesson course-nav-lesson--next" href={next.href}>
        {next.label}
      </a>
    ) : null
  }
</nav>
