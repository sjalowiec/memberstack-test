---
import type { PresentedExerciseItem } from "../../lib/kinCourse/legacyCollapse";

interface Props {
  lessonId: number;
  courseId?: number;
  knownAssignIds?: number[];
  items?: PresentedExerciseItem[];
}

const { lessonId, items = [] } = Astro.props;
---

{
  items.length === 0 ? (
    <div class="legacy-error" role="alert">
      Cannot render Exercise in lesson {lessonId}: no populated exercise tasks were extracted.
    </div>
  ) : (
    <div class="legacy-exercise">
      {items.map((item) =>
        item.mode === "embedded-trigger" ? (
          <div class="legacy-exercise-item legacy-exercise-item--prompt legacy-html" set:html={item.html} />
        ) : (
          <details class="legacy-exercise-item">
            <summary>
              {item.image ? <img class="legacy-exercise-icon" src={item.image} alt="" /> : null}
              <span class="legacy-exercise-heading" set:html={item.headingHtml || ""} />
            </summary>
            <div class="legacy-exercise-body" set:html={item.detailsHtml || ""} />
          </details>
        ),
      )}
    </div>
  )
}
