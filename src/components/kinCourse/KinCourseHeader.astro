---
const homeHref = "/";
const coursesHref = "/courses/";
---

<header class="kin-site-header" data-pagefind-ignore>
  <div class="kin-site-header-inner">
    <a class="kin-site-brand" href={homeHref}>
      <img class="kin-site-logo" src="/images/KINlogo.svg" alt="" width="40" height="40" />
      <span class="kin-site-wordmark">Knit it Now</span>
    </a>
    <a class="kin-site-back" href={coursesHref} aria-label="Back to Courses">
      <span class="kin-site-back-full">Back to Courses</span>
      <span class="kin-site-back-short">Courses</span>
    </a>
  </div>
</header>
