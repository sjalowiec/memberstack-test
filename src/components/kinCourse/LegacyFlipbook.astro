---
import { stripHtml } from "../../lib/kinCourse/hrefs";

interface SlideItem {
  src?: string;
  caption?: string;
}

interface Props {
  lessonId: number;
  slides?: SlideItem[];
}

const { lessonId, slides = [] } = Astro.props;
const usable = slides.filter((slide) => Boolean(slide.src));

function slideAlt(slide: SlideItem, index: number): string {
  return stripHtml(slide.caption || '') || `Image ${index + 1} of ${usable.length}`;
}
---

{
  usable.length === 0 ? (
    <div class="legacy-error" role="alert">
      Cannot render flipbook in lesson {lessonId}: no recovered slides were extracted.
    </div>
  ) : (
    <div class="legacy-flipbook" data-legacy-flipbook role="region" aria-label="Image viewer">
      <div class="legacy-flipbook-controls">
        <button
          type="button"
          class="legacy-flipbook-btn"
          data-flipbook-prev
          disabled
          aria-label="Previous image"
        >
          Previous
        </button>
        <p class="legacy-flipbook-status" data-flipbook-status aria-live="polite">
          1 of {usable.length}
        </p>
        <button
          type="button"
          class="legacy-flipbook-btn"
          data-flipbook-next
          disabled={usable.length === 1}
          aria-label="Next image"
        >
          Next
        </button>
      </div>
      <div class="legacy-flipbook-stage">
        {usable.map((slide, index) => (
          <figure
            class="legacy-flipbook-item"
            data-flipbook-index={String(index)}
            hidden={index !== 0}
          >
            <img src={slide.src} alt={slideAlt(slide, index)} />
            {slide.caption ? (
              <figcaption set:html={slide.caption} />
            ) : null}
          </figure>
        ))}
      </div>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-legacy-flipbook]').forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-flipbook-index]'));
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-flipbook-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-flipbook-next]');
    const status = root.querySelector<HTMLElement>('[data-flipbook-status]');
    if (items.length === 0 || !prevBtn || !nextBtn || !status) return;

    const previous = prevBtn;
    const next = nextBtn;
    const label = status;
    let index = 0;

    function show(nextIndex: number) {
      index = Math.max(0, Math.min(items.length - 1, nextIndex));
      items.forEach((item, i) => {
        item.hidden = i !== index;
      });
      previous.disabled = index === 0;
      next.disabled = index === items.length - 1;
      label.textContent = `${index + 1} of ${items.length}`;
    }

    prevBtn.addEventListener('click', () => show(index - 1));
    nextBtn.addEventListener('click', () => show(index + 1));

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + 1);
      }
    });
  });
</script>
