---
import {
  jumpLinkButtonLabel,
  jumpSeconds,
  kinVimeoPlayerDomId,
} from "../../lib/kinCourse/vimeoJumpLinks";

interface Jump {
  time?: string;
  title?: string;
}

interface Props {
  lessonId: number;
  fallbackTitle?: string;
  vimeoId?: string;
  playerKey?: string;
  embedPlayer?: boolean;
  jumps?: Jump[];
}

const { lessonId, fallbackTitle = "Course video", vimeoId, playerKey = "", embedPlayer = false, jumps = [] } = Astro.props;

const usable = jumps
  .map((jump) => ({
    time: jump.time || "",
    title: jump.title || "",
    seconds: jumpSeconds(jump.time || ""),
  }))
  .filter((jump) => jump.seconds != null);

const canRender = Boolean(playerKey) && usable.length > 0;
---

{
  !canRender ? (
    <div class="legacy-error" role="alert">
      Cannot render VimeoJumpLinks in lesson {lessonId}:{" "}
      {!playerKey ? "no Vimeo player identifier was found" : "no jump-link timestamps were extracted"}.
    </div>
  ) : (
    <div class="legacy-jumplinks-block">
      {
        embedPlayer && vimeoId ? (
          <div class="legacy-vimeo-block">
            <div class="legacy-vimeo">
              <iframe
                id={kinVimeoPlayerDomId(playerKey)}
                data-kin-vimeo-player={playerKey}
                data-vimeo-id={vimeoId}
                src={`https://player.vimeo.com/video/${vimeoId}`}
                title={fallbackTitle}
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
              />
            </div>
          </div>
        ) : null
      }
      <nav
        class="legacy-jumplinks"
        data-kin-vimeo-player={playerKey}
        data-vimeo-id={vimeoId}
        aria-label="In this video"
      >
        <h3>In this video:</h3>
        {usable.map((jump) => (
          <button
            type="button"
            class="legacy-jumplink"
            data-jump-seconds={String(jump.seconds)}
          >
            {jumpLinkButtonLabel({ time: jump.time, title: jump.title })}
          </button>
        ))}
      </nav>
    </div>
  )
}

<script>
  import { bindKinCourseVimeoJumpLinks } from "../../scripts/kinCourseVimeoJumpLinks";
  bindKinCourseVimeoJumpLinks(document);
</script>
