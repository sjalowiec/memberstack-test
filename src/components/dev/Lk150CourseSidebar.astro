---
import {
  coursePreviewHref,
  getCoursePreviewData,
  getPreviewCourseIds,
  getSortedLessons,
  parseCourseId,
} from "../../lib/legacy_kin/coursePreviewPoc";
import type { LessonContentNavEntry } from "../../lib/legacy_kin/courseLessonContentItems";
import {
  legacyLessonHref,
  legacyLessonItemHref,
} from "../../lib/legacy_kin/legacyCourseLoader";

interface Props {
  courseId: number;
  currentLessonSlug?: string;
  currentItemSlug?: string;
  contentNavEntries?: LessonContentNavEntry[];
}

const {
  courseId: rawCourseId,
  currentLessonSlug,
  currentItemSlug,
  contentNavEntries = [],
} = Astro.props;
const courseId = parseCourseId(rawCourseId);
const course = getCoursePreviewData(courseId)!.course;
const lessons = getSortedLessons(courseId);
const previewCourses = getPreviewCourseIds()
  .map((id) => getCoursePreviewData(id)!)
  .map((data) => data.course);
const showContentNav = contentNavEntries.length > 1;
const publicCourseSlug = course.slug;
---

<aside class="course-preview__sidebar" aria-label="Course navigation">
  <header class="course-preview__sidebar-header">
    <label class="course-preview__course-select-wrap">
      <span class="course-preview__course-select-label">Course</span>
      <select
        class="course-preview__course-select"
        id="lk150-course-select"
        aria-label="Select LK-150 course"
        data-lk150-course-select
      >
        {
          previewCourses.map((previewCourse) => (
            <option
              value={coursePreviewHref(previewCourse.legacyChallengeId)}
              selected={previewCourse.legacyChallengeId === courseId}
            >
              {previewCourse.legacyChallengeId}. {previewCourse.title}
            </option>
          ))
        }
      </select>
    </label>

    <h2 class="course-preview__sidebar-title">
      <a href={coursePreviewHref(courseId)}>{course.title}</a>
    </h2>
    <p class="course-preview__sidebar-meta">Legacy course {courseId}</p>
  </header>

  <nav class="course-preview__sidebar-nav" aria-label="Lessons">
    <ol class="course-preview__sidebar-lessons">
      {
        lessons.map((lessonItem) => {
          const isActiveLesson = lessonItem.slug === currentLessonSlug;

          return (
            <li
              class:list={[
                "course-preview__sidebar-lesson",
                isActiveLesson && "course-preview__sidebar-lesson--active",
              ]}
            >
              <a
                class="course-preview__sidebar-lesson-link"
                href={legacyLessonHref(publicCourseSlug, lessonItem.slug)}
                aria-current={isActiveLesson ? "page" : undefined}
              >
                <span class="course-preview__sidebar-lesson-order">
                  {lessonItem.displayOrder}.
                </span>
                {lessonItem.title}
              </a>

              {
                isActiveLesson && showContentNav ? (
                  <ol class="course-preview__sidebar-sections">
                    {contentNavEntries.map((entry) => {
                      const isActiveItem = entry.itemSlug === currentItemSlug;
                      return (
                        <li class="course-preview__sidebar-section">
                          <a
                            class:list={[
                              "course-preview__sidebar-section-link",
                              isActiveItem &&
                                "course-preview__sidebar-section-link--active",
                            ]}
                            href={legacyLessonItemHref(
                              publicCourseSlug,
                              lessonItem.slug,
                              entry.itemSlug,
                            )}
                            aria-current={isActiveItem ? "page" : undefined}
                          >
                            {entry.title}
                          </a>
                        </li>
                      );
                    })}
                  </ol>
                ) : null
              }
            </li>
          );
        })
      }
    </ol>
  </nav>
</aside>

<script>
  document.querySelectorAll("[data-lk150-course-select]").forEach((select) => {
    select.addEventListener("change", (event) => {
      const target = event.currentTarget;
      if (!(target instanceof HTMLSelectElement)) return;
      const url = target.value;
      if (url) window.location.href = url;
    });
  });
</script>
