---
import VimeoEmbed from "../media/VimeoEmbed.astro";
import LegacyCourseImageCarousel from "../courses/legacy/LegacyCourseImageCarousel.astro";
import LegacyCourseImage from "../courses/legacy/LegacyCourseImage.astro";
import LegacyCourseAccordionLayout from "../courses/legacy/LegacyCourseAccordionLayout.astro";
import LegacyCourseTextVideoLayout from "../courses/legacy/LegacyCourseTextVideoLayout.astro";
import LegacyCourseTextImageLayout from "../courses/legacy/LegacyCourseTextImageLayout.astro";
import LegacyCourseThreeVideosLayout from "../courses/legacy/LegacyCourseThreeVideosLayout.astro";
import type { CourseLesson } from "../../lib/legacy_kin/coursePreviewPoc";
import {
  downloadUrl,
  legacyAssetUrl,
  rewriteLegacyHtml,
  sortedBlocks,
  sortedComponents,
} from "../../lib/legacy_kin/coursePreviewPoc";
import { isAccordionLayoutBlock } from "../../lib/legacy_kin/courseAccordionLayout";
import { isTextVideoLayoutBlock } from "../../lib/legacy_kin/courseTextVideoLayout";
import { isTextImageLayoutBlock } from "../../lib/legacy_kin/courseTextImageLayout";
import { isThreeVideosLayoutBlock } from "../../lib/legacy_kin/courseThreeVideosLayout";

interface Props {
  lesson: CourseLesson;
}

const { lesson } = Astro.props;
---

<section class="course-preview__lesson" id={`lesson-${lesson.slug}`}>
  <h2 class="course-preview__lesson-title">
    <span class="course-preview__lesson-order">{lesson.displayOrder}.</span>
    {lesson.title}
  </h2>
  <p class="course-preview__lesson-meta">legacy item {lesson.legacy.itemId}</p>

  {
    sortedBlocks(lesson).map((block) => (
      <article class="course-preview__block" id={`${lesson.slug}--${block.slug}`}>
        <h3 class="course-preview__block-title">{block.title}</h3>
        <p class="course-preview__block-meta">
          block {block.order} · legacy assign {block.legacy.assignId} · {block.legacy.blockType}
        </p>

        <div class="course-preview__components">
          {isTextVideoLayoutBlock(block) ? (
            <LegacyCourseTextVideoLayout block={block} />
          ) : isThreeVideosLayoutBlock(block) ? (
            <LegacyCourseThreeVideosLayout block={block} />
          ) : isTextImageLayoutBlock(block) ? (
            <LegacyCourseTextImageLayout block={block} />
          ) : isAccordionLayoutBlock(block) ? (
            <LegacyCourseAccordionLayout block={block} />
          ) : (
            sortedComponents(block).map((component) => {
            if (component.type === "richText") {
              return (
                <div
                  class="course-preview__richtext"
                  set:html={rewriteLegacyHtml(component.html)}
                  data-legacy-component={component.legacyComponentId}
                />
              );
            }

            if (component.type === "video") {
              return (
                <figure class="course-preview__video" data-legacy-component={component.legacyComponentId}>
                  {component.title ? (
                    <figcaption class="course-preview__video-title">{component.title}</figcaption>
                  ) : null}
                  <VimeoEmbed
                    vimeoId={component.vimeoId}
                    title={component.title ?? "Course video"}
                  />
                </figure>
              );
            }

            if (component.type === "download") {
              const href = downloadUrl(component.filename);
              return (
                <p class="course-preview__download" data-legacy-component={component.legacyComponentId}>
                  <a href={href} target="_blank" rel="noopener noreferrer">
                    {component.label}
                  </a>
                  <span class="course-preview__download-file"> ({component.filename})</span>
                  {component.showInline ? (
                    <span class="course-preview__download-note"> — legacy inline viewer</span>
                  ) : null}
                </p>
              );
            }

            if (component.type === "imageGallery") {
              return (
                <LegacyCourseImageCarousel
                  legacyComponentId={component.legacyComponentId}
                  introHtml={component.introHtml}
                  title={component.title}
                  slides={component.slides.map((slide) => ({
                    src: slide.src,
                    alt: slide.caption ?? "",
                    caption: slide.caption ?? null,
                    linkUrl: slide.linkUrl,
                  }))}
                />
              );
            }

            if (component.type === "image") {
              return <LegacyCourseImage component={component} />;
            }

            if (component.type === "imageCarousel") {
              return (
                <LegacyCourseImageCarousel
                  legacyComponentId={component.legacyComponentId}
                  title={component.title}
                  slides={component.slides}
                />
              );
            }

            if (component.type === "exerciseAccordion") {
              return (
                <div class="course-preview__exercise" data-legacy-component={component.legacyComponentId}>
                  {component.sections.map((section) => (
                    <details class="course-preview__exercise-section">
                      <summary set:html={section.title} />
                      {section.iconSrc ? (
                        <img
                          class="course-preview__exercise-icon"
                          src={legacyAssetUrl(section.iconSrc)}
                          alt=""
                          loading="lazy"
                        />
                      ) : null}
                      {section.bodyHtml ? (
                        <div
                          class="course-preview__richtext"
                          set:html={rewriteLegacyHtml(section.bodyHtml)}
                        />
                      ) : null}
                    </details>
                  ))}
                </div>
              );
            }

            if (component.type === "migrationPending") {
              return (
                <aside
                  class="course-preview__migration"
                  role="alert"
                  data-legacy-component={component.legacyComponentId}
                >
                  <p class="course-preview__migration-heading">
                    Migration pending: <code>{component.legacyType}</code>
                  </p>
                  <ul class="course-preview__migration-notes">
                    {component.notes.map((note) => (
                      <li>{note}</li>
                    ))}
                  </ul>
                </aside>
              );
            }

            return null;
          })
          )}
        </div>
      </article>
    ))
  }
</section>
