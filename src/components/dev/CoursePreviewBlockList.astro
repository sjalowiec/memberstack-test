---
import VimeoEmbed from "../media/VimeoEmbed.astro";
import type { CourseBlock } from "../../lib/legacy_kin/coursePreviewPoc";
import {
  downloadUrl,
  legacyAssetUrl,
  rewriteLegacyHtml,
  sortedComponents,
} from "../../lib/legacy_kin/coursePreviewPoc";

interface Props {
  blocks: CourseBlock[];
  lessonSlug: string;
  compact?: boolean;
}

const { blocks, lessonSlug, compact = false } = Astro.props;
---

{
  blocks.map((block) => (
    <article
      class:list={[
        "course-preview__block",
        compact && "course-preview__block--compact",
      ]}
      id={`${lessonSlug}--${block.slug}`}
    >
      {!compact ? (
        <h3 class="course-preview__block-title">{block.title}</h3>
      ) : null}

      <div class="course-preview__components">
        {sortedComponents(block).map((component) => {
          if (component.type === "richText") {
            return (
              <div
                class="course-preview__richtext"
                set:html={rewriteLegacyHtml(component.html)}
                data-legacy-component={component.legacyComponentId}
              />
            );
          }

          if (component.type === "video") {
            return (
              <figure class="course-preview__video" data-legacy-component={component.legacyComponentId}>
                {component.title ? (
                  <figcaption class="course-preview__video-title">{component.title}</figcaption>
                ) : null}
                <VimeoEmbed
                  vimeoId={component.vimeoId}
                  title={component.title ?? "Course video"}
                />
              </figure>
            );
          }

          if (component.type === "download") {
            const href = downloadUrl(component.filename);
            return (
              <p class="course-preview__download" data-legacy-component={component.legacyComponentId}>
                <a href={href} target="_blank" rel="noopener noreferrer">
                  {component.label}
                </a>
                <span class="course-preview__download-file"> ({component.filename})</span>
              </p>
            );
          }

          if (component.type === "imageGallery") {
            return (
              <div class="course-preview__gallery" data-legacy-component={component.legacyComponentId}>
                {component.slides.map((slide) => (
                  <figure class="course-preview__gallery-slide">
                    <img
                      src={legacyAssetUrl(slide.src)}
                      alt={slide.caption ?? ""}
                      loading="lazy"
                    />
                    {slide.caption ? <figcaption>{slide.caption}</figcaption> : null}
                  </figure>
                ))}
              </div>
            );
          }

          if (component.type === "exerciseAccordion") {
            return (
              <div class="course-preview__exercise" data-legacy-component={component.legacyComponentId}>
                {component.sections.map((section) => (
                  <details class="course-preview__exercise-section">
                    <summary set:html={section.title} />
                    {section.iconSrc ? (
                      <img
                        class="course-preview__exercise-icon"
                        src={legacyAssetUrl(section.iconSrc)}
                        alt=""
                        loading="lazy"
                      />
                    ) : null}
                    {section.bodyHtml ? (
                      <div
                        class="course-preview__richtext"
                        set:html={rewriteLegacyHtml(section.bodyHtml)}
                      />
                    ) : null}
                  </details>
                ))}
              </div>
            );
          }

          if (component.type === "migrationPending") {
            return (
              <aside
                class="course-preview__migration"
                role="alert"
                data-legacy-component={component.legacyComponentId}
              >
                <p class="course-preview__migration-heading">
                  Migration pending: <code>{component.legacyType}</code>
                </p>
                <ul class="course-preview__migration-notes">
                  {component.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
              </aside>
            );
          }

          return null;
        })}
      </div>
    </article>
  ))
}
