---
import LegacyCourseRenderer from "../courses/legacy/LegacyCourseRenderer.astro";
import type { CourseBlock } from "../../lib/legacy_kin/coursePreviewPoc";

interface Props {
  blocks: CourseBlock[];
  lessonSlug: string;
  compact?: boolean;
}

const { blocks, lessonSlug, compact = false } = Astro.props;
---

<LegacyCourseRenderer
  blocks={blocks}
  {lessonSlug}
  showBlockTitles={!compact}
/>
