---
interface Props {
  title?: string;
  breadcrumb?: string;
  meta?: string;
  subhead?: string;
  hideTitle?: boolean;
}

const { title, breadcrumb, meta, subhead, hideTitle = false } = Astro.props;
const isEmpty = hideTitle && !subhead && !meta && !breadcrumb;
const hasAfterTitle = await Astro.slots.has("after-title");
---

<header class:list={["page-head", isEmpty && "page-head--empty"]}>


  {title && !hideTitle && (
    <h1 class:list={["page-title", hasAfterTitle && "page-title--with-aside"]}>
      {hasAfterTitle ? <span class="page-title__text">{title}</span> : title}
      <slot name="after-title" />
    </h1>
  )}

  {subhead && (
    <p class="page-subhead">{subhead}</p>
  )}

  {meta && (
    <p class="meta">{meta}</p>
  )}
</header>

<style>
  .page-head {
    margin-bottom: 2rem;
  }

  .page-head--empty {
    margin-bottom: 0;
  }

  .page-title {
    margin: 0 0 0.75rem 0;
    font-size: var(--text-xxl);
    line-height: 1.2;
  }

  .page-title__text {
    min-width: 0;
  }

  .page-subhead {
    margin: 0 0 1rem 0;
    font-size: var(--text-lg);
    opacity: 0.85;
  }


</style>