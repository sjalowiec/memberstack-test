---
---
<!-- Contact Modal -->
<div
  id="contact-modal"
  class="contact-modal"
  aria-hidden="true"
  role="dialog"
  aria-labelledby="contact-modal-title"
>
  <div class="contact-modal-overlay" id="contact-modal-overlay"></div>
  <div class="contact-modal-container">
    <button
      class="contact-modal-close"
      id="contact-modal-close"
      aria-label="Close contact form"
    >
      <span aria-hidden="true">&times;</span>
    </button>

    <div class="contact-modal-header">
      <div class="contact-modal-title-wrapper">
        <div class="contact-modal-title">
          <img src="/images/KINlogo.svg" alt="Knit it Now" class="contact-modal-logo">
          <h2 id="contact-modal-title">Contact Sue</h2>
        </div>
        <div class="contact-modal-divider"></div>
      </div>
      <p class="contact-modal-subheader">
        Questions or feedback? Send a message below.
      </p>
    </div>

    <form
    id="contactFormModal"
    name="contact"
    method="POST"
    action="/.netlify/functions/contact"
    enctype="multipart/form-data"
    netlify-honeypot="bot-field"
    class="contact-form"
  >
      <input type="hidden" name="form-name" value="contact" />
      <p style="display:none;">
        <label>Don't fill this out: <input name="bot-field" /></label>
      </p>
      <input type="hidden" name="submission-type" value="contact" />
      <input type="hidden" name="page_url" id="contactPageURLModal" />
      <input type="hidden" name="submitted_at" id="contactSubmittedAtModal" />
      <input type="hidden" name="form_source" id="contactFormSourceModal" value="unknown" />

      <label class="contact-form__field">
        <span>Name *</span>
        <input type="text" name="name" required />
      </label>

      <label class="contact-form__field">
        <span>Email *</span>
        <input type="email" name="email" required />
      </label>

      <div class="contact-modal-tip">
        Tip: If you're troubleshooting, include your machine model, yarn type, and what the machine is doing.
      </div>

      <label class="contact-form__field">
       
        <textarea 
        name="message" 
        rows="6" 
        placeholder="Enter your message here. Example: I'm using a Brother KH260 and my carriage jams when knitting tuck stitch. I’ve already changed the sponge bar."
        required
      ></textarea>
      </label>

      <div class="contact-form__field">
        <span>Add a photo of your knitting or machine (optional)</span>
        <p class="contact-form__hint">A photo can help us see what’s happening.</p>
        <input
          type="file"
          name="images"
          id="contactImagesModal"
          accept="image/jpeg,image/png,image/webp"
          class="contact-form__file"
        />
        <p class="contact-form__note">JPG, PNG, or WEBP • max 5MB</p>
        <p id="contact-image-error-modal" class="contact-form__error" hidden role="alert"></p>
        <p id="contact-submit-error-modal" class="contact-form__error" hidden role="alert"></p>
      </div>

      <div class="contact-form__submit-wrap">
        <button type="submit" class="contact-form__submit kbm-btn kbm-btn-primary">
          Send message
        </button>
        <span class="contact-form__submit-note">😊 I usually respond within 1–2 business days.</span>
      </div>
    </form>
    </div>

    <div class="contact-modal-success-wrapper">
    <div id="contactSuccessModal" class="contact-success hidden">
      <h2>Thank you - your message has been sent.</h2>
      <p>
        We'll read it soon and reply if needed. 
        While you wait:
👉 Get the checklist: It’s Not You, It Might Be the Machine
(Link to /troubleshoot)
      </p>
    </div>
    </div>
  </div>
</div>

<style is:global>
 .contact-modal-leadmag {
  background: #f5f7f2;
  border-left: 4px solid #6a8141;
  padding: 14px 16px;
  border-radius: 10px;
}

.contact-modal-leadmag-intro {
  font-size: 0.9rem;
  margin-bottom: 6px;
}

.contact-modal-leadmag-title {
  font-weight: 700;
  font-size: 1.05rem;
  color: #2e3c20;
  text-align: center;
  margin: 4px 0 6px 0;
}

.contact-modal-leadmaghelp {
  font-size: 0.9rem;
  color: #555;
  text-align: center;
  margin-bottom: 8px;
}

.contact-modal-leadmaglink {
  display: block;
  text-align: center;
  font-weight: 600;
  text-decoration: none;
}

.contact-modal-leadmaglink i {
  font-size: 0.85em;
  margin-left: 4px;
}
  .external-link-icon {
  font-size: 0.85em;
  margin-left: 4px;
  opacity: 0.7;
}
#contact-modal textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 140px;
  padding: 12px 14px;
  line-height: 1.5;
  resize: vertical;
  border-radius: 8px;
}

#contact-modal textarea:focus {
  outline: none;
  border-color: #6a8141;
  box-shadow: 0 0 0 2px rgba(106,129,65,0.15);
}
#contact-modal .contact-modal-container {
  position: relative;
  max-width: 520px;
  width: calc(100% - 32px);
  max-height: 90vh;
  overflow-y: auto;
  margin: 60px auto;
  padding: 26px 28px;
  border-radius: 14px;
  box-shadow: 0 18px 45px rgba(0,0,0,0.18);
  transform: translateY(8px);
  transition: transform 0.18s ease;
}

.contact-modal--open .contact-modal-container {
  transform: translateY(0);
}

#contact-modal-overlay {
  backdrop-filter: blur(2px);
  background: rgba(0,0,0,0.35);
}

  #contact-modal textarea::placeholder {
  font-style: italic;
  font-size: 0.9rem;
  color: #b5b5b5;
}


  #contact-modal .contact-modal-subheader {
    margin: 6px 0 14px 0;
    font-size: 0.95rem;
    line-height: 1.45;
    max-width: 42ch;
    opacity: 0.9;
  }

  #contact-modal .contact-modal-tip {
    background: #f5f7f2;
    border-left: 4px solid #6a8141;
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 0.9rem;
    margin-bottom: 10px;
  }

  #contact-modal .contact-modal-leadmag {
    background: #f7f7f7;
    border-radius: 12px;
    padding: 10px 12px;
    margin-top: 6px;
  }

  #contact-modal .contact-modal-checkbox {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    cursor: pointer;
  }

  #contact-modal .contact-modal-checkbox input {
    margin-top: 3px;
  }

  #contact-modal .contact-modal-leadmaglink {
    margin-left: 6px;
    font-weight: 600;
    text-decoration: underline;
  }

  #contact-modal .contact-modal-leadmaghelp {
    font-size: 0.85rem;
    margin-top: 5px;
    opacity: 0.85;
  }

  #contact-modal .contact-modal-response {
    font-size: 0.85rem;
    margin-top: 6px;
    opacity: 0.8;
  }

  #contact-modal .contact-modal-header {
    margin-bottom: 12px;
  }

  .contact-modal-title-wrapper {
    text-align: center;
    margin-bottom: 20px;
  }

  .contact-modal-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .contact-modal-title h2 {
    font-size: 1.5rem;
    color: var(--kbm-green);
    margin: 0;
    font-weight: 600;
  }

  .contact-modal-logo {
    width: 34px;
    height: auto;
  }

  .contact-modal-divider {
    width: 60px;
    height: 2px;
    background: #e5e5e5;
    margin: 12px auto 0;
  }

  #contact-modal .contact-modal-body {
    margin-top: 6px;
  }

  #contact-modal .contact-modal-success-wrapper {
    margin-top: 12px;
  }

  /* --- CONTACT MODAL LAYOUT SAFETY (center + visible) --- */
  #contact-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
  }

  #contact-modal.contact-modal--open {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #contact-modal-overlay,
  #contact-modal .contact-modal-overlay {
    position: absolute;
    inset: 0;
  }

  #contact-modal .contact-modal-container {
  position: relative;
  max-width: 520px;
  width: calc(100% - 32px);
  margin: auto;
  background: white;
}
#contact-modal.contact-modal--open {
  display: flex;
  align-items: center;
  justify-content: center;
}
  /* Make sure the form + submit are not accidentally hidden */
  #contact-modal #contactFormModal {
    display: block;
  }

  #contact-modal .contact-form__field {
    margin-bottom: 1.25rem;
  }

  #contact-modal .contact-form__submit-wrap {
    margin-top: 1.5rem;
    padding-top: 0.5rem;
  }

  #contact-modal .contact-form__submit {
    display: block;
    width: 100%;
    visibility: visible;
    opacity: 1;
    position: relative;
    padding: 0.85rem 1.5rem;
    cursor: pointer;
    background-color: #6a8141;
    color: #fff;
    font-weight: 600;
    font-size: 1rem;
    border: none;
    border-radius: 8px;
  }

  /* Contact modal: primary CTA uses clay style */
  #contact-modal .contact-form__submit.kbm-btn-primary {
    background-color: #B36D61;
    border: 1px solid #B36D61;
    color: #ffffff;
  }
  #contact-modal .contact-form__submit.kbm-btn-primary:hover {
    background-color: #9e5e54;
    border-color: #9e5e54;
    color: #ffffff;
  }

  #contact-modal .contact-form__submit-note {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }

  #contact-modal .contact-form__hint {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: #4b5563;
    line-height: 1.45;
  }

  #contact-modal .contact-form__note {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    color: #6b7280;
  }

  #contact-modal .contact-form__file {
    padding: 0.25rem 0;
    font-size: 0.9rem;
    font-family: var(--font);
    max-width: 100%;
  }

  #contact-modal .contact-form__error {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: #b91c1c;
  }

  #contact-modal .contact-form__error[hidden] {
    display: none;
  }
</style>

<script is:inline>
  (function() {
    const ALLOWED_IMAGE_TYPES = ['image/jpeg', 'image/png', 'image/webp'];
    const MAX_IMAGE_BYTES = 5 * 1024 * 1024;

    function validateContactImage(file) {
      if (!file || file.size === 0) {
        return { ok: true };
      }
      if (!ALLOWED_IMAGE_TYPES.includes(file.type)) {
        return {
          ok: false,
          message: 'Please choose a JPG, PNG, or WEBP image.',
        };
      }
      if (file.size > MAX_IMAGE_BYTES) {
        return {
          ok: false,
          message: 'Please choose an image smaller than 5MB.',
        };
      }
      return { ok: true };
    }

    const modal = document.getElementById('contact-modal');
    const overlay = document.getElementById('contact-modal-overlay');
    const closeBtn = document.getElementById('contact-modal-close');
    const form = document.getElementById('contactFormModal');
    const successMsg = document.getElementById('contactSuccessModal');
    const pageUrlInput = document.getElementById('contactPageURLModal');
    const submittedAtInput = document.getElementById('contactSubmittedAtModal');
    const formSourceInput = document.getElementById('contactFormSourceModal');
    const fileInput = document.getElementById('contactImagesModal');
    const imageErrorEl = document.getElementById('contact-image-error-modal');
    const submitErrorEl = document.getElementById('contact-submit-error-modal');
    const submitBtn = form && form.querySelector('button[type="submit"]');

    const triggers = document.querySelectorAll('#contact-modal-trigger, .contact-modal-trigger');

    function showImageError(message) {
      if (!imageErrorEl) return;
      imageErrorEl.textContent = message;
      imageErrorEl.hidden = false;
      if (submitErrorEl) submitErrorEl.hidden = true;
    }

    function clearImageError() {
      if (!imageErrorEl) return;
      imageErrorEl.textContent = '';
      imageErrorEl.hidden = true;
    }

    function showSubmitError(message) {
      if (!submitErrorEl) return;
      submitErrorEl.textContent = message;
      submitErrorEl.hidden = false;
    }

    function clearSubmitError() {
      if (!submitErrorEl) return;
      submitErrorEl.textContent = '';
      submitErrorEl.hidden = true;
    }

    function openModal(source) {
      source = source || 'unknown';
      if (pageUrlInput) pageUrlInput.value = window.location.href;
      if (submittedAtInput) submittedAtInput.value = new Date().toISOString();
      if (formSourceInput) formSourceInput.value = source;
      clearImageError();
      clearSubmitError();

      modal?.setAttribute('aria-hidden', 'false');
      modal?.classList.add('contact-modal--open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal?.setAttribute('aria-hidden', 'true');
      modal?.classList.remove('contact-modal--open');
      document.body.style.overflow = '';
      form?.reset();
      clearImageError();
      clearSubmitError();
    }

    if (modal && overlay && closeBtn && form) {
      triggers.forEach(function(trigger) {
        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          const source = trigger.getAttribute('data-contact-source') || 'unknown';
          openModal(source);
        });
      });

      overlay.addEventListener('click', closeModal);
      closeBtn.addEventListener('click', closeModal);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
          closeModal();
        }
      });

      if (fileInput instanceof HTMLInputElement) {
        fileInput.addEventListener('change', function() {
          const file = fileInput.files && fileInput.files[0];
          if (!file) {
            clearImageError();
            return;
          }
          const result = validateContactImage(file);
          if (!result.ok) {
            showImageError(result.message);
          } else {
            clearImageError();
          }
        });
      }

      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        e.stopImmediatePropagation();
        clearSubmitError();

        const file =
          fileInput instanceof HTMLInputElement && fileInput.files
            ? fileInput.files[0]
            : undefined;
        const imageResult = validateContactImage(file);
        if (!imageResult.ok) {
          showImageError(imageResult.message);
          if (fileInput instanceof HTMLInputElement) {
            fileInput.focus();
          }
          return;
        }
        clearImageError();

        if (pageUrlInput) {
          pageUrlInput.value = window.location.href;
        }
        if (submittedAtInput) {
          const now = new Date();

          const date = now.toLocaleDateString('en-US');
          const time = now.toLocaleTimeString('en-US', {
            hour: 'numeric',
            minute: '2-digit',
            hour12: true
          });

          submittedAtInput.value = date + ' – ' + time;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
        }

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
          });

          if (res.status >= 200 && res.status < 300) {
            window.location.href = '/contact/thanks/';
            return;
          }

          const serverMessage = (await res.text()).trim();
          const fallback =
            'Something went wrong sending your message. Please try again in a moment.';

          if (res.status === 400) {
            showSubmitError(serverMessage || fallback);
            return;
          }

          showSubmitError(serverMessage || fallback);
        } catch (err) {
          showSubmitError('Something went wrong sending your message. Please try again in a moment.');
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
          }
        }
      }, true);
    }
  })();
</script>