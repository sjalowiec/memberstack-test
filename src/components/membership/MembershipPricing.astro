---
import { MEMBERSHIPS } from "../../config/memberships";

interface Props {
  showStatus?: boolean;
  showFooter?: boolean;
}

const { showStatus = true, showFooter = true } = Astro.props;

const basicMonthlyPrice = MEMBERSHIPS.basic.prices.monthly.price;
const basicAnnualPrice = MEMBERSHIPS.basic.prices.annual.price;
const premiumMonthlyPrice = MEMBERSHIPS.premium.prices.monthly.price;
const premiumAnnualPrice = MEMBERSHIPS.premium.prices.annual.price;
---

<div class="membership-pricing">
  {
    showStatus ? (
      <div
        id="join-checkout-status"
        class="join-checkout-status join-checkout-status--info"
        role="status"
        aria-live="polite"
        hidden
      />
    ) : null
  }

  <div class="join-plans">
    <article class="join-plan">
      <h3 class="join-plan__title">Basic Membership</h3>
      <p class="join-plan__summary">
        Knit It Now member benefits: videos, patterns, tools, reference resources, glossary, and member
        features.
      </p>
      <div class="join-plan__options">
        <div class="join-plan__option">
          <p class="join-plan__price">
            ${basicMonthlyPrice}<span class="join-plan__period">/month</span>
          </p>
          <button
            type="button"
            class="kbm-btn kbm-btn-primary join-plan__cta"
            data-join-checkout="basicMonthly"
          >
            Join Basic - Monthly
          </button>
        </div>
        <div class="join-plan__option">
          <p class="join-plan__price">
            ${basicAnnualPrice}<span class="join-plan__period">/year</span>
          </p>
          <button
            type="button"
            class="kbm-btn kbm-btn-outline join-plan__cta"
            data-join-checkout="basicAnnual"
          >
            Join Basic - Annual
          </button>
        </div>
      </div>
    </article>

    <article class="join-plan join-plan--premium">
      <h3 class="join-plan__title">Premium Membership</h3>
      <p class="join-plan__summary">Everything in Basic, plus all Knit It Now courses.</p>
      <div class="join-plan__options">
        <div class="join-plan__option">
          <p class="join-plan__price">
            ${premiumMonthlyPrice}<span class="join-plan__period">/month</span>
          </p>
          <button
            type="button"
            class="kbm-btn kbm-btn-primary join-plan__cta"
            data-join-checkout="premiumMonthly"
          >
            Join Premium - Monthly
          </button>
        </div>
        <div class="join-plan__option">
          <p class="join-plan__price">
            ${premiumAnnualPrice}<span class="join-plan__period">/year</span>
          </p>
          <button
            type="button"
            class="kbm-btn kbm-btn-outline join-plan__cta"
            data-join-checkout="premiumAnnual"
          >
            Join Premium - Annual
          </button>
        </div>
      </div>
    </article>
  </div>

  {
    showFooter ? (
      <p class="join-footer">
        Already a member?
        <a href="#" data-ms-modal="login" data-ms-redirect="current-url">Log in</a>,
        visit <a href="/account">your workspace</a>,
        or <a href="#" data-join-billing-portal>manage billing</a>.
      </p>
    ) : null
  }
</div>

<style>
  .membership-pricing {
    margin: 0;
  }

  .join-checkout-status {
    margin: 0 0 1.25rem 0;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    font-size: var(--text-base, 1rem);
    line-height: 1.5;
  }

  .join-checkout-status[hidden] {
    display: none;
  }

  .join-checkout-status--info {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e3a8a;
  }

  .join-checkout-status--success {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
  }

  .join-checkout-status--error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .join-plan__cta:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .join-plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .join-plan {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fafafa;
  }

  .join-plan--premium {
    border-color: rgba(82, 104, 45, 0.35);
    background: #f8faf6;
  }

  .join-plan__title {
    margin: 0;
    font-size: var(--text-xl, 1.25rem);
    line-height: 1.3;
  }

  .join-plan__summary {
    margin: 0;
    font-size: var(--text-base, 1rem);
    line-height: 1.5;
    color: #374151;
    flex: 1;
  }

  .join-plan__options {
    display: grid;
    gap: 0.85rem;
  }

  .join-plan__option {
    padding-top: 0.85rem;
    border-top: 1px solid #e5e7eb;
  }

  .join-plan__price {
    margin: 0 0 0.65rem 0;
    font-size: var(--text-lg, 1.125rem);
    font-weight: 600;
    color: #111827;
  }

  .join-plan__period {
    font-size: var(--text-base, 1rem);
    font-weight: 500;
    color: #6b7280;
  }

  .join-plan__cta {
    display: inline-block;
    width: 100%;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
  }

  .join-footer {
    margin: 0;
    font-size: var(--text-base, 1rem);
    color: #6b7280;
  }

  .join-footer a {
    color: var(--kbm-green, #166534);
    text-decoration: underline;
  }
</style>
