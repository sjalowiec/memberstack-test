---
import { MEMBERSHIP_PRICE_IDS, MEMBERSHIPS } from "../../config/memberships";

interface Props {
  showStatus?: boolean;
  showFooter?: boolean;
  variant?: "full" | "compact";
  /** Render the shared billing-period radios (only once per page). */
  billingRadioHost?: boolean;
}

const {
  showStatus = true,
  showFooter = true,
  variant = "full",
  billingRadioHost = true,
} = Astro.props;

const monthlyPrice = MEMBERSHIPS.membership.prices.monthly.price;
const annualPrice = MEMBERSHIPS.membership.prices.annual.price;
const annualSavings = Math.round(monthlyPrice * 12 - annualPrice);

const membershipFeatures = [
  "Instructional videos and Help Hub",
  "Tools, calculators, and Skill Builders",
  "Stitch downloads and reference resources",
  "Community and member features",
  "Unlimited access to every Pattern Builder, including Sleeveless, Drop Shoulder, Raglan, Cardigans, Set-In Sleeves, and future releases",
  "All Knit It Now courses",
];

const compactSummary =
  "Lessons, tools, member resources, every pattern builder, and all courses.";
---

<div class="membership-pricing" data-variant={variant}>
  {
    billingRadioHost ? (
      <>
        <input
          type="radio"
          name="membership-billing-period"
          id="membership-billing-monthly"
          value="monthly"
          class="membership-billing-radio"
          checked
        />
        <input
          type="radio"
          name="membership-billing-period"
          id="membership-billing-annual"
          value="annual"
          class="membership-billing-radio"
        />
      </>
    ) : null
  }

  {
    showStatus ? (
      <div
        id="join-checkout-status"
        class="join-checkout-status join-checkout-status--info"
        role="status"
        aria-live="polite"
        hidden
      />
    ) : null
  }

  <div class="membership-billing-toggle-wrap">
    <div class="membership-billing-toggle" role="radiogroup" aria-label="Billing period">
      <label for="membership-billing-monthly" class="membership-billing-toggle__option">
        Monthly
      </label>
      <label for="membership-billing-annual" class="membership-billing-toggle__option">
        Annual
      </label>
    </div>
  </div>

  {
    variant === "full" ? (
      <div
        class="membership-active-confirmation"
        data-membership-active-confirmation
        role="status"
        hidden
      >
        <p class="membership-active-confirmation__title">
          Your Knit it Now membership is active.
        </p>
        <p class="membership-active-confirmation__thanks">
          Thank you for being part of the community.
        </p>
      </div>
    ) : null
  }

  <div class="join-plans">
    <article class="join-plan join-plan--featured">
      <h3 class="join-plan__title">Knit it Now Membership</h3>
      {
        variant === "full" ? (
          <>
            <p class="join-plan__tagline">Full access for active makers.</p>
            <p class="join-plan__summary">
              Access Knit It Now lessons, tools, reference resources, member features, every pattern
              builder, and every Knit It Now course.
            </p>
            <ul class="join-plan__features">
              {membershipFeatures.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </>
        ) : (
          <p class="join-plan__summary">{compactSummary}</p>
        )
      }
      <div class="join-plan__checkout">
        <div class="join-plan__billing join-plan__billing--monthly">
          <p class="join-plan__price">
            ${monthlyPrice}<span class="join-plan__period">/month</span>
          </p>
          <button
            type="button"
            class="kbm-btn kbm-btn-primary join-plan__cta"
            data-join-checkout="monthly"
            data-membership-price-id={MEMBERSHIP_PRICE_IDS.monthly}
          >
            Become a Member
          </button>
        </div>
        <div class="join-plan__billing join-plan__billing--annual">
          <p class="join-plan__price">
            ${annualPrice}<span class="join-plan__period">/year</span>
          </p>
          <p class="join-plan__savings">Save ${annualSavings}/year</p>
          <button
            type="button"
            class="kbm-btn kbm-btn-primary join-plan__cta"
            data-join-checkout="annual"
            data-membership-price-id={MEMBERSHIP_PRICE_IDS.annual}
          >
            Become a Member
          </button>
        </div>
      </div>
    </article>
  </div>

  {
    showFooter ? (
      <p class="join-footer">
        Returning or canceled members: <a href="#" data-ms-modal="login" data-ms-redirect="current-url">log in with your existing account</a>
        before joining again — do not create a second account.
        New here? Choose monthly or annual above, then create your account at checkout.
        Already subscribed?
        Visit <a href="/account">your workspace</a>
        or <a href="#" data-join-billing-portal>manage billing</a>.
      </p>
    ) : null
  }
</div>

<style>
  .membership-pricing {
    margin: 0;
  }

  .membership-billing-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .membership-billing-toggle-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .membership-billing-toggle {
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.25rem;
    border: 1px solid #d6dbc9;
    border-radius: 999px;
    background: #f9f9f6;
  }

  .membership-billing-toggle__option {
    display: inline-block;
    padding: 0.45rem 1.35rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    color: #4d5a48;
    cursor: pointer;
    user-select: none;
    transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }

  .membership-billing-toggle__option:hover {
    color: #2c3a57;
  }

  :global(.membership-billing-scope:has(#membership-billing-monthly:checked))
    .membership-billing-toggle__option[for="membership-billing-monthly"],
  :global(.membership-billing-scope:has(#membership-billing-annual:checked))
    .membership-billing-toggle__option[for="membership-billing-annual"],
  :global(.membership-billing-scope[data-billing-period="monthly"])
    .membership-billing-toggle__option[for="membership-billing-monthly"],
  :global(.membership-billing-scope[data-billing-period="annual"])
    .membership-billing-toggle__option[for="membership-billing-annual"] {
    background: #fff;
    color: #2c3a57;
    box-shadow: 0 1px 3px rgba(82, 104, 45, 0.15);
  }

  .join-plan__billing--annual {
    display: none;
  }

  :global(.membership-billing-scope:has(#membership-billing-annual:checked))
    .join-plan__billing--monthly,
  :global(.membership-billing-scope[data-billing-period="annual"])
    .join-plan__billing--monthly {
    display: none;
  }

  :global(.membership-billing-scope:has(#membership-billing-annual:checked))
    .join-plan__billing--annual,
  :global(.membership-billing-scope[data-billing-period="annual"])
    .join-plan__billing--annual {
    display: block;
  }

  .join-checkout-status {
    margin: 0 0 1.25rem 0;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    font-size: var(--text-base, 1rem);
    line-height: 1.5;
  }

  .join-checkout-status[hidden] {
    display: none;
  }

  .join-checkout-status--info {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e3a8a;
  }

  .join-checkout-status--success {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
  }

  .join-checkout-status--error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .join-checkout-status__message {
    margin: 0 0 0.75rem;
  }

  .join-checkout-status__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .membership-active-confirmation {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    text-align: center;
    border-radius: 0.75rem;
    background: rgba(82, 104, 45, 0.08);
    border: 1px solid rgba(82, 104, 45, 0.2);
  }

  .membership-active-confirmation[hidden] {
    display: none;
  }

  .membership-active-confirmation__title,
  .membership-active-confirmation__thanks {
    margin: 0;
    color: #4d5a48;
    line-height: 1.45;
  }

  .membership-active-confirmation__title {
    font-size: 0.98rem;
    font-weight: 600;
  }

  .membership-active-confirmation__thanks {
    margin-top: 0.25rem;
    font-size: 0.92rem;
  }

  .join-plan__cta:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .join-plans {
    display: grid;
    grid-template-columns: minmax(0, 28rem);
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .join-plan {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fafafa;
  }

  .join-plan--featured {
    border-color: rgba(82, 104, 45, 0.35);
    background: #f8faf6;
  }

  .join-plan__title {
    margin: 0;
    font-size: var(--text-xl, 1.25rem);
    line-height: 1.3;
  }

  .join-plan__tagline {
    margin: 0;
    font-size: var(--text-base, 1rem);
    font-weight: 600;
    line-height: 1.4;
    color: #2c3a57;
  }

  .join-plan__summary {
    margin: 0;
    font-size: var(--text-base, 1rem);
    line-height: 1.5;
    color: #374151;
    flex: 1;
  }

  .join-plan__features {
    margin: 0;
    padding-left: 1.15rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #4d5a48;
  }

  .join-plan__features li {
    margin-bottom: 0.35rem;
  }

  .join-plan__features li:last-child {
    margin-bottom: 0;
  }

  .membership-pricing[data-variant="compact"] .join-plan {
    gap: 0.65rem;
  }

  .membership-pricing[data-variant="compact"] .join-plans {
    margin-bottom: 0;
  }

  .join-plan__checkout {
    padding-top: 0.85rem;
    border-top: 1px solid #e5e7eb;
    margin-top: auto;
  }

  .join-plan__price {
    margin: 0 0 0.35rem 0;
    font-size: var(--text-lg, 1.125rem);
    font-weight: 600;
    color: #111827;
  }

  .join-plan__savings {
    margin: 0 0 0.65rem 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: #4d5a48;
  }

  .join-plan__period {
    font-size: var(--text-base, 1rem);
    font-weight: 500;
    color: #6b7280;
  }

  .join-plan__cta {
    display: inline-block;
    width: 100%;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
  }

  .join-plan__cta:disabled,
  .join-plan__cta[aria-disabled="true"] {
    cursor: default;
    opacity: 0.72;
  }

  .join-footer {
    margin: 0;
    font-size: var(--text-base, 1rem);
    color: #6b7280;
  }

  .join-footer a {
    color: var(--kbm-green, #166534);
    text-decoration: underline;
  }
</style>
