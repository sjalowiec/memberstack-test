---
import { MEMBERSHIP_PRICE_IDS, MEMBERSHIPS } from "../../config/memberships";

interface Props {
  showStatus?: boolean;
  showFooter?: boolean;
  variant?: "full" | "compact";
  /** Render the shared billing-period radios (only once per page). */
  billingRadioHost?: boolean;
}

const {
  showStatus = true,
  showFooter = true,
  variant = "full",
  billingRadioHost = true,
} = Astro.props;

const basicMonthlyPrice = MEMBERSHIPS.basic.prices.monthly.price;
const basicAnnualPrice = MEMBERSHIPS.basic.prices.annual.price;
const premiumMonthlyPrice = MEMBERSHIPS.premium.prices.monthly.price;
const premiumAnnualPrice = MEMBERSHIPS.premium.prices.annual.price;

/** Hidden data-ms-price:update triggers (bound by Memberstack at page load). */
const priceUpdateTriggers = [
  { planKey: "basicMonthly", priceId: MEMBERSHIP_PRICE_IDS.basicMonthly },
  { planKey: "basicAnnual", priceId: MEMBERSHIP_PRICE_IDS.basicAnnual },
  { planKey: "premiumMonthly", priceId: MEMBERSHIP_PRICE_IDS.premiumMonthly },
  { planKey: "premiumAnnual", priceId: MEMBERSHIP_PRICE_IDS.premiumAnnual },
] as const;

const basicAnnualSavings = Math.round(basicMonthlyPrice * 12 - basicAnnualPrice);
const premiumAnnualSavings = Math.round(premiumMonthlyPrice * 12 - premiumAnnualPrice);

const basicFeatures = [
  "Instructional videos and Help Hub",
  "Tools, calculators, and Skill Builders",
  "Stitch downloads and reference resources",
  "Community and member features",
  "Includes the Sleeveless Sweater Pattern Builder",
];

const premiumFeatures = [
  "Everything in Basic",
  "Unlimited access to every Pattern Builder, including Sleeveless, Drop Shoulder, Raglan, Cardigans, Set-In Sleeves, and future releases",
  "All Knit It Now courses",
];

const basicCompactSummary =
  "Lessons, tools, member resources, and the Sleeveless Sweater Pattern Builder.";

const premiumCompactSummary = "Everything in Basic, plus all pattern builders and all courses.";
---

<div class="membership-pricing" data-variant={variant}>
  {
    billingRadioHost ? (
      <>
        <input
          type="radio"
          name="membership-billing-period"
          id="membership-billing-monthly"
          value="monthly"
          class="membership-billing-radio"
          checked
        />
        <input
          type="radio"
          name="membership-billing-period"
          id="membership-billing-annual"
          value="annual"
          class="membership-billing-radio"
        />
        {/*
          Memberstack binds data-ms-price:update at page load.
          Join checkout programmatically clicks these for Basic↔Premium replace.
        */}
        <div class="membership-price-update-triggers" hidden aria-hidden="true">
          {priceUpdateTriggers.map(({ planKey, priceId }) => (
            <button
              type="button"
              tabindex="-1"
              data-join-price-update={planKey}
              {...{ "data-ms-price:update": priceId }}
            />
          ))}
        </div>
      </>
    ) : null
  }

  {
    showStatus ? (
      <div
        id="join-checkout-status"
        class="join-checkout-status join-checkout-status--info"
        role="status"
        aria-live="polite"
        hidden
      />
    ) : null
  }

  <div class="membership-billing-toggle-wrap">
    <div class="membership-billing-toggle" role="radiogroup" aria-label="Billing period">
      <label for="membership-billing-monthly" class="membership-billing-toggle__option">
        Monthly
      </label>
      <label for="membership-billing-annual" class="membership-billing-toggle__option">
        Annual
      </label>
    </div>
  </div>

  <div class="join-plans">
    <article class="join-plan">
      <h3 class="join-plan__title">Basic Membership</h3>
      {
        variant === "full" ? (
          <>
            <p class="join-plan__tagline">Learn, knit, and build confidence.</p>
            <p class="join-plan__summary">
              Access Knit It Now lessons, tools, reference resources, member features, and the
              Sleeveless Sweater Pattern Builder.
            </p>
            <ul class="join-plan__features">
              {basicFeatures.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </>
        ) : (
          <p class="join-plan__summary">{basicCompactSummary}</p>
        )
      }
      <div class="join-plan__checkout">
        <div class="join-plan__billing join-plan__billing--monthly">
          <p class="join-plan__price">
            ${basicMonthlyPrice}<span class="join-plan__period">/month</span>
          </p>
          <button
            type="button"
            class="kbm-btn kbm-btn-primary join-plan__cta"
            data-join-checkout="basicMonthly"
          >
            Join Basic
          </button>
        </div>
        <div class="join-plan__billing join-plan__billing--annual">
          <p class="join-plan__price">
            ${basicAnnualPrice}<span class="join-plan__period">/year</span>
          </p>
          <p class="join-plan__savings">Save ${basicAnnualSavings}/year</p>
          <button
            type="button"
            class="kbm-btn kbm-btn-primary join-plan__cta"
            data-join-checkout="basicAnnual"
          >
            Join Basic
          </button>
        </div>
      </div>
    </article>

    <article class="join-plan join-plan--premium">
      <p class="join-plan__badge" aria-label="Best value plan">Best Value</p>
      <h3 class="join-plan__title">Premium Membership</h3>
      {
        variant === "full" ? (
          <>
            <p class="join-plan__tagline">Full access for active makers.</p>
            <p class="join-plan__summary">
              Everything in Basic, plus every Knit It Now pattern builder and every Knit It Now
              course.
            </p>
            <ul class="join-plan__features">
              {premiumFeatures.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </>
        ) : (
          <p class="join-plan__summary">{premiumCompactSummary}</p>
        )
      }
      <div class="join-plan__checkout">
        <div class="join-plan__billing join-plan__billing--monthly">
          <p class="join-plan__price">
            ${premiumMonthlyPrice}<span class="join-plan__period">/month</span>
          </p>
          <button
            type="button"
            class="kbm-btn kbm-btn-primary join-plan__cta"
            data-join-checkout="premiumMonthly"
          >
            Join Premium
          </button>
        </div>
        <div class="join-plan__billing join-plan__billing--annual">
          <p class="join-plan__price">
            ${premiumAnnualPrice}<span class="join-plan__period">/year</span>
          </p>
          <p class="join-plan__savings">Save ${premiumAnnualSavings}/year</p>
          <button
            type="button"
            class="kbm-btn kbm-btn-primary join-plan__cta"
            data-join-checkout="premiumAnnual"
          >
            Join Premium
          </button>
        </div>
      </div>
    </article>
  </div>

  {
    showFooter ? (
      <p class="join-footer">
        Returning or canceled members: <a href="#" data-ms-modal="login" data-ms-redirect="current-url">log in with your existing account</a>
        before joining again — do not create a second account.
        New here? Use Sign Up in the menu for a free account, then join.
        Already subscribed?
        Visit <a href="/account">your workspace</a>
        or <a href="#" data-join-billing-portal>manage billing</a>.
      </p>
    ) : null
  }
</div>

<style>
  .membership-pricing {
    margin: 0;
  }

  .membership-billing-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .membership-billing-toggle-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .membership-billing-toggle {
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.25rem;
    border: 1px solid #d6dbc9;
    border-radius: 999px;
    background: #f9f9f6;
  }

  .membership-billing-toggle__option {
    display: inline-block;
    padding: 0.45rem 1.35rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    color: #4d5a48;
    cursor: pointer;
    user-select: none;
    transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }

  .membership-billing-toggle__option:hover {
    color: #2c3a57;
  }

  :global(.membership-billing-scope:has(#membership-billing-monthly:checked))
    .membership-billing-toggle__option[for="membership-billing-monthly"],
  :global(.membership-billing-scope:has(#membership-billing-annual:checked))
    .membership-billing-toggle__option[for="membership-billing-annual"],
  :global(.membership-billing-scope[data-billing-period="monthly"])
    .membership-billing-toggle__option[for="membership-billing-monthly"],
  :global(.membership-billing-scope[data-billing-period="annual"])
    .membership-billing-toggle__option[for="membership-billing-annual"] {
    background: #fff;
    color: #2c3a57;
    box-shadow: 0 1px 3px rgba(82, 104, 45, 0.15);
  }

  .join-plan__billing--annual {
    display: none;
  }

  :global(.membership-billing-scope:has(#membership-billing-annual:checked))
    .join-plan__billing--monthly,
  :global(.membership-billing-scope[data-billing-period="annual"])
    .join-plan__billing--monthly {
    display: none;
  }

  :global(.membership-billing-scope:has(#membership-billing-annual:checked))
    .join-plan__billing--annual,
  :global(.membership-billing-scope[data-billing-period="annual"])
    .join-plan__billing--annual {
    display: block;
  }

  .join-checkout-status {
    margin: 0 0 1.25rem 0;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    font-size: var(--text-base, 1rem);
    line-height: 1.5;
  }

  .join-checkout-status[hidden] {
    display: none;
  }

  .join-checkout-status--info {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e3a8a;
  }

  .join-checkout-status--success {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
  }

  .join-checkout-status--error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .join-plan__cta:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .join-plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .join-plan {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fafafa;
  }

  .join-plan--premium {
    border-color: rgba(82, 104, 45, 0.35);
    background: #f8faf6;
  }

  .join-plan__badge {
    align-self: flex-start;
    margin: 0;
    padding: 0.2rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #4d5a48;
    background: rgba(82, 104, 45, 0.12);
    border-radius: 999px;
  }

  .join-plan__title {
    margin: 0;
    font-size: var(--text-xl, 1.25rem);
    line-height: 1.3;
  }

  .join-plan__tagline {
    margin: 0;
    font-size: var(--text-base, 1rem);
    font-weight: 600;
    line-height: 1.4;
    color: #2c3a57;
  }

  .join-plan__summary {
    margin: 0;
    font-size: var(--text-base, 1rem);
    line-height: 1.5;
    color: #374151;
    flex: 1;
  }

  .join-plan__features {
    margin: 0;
    padding-left: 1.15rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #4d5a48;
  }

  .join-plan__features li {
    margin-bottom: 0.35rem;
  }

  .join-plan__features li:last-child {
    margin-bottom: 0;
  }

  .membership-pricing[data-variant="compact"] .join-plan {
    gap: 0.65rem;
  }

  .membership-pricing[data-variant="compact"] .join-plans {
    margin-bottom: 0;
  }

  .join-plan__checkout {
    padding-top: 0.85rem;
    border-top: 1px solid #e5e7eb;
    margin-top: auto;
  }

  .join-plan__price {
    margin: 0 0 0.35rem 0;
    font-size: var(--text-lg, 1.125rem);
    font-weight: 600;
    color: #111827;
  }

  .join-plan__savings {
    margin: 0 0 0.65rem 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: #4d5a48;
  }

  .join-plan__period {
    font-size: var(--text-base, 1rem);
    font-weight: 500;
    color: #6b7280;
  }

  .join-plan__cta {
    display: inline-block;
    width: 100%;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
  }

  .join-plan__cta:disabled,
  .join-plan__cta[aria-disabled="true"] {
    cursor: default;
    opacity: 0.72;
  }

  .membership-price-update-triggers {
    display: none;
  }

  .join-footer {
    margin: 0;
    font-size: var(--text-base, 1rem);
    color: #6b7280;
  }

  .join-footer a {
    color: var(--kbm-green, #166534);
    text-decoration: underline;
  }
</style>
