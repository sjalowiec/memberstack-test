---
/**
 * Presentational membership CTA.
 *
 * Desktop / tablet (min-width: 768px): rounded floating pill, lower-right.
 * Phone (max-width: 767.98px): hidden — sticky/full-width bar covers content/controls.
 *
 * Visual-only: pass `label`; click/navigation wired in membershipCornerControl.ts.
 */
interface Props {
  label?: string;
}

const { label = "Become a Member" } = Astro.props;
---

<button
  type="button"
  class="membership-corner-cta"
  data-membership-corner-cta
  data-membership-corner-kind="become"
  data-membership-corner-href="/membership"
>
  {label}
</button>

<style>
  /* ---- Desktop / tablet: floating pill (unchanged) ---- */
  .membership-corner-cta {
    --membership-corner-inset: 1.5rem; /* 24px */
    --membership-bar-tap-h: 3.375rem; /* 54px; used on phone + body padding */
    position: fixed;
    z-index: 2800;
    bottom: max(var(--membership-corner-inset), env(safe-area-inset-bottom, 0px));
    right: max(var(--membership-corner-inset), env(safe-area-inset-right, 0px));
    appearance: none;
    border: none;
    cursor: pointer;
    margin: 0;
    padding: 0.65rem 1.2rem;
    border-radius: 999px;
    background: var(--kbm-accent, #c2614e);
    color: #fff;
    font-family: var(--font, "Poppins", system-ui, Arial, sans-serif);
    font-size: clamp(0.85rem, 2.4vw, 0.95rem);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    text-align: center;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.14);
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .membership-corner-cta:hover {
    background: var(--kbm-accent-hover, #a94e3d);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.2);
    transform: translateY(-2px);
  }

  .membership-corner-cta:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
    box-shadow:
      0 0 0 5px var(--kbm-green, #52682d),
      0 8px 20px rgba(15, 23, 42, 0.2);
  }

  .membership-corner-cta:active {
    transform: translateY(0);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.14);
  }

  .membership-corner-cta:disabled {
    cursor: wait;
    opacity: 0.75;
    transform: none;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .membership-corner-cta {
      transition: background-color 0.2s ease;
    }

    .membership-corner-cta:hover,
    .membership-corner-cta:active {
      transform: none;
    }
  }

  /*
   * Phone: hide site-wide corner CTA (covers content/controls).
   * Breakpoint matches site phone queries (max-width: 767.98px).
   * Also clear reserved body offset + CSS var so no blank bottom gap remains.
   * Tablet (768px+) keeps the floating pill.
   *
   * Use the data-attribute + !important so Astro :where() scoping (0 specificity)
   * cannot lose to a leftover full-width phone `display: flex` rule.
   */
  @media (max-width: 767.98px) {
    .membership-corner-cta,
    :global([data-membership-corner-cta]) {
      display: none !important;
    }

    :global(body) {
      --membership-bar-tap-h: 0;
      padding-bottom: 0;
    }
  }
</style>
