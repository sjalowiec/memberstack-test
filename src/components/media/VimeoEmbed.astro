---
import { kinVimeoPlayerDomId } from "../../lib/kinCourse/vimeoJumpLinks";
import { publicVimeoPlayerUrl } from "../../lib/videos/publicVimeoPlayerUrl";

interface Props {
  vimeoId: string;
  title?: string;
  aspectRatio?: "16:9" | "4:3";
  autoplay?: boolean;
  loop?: boolean;
  muted?: boolean;
  /** When set, chapter buttons on this page can seek this player. */
  playerKey?: string;
  /** Unlisted Vimeo privacy hash. Omitted from the player URL when blank or invalid. */
  privacyHash?: string;
  /** Turn the player control bar on. Omit to leave Vimeo's default. */
  controls?: boolean;
  /** When false, hide the Vimeo title overlay. */
  showPlayerTitle?: boolean;
  loading?: "lazy" | "eager";
}

const { 
  vimeoId, 
  title = "Video", 
  aspectRatio = "16:9",
  autoplay = false,
  loop = false,
  muted = false,
  playerKey = "",
  privacyHash,
  controls,
  showPlayerTitle,
  loading = "lazy",
} = Astro.props;

const vimeoUrl = publicVimeoPlayerUrl({
  vimeoId,
  autoplay,
  loop,
  muted,
  privacyHash,
  controls,
  showPlayerTitle,
});
const paddingBottom = aspectRatio === "16:9" ? "56.25%" : "75%";
---

<div class="vimeo-embed-wrapper" data-testid="video-vimeo">
  <div class="vimeo-embed-container" style={`padding-bottom: ${paddingBottom}`}>
    <iframe
      id={playerKey ? kinVimeoPlayerDomId(playerKey) : undefined}
      data-kin-vimeo-player={playerKey || undefined}
      src={vimeoUrl}
      title={title}
      frameborder="0"
      allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
      allowfullscreen
      loading={loading}
      aria-label={title}
    ></iframe>
  </div>
</div>

<style>
  .vimeo-embed-wrapper {
    margin: 1rem 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.15);
  }

  .vimeo-embed-container {
    position: relative;
    width: 100%;
    height: 0;
    overflow: hidden;
  }

  .vimeo-embed-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  @media (max-width: 768px) {
    .vimeo-embed-wrapper {
      margin: 0.75rem 0;
      border-radius: 6px;
    }
  }
</style>
