---
interface Props {
  fallback?: string;
  className?: string;
  label?: string;
}

const { fallback = "/tools", className = "", label = "← Back" } = Astro.props;
---

<a
  href={fallback}
  class={className}
  data-testid="link-back-catalog"
  onclick={`if (window.history.length > 1) { event.preventDefault(); window.history.back(); }`}
>
  {label}
</a>
