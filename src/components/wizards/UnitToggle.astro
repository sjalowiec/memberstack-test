---
/**
 * ============================================================================
 * KBM LEGO BLOCK: Unit Toggle Component
 * ============================================================================
 * 
 * This is a standardized, reusable component for all KBM wizards.
 * 
 * PURPOSE:
 * - Provides inches/cm switching with consistent KBM styling
 * - LEFT-ALIGNED, compact design (30-32px height)
 * - Appears immediately ABOVE the first input section in wizard forms
 * - Dispatches kbm:units-change event for page-level coordination
 * - Creates/manages hidden input for form submission
 * 
 * USAGE:
 * <UnitToggle id="mywizard" />
 * Multiple synced toggles (same `id`, shared `#unit` + storage): add `buttonSuffix` on secondary instances only.
 * 
 * PLACEMENT:
 * - Typically immediately above the first input section (additional copies stay in sync automatically)
 * - Do NOT right-align or tie to section titles
 * 
 * EVENTS:
 * - Dispatches: window.dispatchEvent(new CustomEvent("kbm:units-change", { detail: { unit: "in" | "cm" } }))
 * - Listen with: window.addEventListener("kbm:units-change", (e) => { ... })
 * 
 * HIDDEN INPUT:
 * - Creates <input type="hidden" name="unit" id="unit" value="in|cm" />
 * - Inserted into nearest parent <form> or #wizard-form
 */

interface Props {
  /** ID prefix for the toggle buttons (e.g., 'hat' creates 'hat-btn-inches') */
  id?: string;
  /** Default unit: 'in' or 'cm' */
  defaultUnit?: 'in' | 'cm';
  /** Additional CSS classes */
  class?: string;
  /**
   * Optional suffix so a second toggle can share the same `id` group without duplicate DOM ids
   * (buttons become `{id}-{suffix}-btn-inches` / `…-btn-cm`). Omit on the primary instance.
   */
  buttonSuffix?: string;
}

const { id = 'unit', defaultUnit = 'in', class: className = '', buttonSuffix } = Astro.props;
const suffix = buttonSuffix?.trim() ?? '';
const inchesBtnId = suffix ? `${id}-${suffix}-btn-inches` : `${id}-btn-inches`;
const cmBtnId = suffix ? `${id}-${suffix}-btn-cm` : `${id}-btn-cm`;
const isInchesActive = defaultUnit === 'in';
---

<div 
  class={`units-toggle ${className}`}
  role="group"
  aria-label="Units"
  data-unit-toggle={id}
  data-unit-button-suffix={suffix || undefined}
>
  <button 
    type="button"
    class={`unit-btn ${isInchesActive ? 'active' : ''}`}
    id={inchesBtnId}
    data-unit="in"
    aria-pressed={isInchesActive ? 'true' : 'false'}
    data-testid="button-unit-inches"
  >
    Inches
  </button>
  <button 
    type="button"
    class={`unit-btn ${!isInchesActive ? 'active' : ''}`}
    id={cmBtnId}
    data-unit="cm"
    aria-pressed={!isInchesActive ? 'true' : 'false'}
    data-testid="button-unit-cm"
  >
    Centimeters
  </button>
</div>

<script define:vars={{ id, defaultUnit }}>
  (function initUnitToggleGroup() {
    const scopeId = id;
    const initKey = '__kbm_ut_' + scopeId;
    if (typeof window !== 'undefined' && window[initKey]) return;
    if (typeof window !== 'undefined') window[initKey] = true;

    document.addEventListener('DOMContentLoaded', () => {
      const wrappers = document.querySelectorAll('[data-unit-toggle="' + scopeId + '"]');
      if (!wrappers.length) return;

      const pairs = [];
      wrappers.forEach((wrapper) => {
        const suffix = wrapper.getAttribute('data-unit-button-suffix') || '';
        const iid = suffix ? scopeId + '-' + suffix + '-btn-inches' : scopeId + '-btn-inches';
        const cid = suffix ? scopeId + '-' + suffix + '-btn-cm' : scopeId + '-btn-cm';
        const inchesBtn = document.getElementById(iid);
        const cmBtn = document.getElementById(cid);
        if (inchesBtn && cmBtn) pairs.push({ inchesBtn, cmBtn });
      });

      if (!pairs.length) return;

      /** Hat wizard uses same key/values as WizardUtils.createUnitStore('hat-unit'); other pages use global kbm-units. */
      const useHatUnitKey = scopeId === 'hat';
      const STORAGE_KEY = useHatUnitKey ? 'hat-unit' : 'kbm-units';

      function persistUiUnit(unit) {
        if (useHatUnitKey) {
          localStorage.setItem(STORAGE_KEY, unit === 'in' ? 'inches' : 'cm');
        } else {
          localStorage.setItem(STORAGE_KEY, unit);
        }
      }

      function readStoredUiUnit() {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (useHatUnitKey) {
          if (raw === 'inches') return 'in';
          if (raw === 'cm') return 'cm';
          const legacy = localStorage.getItem('kbm-units');
          if (legacy === 'in' || legacy === 'cm') {
            persistUiUnit(legacy);
            return legacy;
          }
          return null;
        }
        if (raw === 'in' || raw === 'cm') return raw;
        return null;
      }

      const anchorWrapper = wrappers[0];

      // Find or create hidden input for unit value
      let hiddenInput = document.getElementById('unit');
      if (!hiddenInput) {
        hiddenInput = document.createElement('input');
        hiddenInput.type = 'hidden';
        hiddenInput.name = 'unit';
        hiddenInput.id = 'unit';
        hiddenInput.value = defaultUnit;

        // Insert into wizard-form if exists, otherwise nearest form from first toggle
        const form = document.getElementById('wizard-form') || anchorWrapper.closest('form');
        if (form) {
          form.appendChild(hiddenInput);
        }
      }

      function setUnit(unit) {
        const previousUnit = hiddenInput && (hiddenInput.value === 'cm' ? 'cm' : 'in');

        const isInches = unit === 'in';

        pairs.forEach(({ inchesBtn, cmBtn }) => {
          inchesBtn.classList.toggle('active', isInches);
          cmBtn.classList.toggle('active', !isInches);
          inchesBtn.setAttribute('aria-pressed', isInches ? 'true' : 'false');
          cmBtn.setAttribute('aria-pressed', !isInches ? 'true' : 'false');
        });

        // Update hidden input
        if (hiddenInput) {
          hiddenInput.value = unit;
        }

        persistUiUnit(unit);

        window.dispatchEvent(new CustomEvent('kbm:units-change', {
          detail: { unit, previousUnit },
        }));
      }

      const savedUnit = readStoredUiUnit() || defaultUnit;
      setUnit(savedUnit);

      pairs.forEach(({ inchesBtn, cmBtn }) => {
        inchesBtn.addEventListener('click', () => setUnit('in'));
        cmBtn.addEventListener('click', () => setUnit('cm'));
      });
    });
  })();
</script>

<style>
  .units-toggle {
    display: inline-flex;
    align-items: center;
    border-radius: 6px;
    overflow: hidden;
    font-size: 0.9rem;
  }
  
  .units-toggle .unit-btn {
    padding: 6px 14px;
    border: 1px solid #9aa38f;
    background: #f3f4ef;
    color: #38412f;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  
  .units-toggle .unit-btn + .unit-btn {
    border-left: none;
  }
  
  .units-toggle .unit-btn.active {
    background: #52682D;
    color: #ffffff;
    border-color: #52682D;
  }
  
  .units-toggle .unit-btn:hover:not(.active) {
    background: #e7eadf;
    border-color: #8f987f;
  }
  
  .units-toggle .unit-btn:focus-visible {
    outline: 2px solid #52682D;
    outline-offset: 2px;
  }
  </style>

<style is:global>
  /* Containers that wrap heading + UnitToggle: same row on desktop, stacked on mobile */
  @media (max-width: 640px) {
    .section-header-with-toggle,
    .kbm-header-layout {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
  </style>
