---
/**
 * ============================================================================
 * KBM LEGO BLOCK: Unit Toggle Component
 * ============================================================================
 * 
 * This is a standardized, reusable component for all KBM wizards.
 * 
 * PURPOSE:
 * - Provides inches/cm switching with consistent KBM styling
 * - LEFT-ALIGNED, compact design (30-32px height)
 * - Appears immediately ABOVE the first input section in wizard forms
 * - Dispatches kbm:units-change event for page-level coordination
 * - Creates/manages hidden input for form submission
 * 
 * USAGE:
 * <UnitToggle id="mywizard" />
 * 
 * PLACEMENT:
 * - Insert ONCE per page, immediately above the first input section
 * - Do NOT right-align or tie to section titles
 * 
 * EVENTS:
 * - Dispatches: window.dispatchEvent(new CustomEvent("kbm:units-change", { detail: { unit: "in" | "cm" } }))
 * - Listen with: window.addEventListener("kbm:units-change", (e) => { ... })
 * 
 * HIDDEN INPUT:
 * - Renders <input type="hidden" id="{id}-unit" data-kbm-unit-value /> inside this toggle’s wrapper
 * - If this is the only unit field inside a parent form, name="unit" is set at runtime for submit parity
 */

interface Props {
  /** ID prefix for the toggle buttons (e.g., 'hat' creates 'hat-btn-inches') */
  id?: string;
  /** Default unit: 'in' or 'cm' */
  defaultUnit?: 'in' | 'cm';
  /** Additional CSS classes */
  class?: string;
}

const { id = 'unit', defaultUnit = 'in', class: className = '' } = Astro.props;
const isInchesActive = defaultUnit === 'in';
const hiddenFieldId = `${id}-unit`;
---

<div 
  class={`units-toggle ${className}`}
  role="group"
  aria-label="Units"
  data-unit-toggle={id}
>
  <input
    type="hidden"
    id={hiddenFieldId}
    data-kbm-unit-value
    value={defaultUnit}
  />
  <button 
    type="button"
    class={`unit-btn ${isInchesActive ? 'active' : ''}`}
    id={`${id}-btn-inches`}
    data-unit="in"
    aria-pressed={isInchesActive ? 'true' : 'false'}
    data-testid="button-unit-inches"
  >
    Inches
  </button>
  <button 
    type="button"
    class={`unit-btn ${!isInchesActive ? 'active' : ''}`}
    id={`${id}-btn-cm`}
    data-unit="cm"
    aria-pressed={!isInchesActive ? 'true' : 'false'}
    data-testid="button-unit-cm"
  >
    Centimeters
  </button>
</div>

<script define:vars={{ id, defaultUnit, hiddenFieldId }}>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleWrapper = document.querySelector(`[data-unit-toggle="${id}"]`);
    if (!toggleWrapper) return;

    const inchesBtn = toggleWrapper.querySelector('button[data-unit="in"]');
    const cmBtn = toggleWrapper.querySelector('button[data-unit="cm"]');
    if (!(inchesBtn instanceof HTMLButtonElement) || !(cmBtn instanceof HTMLButtonElement)) return;

    /** Hat: hat-unit. Default id `unit`: legacy global kbm-units. Any other id: scoped kbm-units-{id} for multi-toggle pages. */
    const useHatUnitKey = id === 'hat';
    const useGlobalKbmUnits = id === 'unit';
    const STORAGE_KEY = useHatUnitKey ? 'hat-unit' : useGlobalKbmUnits ? 'kbm-units' : `kbm-units-${id}`;

    function persistUiUnit(unit) {
      if (useHatUnitKey) {
        localStorage.setItem(STORAGE_KEY, unit === 'in' ? 'inches' : 'cm');
      } else {
        localStorage.setItem(STORAGE_KEY, unit);
      }
    }

    function readStoredUiUnit() {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (useHatUnitKey) {
        if (raw === 'inches') return 'in';
        if (raw === 'cm') return 'cm';
        const legacy = localStorage.getItem('kbm-units');
        if (legacy === 'in' || legacy === 'cm') {
          persistUiUnit(legacy);
          return legacy;
        }
        return null;
      }
      if (raw === 'in' || raw === 'cm') return raw;
      if (!useGlobalKbmUnits) {
        const legacyGlobal = localStorage.getItem('kbm-units');
        if (legacyGlobal === 'in' || legacyGlobal === 'cm') return legacyGlobal;
      }
      return null;
    }

    let hiddenInput = toggleWrapper.querySelector('[data-kbm-unit-value]');
    if (!(hiddenInput instanceof HTMLInputElement)) {
      hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.id = hiddenFieldId;
      hiddenInput.setAttribute('data-kbm-unit-value', '');
      hiddenInput.value = defaultUnit;
      toggleWrapper.insertBefore(hiddenInput, toggleWrapper.firstChild);
    }

    const hostForm = toggleWrapper.closest('form');
    if (hostForm) {
      const unitFields = hostForm.querySelectorAll('[data-kbm-unit-value]');
      if (unitFields.length === 1) {
        hiddenInput.name = 'unit';
      }
    }

    function setUnit(unit) {
      const isInches = unit === 'in';
      
      // Update button states
      inchesBtn.classList.toggle('active', isInches);
      cmBtn.classList.toggle('active', !isInches);
      inchesBtn.setAttribute('aria-pressed', isInches ? 'true' : 'false');
      cmBtn.setAttribute('aria-pressed', !isInches ? 'true' : 'false');
      
      // Update hidden input
      if (hiddenInput) {
        hiddenInput.value = unit;
      }

      // Save preference (hat-unit: inches/cm for WizardUtils.createUnitStore parity)
      persistUiUnit(unit);
      
      window.dispatchEvent(
        new CustomEvent('kbm:units-change', {
          detail: { unit, toggleId: id },
        }),
      );
    }

    // Load saved preference, otherwise use default
    const savedUnit = readStoredUiUnit() || defaultUnit;
    setUnit(savedUnit);

    inchesBtn.addEventListener('click', () => setUnit('in'));
    cmBtn.addEventListener('click', () => setUnit('cm'));
  });
</script>

<style>
  .units-toggle {
    display: inline-flex;
    align-items: center;
    border-radius: 6px;
    overflow: hidden;
    font-size: 0.9rem;
  }
  
  .units-toggle .unit-btn {
    padding: 6px 14px;
    border: 1px solid #9aa38f;
    background: #f3f4ef;
    color: #38412f;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  
  .units-toggle .unit-btn + .unit-btn {
    border-left: none;
  }
  
  .units-toggle .unit-btn.active {
    background: #52682D;
    color: #ffffff;
    border-color: #52682D;
  }
  
  .units-toggle .unit-btn:hover:not(.active) {
    background: #e7eadf;
    border-color: #8f987f;
  }
  
  .units-toggle .unit-btn:focus-visible {
    outline: 2px solid #52682D;
    outline-offset: 2px;
  }
  </style>

<style is:global>
  /* Containers that wrap heading + UnitToggle: same row on desktop, stacked on mobile */
  @media (max-width: 640px) {
    .section-header-with-toggle,
    .kbm-header-layout {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
  </style>
