---
/**
 * ============================================================================
 * KBM LEGO BLOCK: Gauge Input Component
 * ============================================================================
 *
 * Standardized gauge input for all KBM wizards.
 * Collects stitch and row gauge over 4" (or 10cm when metric).
 *
 * Modes:
 * - Default: FloatingInput chips (tools / hat / etc.)
 * - formFields: short titles + unit hints below (pattern Builder workspaces)
 */

import { Fragment } from 'astro/jsx-runtime';
import UnitToggle from './UnitToggle.astro';
import FloatingInput from '../tools/FloatingInput.astro';
import {
  editWorkspaceGaugeFieldTitle,
  editWorkspaceGaugeUnitDescription,
} from '../../lib/patterns/editWorkspaceGaugeUnitDisplay';

interface Props {
  /** ID prefix for form elements (e.g., 'hat' creates 'hat-stitch-gauge') */
  id?: string;
  /** Show section title above the gauge inputs */
  showTitle?: boolean;
  /** Custom title text */
  title?: string;
  /** Show the small "Gauge" sublabel above the stitch/row box (title alone is enough on some wizards) */
  showGaugeSubLabel?: boolean;
  /** Show the unit toggle (set false if wizard has its own toggle) */
  showToggle?: boolean;
  /** ID of external toggle buttons (defaults to id) */
  toggleId?: string;
  /**
   * When true, stitch/row inputs sit in a plain flex row (no inner bordered “gauge box”).
   * Use inside a page section that already provides grouping (e.g. hat builder).
   */
  flatRow?: boolean;
  /** When true, adds no-print on the wrapper so the Sts/Rows UI is hidden when printing (pattern copy can still show gauge in prose). */
  noPrint?: boolean;
  /** Optional floating-label copy when inches / cm (defaults to Sts/Rows 4″ / 10 cm). Ignored when formFields is true. */
  stitchLabelInches?: string;
  stitchLabelCm?: string;
  rowLabelInches?: string;
  rowLabelCm?: string;
  /**
   * Pattern workspace form layout: short titles above inputs, unit descriptions below.
   * Avoids floating-label nowrap clipping of long combined labels on phones.
   */
  formFields?: boolean;
}

const {
  id = 'gauge',
  showTitle = true,
  title = 'Your Gauge',
  showGaugeSubLabel = true,
  showToggle = true,
  toggleId,
  flatRow = false,
  noPrint = false,
  stitchLabelInches,
  stitchLabelCm,
  rowLabelInches,
  rowLabelCm,
  formFields = false,
} = Astro.props;

const effectiveToggleId = toggleId || "kbm-unit-toggle";

const stitchLabelInchesResolved = stitchLabelInches ?? 'Sts (4")';
const stitchLabelCmResolved = stitchLabelCm ?? 'Sts (10 cm)';
const rowLabelInchesResolved = rowLabelInches ?? 'Rows (4")';
const rowLabelCmResolved = rowLabelCm ?? 'Rows (10 cm)';

const stitchTitle = editWorkspaceGaugeFieldTitle("stitch");
const rowTitle = editWorkspaceGaugeFieldTitle("row");
const stitchHintIn = editWorkspaceGaugeUnitDescription("stitch", "in");
const stitchHintCm = editWorkspaceGaugeUnitDescription("stitch", "cm");
const rowHintIn = editWorkspaceGaugeUnitDescription("row", "in");
const rowHintCm = editWorkspaceGaugeUnitDescription("row", "cm");

/** When flatRow, omit inner row wrapper if there is nothing above the stitch/row fields (hat builder). */
const hasGaugePrefix =
  showTitle ||
  showGaugeSubLabel ||
  (!showTitle && showToggle);
---

<div
  class:list={[
    'gauge-input-wrapper',
    flatRow && !hasGaugePrefix && 'gauge-input-wrapper--flat',
    formFields && 'gauge-input-wrapper--form-fields',
    noPrint && 'no-print',
  ]}
  data-toggle-id={effectiveToggleId}
  data-gauge-stitch-in={formFields ? stitchHintIn : stitchLabelInchesResolved}
  data-gauge-stitch-cm={formFields ? stitchHintCm : stitchLabelCmResolved}
  data-gauge-row-in={formFields ? rowHintIn : rowLabelInchesResolved}
  data-gauge-row-cm={formFields ? rowHintCm : rowLabelCmResolved}
  data-gauge-form-fields={formFields ? "true" : undefined}
>
  {showTitle && showToggle && (
    <div class="kbm-header-layout">
      <h3 class="section-title">{title}</h3>
      <div id="kbm-units-toggle">
        <UnitToggle id={effectiveToggleId} />
      </div>
    </div>
  )}

  {showTitle && !showToggle && (
    <h3 class="section-title">{title}</h3>
  )}

  {!showTitle && showToggle && (
    <div class="gauge-toggle-only">
      <UnitToggle id={effectiveToggleId} />
    </div>
  )}

  {showGaugeSubLabel && <div class="gauge-label">Gauge</div>}

  {formFields ? (
    <div class="gauge-form-fields pattern-workspace-gauge-grid">
      <div class="gauge-form-field pattern-workspace-form-field">
        <label class="gauge-form-field__label" for={`${id}-stitch-gauge`}>{stitchTitle}</label>
        <input
          type="number"
          id={`${id}-stitch-gauge`}
          class="gauge-form-field__input"
          step="0.01"
          min="1"
          inputmode="decimal"
          data-testid={`input-${id}-stitch-gauge`}
          aria-describedby={`${id}-stitch-hint`}
        />
        <p
          class="pattern-workspace-field-hint gauge-form-field__hint"
          id={`${id}-stitch-hint`}
          data-gauge-hint="stitch"
        >
          {stitchHintIn}
        </p>
      </div>
      <div class="gauge-form-field pattern-workspace-form-field">
        <label class="gauge-form-field__label" for={`${id}-row-gauge`}>{rowTitle}</label>
        <input
          type="number"
          id={`${id}-row-gauge`}
          class="gauge-form-field__input"
          step="0.01"
          min="1"
          inputmode="decimal"
          data-testid={`input-${id}-row-gauge`}
          aria-describedby={`${id}-row-hint`}
        />
        <p
          class="pattern-workspace-field-hint gauge-form-field__hint"
          id={`${id}-row-hint`}
          data-gauge-hint="row"
        >
          {rowHintIn}
        </p>
      </div>
    </div>
  ) : (
    <>
      {!flatRow && (
        <div class="gauge-box">
          <FloatingInput
            id={`${id}-stitch-gauge`}
            labelId={`${id}-stitch-label`}
            labelClass="floating-label"
            label={stitchLabelInchesResolved}
            type="number"
            step="0.01"
            min="1"
            dataTestid={`input-${id}-stitch-gauge`}
          />
          <span class="gauge-divider">×</span>
          <FloatingInput
            id={`${id}-row-gauge`}
            labelId={`${id}-row-label`}
            labelClass="floating-label"
            label={rowLabelInchesResolved}
            type="number"
            step="0.01"
            min="1"
            dataTestid={`input-${id}-row-gauge`}
          />
        </div>
      )}
      {flatRow && hasGaugePrefix && (
        <div class="gauge-row">
          <FloatingInput
            id={`${id}-stitch-gauge`}
            labelId={`${id}-stitch-label`}
            labelClass="floating-label"
            label={stitchLabelInchesResolved}
            type="number"
            step="0.01"
            min="1"
            dataTestid={`input-${id}-stitch-gauge`}
          />
          <span class="gauge-divider">×</span>
          <FloatingInput
            id={`${id}-row-gauge`}
            labelId={`${id}-row-label`}
            labelClass="floating-label"
            label={rowLabelInchesResolved}
            type="number"
            step="0.01"
            min="1"
            dataTestid={`input-${id}-row-gauge`}
          />
        </div>
      )}
      {flatRow && !hasGaugePrefix && (
        <Fragment>
          <FloatingInput
            id={`${id}-stitch-gauge`}
            labelId={`${id}-stitch-label`}
            labelClass="floating-label"
            label={stitchLabelInchesResolved}
            type="number"
            step="0.01"
            min="1"
            dataTestid={`input-${id}-stitch-gauge`}
          />
          <span class="gauge-divider">×</span>
          <FloatingInput
            id={`${id}-row-gauge`}
            labelId={`${id}-row-label`}
            labelClass="floating-label"
            label={rowLabelInchesResolved}
            type="number"
            step="0.01"
            min="1"
            dataTestid={`input-${id}-row-gauge`}
          />
        </Fragment>
      )}
    </>
  )}
</div>

<style is:global>
.gauge-input-wrapper {
  margin-bottom: 1.5rem;
}

/* flatRow + no title/label/toggle: one flex row on the wrapper, fields are direct children */
.gauge-input-wrapper--flat {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.gauge-toggle-only {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 0.75rem;
}

.gauge-label {
  font-weight: 600;
  color: #374151;
  margin-bottom: 6px;
}

.gauge-box {
  background: #f7f9fb;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

/* Plain row: layout only — no second “card”; section/page supplies grouping */
.gauge-row {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
}

.gauge-divider {
  font-size: 18px;
  font-weight: 600;
  color: #6b7280;
}

.gauge-helper {
  font-size: 0.85rem;
  color: #6b7280;
  margin-top: 0.5rem;
  margin-bottom: 0;
  font-style: italic;
}

/* Pattern workspace form-fields mode (shared with EditWorkspaceGaugeFields wording). */
.gauge-input-wrapper--form-fields .gauge-form-fields {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0.75rem;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

@media (min-width: 700px) {
  .gauge-input-wrapper--form-fields .gauge-form-fields {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
}

.gauge-form-field {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0.28rem;
  min-width: 0;
  width: 100%;
}

.gauge-form-field__label {
  display: block;
  margin: 0;
  font-size: 0.82rem;
  font-weight: 600;
  line-height: 1.25;
  color: #3f4a36;
  white-space: normal;
  overflow: visible;
  text-overflow: unset;
}

.gauge-form-field__input {
  display: block;
  box-sizing: border-box;
  width: 100%;
  max-width: none;
  min-width: 0;
  min-height: 2.75rem;
  margin: 0;
  padding: 0.55rem 0.7rem;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-family: inherit;
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.3;
  color: #1f2937;
  background: #fff;
}

.gauge-form-field__input:focus {
  outline: none;
  border-color: var(--kbm-green, #52682d);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--kbm-green, #52682d) 16%, transparent);
}

.gauge-form-field__hint {
  margin: 0;
  white-space: normal;
  overflow: visible;
  text-overflow: unset;
}

/* ===========================================
   FLOATING INPUT STYLES FOR GAUGE INPUTS
   High specificity to override wizard.css
   =========================================== */
.gauge-box .floating-input,
.gauge-row .floating-input,
.gauge-input-wrapper--flat > .floating-input {
  position: relative !important;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  flex: 1 1 0;
  min-width: 120px;
}

.gauge-box .floating-input input,
.gauge-row .floating-input input,
.gauge-input-wrapper--flat > .floating-input input {
  width: 100% !important;
  min-height: 52px !important;
  padding: 1.25rem 0.75rem 0.5rem !important;
  border: 2px solid #e5e7eb !important;
  border-radius: 8px !important;
  font-family: var(--font);
  font-size: 1rem !important;
  color: var(--text-dark, #374151);
  background: white !important;
  transition: border-color 0.2s, box-shadow 0.2s;
  -moz-appearance: textfield;
  box-sizing: border-box;
}

.gauge-box .floating-input input::-webkit-outer-spin-button,
.gauge-box .floating-input input::-webkit-inner-spin-button,
.gauge-row .floating-input input::-webkit-outer-spin-button,
.gauge-row .floating-input input::-webkit-inner-spin-button,
.gauge-input-wrapper--flat > .floating-input input::-webkit-outer-spin-button,
.gauge-input-wrapper--flat > .floating-input input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.gauge-box .floating-input input:focus,
.gauge-row .floating-input input:focus,
.gauge-input-wrapper--flat > .floating-input input:focus {
  outline: none;
  border-color: var(--kbm-green) !important;
  box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.1) !important;
}

.gauge-box .floating-input .floating-label,
.gauge-row .floating-input .floating-label,
.gauge-input-wrapper--flat > .floating-input .floating-label {
  position: absolute !important;
  left: 0.75rem !important;
  top: 50% !important;
  right: auto !important;
  bottom: auto !important;
  transform: translateY(-50%) !important;
  display: block !important;
  width: auto !important;
  height: auto !important;
  margin: 0 !important;
  padding: 0 2px !important;
  font-size: 0.95rem !important;
  font-weight: normal !important;
  color: #6b7280 !important;
  pointer-events: none !important;
  transition: all 0.2s ease !important;
  background: transparent !important;
  white-space: nowrap !important;
  z-index: 1 !important;
}

.gauge-box .floating-input input:focus ~ .floating-label,
.gauge-box .floating-input input:not(:placeholder-shown) ~ .floating-label,
.gauge-row .floating-input input:focus ~ .floating-label,
.gauge-row .floating-input input:not(:placeholder-shown) ~ .floating-label,
.gauge-input-wrapper--flat > .floating-input input:focus ~ .floating-label,
.gauge-input-wrapper--flat > .floating-input input:not(:placeholder-shown) ~ .floating-label {
  top: 0.35rem !important;
  transform: translateY(0) !important;
  font-size: 0.75rem !important;
  color: var(--kbm-green) !important;
  font-weight: 500 !important;
}

.gauge-box .floating-input input::placeholder,
.gauge-row .floating-input input::placeholder,
.gauge-input-wrapper--flat > .floating-input input::placeholder {
  color: transparent !important;
}

.gauge-box .floating-input input:focus::placeholder,
.gauge-row .floating-input input:focus::placeholder,
.gauge-input-wrapper--flat > .floating-input input:focus::placeholder {
  color: #9ca3af !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {

  document.querySelectorAll('.gauge-input-wrapper').forEach((wrapper) => {

    const toggleId = (wrapper as HTMLElement).dataset.toggleId;
    const stitchInput = wrapper.querySelector('input[id$="-stitch-gauge"]');

    if (!stitchInput || !toggleId) return;

    const id = stitchInput.id.replace('-stitch-gauge','');
    const isFormFields = (wrapper as HTMLElement).dataset.gaugeFormFields === "true";

    const stitchLabel = document.getElementById(`${id}-stitch-label`);
    const rowLabel = document.getElementById(`${id}-row-label`);
    const stitchHint = wrapper.querySelector<HTMLElement>('[data-gauge-hint="stitch"]');
    const rowHint = wrapper.querySelector<HTMLElement>('[data-gauge-hint="row"]');

    const w = wrapper as HTMLElement;
    function updateLabels(unit: string) {
      if (isFormFields) {
        if (stitchHint) {
          stitchHint.textContent =
            unit === "cm" ? (w.dataset.gaugeStitchCm ?? "stitches per 10 cm") : (w.dataset.gaugeStitchIn ?? 'stitches per 4"');
        }
        if (rowHint) {
          rowHint.textContent =
            unit === "cm" ? (w.dataset.gaugeRowCm ?? "rows per 10 cm") : (w.dataset.gaugeRowIn ?? 'rows per 4"');
        }
        if (stitchInput instanceof HTMLInputElement && stitchHint) {
          stitchInput.setAttribute("aria-label", `Stitch gauge, ${stitchHint.textContent}`);
        }
        const rowInput = wrapper.querySelector(`#${CSS.escape(id)}-row-gauge`);
        if (rowInput instanceof HTMLInputElement && rowHint) {
          rowInput.setAttribute("aria-label", `Row gauge, ${rowHint.textContent}`);
        }
        return;
      }

      if (!stitchLabel || !rowLabel) return;

      if (unit === 'cm') {
        stitchLabel.textContent = w.dataset.gaugeStitchCm ?? 'Sts (10 cm)';
        rowLabel.textContent = w.dataset.gaugeRowCm ?? 'Rows (10 cm)';
      } else {
        stitchLabel.textContent = w.dataset.gaugeStitchIn ?? 'Sts (4")';
        rowLabel.textContent = w.dataset.gaugeRowIn ?? 'Rows (4")';
      }
    }

    function getToggleRoot(): HTMLElement | null {
      const scoped = document.querySelector(`[data-unit-toggle="${toggleId}"]`);
      return scoped instanceof HTMLElement ? scoped : null;
    }

    function getCurrentUnit() {
      const root = getToggleRoot();
      const btnCm = root?.querySelector('button[data-unit="cm"]');
      const btnInches = root?.querySelector('button[data-unit="in"]');

      if (btnCm instanceof HTMLButtonElement && btnCm.classList.contains('active')) return 'cm';
      if (btnInches instanceof HTMLButtonElement && btnInches.classList.contains('active')) return 'in';

      const hidden = root?.querySelector<HTMLInputElement>('[data-kbm-unit-value]');
      if (hidden && (hidden.value === 'cm' || hidden.value === 'in')) {
        return hidden.value;
      }

      const saved =
        localStorage.getItem(`kbm-units-${toggleId}`) ||
        localStorage.getItem('kbm-units') ||
        localStorage.getItem(`${toggleId}.unit`) ||
        localStorage.getItem(`${toggleId}-unit`);

      return saved === 'cm' ? 'cm' : 'in';
    }

    window.addEventListener('kbm:units-change', (e: Event) => {
      const detail = (e as CustomEvent<{ unit?: string; toggleId?: string }>).detail;
      if (detail?.toggleId != null && detail.toggleId !== toggleId) return;
      const newUnit = detail?.unit ? detail.unit : 'in';
      updateLabels(newUnit);
    });

    updateLabels(getCurrentUnit());

  });

});
</script>
