---
/**
 * Site-wide modal for catalog (KIN) videos triggered by:
 *   <button type="button" class="kbm-kin-catalog-video" data-vimeo-id="{numericVimeoId}" data-video-title="…">
 * Optional start time on the trigger (first non-empty): `data-video-start`, `data-start-time`, `data-time`
 * (seconds or `mm:ss` / `hh:mm:ss`). Jump controls inside the modal may use `data-video-jump`,
 * `data-jump-time`, `data-jumptime` (legacy), or `data-time` (same time formats); active jump gets
 * `kbm-kin-catalog-video-modal__jump--active`. Optional `data-video-chapters` on the trigger is a JSON array of
 * `{ label, time }` (from the catalog row's `chapters` or `jumpLinks`) used to render chapter buttons inside the modal when it opens.
 * `data-vimeo-id` must be the numeric Vimeo player id (for example from `videos-public.json` after
 * resolving a catalog `content_id`). Do not pass internal catalog ids here.
 * Uses the same Vimeo player URL pattern as /videos/[id] (GatedVimeoEmbed open videos), plus `api=1` for Player.js.
 */
---

<div
  id="kbmKinCatalogVideoModal"
  class="kbm-kin-catalog-video-modal"
  hidden
  aria-hidden="true"
>
  <div class="kbm-kin-catalog-video-modal__backdrop" data-kin-video-close="true"></div>
  <div
    class="kbm-kin-catalog-video-modal__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="kbmKinCatalogVideoModalTitle"
  >
    <h2 id="kbmKinCatalogVideoModalTitle" class="kbm-kin-catalog-video-modal__sr-title">
      Video
    </h2>
    <button
      type="button"
      id="kbmKinCatalogVideoModalClose"
      class="kbm-kin-catalog-video-modal__close"
      aria-label="Close video"
    >
      ×
    </button>
    <div class="kbm-kin-catalog-video-modal__frame">
      <iframe
        id="kbmKinCatalogVideoIframe"
        title="Video"
        loading="lazy"
        frameborder="0"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
    <div id="kbmKinCatalogVideoModalChapters" class="kbm-kin-catalog-video-modal__chapters" hidden></div>
  </div>
</div>

<style>
  /* Above `.glossaryModal` (z-index 99999 on glossary index) and glossary tooltips (~10050) so catalog video can open from glossary UI. Below site chrome (e.g. header) where applicable. */
  .kbm-kin-catalog-video-modal {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .kbm-kin-catalog-video-modal[hidden],
  .kbm-kin-catalog-video-modal[aria-hidden="true"] {
    display: none !important;
  }

  .kbm-kin-catalog-video-modal__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgba(17, 24, 39, 0.62);
  }

  .kbm-kin-catalog-video-modal__panel {
    position: relative;
    z-index: 1;
    width: min(94vw, 1200px);
    max-width: 1200px;
    max-height: calc(100vh - 2rem);
    background: #0f172a;
    border-radius: 12px;
    overflow-x: hidden;
    overflow-y: auto;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
  }

  .kbm-kin-catalog-video-modal__sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .kbm-kin-catalog-video-modal__close {
    position: absolute;
    top: 10px;
    right: 12px;
    z-index: 10;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(15, 23, 42, 0.78);
    color: #f8fafc;
    font-size: 1.45rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .kbm-kin-catalog-video-modal__close:hover,
  .kbm-kin-catalog-video-modal__close:focus-visible {
    background: rgba(30, 41, 59, 0.95);
    outline: 2px solid #cbd5e1;
    outline-offset: 2px;
  }

  .kbm-kin-catalog-video-modal__frame {
    width: 100%;
    position: relative;
    z-index: 0;
    padding-top: 56.25%;
    background: #000;
  }

  .kbm-kin-catalog-video-modal__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .kbm-kin-catalog-video-modal .kbm-kin-catalog-video-modal__jump--active {
    outline: 2px solid #94a3b8;
    outline-offset: 2px;
  }

  .kbm-kin-catalog-video-modal__chapters {
    padding: 0.65rem 0.85rem 0.85rem;
    background: rgba(15, 23, 42, 0.98);
    border-top: 1px solid rgba(148, 163, 184, 0.28);
    max-height: min(38vh, 280px);
    overflow: auto;
    flex-shrink: 0;
  }

  .kbm-kin-catalog-video-modal__chapters[hidden] {
    display: none !important;
  }

  .kbm-kin-catalog-video-modal__chapters-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  .kbm-kin-catalog-video-modal__chapter {
    display: inline-flex;
    align-items: center;
    text-align: left;
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    border: 1px solid rgba(148, 163, 184, 0.45);
    background: rgba(30, 41, 59, 0.85);
    color: #e2e8f0;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
    max-width: 100%;
  }

  .kbm-kin-catalog-video-modal__chapter:hover,
  .kbm-kin-catalog-video-modal__chapter:focus-visible {
    background: rgba(51, 65, 85, 0.95);
    border-color: rgba(203, 213, 225, 0.55);
    outline: none;
  }

  .kbm-kin-catalog-video-modal__chapter:focus-visible {
    outline: 2px solid #cbd5e1;
    outline-offset: 2px;
  }
</style>

<script is:inline>
  (function () {
    function extractVimeoId(input) {
      var value = String(input || "").trim();
      if (!value) return null;
      var numeric = value.match(/^(\d+)$/);
      if (numeric) return numeric[1];
      var match =
        value.match(/vimeo\.com\/(?:video\/)?(\d+)/) ||
        value.match(/player\.vimeo\.com\/video\/(\d+)/);
      return match ? match[1] : null;
    }

    var VIMEO_API_SRC = "https://player.vimeo.com/api/player.js";
    var IFRAME_PLAYER_ID = "kbmKinCatalogVideoIframe";

    var modal = document.getElementById("kbmKinCatalogVideoModal");
    var iframe = document.getElementById("kbmKinCatalogVideoIframe");
    var closeBtn = document.getElementById("kbmKinCatalogVideoModalClose");
    var titleEl = document.getElementById("kbmKinCatalogVideoModalTitle");
    var chaptersWrap = document.getElementById("kbmKinCatalogVideoModalChapters");
    if (!modal || !iframe || !(iframe instanceof HTMLIFrameElement)) return;

    var lastFocus = null;
    var vimeoPlayer = null;
    var vimeoApiPromise = null;
    var activeJumpEl = null;
    var openGeneration = 0;

    function ensureVimeoApi() {
      if (typeof window !== "undefined" && window.Vimeo && window.Vimeo.Player) {
        return Promise.resolve();
      }
      if (vimeoApiPromise) return vimeoApiPromise;
      var existing = document.querySelector('script[src="' + VIMEO_API_SRC + '"]');
      if (existing) {
        vimeoApiPromise = new Promise(function (resolve, reject) {
          if (window.Vimeo && window.Vimeo.Player) {
            resolve();
            return;
          }
          function onLoad() {
            existing.removeEventListener("load", onLoad);
            if (window.Vimeo && window.Vimeo.Player) resolve();
            else reject(new Error("Vimeo API unavailable"));
          }
          function onErr() {
            existing.removeEventListener("error", onErr);
            vimeoApiPromise = null;
            reject(new Error("Vimeo Player API script failed"));
          }
          existing.addEventListener("load", onLoad);
          existing.addEventListener("error", onErr);
          Promise.resolve().then(function () {
            if (window.Vimeo && window.Vimeo.Player) {
              existing.removeEventListener("load", onLoad);
              existing.removeEventListener("error", onErr);
              resolve();
            }
          });
        });
        return vimeoApiPromise;
      }
      vimeoApiPromise = new Promise(function (resolve, reject) {
        var s = document.createElement("script");
        s.src = VIMEO_API_SRC;
        s.async = true;
        s.onload = function () {
          resolve();
        };
        s.onerror = function () {
          vimeoApiPromise = null;
          reject(new Error("Vimeo Player API script failed"));
        };
        document.head.appendChild(s);
      });
      return vimeoApiPromise;
    }

    function parseVideoTime(value) {
      if (value == null) return null;
      var str = String(value).trim();
      if (!str) return null;
      if (/^\d+(\.\d+)?$/.test(str)) return parseFloat(str);
      var parts = str.split(":");
      if (parts.length < 2 || parts.length > 3) return null;
      for (var i = 0; i < parts.length; i++) {
        if (!/^\d+(\.\d+)?$/.test(parts[i].trim())) return null;
      }
      var n = parts.map(function (p) {
        return parseFloat(p.trim());
      });
      if (parts.length === 2) return n[0] * 60 + n[1];
      return n[0] * 3600 + n[1] * 60 + n[2];
    }

    function getTriggerStartTime(trigger) {
      if (!trigger) return null;
      var keys = ["data-video-start", "data-start-time", "data-time"];
      for (var i = 0; i < keys.length; i++) {
        if (!trigger.hasAttribute(keys[i])) continue;
        var raw = trigger.getAttribute(keys[i]);
        if (raw == null || !String(raw).trim()) continue;
        var sec = parseVideoTime(raw);
        if (sec != null && !isNaN(sec) && sec >= 0) return sec;
      }
      return null;
    }

    function clearActiveJumpState() {
      if (activeJumpEl) {
        activeJumpEl.classList.remove("kbm-kin-catalog-video-modal__jump--active");
        activeJumpEl = null;
      }
    }

    function setActiveJumpState(element) {
      clearActiveJumpState();
      if (element) {
        activeJumpEl = element;
        activeJumpEl.classList.add("kbm-kin-catalog-video-modal__jump--active");
      }
    }

    function destroyVimeoPlayer() {
      if (!vimeoPlayer) return Promise.resolve();
      var p = vimeoPlayer;
      vimeoPlayer = null;
      return p.destroy().catch(function () {});
    }

    // Rebuild a clean iframe inside the frame container on every open. Vimeo's
    // Player can detach/replace the element and its async destroy() resets whatever
    // iframe it still holds — starting fresh guarantees the new src survives reopen.
    function resetIframeElement() {
      var frame = document.querySelector(".kbm-kin-catalog-video-modal__frame");
      if (!frame) return iframe;
      var existing = frame.querySelectorAll("iframe");
      for (var i = 0; i < existing.length; i++) {
        if (existing[i].parentNode) existing[i].parentNode.removeChild(existing[i]);
      }
      var fresh = document.createElement("iframe");
      fresh.id = IFRAME_PLAYER_ID;
      fresh.setAttribute("title", "Video");
      fresh.setAttribute("loading", "lazy");
      fresh.setAttribute("frameborder", "0");
      fresh.setAttribute("allow", "autoplay; fullscreen; picture-in-picture");
      fresh.setAttribute("allowfullscreen", "");
      // Inline fill styles: a JS-created element lacks the Astro scoped-style
      // attribute, so the scoped ".__frame iframe" rule won't match it. Inline
      // styles guarantee it fills the 16:9 frame regardless of CSS scoping.
      fresh.style.position = "absolute";
      fresh.style.top = "0";
      fresh.style.left = "0";
      fresh.style.width = "100%";
      fresh.style.height = "100%";
      fresh.style.display = "block";
      fresh.style.border = "0";
      frame.appendChild(fresh);
      iframe = fresh;
      return iframe;
    }

    function closeModal() {
      openGeneration++;
      clearActiveJumpState();
      clearModalChapters();
      var p = vimeoPlayer;
      vimeoPlayer = null;
      modal.hidden = true;
      modal.setAttribute("aria-hidden", "true");
      iframe.removeAttribute("src");
      iframe.title = "Video";
      if (titleEl) titleEl.textContent = "Video";
      document.body.style.overflow = "";
      if (p && typeof p.destroy === "function") {
        p.destroy().catch(function () {});
      }
      if (lastFocus && typeof lastFocus.focus === "function") {
        try {
          lastFocus.focus();
        } catch (e) {}
      }
      lastFocus = null;
    }

    function buildVimeoSrc(vimeoId) {
      return (
        "https://player.vimeo.com/video/" +
        vimeoId +
        "?autoplay=1&api=1&player_id=" +
        encodeURIComponent(IFRAME_PLAYER_ID)
      );
    }

    function getJumpTimeAttributeValue(el) {
      if (!el) return null;
      if (el.hasAttribute("data-video-jump")) return el.getAttribute("data-video-jump");
      if (el.hasAttribute("data-jump-time")) return el.getAttribute("data-jump-time");
      if (el.hasAttribute("data-jumptime")) return el.getAttribute("data-jumptime");
      if (el.hasAttribute("data-time")) return el.getAttribute("data-time");
      return null;
    }

    function jumpIframeMatches(el) {
      if (!(el instanceof Element)) return true;
      var idAttr = el.getAttribute("data-jumpiframe");
      if (idAttr == null || !String(idAttr).trim()) return true;
      return String(idAttr).trim() === IFRAME_PLAYER_ID;
    }

    function findJumpTarget(fromEl) {
      if (!(fromEl instanceof Element)) return null;
      var el = fromEl.closest(
        "[data-video-jump], [data-jump-time], [data-jumptime], [data-time], button.jumplink",
      );
      if (!el || !modal.contains(el)) return null;
      if (!jumpIframeMatches(el)) return null;
      var raw = getJumpTimeAttributeValue(el);
      if (raw == null || !String(raw).trim()) return null;
      if (parseVideoTime(raw) == null) return null;
      return el;
    }

    function clearModalChapters() {
      if (!chaptersWrap) return;
      chaptersWrap.innerHTML = "";
      chaptersWrap.hidden = true;
    }

    function renderModalChaptersFromTrigger(trigger) {
      clearModalChapters();
      if (!chaptersWrap || !trigger) return;
      var raw = trigger.getAttribute("data-video-chapters");
      if (!raw || !String(raw).trim()) return;
      var rows;
      try {
        rows = JSON.parse(raw);
      } catch (e) {
        return;
      }
      if (!Array.isArray(rows) || rows.length === 0) return;
      var inner = document.createElement("div");
      inner.className = "kbm-kin-catalog-video-modal__chapters-inner";
      for (var i = 0; i < rows.length; i++) {
        var row = rows[i];
        if (!row || typeof row !== "object") continue;
        var label = String(row.label != null ? row.label : "").trim();
        var t = row.time;
        var sec = null;
        if (typeof t === "number" && isFinite(t)) sec = t;
        else if (typeof t === "string" && /^\d+(\.\d+)?$/.test(t.trim())) sec = parseFloat(t.trim());
        if (!label || sec == null || sec < 0) continue;
        var b = document.createElement("button");
        b.type = "button";
        b.className = "kbm-kin-catalog-video-modal__chapter";
        b.setAttribute("data-video-jump", String(sec));
        b.textContent = label;
        inner.appendChild(b);
      }
      if (!inner.childNodes.length) return;
      chaptersWrap.appendChild(inner);
      chaptersWrap.hidden = false;
    }

    function openModal(trigger) {
      var raw = trigger.getAttribute("data-vimeo-id");
      var vimeoId = extractVimeoId(raw);
      if (!vimeoId) return;
      var myGen = ++openGeneration;
      var videoTitle = (trigger.getAttribute("data-video-title") || "").trim();
      lastFocus = document.activeElement;
      var label = videoTitle || "Video";
      if (titleEl) titleEl.textContent = label;
      clearActiveJumpState();
      renderModalChaptersFromTrigger(trigger);

      // Tear down any previous player in the background, then start from a fresh
      // iframe so its late async teardown cannot clobber the new src on reopen.
      destroyVimeoPlayer();
      resetIframeElement();
      iframe.title = label;
      iframe.src = buildVimeoSrc(vimeoId);
      modal.hidden = false;
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      if (closeBtn && typeof closeBtn.focus === "function") closeBtn.focus();

      ensureVimeoApi().then(function () {
        if (myGen !== openGeneration || modal.hidden) return;
        try {
          vimeoPlayer = new window.Vimeo.Player(iframe);
        } catch (err) {
          return;
        }
        return vimeoPlayer.ready();
      }).then(function () {
        if (myGen !== openGeneration || modal.hidden || !vimeoPlayer) return;
        var startSec = getTriggerStartTime(trigger);
        if (startSec != null) {
          return vimeoPlayer.setCurrentTime(startSec).catch(function () {});
        }
      }).then(function () {
        if (myGen !== openGeneration || modal.hidden || !vimeoPlayer) return;
        return vimeoPlayer.play().catch(function () {});
      }).catch(function () {});
    }

    document.addEventListener(
      "click",
      function (e) {
        var t = e.target;
        if (!(t instanceof Element)) return;
        if (!modal.hidden) {
          var jumpEl = findJumpTarget(t);
          if (jumpEl) {
            e.preventDefault();
            e.stopPropagation();
            var rawJump = getJumpTimeAttributeValue(jumpEl);
            var sec = parseVideoTime(rawJump);
            if (sec != null && !isNaN(sec) && sec >= 0 && vimeoPlayer) {
              vimeoPlayer
                .setCurrentTime(sec)
                .then(function () {
                  return vimeoPlayer.play();
                })
                .catch(function () {});
              setActiveJumpState(jumpEl);
            }
            return;
          }
        }
        var trigger = t.closest(".kbm-kin-catalog-video");
        if (!trigger) return;
        if (!(trigger instanceof HTMLButtonElement) && !(trigger instanceof HTMLAnchorElement)) return;
        var vid = trigger.getAttribute("data-vimeo-id");
        if (!vid) return;
        e.preventDefault();
        openModal(trigger);
      },
      true
    );

    if (closeBtn) closeBtn.addEventListener("click", closeModal);
    var bd = modal.querySelector("[data-kin-video-close]");
    if (bd) bd.addEventListener("click", closeModal);

    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      if (modal.hidden) return;
      e.preventDefault();
      closeModal();
    });
  })();
</script>
