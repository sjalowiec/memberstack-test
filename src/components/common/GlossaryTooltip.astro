---
/**
 * Reusable inline glossary tooltip. Prefer glossaryId (id) for reliable lookup;
 * term is supported for backward compatibility.
 *
 * Preferred (by id):
 *   <GlossaryTooltip id={753} />
 *   <GlossaryTooltip id={753}>fine gauge machine</GlossaryTooltip>
 *   <GlossaryTooltip id={753} autoOpenOnce>fine gauge machine</GlossaryTooltip>
 *
 * Fallback (by term):
 *   <GlossaryTooltip term="Fine Gauge" />
 */
import { randomUUID } from "node:crypto";

interface Props {
  /** Glossary entry id (glossaryId). Preferred. */
  id?: number;
  /** Look up by term (entry.english). Fallback for backward compatibility. */
  term?: string;
  /** First page visit: open the rich glossary popup once per entry (localStorage). Requires a resolved glossary entry with glossaryId. */
  autoOpenOnce?: boolean;
}

const { id, term, autoOpenOnce = false } = Astro.props;

import glossaryData from "../../data/glossary.json";
import videosPublic from "../../data/videos-public.json";
import { buildGlossaryRelatedVideosHtml } from "../../lib/glossary/glossaryCatalogVideos";
import type { PublicVideoRow } from "../../lib/lessonVideo";

type RelatedTool = { name: string; url: string; icon?: string };

type GlossaryRow = {
  glossaryId: number;
  english: string;
  example?: string;
  helpinfo?: string;
  image?: string;
  image_alt?: string;
  relatedTools?: RelatedTool[];
  active?: boolean;
  vimeoIds?: unknown;
  videoIds?: unknown;
};

const glossary: GlossaryRow[] = Array.isArray(glossaryData) ? (glossaryData as GlossaryRow[]) : [];
const glossaryCatalogVideos: PublicVideoRow[] = Array.isArray(videosPublic)
  ? (videosPublic as PublicVideoRow[])
  : [];

/** Remove embeds / executable markup; keep images (e.g. GIFs) and normal HTML. */
function sanitizeGlossaryPopupHtml(html: string): string {
  if (!html) return "";
  return html
    .replace(/<script\b[\s\S]*?<\/script>/gi, "")
    .replace(/<iframe\b[\s\S]*?<\/iframe>/gi, "")
    .replace(/<video\b[\s\S]*?<\/video>/gi, "")
    .replace(/<audio\b[\s\S]*?<\/audio>/gi, "")
    .replace(/<object\b[\s\S]*?<\/object>/gi, "")
    .replace(/<embed\b[^>]*\/?>/gi, "");
}

function escapeHtmlAttr(s: string): string {
  return (s ?? "")
    .replace(/&/g, "&amp;")
    .replace(/"/g, "&quot;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

function escapeHtmlText(s: string): string {
  return (s ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

function normalizeGlossaryImageSrc(path: string): string {
  const p = (path ?? "").trim();
  if (!p) return "";
  if (p.startsWith("http") || p.startsWith("/")) return p;
  return `/images/glossary/${p.replace(/^\.?\//, "")}`;
}

function buildRelatedToolsPopupHtml(tools: RelatedTool[]): string {
  if (!Array.isArray(tools) || tools.length === 0) return "";
  const items = tools
    .map((t) => {
      const name = escapeHtmlText((t?.name ?? "").trim());
      const url = escapeHtmlAttr((t?.url ?? "").trim());
      if (!name || !url) return "";
      const iconRaw = (t?.icon ?? "").trim();
      const icon =
        iconRaw !== ""
          ? `<img src="${escapeHtmlAttr(iconRaw)}" alt="" class="glossary-related-tools__icon" width="26" height="26" loading="lazy" decoding="async" />`
          : "";
      return `<li class="glossary-related-tools__item"><a href="${url}" class="glossary-related-tools__link">${icon}<span class="glossary-related-tools__name">${name}</span></a></li>`;
    })
    .filter(Boolean)
    .join("");
  if (!items) return "";
  return `<div class="glossary-related-tools"><p class="glossary-related-tools__heading">Use this tool</p><ul class="glossary-related-tools__list">${items}</ul></div>`;
}

/** Sanitized example HTML plus illustration + help; no iframe/video/script. */
function buildGlossaryContentHtml(entry: GlossaryRow): string {
  const parts: string[] = [];
  const ex = (entry.example ?? "").trim();
  if (ex) {
    if (/[<>]/.test(ex)) {
      parts.push(sanitizeGlossaryPopupHtml(ex));
    } else {
      parts.push(`<p class="glossary-popup-lead">${escapeHtmlText(ex)}</p>`);
    }
  }
  const imgSrc = normalizeGlossaryImageSrc(entry.image ?? "");
  const altRaw = (entry.image_alt ?? "").trim() || stripHtml(entry.english ?? "");
  if (imgSrc) {
    parts.push(
      `<figure class="glossary-popup-figure"><img src="${escapeHtmlAttr(imgSrc)}" alt="${escapeHtmlAttr(altRaw)}" loading="lazy" /></figure>`
    );
  }
  const help = (entry.helpinfo ?? "").trim();
  if (help) {
    parts.push(`<div class="glossary-popup-help">${sanitizeGlossaryPopupHtml(help)}</div>`);
  }
  const relatedVideosHtml = buildGlossaryRelatedVideosHtml(entry, glossaryCatalogVideos);
  if (relatedVideosHtml) parts.push(relatedVideosHtml);
  const toolsHtml = buildRelatedToolsPopupHtml(entry.relatedTools ?? []);
  if (toolsHtml) parts.push(toolsHtml);
  return parts.join("");
}

const htmlToText = (html: string) => {
  if (!html) return "";
  let out = html
    .replace(/<script[\s\S]*?<\/script>/gi, "")
    .replace(/<style[\s\S]*?<\/style>/gi, "")
    .replace(/<\/(p|div|li|br|figure|figcaption|h\d)>/gi, " ")
    .replace(/<(br|hr)\s*\/?>/gi, " ")
    .replace(/<[^>]+>/g, " ");
  out = out
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/\s+/g, " ")
    .trim();
  return out;
};

const stripHtml = (s: string) => (s ?? "").replace(/<[^>]*>/g, "").trim();

const truncate = (text: string, max = 260) => {
  const t = (text ?? "").trim();
  if (t.length <= max) return t;
  return t.slice(0, max).replace(/\s+\S*$/, "") + "…";
};

const norm = (s: string) => (s ?? "").toLowerCase().trim();
const matchesTerm = (entryEnglish: string, t: string) => {
  const e = norm(entryEnglish);
  const target = norm(t);
  if (!e) return false;
  const parts = e.split("|").map((p) => p.trim());
  return parts.some((p) => norm(p) === target) || e === target;
};

let entry: GlossaryRow | undefined;

if (id != null) {
  entry = glossary.find((e) => e.glossaryId === id && e.active === true);
  if (!entry && typeof console !== "undefined" && import.meta.env?.DEV) {
    console.warn(`[GlossaryTooltip] No glossary entry found for id=${id}`);
  }
} else if (term != null && term !== "") {
  entry = glossary.find((e) => e.active === true && matchesTerm(e?.english ?? "", term));
  if (!entry && typeof console !== "undefined" && import.meta.env?.DEV) {
    console.warn(`[GlossaryTooltip] No glossary entry found for term="${term}"`);
  }
}

const tooltipText = entry?.example ? truncate(htmlToText(entry.example)) : "";
const hasSlot = Astro.slots.has("default");

const visibleText = hasSlot
  ? undefined
  : entry
    ? stripHtml(entry.english ?? "")
    : (term ?? "").trim();

/** localStorage key; only when we have a stable id from the matched entry */
const storageKey =
  entry != null && typeof entry.glossaryId === "number" ? `glossary-seen-${entry.glossaryId}` : null;

const enableAutoOnce = Boolean(autoOpenOnce && storageKey);
const hasPopup = Boolean(entry);
const titlePlain = entry ? stripHtml(entry.english ?? "") : "";
const cleanHtml = entry ? buildGlossaryContentHtml(entry) : "";

const rootId = `gt-${randomUUID()}`;
const titleId = `gt-title-${randomUUID()}`;
---

{
  hasPopup ? (
    <span
      class="glossary-tooltip-wrap"
      id={rootId}
      data-glossary-ls-key={storageKey ?? undefined}
      data-glossary-auto-once={enableAutoOnce ? "true" : undefined}
    >
      <button
        type="button"
        class:list={["glossary-tooltip", "glossary-tooltip-trigger"]}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls={`${rootId}-popup`}
      >
        <span class="glossary-tooltip-label">
          {hasSlot ? <slot /> : visibleText}
          <sup class="glossary-tooltip-icon" aria-hidden="true">
            ?
          </sup>
        </span>
      </button>

      <div class="glossary-mobile-scrim" data-glossary-mobile-scrim aria-hidden="true" />

      <div
        class="glossary-popup"
        id={`${rootId}-popup`}
        role="dialog"
        aria-modal="false"
        aria-labelledby={titleId}
        hidden
        data-glossary-popup
      >
        <h2 class="glossary-popup-sr-title" id={titleId}>
          {titlePlain}
        </h2>
        <button type="button" class="glossary-close" data-glossary-close aria-label="Close">
          ×
        </button>
        <div class="glossary-content" set:html={cleanHtml} />
      </div>
    </span>
  ) : (
    <span class:list={["glossary-tooltip-fallback", "glossary-tooltip", tooltipText && "kbm-tooltip"]} {...(tooltipText ? { "data-tip": tooltipText } : {})}>
      {hasSlot ? <slot /> : visibleText}
    </span>
  )
}

{hasPopup && (
  <script is:inline define:vars={{ rootId }}>
    (function () {
      var w = window;
      if (!w.__kbmGlossaryApi) {
        w.__kbmGlossaryApi = {
          closeAll: function () {
            document.querySelectorAll(".glossary-tooltip-wrap").forEach(function (wrap) {
              var p = wrap.querySelector("[data-glossary-popup]");
              var b = wrap.querySelector(".glossary-tooltip-trigger");
              if (p instanceof HTMLElement) p.setAttribute("hidden", "");
              if (b instanceof HTMLElement) b.setAttribute("aria-expanded", "false");
              wrap.classList.remove("glossary-tooltip-wrap--open");
            });
          },
          ensureGlobalListeners: function () {
            if (w.__kbmGlossaryGlobalsBound) return;
            w.__kbmGlossaryGlobalsBound = true;
            document.addEventListener(
              "pointerdown",
              function (e) {
                var t = e.target;
                if (!(t instanceof Element)) return;
                if (t.closest(".glossary-tooltip-wrap")) return;
                w.__kbmGlossaryApi.closeAll();
              },
              true
            );
            document.addEventListener("keydown", function (e) {
              if (e.key !== "Escape") return;
              if (!document.querySelector(".glossary-tooltip-wrap--open")) return;
              e.preventDefault();
              w.__kbmGlossaryApi.closeAll();
            });
          },
        };
      }
      w.__kbmGlossaryApi.ensureGlobalListeners();

      var root = document.getElementById(rootId);
      if (!root) return;
      var btn = root.querySelector(".glossary-tooltip-trigger");
      var popup = root.querySelector("[data-glossary-popup]");
      if (!btn || !popup || !(btn instanceof HTMLButtonElement) || !(popup instanceof HTMLElement)) return;

      var lsKey = root.getAttribute("data-glossary-ls-key") || "";
      var autoOnce = root.getAttribute("data-glossary-auto-once") === "true";
      var api = w.__kbmGlossaryApi;

      function markSeen() {
        if (!autoOnce || !lsKey) return;
        try {
          localStorage.setItem(lsKey, "1");
        } catch (e) {}
      }

      function isSeen() {
        if (!lsKey) return true;
        try {
          return localStorage.getItem(lsKey) === "1";
        } catch (e) {
          return true;
        }
      }

      function isOpen() {
        return !popup.hasAttribute("hidden");
      }

      function setExpanded(open) {
        btn.setAttribute("aria-expanded", open ? "true" : "false");
        root.classList.toggle("glossary-tooltip-wrap--open", open);
      }

      function openPopup() {
        api.closeAll();
        popup.removeAttribute("hidden");
        setExpanded(true);
        markSeen();
        requestAnimationFrame(function () {
          var closeBtn = popup.querySelector("[data-glossary-close]");
          if (closeBtn instanceof HTMLElement) closeBtn.focus();
        });
      }

      function closePopup() {
        popup.setAttribute("hidden", "");
        setExpanded(false);
        btn.focus();
      }

      function togglePopup() {
        if (isOpen()) closePopup();
        else openPopup();
      }

      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        togglePopup();
      });

      var closeBtn = popup.querySelector("[data-glossary-close]");
      closeBtn &&
        closeBtn.addEventListener("click", function (e) {
          e.stopPropagation();
          e.preventDefault();
          closePopup();
        });

      var scrim = root.querySelector("[data-glossary-mobile-scrim]");
      scrim &&
        scrim.addEventListener("click", function () {
          closePopup();
        });

      if (autoOnce && lsKey && !isSeen()) {
        requestAnimationFrame(function () {
          if (!root.isConnected || isOpen()) return;
          if (isSeen()) return;
          openPopup();
        });
      }
    })();
  </script>
)}

<style>
  .glossary-tooltip-wrap {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  /* Popups are position:absolute; avoid clipping inside pattern cards with implicit overflow. */
  :global(.pattern-card:has(.glossary-tooltip-wrap--open)) {
    overflow: visible;
  }

  .glossary-tooltip-wrap--open {
    z-index: 10020;
    isolation: isolate;
  }

  .glossary-tooltip {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-decoration: underline dotted;
    text-underline-offset: 3px;
  }

  .glossary-tooltip:hover,
  .glossary-tooltip:focus-visible {
    text-decoration-thickness: 2px;
  }

  .glossary-tooltip:focus-visible {
    outline: 2px solid rgba(82, 104, 45, 0.35);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .glossary-tooltip-label {
    display: inline;
  }

  .glossary-tooltip-icon {
    font-size: 0.7em;
    margin-left: 2px;
    opacity: 0.6;
    font-weight: inherit;
    line-height: 0;
  }

  .glossary-tooltip-fallback {
    text-decoration: underline dotted;
    text-underline-offset: 3px;
    cursor: default;
  }

  .glossary-popup {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 10050;
    width: min(420px, 85vw);
    max-height: min(70vh, 520px);
    display: flex;
    flex-direction: column;
    background: #fff;
    color: #1f2937;
    border-radius: 10px;
    padding: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    box-sizing: border-box;
    pointer-events: auto;
  }

  .glossary-popup[hidden] {
    display: none !important;
  }

  .glossary-popup-sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .glossary-close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 2rem;
    height: 2rem;
    margin: 0;
    border: none;
    border-radius: 8px;
    background: #f3f4f6;
    color: #374151;
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    flex-shrink: 0;
    z-index: 10;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  .glossary-close:hover {
    background: #e5e7eb;
  }

  .glossary-close:focus-visible {
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }

  .glossary-content {
    font-size: 0.95rem;
    line-height: 1.55;
    overflow-y: auto;
    min-height: 0;
    flex: 1 1 auto;
    padding-right: 2.25rem;
  }

  .glossary-content :global(img) {
    max-width: 100%;
    height: auto;
  }

  .glossary-content .glossary-popup-figure {
    margin: 0.75rem 0 0;
  }

  .glossary-content .glossary-popup-help {
    margin-top: 0.75rem;
  }

  .glossary-content .glossary-popup-help :global(p:first-child) {
    margin-top: 0;
  }

  .glossary-content :global(.glossary-popup-extra-help) {
    margin: 1rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(17, 24, 39, 0.1);
  }

  .glossary-content :global(.glossary-popup-extra-help .kbm-kin-catalog-video) {
    display: inline;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 500;
    color: #52682d;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-align: left;
  }

  .glossary-content :global(.glossary-popup-extra-help .kbm-kin-catalog-video:hover),
  .glossary-content :global(.glossary-popup-extra-help .kbm-kin-catalog-video:focus-visible) {
    color: #3d4f22;
    outline: none;
  }

  .glossary-content :global(.glossary-popup-extra-help .kbm-kin-catalog-video:focus-visible) {
    outline: 2px solid #52682d;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .glossary-content :global(.glossary-related-videos) {
    margin: 0.85rem 0 0;
    padding: 0.65rem 0.7rem;
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.03);
    border: 1px solid rgba(17, 24, 39, 0.08);
  }

  .glossary-content :global(.glossary-related-videos__title) {
    margin: 0 0 0.45rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #52682d;
  }

  .glossary-content :global(.glossary-related-videos__list) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .glossary-content :global(.glossary-related-videos__item) {
    margin: 0;
    padding: 0;
  }

  .glossary-content :global(.glossary-related-videos__btn) {
    display: inline-flex;
    width: 100%;
    text-align: left;
    align-items: center;
    padding: 0.45rem 0.55rem;
    border-radius: 8px;
    border: 1px solid rgba(82, 104, 45, 0.35);
    background: rgba(82, 104, 45, 0.08);
    color: #3d4f22;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .glossary-content :global(.glossary-related-videos__btn:hover),
  .glossary-content :global(.glossary-related-videos__btn:focus-visible) {
    background: rgba(82, 104, 45, 0.14);
    outline: none;
  }

  .glossary-content :global(.glossary-related-videos__btn:focus-visible) {
    outline: 2px solid rgba(82, 104, 45, 0.45);
    outline-offset: 2px;
  }

  .glossary-content :global(.glossary-related-videos__link) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.45rem;
    width: 100%;
    padding: 0.45rem 0.55rem;
    border-radius: 8px;
    border: 1px solid rgba(17, 24, 39, 0.1);
    background: rgba(255, 255, 255, 0.9);
    color: #1f2937;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    box-sizing: border-box;
  }

  .glossary-content :global(.glossary-related-videos__link--member) {
    border-style: dashed;
  }

  .glossary-content :global(.glossary-related-videos__link:hover),
  .glossary-content :global(.glossary-related-videos__link:focus-visible) {
    background: rgba(82, 104, 45, 0.08);
    outline: none;
  }

  .glossary-content :global(.glossary-related-videos__badge) {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6b7280;
  }

  .glossary-content :global(.glossary-related-tools) {
    margin-top: 1rem;
    padding: 0.85rem 0.95rem;
    border-radius: 10px;
    background: rgba(82, 104, 45, 0.06);
    border: 1px solid rgba(82, 104, 45, 0.15);
  }

  .glossary-content :global(.glossary-related-tools__heading) {
    margin: 0 0 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #52682d;
  }

  .glossary-content :global(.glossary-related-tools__list) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .glossary-content :global(.glossary-related-tools__link) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.45rem;
    border-radius: 8px;
    text-decoration: none;
    color: #1f2937;
    font-weight: 600;
    font-size: 0.92rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .glossary-content :global(.glossary-related-tools__link:hover),
  .glossary-content :global(.glossary-related-tools__link:focus-visible) {
    background: rgba(82, 104, 45, 0.12);
    color: #52682d;
    outline: none;
  }

  .glossary-content :global(.glossary-related-tools__icon) {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    object-fit: contain;
  }

  .glossary-mobile-scrim {
    display: none;
  }

  @media (max-width: 640px) {
    .glossary-tooltip-wrap--open .glossary-mobile-scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 10040;
      background: rgba(17, 24, 39, 0.35);
      cursor: pointer;
    }

    .glossary-tooltip-wrap .glossary-popup {
      position: fixed;
      left: 50%;
      top: 50%;
      right: auto;
      bottom: auto;
      transform: translate(-50%, -50%);
      width: min(420px, 85vw);
      max-height: min(75vh, 560px);
      z-index: 10050;
    }
  }
</style>
