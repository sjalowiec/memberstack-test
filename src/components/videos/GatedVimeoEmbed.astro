---
/**
 * GatedVimeoEmbed.astro
 * - If access_level === "open": render iframe for everyone.
 * - If access_level === "member": iframe when member has active basic or premium plan (window.kbmHasKinVideoAccess).
 * - When PUBLIC_DEV_BYPASS_GATING=true on the Astro dev server, member videos show without login.
 */
import { videoDevBypass } from "../../lib/devBypass";

const {
  videoId: rawVideoId,
  title = "Video",
  access_level: rawAccessLevel = "open", // "open" | "member" | "public" | "free"
  aspect = "16/9",
  thumbUrl = "", // optional: show a thumbnail for locked state
  ctaHref = "/membership",
  ctaText = "Join to watch",
  /** When true, iframe uses Vimeo Player.js (`api=1`) and a stable `id` for programmatic seek. */
  enableVimeoPlayerApi = false,
} = Astro.props;

// Coerce the Vimeo ID to a trimmed string (JSON may store it as a number).
const videoId = rawVideoId != null ? String(rawVideoId).trim() : "";

// Normalize access level so gating only ever deals with "open" | "member".
// Public synonyms ("public", "free", "open") all mean "show to everyone".
const normalizedAccess = String(rawAccessLevel).trim().toLowerCase();
const access_level =
  normalizedAccess === "open" || normalizedAccess === "public" || normalizedAccess === "free"
    ? "open"
    : "member";

function paddingPercent(aspectStr: string) {
  // "16/9" -> 56.25
  const [w, h] = String(aspectStr).split("/").map(Number);
  if (!w || !h) return 56.25;
  return (h / w) * 100;
}

const pad = paddingPercent(aspect);
const iframePlayerId = `kbm-gated-vimeo-${videoId}`;
const iframeBase = `https://player.vimeo.com/video/${videoId}`;
const iframeSrc = enableVimeoPlayerApi
  ? `${iframeBase}?api=1&player_id=${encodeURIComponent(iframePlayerId)}`
  : iframeBase;
---

<div
  class="kbm-video"
  data-access-level={access_level}
  data-video-id={videoId}
  data-iframe-src={iframeSrc}
  data-video-title={title}
  data-video-dev-bypass={videoDevBypass ? "true" : "false"}
  data-enable-vimeo-player-api={enableVimeoPlayerApi ? "true" : "false"}
  data-cta-href={ctaHref}
  data-cta-text={ctaText}
>
  <div class="kbm-video__frame" style={`padding-top:${pad}%;`}>
    <div
      id={`kbm-vimeo-slot-${videoId}`}
      data-access-level={access_level}
      data-state={access_level === "member" ? "loading" : "ready"}
    >
      {access_level === "open" ? (
        <iframe
          class="kbm-video__iframe"
          id={enableVimeoPlayerApi ? iframePlayerId : undefined}
          src={iframeSrc}
          title={title}
          loading="lazy"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        />
      ) : (
        <div class="kbm-video__loading" aria-hidden="true"></div>
      )}
    </div>
  </div>
</div>

<script>
  import { runGatedVimeoEmbedBoot } from "../../scripts/gatedVimeoEmbedClient";

  runGatedVimeoEmbedBoot();
</script>



<style>
  .kbm-video__frame [data-state="loading"] {
    position: absolute;
    inset: 0;
    background: #f3f4ef;
  }
  .kbm-video__loading {
    position: absolute;
    inset: 0;
    background: #f3f4ef;
  }
  .kbm-video__frame{
    position: relative;
    width: 100%;
    height: 0;
    overflow: hidden;
    border-radius: 14px;
    background: #fff;
  }
  .kbm-video__frame > [data-access-level] {
    position: absolute;
    inset: 0;
  }
  .kbm-video__iframe{
    position:absolute;
    top:0; left:0;
    width:100%;
    height:100%;
    border:0;
  }
  .kbm-video__locked{
    position:absolute;
    inset:0;
    display:block;
    background:#fff;
  }
  .kbm-video__thumb{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    filter: blur(0px);
  }
  .kbm-video__overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    padding:16px;
    text-align:center;
    background: rgba(255,255,255,0.86);
    gap:10px;
  }
  .kbm-video__lockline{
    display:flex;
    gap:8px;
    align-items:center;
    font-size: 1.05rem;
  }
  .kbm-video__msg{
    margin:0;
    max-width: 42ch;
  }
  .kbm-video__actions{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    justify-content:center;
    align-items:center;
  }
  .kbm-video__cta{
    display:inline-block;
    padding:10px 14px;
    border-radius: 999px;
    text-decoration:none;
    font-weight:700;
    background: var(--kbm-green, #52682d);
    color:#fff;
  }
  .kbm-video__cta--login{
    background:#fff;
    color: var(--kbm-green, #52682d);
    border: 2px solid var(--kbm-green, #52682d);
    cursor: pointer;
    font: inherit;
  }
  .kbm-video__cta--login:hover{
    background: rgba(82, 104, 45, 0.08);
  }
</style>