---
/**
 * GatedVimeoEmbed.astro
 * - If access_level is public/open/free (or the featured tip): render iframe for everyone.
 * - If access_level is member: do not put the Vimeo URL or player on the page.
 *   The client confirms hasMemberAccess, then loads the embed URL from
 *   `/.netlify/functions/catalog-video-embed`.
 */
import { videoDevBypass } from "../../lib/devBypass";
import { catalogVideoPlaybackAccess } from "../../lib/videos/catalogVideoPlaybackAccess";
import { gatedVimeoEmbedDelivery } from "../../lib/videos/gatedVimeoEmbedDelivery";

const {
  videoId: rawVideoId,
  contentId: rawContentId = "",
  title = "Video",
  access_level: rawAccessLevel = "member",
  aspect = "16/9",
  thumbUrl = "",
  ctaHref = "/membership",
  ctaText = "Become a Member",
  enableVimeoPlayerApi = false,
  privacyHash: rawPrivacyHash = "",
} = Astro.props;

const videoId = rawVideoId != null ? String(rawVideoId).trim() : "";
const contentId = rawContentId != null ? String(rawContentId).trim() : "";
const privacyHash = String(rawPrivacyHash ?? "").trim();
const access_level = catalogVideoPlaybackAccess({
  access_level: rawAccessLevel,
});
const iframePlayerId = videoId ? `kbm-gated-vimeo-${videoId}` : contentId ? `kbm-gated-vimeo-${contentId}` : "";
const delivery = gatedVimeoEmbedDelivery({
  accessLevel: access_level,
  videoId,
  contentId,
  privacyHash,
  enableVimeoPlayerApi,
  iframePlayerId,
  videoDevBypass,
});

function paddingPercent(aspectStr: string) {
  const [w, h] = String(aspectStr).split("/").map(Number);
  if (!w || !h) return 56.25;
  return (h / w) * 100;
}

const pad = paddingPercent(aspect);
---

<div
  class="kbm-video"
  data-access-level={delivery.accessLevel}
  data-content-id={delivery.contentIdAttr ?? undefined}
  data-video-id={delivery.videoIdAttr ?? undefined}
  data-iframe-src={delivery.iframeSrcAttr ?? undefined}
  data-video-title={title}
  data-video-dev-bypass={videoDevBypass ? "true" : "false"}
  data-enable-vimeo-player-api={enableVimeoPlayerApi ? "true" : "false"}
  data-cta-href={ctaHref}
  data-cta-text={ctaText}
>
  <div class="kbm-video__frame" style={`padding-top:${pad}%;`}>
    <div
      id={`kbm-vimeo-slot-${contentId || videoId}`}
      data-access-level={delivery.accessLevel}
      data-state={delivery.renderIframe ? "ready" : "loading"}
    >
      {delivery.renderIframe ? (
        <iframe
          class="kbm-video__iframe"
          id={enableVimeoPlayerApi ? iframePlayerId : undefined}
          src={delivery.iframeSrc}
          title={title}
          loading="lazy"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        />
      ) : (
        <div class="kbm-video__loading" aria-hidden="true"></div>
      )}
    </div>
  </div>
</div>

<script>
  import { runGatedVimeoEmbedBoot } from "../../scripts/gatedVimeoEmbedClient";

  runGatedVimeoEmbedBoot();
</script>



<style>
  .kbm-video__frame [data-state="loading"] {
    position: absolute;
    inset: 0;
    background: #f3f4ef;
  }
  .kbm-video__loading {
    position: absolute;
    inset: 0;
    background: #f3f4ef;
  }
  .kbm-video__frame{
    position: relative;
    width: 100%;
    height: 0;
    overflow: hidden;
    border-radius: 14px;
    background: #fff;
  }
  .kbm-video__frame > [data-access-level] {
    position: absolute;
    inset: 0;
  }
  .kbm-video__iframe{
    position:absolute;
    top:0; left:0;
    width:100%;
    height:100%;
    border:0;
  }
  .kbm-video__locked{
    position:absolute;
    inset:0;
    display:block;
    background:#fff;
  }
  .kbm-video__thumb{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    filter: blur(0px);
  }
  .kbm-video__overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    padding:16px;
    text-align:center;
    background: rgba(255,255,255,0.86);
    gap:10px;
  }
  .kbm-video__lockline{
    display:flex;
    gap:8px;
    align-items:center;
    font-size: 1.05rem;
  }
  .kbm-video__msg{
    margin:0;
    max-width: 42ch;
  }
  .kbm-video__actions{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    justify-content:center;
    align-items:center;
  }
  .kbm-video__cta{
    display:inline-block;
    padding:10px 14px;
    border-radius: 999px;
    text-decoration:none;
    font-weight:700;
    background: var(--kbm-green, #52682d);
    color:#fff;
  }
  .kbm-video__cta--login{
    background:#fff;
    color: var(--kbm-green, #52682d);
    border: 2px solid var(--kbm-green, #52682d);
    cursor: pointer;
    font: inherit;
  }
  .kbm-video__cta--login:hover{
    background: rgba(82, 104, 45, 0.08);
  }
</style>
