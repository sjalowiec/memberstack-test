---
/**
 * GatedVimeoEmbed.astro
 * - If access_level is public/open/free (or the featured tip): render iframe for everyone.
 * - If access_level is member: do not put the Vimeo URL or player on the page.
 *   The client confirms hasMemberAccess, then loads the embed URL from
 *   `/.netlify/functions/catalog-video-embed`.
 */
import { videoDevBypass } from "../../lib/devBypass";
import { catalogVideoPlaybackAccess } from "../../lib/videos/catalogVideoPlaybackAccess";
import { gatedVimeoEmbedDelivery } from "../../lib/videos/gatedVimeoEmbedDelivery";
import { catalogVimeoIframePlayerId } from "../../lib/videos/catalogVideoEmbedSrc";
import { lockedVideoPanelHtml, permittedCatalogThumbnailUrl } from "../../lib/videos/lockedVideoPanel";

const {
  videoId: rawVideoId,
  contentId: rawContentId = "",
  title = "Video",
  access_level: rawAccessLevel = "member",
  aspect = "16/9",
  thumbUrl = "",
  ctaHref = "/membership",
  ctaText = "Become a Member",
  enableVimeoPlayerApi = false,
  privacyHash: rawPrivacyHash = "",
} = Astro.props;

const videoId = rawVideoId != null ? String(rawVideoId).trim() : "";
const contentId = rawContentId != null ? String(rawContentId).trim() : "";
const privacyHash = String(rawPrivacyHash ?? "").trim();
const access_level = catalogVideoPlaybackAccess({
  access_level: rawAccessLevel,
});
const iframePlayerId = catalogVimeoIframePlayerId(videoId, contentId);
const delivery = gatedVimeoEmbedDelivery({
  accessLevel: access_level,
  videoId,
  contentId,
  privacyHash,
  enableVimeoPlayerApi,
  iframePlayerId,
  videoDevBypass,
});

function paddingPercent(aspectStr: string) {
  const [w, h] = String(aspectStr).split("/").map(Number);
  if (!w || !h) return 56.25;
  return (h / w) * 100;
}

const pad = paddingPercent(aspect);
const safeThumbUrl = permittedCatalogThumbnailUrl(thumbUrl);
const deniedPanelHtml = delivery.renderIframe
  ? ""
  : lockedVideoPanelHtml({
      thumbUrl: safeThumbUrl,
      showLogin: true,
      ctaHref,
      ctaText,
    });
---

<div
  class="kbm-video"
  data-access-level={delivery.accessLevel}
  data-content-id={delivery.contentIdAttr ?? undefined}
  data-video-id={delivery.videoIdAttr ?? undefined}
  data-iframe-src={delivery.iframeSrcAttr ?? undefined}
  data-video-title={title}
  data-video-dev-bypass={videoDevBypass ? "true" : "false"}
  data-enable-vimeo-player-api={enableVimeoPlayerApi ? "true" : "false"}
  data-cta-href={ctaHref}
  data-cta-text={ctaText}
  data-thumb-url={safeThumbUrl || undefined}
>
  <div class="kbm-video__frame" style={`padding-top:${pad}%;`}>
    <div
      id={`kbm-vimeo-slot-${contentId || videoId}`}
      data-access-level={delivery.accessLevel}
      data-state={delivery.renderIframe ? "ready" : "loading"}
    >
      {delivery.renderIframe ? (
        <iframe
          class="kbm-video__iframe"
          id={enableVimeoPlayerApi ? iframePlayerId : undefined}
          src={delivery.iframeSrc}
          title={title}
          loading="lazy"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        />
      ) : (
        <Fragment set:html={deniedPanelHtml} />
      )}
    </div>
  </div>
</div>

<script>
  import { runGatedVimeoEmbedBoot } from "../../scripts/gatedVimeoEmbedClient";

  runGatedVimeoEmbedBoot();
</script>



<style>
  .kbm-video__frame [data-state="loading"] {
    position: absolute;
    inset: 0;
    background: #f3f4ef;
  }
  .kbm-video__frame{
    position: relative;
    width: 100%;
    height: 0;
    overflow: hidden;
    border-radius: 14px;
    background: #fff;
  }
  .kbm-video__frame > [data-access-level] {
    position: absolute;
    inset: 0;
  }
  .kbm-video__iframe{
    position:absolute;
    top:0; left:0;
    width:100%;
    height:100%;
    border:0;
  }
  :global(.kbm-video__locked){
    position:absolute;
    inset:0;
    display:block;
    background:#f3f4ef;
    overflow:hidden;
  }
  :global(.kbm-video__thumb){
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
    display:block;
  }
  :global(.kbm-video__overlay){
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    justify-content:safe center;
    align-items:center;
    padding:16px;
    text-align:center;
    background: rgba(255,255,255,0.92);
    color:#1c2414;
    gap:10px;
  }
  :global(.kbm-video__locked--thumb .kbm-video__overlay){
    background: rgba(16, 22, 12, 0.72);
    color:#fff;
  }
  :global(.kbm-video__lockline){
    display:flex;
    gap:8px;
    align-items:center;
    font-size: 1.05rem;
  }
  :global(.kbm-video__msg){
    margin:0;
    max-width: 42ch;
  }
  :global(.kbm-video__actions){
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    justify-content:center;
    align-items:center;
    width:100%;
    max-width:22rem;
  }
  :global(.kbm-video__cta){
    appearance:none;
    -webkit-appearance:none;
    box-sizing:border-box;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:44px;
    padding:10px 16px;
    border-radius:999px;
    border:2px solid var(--kbm-green, #52682d);
    text-decoration:none;
    font-family:inherit;
    font-size:1rem;
    font-weight:700;
    line-height:1.2;
    cursor:pointer;
    background: var(--kbm-green, #52682d);
    color:#fff;
  }
  :global(.kbm-video__cta--login){
    background:#fff;
    color: var(--kbm-green, #52682d);
  }
  :global(.kbm-video__cta--login:hover){
    background: rgba(82, 104, 45, 0.08);
  }
  @media (max-width: 640px) {
    :global(.kbm-video__overlay){
      padding:4px 8px;
      gap:2px;
      overflow:auto;
    }
    :global(.kbm-video__lockline){
      font-size:0.875rem;
    }
    :global(.kbm-video__msg){
      font-size:0.8125rem;
      line-height:1.2;
    }
    :global(.kbm-video__actions){
      flex-direction:column;
      gap:4px;
    }
    :global(.kbm-video__cta){
      width:100%;
      min-height:44px;
      padding:8px 12px;
    }
  }
</style>
