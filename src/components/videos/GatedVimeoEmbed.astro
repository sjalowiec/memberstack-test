---
/**
 * GatedVimeoEmbed.astro
 * - If access_level === "open": render iframe for everyone.
 * - If access_level === "member": iframe when member has active basic or premium plan (window.kbmHasKinVideoAccess).
 * - When PUBLIC_DEV_BYPASS_GATING=true on the Astro dev server, member videos show without login.
 */
import { videoDevBypass } from "../../lib/devBypass";

const {
  videoId,
  title = "Video",
  access_level = "open", // "open" | "member"
  aspect = "16/9",
  thumbUrl = "", // optional: show a thumbnail for locked state
  ctaHref = "/membership",
  ctaText = "Join to watch",
  /** When true, iframe uses Vimeo Player.js (`api=1`) and a stable `id` for programmatic seek. */
  enableVimeoPlayerApi = false,
} = Astro.props;

function paddingPercent(aspectStr: string) {
  // "16/9" -> 56.25
  const [w, h] = String(aspectStr).split("/").map(Number);
  if (!w || !h) return 56.25;
  return (h / w) * 100;
}

const pad = paddingPercent(aspect);
const iframePlayerId = `kbm-gated-vimeo-${videoId}`;
const iframeBase = `https://player.vimeo.com/video/${videoId}`;
const iframeSrc = enableVimeoPlayerApi
  ? `${iframeBase}?api=1&player_id=${encodeURIComponent(iframePlayerId)}`
  : iframeBase;
---

<div
  class="kbm-video"
  data-access-level={access_level}
  data-video-id={videoId}
  data-iframe-src={iframeSrc}
>
  <div class="kbm-video__frame" style={`padding-top:${pad}%;`}>
    <div
      id={`kbm-vimeo-slot-${videoId}`}
      data-access-level={access_level}
      data-state={access_level === "member" ? "loading" : "ready"}
    >
      {access_level === "open" ? (
        <iframe
          class="kbm-video__iframe"
          id={enableVimeoPlayerApi ? iframePlayerId : undefined}
          src={iframeSrc}
          title={title}
          loading="lazy"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        />
      ) : (
        <div class="kbm-video__loading" aria-hidden="true"></div>
      )}
    </div>
  </div>
</div>

<script define:vars={{ videoId, access_level, iframeSrc, title, videoDevBypass, enableVimeoPlayerApi, iframePlayerId, ctaHref, ctaText }}>
  import { hasKinVideoAccess, logKinVideoAccessDebug } from "../../lib/kinVideoAccess";

  async function waitForMemberstackReady({ attempts = 30, delayMs = 200 } = {}) {
    for (let i = 0; i < attempts; i++) {
      try {
        const api = window.$memberstackDom?.getAppAndMember;
        if (typeof api === "function") return await api();
      } catch {
        /* keep polling until Memberstack is ready */
      }
      await new Promise((r) => setTimeout(r, delayMs));
    }
    return null;
  }

  document.addEventListener("DOMContentLoaded", () => {
    if (access_level !== "member") return;

    const slot = document.getElementById(`kbm-vimeo-slot-${videoId}`);
    if (!slot) return;

    const iframeIdAttr =
      enableVimeoPlayerApi && iframePlayerId ? ` id="${iframePlayerId}"` : "";
    let authListenersBound = false;

    function buildLockedMarkup(showLogin) {
      const loginBtn = showLogin
        ? `<button type="button" class="kbm-video__cta kbm-video__cta--login" data-kbm-video-login>Log in to watch</button>`
        : "";
      return `
  <div class="kbm-video__locked">
    <div class="kbm-video__overlay">
      <div class="kbm-video__lockline">
        🔒 <strong>Members only</strong>
      </div>
      <p>This video is available with membership.</p>
      <div class="kbm-video__actions">
        ${loginBtn}
        <a href="${ctaHref}" class="kbm-video__cta">${ctaText}</a>
      </div>
    </div>
  </div>
`;
    }

    function wireVideoLoginButton() {
      const btn = slot.querySelector("[data-kbm-video-login]");
      if (!(btn instanceof HTMLElement)) return;
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        if (typeof window.kbmOpenMemberstackLoginModal === "function") {
          window.kbmOpenMemberstackLoginModal();
          return;
        }
        const ms = window.$memberstackDom;
        if (ms && typeof ms.openModal === "function") {
          void ms.openModal("LOGIN");
        }
      });
    }

    function showLocked(showLogin) {
      slot.innerHTML = buildLockedMarkup(showLogin);
      if (showLogin) wireVideoLoginButton();
      slot.setAttribute("data-state", "ready");
    }

    function showUnlockedIframe() {
      slot.innerHTML = `
        <iframe${iframeIdAttr}
          src="${iframeSrc}"
          title="${title}"
          loading="lazy"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          style="position:absolute; inset:0; width:100%; height:100%; border:0;"
        ></iframe>
      `;
      slot.setAttribute("data-state", "ready");
    }

    async function resolveAccessAndRender() {
      if (videoDevBypass) {
        console.log("[KBM video access debug]", "GatedVimeoEmbed.unlock", {
          videoId,
          reason: "videoDevBypass(PUBLIC_DEV_BYPASS_GATING=true)",
        });
        showUnlockedIframe();
        return;
      }

      const res = await waitForMemberstackReady();
      const member = res?.data?.member ?? null;
      const isLoggedIn = Boolean(member);
      const rawKinAccess = member?.customFields?.["kin-access"];
      const hasVideoAccess = res ? hasKinVideoAccess(res) : false;

      logKinVideoAccessDebug("GatedVimeoEmbed.iframe", {
        member: res,
        rawKinAccess,
        finalHasVideoAccess: hasVideoAccess,
      });

      if (!hasVideoAccess) {
        showLocked(!isLoggedIn);
        return;
      }

      showUnlockedIframe();
    }

    function bindMemberstackAuthRefresh() {
      if (authListenersBound) return;
      const ms = window.$memberstackDom;
      if (!ms || typeof ms.on !== "function") return;
      authListenersBound = true;
      ms.on("member.login", () => {
        void resolveAccessAndRender();
      });
      ms.on("member.logout", () => {
        void resolveAccessAndRender();
      });
    }

    async function initGatedVideo() {
      await resolveAccessAndRender();

      bindMemberstackAuthRefresh();
      void window.$memberstackDom?.onReady?.then(() => {
        bindMemberstackAuthRefresh();
      });

      window.addEventListener("auth:updated", () => {
        void resolveAccessAndRender();
      });
    }

    void initGatedVideo();
  });
</script>



<style>
  .kbm-video__frame [data-state="loading"] {
    position: absolute;
    inset: 0;
    background: #f3f4ef;
  }
  .kbm-video__loading {
    position: absolute;
    inset: 0;
    background: #f3f4ef;
  }
  .kbm-video__frame{
    position: relative;
    width: 100%;
    height: 0;
    overflow: hidden;
    border-radius: 14px;
    background: #fff;
  }
  .kbm-video__frame > [data-access-level] {
    position: absolute;
    inset: 0;
  }
  .kbm-video__iframe{
    position:absolute;
    top:0; left:0;
    width:100%;
    height:100%;
    border:0;
  }
  .kbm-video__locked{
    position:absolute;
    inset:0;
    display:block;
    background:#fff;
  }
  .kbm-video__thumb{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    filter: blur(0px);
  }
  .kbm-video__overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    padding:16px;
    text-align:center;
    background: rgba(255,255,255,0.86);
    gap:10px;
  }
  .kbm-video__lockline{
    display:flex;
    gap:8px;
    align-items:center;
    font-size: 1.05rem;
  }
  .kbm-video__msg{
    margin:0;
    max-width: 42ch;
  }
  .kbm-video__actions{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    justify-content:center;
    align-items:center;
  }
  .kbm-video__cta{
    display:inline-block;
    padding:10px 14px;
    border-radius: 999px;
    text-decoration:none;
    font-weight:700;
    background: var(--kbm-green, #52682d);
    color:#fff;
  }
  .kbm-video__cta--login{
    background:#fff;
    color: var(--kbm-green, #52682d);
    border: 2px solid var(--kbm-green, #52682d);
    cursor: pointer;
    font: inherit;
  }
  .kbm-video__cta--login:hover{
    background: rgba(82, 104, 45, 0.08);
  }
</style>