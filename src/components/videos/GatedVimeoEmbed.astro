---
/**
 * GatedVimeoEmbed.astro
 * - If access_level === "open": render iframe for everyone.
 * - If access_level === "member": iframe when logged in and kin-access is not false/"false" (see window.kbmHasKinVideoAccess).
 * - When dev bypass is on (localhost + PUBLIC_DEV_BYPASS_GATING=true), member videos show without login.
 */
import { devBypass } from "../../lib/devBypass";

const {
  videoId,
  title = "Video",
  access_level = "open", // "open" | "member"
  aspect = "16/9",
  thumbUrl = "", // optional: show a thumbnail for locked state
  ctaHref = "/membership",
  ctaText = "Join to watch",
  /** When true, iframe uses Vimeo Player.js (`api=1`) and a stable `id` for programmatic seek. */
  enableVimeoPlayerApi = false,
} = Astro.props;

function paddingPercent(aspectStr: string) {
  // "16/9" -> 56.25
  const [w, h] = String(aspectStr).split("/").map(Number);
  if (!w || !h) return 56.25;
  return (h / w) * 100;
}

const pad = paddingPercent(aspect);
const iframePlayerId = `kbm-gated-vimeo-${videoId}`;
const iframeBase = `https://player.vimeo.com/video/${videoId}`;
const iframeSrc = enableVimeoPlayerApi
  ? `${iframeBase}?api=1&player_id=${encodeURIComponent(iframePlayerId)}`
  : iframeBase;
---

<div
  class="kbm-video"
  data-access-level={access_level}
  data-video-id={videoId}
  data-iframe-src={iframeSrc}
>
  <div class="kbm-video__frame" style={`padding-top:${pad}%;`}>
    <div
      id={`kbm-vimeo-slot-${videoId}`}
      data-access-level={access_level}
      data-state={access_level === "member" ? "loading" : "ready"}
    >
      {access_level === "open" ? (
        <iframe
          class="kbm-video__iframe"
          id={enableVimeoPlayerApi ? iframePlayerId : undefined}
          src={iframeSrc}
          title={title}
          loading="lazy"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        />
      ) : (
        <div class="kbm-video__loading" aria-hidden="true"></div>
      )}
    </div>
  </div>
</div>

<script is:inline define:vars={{ videoId, access_level, iframeSrc, title, devBypass, enableVimeoPlayerApi, iframePlayerId }}>
  document.addEventListener("DOMContentLoaded", async () => {
    if (access_level !== "member") return;

    const slot = document.getElementById(`kbm-vimeo-slot-${videoId}`);
    if (!slot) return;

    const iframeIdAttr =
      enableVimeoPlayerApi && iframePlayerId ? ` id="${iframePlayerId}"` : "";

    const lockedMarkup = `
  <div class="kbm-video__locked">
    <div class="kbm-video__overlay">
      <div class="kbm-video__lockline">
        🔒 <strong>Members only</strong>
      </div>
      <p>This video is available with membership.</p>
      <a href="/membership" class="kbm-video__cta">
        Join to watch
      </a>
    </div>
  </div>
`;

    /* Dev-only: env bypass or localhost ?member=true (window.__KBM_DEV_MEMBER__ in BaseLayout). */
    if (devBypass || window.__KBM_DEV_MEMBER__ === true) {
      console.log("[KBM video access debug]", "GatedVimeoEmbed.unlock", {
        videoId,
        reason: devBypass ? "devBypass(PUBLIC_DEV_BYPASS_GATING)" : "__KBM_DEV_MEMBER__(localhost?member=true)",
      });
      slot.innerHTML = `
        <iframe${iframeIdAttr}
          src="${iframeSrc}"
          title="${title}"
          loading="lazy"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          style="position:absolute; inset:0; width:100%; height:100%; border:0;"
        ></iframe>
      `;
      slot.setAttribute("data-state", "ready");
      return;
    }

    if (!window.$memberstackDom) {
      slot.innerHTML = lockedMarkup;
      slot.setAttribute("data-state", "ready");
      return;
    }

    try {
      const { data: member } = await window.$memberstackDom.getCurrentMember();
      if (!member) {
        slot.innerHTML = lockedMarkup;
        slot.setAttribute("data-state", "ready");
        return;
      }

      const rawKinAccess = member.customFields?.["kin-access"];
      const hasVideoAccess =
        typeof window.kbmHasKinVideoAccess === "function"
          ? window.kbmHasKinVideoAccess(rawKinAccess)
          : String(rawKinAccess ?? "").trim().toLowerCase() !== "false";

      window.kbmLogKinVideoAccessDebug?.("GatedVimeoEmbed.iframe", {
        member,
        rawKinAccess,
        finalHasVideoAccess: hasVideoAccess,
      });

      if (!hasVideoAccess) {
        slot.innerHTML = lockedMarkup;
        slot.setAttribute("data-state", "ready");
        return;
      }

      slot.innerHTML = `
        <iframe${iframeIdAttr}
          src="${iframeSrc}"
          title="${title}"
          loading="lazy"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          style="position:absolute; inset:0; width:100%; height:100%; border:0;"
        ></iframe>
      `;
      slot.setAttribute("data-state", "ready");
    } catch (e) {
      console.error("GatedVimeoEmbed MemberStack getCurrentMember failed:", e);
      slot.innerHTML = lockedMarkup;
      slot.setAttribute("data-state", "ready");
    }
  });
</script>



<style>
  .kbm-video__frame [data-state="loading"] {
    position: absolute;
    inset: 0;
    background: #f3f4ef;
  }
  .kbm-video__loading {
    position: absolute;
    inset: 0;
    background: #f3f4ef;
  }
  .kbm-video__frame{
    position: relative;
    width: 100%;
    height: 0;
    overflow: hidden;
    border-radius: 14px;
    background: #fff;
  }
  .kbm-video__frame > [data-access-level] {
    position: absolute;
    inset: 0;
  }
  .kbm-video__iframe{
    position:absolute;
    top:0; left:0;
    width:100%;
    height:100%;
    border:0;
  }
  .kbm-video__locked{
    position:absolute;
    inset:0;
    display:block;
    background:#fff;
  }
  .kbm-video__thumb{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    filter: blur(0px);
  }
  .kbm-video__overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    padding:16px;
    text-align:center;
    background: rgba(255,255,255,0.86);
    gap:10px;
  }
  .kbm-video__lockline{
    display:flex;
    gap:8px;
    align-items:center;
    font-size: 1.05rem;
  }
  .kbm-video__msg{
    margin:0;
    max-width: 42ch;
  }
  .kbm-video__cta{
    display:inline-block;
    padding:10px 14px;
    border-radius: 999px;
    text-decoration:none;
    font-weight:700;
    background: var(--kbm-green, #52682d);
    color:#fff;
  }
</style>