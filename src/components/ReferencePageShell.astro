---
import PageHead from "./PageHead.astro";

interface Props {
  title?: string;
  icon?: string;
  subhead?: string;
  breadcrumb?: string;
  meta?: string;
  backHref: string;
  backLabel: string;
  /** Match site main column (~1100px); default shell matches legacy .page-wrap max-width (860px). */
  wide?: boolean;
}

const {
  title,
  icon,
  subhead,
  breadcrumb,
  meta,
  backHref,
  backLabel,
  wide = false,
} = Astro.props;
---

<div class:list={["reference-shell", wide && "reference-shell--wide"]}>
  <div class="page-nav">
    <a class="page-nav__back" href={backHref}>
      ← {backLabel}
    </a>
  </div>

  <div class="page-wrap">
    {icon && title && (
      <h1 class="page-title reference-shell__title-row">
        <i class={`${icon} reference-shell__title-icon`} aria-hidden="true"></i>
        <span class="reference-shell__title-text">{title}</span>
      </h1>
    )}
    <PageHead
      title={title}
      subhead={subhead}
      breadcrumb={breadcrumb}
      meta={meta}
      hideTitle={!!icon}
    />

    <slot />
  </div>
</div>

<style>
  .reference-shell :global(.page-nav) {
    position: relative;
    z-index: 5;
    margin-top: 0;
    padding-top: 1px;
  }

  .reference-shell :global(.page-wrap) {
    padding-top: 0;
  }

  .reference-shell--wide :global(.page-wrap) {
    max-width: min(var(--max-content-width, 1100px), calc(100vw - 2rem));
  }

  .reference-shell :global(.page-head) {
    margin-top: 0;
    margin-bottom: 0.25rem;
    padding-top: 0;
  }

  .reference-shell :global(.page-title) {
    margin-top: 0;
  }

  .reference-shell__title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .reference-shell__title-icon {
    color: #52682d;
  }

  .reference-shell__title-text {
    white-space: pre-line;
  }
</style>
