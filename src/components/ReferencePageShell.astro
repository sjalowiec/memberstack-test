---
import PageHead from "./PageHead.astro";
import FavoriteStar from "./favorites/FavoriteStar.astro";
import FavoritesRuntime from "./favorites/FavoritesRuntime.astro";
import { normalizeFavoriteHref } from "../lib/favorites/favoriteHref";
import "../styles/favorites.css";

interface Props {
  title?: string;
  icon?: string;
  subhead?: string;
  breadcrumb?: string;
  meta?: string;
  backHref: string;
  backLabel: string;
  /** Match site main column (~1100px); default shell matches legacy .page-wrap max-width (860px). */
  wide?: boolean;
  /** When false, omit the favorite star (rare). Default true when a title is present. */
  enableFavorite?: boolean;
  /** Override path used as favorite content_id (defaults to current pathname). */
  favoriteContentId?: string;
}

const {
  title,
  icon,
  subhead,
  breadcrumb,
  meta,
  backHref,
  backLabel,
  wide = false,
  enableFavorite = true,
  favoriteContentId,
} = Astro.props;

const favoriteId =
  enableFavorite && title
    ? normalizeFavoriteHref(favoriteContentId ?? Astro.url.pathname)
    : null;
---

<div class:list={["reference-shell", wide && "reference-shell--wide"]}>
  <div class="page-nav">
    <a class="page-nav__back" href={backHref}>
      ← {backLabel}
    </a>
  </div>

  <div class="page-wrap">
    {icon && title && (
      <h1 class="page-title reference-shell__title-row favorite-title-row">
        <i class={`${icon} reference-shell__title-icon`} aria-hidden="true"></i>
        <span class="reference-shell__title-text">{title}</span>
        {favoriteId ? (
          <FavoriteStar contentType="reference" contentId={favoriteId} title={title} />
        ) : null}
      </h1>
    )}
    <PageHead
      title={title}
      subhead={subhead}
      breadcrumb={breadcrumb}
      meta={meta}
      hideTitle={!!icon}
    >
      {!icon && favoriteId && title ? (
        <FavoriteStar slot="after-title" contentType="reference" contentId={favoriteId} title={title} />
      ) : null}
    </PageHead>

    <slot />
  </div>
</div>
{favoriteId ? <FavoritesRuntime contentType="reference" /> : null}

<style>
  .reference-shell :global(.page-nav) {
    position: relative;
    z-index: 5;
    margin-top: 0;
    padding-top: 1px;
  }

  .reference-shell :global(.page-wrap) {
    padding-top: 0;
  }

  .reference-shell--wide :global(.page-wrap) {
    max-width: min(var(--max-content-width, 1100px), calc(100vw - 2rem));
  }

  .reference-shell :global(.page-head) {
    margin-top: 0;
    margin-bottom: 0.25rem;
    padding-top: 0;
  }

  .reference-shell :global(.page-title) {
    margin-top: 0;
  }

  .reference-shell__title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .reference-shell__title-icon {
    color: #52682d;
  }

  .reference-shell__title-text {
    white-space: pre-line;
    flex: 1 1 auto;
    min-width: 0;
  }
</style>
