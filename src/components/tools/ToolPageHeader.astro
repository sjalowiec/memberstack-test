---
/**
 * Tool page header: title + optional icon from tools JSON + favorite star.
 * Pass the tool object from the page (page looks up by pathname in tools JSON).
 */
import FavoriteStar from "../favorites/FavoriteStar.astro";
import FavoritesRuntime from "../favorites/FavoritesRuntime.astro";
import "../../styles/favorites.css";

interface Props {
  /** Tool entry from tools JSON (id, title, icon); when missing, fallbackTitle is used and no icon shown */
  tool?: { id?: number | string; title?: string; icon?: string } | null;
  /** Title used when tool is not provided or has no title */
  fallbackTitle?: string;
}

const { tool = null, fallbackTitle = "Tool" } = Astro.props;

const title = tool?.title ?? fallbackTitle;
const iconUrl = tool?.icon ? `/icons/tools/${tool.icon}` : null;
const contentId = tool?.id != null && String(tool.id).trim() ? String(tool.id).trim() : "";
---

<div class="tool-title favorite-title-row">
  {iconUrl && (
    <img src={iconUrl} alt="" class="tool-title-icon" />
  )}
  <h1>{title}</h1>
  {contentId ? (
    <FavoriteStar contentType="tool" contentId={contentId} title={title} />
  ) : null}
</div>
{contentId ? <FavoritesRuntime contentType="tool" /> : null}

<style>
  .tool-title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 0.5rem;
  }

  .tool-title-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .tool-title h1 {
    margin: 0;
    color: var(--kbm-green);
    font-size: 2rem;
    font-weight: 700;
    flex: 1 1 auto;
    min-width: 0;
  }
</style>
