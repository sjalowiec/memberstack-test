---
import FloatingInput from './FloatingInput.astro';
import {
  yarnResultSublineForVariant,
  type YarnRequirementEmbedVariant,
} from './yarnRequirementCopy';

export interface Props {
  isEmbedMode: boolean;
  /** Richer section layout for hat builder drawer only */
  drawerLayout?: boolean;
  /** Embed copy for drawer results subline */
  embedVariant?: YarnRequirementEmbedVariant;
}

const { isEmbedMode, drawerLayout = false, embedVariant = 'default' } = Astro.props;

const drawerResultsSubline = yarnResultSublineForVariant(embedVariant);
---

<div class:list={['yarn-section', drawerLayout && 'yarn-section--drawer-swatch']}>
  {drawerLayout ? (
    <>
      <div class="yarn-drawer-swatch-head">
        <h3 class="yarn-drawer-section-title">Swatch</h3>
        <div
          class="yarn-length-toggle-wrap yarn-length-toggle-wrap--compact"
          role="group"
          aria-label="Length units"
        >
          <div class="unit-toggle" id="yarn-length-units-toggle">
            <button
              type="button"
              class="active"
              data-unit="in"
              data-testid="button-yarn-length-unit-in"
              aria-pressed="true"
            >
              in
            </button>
            <button
              type="button"
              data-unit="cm"
              data-testid="button-yarn-length-unit-cm"
              aria-pressed="false"
            >
              cm
            </button>
          </div>
        </div>
      </div>
      <p class="yarn-drawer-section-hint">
        Measure edge to edge, then weigh on a kitchen or postal scale.
      </p>
    </>
  ) : (
    <div class="yarn-swatch-section-head">
      <span class="yarn-section-label">
        Measure your entire swatch (edge to edge), then weigh it.<br />
        Use a food or postal scale.
      </span>
      <div
        class:list={[
          'yarn-length-toggle-wrap',
          isEmbedMode && 'yarn-length-toggle-wrap--compact',
        ]}
        role="group"
        aria-label="Length units"
      >
        {isEmbedMode ? (
          <div class="unit-toggle" id="yarn-length-units-toggle">
            <button
              type="button"
              class="active"
              data-unit="in"
              data-testid="button-yarn-length-unit-in"
              aria-pressed="true"
            >
              in
            </button>
            <button
              type="button"
              data-unit="cm"
              data-testid="button-yarn-length-unit-cm"
              aria-pressed="false"
            >
              cm
            </button>
          </div>
        ) : (
          <div class="yarn-units-toggle" id="yarn-length-units-toggle">
            <button type="button" class="yarn-unit-btn active" data-unit="in" data-testid="button-yarn-length-unit-in">
              Inches
            </button>
            <button type="button" class="yarn-unit-btn" data-testid="button-yarn-length-unit-cm" data-unit="cm">
              Centimeters
            </button>
          </div>
        )}
      </div>
    </div>
  )}
  <div class="yarn-field-stack">
    <div class="yarn-field">
      <FloatingInput
        id="yarn-swatch-width"
        labelId="yarn-swatch-width-label"
        label="Swatch Width (in)"
        type="number"
        step={0.1}
        min={0}
        inputmode="decimal"
        autocomplete="off"
        dataTestid="input-yarn-swatch-width"
        dataAttrs={{ 'data-yarn-dimension-field': 'swatch-width' }}
      />
    </div>
    <div class="yarn-field">
      <FloatingInput
        id="yarn-swatch-length"
        labelId="yarn-swatch-length-label"
        label="Swatch Length (in)"
        type="number"
        step={0.1}
        min={0}
        inputmode="decimal"
        autocomplete="off"
        dataTestid="input-yarn-swatch-length"
        dataAttrs={{ 'data-yarn-dimension-field': 'swatch-length' }}
      />
    </div>
    <div class="yarn-field yarn-field--weight">
      <div class="yarn-weight-row">
        <FloatingInput
          id="yarn-swatch-weight"
          label="Swatch Weight"
          type="number"
          step={0.1}
          min={0}
          inputmode="decimal"
          autocomplete="off"
          dataTestid="input-yarn-swatch-weight"
          class="yarn-floating-weight"
        />
        <div class="unit-toggle" id="yarn-weight-units-toggle">
          <button type="button" class="active" data-unit="g" data-testid="button-yarn-weight-unit-g">g</button>
          <button type="button" data-unit="oz" data-testid="button-yarn-weight-unit-oz">oz</button>
        </div>
      </div>
    </div>
  </div>
</div>

{!isEmbedMode && (
  <div class="yarn-section">
    <span class="yarn-section-label">Your project</span>
    <div class="yarn-field-stack">
      <div class="yarn-field">
        <FloatingInput
          id="yarn-blanket-width"
          labelId="yarn-blanket-width-label"
          label="Project width (in)"
          type="number"
          step={0.1}
          min={0}
          inputmode="decimal"
          autocomplete="off"
          dataTestid="input-yarn-blanket-width"
          dataAttrs={{ 'data-yarn-dimension-field': 'project-width' }}
        />
      </div>
      <div class="yarn-field">
        <FloatingInput
          id="yarn-blanket-length"
          labelId="yarn-blanket-length-label"
          label="Project length (in)"
          type="number"
          step={0.1}
          min={0}
          inputmode="decimal"
          autocomplete="off"
          dataTestid="input-yarn-blanket-length"
          dataAttrs={{ 'data-yarn-dimension-field': 'project-length' }}
        />
      </div>
    </div>
  </div>
)}

{isEmbedMode && !drawerLayout && (
  <p
    id="yarn-project-context"
    class="yarn-project-context"
    aria-live="polite"
  ></p>
)}

<div class:list={['yarn-results-section', drawerLayout && 'yarn-results-section--drawer']} id="yarn-results-section">
  {drawerLayout ? (
    <div class="yarn-results-section-head">
      <h4 class="yarn-results-heading yarn-results-heading--drawer">Estimated yarn needed</h4>
      <p class="yarn-results-subline">{drawerResultsSubline}</p>
    </div>
  ) : (
    <h4 class="yarn-results-heading">Estimated yarn needed</h4>
  )}
  <div class:list={['yarn-results-display', drawerLayout && 'yarn-results-display--drawer']}>
    <p class="yarn-result-primary" id="yarn-result-primary" aria-live="polite">---</p>
    <p class="yarn-result-secondary" id="yarn-result-secondary" hidden></p>
  </div>
</div>

<p class="yarn-message" id="yarn-message-incomplete" style="display: none;">Enter your swatch measurements to see your estimate.</p>
<p class="yarn-message yarn-error" id="yarn-message-error" style="display: none;">All values must be greater than zero.</p>
