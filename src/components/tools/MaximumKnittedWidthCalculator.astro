---
import "../../styles/wizard.css";
import FloatingInput from "./FloatingInput.astro";
import UnitToggle from "../wizards/UnitToggle.astro";

interface Props {
  /** Compact layout for course lessons and other embedded contexts. */
  embedded?: boolean;
  /** Suffix for input ids when multiple calculators may appear on one page. */
  instanceId?: string;
}

const { embedded = false, instanceId = "standalone" } = Astro.props;
const needlesId = `availableNeedles-${instanceId}`;
const gaugeId = `stitchGauge-${instanceId}`;
---

<div
  class:list={["maxwidth-panel", embedded && "maxwidth-panel--embedded"]}
  data-maxwidth-calculator
>
  <div class="section-header-with-toggle">
    {
      embedded ? (
        <h3 class="embedded-tool-heading">Maximum Knitted Width</h3>
      ) : (
        <h2>Enter Your Measurements</h2>
      )
    }
    <UnitToggle />
  </div>
  <form data-maxwidth-form>
    <div class="maxwidth-input-grid">
      <FloatingInput
        id={needlesId}
        name="availableNeedles"
        label="Available Needles"
        type="number"
        min={1}
        step={1}
        placeholder=" "
      />
      <FloatingInput
        id={gaugeId}
        name="stitchGauge"
        label="Stitch Gauge"
        type="number"
        min={0.1}
        step={0.1}
        placeholder=" "
        dataAttrs={{ "data-maxwidth-gauge": "true" }}
      />
    </div>
    <div class="maxwidth-actions">
      <button type="button" data-maxwidth-calc class="wizard-button">
        Calculate
      </button>
    </div>

    <div data-maxwidth-validation class="maxwidth-validation" role="alert" hidden></div>
    <div data-maxwidth-results class="maxwidth-results"></div>
  </form>
</div>

<style>
  .maxwidth-panel {
    background: #fff;
    padding: 1.75rem;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    margin-bottom: 1.5rem;
  }

  .maxwidth-panel--embedded {
    padding: 1.1rem 1.15rem;
    margin-bottom: 0;
    box-shadow: none;
    border-radius: 10px;
  }

  .embedded-tool-heading {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: #52682d;
    line-height: 1.3;
  }

  .maxwidth-panel--embedded .section-header-with-toggle {
    gap: 0.75rem;
    align-items: flex-start;
  }

  @media (max-width: 640px) {
    .maxwidth-panel {
      padding: 1.25rem;
    }

    .maxwidth-panel--embedded {
      padding: 1rem;
    }

    .maxwidth-panel--embedded .section-header-with-toggle {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .maxwidth-input-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 16px;
  }

  @media (max-width: 640px) {
    .maxwidth-input-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  .maxwidth-actions {
    margin-top: 20px;
  }

  .maxwidth-panel--embedded .maxwidth-actions {
    margin-top: 16px;
  }

  .maxwidth-actions .wizard-button {
    padding: 12px 22px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 8px;
    background: #52682d;
    color: white;
    border: none;
    cursor: pointer;
    width: auto;
  }

  @media (max-width: 640px) {
    .maxwidth-actions .wizard-button {
      width: 100%;
    }
  }

  .maxwidth-actions .wizard-button:hover {
    background: #445925;
  }

  .maxwidth-validation {
    margin-top: 20px;
    padding: 14px 18px;
    border-left: 6px solid #d9534f;
    background: #fff4f4;
    border-radius: 6px;
    font-size: 0.95rem;
    color: #333;
  }

  .maxwidth-validation:not([hidden]) {
    display: block;
  }

  .maxwidth-results {
    margin-top: 24px;
  }

  .maxwidth-panel--embedded .maxwidth-results {
    margin-top: 18px;
  }

  .maxwidth-results-card.tool-results {
    background: #f8faf6;
    border: 1px solid #e5e7eb;
    border-left: 4px solid #52682d;
    border-radius: 8px;
    padding: 20px 24px;
    font-size: 1.1rem;
  }

  .maxwidth-panel--embedded .maxwidth-results-card.tool-results {
    padding: 16px 18px;
    font-size: 1rem;
  }

  .maxwidth-results-card.tool-results .result-main {
    font-size: 1.25rem;
    font-weight: 700;
    color: #52682d;
  }

  .maxwidth-panel--embedded .maxwidth-results-card.tool-results .result-main {
    font-size: 1.1rem;
  }

  /* Global so injected results HTML receives these styles */
  :global(.width-indicator) {
    margin-top: 1rem;
    max-width: 420px;
  }

  :global(.width-bar) {
    width: 100%;
    height: 12px;
    background: #e5e7eb;
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  :global(.width-fill) {
    position: relative;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #52682d, #7b9b4a);
    border-radius: 999px;
    transition: width 0.5s ease;
  }

  :global(.width-fill::after) {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    transform: translate(50%, -50%);
    width: 3px;
    height: 16px;
    background: #6b7f43;
    border-radius: 2px;
  }

  :global(.width-scale) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    color: #4b5563;
    margin-top: 0.35rem;
  }
</style>

<script>
  function getUnit(): string {
    return localStorage.getItem("kbm-units") || "in";
  }

  function initMaxWidthCalculator(root: HTMLElement): void {
    const calculateButton = root.querySelector("[data-maxwidth-calc]");
    const resultsPanel = root.querySelector("[data-maxwidth-results]");
    const validationEl = root.querySelector(
      "[data-maxwidth-validation]",
    ) as HTMLElement | null;
    const gaugeInput = root.querySelector("[data-maxwidth-gauge]") as HTMLInputElement | null;

    function updateGaugePlaceholder(unit: string): void {
      if (!gaugeInput) return;
      gaugeInput.placeholder = unit === "cm" ? "per 10 cm" : "per 4 inches";
    }

    updateGaugePlaceholder(getUnit());

    if (!calculateButton || !resultsPanel || !validationEl) return;

    calculateButton.addEventListener("click", () => {
      const form = root.querySelector("[data-maxwidth-form]") as HTMLFormElement | null;
      const formData = form ? new FormData(form) : new FormData();

      const needlesRaw = formData.get("availableNeedles") ?? "";
      const gaugeRaw = formData.get("stitchGauge") ?? "";

      const needles = parseInt(String(needlesRaw), 10) || 0;
      const gauge = parseFloat(String(gaugeRaw)) || 0;

      validationEl.hidden = true;
      validationEl.textContent = "";

      const errors: string[] = [];
      if (needlesRaw === "" || needlesRaw === null) errors.push("Please enter available needles.");
      else if (needles <= 0) errors.push("Available needles must be greater than zero.");
      if (gaugeRaw === "" || gaugeRaw === null) errors.push("Please enter stitch gauge.");
      else if (gauge <= 0) errors.push("Stitch gauge must be greater than zero.");

      if (errors.length > 0) {
        validationEl.textContent = errors.join(" ");
        validationEl.hidden = false;
        resultsPanel.innerHTML = "";
        return;
      }

      const unit = getUnit();
      let widthIn: number;
      let widthCm: number;

      if (unit === "cm") {
        widthCm = (needles / gauge) * 10;
        widthIn = widthCm / 2.54;
      } else {
        widthIn = (needles / gauge) * 4;
        widthCm = widthIn * 2.54;
      }

      const widthInRounded = Math.round(widthIn * 10) / 10;
      const widthCmRounded = Math.round(widthCm * 10) / 10;

      const primaryUnit = unit === "cm" ? "cm" : "in";
      const primaryVal = unit === "cm" ? widthCmRounded : widthInRounded;
      const altVal = unit === "cm" ? widthInRounded : widthCmRounded;
      const altUnit = unit === "cm" ? "in" : "cm";

      resultsPanel.innerHTML = `
        <div class="maxwidth-results-card tool-results">
          <p class="result-main">
            Maximum Width: <strong>${primaryVal} ${primaryUnit}</strong> (${altVal} ${altUnit})
          </p>
          <div class="width-indicator">
            <div class="width-bar">
              <div class="width-fill" data-maxwidth-fill></div>
            </div>
            <div class="width-scale">
              <span>0</span>
              <span data-maxwidth-label>50 in</span>
            </div>
          </div>
        </div>`;

      const visualMax = 60;
      const percent = Math.min((widthIn / visualMax) * 100, 100);
      const bar = resultsPanel.querySelector("[data-maxwidth-fill]") as HTMLElement | null;
      const label = resultsPanel.querySelector("[data-maxwidth-label]");
      if (bar) {
        bar.style.width = "0%";
        window.setTimeout(() => {
          bar.style.width = percent + "%";
        }, 50);
      }
      if (label) {
        label.textContent = primaryVal.toFixed(1) + " " + primaryUnit;
      }
    });
  }

  window.addEventListener("kbm:units-change", (e: Event) => {
    const ev = e as CustomEvent<{ unit?: string }>;
    const unit = ev.detail?.unit ?? "in";
    document.querySelectorAll("[data-maxwidth-calculator]").forEach((root) => {
      const gaugeInput = root.querySelector("[data-maxwidth-gauge]") as HTMLInputElement | null;
      if (gaugeInput) {
        gaugeInput.placeholder = unit === "cm" ? "per 10 cm" : "per 4 inches";
      }
    });
  });

  document.querySelectorAll("[data-maxwidth-calculator]").forEach((root) => {
    initMaxWidthCalculator(root as HTMLElement);
  });
</script>
