</style>

<script>
  import {
    YARN_REQUIREMENT_BUFFER,
    estimateYarnWeightWithBuffer,
    resolveYarnProjectAreaSquareInches,
  } from '../../lib/tools/yarnRequirementDimensions';

  (function() {
    // Get DOM elements
    const yarnHeading = document.getElementById('yarn-heading');
    const swatchWidth = document.getElementById('yarn-swatch-width');
    const swatchLength = document.getElementById('yarn-swatch-length');
    const swatchWeight = document.getElementById('yarn-swatch-weight');
    const blanketWidth = document.getElementById('yarn-blanket-width');
    const blanketLength = document.getElementById('yarn-blanket-length');
    const lengthUnitBtns = document.querySelectorAll('#yarn-length-units-toggle button[type="button"]');
    const swatchWidthLabel = document.getElementById('yarn-swatch-width-label');
    const swatchLengthLabel = document.getElementById('yarn-swatch-length-label');
    const blanketWidthLabel = document.getElementById('yarn-blanket-width-label');
    const blanketLengthLabel = document.getElementById('yarn-blanket-length-label');
    const weightUnitBtns = document.querySelectorAll('#yarn-weight-units-toggle button[type="button"]');
    const resultsSection = document.getElementById('yarn-results-section');
    const resultPrimary = document.getElementById('yarn-result-primary');
    const resultSecondary = document.getElementById('yarn-result-secondary');
    const messageIncomplete = document.getElementById('yarn-message-incomplete');
    const messageError = document.getElementById('yarn-message-error');

    const wrapper = document.getElementById('yarn-requirement');
    if (!swatchWidth || !swatchLength || !swatchWeight || !wrapper) {
      return;
    }

    const LENGTH_STORAGE_KEY = 'kbm:yarnRequirement:lengthUnit';
    const WEIGHT_STORAGE_KEY = 'kbm:yarnRequirement:weightUnit';
    const INCH_TO_CM = 2.54;

    const isEmbedMode = wrapper.getAttribute('data-embed-mode') === 'true';
    const variant = wrapper.dataset.variant || 'default';
    const isHatVariant = variant === 'hat';
    const isGarmentVariant = variant === 'garment';
    const isBlanketVariant = variant === 'blanket';

    /** Read page-level in/cm preference (UnitToggle, hat builder, etc.). */
    function readAppLengthUnit(): 'in' | 'cm' {
      try {
        if (isHatVariant) {
          const hat = localStorage.getItem('hat-unit');
          if (hat === 'cm') return 'cm';
          if (hat === 'inches') return 'in';
        }
        if (isGarmentVariant) {
          const scoped = localStorage.getItem('kbm-units-sleeveless-fit');
          if (scoped === 'in' || scoped === 'cm') return scoped;
        }
        if (isBlanketVariant) {
          const scoped = localStorage.getItem('kbm-units-diy');
          if (scoped === 'in' || scoped === 'cm') return scoped;
        }
        const global = localStorage.getItem('kbm-units');
        if (global === 'in' || global === 'cm') return global;
      } catch {
        /* ignore */
      }
      return 'in';
    }

    function convertDimensionValue(value: number, fromUnit: 'in' | 'cm', toUnit: 'in' | 'cm'): number {
      if (fromUnit === toUnit) return value;
      if (fromUnit === 'cm' && toUnit === 'in') return value / INCH_TO_CM;
      return value * INCH_TO_CM;
    }

    function formatDimensionInputValue(value: number, unit: 'in' | 'cm'): string {
      if (unit === 'cm') {
        const rounded = Math.round(value * 10) / 10;
        return String(rounded);
      }
      const rounded = Math.round(value * 100) / 100;
      return rounded % 1 === 0 ? String(Math.round(rounded)) : String(rounded);
    }

    function convertLengthInputField(input: HTMLInputElement | null, fromUnit: 'in' | 'cm', toUnit: 'in' | 'cm') {
      if (!input) return;
      const raw = input.value.trim();
      if (!raw) return;
      const n = parseFloat(raw);
      if (isNaN(n) || n <= 0) return;
      input.value = formatDimensionInputValue(convertDimensionValue(n, fromUnit, toUnit), toUnit);
    }

    const propsLengthUnit = wrapper.dataset.lengthUnit === 'cm' ? 'cm' : 'in';
    const storedLengthUnit = localStorage.getItem(LENGTH_STORAGE_KEY);
    const resolvedStoredLength =
      storedLengthUnit === 'cm' || storedLengthUnit === 'in' ? storedLengthUnit : null;
    let currentLengthUnit: 'in' | 'cm' = isEmbedMode
      ? readAppLengthUnit()
      : (resolvedStoredLength || readAppLengthUnit());
    let currentWeightUnit = localStorage.getItem(WEIGHT_STORAGE_KEY) || 'g';
    let blanketWidthIn = 0;
    let blanketLengthIn = 0;
    /** Optional fabric area override (sq in); 0 = use W×L rectangle. */
    let projectAreaSqIn = 0;
    let hasInteracted = false;
    let isCustomPattern = false;

    let projectWidth = parseFloat(wrapper.dataset.projectWidth || '0');
    let projectLength = parseFloat(wrapper.dataset.projectLength || '0');
    
    // Convert props to inches for internal calculations
    if (propsLengthUnit === 'cm') {
      projectWidth = projectWidth / 2.54;
      projectLength = projectLength / 2.54;
    }
    
    // Sample defaults (for comparison to detect custom vs sample)
    const SAMPLE_WIDTH_IN = 36;
    const SAMPLE_LENGTH_IN = 36;
    
    // Initialize blanket dimensions from props (embed mode)
    if (isEmbedMode) {
      blanketWidthIn = projectWidth;
      blanketLengthIn = projectLength;
      
      // Use source prop if available, otherwise detect from dimensions
      const sourceProp = wrapper.getAttribute('data-source');
      if (sourceProp === 'custom' || sourceProp === 'sample') {
        isCustomPattern = sourceProp === 'custom';
      } else {
        // Fallback: check if values differ from sample defaults (within small tolerance)
        const tolerance = 0.1;
        const isSampleSize = Math.abs(blanketWidthIn - SAMPLE_WIDTH_IN) < tolerance && 
                            Math.abs(blanketLengthIn - SAMPLE_LENGTH_IN) < tolerance;
        isCustomPattern = !isSampleSize;
      }
      
      // Fallback: read from wizard data attributes if props are zero (blanket wizard only)
      if (blanketWidthIn === 0 || blanketLengthIn === 0) {
        const wizard = document.getElementById('hybrid-blanket-wizard-v2');
        if (wizard) {
          const wizardWidth = wizard.getAttribute('data-blanket-width-inches');
          const wizardLength = wizard.getAttribute('data-blanket-length-inches');
          if (wizardWidth) blanketWidthIn = parseFloat(wizardWidth) || 0;
          if (wizardLength) blanketLengthIn = parseFloat(wizardLength) || 0;
          if (blanketWidthIn > 0 || blanketLengthIn > 0) {
            const tol = 0.1;
            const isSampleSize = Math.abs(blanketWidthIn - SAMPLE_WIDTH_IN) < tol && 
                                Math.abs(blanketLengthIn - SAMPLE_LENGTH_IN) < tol;
            isCustomPattern = !isSampleSize;
          }
        }
      }
    }
    
    /** True when focus is moving to another control inside this calculator (not leaving it). */
    function focusMovedWithinCalculator(nextFocus: EventTarget | null): boolean {
      return nextFocus instanceof Node && wrapper.contains(nextFocus);
    }

    /**
     * Recalculate on blur; only jump to the first empty field when focus leaves the calculator.
     * Avoids trapping users who click back to an earlier swatch field while a later one is still empty.
     */
    function handleCalculatorFieldBlur(ev: FocusEvent) {
      if (!hasInteracted) return;
      calculateYarn(false);
      if (focusMovedWithinCalculator(ev.relatedTarget)) {
        return;
      }
      window.setTimeout(() => {
        if (focusMovedWithinCalculator(document.activeElement)) {
          return;
        }
        calculateYarn(true);
      }, 0);
    }

    // Focus first missing required field
    function focusFirstMissing() {
      const requiredFields = [];
      
      // Swatch fields (always required)
      requiredFields.push(swatchWidth);
      requiredFields.push(swatchLength);
      requiredFields.push(swatchWeight);
      
      // Blanket fields (only in standalone mode)
      if (!isEmbedMode) {
        if (blanketWidth) requiredFields.push(blanketWidth);
        if (blanketLength) requiredFields.push(blanketLength);
      }
      
      // Find first empty or invalid field
      for (const field of requiredFields) {
        const value = parseFloat(field.value);
        if (!field.value.trim() || isNaN(value) || value <= 0) {
          field.focus();
          field.select();
          return true;
        }
      }
      
      return false;
    }
    
    function setLengthUnit(nextUnit: 'in' | 'cm', options?: { convertFields?: boolean; persist?: boolean }) {
      const convertFields = options?.convertFields !== false;
      const persist = options?.persist !== false;
      const prevUnit = currentLengthUnit;
      if (nextUnit === prevUnit) {
        updateLengthUnitUI();
        return;
      }
      if (convertFields) {
        convertLengthInputField(swatchWidth, prevUnit, nextUnit);
        convertLengthInputField(swatchLength, prevUnit, nextUnit);
        if (!isEmbedMode) {
          convertLengthInputField(blanketWidth, prevUnit, nextUnit);
          convertLengthInputField(blanketLength, prevUnit, nextUnit);
        }
      }
      currentLengthUnit = nextUnit;
      if (persist) {
        localStorage.setItem(LENGTH_STORAGE_KEY, currentLengthUnit);
      }
      updateLengthUnitUI();
      calculateYarn();
    }

    // Update length unit UI
    function updateLengthUnitUI() {
      lengthUnitBtns.forEach(btn => {
        const isActive = btn.dataset.unit === currentLengthUnit;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
      const unit = currentLengthUnit;
      if (swatchWidthLabel) swatchWidthLabel.textContent = `Swatch Width (${unit})`;
      if (swatchLengthLabel) swatchLengthLabel.textContent = `Swatch Length (${unit})`;
      if (blanketWidthLabel) blanketWidthLabel.textContent = `Project width (${unit})`;
      if (blanketLengthLabel) blanketLengthLabel.textContent = `Project length (${unit})`;
      // Update context line when unit changes
      if (resultsSection) {
        updateProjectContext();
      }
    }
    
    // Update weight unit UI
    function updateWeightUnitUI() {
      weightUnitBtns.forEach(btn => {
        btn.classList.toggle('active', btn.dataset.unit === currentWeightUnit);
      });
    }
    
    // Set placeholder values for results section
    // NOTE: Does NOT reset blanket context - that should always show current dimensions
    function formatGrams(grams: number) {
      return Math.round(grams) + ' g';
    }

    function formatOunces(ounces: number) {
      return ounces.toFixed(1) + ' oz';
    }

    function displayResults(estimatedGrams: number, estimatedOunces: number) {
      if (!resultPrimary) return;
      const gramsText = formatGrams(estimatedGrams);
      const ouncesText = formatOunces(estimatedOunces);
      if (currentLengthUnit === 'in') {
        resultPrimary.textContent = ouncesText;
        if (resultSecondary) {
          resultSecondary.textContent = '≈ ' + gramsText;
          resultSecondary.hidden = false;
        }
      } else {
        resultPrimary.textContent = gramsText;
        if (resultSecondary) {
          resultSecondary.textContent = '≈ ' + ouncesText;
          resultSecondary.hidden = false;
        }
      }
    }

    function setResultsPlaceholders() {
      // Don't reset blanket context - it should always show the current dimensions
      if (resultPrimary) {
        resultPrimary.textContent = '---';
      }
      if (resultSecondary) {
        resultSecondary.textContent = '';
        resultSecondary.hidden = true;
      }
    }
    
    // Update heading text dynamically based on current dimensions
    function updateHeading() {
      if (!yarnHeading) {
        return;
      }

      if (isHatVariant) {
        yarnHeading.textContent = 'Do I have enough yarn?';
        return;
      }

      if (blanketWidthIn > 0 && blanketLengthIn > 0) {
        const w = Math.round(blanketWidthIn * 10) / 10;
        const l = Math.round(blanketLengthIn * 10) / 10;
        const wDisplay = w % 1 === 0 ? Math.round(w) : w;
        const lDisplay = l % 1 === 0 ? Math.round(l) : l;
        yarnHeading.textContent = `How much yarn do I need for my ${wDisplay}″ × ${lDisplay}″ project?`;
      } else {
        yarnHeading.textContent = 'How much yarn do I need?';
      }
    }

    // Embed mode: show which project dimensions the estimate uses
    function updateProjectContext() {
      const el = document.getElementById('yarn-project-context');
      if (!el) {
        return;
      }

      if (blanketWidthIn <= 0 || blanketLengthIn <= 0) {
        el.textContent = isHatVariant
          ? 'Choose hat size and length above to see your estimate.'
          : isGarmentVariant
            ? 'Measurements are loading…'
            : isBlanketVariant
              ? 'Choose a blanket size above to see your estimate.'
              : 'Project size used: —';
        return;
      }

      let displayW, displayL;
      const displayUnit = currentLengthUnit;

      if (displayUnit === 'cm') {
        displayW = Math.round(blanketWidthIn * 2.54);
        displayL = Math.round(blanketLengthIn * 2.54);
      } else {
        displayW = Math.round(blanketWidthIn * 10) / 10;
        displayL = Math.round(blanketLengthIn * 10) / 10;
        if (displayW % 1 === 0) displayW = Math.round(displayW);
        if (displayL % 1 === 0) displayL = Math.round(displayL);
      }

      const unitLabel = displayUnit === 'in' ? 'in' : 'cm';
      el.textContent = isHatVariant
        ? `Uses hat size and length from your pattern: ${displayW} × ${displayL} ${unitLabel}.`
        : isGarmentVariant
          ? `Uses this sweater’s finished size: ${displayW} × ${displayL} ${unitLabel}.`
          : isBlanketVariant
            ? `Uses this blanket’s finished size: ${displayW} × ${displayL} ${unitLabel}.`
            : `Project size used: ${displayW} × ${displayL} ${unitLabel}.`;
    }
    
    // Calculate yarn estimate
    function calculateYarn(shouldFocus = false) {
      // Hide messages (but keep results visible)
      if (messageIncomplete) messageIncomplete.style.display = 'none';
      if (messageError) messageError.style.display = 'none';
      
      // Get swatch values
      let swatchW = parseFloat(swatchWidth.value);
      let swatchL = parseFloat(swatchLength.value);
      const swatchWt = parseFloat(swatchWeight.value);
      
      // Get blanket dimensions
      let blanketW = blanketWidthIn;
      let blanketL = blanketLengthIn;
      
      if (!isEmbedMode) {
        // Standalone mode: read from inputs
        blanketW = parseFloat(blanketWidth?.value || '0');
        blanketL = parseFloat(blanketLength?.value || '0');
        
        // Convert to inches if needed
        if (currentLengthUnit === 'cm') {
          blanketW = blanketW / 2.54;
          blanketL = blanketL / 2.54;
        }
      }
      
      // Convert swatch dimensions to inches if needed
      if (currentLengthUnit === 'cm') {
        swatchW = swatchW / 2.54;
        swatchL = swatchL / 2.54;
      }
      
      // Validate inputs
      const swatchValid = !isNaN(swatchW) && !isNaN(swatchL) && !isNaN(swatchWt) && 
                         swatchW > 0 && swatchL > 0 && swatchWt > 0;
      const blanketArea = resolveYarnProjectAreaSquareInches({
        widthInches: blanketW,
        lengthInches: blanketL,
        projectAreaSquareInches: projectAreaSqIn > 0 ? projectAreaSqIn : undefined,
      });
      const blanketValid = blanketArea > 0;
      
      // Check if any input has been entered
      const hasAnyInput = swatchWidth.value.trim() !== '' || 
                         swatchLength.value.trim() !== '' || 
                         swatchWeight.value.trim() !== '' ||
                         (!isEmbedMode && (blanketWidth?.value.trim() !== '' || blanketLength?.value.trim() !== ''));
      
      // Show appropriate message (only if user has interacted)
      if (!hasAnyInput) {
        if (messageIncomplete && hasInteracted) {
          messageIncomplete.style.display = 'block';
        }
        setResultsPlaceholders();
        return;
      }
      
      // Check for invalid values (only show error if user has entered something)
      if (!swatchValid || !blanketValid) {
        // Only show error if user has interacted AND entered invalid values
        if (hasInteracted && messageError) {
          const hasInvalidValue = (swatchWidth.value.trim() !== '' && (isNaN(swatchW) || swatchW <= 0)) ||
                                  (swatchLength.value.trim() !== '' && (isNaN(swatchL) || swatchL <= 0)) ||
                                  (swatchWeight.value.trim() !== '' && (isNaN(swatchWt) || swatchWt <= 0)) ||
                                  (!isEmbedMode && blanketWidth && blanketWidth.value.trim() !== '' && (isNaN(blanketW) || blanketW <= 0)) ||
                                  (!isEmbedMode && blanketLength && blanketLength.value.trim() !== '' && (isNaN(blanketL) || blanketL <= 0));
          
          if (hasInvalidValue) {
            messageError.style.display = 'block';
          }
        }
        
        // Focus first missing field if requested
        if (shouldFocus) {
          focusFirstMissing();
        }
        
        setResultsPlaceholders();
        return;
      }
      
      // Density × area × 10% buffer (shared with yarnRequirementDimensions)
      let estimatedGrams, estimatedOunces;

      if (currentWeightUnit === 'oz') {
        const estimatedOzWithBuffer = estimateYarnWeightWithBuffer({
          swatchWidthInches: swatchW,
          swatchLengthInches: swatchL,
          swatchWeight: swatchWt,
          projectAreaSquareInches: blanketArea,
          buffer: YARN_REQUIREMENT_BUFFER,
        });
        estimatedOunces = estimatedOzWithBuffer;
        estimatedGrams = estimatedOzWithBuffer * 28.349523125;
      } else {
        const estimatedGramsWithBuffer = estimateYarnWeightWithBuffer({
          swatchWidthInches: swatchW,
          swatchLengthInches: swatchL,
          swatchWeight: swatchWt,
          projectAreaSquareInches: blanketArea,
          buffer: YARN_REQUIREMENT_BUFFER,
        });
        estimatedGrams = estimatedGramsWithBuffer;
        estimatedOunces = estimatedGramsWithBuffer / 28.349523125;
      }
      
      // Validate computed values are finite and > 0
      if (!Number.isFinite(estimatedGrams) || !Number.isFinite(estimatedOunces) || 
          estimatedGrams <= 0 || estimatedOunces <= 0) {
        setResultsPlaceholders();
        return;
      }
      
      displayResults(estimatedGrams, estimatedOunces);
      
      // Update blanket context line
      updateProjectContext();
    }
    
    // Listen for yarn dimensions event from pattern engine (embed mode)
    if (isEmbedMode) {
      window.addEventListener('kbm:yarnDimensions', function(e: CustomEvent) {
        const detail = e.detail;
        if (detail && (detail.projectWidth !== undefined || detail.projectLength !== undefined || detail.projectAreaSquareInches !== undefined)) {
          // Update props from event
          let newWidth = detail.projectWidth || 0;
          let newLength = detail.projectLength || 0;
          const eventUnit = detail.lengthUnit || 'in';
          
          // Convert to inches if needed
          if (eventUnit === 'cm') {
            newWidth = newWidth / 2.54;
            newLength = newLength / 2.54;
          }
          
          // Update internal values (in inches) first
          blanketWidthIn = newWidth;
          blanketLengthIn = newLength;
          const areaRaw = detail.projectAreaSquareInches;
          projectAreaSqIn =
            typeof areaRaw === 'number' && Number.isFinite(areaRaw) && areaRaw > 0 ? areaRaw : 0;
          
          // Update wrapper dataset
          wrapper.dataset.projectWidth = String(detail.projectWidth || 0);
          wrapper.dataset.projectLength = String(detail.projectLength || 0);
          wrapper.dataset.projectAreaSqIn = String(projectAreaSqIn);
          wrapper.dataset.lengthUnit = eventUnit;
          
          // Update source from event if provided
          if (detail.source === 'custom' || detail.source === 'sample') {
            wrapper.dataset.source = detail.source;
            isCustomPattern = detail.source === 'custom';
          } else {
            // Fallback: check if this is custom pattern (differs from sample defaults)
            const tolerance = 0.1;
            const isSampleSize = Math.abs(blanketWidthIn - SAMPLE_WIDTH_IN) < tolerance && 
                                Math.abs(blanketLengthIn - SAMPLE_LENGTH_IN) < tolerance;
            isCustomPattern = !isSampleSize;
          }
          
          // Update data-width-inches and data-length-inches for compatibility
          wrapper.setAttribute('data-width-inches', blanketWidthIn.toString());
          wrapper.setAttribute('data-length-inches', blanketLengthIn.toString());
          
          updateHeading();

          setLengthUnit(eventUnit === 'cm' ? 'cm' : 'in', { convertFields: false, persist: false });

          updateProjectContext();
          
          // Recalculate (will show placeholders if swatch inputs aren't filled)
          calculateYarn();
        }
      });
      
      // Also listen for legacy event (for backwards compatibility)
      window.addEventListener('kbm:hybridBlanket:dimensions', function(e: CustomEvent) {
        const detail = e.detail;
        if (detail && detail.widthInches !== undefined && detail.lengthInches !== undefined) {
          blanketWidthIn = detail.widthInches || 0;
          blanketLengthIn = detail.lengthInches || 0;
          
          // Use source from event if provided, otherwise detect from dimensions
          if (detail.source === 'custom' || detail.source === 'sample') {
            wrapper.dataset.source = detail.source;
            isCustomPattern = detail.source === 'custom';
          } else {
            // Fallback: check if custom pattern (differs from sample defaults)
            const tolerance = 0.1;
            const isSampleSize = Math.abs(blanketWidthIn - SAMPLE_WIDTH_IN) < tolerance && 
                                Math.abs(blanketLengthIn - SAMPLE_LENGTH_IN) < tolerance;
            isCustomPattern = !isSampleSize;
          }
          
          updateHeading();
          updateProjectContext();
          calculateYarn();
        }
      });
    }
    
    // Track user interaction
    function markInteracted() {
      hasInteracted = true;
    }
    
    lengthUnitBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        markInteracted();
        const next = btn.dataset.unit === 'cm' ? 'cm' : 'in';
        setLengthUnit(next);
      });
    });

    window.addEventListener('kbm:units-change', (ev: Event) => {
      const detail = (ev as CustomEvent<{ unit?: string; toggleId?: string }>).detail;
      const unit = detail?.unit;
      if (unit !== 'in' && unit !== 'cm') return;
      if (isGarmentVariant && detail?.toggleId != null && detail.toggleId !== 'sleeveless-fit') {
        return;
      }
      if (isHatVariant && detail?.toggleId != null && detail.toggleId !== 'hat') {
        return;
      }
      if (isBlanketVariant && detail?.toggleId != null && detail.toggleId !== 'diy') {
        return;
      }
      setLengthUnit(unit, { convertFields: true, persist: false });
    });
    
    // Weight unit toggle handlers
    weightUnitBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        markInteracted();
        currentWeightUnit = btn.dataset.unit || 'g';
        localStorage.setItem(WEIGHT_STORAGE_KEY, currentWeightUnit);
        updateWeightUnitUI();
        calculateYarn();
      });
    });
    
    // Input handlers - mark as interacted on input
    [swatchWidth, swatchLength, swatchWeight].forEach(input => {
      input.addEventListener('input', () => {
        markInteracted();
        calculateYarn();
      });
      
      input.addEventListener('blur', handleCalculatorFieldBlur);
    });
    
    if (!isEmbedMode && blanketWidth && blanketLength) {
      blanketWidth.addEventListener('input', () => {
        markInteracted();
        calculateYarn();
      });
      blanketLength.addEventListener('input', () => {
        markInteracted();
        calculateYarn();
      });
      
      blanketWidth.addEventListener('blur', handleCalculatorFieldBlur);
      blanketLength.addEventListener('blur', handleCalculatorFieldBlur);
    }
    
    // Initialize
    updateLengthUnitUI();
    updateWeightUnitUI();
    updateHeading();
    if (isEmbedMode) {
      updateProjectContext();
    }
    setResultsPlaceholders();
  })();
</script>
