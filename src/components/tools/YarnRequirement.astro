---
// YarnRequirement.astro
// Estimates yarn needed from swatch weight and project dimensions (rectangle area + 10% buffer)
// Supports embed mode (pattern-driven dimensions), hat embed, and standalone mode

import YarnRequirementCalculatorCore from './YarnRequirementCalculatorCore.astro';
import '../../styles/tools/yarn-drawer-presentation.css';

export interface Props {
  projectWidth?: number; // Project width (in lengthUnit), e.g. blanket width or finished hat width
  projectLength?: number; // Project length (in lengthUnit)
  lengthUnit?: 'in' | 'cm'; // Unit of projectWidth/projectLength (default: 'in')
  source?: 'sample' | 'custom'; // Whether dimensions are from sample or custom pattern
  /** When hat/garment/blanket, embeds even if dimensions start at 0; copy differs by variant */
  variant?: 'default' | 'hat' | 'garment' | 'blanket';
  /** 'accordion': details/summary (default). 'panel': flat block (e.g. hat builder drawer). */
  layout?: 'accordion' | 'panel';
  /** 'drawer': hat-builder helper panel styling and section layout (use with layout panel + hat). */
  presentation?: 'default' | 'drawer';
}

const {
  projectWidth = 0,
  projectLength = 0,
  lengthUnit = 'in',
  source = 'sample',
  variant = 'default',
  layout = 'accordion',
  presentation = 'default',
} = Astro.props;

const isHat = variant === 'hat';
const isGarment = variant === 'garment';
const isBlanket = variant === 'blanket';
const isDrawerEmbed = isHat || isGarment || isBlanket;
const usePanelLayout = layout === 'panel';
const isDrawerPresentation = presentation === 'drawer';
const drawerLayout = isDrawerPresentation;
// Embed: pattern drawers, or any caller passing positive pattern dimensions (e.g. triangle scarf tab)
const isEmbedMode = isDrawerEmbed || (projectWidth > 0 && projectLength > 0);

// Convert to inches if needed (internal calculations always use inches)
const widthInches = lengthUnit === 'cm' ? projectWidth / 2.54 : projectWidth;
const lengthInches = lengthUnit === 'cm' ? projectLength / 2.54 : projectLength;

const defaultTitle =
  widthInches > 0 && lengthInches > 0
    ? (() => {
        const w = Math.round(widthInches * 10) / 10;
        const l = Math.round(lengthInches * 10) / 10;
        const wDisplay = w % 1 === 0 ? Math.round(w) : w;
        const lDisplay = l % 1 === 0 ? Math.round(l) : l;
        return `How much yarn do I need for my ${wDisplay}″ × ${lDisplay}″ project?`;
      })()
    : 'How much yarn do I need?';
---

<div
  id="yarn-requirement"
  class:list={[
    'yarn-requirement-tool',
    isDrawerEmbed && 'yarn--variant-hat',
    isDrawerPresentation && 'yarn--presentation-drawer',
    isDrawerPresentation && 'yarn-drawer-presentation',
  ]}
  data-width-inches={widthInches}
  data-length-inches={lengthInches}
  data-embed-mode={isEmbedMode}
  data-project-width={projectWidth}
  data-project-length={projectLength}
  data-project-area-sq-in="0"
  data-length-unit={lengthUnit}
  data-source={source}
  data-variant={variant}
  data-layout={layout}
  data-presentation={presentation}
>
  {usePanelLayout ? (
    <div class:list={['yarn-outer-panel', isDrawerEmbed && 'yarn-outer-panel--hat']}>
      {isHat && !isDrawerPresentation && (
        <p class="yarn-helper-hat">
          Enter your swatch measurements and weight to estimate yarn needed for this hat.
        </p>
      )}
      {isGarment && !isDrawerPresentation && (
        <p class="yarn-helper-hat">
          Enter your swatch measurements and weight to estimate yarn needed for this sweater.
        </p>
      )}
      {!isDrawerEmbed && (
        <h2 class="yarn-heading" id="yarn-heading">{defaultTitle}</h2>
      )}
      <div class="yarn-calculator" id="yarn-calculator">
        <YarnRequirementCalculatorCore
          isEmbedMode={isEmbedMode}
          drawerLayout={drawerLayout}
          embedVariant={variant}
        />
      </div>
    </div>
  ) : (
    <details
      class:list={['yarn-outer-details', isHat ? 'yarn-outer-details--hat' : 'yarn-outer-details--standalone']}
      open
    >
      <summary class:list={['yarn-heading', isHat && 'yarn-heading--summary']} id="yarn-heading">
        {isHat ? 'Do I have enough yarn?' : defaultTitle}
      </summary>
      {isHat && (
        <p class="yarn-helper-hat">
          Enter your swatch measurements and weight to estimate yarn needed for this hat.
        </p>
      )}
      <div class="yarn-calculator" id="yarn-calculator">
        <YarnRequirementCalculatorCore
          isEmbedMode={isEmbedMode}
          drawerLayout={drawerLayout}
          embedVariant={variant}
        />
      </div>
    </details>
  )}
</div>

