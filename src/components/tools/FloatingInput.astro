---
/**
 * Reusable floating-label input for tool pages.
 * Label sits inside the input and floats up on focus or when the field has a value.
 * Styles are loaded by this component (no separate import needed).
 *
 * Example (number field on a tool page):
 *   import FloatingInput from "../../components/tools/FloatingInput.astro";
 *   <FloatingInput id="totalRows" label="Total rows" type="number" min={1} step={1} />
 *
 * With error and message:
 *   <FloatingInput id="width" label="Width (inches)" type="number" error={hasError} errorMessage="Please enter a valid width." />
 *
 * Placeholder: Default " " enables the float; pass a string for optional hint on focus.
 */
type InputType = "text" | "number" | "email" | "tel" | "url" | "search" | "password";
type InputMode = "text" | "numeric" | "decimal" | "email" | "tel" | "url" | "search" | "none";

interface Props {
  id: string;
  name?: string;
  label: string;
  type?: InputType;
  value?: string | number;
  /** Use " " (space) for floating label only; set a string for optional hint on focus. */
  placeholder?: string;
  min?: string | number;
  max?: string | number;
  step?: string | number;
  required?: boolean;
  inputmode?: InputMode;
  autocomplete?: string;
  /** When false, disables spellcheck (e.g. search fields). Omit for browser default. */
  spellcheck?: boolean;
  ariaDescribedby?: string;
  /** When true, shows error state (red border/label) and optional error message. */
  error?: boolean;
  /** Message shown when error is true (e.g. "Please enter a valid number."). */
  errorMessage?: string;
  /** Extra class(es) on the wrapper div. */
  class?: string;
  enterkeyhint?: "enter" | "done" | "go" | "next" | "previous" | "search" | "send";
  role?: "searchbox";
  /** data-testid for the input. */
  dataTestid?: string;
  /** When set, the visible label element gets this id (e.g. for script-driven text updates). */
  labelId?: string;
  /** Optional class on the label (e.g. floating-label for gauge overrides). */
  labelClass?: string;
  /** Optional modal element id; renders a ? control with data-modal (caller wires open/close). */
  helpModalId?: string;
  /** aria-label for the help button when helpModalId is set. */
  helpModalAriaLabel?: string;
  /** Additional data-* attributes to spread on the input. */
  dataAttrs?: Record<string, string>;
}

const {
  id,
  name,
  label,
  type = "text",
  value,
  placeholder = " ",
  min,
  max,
  step,
  required = false,
  inputmode,
  autocomplete,
  spellcheck,
  ariaDescribedby,
  error = false,
  errorMessage,
  class: wrapperClass,
  enterkeyhint,
  role,
  dataTestid,
  labelId,
  labelClass,
  helpModalId,
  helpModalAriaLabel,
  dataAttrs = {},
} = Astro.props;

const errorId = errorMessage ? `${id}-error` : undefined;
const describedBy = [ariaDescribedby, errorId].filter(Boolean).join(" ") || undefined;
---

<style is:global>
  @import "../../styles/tools/floating-input.css";
</style>

<div class:list={["floating-input", wrapperClass]}>
  <input
    type={type}
    id={id}
    name={name}
    value={value}
    placeholder={placeholder}
    min={min}
    max={max}
    step={step}
    required={required}
    inputmode={inputmode}
    enterkeyhint={enterkeyhint}
    autocomplete={autocomplete}
    spellcheck={spellcheck}
    aria-describedby={describedBy}
    aria-invalid={error ? "true" : undefined}
    role={role}
    data-testid={dataTestid}
    class:list={[{ error }]}
    {...dataAttrs}
  />
  <label
    for={id}
    id={labelId}
    class:list={[labelClass, helpModalId && "field-label-with-help"]}
  >
    {helpModalId ? (
      <>
        <span id={`${id}-floating-label-text`}>{label}</span>
        <button
          type="button"
          class="help-icon"
          data-modal={helpModalId}
          aria-label={helpModalAriaLabel ?? "Open help"}
        >?</button>
      </>
    ) : (
      label
    )}
  </label>
  {errorMessage && (
    <span class="error-text" id={errorId} aria-live="polite">
      {errorMessage}
    </span>
  )}
</div>
