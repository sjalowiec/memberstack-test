---
/**
 * ToolPreviewGate - member gate that keeps the tool visible as a disabled preview.
 *
 * Works alongside <ToolGate /> (which renders the page-level membership notice).
 * Wrap the tool's interactive UI in this component so that:
 *   - Non-members SEE the full tool as a preview (readable, no interaction).
 *   - Members with access see and use the tool normally.
 *
 * Access is decided the same way as the rest of the site: BaseLayout adds one of
 * `ms-logged-in` / `dev-member` / `dev-bypass-gating` to <body> for members with
 * a qualifying plan. The CSS below reacts to those classes, and a small script
 * toggles the `inert` attribute so keyboard/focus is blocked for non-members too.
 *
 * Usage (member-only tool pages):
 *   <ToolGate tool={tool} />
 *   <ToolPreviewGate tool={tool}>
 *     <div class="my-tool-wrap"> ...interactive tool UI... </div>
 *   </ToolPreviewGate>
 *
 * For free tools (`tool.membersonly !== true`) this renders the slot unchanged.
 */
interface Props {
  /** Tool entry from data/tools.json (only `membersonly` is read). */
  tool?: { membersonly?: boolean } | null;
}

const { tool = null } = Astro.props;
const isMemberOnly = tool?.membersonly === true;
---

{isMemberOnly ? (
  <div class="tool-preview tool-preview--locked" data-tool-preview>
    {/* Locked-first: `inert` is removed by the script for members with access. */}
    <div class="tool-preview__inner" data-tool-preview-inner inert>
      <slot />
    </div>
  </div>
) : (
  <slot />
)}

<style>
  .tool-preview {
    position: relative;
  }

  /* Non-member (default) locked preview: readable but clearly inactive. */
  .tool-preview__inner {
    opacity: 0.75;
    pointer-events: none;
    user-select: none;
    transition: opacity 0.2s ease;
  }

  /* Members with access: unlock the tool. */
  :global(body.ms-logged-in) .tool-preview__inner,
  :global(body.dev-member) .tool-preview__inner,
  :global(body.dev-bypass-gating) .tool-preview__inner {
    opacity: 1;
    pointer-events: auto;
    user-select: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-preview__inner {
      transition: none;
    }
  }
</style>

<script>
  // Block keyboard/focus interaction inside the locked preview for non-members.
  // CSS handles the visual + pointer state; `inert` also removes the subtree from
  // the tab order and accessibility tree. Members with access get it removed.
  function applyPreviewLockState() {
    const memberClasses = ["ms-logged-in", "dev-member", "dev-bypass-gating"];
    const hasAccess = memberClasses.some((cls) => document.body.classList.contains(cls));

    document.querySelectorAll<HTMLElement>("[data-tool-preview-inner]").forEach((inner) => {
      if (hasAccess) {
        inner.removeAttribute("inert");
      } else {
        inner.setAttribute("inert", "");
      }
    });
  }

  function initPreviewLock() {
    applyPreviewLockState();

    // BaseLayout adds `ms-logged-in` asynchronously after the Memberstack check,
    // so react to <body> class changes.
    const observer = new MutationObserver(applyPreviewLockState);
    observer.observe(document.body, { attributes: true, attributeFilter: ["class"] });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPreviewLock);
  } else {
    initPreviewLock();
  }
</script>
