---
export interface Props {
  title: string;
  message: string;
  ctaText: string;
  ctaLink: string;
}

const { title, message, ctaText, ctaLink } = Astro.props;
---

<div class="member-lock-overlay">
  <div class="member-lock-overlay-inner">
    <h2>{title}</h2>
    <p>{message}</p>
    <p>
      <a href={ctaLink} class="wizard-button">{ctaText}</a>
    </p>
  </div>
</div>

<style>
  .member-lock-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem;
    /* Minimal veil — tool stays sharp; card carries the “locked” affordance */
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(1px);
    -webkit-backdrop-filter: blur(1px);
    box-sizing: border-box;
  }
  .member-lock-overlay-inner {
    max-width: 400px;
    width: min(400px, 92%);
    margin: 0 auto;
    padding: 1.4rem 1.5rem;
    border-radius: 12px;
    box-sizing: border-box;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.06),
      0 12px 28px -8px rgba(0, 0, 0, 0.1);
    transform: translateY(-40px);
  }
  .member-lock-overlay-inner h2 {
    margin: 0 0 0.45em;
    font-size: 1.1rem;
  }
  .member-lock-overlay-inner p {
    margin: 0.45em 0 0.85em;
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .member-lock-overlay .wizard-button {
    display: inline-block;
    padding: 10px 18px;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 8px;
    background: #52682d;
    color: #fff;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }
  .member-lock-overlay .wizard-button:hover {
    background: #445925;
    color: #fff;
  }
</style>
