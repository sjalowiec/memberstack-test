---
/**
 * Tip of the Week email signup presentation pieces.
 * variant:
 *  - "inline" — one-line invite in the active-tip header (no bordered card)
 *  - "coming-soon" — compact invite with short explanation when no tip is live
 *  - "secondary" — simple button below the featured lesson
 *  - "modal" — accessible dialog containing EmailListSignup fields (once per page)
 */
import EmailListSignup from "../EmailListSignup.astro";

interface Props {
  variant: "inline" | "coming-soon" | "secondary" | "modal";
}

const { variant } = Astro.props;
---

{
  variant === "inline" ? (
    <p
      class="weekly-tip-signup-inline"
      data-weekly-tip-signup-chrome
      data-testid="weekly-tip-signup-cta"
    >
      <span class="weekly-tip-signup-inline__text">Want next week’s tip?</span>{" "}
      <button
        type="button"
        class="kbm-btn kbm-btn-primary weekly-tip-signup-inline__btn"
        data-weekly-tip-signup-open
        data-testid="weekly-tip-signup-open-top"
        aria-haspopup="dialog"
        aria-controls="weekly-tip-signup-dialog"
      >
        Get the Weekly Tip
      </button>
    </p>
  ) : variant === "coming-soon" ? (
    <aside
      class="weekly-tip-signup-coming-soon"
      data-weekly-tip-signup-chrome
      data-testid="weekly-tip-signup-cta"
      aria-labelledby="weekly-tip-signup-coming-soon-heading"
    >
      <p id="weekly-tip-signup-coming-soon-heading" class="weekly-tip-signup-coming-soon__heading">
        Want next week’s tip?
      </p>
      <p class="weekly-tip-signup-coming-soon__text">
        Join the email list and I’ll let you know when it’s ready.
      </p>
      <button
        type="button"
        class="kbm-btn kbm-btn-primary weekly-tip-signup-coming-soon__btn"
        data-weekly-tip-signup-open
        data-testid="weekly-tip-signup-open-top"
        aria-haspopup="dialog"
        aria-controls="weekly-tip-signup-dialog"
      >
        Get the Weekly Tip
      </button>
    </aside>
  ) : variant === "secondary" ? (
    <p
      class="weekly-tip-signup-secondary"
      data-weekly-tip-signup-chrome
      data-testid="weekly-tip-signup-secondary"
    >
      <button
        type="button"
        class="kbm-btn kbm-btn-primary"
        data-weekly-tip-signup-open
        data-testid="weekly-tip-signup-open-secondary"
        aria-haspopup="dialog"
        aria-controls="weekly-tip-signup-dialog"
      >
        Get the Weekly Tip
      </button>
    </p>
  ) : (
    <dialog
      id="weekly-tip-signup-dialog"
      class="weekly-tip-signup-modal"
      data-weekly-tip-signup-modal
      aria-labelledby="weekly-tip-signup-modal-heading"
      data-testid="weekly-tip-signup-modal"
    >
      <div class="weekly-tip-signup-modal__shell">
        <div class="weekly-tip-signup-modal__header">
          <h2 id="weekly-tip-signup-modal-heading" class="weekly-tip-signup-modal__title">
            Get the Weekly Tip
          </h2>
          <button
            type="button"
            class="weekly-tip-signup-modal__close"
            data-signup-close
            aria-label="Close"
            data-testid="weekly-tip-signup-close"
          >
            ×
          </button>
        </div>
        <div class="weekly-tip-signup-modal__body">
          <EmailListSignup idPrefix="totw-email-signup" embedded />
        </div>
      </div>
    </dialog>
  )
}

{
  variant === "modal" ? (
    <script>
      import { bootWeeklyTipSignupModal } from "../../scripts/emailListSignupModal.ts";
      bootWeeklyTipSignupModal();
    </script>
  ) : null
}

<style>
  .weekly-tip-signup-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.65rem;
    margin: 0.75rem 0 0;
    max-width: 42rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: #374151;
  }

  /*
   * Author `display: flex` overrides the UA [hidden] { display: none } rule.
   * Without this, subscriber recognition left the CTA visible while open() no-op'd.
   */
  .weekly-tip-signup-inline[hidden],
  .weekly-tip-signup-coming-soon[hidden],
  .weekly-tip-signup-secondary[hidden] {
    display: none !important;
  }

  .weekly-tip-signup-inline__text {
    font-weight: 400;
  }

  .weekly-tip-signup-inline__btn {
    padding: 0.35rem 0.75rem;
    font-size: 0.88rem;
    border-radius: 7px;
    width: auto;
    flex: none;
  }

  .weekly-tip-signup-coming-soon {
    margin: 1rem 0 0;
    max-width: 42rem;
  }

  .weekly-tip-signup-coming-soon__heading {
    margin: 0 0 0.3rem;
    font-size: 1rem;
    font-weight: 650;
    color: #1f2937;
    line-height: 1.35;
  }

  .weekly-tip-signup-coming-soon__text {
    margin: 0 0 0.7rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #374151;
  }

  .weekly-tip-signup-coming-soon__btn {
    padding: 0.4rem 0.85rem;
    font-size: 0.92rem;
  }

  .weekly-tip-signup-secondary {
    margin: 1.5rem 0 0;
    max-width: 42rem;
  }

  .weekly-tip-signup-modal {
    max-width: min(92vw, 28rem);
    max-height: min(90vh, 40rem);
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.18);
    overflow: auto;
  }

  .weekly-tip-signup-modal::backdrop {
    background: rgba(15, 23, 42, 0.45);
  }

  .weekly-tip-signup-modal__shell {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .weekly-tip-signup-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.1rem 1.15rem 0.35rem;
  }

  .weekly-tip-signup-modal__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: #1f2937;
    line-height: 1.25;
  }

  .weekly-tip-signup-modal__close {
    flex: none;
    appearance: none;
    border: none;
    background: transparent;
    color: #4b5563;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.15rem 0.4rem;
    border-radius: 6px;
  }

  .weekly-tip-signup-modal__close:hover,
  .weekly-tip-signup-modal__close:focus-visible {
    color: #1f2937;
    background: #f3f4f6;
  }

  .weekly-tip-signup-modal__close:focus-visible {
    outline: 2px solid var(--kbm-green, #52682d);
    outline-offset: 2px;
  }

  .weekly-tip-signup-modal__body {
    padding: 0.35rem 1.15rem 1.25rem;
  }

  @media (max-width: 480px) {
    .weekly-tip-signup-modal {
      max-width: calc(100vw - 1.25rem);
      max-height: min(92dvh, 92vh);
      margin: 0.5rem auto;
    }
  }
</style>
