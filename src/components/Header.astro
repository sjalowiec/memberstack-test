---
/* Centered Logo Header for Knit it Now — soft launch (simplified nav) */

import { PATTERN_BUILDERS_HOME_HREF } from "../lib/patterns/customPatternProjectNavigation";
import { EBOOK_SALES_PAUSED } from "../lib/legacy/legacyEbookSalesHold";
import PatternWorkspaceLibraryDrawer from "./patterns/PatternWorkspaceLibraryDrawer.astro";

interface Props {
  /**
   * Onboarding mode: render a stripped-down header (logo only) for focused
   * focused signup/checklist flows. Hides primary nav, search, account actions,
   * the hamburger menu, and the beta banner while keeping the logo → home link.
   */
  onboarding?: boolean;
  /**
   * Marketing mode: same minimal chrome as onboarding (logo only, no nav/search)
   * for sales pages such as /membership.
   */
  marketing?: boolean;
}

const { onboarding = false, marketing = false } = Astro.props;
const minimalHeader = onboarding || marketing;
---
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap');

/* Global variables and typography now defined in global.css to avoid Astro CSS bundling issues */

/* Desktop header-specific adjustments */
@media (min-width: 1025px) {
  .kbm-logo-section {
    padding: 4px 24px 0 20px;
  }

  .kbm-nav-row { 
    padding: 0.25rem 0;
    margin-top: 0;
  }
}

/* Tablet / medium desktop: row 1 = logo + nav, row 2 = search + account (mobile unchanged ≤1024px) */
@media (min-width: 1025px) and (max-width: 1400px) {
  .kbm-nav-bar .kbm-container {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "brand nav"
      "secondary secondary";
    align-items: center;
    gap: 0.35rem 0.65rem;
    padding-inline: 16px;
  }

  .kbm-nav-bar .brand {
    grid-area: brand;
    min-width: 0;
  }

  .kbm-nav-bar .kbm-nav-primary {
    grid-area: nav;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .kbm-nav-bar .kbm-nav-secondary {
    grid-area: secondary;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem 0.75rem;
    width: 100%;
    min-width: 0;
  }

  .kbm-logo-section {
    padding: 4px 12px 0 8px;
  }

  .kbm-nav-bar .kbm-logo-img {
    width: 40px;
    height: 40px;
  }

  .kbm-nav-bar .kbm-logo-text {
    font-size: 1.45rem;
  }

  .kbm-nav-bar .kbm-nav-row {
    gap: 0.65rem;
    flex-wrap: wrap;
    justify-content: flex-start;
    min-width: 0;
  }

  .kbm-menu {
    gap: 0.65rem;
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .kbm-menu > li > a,
  .kbm-menu > li > .dd-trigger {
    font-size: 0.95rem;
    padding: 6px 0;
  }

  .kbm-nav-bar .kbm-header-auth {
    flex: 0 1 auto;
    min-width: 0;
  }

  .kbm-nav-bar .kbm-header-auth .kbm-header-account-btn {
    max-width: min(12rem, 42vw);
  }

  .kbm-nav-bar .kbm-header-auth > [data-ms-content] {
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-left: auto;
  }

  .kbm-nav-bar .kbm-header-auth .kbm-btn-outline {
    font-size: 0.85rem;
    padding: 6px 10px;
  }

  .kbm-nav-bar .kbm-nav-right {
    display: none;
  }
}

/* Wide desktop single row — only when the full header fits without clipping */
@media (min-width: 1401px) {
  .kbm-nav-bar .kbm-container {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: nowrap;
  }

  .kbm-nav-bar .brand {
    flex: 0 0 auto;
  }

  .kbm-nav-bar .kbm-nav-primary {
    flex: 1 1 auto;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .kbm-nav-bar .kbm-nav-secondary {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
  }

  .kbm-nav-bar .kbm-header-auth {
    flex-shrink: 0;
  }

  .kbm-nav-bar .kbm-header-auth .kbm-header-account-btn {
    max-width: min(13rem, 100%);
  }

  .kbm-nav-bar .kbm-nav-right {
    display: none;
  }
}

/* ===== FIXED HEADER ===== */
.kbm-header-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1500;
  box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
  width: 100%;
  max-width: 100%;
}

/* Full-width header content with page padding (no max-width) */
.kbm-container {
  width: 100%;
  padding-inline: 24px;
  box-sizing: border-box;
}

/* ===== BILLBOARD STRIP (above main nav) ===== */
.kbm-billboard {
  width: 100%;
  background: #fff1d3;
  padding: 0.5rem 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

/* Same horizontal alignment as nav bar: full width, same padding */
.kbm-billboard-inner {
  width: 100%;
  padding-inline: 24px;
  box-sizing: border-box;
  text-align: center;
}

@media (max-width: 600px) {
  .kbm-billboard-inner {
    padding-inline: 16px;
  }
}

/* Mobile: compact announcement strip (Layer 1); secondary to brand bar and CTA */
@media (max-width: 1024px) {
  .kbm-billboard {
    padding: 0.28rem 0;
  }

  .kbm-billboard-inner {
    padding-inline: 16px;
    text-align: center;
  }

  .kbm-billboard-text {
    font-size: 0.85rem;
    line-height: 1.35;
  }
}

@media (max-width: 600px) {
  .kbm-billboard {
    padding: 0.2rem 0;
  }

  .kbm-billboard-text {
    font-size: 0.8rem;
    line-height: 1.3;
  }
}

/* ===== SITE-WIDE SEARCH STRIP (full-width search bar below nav) ===== */
.kbm-search-strip {
  width: 100%;
  background: var(--kbm-accent, #c2614e);
  padding: 0.6rem 0;
  border-top: 1px solid rgba(255, 255, 255, 0.18);
}

.kbm-search-strip-inner {
  width: 100%;
  max-width: 900px;
  margin: 0 auto;
  padding-inline: 24px;
  box-sizing: border-box;
}

.kbm-search-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 52px;
  padding: 10px 20px;
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 999px;
  background: #fff;
  color: #5b5b5b;
  cursor: text;
  box-sizing: border-box;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
  transition: box-shadow 0.15s ease, border-color 0.15s ease;
}

.kbm-search-bar:hover {
  border-color: rgba(0, 0, 0, 0.16);
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.18);
}

.kbm-search-bar:focus,
.kbm-search-bar:focus-visible {
  outline: none;
  border-color: var(--kbm-green, #52682d);
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.85), 0 3px 10px rgba(0, 0, 0, 0.18);
}

.kbm-search-bar__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  color: var(--kbm-green, #52682d);
}

.kbm-search-bar__placeholder {
  font-family: var(--font, "Poppins", sans-serif);
  font-size: 1.05rem;
  color: #6a6a6a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

@media (max-width: 1024px) {
  .kbm-search-strip {
    padding: 0.5rem 0;
  }
  .kbm-search-strip-inner {
    padding-inline: 16px;
  }
}

@media (max-width: 600px) {
  .kbm-search-bar {
    min-height: 48px;
    padding: 8px 16px;
    gap: 10px;
  }
  .kbm-search-bar__placeholder {
    font-size: 0.95rem;
  }
  .kbm-search-bar__icon svg {
    width: 20px;
    height: 20px;
  }
}

/* Drawer-only block: CTA + Account (visible only inside mobile drawer) */
.kbm-drawer-actions {
  display: none;
}

@media (max-width: 1024px) {
  .kbm-nav-row .kbm-drawer-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    /* ~32px total between nav links and buttons, split across the divider */
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--ring);
  }

  /* CTA moved to green bar; remove from drawer */
  .kbm-nav-row .kbm-drawer-actions .kbm-drawer-cta {
    display: none !important;
  }

  .kbm-nav-row .kbm-drawer-actions .kbm-drawer-account {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  /* Memberstack toggles these wrappers; only one is visible at a time */
  .kbm-nav-row .kbm-drawer-actions .kbm-drawer-account > [data-ms-content] {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  .kbm-nav-row .kbm-drawer-actions .kbm-drawer-account a {
    min-height: 44px;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.5rem 1rem;
  }

  /* Strong contrast in drawer: dark text on light background */
  .kbm-nav-row .kbm-menu > li > a,
  .kbm-nav-row .kbm-menu > li > .dd-trigger {
    color: #1a2a15 !important;
    font-weight: 600;
  }

  .kbm-nav-row .kbm-menu > li > a:hover,
  .kbm-nav-row .kbm-menu > li > .dd-trigger:hover {
    color: var(--kbm-green) !important;
  }

  .kbm-nav-row .kbm-menu .dd-panel a {
    color: #1a2a15 !important;
    font-weight: 500;
  }

  .kbm-nav-row .kbm-menu .dd-panel a:hover {
    color: var(--kbm-green) !important;
  }

  .kbm-nav-row .kbm-drawer-actions .kbm-drawer-account a {
    color: #1a2a15 !important;
  }

  .kbm-nav-row .kbm-drawer-actions .kbm-drawer-account .kbm-btn--primary {
    color: #fff !important;
    background: var(--kbm-green) !important;
    border-color: var(--kbm-green) !important;
  }
}

.kbm-billboard-text {
  font-family: var(--font);
  font-size: var(--text-base);
  color: #243015;
  margin: 0;
}

.kbm-billboard-trigger {
  border: none;
  background: none;
  font-family: inherit;
  font-size: inherit;
  color: var(--kbm-green);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
  padding: 0;
  margin-left: 0.2em;
}

.kbm-billboard-trigger:hover {
  color: var(--kbm-green-hover);
  text-decoration-thickness: 2px;
}

.kbm-billboard-trigger:focus {
  outline: 2px solid var(--kbm-green);
  outline-offset: 2px;
}

/* ===== MAIN NAV BAR (green bar: logo | nav | search | CTA | account) ===== */
.kbm-nav-bar {
  background: var(--kbm-green);
  padding: 0.35rem 0;
}

.kbm-nav-bar .kbm-container {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.kbm-nav-bar .brand {
  flex-shrink: 0;
  min-width: 0;
}

.kbm-nav-bar .kbm-nav-primary {
  min-width: 0;
}

.kbm-nav-bar .kbm-nav-secondary {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  min-width: 0;
}

.kbm-nav-bar .kbm-nav-right {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

.kbm-nav-bar .kbm-header-auth {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.kbm-nav-bar .kbm-header-auth > [data-ms-content] {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.kbm-nav-bar .kbm-header-auth .kbm-btn-outline {
  font-size: 0.9rem;
  padding: 8px 14px;
  white-space: nowrap;
}

.kbm-nav-bar .kbm-header-auth .kbm-header-account-btn {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  max-width: min(13rem, 100%);
  overflow: hidden;
  white-space: normal;
  flex: 0 1 auto;
}

.kbm-header-account-label {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

.kbm-header-account-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
  flex: 0 1 auto;
}

.kbm-header-account-suffix,
.kbm-header-account-fallback {
  flex: 0 0 auto;
  white-space: nowrap;
}

.kbm-nav-bar .kbm-header-auth a[data-ms-action="logout"] {
  flex-shrink: 0;
}

.kbm-nav-bar .kbm-logo-section {
  padding: 0.25rem 0;
}

.kbm-nav-bar .kbm-logo,
.kbm-nav-bar .kbm-logo-text {
  color: #fff;
}

.kbm-nav-bar .kbm-logo:hover,
.kbm-nav-bar .kbm-logo-text:hover {
  color: rgba(255, 255, 255, 0.92);
}

/* ===== HEADER INNER (legacy / mobile) ===== */
.header-inner {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  border-bottom: 1px solid var(--ring);
}

/* Nav bar: menu + search icon + CTA + account (inside green bar) */
.kbm-nav-bar .kbm-menu-wrap {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex: 1 1 auto;
  justify-content: center;
  min-width: 0;
}

.kbm-nav-bar .kbm-menu > li > a,
.kbm-nav-bar .kbm-menu > li > .dd-trigger {
  color: #fff;
  font-weight: 500;
}

.kbm-nav-bar .kbm-menu > li > a:hover,
.kbm-nav-bar .kbm-menu > li > .dd-trigger:hover {
  color: rgba(255, 255, 255, 0.9);
}

.kbm-nav-bar .kbm-menu .dd-panel a {
  color: var(--kbm-green);
}

.kbm-nav-bar .kbm-search-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: none;
  background: transparent;
  color: #fff;
  cursor: pointer;
  border-radius: 50%;
  flex-shrink: 0;
}

.kbm-nav-bar .kbm-search-icon:hover {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
}

.kbm-nav-bar .kbm-search-icon:focus {
  outline: 2px solid rgba(255, 255, 255, 0.8);
  outline-offset: 2px;
}

.kbm-cta-guide {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.45rem 1rem;
  font-family: var(--font);
  font-size: var(--text-base);
  font-weight: 600;
  color: #243015;
  background: #e7c677;
  border: none;
  border-radius: 6px;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.15s ease;
  flex-shrink: 0;
  white-space: nowrap;
}

.kbm-cta-guide:hover {
  background: #e0bc5c;
  color: #243015;
}

.kbm-cta-guide:focus {
  outline: 2px solid #243015;
  outline-offset: 2px;
}

/* Desktop: full CTA text; mobile: short "Free Guide" */
.kbm-cta-mobile {
  display: none;
}

.kbm-nav-bar .kbm-account-wrap {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.kbm-nav-bar .kbm-account-wrap a {
  color: #fff;
  text-decoration: none;
  font-size: var(--text-base);
  font-weight: 600;
  padding: 0.35rem 0.5rem;
  border-radius: 4px;
  white-space: nowrap;
}

.kbm-nav-bar .kbm-account-wrap a:hover {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
}

.right {
  display: flex;
  gap: 12px;
  align-items: center;
  justify-content: flex-end;
}

.auth {
  display: flex;
  gap: 10px;
  align-items: center;
  font-family: "Poppins", sans-serif;
  font-size: var(--text-base);
}

.auth a,
.auth button {
  color: var(--kbm-green);
  text-decoration: none;
  font-weight: 600;
  white-space: nowrap;
  background: none;
  border: none;
  cursor: pointer;
  font-family: inherit;
  font-size: inherit;
  padding: 0;
}

.auth a:hover,
.auth button:hover {
  color: var(--kbm-green-hover);
}

.header-actions a {
  display: inline-flex;
  gap: 0.4rem;
  align-items: center;
  padding: 0.4rem 0.7rem;
  border-radius: 999px;
  border: 1px solid currentColor;
  text-decoration: none;
  margin-left: 0.5rem;
}

.auth-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.45rem 0.9rem;
  border-radius: 999px;
  font-size: 0.95rem;
  text-decoration: none;
  transition: all 0.15s ease;
}

.auth-btn--primary {
  background: var(--color-primary, #111);
  color: #fff;
  border: 1px solid var(--color-primary, #111);
}

.auth-btn--primary:hover {
  opacity: 0.9;
}

.auth-btn--secondary {
  background: transparent;
  color: var(--color-primary, #111);
  border: 1px solid transparent;
}

.auth-btn--secondary:hover {
  text-decoration: underline;
}

@media (max-width: 760px) {
  .header-inner {
    grid-template-columns: 1fr;
  }
  .right {
    justify-content: flex-start;
    flex-wrap: wrap;
  }
}

/* ===== BRAND (logo + tagline) ===== */
.brand .kbm-logo-section {
  text-align: left;
  padding: 0.5rem 0 0.25rem 0;
  justify-self: start;
}

.kbm-logo-section {
  padding: 0.5rem 80px 0.25rem 80px;
}

.kbm-logo {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  color: var(--kbm-green);
  margin-bottom: 0.25rem;
}

.kbm-logo-img {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.kbm-logo-text {
  font-family: "Poppins", sans-serif;
  font-size: var(--text-xxl);
  font-weight: 700;
  letter-spacing: -0.5px;
  line-height: 1;
  color: var(--kbm-green);
}

.kbm-logo-text-by {
  font-weight: 400;
  font-size: 0.85em;
  opacity: 0.8;
}

.kbm-tagline {
  font-family: "Poppins", sans-serif;
  font-size: calc(var(--text-base) + 2px);
  color: rgba(60, 80, 45, 0.75);
  margin-top: 0;
  margin-bottom: 0.5rem;
  font-weight: 400;
  text-align: center;
}

/* ===== NAVIGATION ROW ===== */
.kbm-nav-row {
  padding: 0.25rem 0;
  margin-top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40px;
}

/* Desktop: nav row in flow; search icon as last nav item; hide full search bar in bar; hide hamburger */
.kbm-nav-bar .kbm-nav-row .kbm-search-icon {
  display: none;
}

@media (min-width: 1025px) {
  .kbm-nav-bar .kbm-nav-row .kbm-search-icon {
    display: inline-flex;
  }

  .kbm-nav-bar .kbm-nav-row .kbm-search-wrap {
    display: none; /* full search only in mobile drawer */
  }

  .kbm-nav-bar .kbm-nav-row {
    position: static;
    width: auto;
    max-width: none;
    height: auto;
    background: transparent;
    box-shadow: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    min-width: 0;
  }

  .kbm-nav-bar .kbm-hamburger {
    display: none;
  }
}

/* Mobile: two-layer header — billboard + green bar with logo, Free Guide CTA, hamburger */
@media (max-width: 1024px) {
  /* Green bar: logo (left), CTA (middle-right), hamburger (far right) */
  .kbm-nav-bar .kbm-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    /* Trimmed ~6px vs. 0.55rem to shorten the green bar; stays centered */
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
    min-width: 0;
  }

  .kbm-nav-bar .brand {
    flex-shrink: 0;
  }

  .kbm-nav-bar .kbm-nav-primary {
    width: 0;
    min-width: 0;
    overflow: visible;
    flex: 0 0 0;
  }

  /* Mobile header = logo (left) + hamburger (right) only.
     Search pill and account buttons move into the drawer, so the whole
     secondary zone is hidden here to stop it competing with the logo. */
  .kbm-nav-bar .kbm-nav-secondary {
    display: none;
  }

  .kbm-nav-bar .kbm-nav-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    min-width: 0;
    flex: 0 0 auto;
  }

  /* Show shorter CTA label in bar on mobile; full text in drawer */
  .kbm-nav-bar .kbm-nav-right .kbm-cta-desktop {
    display: none;
  }

  .kbm-nav-bar .kbm-nav-right .kbm-cta-mobile {
    display: inline;
  }

  .kbm-nav-bar .kbm-nav-right .kbm-cta-guide {
    padding: 0.35rem 0.5rem 0.35rem 0.6rem;
    font-size: 0.85rem;
    display: inline-flex !important;
    justify-content: flex-start;
    text-align: left;
