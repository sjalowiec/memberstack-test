<script>
  import {
    headerAuthWindowState,
    resolveHeaderAuthState,
  } from "../lib/headerAuthState";

  (function () {
    const pill = document.getElementById("auth-pill");
    const authMsg = document.getElementById("auth-msg");
    const authMsgText = document.getElementById("auth-msg-text");
    const authMsgClose = document.getElementById("auth-msg-close");

    function showAuthMsg(text) {
      if (authMsgText) authMsgText.textContent = text;
      if (authMsg) authMsg.style.display = "flex";
      clearTimeout(window.__kinAuthMsgTimer);
      window.__kinAuthMsgTimer = setTimeout(() => {
        const el = document.getElementById("auth-msg");
        if (el) el.style.display = "none";
      }, 6000);
    }
    function hideAuthMsg() {
      clearTimeout(window.__kinAuthMsgTimer);
      if (authMsg) authMsg.style.display = "none";
    }

    function setPill(_state) {
      /* Debug pill removed from UI; auth state still tracked for logic */
    }

    async function waitForMS(attempts = 30, delayMs = 200) {
      for (let i = 0; i < attempts; i++) {
        if (window.$memberstackDom?.getCurrentMember) return true;
        await new Promise(r => setTimeout(r, delayMs));
      }
      return false;
    }

    function firstNameFromMember(member) {
      if (!member) return "";
      const cf = member.customFields || {};
      return (
        (typeof cf["first-name"] === "string" ? cf["first-name"].trim() : "") ||
        (typeof cf.firstName === "string" ? cf.firstName.trim() : "") ||
        ""
      );
    }

    function updateAccountButtonLabel(state) {
      const link = document.getElementById("kbm-header-account-link");
      const nameEl = document.getElementById("kbm-header-account-name");
      const suffixEl = document.getElementById("kbm-header-account-suffix");
      const fallbackEl = document.getElementById("kbm-header-account-fallback");
      if (!link || !nameEl || !suffixEl || !fallbackEl) return;

      if (!state?.loggedIn) {
        nameEl.hidden = true;
        nameEl.textContent = "";
        suffixEl.hidden = true;
        fallbackEl.hidden = false;
        link.setAttribute("aria-label", "Account");
        link.setAttribute("title", "Account");
        return;
      }

      const firstName = firstNameFromMember(state._member);
      if (firstName) {
        const fullLabel = firstName + "'s Account";
        nameEl.textContent = firstName;
        nameEl.hidden = false;
        suffixEl.hidden = false;
        fallbackEl.hidden = true;
        link.setAttribute("aria-label", fullLabel);
        link.setAttribute("title", fullLabel);
      } else {
        nameEl.hidden = true;
        nameEl.textContent = "";
        suffixEl.hidden = true;
        fallbackEl.hidden = false;
        link.setAttribute("aria-label", "Account");
        link.setAttribute("title", "Account");
      }
    }

    async function getAuthState() {
      const ms = window.$memberstackDom;
      if (!ms?.getCurrentMember) {
        window.__KBM_AUTH = { loggedIn: false, member: false, memberId: null };
        return { ms: "missing", loggedIn: false, isMember: false, displayName: "", memberId: null };
      }
      try {
        const res = await ms.getCurrentMember();
        // Same ACTIVE/TRIALING ∩ MEMBER_PLAN_IDS rule as BaseLayout / hasMemberAccess.
        const auth = resolveHeaderAuthState(res);
        window.__KBM_AUTH = headerAuthWindowState(auth);
        const member = auth.member as Record<string, any> | null;
        const planConnections = Array.isArray(member?.planConnections)
          ? member.planConnections
          : [];
        const planLabels = planConnections
          .map((p: any) => p?.planId || p?.planName || "?")
          .join(",");
        const plansDebug = `plans:${planConnections.length}:${planLabels}`;
        const displayName =
          member?.name ||
          member?.customFields?.firstName ||
          member?.email ||
          "";
        const email = member?.auth?.email || member?.email || "";
        return {
          ms: "ready",
          loggedIn: auth.loggedIn,
          isMember: auth.isMember,
          displayName,
          email,
          plansDebug,
          memberId: auth.memberId,
          _member: member,
        };
      } catch (e) {
        window.__KBM_AUTH = { loggedIn: false, member: false, memberId: null };
        return { ms: "error", loggedIn: false, isMember: false, displayName: "", email: "", memberId: null, _member: null };
      }
    }

    async function refreshHeaderAuthUI() {
      try {
        const state = await getAuthState();
        setPill(state);
        updateAccountButtonLabel(state);
        window.__AUTH = {
          loggedIn: Boolean(state.loggedIn),
          member: Boolean(state.isMember),
          memberId: state.memberId || null
        };
        window.dispatchEvent(new Event("auth:updated"));
        return state;
      } catch (e) {
        return null;
      }
    }

    // ---- Logout: immediate feedback + guaranteed header refresh -------------
    // The logout buttons use Memberstack's declarative data-ms-action="logout".
    // Memberstack logs the member out, but the header can lag until a manual
    // refresh, so we take over the click to give instant feedback and force a
    // reload once logout resolves (which re-evaluates data-ms-content state).
    let logoutInProgress = false;

    function setLogoutButtonBusy(btn, busy) {
      if (!btn) return;
      if (busy) {
        if (typeof btn.dataset.kbmLogoutLabel !== "string") {
          btn.dataset.kbmLogoutLabel = btn.textContent.trim();
        }
        btn.textContent = "Logging out\u2026";
        btn.setAttribute("aria-disabled", "true");
        btn.setAttribute("aria-busy", "true");
        btn.style.pointerEvents = "none";
        btn.style.opacity = "0.7";
      } else {
        if (typeof btn.dataset.kbmLogoutLabel === "string") {
          btn.textContent = btn.dataset.kbmLogoutLabel;
          delete btn.dataset.kbmLogoutLabel;
        }
        btn.removeAttribute("aria-disabled");
        btn.removeAttribute("aria-busy");
        btn.style.pointerEvents = "";
        btn.style.opacity = "";
      }
    }

    async function handleLogoutClick(e) {
      const ms = window.$memberstackDom;
      // If Memberstack isn't ready, let the default declarative handler run.
      if (!ms?.logout) return;

      // Preempt Memberstack's own delegated handler so logout only runs once.
      e.preventDefault();
      e.stopImmediatePropagation();

      if (logoutInProgress) return;
      logoutInProgress = true;

      const buttons = document.querySelectorAll('a[data-ms-action="logout"]');
      buttons.forEach((b) => setLogoutButtonBusy(b, true));

      try {
        await ms.logout();
        // Full reload guarantees the header re-renders to the logged-out state
        // (Become a Member / Log In) instead of leaving "Log Out" visible.
        window.location.reload();
      } catch (err) {
        console.error("[kbm] Logout failed:", err);
        logoutInProgress = false;
        buttons.forEach((b) => setLogoutButtonBusy(b, false));
      }
    }

    function setupLogoutButtons() {
      const buttons = document.querySelectorAll('a[data-ms-action="logout"]');
      buttons.forEach((btn) => {
        if (btn.dataset.kbmLogoutBound === "1") return;
        btn.dataset.kbmLogoutBound = "1";
        // Capture phase so we run before Memberstack's bubble-phase handler.
        btn.addEventListener("click", handleLogoutClick, true);
      });
    }

    setupLogoutButtons();

    setPill({ ms: "loading", loggedIn: false, isMember: false, plansDebug: "" });

    (async () => {
      const ready = await waitForMS();
      if (!ready) {
        setPill({ ms: "missing", loggedIn: false, isMember: false, plansDebug: "" });
        return;
      }
      await refreshHeaderAuthUI();

      if (authMsgClose) {
        authMsgClose.addEventListener("click", hideAuthMsg);
      }

      window.addEventListener("focus", refreshHeaderAuthUI);
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) refreshHeaderAuthUI();
      });
    })();
  })();
</script>
<script is:inline>
  (() => {
    const dds = document.querySelectorAll('.kbm-menu .dd');
    const hamburger = document.querySelector('.kbm-hamburger');
    const navRow = document.querySelector('.kbm-nav-row');
    
    let currentMode = null;
    let clickHandlers = new Map();
    let outsideClickHandler = null;

    function closeAll(except) {
      dds.forEach(li => {
        if (li !== except) {
          li.classList.remove('open');
          const trigger = li.querySelector('.dd-trigger');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
        }
      });
    }

    function isTouchMode() {
      return matchMedia('(hover: none), (pointer: coarse)').matches || window.innerWidth <= 1024;
    }

    function setupDropdownBehavior() {
      const touchMode = isTouchMode();
      
      // Only update if mode has changed
      if (currentMode === touchMode) return;
      currentMode = touchMode;

      // Remove old click handlers when switching mode
      clickHandlers.forEach((handler, element) => {
        element.removeEventListener('click', handler);
      });
      clickHandlers.clear();
      if (outsideClickHandler) {
        document.removeEventListener('click', outsideClickHandler);
        outsideClickHandler = null;
      }

      // Setup touch/mobile click behavior (toggle on trigger click)
      if (touchMode) {
        dds.forEach(li => {
          const trigger = li.querySelector(':scope > a, :scope > .dd-trigger');
          const handler = (e) => {
            // For linked top-level items, first tap opens dropdown; second tap follows link.
            if (trigger.tagName === 'A' && !li.classList.contains('open')) {
              e.preventDefault();
            } else if (trigger.tagName !== 'A') {
              e.preventDefault();
            }
            const nowOpen = li.classList.toggle('open');
            trigger.setAttribute('aria-expanded', nowOpen ? 'true' : 'false');
            if (nowOpen) closeAll(li);
          };
          trigger.addEventListener('click', handler);
          clickHandlers.set(trigger, handler);
        });
        
        outsideClickHandler = (e) => {
          if (!e.target.closest('.kbm-nav-row')) closeAll();
        };
        document.addEventListener('click', outsideClickHandler);
      } else {
        // Desktop: click (and keyboard Enter/Space) also toggles dropdown
        dds.forEach(li => {
          const trigger = li.querySelector(':scope > .dd-trigger');
          if (!trigger) return;
          const handler = (e) => {
            // Keep button-based dropdowns toggle-only; allow linked triggers to navigate.
            if (trigger.tagName !== 'A') {
              e.preventDefault();
            }
            const nowOpen = li.classList.toggle('open');
            trigger.setAttribute('aria-expanded', nowOpen ? 'true' : 'false');
            if (nowOpen) closeAll(li);
          };
          trigger.addEventListener('click', handler);
          clickHandlers.set(trigger, handler);
        });
      }
    }

    // Desktop hover behavior (always active, but only works when not in touch mode)
    dds.forEach(li => {
      const trigger = li.querySelector('.dd-trigger');
      li.addEventListener('mouseenter', () => {
        if (!isTouchMode()) {
          clearTimeout(li._closeTimeout);
          li.classList.add('open');
          if (trigger) trigger.setAttribute('aria-expanded', 'true');
        }
      });
      li.addEventListener('mouseleave', () => {
        if (!isTouchMode()) {
          li._closeTimeout = setTimeout(() => {
            li.classList.remove('open');
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
          }, 250);
        }
      });
    });

    // Sync header height to CSS variable for accurate sticky positioning
    function syncHeaderHeight() {
      const header = document.querySelector('.kbm-header-wrap');
      if (header) {
        // Use the header's bottom edge (not just its height) so the value also
        // accounts for the fixed DEV/env stripe that pushes the header down.
        // This keeps the mobile drawer and content offset below both bars.
        const rect = header.getBoundingClientRect();
        const headerBottom = Math.max(0, Math.round(rect.bottom));
        document.documentElement.style.setProperty('--header-height', `${headerBottom}px`);
      }
    }

    // Initial setup
    setupDropdownBehavior();
    syncHeaderHeight();

    // Re-sync after fonts load to handle late layout shifts
    if (document.fonts) {
      document.fonts.ready.then(syncHeaderHeight);
    }
    window.addEventListener('load', syncHeaderHeight, { passive: true });

    // Re-check on resize
    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        setupDropdownBehavior();
        syncHeaderHeight();
      }, 150);
    }, { passive: true });

    // Escape closes open dropdown (keyboard accessibility)
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = document.querySelector('.kbm-menu .dd.open');
      if (open) {
        open.classList.remove('open');
        const t = open.querySelector('.dd-trigger');
        if (t) t.setAttribute('aria-expanded', 'false');
      }
    });

    // Hamburger menu toggle
    if (hamburger && navRow) {
      hamburger.addEventListener('click', () => {
        const isOpen = navRow.classList.toggle('mobile-open');
        hamburger.classList.toggle('active');
        hamburger.setAttribute('aria-expanded', isOpen);
        
        if (isOpen) {
          document.body.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
          closeAll();
        }
      });

      // Close menu when clicking outside
      document.addEventListener('click', (e) => {
        if (window.innerWidth <= 1024 && 
            !navRow.contains(e.target) && 
            !hamburger.contains(e.target) && 
            navRow.classList.contains('mobile-open')) {
          navRow.classList.remove('mobile-open');
          hamburger.classList.remove('active');
          hamburger.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          closeAll();
        }
      });
    }
  })();
</script>
<script is:inline>
  (() => {
    const openBtn = document.getElementById("openSearchModal");
    const modal = document.getElementById("searchModal");
    const overlay = document.getElementById("closeSearchModal");
    const closeBtn = document.getElementById("closeSearchModalBtn");

    // Custom site-wide search results (presentation only).
    // We drive Pagefind's own JS API (/pagefind/pagefind.js) so we can render a
    // clean, scannable layout with category icons/labels + filter chips, instead
    // of the generic default PagefindUI. The index/search logic is unchanged.
    // The /pagefind/ assets only exist after `pagefind --site dist` runs
    // post-build, so we load on demand and fail gracefully on pages/dev.
    let pagefindRequested = false;
    function loadPagefind() {
      if (pagefindRequested) return;
      pagefindRequested = true;

      const root = document.getElementById("pagefind-search");
      if (!root) return;

      const svg = (paths) =>
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
        paths + "</svg>";

      const ICONS = {
        search: svg('<circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>'),
        // Graduation cap
        courses: svg('<path d="M3 9l9-4 9 4-9 4-9-4z"/><path d="M7 11v4.4c0 1 2.2 2.6 5 2.6s5-1.6 5-2.6V11"/><path d="M21 9v4.5"/>'),
        // Play button
        videos: svg('<circle cx="12" cy="12" r="9"/><path d="M10 8.3l6 3.7-6 3.7z"/>'),
        // Sliders / adjustments
        tools: svg('<line x1="4" y1="7" x2="12" y2="7"/><line x1="16" y1="7" x2="20" y2="7"/><circle cx="14" cy="7" r="2"/><line x1="4" y1="12" x2="8" y2="12"/><line x1="12" y1="12" x2="20" y2="12"/><circle cx="10" cy="12" r="2"/><line x1="4" y1="17" x2="12" y2="17"/><line x1="16" y1="17" x2="20" y2="17"/><circle cx="14" cy="17" r="2"/>'),
        // Open book
        reference: svg('<path d="M12 6C10.4 5 8 4.5 5 4.5c-1 0-2 .2-2 .2v13s1-.2 2-.2c3 0 5.4.5 7 1.5"/><path d="M12 6c1.6-1 4-1.5 7-1.5 1 0 2 .2 2 .2v13s-1-.2-2-.2c-3 0-5.4.5-7 1.5z"/><line x1="12" y1="6" x2="12" y2="19"/>'),
        // Tag / label
        glossary: svg('<path d="M20.5 12.3l-7.2 7.2a1.6 1.6 0 0 1-2.3 0l-6.7-6.7V4.5h8.3l7.9 7.8z"/><circle cx="8.3" cy="8.3" r="1.3"/>'),
        // Question mark in a circle
        help: svg('<circle cx="12" cy="12" r="9"/><path d="M9.6 9.3c0-1.4 1.1-2.3 2.5-2.3s2.4 1 2.4 2.2c0 1.1-.8 1.6-1.6 2.2-.7.5-1 .9-1 1.8v.3"/><line x1="12" y1="16.6" x2="12" y2="16.7"/>'),
        // Document
        guide: svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="16" x2="13" y2="16"/>'),
      };

      // Category config. `label` is the per-result badge label (singular),
      // `plural` is the filter-chip label. New categories can be added here and
      // wired into categorize() below without touching search/indexing.
      const CATEGORY_ORDER = ["courses", "videos", "tools", "reference", "glossary", "help", "guide"];
      const CATEGORIES = {
        courses:   { label: "Course",    plural: "Courses",    icon: ICONS.courses },
        videos:    { label: "Video",     plural: "Videos",     icon: ICONS.videos },
        tools:     { label: "Tool",      plural: "Tools",      icon: ICONS.tools },
        reference: { label: "Reference", plural: "Reference",  icon: ICONS.reference },
        glossary:  { label: "Glossary",  plural: "Glossary",   icon: ICONS.glossary },
        help:      { label: "Help Hub",  plural: "Help Hubs",  icon: ICONS.help },
        guide:     { label: "Guide",     plural: "Guides",     icon: ICONS.guide },
      };

      // Infer category from the result URL path (presentation-only).
      function categorize(url) {
        const path = String(url || "").split(/[?#]/)[0].toLowerCase();
        if (/^\/courses(\/|$)/.test(path) || /^\/lessons(\/|$)/.test(path)) return "courses";
        if (/^\/videos?(\/|$)/.test(path) || /^\/video-search(\/|$)/.test(path) ||
            /^\/ready-set-knit(\/|$)/.test(path) || /^\/stitch(\/|$)/.test(path)) return "videos";
        if (/^\/tools(\/|$)/.test(path)) return "tools";
        if (/^\/reference(\/|$)/.test(path)) return "reference";
        if (/^\/glossary(\/|$)/.test(path)) return "glossary";
        if (/^\/help-hub(\/|$)/.test(path)) return "help";
        return "guide";
      }

      function titleFromUrl(url) {
        const path = String(url || "").split(/[?#]/)[0].replace(/\/$/, "");
        const last = path.split("/").filter(Boolean).pop() || "Page";
        return last.replace(/[-_]+/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
      }

      function escapeHtml(s) {
        return String(s == null ? "" : s)
          .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function stripTags(s) {
        return String(s == null ? "" : s).replace(/<[^>]*>/g, "");
      }

      // Drop the first `count` visible characters from an HTML string while
      // preserving/removing tags cleanly (used to trim a leading title echo).
      function removeLeadingVisible(html, count) {
        let removed = 0;
        let i = 0;
        while (i < html.length && removed < count) {
          const ch = html[i];
          if (ch === "<") {
            const close = html.indexOf(">", i);
            if (close === -1) break;
            i = close + 1; // skip the tag; tags aren't visible characters
            continue;
          }
          if (ch === "&") {
            const semi = html.indexOf(";", i);
            if (semi !== -1 && semi - i <= 9) {
              removed += 1;
              i = semi + 1;
              continue;
            }
          }
          removed += 1;
          i += 1;
        }
        // Drop any now-orphaned leading closing tags and separators.
        return html.slice(i).replace(/^(?:\s*<\/[^>]+>)+/, "").trim();
      }

      // Presentation-only tidy of Pagefind excerpts: strip a leading
      // "← Back to …" breadcrumb and a leading echo of the page title so the
      // snippet leads with useful content. Never touches source/indexing.
      function cleanExcerpt(html, title) {
        if (!html) return "";
        let out = String(html).trim();

        out = out.replace(
          /^(?:<[^>]+>\s*)*(?:←|&larr;|&#8592;|&#x2190;|«)?\s*Back to\b[^.<]*?(?:[.•·|–—-]+\s*|\s{2,}|(?=<))/i,
          ""
        ).trim();

        if (title) {
          const t = title.replace(/\s+/g, " ").trim();
          const plain = stripTags(out).replace(/\s+/g, " ").trim();
          if (t && plain.toLowerCase().startsWith(t.toLowerCase())) {
            out = removeLeadingVisible(out, t.length)
              .replace(/^\s*[-–—:.|•·]+\s*/, "")
              .trim();
          }
        }

        return out;
      }

      root.innerHTML =
        '<form class="kin-search__form" role="search">' +
        '<span class="kin-search__icon">' + ICONS.search + "</span>" +
        '<input type="search" class="kin-search__input" autocomplete="off" ' +
        'placeholder="Search courses, videos, tools\u2026" aria-label="Search Knit it Now">' +
        "</form>" +
        '<p class="kin-search__hint"><b>Tip:</b> Search works best with a few keywords. ' +
        "If you don\u2019t find what you need, try fewer words or a simpler search.</p>" +
        '<div class="kin-search__filters" role="group" aria-label="Filter results by type"></div>' +
        '<p class="kin-search__status" role="status" aria-live="polite">Start typing to search across Knit it Now.</p>' +
        '<ul class="kin-search__results" aria-label="Search results"></ul>';

      const input = root.querySelector(".kin-search__input");
      const form = root.querySelector(".kin-search__form");
      const filtersEl = root.querySelector(".kin-search__filters");
      const statusEl = root.querySelector(".kin-search__status");
      const listEl = root.querySelector(".kin-search__results");

      let pagefind = null;
      let allResults = [];
      let activeFilter = "all";
      let currentTerm = "";

      // ---- Search-result QUALITY FILTER (UX-only, not a Pagefind change) ----
      // Pagefind will happily match tiny fragments (single letters, generic
      // words) for weak/garbage queries, which makes search feel broken. The
      // helpers below decide, purely in the presentation layer, whether the
      // results are worth showing. This does NOT touch the Pagefind index or
      // the search query — it only gates what we render after results return.
      //
      // Quality is judged from the ACTUAL MATCHED TERMS Pagefind returns (the
      // <mark> highlights in the result excerpts), NOT from the raw query. We
      // require at least one matched token that is 3+ characters and not a
      // generic UI word. If every match is a single character or a generic
      // word, we treat the results as noise and show the empty state.
      //
      // MIN_GOOD_RESULT_SCORE is a secondary, conservative guard on Pagefind's
      // relative relevance score (higher = better). Tune it if weak matches
      // still slip through.
      const MIN_GOOD_RESULT_SCORE = 0.05;

      // Generic UI/helper words that shouldn't count as a "real" match.
      const GENERIC_WORDS = new Set([
        "search", "another", "result", "results", "showing", "try",
        "word", "words", "keyword", "keywords", "clear", "filter", "filters",
      ]);

      // Lowercase, strip punctuation, split into tokens.
      function tokenize(text) {
        return String(text || "")
          .toLowerCase()
          .replace(/[^\p{L}\p{N}\s]+/gu, " ")
          .split(/\s+/)
          .filter(Boolean);
      }

      // A token counts as meaningful when it is 3+ chars and not generic.
      function isMeaningfulToken(t) {
        return t.length >= 3 && !GENERIC_WORDS.has(t);
      }

      // Pull the actual matched terms out of Pagefind result data by reading
      // the <mark>…</mark> highlights in each excerpt (and any sub-result
      // excerpts). These are the words Pagefind actually matched on.
      function matchedTermsFrom(dataItems) {
        const terms = [];
        const collect = (html) => {
          const re = /<mark[^>]*>([\s\S]*?)<\/mark>/gi;
          let m;
          while ((m = re.exec(String(html || "")))) {
            terms.push(...tokenize(stripTags(m[1])));
          }
        };
        (dataItems || []).forEach((d) => {
          if (!d) return;
          collect(d.excerpt);
          (d.sub_results || []).forEach((s) => collect(s && s.excerpt));
        });
        return terms;
      }

      // Good quality requires at least one matched term that is 3+ chars and
      // not a generic word. Single-character or generic-only matches → poor.
      function hasGoodMatchedTerm(dataItems) {
        return matchedTermsFrom(dataItems).some(isMeaningfulToken);
      }

      // Empty state shown for weak/garbage queries: hide filter pills + cards
      // (so we never show misleading counts like "All 6") and guide the user
      // toward stronger knitting keywords.
      function showNoGoodMatches(term) {
        allResults = [];
        activeFilter = "all";
        filtersEl.innerHTML = "";
        filtersEl.style.display = "none";
        listEl.innerHTML = "";
        statusEl.innerHTML =
          "No matches found for \u201C" + escapeHtml(term) + "\u201D.<br>" +
          "Search works best with one or two knitting keywords.<br><br>" +
          "Try searching for:" +
          '<ul class="kin-search__suggestions">' +
          "<li>tuck</li><li>ribbing</li><li>band pickup</li>" +
          "<li>LK150</li><li>punchcard</li>" +
          "</ul>";
        statusEl.style.display = "";
      }

      function setStatusText(msg) {
        statusEl.textContent = msg || "";
        statusEl.style.display = msg ? "" : "none";
      }
      function showUnavailable() {
        allResults = [];
        filtersEl.innerHTML = "";
        filtersEl.style.display = "none";
        listEl.innerHTML = "";
        statusEl.innerHTML =
          "Search isn\u2019t available yet. Try <a href=\"/video-search\">Search Videos</a> or <a href=\"/help-hub\">Browse the Help Hub</a>.";
        statusEl.style.display = "";
      }

      async function getPagefind() {
        if (pagefind) return pagefind;
        pagefind = await import("/pagefind/pagefind.js");
        return pagefind;
      }

      function render() {
        const counts = {};
        allResults.forEach((r) => { counts[r.cat] = (counts[r.cat] || 0) + 1; });
        if (activeFilter !== "all" && !counts[activeFilter]) activeFilter = "all";

        const chips = [{ key: "all", label: "All", count: allResults.length }];
        CATEGORY_ORDER.forEach((k) => {
          if (counts[k]) chips.push({ key: k, label: CATEGORIES[k].plural, count: counts[k] });
        });
        filtersEl.style.display = allResults.length ? "" : "none";
        filtersEl.innerHTML = chips
          .map((c) =>
            '<button type="button" class="kin-chip' + (c.key === activeFilter ? " is-active" : "") +
            '" data-filter="' + c.key + '" aria-pressed="' + (c.key === activeFilter) + '">' +
            escapeHtml(c.label) + '<span class="kin-chip__count">' + c.count + "</span></button>")
          .join("");

        const items = activeFilter === "all"
          ? allResults
          : allResults.filter((r) => r.cat === activeFilter);
        listEl.innerHTML = items
          .map((r) => {
            const cat = CATEGORIES[r.cat] || CATEGORIES.guide;
            return '<li class="kin-result"><a class="kin-result__link" href="' + escapeHtml(r.url) + '">' +
              '<span class="kin-result__title-row">' +
              '<span class="kin-result__icon kin-result__icon--' + r.cat + '">' + cat.icon + "</span>" +
              '<span class="kin-result__title">' + escapeHtml(r.title) + "</span>" +
              "</span>" +
              '<span class="kin-result__excerpt">' + (r.excerpt || "") + "</span>" +
              "</a></li>";
          })
          .join("");
      }

      filtersEl.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-filter]");
        if (!btn) return;
        activeFilter = btn.getAttribute("data-filter");
        render();
      });

      async function runSearch(term) {
        currentTerm = term;
        if (!term.trim()) {
          allResults = [];
          activeFilter = "all";
          render();
          setStatusText("Start typing to search across Knit it Now.");
          return;
        }
        setStatusText("Searching\u2026");
        let pf;
        try {
          pf = await getPagefind();
        } catch (err) {
          showUnavailable();
          return;
        }
        let search;
        try {
          search = await pf.debouncedSearch(term, {}, 200);
        } catch (err) {
          showUnavailable();
          return;
        }
        if (search === null) return; // superseded by a newer keystroke
        if (term !== currentTerm) return; // stale

        const data = await Promise.all(search.results.slice(0, 30).map((r) => r.data()));
        if (term !== currentTerm) return;

        // UX quality gate (presentation-only): judge quality from the ACTUAL
        // matched terms Pagefind returned (not the raw query). Require at least
        // one matched token of 3+ chars that isn't a generic UI word, plus a
        // conservative relevance-score guard. If it's all single letters or
        // generic words, show the empty state instead of noisy cards/counts.
        // The Pagefind index/query are untouched — we just don't show noise.
        const topScore = search.results.length ? search.results[0].score : 0;
        if (!hasGoodMatchedTerm(data) || !(topScore >= MIN_GOOD_RESULT_SCORE)) {
          showNoGoodMatches(term);
          return;
        }

        allResults = data.map((d) => {
          const title = (d.meta && d.meta.title) || titleFromUrl(d.url);
          return {
            url: d.url,
            title,
            excerpt: cleanExcerpt(d.excerpt, title),
            cat: categorize(d.url),
          };
        });
        render();
        setStatusText(
          allResults.length ? "" : "No results for \u201C" + term + "\u201D. Try a different word."
        );
      }

      form.addEventListener("submit", (e) => e.preventDefault());
      input.addEventListener("input", () => runSearch(input.value));
    }

    function openModal() {
      if (!modal) return;
      loadPagefind();
      modal.classList.add("active");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      const input = document.querySelector("#pagefind-search input");
      if (input) input.focus();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove("active");
      modal.setAttribute("aria-hidden", "true");
      if (!menuDrawerOpen()) document.body.style.overflow = "";
    }

    openBtn?.addEventListener("click", openModal);
    openBtn?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        openModal();
      }
    });
    overlay?.addEventListener("click", closeModal);
    closeBtn?.addEventListener("click", closeModal);

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (!modal?.classList.contains("active")) return;
      closeModal();
    });
  })();
</script>
