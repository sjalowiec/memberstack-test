---
/* Centered Logo Header for Knit it Now — soft launch (simplified nav) */
---
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap');

/* Global variables and typography now defined in global.css to avoid Astro CSS bundling issues */

/* Desktop header-specific adjustments */
@media (min-width: 1025px) {
  .kbm-logo-section {
    padding: 4px 24px 0 20px;
  }

  .kbm-nav-row { 
    padding: 0.25rem 0;
    margin-top: 0;
  }
}

/* ===== FIXED HEADER ===== */
.kbm-header-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1500;
  box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
}

/* Full-width header content with page padding (no max-width) */
.kbm-container {
  width: 100%;
  padding-inline: 24px;
  box-sizing: border-box;
}

/* ===== BILLBOARD STRIP (above main nav) ===== */
.kbm-billboard {
  width: 100%;
  background: #fff1d3;
  padding: 0.5rem 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

/* Same horizontal alignment as nav bar: full width, same padding */
.kbm-billboard-inner {
  width: 100%;
  padding-inline: 24px;
  box-sizing: border-box;
  text-align: center;
}

@media (max-width: 600px) {
  .kbm-billboard-inner {
    padding-inline: 16px;
  }
}

/* Mobile: compact announcement strip (Layer 1); secondary to brand bar and CTA */
@media (max-width: 1024px) {
  .kbm-billboard {
    padding: 0.28rem 0;
  }

  .kbm-billboard-inner {
    padding-inline: 16px;
    text-align: center;
  }

  .kbm-billboard-text {
    font-size: 0.85rem;
    line-height: 1.35;
  }
}

@media (max-width: 600px) {
  .kbm-billboard {
    padding: 0.2rem 0;
  }

  .kbm-billboard-text {
    font-size: 0.8rem;
    line-height: 1.3;
  }
}

/* Drawer-only block: CTA + Account (visible only inside mobile drawer) */
.kbm-drawer-actions {
  display: none;
}

@media (max-width: 1024px) {
  .kbm-nav-row .kbm-drawer-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ring);
  }

  /* CTA moved to green bar; remove from drawer */
  .kbm-nav-row .kbm-drawer-actions .kbm-drawer-cta {
    display: none !important;
  }

  .kbm-nav-row .kbm-drawer-actions .kbm-drawer-account {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: flex-start;
  }

  .kbm-nav-row .kbm-drawer-actions .kbm-drawer-account a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
  }

  /* Strong contrast in drawer: dark text on light background */
  .kbm-nav-row .kbm-menu > li > a,
  .kbm-nav-row .kbm-menu > li > .dd-trigger {
    color: #1a2a15 !important;
    font-weight: 600;
  }

  .kbm-nav-row .kbm-menu > li > a:hover,
  .kbm-nav-row .kbm-menu > li > .dd-trigger:hover {
    color: var(--kbm-green) !important;
  }

  .kbm-nav-row .kbm-menu .dd-panel a {
    color: #1a2a15 !important;
    font-weight: 500;
  }

  .kbm-nav-row .kbm-menu .dd-panel a:hover {
    color: var(--kbm-green) !important;
  }

  .kbm-nav-row .kbm-drawer-actions .kbm-drawer-account a {
    color: #1a2a15 !important;
  }

  .kbm-nav-row .kbm-drawer-actions .kbm-drawer-account .kbm-btn--primary {
    color: #fff !important;
    background: var(--kbm-green) !important;
    border-color: var(--kbm-green) !important;
  }
}

.kbm-billboard-text {
  font-family: var(--font);
  font-size: var(--text-base);
  color: #243015;
  margin: 0;
}

.kbm-billboard-trigger {
  border: none;
  background: none;
  font-family: inherit;
  font-size: inherit;
  color: var(--kbm-green);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
  padding: 0;
  margin-left: 0.2em;
}

.kbm-billboard-trigger:hover {
  color: var(--kbm-green-hover);
  text-decoration-thickness: 2px;
}

.kbm-billboard-trigger:focus {
  outline: 2px solid var(--kbm-green);
  outline-offset: 2px;
}

/* ===== MAIN NAV BAR (green bar: logo | nav | search | CTA | account) ===== */
.kbm-nav-bar {
  background: var(--kbm-green);
  padding: 0.35rem 0;
}

/* Desktop: three-zone layout — logo left, nav centered, CTA + account right */
.kbm-nav-bar .kbm-container {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 1.5rem;
}

.kbm-nav-bar .brand {
  justify-self: start;
  flex-shrink: 0;
}

.kbm-nav-bar .kbm-nav-center {
  justify-self: center;
  min-width: 0;
}

/* Nav links + site search pill in one horizontal group (desktop) */
.kbm-nav-bar .kbm-nav-center-cluster {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.kbm-nav-bar .header-search-trigger {
  margin-left: 24px;
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 999px;
  padding: 8px 16px;
  color: rgba(255, 255, 255, 0.8);
  cursor: pointer;
  background: transparent;
  min-width: 220px;
  font-size: 14px;
  flex-shrink: 0;
  box-sizing: border-box;
}

.kbm-nav-bar .header-search-trigger:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.6);
}

.kbm-nav-bar .header-search-trigger:focus-visible {
  outline: 2px solid rgba(255, 255, 255, 0.85);
  outline-offset: 2px;
}

.kbm-nav-bar .search-placeholder {
  opacity: 0.8;
}

.kbm-nav-bar .kbm-nav-right {
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

/* Nav CTA — terracotta accent (same tokens as .kbm-btn-accent in global.css) */
.kbm-nav-bar .nav-cta-wrapper {
  margin-left: 1rem;
  flex-shrink: 0;
}

@media (max-width: 1024px) {
  .kbm-nav-bar .nav-cta-wrapper {
    margin-left: 0.35rem;
  }
}

.kbm-nav-bar a.kbm-button.kbm-button-accent.nav-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.4rem 0.9rem;
  font-family: var(--font, "Poppins", sans-serif);
  font-size: 0.9rem;
  font-weight: 600;
  color: #fff !important;
  background: var(--kbm-accent);
  border-radius: 8px;
  text-decoration: none;
  white-space: nowrap;
  transition: background 0.2s ease;
  line-height: 1.2;
  box-sizing: border-box;
}

.kbm-nav-bar a.kbm-button.kbm-button-accent.nav-cta:hover,
.kbm-nav-bar a.kbm-button.kbm-button-accent.nav-cta:focus {
  background: var(--kbm-accent-hover);
  color: #fff !important;
  text-decoration: none;
}

@media (max-width: 480px) {
  .kbm-nav-bar a.kbm-button.kbm-button-accent.nav-cta {
    font-size: 0.8rem;
    padding: 0.35rem 0.55rem;
  }
}

.kbm-nav-bar .kbm-header-auth {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.kbm-nav-bar .kbm-header-auth .kbm-btn-outline {
  font-size: 0.9rem;
  padding: 8px 14px;
  white-space: nowrap;
}

.kbm-nav-bar .kbm-logo-section {
  padding: 0.25rem 0;
}

.kbm-nav-bar .kbm-logo,
.kbm-nav-bar .kbm-logo-text {
  color: #fff;
}

.kbm-nav-bar .kbm-logo:hover,
.kbm-nav-bar .kbm-logo-text:hover {
  color: rgba(255, 255, 255, 0.92);
}

/* ===== HEADER INNER (legacy / mobile) ===== */
.header-inner {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  border-bottom: 1px solid var(--ring);
}

/* Nav bar: menu + search icon + CTA + account (inside green bar) */
.kbm-nav-bar .kbm-menu-wrap {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex: 1 1 auto;
  justify-content: center;
  min-width: 0;
}

.kbm-nav-bar .kbm-menu > li > a,
.kbm-nav-bar .kbm-menu > li > .dd-trigger {
  color: #fff;
  font-weight: 500;
}

.kbm-nav-bar .kbm-menu > li > a:hover,
.kbm-nav-bar .kbm-menu > li > .dd-trigger:hover {
  color: rgba(255, 255, 255, 0.9);
}

.kbm-nav-bar .kbm-menu .dd-panel a {
  color: var(--kbm-green);
}

.kbm-nav-bar .kbm-search-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: none;
  background: transparent;
  color: #fff;
  cursor: pointer;
  border-radius: 50%;
  flex-shrink: 0;
}

.kbm-nav-bar .kbm-search-icon:hover {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
}

.kbm-nav-bar .kbm-search-icon:focus {
  outline: 2px solid rgba(255, 255, 255, 0.8);
  outline-offset: 2px;
}

.kbm-cta-guide {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.45rem 1rem;
  font-family: var(--font);
  font-size: var(--text-base);
  font-weight: 600;
  color: #243015;
  background: #e7c677;
  border: none;
  border-radius: 6px;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.15s ease;
  flex-shrink: 0;
  white-space: nowrap;
}

.kbm-cta-guide:hover {
  background: #e0bc5c;
  color: #243015;
}

.kbm-cta-guide:focus {
  outline: 2px solid #243015;
  outline-offset: 2px;
}

/* Desktop: full CTA text; mobile: short "Free Guide" */
.kbm-cta-mobile {
  display: none;
}

.kbm-nav-bar .kbm-account-wrap {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.kbm-nav-bar .kbm-account-wrap a {
  color: #fff;
  text-decoration: none;
  font-size: var(--text-base);
  font-weight: 600;
  padding: 0.35rem 0.5rem;
  border-radius: 4px;
  white-space: nowrap;
}

.kbm-nav-bar .kbm-account-wrap a:hover {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
}

.right {
  display: flex;
  gap: 12px;
  align-items: center;
  justify-content: flex-end;
}

.auth {
  display: flex;
  gap: 10px;
  align-items: center;
  font-family: "Poppins", sans-serif;
  font-size: var(--text-base);
}

.auth a,
.auth button {
  color: var(--kbm-green);
  text-decoration: none;
  font-weight: 600;
  white-space: nowrap;
  background: none;
  border: none;
  cursor: pointer;
  font-family: inherit;
  font-size: inherit;
  padding: 0;
}

.auth a:hover,
.auth button:hover {
  color: var(--kbm-green-hover);
}

.header-actions a {
  display: inline-flex;
  gap: 0.4rem;
  align-items: center;
  padding: 0.4rem 0.7rem;
  border-radius: 999px;
  border: 1px solid currentColor;
  text-decoration: none;
  margin-left: 0.5rem;
}

.auth-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.45rem 0.9rem;
  border-radius: 999px;
  font-size: 0.95rem;
  text-decoration: none;
  transition: all 0.15s ease;
}

.auth-btn--primary {
  background: var(--color-primary, #111);
  color: #fff;
  border: 1px solid var(--color-primary, #111);
}

.auth-btn--primary:hover {
  opacity: 0.9;
}

.auth-btn--secondary {
  background: transparent;
  color: var(--color-primary, #111);
  border: 1px solid transparent;
}

.auth-btn--secondary:hover {
  text-decoration: underline;
}

@media (max-width: 760px) {
  .header-inner {
    grid-template-columns: 1fr;
  }
  .right {
    justify-content: flex-start;
    flex-wrap: wrap;
  }
}

/* ===== BRAND (logo + tagline) ===== */
.brand .kbm-logo-section {
  text-align: left;
  padding: 0.5rem 0 0.25rem 0;
  justify-self: start;
}

.kbm-logo-section {
  padding: 0.5rem 80px 0.25rem 80px;
}

.kbm-logo {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  color: var(--kbm-green);
  margin-bottom: 0.25rem;
}

.kbm-logo-img {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.kbm-logo-text {
  font-family: "Poppins", sans-serif;
  font-size: var(--text-xxl);
  font-weight: 700;
  letter-spacing: -0.5px;
  line-height: 1;
  color: var(--kbm-green);
}

.kbm-logo-text-by {
  font-weight: 400;
  font-size: 0.85em;
  opacity: 0.8;
}

.kbm-tagline {
  font-family: "Poppins", sans-serif;
  font-size: calc(var(--text-base) + 2px);
  color: rgba(60, 80, 45, 0.75);
  margin-top: 0;
  margin-bottom: 0.5rem;
  font-weight: 400;
  text-align: center;
}

/* ===== NAVIGATION ROW ===== */
.kbm-nav-row {
  padding: 0.25rem 0;
  margin-top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40px;
}

/* Desktop: nav row in flow; search icon as last nav item; hide full search bar in bar; hide hamburger */
.kbm-nav-bar .kbm-nav-row .kbm-search-icon {
  display: none;
}

@media (min-width: 1025px) {
  .kbm-nav-bar .kbm-nav-row .kbm-search-icon {
    display: inline-flex;
  }

  .kbm-nav-bar .kbm-nav-row .kbm-search-wrap {
    display: none; /* full search only in mobile drawer */
  }

  .kbm-nav-bar .kbm-nav-row {
    position: static;
    width: auto;
    max-width: none;
    height: auto;
    background: transparent;
    box-shadow: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    min-width: 0;
  }

  .kbm-nav-bar .kbm-hamburger {
    display: none;
  }
}

/* Mobile: two-layer header — billboard + green bar with logo, Free Guide CTA, hamburger */
@media (max-width: 1024px) {
  /* Green bar: logo (left), CTA (middle-right), hamburger (far right) */
  .kbm-nav-bar .kbm-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.55rem;
    padding-bottom: 0.55rem;
    min-width: 0;
  }

  .kbm-nav-bar .brand {
    flex-shrink: 0;
  }

  .kbm-nav-bar .kbm-nav-center {
    width: 0;
    min-width: 0;
    overflow: visible;
    flex: 0 0 0;
  }

  /* Center column is collapsed on mobile; search pill lives in desktop bar only */
  .kbm-nav-bar .header-search-trigger {
    display: none;
  }

  .kbm-nav-bar .kbm-nav-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    min-width: 0;
    flex-shrink: 1;
  }

  /* Show shorter CTA label in bar on mobile; full text in drawer */
  .kbm-nav-bar .kbm-nav-right .kbm-cta-desktop {
    display: none;
  }

  .kbm-nav-bar .kbm-nav-right .kbm-cta-mobile {
    display: inline;
  }

  .kbm-nav-bar .kbm-nav-right .kbm-cta-guide {
    padding: 0.35rem 0.5rem 0.35rem 0.6rem;
    font-size: 0.85rem;
    display: inline-flex !important;
    justify-content: flex-start;
    text-align: left;
    flex-shrink: 1;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
  }

  .kbm-nav-bar .kbm-nav-right .kbm-cta-guide .kbm-cta-mobile {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .kbm-nav-bar .kbm-nav-right .kbm-hamburger {
    flex-shrink: 0;
  }

  .kbm-nav-bar .kbm-nav-right .kbm-account-wrap {
    display: none !important;
  }

  /* Hamburger in flow inside green bar (not absolute); white for contrast on green */
  .kbm-nav-bar .kbm-hamburger {
    position: static;
    top: auto;
    right: auto;
    margin: 0;
    padding: 10px;
    min-width: 48px;
    min-height: 48px;
  }

  .kbm-nav-bar .kbm-hamburger span {
    background: #fff;
    width: 26px;
    height: 3px;
  }

  .kbm-nav-bar .kbm-hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(6px, 6px);
  }

  .kbm-nav-bar .kbm-hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(6px, -6px);
  }
}

/* Account buttons in green bar */
.kbm-nav-bar .kbm-account-wrap .kbm-btn--ghost {
  color: #fff;
  border-color: rgba(255, 255, 255, 0.6);
  background: transparent;
}

.kbm-nav-bar .kbm-account-wrap .kbm-btn--ghost:hover {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
}

.kbm-nav-bar .kbm-account-wrap .kbm-btn--primary {
  background: #fff;
  color: var(--kbm-green);
  border-color: #fff;
}

.kbm-nav-bar .kbm-account-wrap .kbm-btn--primary:hover {
  background: rgba(255, 255, 255, 0.92);
  color: var(--kbm-green);
}

.kbm-nav-bar .kbm-hamburger span {
  background: #fff;
}

.kbm-menu {
  display: flex;
  align-items: center;
  gap: 40px;
  margin: 0;
  padding: 0;
  list-style: none;
  font-family: "Poppins", sans-serif;
}

.kbm-menu > li > a,
.kbm-menu > li > .dd-trigger {
  color: var(--kbm-green);
  text-decoration: none;
  font-weight: 600;
  font-size: var(--text-lg);
  padding: 8px 0;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  transition: color 0.2s ease;
  white-space: nowrap;
  cursor: pointer;
  background: none;
  border: none;
  font-family: inherit;
}

.kbm-menu > li > a:hover,
.kbm-menu > li > .dd-trigger:hover {
  color: var(--kbm-green-hover);
}

.kbm-menu > li > .dd-trigger:focus {
  outline: 2px solid var(--kbm-green);
  outline-offset: 2px;
}

.caret {
  font-size: 1.2em;
  margin-left: 2px;
}

.nav-pill-new {
  display: inline-block;
  margin-right: 8px;
  padding: 2px 6px;
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
  border-radius: 999px;
  background-color: #c2614e;
  color: #fff;
  transform: rotate(-15deg);
  transform-origin: center;
  vertical-align: middle;
  white-space: nowrap;
}

.kbm-menu > li > a.nav-whats-new-link {
  gap: 6px;
}

.nav-whats-new-link .nav-pill-new {
  margin-right: 0;
}

/* ===== SEARCH BAR ===== */
.kbm-search-wrap {
  display: flex;
  align-items: center;
  gap: 0;
  background: white;
  border: 1px solid var(--ring);
  border-radius: 24px;
  overflow: hidden;
  min-width: 280px;
}

.kbm-search-input {
  flex: 1;
  border: none;
  outline: none;
  padding: 8px 16px;
  font-size: var(--text-base);
  font-family: "Poppins", sans-serif;
  background: transparent;
}

.kbm-search-btn {
  background: var(--kbm-green);
  color: white;
  border: none;
  padding: 8px 18px;
  cursor: pointer;
  font-size: var(--text-base);
  transition: background 0.2s ease;
  min-height: 40px;
}

.kbm-search-btn:hover {
  background: var(--kbm-green-hover);
}

/* ===== DROPDOWNS ===== */
.dd {
  position: relative;
}

.dd-panel {
  position: absolute;
  top: calc(100% + 12px);
  left: 50%;
  transform: translateX(-50%) translateY(8px) scale(0.98);
  min-width: 200px;
  background: #ffffff;
  border: 1px solid var(--ring);
  border-radius: 8px;
  box-shadow: 0 4px 12px rgba(0, 0, 0, .15);
  padding: 8px 0;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity .2s ease, transform .2s ease;
  z-index: 1200;
}

.dd.open > .dd-panel,
.dd:hover > .dd-panel {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0) scale(1);
}

.dd-panel li {
  list-style: none;
}

.dd-panel a {
  display: block;
  padding: 12px 16px;
  color: var(--kbm-green);
  text-decoration: none;
  font-size: var(--text-base);
  transition: background 0.15s ease;
  min-height: 44px;
}

.dd-panel a:hover {
  background: var(--kbm-bg);
}

/* Help dropdown (nav-* classes; shares .dd / .dd-trigger / .dd-panel behavior with existing JS) */
