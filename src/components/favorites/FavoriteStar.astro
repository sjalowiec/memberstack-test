---
/**
 * Reusable favorite star button � place immediately beside an item title.
 */
import "../../styles/favorites.css";
import {
  favoriteActionTooltip,
  favoriteAriaLabel,
  FAVORITE_STAR_CLASS,
  FAVORITE_STAR_ICON_CLASS,
} from "../../lib/favorites/favoriteStarUi";
import type { FavoriteContentType } from "../../lib/favorites/favoriteContentTypes";
import { normalizeFavoriteContentId } from "../../lib/favorites/favoriteContentTypes";

interface Props {
  contentType: FavoriteContentType;
  contentId: string | number;
  title: string;
  isFavorite?: boolean;
  class?: string;
  /** Short hover/focus tooltip. The accessible name stays the full save/remove label. */
  actionTooltip?: boolean;
  /** Where the star sits, for analytics. Example: tip-page, knit-able-card. */
  source?: string;
}

const {
  contentType,
  contentId,
  title,
  isFavorite = false,
  class: className,
  actionTooltip = false,
  source,
} = Astro.props;
const id = normalizeFavoriteContentId(contentId) ?? "";
const label = favoriteAriaLabel(title, isFavorite);
const iconClass = isFavorite ? "fa-solid fa-star" : "fa-regular fa-star";
---

{
  id ? (
    <button
      type="button"
      class:list={[FAVORITE_STAR_CLASS, isFavorite && "is-favorite", className]}
      data-favorite-star
      data-content-type={contentType}
      data-content-id={id}
      data-favorite-title={title.trim() || "this item"}
      data-favorite-source={source || undefined}
      data-favorite-action-tooltip={actionTooltip ? "true" : undefined}
      data-tooltip={actionTooltip ? favoriteActionTooltip(isFavorite) : undefined}
      aria-pressed={isFavorite ? "true" : "false"}
      aria-label={label}
    >
      <i class:list={[FAVORITE_STAR_ICON_CLASS, iconClass]} aria-hidden="true" />
    </button>
  ) : null
}
